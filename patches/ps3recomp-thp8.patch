+ * import-library member also defines __imp_getenv, so defining the slot here
+ * is a duplicate symbol, and zig's linker driver has no --wrap. The cache is
+ * installed at startup instead by patching the IAT slot (ppu_getenv_iat_patch). */
+extern "C" void* ppu_getenv_cache_fn(void) { return (void*)&cached_getenv; }
