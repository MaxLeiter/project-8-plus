+    void     (*guest_free)(const ps3mod_host* self, uint32_t addr);
+
+    /* -- plugin services (see "Plugin services") --------------------------------
+     * service_publish: make `table` available under `name` (UTF-8, compared
+     * case-sensitively). One publisher per name: PS3MOD_E_CONFLICT if another
+     * plugin has it; the same plugin may republish (replaces table/version).
+     * The table must stay valid while the DLL is loaded.
+     * service_get: the table, or NULL if no plugin published `name` or its
+     * version < min_version. Callable from any thread at any time. */
+    int         (*service_publish)(const ps3mod_host* self, const char* name, uint32_t version,
+                                   const void* table);
+    const void* (*service_get)(const ps3mod_host* self, const char* name, uint32_t min_version);
+
+    /* -- mods overlay rescan (live link) ------------------------------------------
+     * Re-index the vfs_mods data overlay (RCU swap: file resolution stays
+     * lock-free) and/or the texrepl texture packs (changed DDS reload by
+     * size/mtime). flags: PS3MOD_RESCAN_*; 0 = both. *out (optional, size
+     * set by the caller) receives the counts. PS3MOD_E_UNAVAILABLE if this
+     * exe has no overlay. */
+    int  (*mods_rescan)(const ps3mod_host* self, uint32_t flags, ps3mod_rescan* out);
+
+    /* -- screenshot -------------------------------------------------------------
+     * Write the next presented frame to path_utf8 (PNG), asynchronously;
+     * completion is a PS3MOD_EV_SCREENSHOT event (result, path) to every
+     * handler. flags: PS3MOD_SHOT_*. */
+    int  (*screenshot)(const ps3mod_host* self, const char* path_utf8, uint32_t flags);
+
+    /* -- debug lines ------------------------------------------------------------
+     * Draw a 2D line list over each presented frame until replaced; n = 0
+     * clears this plugin's lines. flags: PS3MOD_LINES_*. The array is copied. */
+    int  (*debug_lines)(const ps3mod_host* self, const ps3mod_line* v, uint32_t n, uint32_t flags);
+
+    /* -- input (ABI 1.3; see "Input") --------------------------------------------
