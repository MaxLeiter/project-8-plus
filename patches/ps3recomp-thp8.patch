+/* the PASS lock for one save/load pass: 1 = held (or no shared folder), 0 = not in time */
+static int savedata_pass_lock(int is_save)
+{
+    if (!s_shared) return 1;
+    static int timeout_ms = -1;
+    if (timeout_ms < 0) {
+        char e[16];
+        timeout_ms = sd_getenv("PS3_SAVEDATA_LOCK_MS", e, sizeof e) ? atoi(e) : 15000;
+        if (timeout_ms < 0) timeout_ms = 0;
+    }
+    int r = sd_lock_try(SD_LOCK_PASS);
+    if (r < 0) return 1;                                   /* no lock file (read-only folder?): go on as before */
+    if (r == 1) return 1;
+    printf("[cellSaveData] the save folder is busy (another game is %s): waiting up to %d ms\n",
+           "saving or loading", timeout_ms);
+    for (int waited = 0; waited < timeout_ms; waited += 50) {
+        sd_sleep_ms(50);
+        if (sd_lock_try(SD_LOCK_PASS) != 0) {
+            printf("[cellSaveData] the save folder is free again after %d ms\n", waited + 50);
+            return 1;
+        }
+    }
+    printf("[cellSaveData] the save folder stayed busy for %d ms: %s\n", timeout_ms,
+           is_save ? "this save is NOT written (the previous save is kept)" : "loading anyway");
+    return 0;
+}
+
+static void savedata_pass_unlock(void)
+{
+    if (s_shared) sd_lock_release(SD_LOCK_PASS);
+}
