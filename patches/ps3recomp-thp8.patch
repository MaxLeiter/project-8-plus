+typedef struct {
+    char*       key;     /* normalised key, e.g. "PS3_GAME/USRDIR/DATA/PAK/F56B119F.CHK" */
+    char*       host;    /* host path of the mod file */
+    const char* src;     /* "(loose)" or the pack name */
+    uint64_t    size;
+    int64_t     mtime;
+    int         prio;    /* higher wins */
+    volatile long opens, stats;
+    volatile long toolong;   /* times a caller's buffer was too small for host */
