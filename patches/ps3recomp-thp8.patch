+def bitwise(name, xo, fn):
+    def sem(s, f):
+        a = int.from_bytes(s.vr[f.ra], "big")
+        b = int.from_bytes(s.vr[f.rb], "big")
+        s.set_v(f.rt, (fn(a, b) & ((1 << 128) - 1)).to_bytes(16, "big"))
+    vx(name, xo, sem)
+
+
+bitwise("vand", 1028, lambda a, b: a & b)
+bitwise("vandc", 1092, lambda a, b: a & ~b)
+bitwise("vor", 1156, lambda a, b: a | b)
+bitwise("vxor", 1220, lambda a, b: a ^ b)
+bitwise("vnor", 1284, lambda a, b: ~(a | b))
