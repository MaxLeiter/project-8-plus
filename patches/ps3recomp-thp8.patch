diff --git a/runtime/spu/tests/bench_spu_mfc.c b/runtime/spu/tests/bench_spu_mfc.c
new file mode 100644
index 00000000..c43d3573
--- /dev/null
+++ b/runtime/spu/tests/bench_spu_mfc.c
@@ -0,0 +1,429 @@
+/*
+ * Microbenchmark: what one SPU channel / MFC operation costs the host, and how
+ * long the blocking channel handoff (PPU signal -> SPU thread parked in rdch)
+ * takes.
+ *
+ * Part 1 times each operation the way lifted code issues it (spu_wrch /
+ * spu_rdch / spu_rchcnt on a context, the MFC command as its six channel
+ * writes): GET and PUT at 16 B / 128 B / 1 KB / 16 KB, a 16-element list GET,
+ * GETLLAR+PUTLLC, PUTLLUC, WrTagMask + WrTagUpdate(all) + RdTagStat, the
+ * FMOD-mixer block (GET 1 KB, tag wait, PUT 1 KB, tag wait) and the
+ * non-blocking channel reads. Single-threaded; each figure is the median of 15
+ * batches of ~2 ms (min alongside), so a busy machine shows up as spread, not
+ * as a shifted median.
+ *
+ * Part 2 is the FMOD mixer's handoff (fmodmix LS 0x1803C / 0x19BA8): the PPU
+ * writes SNR1 (spu_snr_deliver, what sys_spu_thread_write_snr does), the SPU
+ * thread parked in rdch SNR1 wakes, sends the event back
+ * (sys_spu_thread_send_event: wrch OutMbox, wrch OutIntrMbox, rdch RdInMbox)
+ * and the PPU, blocked on a condition variable the way sys_event_queue_receive
+ * blocks, wakes. Reported per gap between handoffs (back to back, 50 us, 1 ms,
+ * 5 ms = FMOD's ~187 blocks/s): the SPU-side wake latency, the round trip,
+ * their distribution, and the CPU the SPU thread burns per handoff
+ * (GetThreadTimes).
+ *
+ * spu_channels.c is compiled in (file-static engine lookups), as in
+ * test_spu_channels.c. Build: as test_spu_channels.c, with this file instead.
+ * Usage: bench_spu_mfc [ops|handoff|contended|all] (default all).
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <malloc.h>
+
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+#define GUEST_SIZE  0x01000000u        /* 16 MB */
+
+#include "spu_channels.c"
+
+#include <intrin.h>
+static double g_tick_ns;
+static uint64_t qpc(void) { LARGE_INTEGER c; QueryPerformanceCounter(&c); return (uint64_t)c.QuadPart; }
+
+static void     wr(spu_context* c, uint32_t ch, uint32_t v) { spu_wrch(c, ch, spu_make_preferred_u32(v)); }
+static uint32_t rd(spu_context* c, uint32_t ch)             { return spu_rdch(c, ch)._u32[0]; }
+static uint32_t cnt(spu_context* c, uint32_t ch)            { return spu_rchcnt(c, ch); }
+static void mfc(spu_context* c, uint32_t cmd, uint32_t lsa, uint32_t ea, uint32_t size, uint32_t tag)
+{
+    wr(c, MFC_LSA, lsa); wr(c, MFC_EAH, 0); wr(c, MFC_EAL, ea);
+    wr(c, MFC_Size, size); wr(c, MFC_TagID, tag); wr(c, MFC_Cmd, cmd);
+}
+static spu_context* new_ctx(uint32_t id)
+{
+    spu_context* c = (spu_context*)_aligned_malloc(sizeof(spu_context), 128);
+    spu_context_init(c, id);
+    c->status = SPU_STATUS_RUNNING;
+    return c;
+}
+
+static int cmp_d(const void* a, const void* b)
+{
+    double x = *(const double*)a, y = *(const double*)b;
+    return x < y ? -1 : x > y;
+}
+
+/* ---------------------------------------------------------------------------
+ * Part 1: per-operation cost
+ * -----------------------------------------------------------------------*/
+#define EA_BUF   0x00200000u
+#define EA_LIST  0x00300000u
+#define EA_LINE  0x00400000u
+#define EA_ARM   0x00500000u     /* a line reserved once, so the coherence bitmap is armed (as in a game) */
+
+typedef struct { uint32_t cmd, size, lsa, ea; } dma_arg;
+typedef void (*op_fn)(spu_context*, void*);
+
+static void op_dma(spu_context* c, void* p)  { dma_arg* a = (dma_arg*)p; mfc(c, a->cmd, a->lsa, a->ea, a->size, 1); }
+static void op_memcpy_get(spu_context* c, void* p) { dma_arg* a = (dma_arg*)p; memcpy(c->ls + a->lsa, vm_base + a->ea, a->size); }
+static void op_list16(spu_context* c, void* p) { (void)p; mfc(c, MFC_GETL_CMD, 0x9000, 0x800, 16 * 8, 2); }
+static void op_llar_llc(spu_context* c, void* p)
+{
+    (void)p;
+    mfc(c, MFC_GETLLAR_CMD, 0x7000, EA_LINE, 128, 0);
+    c->ls[0x7008]++;
+    mfc(c, MFC_PUTLLC_CMD, 0x7000, EA_LINE, 128, 0);
+    if (rd(c, MFC_RdAtomicStat) != 0) { printf("PUTLLC failed in the benchmark\n"); exit(3); }
+}
+static void op_putlluc(spu_context* c, void* p) { (void)p; c->ls[0x7008]++; mfc(c, MFC_PUTLLUC_CMD, 0x7000, EA_LINE + 128, 128, 0); }
+static void op_tagwait(spu_context* c, void* p)
+{
+    (void)p;
+    wr(c, MFC_WrTagMask, 1u << 1); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL);
+    if (rd(c, MFC_RdTagStat) != 2u) { printf("tag wait wrong\n"); exit(3); }
+}
+static void op_fmod_block(spu_context* c, void* p)
+{
+    (void)p;
+    mfc(c, MFC_GET_CMD, 0x4000, EA_BUF, 1024, 3);
+    wr(c, MFC_WrTagMask, 1u << 3); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL); (void)rd(c, MFC_RdTagStat);
+    mfc(c, MFC_PUT_CMD, 0x4000, EA_BUF + 0x8000, 1024, 3);
+    wr(c, MFC_WrTagMask, 1u << 3); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL); (void)rd(c, MFC_RdTagStat);
+}
+static volatile uint32_t g_sink;
+static void op_rchcnt(spu_context* c, void* p) { g_sink += cnt(c, *(uint32_t*)p); }
+static void op_rdch(spu_context* c, void* p)   { g_sink += rd(c, *(uint32_t*)p); }
+
+/* Each batch is timed by the CPU cycles this thread actually ran
+ * (QueryThreadCycleTime, TSC rate), so time the thread spent preempted --
+ * the machine is shared -- does not count. A busy SMT sibling still slows it;
+ * that shows up as spread, hence median and min of 31 batches. */
+static double g_tsc_per_ns;
+static uint64_t thread_cycles(void)
+{
+    ULONG64 c = 0;
+    QueryThreadCycleTime(GetCurrentThread(), &c);
+    return (uint64_t)c;
+}
+static double bench(const char* name, op_fn op, spu_context* c, void* arg)
+{
+    enum { R = 31 };
+    /* Batch size: ~1 ms of the operation. */
+    unsigned iters = 1;
+    for (;;) {
+        uint64_t t0 = qpc();
+        for (unsigned i = 0; i < iters; i++) op(c, arg);
+        double ns = (double)(qpc() - t0) * g_tick_ns;
+        if (ns > 1e6 || iters > (1u << 24)) break;
+        iters *= 2;
+    }
+    double v[R];
+    for (int r = 0; r < R; r++) {
+        uint64_t t0 = thread_cycles();
+        for (unsigned i = 0; i < iters; i++) op(c, arg);
+        v[r] = (double)(thread_cycles() - t0) / g_tsc_per_ns / iters;
+    }
+    qsort(v, R, sizeof v[0], cmp_d);
+    printf("  %-40s %9.1f ns/op   (min %8.1f, p75 %8.1f)\n", name, v[R / 2], v[0], v[(R * 3) / 4]);
+    return v[R / 2];
+}
+
+static void bench_ops(void)
+{
+    printf("Part 1: per-operation cost (median of 15 batches of ~2 ms)\n");
+    spu_context* c = new_ctx(1);
+    spu_context* arm = new_ctx(2);
+    mfc(arm, MFC_GETLLAR_CMD, 0x7000, EA_ARM, 128, 0);       /* arm the coherence bitmap */
+    for (uint32_t i = 0; i < 0x10000; i++) vm_base[EA_BUF + i] = (uint8_t)(i * 7u);
+    for (uint32_t i = 0; i < 0x40000; i++) c->ls[i] = (uint8_t)(i * 13u);
+    /* THP8 registers its five SPURS job bodies as code overlays, by source
+     * region and by content signature (src/spu_gen/spu_workloads.c), and every
+     * GET is checked against them: register the same number here. */
+    for (int k = 0; k < 5; k++) {
+        uint8_t sig[16]; memset(sig, 0xA5, sizeof sig); sig[0] = (uint8_t)k;
+        spu_overlay_register_region(0x100C4600u + 0x10000u * (uint32_t)k, 0x2000u, 36 + k);
+        spu_overlay_register_sig(sig, 36 + k);
+    }
+
+    static const uint32_t sizes[] = { 16, 128, 1024, 16384 };
+    char name[64];
+    for (int k = 0; k < 4; k++) {
+        dma_arg g = { MFC_GET_CMD, sizes[k], 0x10000, EA_BUF };
+        snprintf(name, sizeof name, "GET %u B", sizes[k]);  bench(name, op_dma, c, &g);
+    }
+    for (int k = 0; k < 4; k++) {
+        dma_arg g = { MFC_PUT_CMD, sizes[k], 0x10000, EA_BUF + 0x8000 };
+        snprintf(name, sizeof name, "PUT %u B", sizes[k]);  bench(name, op_dma, c, &g);
+    }
+    for (int k = 0; k < 4; k++) {
+        dma_arg g = { MFC_GET_CMD, sizes[k], 0x10000, EA_BUF };
+        snprintf(name, sizeof name, "  (memcpy %u B, reference)", sizes[k]); bench(name, op_memcpy_get, c, &g);
+    }
+    for (int i = 0; i < 16; i++) {
+        spu_ls_write32(c, 0x800 + 8u * i, 128);
+        spu_ls_write32(c, 0x804 + 8u * i, EA_BUF + 0x1000u + 0x100u * i);
+    }
+    bench("GETL 16 elements x 128 B", op_list16, c, NULL);
+    bench("GETLLAR + PUTLLC + RdAtomicStat", op_llar_llc, c, NULL);
+    bench("PUTLLUC", op_putlluc, c, NULL);
+    bench("WrTagMask+WrTagUpdate(all)+RdTagStat", op_tagwait, c, NULL);
+    bench("FMOD block: GET 1K, tag, PUT 1K, tag", op_fmod_block, c, NULL);
+    { uint32_t ch;
+      ch = SPU_RdInMbox;     bench("rchcnt RdInMbox (empty)", op_rchcnt, c, &ch);
+      ch = SPU_RdSigNotify1; bench("rchcnt RdSigNotify1", op_rchcnt, c, &ch);
+      ch = SPU_RdEventStat;  bench("rchcnt RdEventStat", op_rchcnt, c, &ch);
+      ch = MFC_Cmd;          bench("rchcnt MFC_Cmd", op_rchcnt, c, &ch);
+      ch = SPU_RdDec;        bench("rdch RdDec", op_rdch, c, &ch);
+      ch = SPU_RdEventMask;  bench("rdch RdEventMask", op_rdch, c, &ch);
+      ch = MFC_RdAtomicStat; bench("rdch MFC_RdAtomicStat", op_rdch, c, &ch);
+      ch = MFC_RdTagStat;    bench("rdch MFC_RdTagStat", op_rdch, c, &ch);
+      ch = SPU_RdEventStat;  bench("rdch RdEventStat (mask 0)", op_rdch, c, &ch); }
+}
+
+/* ---------------------------------------------------------------------------
+ * Part 2: the blocking handoff
+ * -----------------------------------------------------------------------*/
+/* The PPU's event queue, shaped like sys_event_queue_receive / event_queue_push
+ * (runtime/syscalls/sys_event.c): a critical section, a condition variable,
+ * WakeConditionVariable on push. */
+static CRITICAL_SECTION   g_q_lock;
+static CONDITION_VARIABLE g_q_cv;
+static volatile LONG      g_q_count;
+static uint32_t           g_q_last;
+
+/* sys_spu_thread_send_event's lv2 side (spu_deliver_user_event): take data1
+ * from the outbound mailbox, push the event, answer CELL_OK in the inbound
+ * mailbox. */
+static int bench_user_event(spu_context* spu, uint32_t value)
+{
+    uint32_t data = spu_channel_read(&spu->ch_out_mbox);
+    EnterCriticalSection(&g_q_lock);
+    g_q_last = data ^ value;
+    g_q_count++;
+    WakeConditionVariable(&g_q_cv);
+    LeaveCriticalSection(&g_q_lock);
+    spu_channel_write(&spu->ch_in_mbox, 0);
+    return 1;
+}
+static void ppu_receive(void)
+{
+    EnterCriticalSection(&g_q_lock);
+    while (g_q_count == 0) SleepConditionVariableCS(&g_q_cv, &g_q_lock, INFINITE);
+    g_q_count--;
+    LeaveCriticalSection(&g_q_lock);
+}
+
+/* sys_spu_thread_write_snr's SPU side. spu_snr_deliver where the runtime has
+ * it; before it existed the lv2 handler did this inline. */
+static void ppu_write_snr(spu_context* c, int num, uint32_t val)
+{
+#ifdef SPU_HAVE_SNR_DELIVER
+    spu_snr_deliver(c, num, val, 0);
+#else
+    if (spu_snr_write(&c->ch_sig_notify[num], val, 0)) {
+        spu_lockline_lock();
+        c->event_status |= 0x200u >> num;
+        spu_lockline_unlock();
+    }
+    spu_ch_wake(c);
+#endif
+}
+
+#define HO_MAX 4000
+typedef struct {
+    spu_context* c;
+    uint64_t t_wake[HO_MAX];
+    volatile LONG ready;
+} mixer_arg;
+
+static DWORD WINAPI mixer_thread(LPVOID p)
+{
+    mixer_arg* a = (mixer_arg*)p;
+    InterlockedExchange(&a->ready, 1);
+    for (;;) {
+        uint32_t blk = rd(a->c, SPU_RdSigNotify1);          /* parks until the PPU signals */
+        uint64_t t = qpc();
+        if (blk == 0xFFFFFFFFu) break;
+        a->t_wake[blk % HO_MAX] = t;
+        /* sys_spu_thread_send_event(9, blk, ~blk) */
+        if (cnt(a->c, SPU_RdInMbox) != 0) { printf("inbound mailbox not empty\n"); exit(3); }
+        wr(a->c, SPU_WrOutMbox, ~blk);
+        wr(a->c, SPU_WrOutIntrMbox, (9u << 24) | (blk & 0xFFFFFFu));
+        (void)rd(a->c, SPU_RdInMbox);
+    }
+    return 0;
+}
+
+/* CPU a thread has run, in ns (QueryThreadCycleTime: exact, unlike the
+ * clock-tick granular GetThreadTimes). */
+static double thread_cpu_ns(HANDLE h)
+{
+    ULONG64 c = 0;
+    QueryThreadCycleTime(h, &c);
+    return (double)c / g_tsc_per_ns;
+}
+
+static void gap_wait(uint64_t gap_ns, HANDLE timer)
+{
+    if (!gap_ns) return;
+    if (gap_ns < 1000000u) {
+        uint64_t end = qpc() + (uint64_t)((double)gap_ns / g_tick_ns);
+        while (qpc() < end) YieldProcessor();
+        return;
+    }
+    LARGE_INTEGER due; due.QuadPart = -(LONGLONG)(gap_ns / 100u);
+    SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE);
+    WaitForSingleObject(timer, INFINITE);
+}
+
+static void pct(const double* sorted, int n, const char* what)
+{
+    printf("    %-10s p50 %8.1f  p90 %8.1f  p99 %8.1f  max %9.1f us\n", what,
+           sorted[n / 2], sorted[(n * 9) / 10], sorted[(n * 99) / 100], sorted[n - 1]);
+}
+
+/* Havok-shaped lock-line traffic on other lines: a GETLLAR/PUTLLC increment
+ * loop flat out, so the lock-line spinlock is as busy as THP8's job-queue
+ * cellSyncMutex loop keeps it. */
+static volatile LONG g_contend_stop;
+static DWORD WINAPI contend_thread(LPVOID p)
+{
+    spu_context* c = (spu_context*)p;
+    while (!g_contend_stop) {
+        mfc(c, MFC_GETLLAR_CMD, 0x7000, EA_LINE + 0x1000, 128, 0);
+        c->ls[0x7000]++;
+        mfc(c, MFC_PUTLLC_CMD, 0x7000, EA_LINE + 0x1000, 128, 0);
+        (void)rd(c, MFC_RdAtomicStat);
+    }
+    return 0;
+}
+
+static void bench_handoff_gap(uint64_t gap_ns, int n, int contend)
+{
+    static double one[HO_MAX], rt[HO_MAX], wsnr[HO_MAX];
+    static mixer_arg a;
+    memset(&a, 0, sizeof a);
+    a.c = new_ctx(0x200);
+    a.c->ch_block = 1;
+    a.c->spu_group_id = 1;
+    spu_context* cc = NULL; HANDLE hc = NULL;
+    if (contend) {
+        cc = new_ctx(0x201); g_contend_stop = 0;
+        hc = CreateThread(NULL, 0, contend_thread, cc, 0, NULL);
+    }
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+    if (!timer) timer = CreateWaitableTimerW(NULL, FALSE, NULL);
+    HANDLE h = CreateThread(NULL, 0, mixer_thread, &a, 0, NULL);
+    while (!a.ready) Sleep(1);
+    Sleep(20);                                         /* parked */
+#ifdef SPU_HAVE_CH_WAIT_STATS
+    long sl0 = g_spu_ch_sleeps, to0 = g_spu_ch_sleep_timeouts, sp0 = g_spu_ch_spin_hits;
+#endif
+    double cpu0 = thread_cpu_ns(h), ppu0 = thread_cpu_ns(GetCurrentThread());
+    uint64_t w0 = qpc();
+    for (int i = 1; i <= n; i++) {
+        gap_wait(gap_ns, timer);
+        uint64_t t0 = qpc();
+        ppu_write_snr(a.c, 0, (uint32_t)i);              /* sys_spu_thread_write_snr */
+        uint64_t tw = qpc();
+        ppu_receive();                                   /* sys_event_queue_receive */
+        uint64_t t1 = qpc();
+        one[i - 1]  = (double)(a.t_wake[i % HO_MAX] - t0) * g_tick_ns / 1000.0;
+        rt[i - 1]   = (double)(t1 - t0) * g_tick_ns / 1000.0;
+        wsnr[i - 1] = (double)(tw - t0) * g_tick_ns / 1000.0;
+    }
+    uint64_t w1 = qpc();
+    double cpu1 = thread_cpu_ns(h), ppu1 = thread_cpu_ns(GetCurrentThread());
+    ppu_write_snr(a.c, 0, 0xFFFFFFFFu);
+    WaitForSingleObject(h, 5000); CloseHandle(h); CloseHandle(timer);
+    if (contend) { InterlockedExchange(&g_contend_stop, 1); WaitForSingleObject(hc, 5000); CloseHandle(hc); }
+    qsort(one, (size_t)n, sizeof one[0], cmp_d);
+    qsort(rt, (size_t)n, sizeof rt[0], cmp_d);
+    qsort(wsnr, (size_t)n, sizeof wsnr[0], cmp_d);
+    double wall_s = (double)(w1 - w0) * g_tick_ns / 1e9;
+    printf("  gap %6.0f us%s, %d handoffs:  SPU thread CPU %.2f us/handoff (%.1f%% of a core), PPU thread %.2f us/handoff (incl. its gap spin)\n",
+           gap_ns / 1000.0, contend ? " +lock-line load" : "", n, (cpu1 - cpu0) / 1000.0 / n,
+           (cpu1 - cpu0) / 1e9 / wall_s * 100.0, (ppu1 - ppu0) / 1000.0 / n);
+#ifdef SPU_HAVE_CH_WAIT_STATS
+    printf("    waits: %ld slept, %ld missed wakes (ready at the 10 ms re-poll), %ld caught by the spin\n",
+           g_spu_ch_sleeps - sl0, g_spu_ch_sleep_timeouts - to0, g_spu_ch_spin_hits - sp0);
+#endif
+    pct(one, n, "SPU wake");
+    pct(rt, n, "round trip");
+    pct(wsnr, n, "write_snr");
+    extern void spu_coh_unregister(spu_context*);
+    spu_coh_unregister(a.c); spu_mfc_release(a.c); _aligned_free(a.c);
+    if (cc) { spu_coh_unregister(cc); spu_mfc_release(cc); _aligned_free(cc); }
+}
+
+static void bench_handoff(int contend)
+{
+    printf("Part 2: FMOD-mixer handoff (write SNR1 -> SPU wakes in rdch -> send_event -> PPU wakes)%s\n",
+           contend ? ", with a Havok-like GETLLAR/PUTLLC loop on another thread" : "");
+    InitializeCriticalSection(&g_q_lock);
+    InitializeConditionVariable(&g_q_cv);
+    g_spu_user_event_hook = bench_user_event;
+    if (!contend) {
+        bench_handoff_gap(0, 3000, 0);
+        bench_handoff_gap(10000, 2000, 0);
+        bench_handoff_gap(50000, 2000, 0);
+        bench_handoff_gap(1000000, 400, 0);
+        bench_handoff_gap(5000000, 200, 0);
+    } else {
+        bench_handoff_gap(10000, 2000, 1);
+        bench_handoff_gap(5000000, 200, 1);
+    }
+    g_spu_user_event_hook = NULL;
+    DeleteCriticalSection(&g_q_lock);
+}
+
+/* ---------------------------------------------------------------------------
+ * Symbols the runtime pulls in from the rest of the port (as in
+ * test_spu_channels.c). None is on a path this drives.
+ * -----------------------------------------------------------------------*/
+uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid, g_ydkj_real_spurs_ea;
+uint32_t g_barrier_sync_watch;
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int      g_resv_store_active;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; }
+unsigned long long ps3_ms_now(void) { return GetTickCount64(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+uint64_t spurs_pm_build_context(uint8_t* ls, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{ (void)ls; (void)a; (void)b; (void)c; (void)d; return 0; }
+void ydkj_wake_all_event_flags(void) {}
+
+int main(int argc, char** argv)
+{
+    const char* what = argc > 1 ? argv[1] : "all";
+    vm_base = (uint8_t*)VirtualAlloc(NULL, GUEST_SIZE, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!vm_base) { printf("cannot allocate guest memory\n"); return 2; }
+    ppu_vm_size = GUEST_SIZE;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    /* The idle-poll park is its own mechanism (test_spu_idle_poll.c); a
+     * benchmark loop that re-reads the same line must not trip it. */
+    _putenv("SPU_POLL_PARK=0");
+    { LARGE_INTEGER f; QueryPerformanceFrequency(&f); g_tick_ns = 1e9 / (double)f.QuadPart; }
+    { uint64_t q0 = qpc(), c0 = __rdtsc(); Sleep(50); uint64_t q1 = qpc(), c1 = __rdtsc();
+      g_tsc_per_ns = (double)(c1 - c0) / ((double)(q1 - q0) * g_tick_ns); }
+    { SYSTEM_INFO si; GetSystemInfo(&si);
+      printf("bench_spu_mfc: %lu logical CPUs, QPC %.1f ns/tick, TSC %.3f GHz, process priority class 0x%lX\n",
+             si.dwNumberOfProcessors, g_tick_ns, g_tsc_per_ns, GetPriorityClass(GetCurrentProcess())); }
+    if (!strcmp(what, "all") || !strcmp(what, "ops")) bench_ops();
+    if (!strcmp(what, "all") || !strcmp(what, "handoff")) bench_handoff(0);
+    if (!strcmp(what, "all") || !strcmp(what, "contended")) bench_handoff(1);
+    return 0;
+}
diff --git a/runtime/spu/tests/spu_float_oracle.py b/runtime/spu/tests/spu_float_oracle.py
new file mode 100644
index 00000000..89a2a4dd
--- /dev/null
+++ b/runtime/spu/tests/spu_float_oracle.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""spu_float_oracle.py -- exact-rational oracle for SPU single precision.
+
+Reads lines "op a b c result" (hex words; op in fa fs fm fma fms fnms csflt<i8>)
+produced by test_spu_float.exe --dump N and checks every result against an
+independent model written with Python Fractions straight from the SPU ISA
+rules: zero-exponent operands are zero, exponent 255 is an ordinary exponent,
+one rounding toward zero to a 24-bit significand, results below 2^-126 are +0,
+results at or beyond 2^129 saturate to sign|0x7FFFFFFF.
+"""
+import sys
+from fractions import Fraction
+
+
+def dec(x):
+    e = (x >> 23) & 0xFF
+    if e == 0:
+        return Fraction(0)
+    m = (x & 0x7FFFFF) | 0x800000
+    v = Fraction(m) * Fraction(2) ** (e - 150)
+    return -v if x >> 31 else v
+
+
+def enc(v):
+    if v == 0:
+        return 0
+    s = 1 if v < 0 else 0
+    v = abs(v)
+    if v < Fraction(2) ** -126:
+        return 0
+    if v >= Fraction(2) ** 129:
+        return (s << 31) | 0x7FFFFFFF
+    e = 0
+    while v >= 2:
+        v /= 2; e += 1
+    while v < 1:
+        v *= 2; e -= 1
+    m = int(v * (1 << 23))            # truncation toward zero (v > 0)
+    field = e + 127
+    assert 1 <= field <= 255
+    return (s << 31) | (field << 23) | (m & 0x7FFFFF)
+
+
+def model(op, a, b, c):
+    A, B, C = dec(a), dec(b), dec(c)
+    if op == "fa": return enc(A + B)
+    if op == "fs": return enc(A - B)
+    if op == "fm": return enc(A * B)
+    if op == "fma": return enc(A * B + C)
+    if op == "fms": return enc(A * B - C)
+    if op == "fnms": return enc(C - A * B)
+    if op.startswith("csflt"):
+        i8 = int(op[5:])
+        iv = a - (1 << 32) if a & 0x80000000 else a
+        return enc(Fraction(iv) * Fraction(2) ** (i8 - 155))
+    raise ValueError(op)
+
+
+def main():
+    bad = n = 0
+    for line in sys.stdin:
+        f = line.split()
+        if len(f) != 5:
+            continue
+        op = f[0]
+        a, b, c, r = (int(t, 16) for t in f[1:])
+        want = model(op, a, b, c)
+        n += 1
+        if want != r:
+            bad += 1
+            if bad <= 20:
+                print(f"MISMATCH {op} {a:08X} {b:08X} {c:08X}: runtime {r:08X} oracle {want:08X}")
+    print(f"oracle: {n} results checked, {bad} mismatches")
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/runtime/spu/tests/spucheck/gen_spucheck.py b/runtime/spu/tests/spucheck/gen_spucheck.py
new file mode 100644
index 00000000..0f2b6ee1
--- /dev/null
+++ b/runtime/spu/tests/spucheck/gen_spucheck.py
@@ -0,0 +1,990 @@
+#!/usr/bin/env python3
+"""gen_spucheck.py -- case generator for the SPU per-instruction differential
+harness (runtime/spu/tests/spucheck, see spucheck_main.c).
+
+1. Enumerates every mnemonic the REAL decoder (tools/spu_disasm.py) knows by
+   sweeping all 2048 primary opcodes with several operand-bit fillings -- no
+   hand-written opcode list, so a decoder table change shows up here.
+2. For each mnemonic generates many encodings: register patterns (r0/r1/r127,
+   rt==ra, rt==rb, ...), edge + random immediates (all 128 i7 values, all 256
+   i8 values, i10/i16/i18 boundaries), branch forms with landing pads.
+3. Lays each case out as its own lifted function in a raw 256 KB LS image:
+       A+0  insn
+       A+4  stop 0x3FF1        fall-through exit
+      [A+8  stop 0x3FF2]       in-function branch target (conditional branches)
+   plus landing pads (one-word functions `stop 0x2xxx`) for brsl/brasl.
+4. Lifts each image with the real tools/spu_lifter.py (functions JSON, unique
+   --symbol-prefix) and writes spck_cases.inc for the driver.
+
+    python gen_spucheck.py --out <dir> [--seed N] [--scale F]
+"""
+import argparse
+import json
+import os
+import random
+import re
+import struct
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.abspath(os.path.join(HERE, "..", "..", "..", ".."))
+TOOLS = os.path.join(REPO, "tools")
+sys.path.insert(0, TOOLS)
+import spu_disasm as D  # noqa: E402
+
+SENT1, SENT2 = 0x3FF1, 0x3FF2       # in-function exits
+PAD_CODE0, PAD_CODE_MAX = 0x2000, 0x2FFF
+RESERVED_STOP = set(range(0x3FF0, 0x3FF4)) | set(range(PAD_CODE0, PAD_CODE_MAX + 1))
+LS_SIZE = 0x40000
+CASE_LO, CASE_HI = 0x00010, 0x3FFF0
+MAX_CASES_PER_IMAGE = 1400
+
+# ---------------------------------------------------------------------------
+# Operand-role formats (how to build encodings). The OPCODES come from the
+# decoder sweep; this only says what the operand fields mean.
+# ---------------------------------------------------------------------------
+RR3 = """a sf ah sfh and or xor nand nor andc orc eqv ceq ceqh ceqb cgt cgth cgtb clgt
+clgth clgtb mpy mpyu mpyh mpyhh mpys mpyhhu absdb avgb sumb cg bg shl shlh rot
+roth rotm rotma rothm rotmah shlqbi rotqbi rotqmbi shlqby rotqby rotqmby
+shlqbybi rotqbybi rotqmbybi cbx chx cwx cdx fa fs fm fceq fcgt fcmeq fcmgt fi
+dfa dfs dfm dfceq dfcgt dfcmeq dfcmgt addx sfx cgx bgx mpyhha mpyhhau dfma dfms
+dfnms dfnma""".split()
+RR2 = "clz cntb gb gbh gbb fsm fsmh fsmb xsbh xshw xswd orx frest frsqest fesd frds".split()
+RRR = "selb shufb mpya fma fms fnms".split()
+RI7 = """roti rotmi rotmai shli rothi rothmi rotmahi shlhi cbd chd cwd cdd rotqbii
+rotqmbii shlqbii rotqbyi rotqmbyi shlqbyi dftsv""".split()
+RI8 = "cflts cfltu csflt cuflt".split()
+RI10 = """ai sfi ahi sfhi andi ori xori andhi orhi xorhi andbi orbi xorbi ceqi ceqhi
+ceqbi cgti cgthi cgtbi clgti clgthi clgtbi mpyi mpyui""".split()
+FMT = {}
+for m in RR3: FMT[m] = "rr3"
+for m in RR2: FMT[m] = "rr2"
+for m in RRR: FMT[m] = "rrr"
+for m in RI7: FMT[m] = "ri7"
+for m in RI8: FMT[m] = "ri8"
+for m in RI10: FMT[m] = "ri10"
+FMT.update({
+    "lqd": "ri10ls", "stqd": "ri10ls",
+    "heqi": "ri10halt", "hgti": "ri10halt", "hlgti": "ri10halt",
+    "heq": "rrhalt", "hgt": "rrhalt", "hlgt": "rrhalt",
+    "lqx": "rr3", "stqx": "rr3",
+    "il": "ri16", "ilh": "ri16", "ilhu": "ri16", "iohl": "ri16", "fsmbi": "ri16",
+    "lqa": "ri16ls", "stqa": "ri16ls", "lqr": "ri16ls", "stqr": "ri16ls",
+    "ila": "ri18",
+    "hbr": "hint", "hbra": "hint7", "hbrr": "hint7",
+    "nop": "nop", "lnop": "nop", "sync": "nop", "dsync": "nop", "syncc": "nop",
+    "stop": "stop", "stopd": "stopd",
+    "rdch": "chr", "rchcnt": "chr", "wrch": "chw",
+    "mfspr": "sprr", "mtspr": "sprw", "fscrrd": "rr2", "fscrwr": "rr2",
+    "br": "br", "bra": "br", "brsl": "brsl", "brasl": "brsl",
+    "brz": "brc", "brnz": "brc", "brhz": "brc", "brhnz": "brc",
+    "bi": "bi", "bisl": "bisl", "bisled": "bisl", "iret": "iret",
+    "biz": "bic", "binz": "bic", "bihz": "bic", "bihnz": "bic",
+})
+OPBITS = {"rr3": 11, "rr2": 11, "rrhalt": 11, "hint": 11, "nop": 11, "stop": 11, "stopd": 11,
+          "chr": 11, "chw": 11, "sprr": 11, "sprw": 11, "bi": 11, "bisl": 11, "iret": 11,
+          "bic": 11, "ri7": 11, "ri8": 10, "ri10": 8, "ri10ls": 8, "ri10halt": 8,
+          "ri16": 9, "ri16ls": 9, "hint7": 7, "br": 9, "brsl": 9, "brc": 9, "ri18": 7, "rrr": 4}
+# Registers used as LINK registers (brsl/brasl/bisl/bisled rt). Kept to a small
+# set so `bi $rN` cases on other registers exercise the lifter's generic
+# indirect path, while these exercise its link-return classification.
+LINK_REGS = [0, 1, 3, 4, 80, 127]
+
+
+def sweep_decoder():
+    rng = random.Random(12345)
+    fills = [0, 0x1FFFFF, 0x0AAAAA, 0x155555] + [rng.getrandbits(21) for _ in range(12)]
+    by_mn = {}
+    for op11 in range(2048):
+        for f in fills:
+            mn = D.spu_decode((op11 << 21) | f, 0).mnemonic
+            by_mn.setdefault(mn, set()).add(op11)
+    by_mn.pop(".word", None)
+    return by_mn
+
+
+def opcode_prefix(mn, op11s, nbits):
+    """The opcode value (nbits wide) of a mnemonic; checks the decoder maps the
+    whole aligned block (every operand-bit filling) to it."""
+    shift = 11 - nbits
+    prefixes = sorted({o >> shift for o in op11s})
+    problems = []
+    for p in prefixes:
+        blk = set(range(p << shift, (p + 1) << shift))
+        if not blk <= op11s and mn not in ("sync", "syncc"):
+            problems.append(f"{mn}: opcode block 0x{p:X}/{nbits} only partially decodes")
+    return prefixes, problems
+
+
+# ---------------------------------------------------------------------------
+class Image:
+    def __init__(self, idx, lo=CASE_LO, hi=CASE_HI, stem="spck"):
+        self.idx = idx
+        self.words = {}          # addr -> word
+        self.funcs = []          # (start, end)
+        self.pads = {}           # addr -> code
+        self.reserved = set()    # word addrs claimed but not code (stub targets)
+        self.lo, self.hi = lo, hi
+        self.cursor = lo
+        self.next_pad_code = PAD_CODE0
+        self.cases = []
+        self.stem = stem
+
+    def is_free(self, a, n=1):
+        if a < 0 or a + 4 * n > LS_SIZE:
+            return False
+        return all((a + 4 * k) not in self.words and (a + 4 * k) not in self.reserved
+                   for k in range(n))
+
+    def alloc(self, nwords):
+        a = self.cursor
+        while a + 4 * nwords <= self.hi:
+            if self.is_free(a, nwords):
+                self.cursor = a + 4 * nwords
+                return a
+            a += 4
+        return None
+
+    def pad_at(self, addr):
+        """A landing-pad function at addr (new or shared). None if occupied."""
+        if addr in self.pads:
+            return self.pads[addr]
+        if not self.is_free(addr) or self.next_pad_code > PAD_CODE_MAX:
+            return None
+        code = self.next_pad_code
+        self.next_pad_code += 1
+        self.pads[addr] = code
+        self.words[addr] = code          # stop <code>
+        self.funcs.append((addr, addr + 4))
+        return code
+
+    def place(self, a, insn, nexits, meta):
+        self.words[a] = insn
+        self.words[a + 4] = SENT1
+        if nexits == 2:
+            self.words[a + 8] = SENT2
+        self.funcs.append((a, a + 4 + 4 * nexits))
+        meta.update(addr=a, insn=insn, exit2=(a + 8 if nexits == 2 else 0), img=self.idx)
+        self.cases.append(meta)
+
+
+# ---------------------------------------------------------------------------
+class Gen:
+    def __init__(self, seed, scale):
+        self.rng = random.Random(seed)
+        self.scale = scale
+        self.images = [Image(0)]
+        self.problems = []
+
+    @property
+    def img(self):
+        return self.images[-1]
+
+    def new_image_if_full(self):
+        if len(self.img.cases) >= MAX_CASES_PER_IMAGE:
+            self.images.append(Image(len(self.images)))
+
+    def n(self, base):
+        return max(4, int(base * self.scale))
+
+    # -- register patterns ---------------------------------------------------
+    def regs(self, k):
+        r = self.rng
+        fixed = [
+            lambda: (r.randrange(2, 127), r.randrange(2, 127), r.randrange(2, 127), r.randrange(2, 127)),
+            lambda: (127, 0, 1, 2), lambda: (0, 127, 1, 126), lambda: (1, 1, 1, 1),
+            lambda: (5, 5, 9, 13), lambda: (6, 10, 6, 14), lambda: (7, 11, 11, 15),
+            lambda: (8, 12, 16, 8), lambda: (9, 9, 9, 20), lambda: (127, 127, 0, 0),
+            lambda: (0, 0, 0, 0), lambda: (2, 3, 4, 2),
+        ]
+        out = [f() for f in fixed]
+        while len(out) < k:
+            pat = r.randrange(6)
+            a, b, c, d = (r.randrange(128) for _ in range(4))
+            if pat == 1: b = a
+            elif pat == 2: c = a
+            elif pat == 3: c = b
+            elif pat == 4: d = a
+            out.append((a, b, c, d))
+        r.shuffle(out)
+        return out[:k] if k >= len(fixed) else out[:k]
+
+    def edge_i10(self, k):
+        e = [0, 1, -1, 2, 15, 16, 127, -128, 128, -129, 255, -256, 256, 511, -512, 0x7F, 0x80, -0x80, -0x81, 0xFF, 0x100]
+        while len(e) < k:
+            e.append(self.rng.randrange(-512, 512))
+        return e[:k]
+
+    def edge_i16(self, k):
+        e = [0, 1, -1, 2, 0x7F, 0x80, 0xFF, 0x100, 0x7FFF, -0x8000, -0x7FFF, 0x8000 - 2, 0x1234, -0x1234, 0xFFFF, 0x7F7F, 0x5555]
+        e = [((x + 0x8000) & 0xFFFF) - 0x8000 for x in e]
+        while len(e) < k:
+            e.append(self.rng.randrange(-0x8000, 0x8000))
+        return e[:k]
+
+    # -- encoders ----------------------------------------------------------
+    @staticmethod
+    def rr(op11, rt, ra, rb):
+        return (op11 << 21) | ((rb & 0x7F) << 14) | ((ra & 0x7F) << 7) | (rt & 0x7F)
+
+    @staticmethod
+    def ri10(op8, rt, ra, i10):
+        return (op8 << 24) | ((i10 & 0x3FF) << 14) | ((ra & 0x7F) << 7) | (rt & 0x7F)
+
+    @staticmethod
+    def ri16(op9, rt, i16):
+        return (op9 << 23) | ((i16 & 0xFFFF) << 7) | (rt & 0x7F)
+
+    def add(self, mn, insn, nexits=1, **extra):
+        self.new_image_if_full()
+        a = self.img.alloc(1 + nexits)
+        if a is None:
+            self.images.append(Image(len(self.images)))
+            a = self.img.alloc(1 + nexits)
+        meta = dict(mn=mn, ovr_reg=-1, ovr_val=0, ovr_mode=0)
+        meta.update(extra)
+        self.img.place(a, insn, nexits, meta)
+        return a
+
+    # -- per format --------------------------------------------------------
+    def gen_mnemonic(self, mn, op, fmt):
+        r = self.rng
+        if fmt in ("rr3", "rrhalt"):
+            for (rt, ra, rb, _) in self.regs(self.n(32)):
+                self.add(mn, self.rr(op, rt, ra, rb))
+        elif fmt == "rr2":
+            for i, (rt, ra, rb, _) in enumerate(self.regs(self.n(24))):
+                self.add(mn, self.rr(op, rt, ra, rb if i % 3 == 0 else 0))
+        elif fmt == "rrr":
+            for (rt, ra, rb, rc) in self.regs(self.n(32)):
+                self.add(mn, (op << 28) | (rt << 21) | (rb << 14) | (ra << 7) | rc)
+        elif fmt == "ri7":
+            pats = self.regs(128)
+            for i7 in range(128):
+                rt, ra, _, _ = pats[i7]
+                self.add(mn, self.rr(op, rt, ra, i7))
+        elif fmt == "ri8":
+            pats = self.regs(64)
+            for i8 in range(256):
+                rt, ra, _, _ = pats[i8 % 64]
+                self.add(mn, (op << 22) | (i8 << 14) | (ra << 7) | rt)
+        elif fmt in ("ri10", "ri10ls", "ri10halt"):
+            imms = self.edge_i10(self.n(48))
+            pats = self.regs(len(imms))
+            for i10, (rt, ra, _, _) in zip(imms, pats):
+                self.add(mn, self.ri10(op, rt, ra, i10))
+        elif fmt in ("ri16", "ri16ls"):
+            imms = self.edge_i16(self.n(48))
+            pats = self.regs(len(imms))
+            for i16, (rt, _, _, _) in zip(imms, pats):
+                self.add(mn, self.ri16(op, rt, i16))
+        elif fmt == "ri18":
+            imms = [0, 1, 0x3FFFF, 0x1FFFF, 0x20000, 0x10000, 0xFFFF, 0x8000, 0x3FFFC]
+            while len(imms) < self.n(32):
+                imms.append(r.randrange(0x40000))
+            for i18, (rt, _, _, _) in zip(imms, self.regs(len(imms))):
+                self.add(mn, (op << 25) | (i18 << 7) | rt)
+        elif fmt in ("hint", "hint7"):
+            w = 25 if fmt == "hint7" else 21
+            for k in range(self.n(16)):
+                self.add(mn, (op << w) | r.getrandbits(w))
+        elif fmt == "nop":
+            for k in range(self.n(12)):
+                lo = r.getrandbits(21)
+                if mn == "sync": lo &= ~0x00100000
+                if mn == "syncc": lo |= 0x00100000
+                if k == 0: lo = 0x00100000 if mn == "syncc" else 0
+                self.add(mn, (op << 21) | lo)
+        elif fmt == "stop":
+            codes = [0, 1, 0x102, 0x110, 0x3FFF, 0x1FFF, 0x3000, 0x0FFF, 0x3FEF, 0x2]
+            while len(codes) < self.n(24):
+                c = r.randrange(0x4000)
+                if c not in RESERVED_STOP:
+                    codes.append(c)
+            for i, c in enumerate(codes):
+                junk = (r.getrandbits(7) << 14) if i % 4 == 3 else 0     # reserved bits
+                self.add(mn, (op << 21) | junk | c)
+        elif fmt == "stopd":
+            for k in range(self.n(8)):
+                self.add(mn, (op << 21) | (r.getrandbits(21) if k else 0))
+        elif fmt == "chr":
+            chans = list(range(32)) + [r.randrange(32, 128) for _ in range(self.n(16))] + [127]
+            for ch in chans:
+                self.add(mn, self.rr(op, r.randrange(128), ch, r.randrange(128) if ch & 1 else 0))
+        elif fmt == "chw":
+            chans = list(range(32)) + [r.randrange(32, 128) for _ in range(self.n(16))] + [127]
+            for ch in chans:
+                self.add(mn, self.rr(op, r.randrange(128), ch, 0))
+        elif fmt in ("sprr", "sprw"):
+            for k in range(self.n(16)):
+                self.add(mn, self.rr(op, r.randrange(128), r.randrange(128), 0))
+        elif fmt == "br":
+            self.gen_br(mn, op)
+        elif fmt == "brsl":
+            self.gen_brsl(mn, op)
+        elif fmt == "brc":
+            self.gen_brc(mn, op)
+        elif fmt in ("bi", "bic", "bisl", "iret"):
+            self.gen_bi(mn, op, fmt)
+        else:
+            self.problems.append(f"{mn}: no generator for format {fmt}")
+
+    # -- branches ------------------------------------------------------------
+    def target(self, mn, a, i16):
+        if mn in ("bra", "brasl"):
+            return (i16 << 2) & 0x3FFFC
+        return (a + (i16 << 2)) & 0x3FFFC
+
+    def peek(self, nwords):
+        """Address the next add() of nwords will get (cursor left there)."""
+        self.new_image_if_full()
+        a = self.img.alloc(nwords)
+        if a is None:
+            self.images.append(Image(len(self.images)))
+            a = self.img.alloc(nwords)
+        self.img.cursor = a
+        return a
+
+    def place_direct(self, mn, op, rt, i16, stub):
+        """Place a direct branch (br/bra/brsl/brasl/brz...) whose target leaves
+        the case function. The target must be a landing pad (a one-word
+        function `stop <code>`) or an address that is no lifted function at
+        all (the lifter emits an indirect-dispatch stub for it) -- never the
+        start of another case's function: the runtime's SPU_XFER is a direct
+        musttail jump into the target while interrupts are disabled, so the
+        lifted run would go on executing that other case. Relative forms move
+        the case until the target fits, absolute forms move the target."""
+        r = self.rng
+        absolute = mn in ("bra", "brasl")
+        for attempt in range(400):
+            a = self.peek(2)
+            img = self.img
+            t = self.target(mn, a, i16)
+            if t == a or (absolute and t == a + 4):
+                img.cursor = a + 4
+                if absolute:
+                    i16 = r.randrange(-0x8000, 0x8000) or 1
+                continue
+            if t == a + 4:                   # in-function target (the fall-through exit)
+                self.add(mn, self.ri16(op, rt, i16))
+                return True
+            if stub and img.is_free(t):
+                img.reserved.add(t)
+                self.add(mn, self.ri16(op, rt, i16), stub_target=t)
+                return True
+            if not stub and (t in img.pads or img.is_free(t)):
+                if img.pad_at(t) is not None:
+                    self.add(mn, self.ri16(op, rt, i16), pad=t)
+                    return True
+            img.cursor = a + 4               # target taken: move the case ...
+            if absolute:                     # ... or the absolute target
+                i16 = r.randrange(-0x8000, 0x8000) or 1
+        self.problems.append(f"{mn}: could not place i16={i16}")
+        return False
+
+    def gen_br(self, mn, op):
+        for k, i16 in enumerate(self.edge_i16(self.n(48))):
+            if i16 == 0:
+                i16 = 5                      # `br .` is a deliberate trap the lifter halts on
+            self.place_direct(mn, op, self.rng.randrange(128), i16, stub=(k % 3 == 2))
+
+    def gen_brsl(self, mn, op):
+        r = self.rng
+        imms = [1, 2, -1, -2, 3, 0x7FFF, -0x8000, 0x4000, -0x4000, 0x100, -0x100]
+        while len(imms) < self.n(56):
+            imms.append(r.randrange(-0x8000, 0x8000))
+        for k, i16 in enumerate(imms):
+            if i16 == 0:
+                continue                     # `brsl rt, .` trap idiom: not a call
+            rt = LINK_REGS[k % len(LINK_REGS)]
+            self.place_direct(mn, op, rt, i16, stub=(k % 5 == 4))
+
+    def gen_brc(self, mn, op):
+        pats = self.regs(self.n(64))
+        for k, (rt, _, _, _) in enumerate(pats):
+            if k % 2 == 0:
+                self.add(mn, self.ri16(op, rt, 2), nexits=2)        # in-function target A+8
+            else:
+                i16 = self.edge_i16(48)[k % 48] if k < 40 else self.rng.randrange(-0x8000, 0x8000)
+                if i16 in (0, 2):
+                    i16 = 3
+                self.place_direct(mn, op, rt, i16, stub=(k % 4 == 3))
+
+    def gen_bi(self, mn, op, fmt):
+        r = self.rng
+        pats = self.regs(self.n(48))
+        for k, (rt, ra, rb, _) in enumerate(pats):
+            de = [0, 0, 0x00040000, 0x00080000][k % 4]               # E / D bits (never both)
+            if fmt == "bisl":
+                rt = LINK_REGS[k % len(LINK_REGS)]
+            if fmt == "bi" and k % 3 == 0:
+                ra = 0                                                # `bi $r0` = SPU_RET path
+            if fmt in ("bisl", "bic") and k % 5 == 2:
+                ra = rt                    # rt == ra: link/condition register is also the target
+            insn = (op << 21) | de | ((ra & 0x7F) << 7) | (rt & 0x7F)
+            if k % 7 == 6:
+                insn |= (r.getrandbits(5) << 14) & ~0x000C0000 & 0x001FC000   # reserved bits
+            # deterministic target patterns in RA on even seeds (odd seeds: random)
+            base = r.randrange(0x40, 0x3FFF0) & ~3
+            ovr = [base, base | 3, base | 1, 0xFFFC0000 | base, 0x80000002 | base, 0x3FFFC][k % 6]
+            self.add(mn, insn, ovr_reg=(ra if fmt != "iret" else -1),
+                     ovr_val=ovr, ovr_mode=(2 if fmt != "iret" else 0))
+
+
+# ---------------------------------------------------------------------------
+# SEQUENCE mode: random multi-instruction programs lifted as whole functions.
+#
+# Each program lives in a "spsq" image (code at SEQ_LO..SEQ_HI, a 4 KB data
+# window at SEQ_WIN the driver re-randomises per seed) and is
+#     ila  $r1, SEQ_WIN+0x800        window base, never written again
+#     <segments>                     straight-line blocks of int / SP / DP /
+#                                    shuffle / load-store / channel / misc
+#                                    instructions over a SMALL register pool
+#                                    (aliasing-heavy), forward conditional
+#                                    skips, `br` over dead code, counted loops
+#                                    (in-function back edge), calls into leaf
+#                                    functions (brsl $r0 ... bi $r0), a rare
+#                                    halt or conditional exit to a landing pad
+#     stop 0x3FF1 | bi $rX | br <pad> | brsl $r0,<pad>
+#   [leaf functions: a few instructions + bi $r0]
+# Stores only reach the window: stqd off $r1 (+-2 KB), stqx $r1 + (andi'd
+# index, emitted as one unit), stqa / stqr with computed window addresses.
+# Loads may read anywhere (all three local stores are identical).
+# ---------------------------------------------------------------------------
+SEQ_LO, SEQ_HI = 0x20000, 0x3DFF0
+SEQ_WIN = 0x3E000                 # data window [0x3E000, 0x3F000)
+SEQ_BASE_REG, SEQ_CNT_REG = 1, 126
+SEQ_END = 0x3FF1
+
+SEQ_MEM = "lqd stqd lqx stqx lqa stqa lqr stqr".split()
+SEQ_SPF = """fa fs fm fma fms fnms fceq fcgt fcmeq fcmgt fi frest frsqest cflts cfltu csflt
+cuflt""".split()
+SEQ_DPF = "dfa dfs dfm dfma dfms dfnms dfnma dfceq dfcgt dfcmeq dfcmgt dftsv fesd frds".split()
+SEQ_SHUF = """shufb selb rotqby rotqbyi rotqbybi rotqbi rotqbii shlqby shlqbyi shlqbybi shlqbi
+shlqbii rotqmby rotqmbyi rotqmbybi rotqmbi rotqmbii cbd chd cwd cdd cbx chx cwx cdx fsm fsmh fsmb
+fsmbi gb gbh gbb orx""".split()
+SEQ_MISC = "nop lnop hbr hbra hbrr sync dsync syncc rdch rchcnt wrch mfspr mtspr fscrrd fscrwr".split()
+SEQ_HALT = "heq hgt hlgt heqi hgti hlgti".split()
+SEQ_SKIP = set(SEQ_MEM) | set(SEQ_MISC) | set(SEQ_HALT) | {"stop", "stopd", "iret"}
+
+
+class SeqGen:
+    def __init__(self, g, by_mn, seed):
+        self.g = g
+        self.r = random.Random(seed)
+        self.op = {}
+        for mn, op11s in by_mn.items():
+            if mn in FMT:
+                self.op[mn] = opcode_prefix(mn, op11s, OPBITS[FMT[mn]])[0][0]
+        body = [m for m in self.op if FMT[m] in ("rr3", "rr2", "rrr", "ri7", "ri8", "ri10", "ri16", "ri18")
+                and m not in SEQ_SKIP]
+        self.cat = {
+            "spf": [m for m in SEQ_SPF if m in self.op],
+            "dpf": [m for m in SEQ_DPF if m in self.op],
+            "shuf": [m for m in SEQ_SHUF if m in self.op],
+            "mem": [m for m in SEQ_MEM if m in self.op],
+            "misc": [m for m in SEQ_MISC if m in self.op],
+            "halt": [m for m in SEQ_HALT if m in self.op],
+        }
+        used = set().union(*[set(v) for v in self.cat.values()])
+        self.cat["int"] = sorted(m for m in body if m not in used)
+        self.images = []
+        self.listing = []
+
+    # -- operand helpers ----------------------------------------------------
+    def i10(self):
+        r = self.r
+        return r.choice([0, 1, -1, 2, -2, 15, 16, 127, -128, 255, -256, 511, -512, r.randrange(-512, 512),
+                         r.randrange(-512, 512)])
+
+    def i16(self):
+        r = self.r
+        return r.choice([0, 1, -1, 0x7FFF, -0x8000, 0x3F80, 0xBF80 - 0x10000, 0x4B00, 0x7F7F,
+                         r.randrange(-0x8000, 0x8000), r.randrange(-0x8000, 0x8000)])
+
+    def encode(self, mn, rt, ra, rb, rc):
+        """One body instruction: rt destination, ra/rb/rc sources."""
+        r, op, f = self.r, self.op[mn], FMT[mn]
+        G = Gen
+        if f == "rr3":
+            return G.rr(op, rt, ra, rb)
+        if f == "rr2":
+            return G.rr(op, rt, ra, rb if r.random() < 0.2 else 0)
+        if f == "rrr":
+            return (op << 28) | (rt << 21) | (rb << 14) | (ra << 7) | rc
+        if f == "ri7":
+            return G.rr(op, rt, ra, r.choice([0, 1, 7, 8, 15, 16, 31, 32, 63, 64, 127, r.randrange(128)]))
+        if f == "ri8":
+            return (op << 22) | (r.choice([155, 156, 173, 174, 0, 255, r.randrange(256)]) << 14) | (ra << 7) | rt
+        if f == "ri10":
+            return G.ri10(op, rt, ra, self.i10())
+        if f == "ri16":
+            return G.ri16(op, rt, self.i16())
+        if f == "ri18":
+            v = r.randrange(0x40000)
+            if SEQ_LO <= v < SEQ_HI:           # never an in-code address (jump-table recogniser)
+                v |= 1
+            return (op << 25) | (v << 7) | rt
+        raise ValueError(mn)
+
+    def body_insn(self, flavor, pool, dests, items):
+        """Append one body instruction (or an atomic pair) to items."""
+        r = self.r
+        w = {"int": 40, "spf": 14, "dpf": 6, "shuf": 16, "mem": 12, "misc": 2, "halt": 0.3}
+        if flavor == "float":
+            w.update(spf=45, dpf=10, int=20)
+        elif flavor == "shuf":
+            w.update(shuf=45, int=25)
+        elif flavor == "mem":
+            w.update(mem=35)
+        elif flavor == "dp":
+            w.update(dpf=40, spf=10)
+        cat = r.choices(list(w), weights=list(w.values()))[0]
+        mn = r.choice(self.cat[cat])
+        rt = r.choice(dests)
+        ra, rb, rc = (r.choice(pool) for _ in range(3))
+        if r.random() < 0.06:
+            ra = r.choice([0, SEQ_BASE_REG, r.randrange(2, 126)])   # an outside source now and then
+        G, op = Gen, self.op[mn]
+        if mn in ("lqd", "stqd"):
+            items.append(("w", G.ri10(op, rt, SEQ_BASE_REG, r.randrange(-0x80, 0x80)), mn))
+        elif mn in ("lqx", "stqx"):
+            ri = r.choice(dests)
+            items.append(("pair", [G.ri10(self.op["andi"], ri, r.choice(pool), 0x1F0),
+                                   G.rr(op, rt, SEQ_BASE_REG, ri)], mn))
+        elif mn in ("lqa", "stqa"):
+            items.append(("w", G.ri16(op, rt, r.randrange(-0x800, -0x400)), mn))
+        elif mn in ("lqr", "stqr"):
+            items.append(("rel", op, rt, SEQ_WIN + 16 * r.randrange(256), mn))
+        elif mn in ("rdch", "rchcnt", "wrch"):
+            items.append(("w", G.rr(op, rt, r.randrange(32), 0), mn))
+        elif mn in ("mfspr", "mtspr"):
+            items.append(("w", G.rr(op, rt, r.randrange(128), 0), mn))
+        elif FMT[mn] in ("nop", "hint", "hint7"):
+            wd = 25 if FMT[mn] == "hint7" else 21
+            lo = r.getrandbits(wd)
+            if mn == "sync":
+                lo &= ~0x00100000
+            if mn == "syncc":
+                lo |= 0x00100000
+            items.append(("w", (op << wd) | lo, mn))
+        elif mn in ("heq", "hgt", "hlgt"):
+            items.append(("w", G.rr(op, 0, ra, rb), mn))
+        elif mn in ("heqi", "hgti", "hlgti"):
+            items.append(("w", G.ri10(op, 0, ra, self.i10()), mn))
+        else:
+            items.append(("w", self.encode(mn, rt, ra, rb, rc), mn))
+
+    def straight(self, n, flavor, pool, dests, items):
+        for _ in range(n):
+            self.body_insn(flavor, pool, dests, items)
+
+    # -- one program -----------------------------------------------------------
+    def program(self, kind, k):
+        r = self.r
+        size = r.randrange(3, 11)
+        pool = r.sample([0] + list(range(2, 126)) + [127], size)
+        pool = [x for x in pool if x not in (SEQ_BASE_REG, SEQ_CNT_REG)] or [2, 3]
+        dests = list(pool)
+        if kind == "call":
+            dests = [x for x in dests if x != 0] or [2]
+        flavor = r.choice(["mix", "mix", "int", "float", "shuf", "mem", "dp"])
+        items = [("w", (self.op["ila"] << 25) | ((SEQ_WIN + 0x800) << 7) | SEQ_BASE_REG, "ila")]
+        leaves = []
+        nlab = [0]
+
+        def lab():
+            nlab[0] += 1
+            return f"L{nlab[0]}"
+
+        target = r.randrange(8, 33)
+        count = 0
+        while count < target:
+            seg = "straight"
+            if kind == "branch":
+                seg = r.choice(["straight", "skip", "skip", "jump", "exitpad", "exitind", "straight"])
+            elif kind == "loop" and count >= 2:
+                seg = r.choice(["straight", "loop", "loop"])
+            elif kind == "call" and count >= 1:
+                seg = r.choice(["straight", "call", "call"])
+            if seg == "straight":
+                n = r.randrange(1, 9)
+                self.straight(n, flavor, pool, dests, items)
+                count += n
+            elif seg == "skip":
+                L = lab()
+                items.append(("b", r.choice(["brz", "brnz", "brhz", "brhnz"]), r.choice(pool), L))
+                n = r.randrange(1, 7)
+                self.straight(n, flavor, pool, dests, items)
+                items.append(("lbl", L))
+                count += n + 1
+            elif seg == "jump":
+                L = lab()
+                items.append(("b", "br", 0, L))
+                for _ in range(r.randrange(1, 4)):
+                    if r.random() < 0.3:
+                        items.append(("w", 0x3FF3, "stop"))            # dead: never executed
+                    else:
+                        self.body_insn(flavor, pool, dests, items)
+                items.append(("lbl", L))
+                count += 2
+            elif seg == "exitpad":
+                items.append(("bpad", r.choice(["brz", "brnz", "brhz", "brhnz"]), r.choice(pool)))
+                count += 1
+            elif seg == "loop":
+                H = lab()
+                items.append(("w", Gen.ri16(self.op["il"], SEQ_CNT_REG, r.randrange(1, 5)), "il"))
+                items.append(("lbl", H))
+                n = r.randrange(2, 9)
+                self.straight(n, flavor, pool, [d for d in dests], items)
+                items.append(("w", Gen.ri10(self.op["ai"], SEQ_CNT_REG, SEQ_CNT_REG, -1), "ai"))
+                items.append(("b", "brnz", SEQ_CNT_REG, H))
+                count += n + 3
+            elif seg == "call":
+                # brsl $r0 / brsl $rL (non-r0 link, leaf returns via bi $rL) /
+                # ila $rT,leaf + bisl $r0,$rT / bisl $rT,$rT (the leaf's bi $r0
+                # then does NOT return: the run ends there, in every executor)
+                L = f"leaf{len(leaves)}"
+                v = r.random()
+                link = 0 if v < 0.5 or v >= 0.7 else r.choice([3, 4, 5, 6, 8, 78, 79])
+                ldests = [d for d in dests if d != link] or [2]
+                li = [("lbl", L)]
+                self.straight(r.randrange(1, 7), flavor, pool, ldests, li)
+                li.append(("w", Gen.rr(self.op["bi"], 0, link, 0), "bi"))
+                leaves.append(li)
+                if v < 0.7:
+                    items.append(("bcall", L, link))
+                else:
+                    rt = r.choice(dests)
+                    items.append(("ilalbl", rt, L))
+                    lk = rt if v >= 0.92 else 0
+                    de = r.choice([0, 0, 0x40000, 0x80000])
+                    items.append(("w", Gen.rr(self.op["bisl"], lk, rt, 0) | de, "bisl"))
+                count += 1
+            elif seg == "exitind":
+                de = r.choice([0, 0, 0x40000, 0x80000])
+                mn = r.choice(["biz", "binz", "bihz", "bihnz"])
+                tgt = r.choice([0] + pool)
+                items.append(("w", Gen.rr(self.op[mn], r.choice(pool), tgt, 0) | de, mn))
+                count += 1
+        # the exit
+        e = r.random()
+        if e < 0.8:
+            items.append(("w", SEQ_END, "stop"))
+        elif e < 0.88:
+            de = r.choice([0, 0, 0x40000, 0x80000])
+            items.append(("w", Gen.rr(self.op["bi"], 0, r.choice([x for x in pool if x != 0] or [2]), 0) | de, "bi"))
+        elif e < 0.9:
+            items.append(("w", Gen.rr(self.op["iret"], 0, 0, 0) | r.choice([0, 0x40000, 0x80000]), "iret"))
+        elif e < 0.95:
+            items.append(("bpad", "br", 0))
+        else:
+            items.append(("bpad", "brsl", 0))
+        # Split the main body into several lifted functions now and then:
+        # fall-through chaining (SPU_XFER into the next function), a branch
+        # to a label that became a function start (cross-function conditional
+        # transfer, a loop whose back edge is a tail jump). The program's
+        # code range is unchanged; the run continues through all of them.
+        # A branch whose label ends up in another function must target that
+        # function's START (a mid-function target is an unlifted entry: the
+        # runtime falls back to its dispatcher, the lifted run cannot follow
+        # it) -- so such labels are split too, until no branch crosses a
+        # split into the middle of a function.
+        psplit = {"line": 0.2, "branch": 0.6, "loop": 0.6, "call": 0.4}[kind]
+        if r.random() < psplit:
+            cut = set()
+            for i, it in enumerate(items):
+                if i > 0 and ((it[0] == "lbl" and r.random() < 0.6) or r.random() < 0.06):
+                    cut.add(i)
+            lab_at = {it[1]: i for i, it in enumerate(items) if it[0] == "lbl"}
+            changed = True
+            while changed:
+                changed = False
+                seg, k = [], 0
+                for i in range(len(items)):
+                    k += i in cut
+                    seg.append(k)
+                for i, it in enumerate(items):
+                    if it[0] == "b":
+                        li = lab_at[it[3]]
+                        if seg[li] != seg[i] and li not in cut:
+                            cut.add(li)
+                            changed = True
+            out = []
+            for i, it in enumerate(items):
+                if i in cut:
+                    out.append(("split",))
+                out.append(it)
+            items = out
+        return items, leaves, flavor
+
+    def layout(self, img, items, leaves):
+        """Place main + leaves contiguously; returns (lo, hi, [(addr, word)]) or None."""
+        r = self.r
+        nwords = sum(2 if it[0] == "pair" else 0 if it[0] in ("lbl", "split") else 1
+                     for blk in [items] + leaves for it in blk)
+        a0 = img.alloc(nwords)
+        if a0 is None:
+            return None
+        labels, a = {}, a0
+        funcs = []
+        for block in [items] + leaves:
+            start = a
+            for it in block:
+                if it[0] == "split":
+                    if a > start:
+                        funcs.append((start, a))
+                    start = a
+                elif it[0] == "lbl":
+                    labels[it[1]] = a
+                else:
+                    a += 8 if it[0] == "pair" else 4
+            funcs.append((start, a))
+        hi = a
+        out = []
+        a = a0
+        for block in [items] + leaves:
+            for it in block:
+                t = it[0]
+                if t in ("lbl", "split"):
+                    continue
+                if t == "w":
+                    out.append((a, it[1], it[2]))
+                elif t == "pair":
+                    out.append((a, it[1][0], "andi")); out.append((a + 4, it[1][1], it[2])); a += 4
+                elif t == "rel":
+                    _, op, rt, tgt, mn = it
+                    out.append((a, Gen.ri16(op, rt, (tgt - a) >> 2), mn))
+                elif t == "b":
+                    _, mn, reg, L = it
+                    out.append((a, Gen.ri16(self.op[mn], reg, (labels[L] - a) >> 2), mn))
+                elif t == "bcall":
+                    out.append((a, Gen.ri16(self.op["brsl"], it[2], (labels[it[1]] - a) >> 2), "brsl"))
+                elif t == "ilalbl":
+                    out.append((a, (self.op["ila"] << 25) | (labels[it[2]] << 7) | it[1], "ila"))
+                elif t == "bpad":
+                    _, mn, reg = it
+                    pad = None
+                    for _ in range(200):
+                        cand = r.randrange(max(0x10, a - 0x1F000), 0x1FFF0) & ~3
+                        if cand in img.pads or img.is_free(cand):
+                            pad = cand
+                            break
+                    if pad is None or img.pad_at(pad) is None:
+                        out.append((a, SEQ_END, "stop"))
+                    else:
+                        out.append((a, Gen.ri16(self.op[mn], reg, (pad - a) >> 2), mn))
+                a += 4
+        for addr, w, _ in out:
+            img.words[addr] = w
+        img.funcs.extend(funcs)
+        return a0, hi, out
+
+    def generate(self, nprog, first_idx):
+        kinds = (["line"] * 10 + ["branch"] * 4 + ["loop"] * 3 + ["call"] * 3)
+        img = None
+        for k in range(nprog):
+            kind = kinds[k % len(kinds)]
+            items, leaves, flavor = self.program(kind, k)
+            for attempt in range(2):
+                if img is None:
+                    img = Image(first_idx + len(self.images), SEQ_LO, SEQ_HI, stem="spsq")
+                    self.images.append(img)
+                placed = self.layout(img, items, leaves)
+                if placed:
+                    break
+                img = None
+            if not placed:
+                self.g.problems.append(f"seq program {k}: could not place")
+                continue
+            lo, hi, out = placed
+            nf = sum(1 for it in items if it[0] == "split") + 1
+            meta = dict(mn="seq." + kind, ovr_reg=-1, ovr_val=0, ovr_mode=0, addr=lo, insn=out[0][1],
+                        exit2=0, img=img.idx, seq_hi=hi, nins=len(out), flavor=flavor)
+            img.cases.append(meta)
+            self.listing.append((img, f"== seq.{kind} #{k} img {{img}} @0x{lo:05X}..0x{hi:05X} "
+                                      f"flavor={flavor} {len(out)} words, main in {nf} lifted function(s)"))
+            for addr, w, mn in out:
+                d = D.spu_decode(w, addr)
+                self.listing.append((None, f"  {addr:05X}: {w:08X}  {d.mnemonic:<10s} {d.operands}"))
+
+
+# ---------------------------------------------------------------------------
+def lift_api(img, blob, funcs, prefix, outdir, stem):
+    """The lifter's own main() sequence (tools/spu_lifter.py), driven through
+    its API. Only the claimed code words are disassembled (the CLI also
+    decodes the 64K background words of the image, which makes its O(funcs x
+    insns) passes take minutes); each function body is lifted from exactly
+    the same instructions either way. --cli runs the real command line."""
+    import spu_lifter as L
+    insns = [D.spu_decode(w, a) for a, w in sorted(img.words.items())]
+    lifter = L.SPULifter(prefix=prefix)
+    lifter.bi_r0_jump = L.compute_bi_r0_jumps(insns, funcs)
+    lifter.link_return = L.compute_link_returns(insns, funcs)
+    lifter.jump_tables = L.compute_jump_tables(insns, blob, 0, funcs)
+    lifter.func_starts = {s for s, e in funcs}
+    by_addr = {i.addr: i for i in insns}
+    for s, e in funcs:
+        lifter.lift_function([by_addr[a] for a in range(s, e, 4) if a in by_addr], s, e)
+    with open(os.path.join(outdir, stem + ".h"), "w") as f:
+        f.write(lifter.emit_header())
+    with open(os.path.join(outdir, stem + ".c"), "w") as f:
+        f.write(lifter.emit_source(stem + ".h"))
+    with open(os.path.join(outdir, stem + "_lift.log"), "w") as f:
+        f.write(f"{len(lifter.functions)} functions, bi_r0_jump={len(lifter.bi_r0_jump)} "
+                f"link_return={len(lifter.link_return)} jump_tables={len(lifter.jump_tables)} "
+                f"unsupported={lifter.unsupported}\n")
+
+
+def c_str(s):
+    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seed", type=int, default=20261004)
+    ap.add_argument("--scale", type=float, default=1.0)
+    ap.add_argument("--python", default=sys.executable)
+    ap.add_argument("--only", default="", help="comma list of mnemonics (debug)")
+    ap.add_argument("--cli", action="store_true", help="lift through the spu_lifter.py command line (slow)")
+    ap.add_argument("--seq", type=int, default=300, help="sequence-mode programs (0 = none)")
+    ap.add_argument("--seq-seed", type=int, default=None, help="sequence generator seed (default: --seed + 1)")
+    args = ap.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+
+    by_mn = sweep_decoder()
+    g = Gen(args.seed, args.scale)
+    only = set(x for x in args.only.split(",") if x)
+    unknown = sorted(m for m in by_mn if m not in FMT)
+    missing = sorted(m for m in FMT if m not in by_mn)
+    if unknown:
+        g.problems.append("decoder knows mnemonics the harness has no format for: " + " ".join(unknown))
+    if missing:
+        g.problems.append("harness formats for mnemonics the decoder never produces: " + " ".join(missing))
+
+    # Branch/pad cases first (they claim fixed target addresses), then the rest.
+    order = sorted(by_mn, key=lambda m: (0 if FMT.get(m) in ("brsl", "br", "brc") else 1, m))
+    for mn in order:
+        if mn not in FMT or (only and mn not in only):
+            continue
+        fmt = FMT[mn]
+        prefixes, probs = opcode_prefix(mn, by_mn[mn], OPBITS[fmt])
+        g.problems.extend(probs)
+        for p in prefixes:
+            g.gen_mnemonic(mn, p, fmt)
+
+    # Sequence programs (their own images), unless --only excludes them.
+    sq = SeqGen(g, by_mn, args.seq_seed if args.seq_seed is not None else args.seed + 1)
+    if args.seq > 0 and (not only or "seq" in only):
+        sq.generate(args.seq, len(g.images))
+
+    # ---- emit images, lift them -------------------------------------------
+    lifter = os.path.join(TOOLS, "spu_lifter.py")
+    inc = ["/* GENERATED by gen_spucheck.py -- do not edit. */"]
+    case_rows = []
+    all_cases = 0
+    unsupported = {}
+    all_imgs = [i for i in g.images + sq.images if i.cases]
+    for ii, img in enumerate(all_imgs):
+        img.idx = ii                     # dense: the driver indexes spck_images[] by it
+        blob = bytearray(LS_SIZE)
+        for a, w in img.words.items():
+            struct.pack_into(">I", blob, a, w)
+        stem = f"{img.stem}{img.idx}"
+        bin_path = os.path.join(args.out, stem + ".bin")
+        with open(bin_path, "wb") as f:
+            f.write(blob)
+        funcs = sorted(img.funcs)
+        with open(os.path.join(args.out, stem + "_funcs.json"), "w") as f:
+            json.dump([{"start": s, "end": e} for s, e in funcs], f)
+        prefix = f"{stem}_"
+        if args.cli:
+            cmd = [args.python, lifter, bin_path, "--base", "0", "--functions",
+                   os.path.join(args.out, stem + "_funcs.json"), "--symbol-prefix", prefix,
+                   "--output", args.out, "--header-name", stem + ".h", "--source-name", stem + ".c"]
+            res = subprocess.run(cmd, capture_output=True, text=True)
+            with open(os.path.join(args.out, stem + "_lift.log"), "w") as f:
+                f.write(res.stdout + res.stderr)
+            if res.returncode != 0:
+                sys.stderr.write(res.stdout + res.stderr)
+                sys.exit("lifter failed on " + stem)
+        else:
+            lift_api(img, bytes(blob), funcs, prefix, args.out, stem)
+        hdr = open(os.path.join(args.out, stem + ".h")).read()
+        names = sorted(set(re.findall(r"void (" + re.escape(prefix) + r"spu_func_([0-9A-F]{8}))\(spu_context\* ctx\);", hdr)))
+        src = open(os.path.join(args.out, stem + ".c")).read()
+        for m in re.finditer(r'spu_unsupported\(0x([0-9A-F]+), "([^"]+)"\)', src):
+            unsupported[m.group(2)] = unsupported.get(m.group(2), 0) + 1
+        fnaddr = {int(a, 16): n for n, a in names}
+        inc.append(f"/* image {img.idx}: {len(img.cases)} cases, {len(funcs)} functions, {len(img.pads)} pads */")
+        for n, a in names:
+            inc.append(f"void {n}(spu_context*);")
+        inc.append(f"static const spck_fn spck_fns{img.idx}[] = {{")
+        for a in sorted(fnaddr):
+            inc.append(f"    {{ 0x{a:05X}u, {fnaddr[a]} }},")
+        inc.append("};")
+        inc.append(f"static const spck_pad spck_pads{img.idx}[] = {{")
+        for a in sorted(img.pads):
+            inc.append(f"    {{ 0x{img.pads[a]:04X}u, 0x{a:05X}u }},")
+        inc.append("    { 0, 0 }")
+        inc.append("};")
+        inc.append(f"static const spck_range spck_code{img.idx}[] = {{")
+        for a in sorted(set(img.words) | img.reserved):
+            inc.append(f"    {{ 0x{a:05X}u, {1 if a in img.words else 0} }},")
+        inc.append("};")
+        for c in img.cases:
+            c["img"] = img.idx
+            d = D.spu_decode(c["insn"], c["addr"])
+            ops = d.operands
+            if c.get("seq_hi"):
+                ops = f"{c['nins']} words, {c['flavor']}, LS 0x{c['addr']:05X}..0x{c['seq_hi']:05X}"
+            fn = fnaddr.get(c["addr"])
+            if fn is None:
+                g.problems.append(f"case 0x{c['addr']:X} {c['mn']}: no lifted function")
+                fn = "0"
+            case_rows.append(
+                f"    {{ {img.idx}, 0x{c['addr']:05X}u, 0x{c['insn']:08X}u, 0x{c['exit2']:05X}u, "
+                f"{c['ovr_reg']}, 0x{c['ovr_val'] & 0xFFFFFFFF:08X}u, {c['ovr_mode']}, "
+                f"{c_str(c['mn'] if c.get('seq_hi') else d.mnemonic)}, {c_str(ops)}, {fn}, "
+                f"0x{c.get('seq_hi', 0):05X}u }},")
+            all_cases += 1
+    with open(os.path.join(args.out, "spsq_listing.txt"), "w") as f:
+        for img, line in sq.listing:
+            f.write((line.replace("{img}", str(img.idx)) if img is not None else line) + "\n")
+    inc.append("static const spck_image spck_images[] = {")
+    for img in all_imgs:
+        if img.cases:
+            inc.append(f'    {{ "{img.stem}{img.idx}.bin", spck_fns{img.idx}, sizeof spck_fns{img.idx} / sizeof spck_fns{img.idx}[0], '
+                       f"spck_pads{img.idx}, spck_code{img.idx}, sizeof spck_code{img.idx} / sizeof spck_code{img.idx}[0] }},")
+    inc.append("};")
+    inc.append("static const spck_case spck_cases[] = {")
+    inc.extend(case_rows)
+    inc.append("};")
+    with open(os.path.join(args.out, "spck_cases.inc"), "w") as f:
+        f.write("\n".join(inc) + "\n")
+
+    cov = {}
+    for img in all_imgs:
+        for c in img.cases:
+            cov[c["mn"]] = cov.get(c["mn"], 0) + 1
+    nmn = len([m for m in cov if not m.startswith("seq.")])
+    summary = {"mnemonics_decoder": len(by_mn), "mnemonics_covered": nmn, "cases": all_cases,
+               "images": len(all_imgs), "per_mnemonic": cov,
+               "seq_programs": sum(1 for i in sq.images for c in i.cases),
+               "seq_words": sum(c["nins"] for i in sq.images for c in i.cases),
+               "lifter_unsupported": unsupported, "problems": g.problems}
+    with open(os.path.join(args.out, "gen_summary.json"), "w") as f:
+        json.dump(summary, f, indent=1, sort_keys=True)
+    print(f"[gen] {len(by_mn)} decoder mnemonics, {nmn} covered, {all_cases} cases "
+          f"({summary['seq_programs']} sequence programs, {summary['seq_words']} words) in "
+          f"{summary['images']} image(s)")
+    if unsupported:
+        print("[gen] lifter emitted spu_unsupported for: " + ", ".join(f"{k}x{v}" for k, v in sorted(unsupported.items())))
+    for p in g.problems:
+        print("[gen] PROBLEM: " + p)
+
+
+if __name__ == "__main__":
+    main()
