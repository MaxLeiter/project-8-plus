+/* LD_ZVIEW_FULL=1: the Y16_X16 view always covers the whole zeta snapshot
+ * (the pre-fix behaviour, A/B only). Default: the view covers exactly the
+ * guest texture's declared width x height from the zeta's origin -- what RSX
+ * reads for a texture at that address and pitch. THP8's goal viewport (the
+ * camcorder picture-in-picture of a photo/film goal) renders 640x360 into
+ * the top-left of a zeta first used by a 1280x720 pass and binds it as a
+ * 640x360 Y16_X16 texture for its fog/haze pass; a view of the whole
+ * 1280x720 snapshot made every normalised lookup land twice as far from the
+ * origin, mostly on cleared depth -> full fog -> sky over most of the panel. */
+static int ld_zview_full(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("LD_ZVIEW_FULL") ? 1 : 0;
+    return v;
+}
+
+/* SRV slot for texture unit `unit` reading zeta `zindex`'s Y16_X16 view
+ * through `remap`, as a texture of guest size tw x th, rebuilding the view
+ * first when the R32F snapshot is newer (the caller has already resolved
+ * that) or the texture size changed. When the view cannot be rebuilt
+ * (descriptor ring exhausted) the previous one is used, one snapshot behind
+ * (*stale = 1); SRV_WHITE when there is none or it cannot be created. */
+static u32 zdepth_view_y16(u32 zindex, u32 remap, u32 unit, u32 tw, u32 th, int* stale)
+{
+    zdepth_t* z = &g.zdepths[zindex];
+    *stale = 0;
+    if (!z->snapshot || !z->snapshot_valid || !g.depth_y16x16_pso ||
+        unit >= SRV_TABLE_SIZE)
+        return SRV_WHITE;
+    if (ld_zview_full() || !tw || !th || tw > 4096u || th > 4096u) {
+        tw = z->snapshot_w; th = z->snapshot_h;
+    }
+    const u32 vhw = tw == z->snapshot_w ? z->snapshot_hw : ld_scaled(tw, z->sx);
+    const u32 vhh = th == z->snapshot_h ? z->snapshot_hh : ld_scaled(th, z->sy);
+    if (z->view_y16 && (z->view_y16_hw != vhw || z->view_y16_hh != vhh)) {
+        /* another texture size over this zeta: the view is rebuilt at it */
+        retire_texture(z->view_y16);
+        z->view_y16 = NULL;
+        z->view_y16_valid = 0;
+    }
+    if (!z->view_y16) {
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        rd.Width = vhw;
+        rd.Height = vhh;
+        rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1;
+        rd.Format = DXGI_FORMAT_R16G16_UNORM;
+        rd.SampleDesc.Count = 1;
+        rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(
+                g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL,
+                &IID_ID3D12Resource, (void**)&z->view_y16))) {
+            z->view_y16 = NULL;
+            return SRV_WHITE;
+        }
+        z->view_y16_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        z->view_y16_valid = 0;
+        D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {0};
+        ud.Format = DXGI_FORMAT_R16G16_UNORM;
+        ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        g.dev->lpVtbl->CreateUnorderedAccessView(
+            g.dev, z->view_y16, NULL, &ud, srv_cpu(UAV_ZVIEW_BASE + zindex));
+        z->view_y16_tw = tw; z->view_y16_th = th;
+        z->view_y16_hw = vhw; z->view_y16_hh = vhh;
+        { static u32 said = 0;
+          if (said++ < 24)
+              fprintf(stderr, "[zetaview] Y16_X16 view of zeta #%u %u:0x%X as %ux%u texture: %ux%u "
+                      "(snapshot %ux%u)\n", zindex, z->location, z->offset, tw, th, vhw, vhh,
+                      z->snapshot_hw, z->snapshot_hh); }
+    }
+    const u32 slot = SRV_ZVIEW_UNIT_BASE + unit;
+    srv_write_zview_y16(zindex, remap, slot);
+    if (z->view_y16_valid && z->view_y16_serial == z->snapshot_serial)
+        return slot;
+
+    /* t0 = the snapshot's R32F SRV, u0 = the view's UAV. */
+    if (g.srv_ring_used >= SRV_RING_TABLES) {
+        if (!z->view_y16_valid) return SRV_WHITE;
+        *stale = 1;
+        return slot;
+    }
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    cpu.ptr = ld_heap_cpu(g.srv_heap);
+    cpu.ptr += (size_t)base * g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(
+        g.dev, 1, cpu, srv_cpu(SRV_ZDEPTH_BASE + zindex),
+        D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    cpu.ptr += g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(
+        g.dev, 1, cpu, srv_cpu(UAV_ZVIEW_BASE + zindex),
+        D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE source_table, destination_table;
+    source_table.ptr = ld_heap_gpu(g.srv_heap);
+    source_table.ptr += (u64)base * g.srv_step;
+    destination_table = source_table;
+    destination_table.ptr += g.srv_step;
+
+    const D3D12_RESOURCE_STATES snapshot_read =
+        D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE |
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    D3D12_RESOURCE_BARRIER bars[2] = {0};
+    u32 nbar = 0;
+    if (z->snapshot_state != snapshot_read) {
+        bars[nbar].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        bars[nbar].Transition.pResource = z->snapshot;
+        bars[nbar].Transition.Subresource =
+            D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        bars[nbar].Transition.StateBefore = z->snapshot_state;
+        bars[nbar].Transition.StateAfter = snapshot_read;
+        nbar++;
+        z->snapshot_state = snapshot_read;
+    }
+    if (z->view_y16_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        bars[nbar].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        bars[nbar].Transition.pResource = z->view_y16;
+        bars[nbar].Transition.Subresource =
+            D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        bars[nbar].Transition.StateBefore = z->view_y16_state;
+        bars[nbar].Transition.StateAfter =
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        nbar++;
+    }
+    if (nbar) ldl_ResourceBarrier(nbar, bars);
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    ldl_SetDescriptorHeaps(2, heaps);
+    ldl_SetPipelineState(g.depth_y16x16_pso);
+    ld_cl_invalidate();
+    ldl_SetComputeRootSignature(g.depth_snapshot_rootsig);
+    ldl_SetComputeRootDescriptorTable(0, source_table);
+    ldl_SetComputeRootDescriptorTable(1, destination_table);
+    depth_snapshot_set_size(vhw, vhh, tw, th);
+    ldl_Dispatch((vhw + 7u) / 8u, (vhh + 7u) / 8u, 1);
+    D3D12_RESOURCE_BARRIER done = {0};
+    done.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    done.Transition.pResource = z->view_y16;
+    done.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    done.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    done.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    ldl_ResourceBarrier(1, &done);
+    z->view_y16_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    z->view_y16_valid = 1;
+    z->view_y16_serial = z->snapshot_serial;
+    g_ld_zview_frame.y16_rebuilds++;
+    return slot;
+}
+
+/* What a texture unit reads when its address is a tracked zeta:
+ *   LD_ZVIEW_COMPARE  depth format + zfunc 1..6: the depth-compare result
+ *                     (rsx_fp_decompile_shadow), bound to the R32F snapshot.
+ *                     No snapshot: white = depth 1.0, i.e. a map cleared to
+ *                     the far plane -- unshadowed for GREATER/GEQUAL/NOTEQUAL
+ *                     (THP8: GREATER), and the same emulation of a cleared
+ *                     map for LESS/LEQUAL/EQUAL.
+ *   LD_ZVIEW_DEPTH    DEPTH24_D8_FLOAT / DEPTH16 / DEPTH16_FLOAT read raw
+ *                     (DEPTH24_D8 keeps its original path below). Binds
+ *                     (d,d,d,1) like that path's snapshot SRV; RPCS3 gives
+ *                     depth formats (d,d,d,d) and applies the remap.
+ *   LD_ZVIEW_Y16X16   Y16_X16 reinterpretation (THP8 DOF)
+ * 0 = not a zeta view; the unit keeps the colour-alias/guest-decode path. */
+enum { LD_ZVIEW_NONE = 0, LD_ZVIEW_COMPARE, LD_ZVIEW_DEPTH, LD_ZVIEW_Y16X16 };
+
+static u32 ld_tex_base_format(const rsx_dsp_texture* t)
+{
+    return t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
+}
+
+/* RSX zfunc (1..6) when the unit's state asks for a depth comparison, else 0.
+ * Mirrors RPCS3's shadow_textures rule: a depth format, 2D, zfunc strictly
+ * between NEVER and ALWAYS, and no alpha kill (TEXTURE_CONTROL0 bit 2). */
+static u32 ld_tex_compare_zfunc(const rsx_dsp_texture* t)
+{
+    if (!t->enabled || t->cubemap || !ld_zeta_views_enabled()) return 0;
+    const u32 base = ld_tex_base_format(t);
+    if (base < TEX_FMT_DEPTH24_D8 || base > TEX_FMT_DEPTH16_FLOAT) return 0;
+    const u32 zf = t->wrap >> 28;
+    if (zf < 1 || zf > 6) return 0;
+    if ((t->control0 >> 2) & 1u) return 0;
+    return zf;
+}
+
+/* The zfunc a unit's depth compare is emulated with (rsx_fp_decompile_shadow),
+ * else 0. Not for a texel-addressed (UNNORM) unit: rsx_fp_apply_unnorm_scale
+ * only rescales .Sample() call sites, so rsx_zcmp<u> would get texel
+ * coordinates (one clamped edge texel); such a unit keeps the pre-zeta-view
+ * path (ld_tex_zeta_view_kind). */
+static u32 ld_tex_shadow_zfunc(const rsx_dsp_texture* t)
+{
+    if (t->format & TEX_FMT_UNNORM) return 0;
+    return ld_tex_compare_zfunc(t);
+}
+
+static u32 ld_tex_zeta_view_kind(const rsx_dsp_texture* t)
+{
+    if (!t->enabled || t->cubemap || !ld_zeta_views_enabled()) return LD_ZVIEW_NONE;
+    if (ld_tex_compare_zfunc(t))
+        return (t->format & TEX_FMT_UNNORM) ? LD_ZVIEW_NONE : LD_ZVIEW_COMPARE;
+    const u32 base = ld_tex_base_format(t);
+    if (base == TEX_FMT_DEPTH24_D8_FLOAT || base == TEX_FMT_DEPTH16 ||
+        base == TEX_FMT_DEPTH16_FLOAT)
+        return LD_ZVIEW_DEPTH;
+    if (base == TEX_FMT_Y16_X16) return LD_ZVIEW_Y16X16;
+    return LD_ZVIEW_NONE;
+}
+
+static u64 g_ld_zview_binds[4];   /* per LD_ZVIEW_* kind, for the frame stats */
+
+/* The current draw writes its zeta: the same test that sets had_write after
+ * the draw (sink_end_impl). */
+static int ld_draw_writes_depth(void)
+{
+    render_state_t rs;
+    decode_render_state(&rs);
+    return rs.depth_test && rs.depth_write;
+}
+
+/* Texture units a fragment program samples, cached per program so neither
+ * get_pso's shadow key nor the zeta-view bind walks the FP on every draw.
+ * `pkey` is get_pso's key up to the cube/vtex masks: VP bytes, the FP bytes
+ * (literal) or its structural hash (buffered: every instruction word, so
+ * every unit field) and the control bits. Direct-mapped; a miss walks the
+ * program once. Returns all sampled units; *tex_txp gets the TEX/TXP ones. */
+typedef struct { u64 pkey; u32 all, tex_txp; } ld_fp_unit_entry;
+static ld_fp_unit_entry g_ld_fp_units[4096];   /* every draw looks up here now (get_pso cube/unnorm key) */
+
+static u32 ld_fp_unit_masks(u64 pkey, const u8* fp_uc, u32 fp_size,
+                            u32* tex_txp)
+{
+    ld_fp_unit_entry* e = &g_ld_fp_units[(pkey ^ (pkey >> 29)) & 4095u];
+    if (!pkey || e->pkey != pkey) {
+        e->all = rsx_fp_texture_unit_masks(fp_uc, fp_size, &e->tex_txp);
+        e->pkey = pkey;
+    }
+    *tex_txp = e->tex_txp;
+    return e->all;
+}
