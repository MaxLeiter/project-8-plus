+/* NIDs with an inline hook in hle_call_full that the lean path does not copy. */
+static inline int hle_nid_has_hook(uint32_t nid)
+{
+    return nid == 0xE0998DBFu   /* YDKJ_TUNERFIX */
+        || nid == 0xE6F2C1E7u   /* sys_process_exit: [exit-chain] */
+        || nid == 0xD0B1D189u   /* cellGcmSetTile: [hle-trace] */
+        || nid == 0xDC09357Eu;  /* cellGcmSetDisplayBuffer: [hle-trace] */
