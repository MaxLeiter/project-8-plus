+/* Host shadow-filter upgrades (rsx_fp_shadow_desc.filter != 0, PCF units),
+ * emitted after the rsx_zcmp<u> signature line. Same operand order, reference
+ * clamp and unorm quantisation (`k`) as the NV40 path below; every tap is a
+ * Gather at the shared corner of its 2x2 footprint, as there. Radii are in
+ * GUEST shadow-map texels: Rh = radius * scale host texels, so a 2x/4x map
+ * (PS3_GFX_SHADOW_SCALE) keeps the same softness in the world.
+ *   filter 1, wide PCF: the average of bilinear compares over -Rh..Rh.
+ *     Rh <= 4: every integer offset = one pass over the (2Rh+2)^2 texel
+ *     window with separable weights (1-f, 1, ..., 1, f) / (2Rh+1), i.e.
+ *     (Rh+1)^2 Gathers. Larger: a 24-tap golden-angle spiral of bilinear
+ *     compares over radius Rh.
+ *   filter 2, PCSS-lite: 16-tap spiral blocker search over Rmax = 3 * Rh
+ *     (blocker = compare false; none -> lit). Penumbra radius =
+ *     |ref - mean blocker depth| * pcss_k / 1000 map widths, clamped to
+ *     [Rh/2, Rmax] host texels, filtered by a 24-tap spiral of bilinear
+ *     compares: shadows harden where the caster touches the receiver (the
+ *     skater's feet) and soften with height. With an orthographic light the
+ *     depth gap is linear in world distance. */
+static void fp_emit_shadow_filter(Out* p, const rsx_fp_shadow_desc* s,
+                                  const char* op, const char* k)
+{
+    char line[2048];
+    const u32 R = s->radius < 1 ? 1u : s->radius > 4 ? 4u : s->radius;
+    const u32 S = s->scale < 1 ? 1u : s->scale > 8 ? 8u : s->scale;
+    const u32 Rh = R * S;
+    out_puts(p, "  uint w, h; t.GetDimensions(w, h); float2 sz = float2(w, h);"
+                " float2 isz = 1.0 / sz;\n");
+    if (k) {
+        snprintf(line, sizeof line, "  float r = round(saturate(z) * %s);\n", k);
+        out_puts(p, line);
+    } else {
+        out_puts(p, "  float r = z;\n");
+    }
+    char quant[96];
+    if (k) snprintf(quant, sizeof quant, "round(saturate(d) * %s)", k);
+    else   snprintf(quant, sizeof quant, "d");
+    /* one bilinear compare at texel-space point q (tc convention) -> acc */
+    char tap[512];
+    snprintf(tap, sizeof tap,
+             "    float2 j0 = floor(q); float2 g = q - j0;\n"
+             "    float4 d = t.Gather(s, (j0 + 1.0) * isz); d = %s;\n"
+             "    float4 c = (float4)(d %s r);\n"
+             "    acc += lerp(lerp(c.w, c.z, g.x), lerp(c.x, c.y, g.x), g.y);\n",
+             quant, op);
+    if (s->filter == 1 && Rh <= 4) {
+        snprintf(line, sizeof line,
+            "  float2 tc = uv * sz - 0.5; float2 i0 = floor(tc); float2 f = tc - i0;\n"
+            "  float acc = 0.0;\n"
+            "  [loop] for (int gy = 0; gy <= %u; gy++) {\n"
+            "    [loop] for (int gx = 0; gx <= %u; gx++) {\n"
+            "      float2 o = float2(gx * 2 - %u, gy * 2 - %u);\n"
+            "      float4 d = t.Gather(s, (i0 + o + 1.0) * isz); d = %s;\n"
+            "      float4 c = (float4)(d %s r);\n"
+            "      float2 wa = float2(gx == 0 ? 1.0 - f.x : 1.0, gx == %u ? f.x : 1.0);\n"
+            "      float2 wb = float2(gy == 0 ? 1.0 - f.y : 1.0, gy == %u ? f.y : 1.0);\n"
+            "      acc += c.w * wa.x * wb.x + c.z * wa.y * wb.x + c.x * wa.x * wb.y + c.y * wa.y * wb.y;\n"
+            "    }\n"
+            "  }\n"
+            "  return (float4)(acc / %u.0);\n"
+            "}\n",
+            Rh, Rh, Rh, Rh, quant, op, Rh, Rh, (2 * Rh + 1) * (2 * Rh + 1));
+        out_puts(p, line);
+        return;
+    }
+    if (s->filter == 1) {
+        snprintf(line, sizeof line,
+            "  float2 pc = uv * sz - 0.5; float acc = 0.0;\n"
+            "  [loop] for (int j = 0; j < 24; j++) {\n"
+            "    float a = j * 2.39996323; float2 q = pc + float2(cos(a), sin(a)) * (sqrt((j + 0.5) / 24.0) * %u.0);\n"
+            "%s"
+            "  }\n"
+            "  return (float4)(acc / 24.0);\n"
+            "}\n", Rh, tap);
+        out_puts(p, line);
+        return;
+    }
+    /* PCSS-lite */
+    const u32 kk = s->pcss_k ? s->pcss_k : 4000;
+    snprintf(line, sizeof line,
+        "  float zr = saturate(z); float2 pc = uv * sz - 0.5;\n"
+        "  float bsum = 0.0, bcnt = 0.0;\n"
+        "  [loop] for (int b = 0; b < 16; b++) {\n"
+        "    float a = b * 2.39996323 + 0.5; float2 q = pc + float2(cos(a), sin(a)) * (sqrt((b + 0.5) / 16.0) * %u.0);\n"
+        "    float4 dr = saturate(t.Gather(s, (floor(q) + 1.0) * isz)); float4 d = dr; d = %s;\n"
+        "    float4 blk = 1.0 - (float4)(d %s r);\n"
+        "    bsum += dot(blk, dr); bcnt += dot(blk, (float4)1.0);\n"
+        "  }\n"
+        "  if (bcnt < 0.5) return (float4)1.0;\n"
+        "  float rad = clamp(abs(zr - bsum / bcnt) * %u.0 * 0.001 * sz.x, %u.0 * 0.5, %u.0);\n"
+        "  float acc = 0.0;\n"
+        "  [loop] for (int j = 0; j < 24; j++) {\n"
+        "    float a = j * 2.39996323; float2 q = pc + float2(cos(a), sin(a)) * (sqrt((j + 0.5) / 24.0) * rad);\n"
+        "%s"
+        "  }\n"
+        "  return (float4)(acc / 24.0);\n"
+        "}\n",
+        3 * Rh, quant, op, kk, Rh, 3 * Rh, tap);
+    out_puts(p, line);
+}
