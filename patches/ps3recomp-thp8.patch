+/* ---------------------------------------------------------------------------
+ * Mismatch bookkeeping
+ * ------------------------------------------------------------------------ */
+enum { EX_INTERP, EX_LIFTED, EX_N };
+static const char* const ex_name[EX_N] = { "interp", "lifted" };
+enum { D_OUTCOME = 1, D_DEST = 2, D_OTHERREG = 4, D_LS = 8, D_CHAN = 16, D_INTEN = 32 };
+
+#define MAXMN 256
+#define MAXCLS 16
+typedef struct {
+    const char* mn;
+    long runs, cases;
+    long mism[EX_N];
+    long il_mism;       /* interpreter != lifted (same helpers: never expected) */
+    long seq_words, seq_steps;   /* sequence programs: code words, reference steps executed */
+    int  il_examples;
+    int  examples[EX_N];
+    int  aspects[EX_N];
+    long cls_n[EX_N][MAXCLS];
+    char cls_ex[EX_N][MAXCLS][400];
+} mnstat;
+static mnstat g_st[MAXMN];
+static int g_nst;
+static int g_maxex = 3;
+/* Expected-failing mnemonics: none. (Until the SP/DP float rework the float
+ * and double ops were listed here; SPUCHECK_XFAIL=a,b,... still sets a list,
+ * and their mismatch classes are then summarised per lane.) */
+static char g_xfail[2048] = ",";
