+static void spu_var_pages_or(uint64_t m[4], const spu_var* v)
+{
+    for (uint32_t p = v->pg_lo; p <= v->pg_hi; p++) m[p >> 6] |= 1ull << (p & 63);
+}
+static void spu_var_know(spu_context* ctx, uint32_t id, int ok)
+{
+    uint64_t* s = ok ? ctx->var_ok : ctx->var_bad;
+    s[id >> 6] |= 1ull << (id & 63);
+    spu_var_pages_or(ctx->var_code, &s_var[id]);
+    ctx->var_known = 1;
+}
+static void spu_var_forget_all(spu_context* ctx)
+{
+    uint32_t words = SPU_VAR_WORDS(s_var_n);
+    memset(ctx->var_ok, 0, words * sizeof(uint64_t));
+    memset(ctx->var_bad, 0, words * sizeof(uint64_t));
+    memset(ctx->var_code, 0, sizeof ctx->var_code);
+    memset(ctx->var_dirty, 0, sizeof ctx->var_dirty);
+    ctx->var_known = 0; ctx->var_dirty_any = 0;
+}
+/* Drop every verdict that rests on a page a GET has rewritten since. var_code
+ * stays a superset until the run ends: a page whose verdicts are all gone costs
+ * a GET there one compare more, never a wrong verdict. */
+static void spu_var_consume(spu_context* ctx)
+{
+    uint64_t d[4];
+    uint64_t any = 0;
+    for (int w = 0; w < 4; w++) {
+        d[w] = ctx->var_dirty[w] & ctx->var_code[w];
+        ctx->var_dirty[w] = 0;
+        any |= d[w];
+    }
+    ctx->var_dirty_any = 0;
+    if (!any) return;
+    s_var_st.consumes++;
+    for (uint32_t w = 0; w < 4; w++)
+        for (uint64_t m = d[w]; m; m &= m - 1) {
+            const uint32_t p = (w << 6) + (uint32_t)__builtin_ctzll(m);
+            for (uint32_t i = 0; i < s_var_pg_n[p]; i++) {
+                const uint32_t id = s_var_pg[p][i];
+                ctx->var_ok[id >> 6] &= ~(1ull << (id & 63));
+                ctx->var_bad[id >> 6] &= ~(1ull << (id & 63));
+            }
+        }
+}
+void spu_variant_note_write(spu_context* ctx, uint32_t lsa, const void* src, uint32_t size)
+{
+    lsa &= SPU_LS_MASK;
+    if (size > SPU_LS_SIZE - lsa) size = SPU_LS_SIZE - lsa;
+    if (!size) return;
+    const uint32_t end = lsa + size;
+    for (uint32_t p = lsa >> 10, last = (end - 1) >> 10; p <= last; p++) {
+        if (!((ctx->var_code[p >> 6] >> (p & 63)) & 1u)) continue;
+        uint32_t a = (p << 10) > lsa ? (p << 10) : lsa;
+        uint32_t b = ((p + 1) << 10) < end ? ((p + 1) << 10) : end;
+        if (src && memcmp(ctx->ls + a, (const uint8_t*)src + (a - lsa), b - a) == 0)
+            continue;                                     /* same bytes: verdicts stand */
+        ctx->var_dirty[p >> 6] |= 1ull << (p & 63);
+        ctx->var_dirty_any = 1;
+        s_var_st.dirty_marks++;
+    }
+}
+static spu_fn spu_variant_lookup_at(spu_context* ctx, uint32_t pc)
+{
+    const uint32_t n0 = s_var_head[spu_var_bucket(pc)];
+    if (!n0) return NULL;
+    if (ctx->var_dirty_any) spu_var_consume(ctx);
+    const uint8_t* ls = ctx->ls;
+    if (!s_var_verify) {
+        /* A variant this context already validated: confirm the entry bytes. */
+        for (uint32_t n = n0; n; n = s_var[n - 1].next) {
+            const spu_var* v = &s_var[n - 1];
+            const uint32_t id = n - 1;
+            if (v->entry != pc || !((ctx->var_ok[id >> 6] >> (id & 63)) & 1u)) continue;
+            if (__atomic_load_n(&v->e16_ok, __ATOMIC_ACQUIRE) && memcmp(ls + pc, v->e16, v->e16_n) == 0)
+                return v->fn;
+            /* The entry changed under a validated variant -- an SPU store or a
+             * PPU write, which nothing tracks. Judge it again below. */
+            ctx->var_ok[id >> 6] &= ~(1ull << (id & 63));
+            s_var_st.spot_fails++;
+        }
+    }
+    for (uint32_t n = n0; n; n = s_var[n - 1].next) {
+        spu_var* v = &s_var[n - 1];
+        const uint32_t id = n - 1;
+        if (v->entry != pc) continue;
+        if (!s_var_verify && ((ctx->var_bad[id >> 6] >> (id & 63)) & 1u)) continue;
+        s_var_st.validations++;
+        const int ok = v->legacy ? spu_code_key(ls, v->lo) == v->hash
+                                 : spu_code_hash(ls + v->lo, v->len) == v->hash;
+        if (!ok) {
+            s_var_st.rejects++;
+            if (!s_var_verify) spu_var_know(ctx, id, 0);
+            continue;
+        }
+        if (!__atomic_load_n(&v->e16_ok, __ATOMIC_ACQUIRE)) {
+            uint32_t k = v->lo + v->len - pc;             /* entry bytes inside the extent */
+            if (k > 16) k = 16;
+            memcpy(v->e16, ls + pc, k);
+            v->e16_n = (uint8_t)k;
+            __atomic_store_n(&v->e16_ok, 1, __ATOMIC_RELEASE);
+        }
+        if (!s_var_verify) spu_var_know(ctx, id, 1);
+        return v->fn;
+    }
+    return NULL;
+}
+/* Benchmarks / tests: the dispatch-miss variant lookup on its own. */
+spu_fn spu_variant_find(spu_context* ctx, uint32_t pc)
+{
+    if (!s_var_n) return NULL;
+    return spu_variant_lookup_at(ctx, pc & SPU_LS_MASK & ~3u);
+}
