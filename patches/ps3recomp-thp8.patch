+def _mfvscr(s, f):
+    s.set_v(f.rt, fromW([0, 0, 0, s.vscr & 0x00010001]))
+
+
+def _mtvscr(s, f):
+    s.vscr = W(s.vr[f.rb])[3] & 0x00010001
