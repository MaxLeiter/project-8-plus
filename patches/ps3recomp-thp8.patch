+/* ===========================================================================
+ * 6. Every MFC command form, list details, more atomics, signals and events
+ * ===========================================================================*/
+/* CBEA command opcodes the runtime header does not name (RPCS3 MFC.h). */
+#define T_PUTR    0x30u
+#define T_PUTRB   0x31u
+#define T_PUTRF   0x32u
+#define T_PUTRL   0x34u
+#define T_PUTRLB  0x35u
+#define T_PUTRLF  0x36u
+#define T_PUTS    0x28u
+#define T_GETS    0x48u
+#define T_SDCRT   0x80u
+#define T_SDCRTST 0x81u
+#define T_SDCRZ   0x89u
+#define T_SDCRS   0x8Du
+#define T_SDCRF   0x8Fu
+
+/* sys_spu_thread_write_snr's SPU side (before spu_snr_deliver existed, the
+ * lv2 handler did this inline). */
+static void ppu_snr(spu_context* c, int num, uint32_t v, int or_mode)
+{
+#ifdef SPU_HAVE_SNR_DELIVER
+    spu_snr_deliver(c, num, v, or_mode);
+#else
+    if (spu_snr_write(&c->ch_sig_notify[num], v, or_mode)) {
+        spu_lockline_lock(); c->event_status |= 0x200u >> num; spu_lockline_unlock();
+    }
+    spu_ch_wake(c);
+#endif
+}
