+/* ------------------------------------------------------------------------------------------------ resources */
+typedef struct wgs_resource {
+    ID3D12Resource iface;
+    volatile LONG refs;
+    u32 id;
+    D3D12_RESOURCE_DESC desc;
+    D3D12_HEAP_TYPE heap;
+    u8* shadow;                 /* upload / readback buffers: the CPU copy Map returns */
+    u64 size;                   /* buffers: bytes */
+} wgs_resource;
+static wgs_resource* res_of(ID3D12Resource* r) { return (wgs_resource*)r; }
+
+static HRESULT STDMETHODCALLTYPE res_qi(ID3D12Resource* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12Resource) || iid_eq(r, &IID_ID3D12Pageable) ||
+        iid_eq(r, &IID_ID3D12DeviceChild) || iid_eq(r, &IID_ID3D12Object)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE res_addref(ID3D12Resource* t) { return (ULONG)__atomic_add_fetch(&res_of(t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE res_release(ID3D12Resource* t)
+{
+    wgs_resource* r = res_of(t);
+    const LONG n = __atomic_sub_fetch(&r->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) {
+        /* The title releases a resource only after the GPU is done with it (its own fences), so the worker can
+         * destroy it when it reaches this message. The shadow goes with it. */
+        wgs_msg* m = &t_msg; msg_begin(m, WGS_DESTROY); msg_u32(m, r->id); ring_post(m);
+        free(r->shadow); free(r);
+    }
+    return (ULONG)n;
+}
+static HRESULT STDMETHODCALLTYPE res_map(ID3D12Resource* t, UINT sub, const D3D12_RANGE* rr, void** data)
+{
+    (void)sub; (void)rr;
+    wgs_resource* r = res_of(t);
+    if (!r->shadow) { if (data) *data = NULL; return E_INVALIDARG; }    /* DEFAULT heap: not mappable */
+    if (data) *data = r->shadow;
+    return S_OK;
+}
+static void STDMETHODCALLTYPE res_unmap(ID3D12Resource* t, UINT sub, const D3D12_RANGE* wr) { (void)t; (void)sub; (void)wr; }
+static D3D12_RESOURCE_DESC* STDMETHODCALLTYPE res_get_desc(ID3D12Resource* t, D3D12_RESOURCE_DESC* ret) { *ret = res_of(t)->desc; return ret; }
+static D3D12_GPU_VIRTUAL_ADDRESS STDMETHODCALLTYPE res_gpu_va(ID3D12Resource* t) { return (u64)res_of(t)->id << 32; }
+static HRESULT STDMETHODCALLTYPE obj_set_name_res(ID3D12Resource* t, const WCHAR* n) { (void)t; (void)n; return S_OK; }
+static HRESULT STDMETHODCALLTYPE res_get_priv(ID3D12Resource* t, REFGUID g, UINT* s, void* d) { (void)t; (void)g; (void)d; if (s) *s = 0; return DXGI_ERROR_NOT_FOUND; }
+static HRESULT STDMETHODCALLTYPE res_set_priv(ID3D12Resource* t, REFGUID g, UINT s, const void* d) { (void)t; (void)g; (void)s; (void)d; return S_OK; }
+static ID3D12ResourceVtbl s_res_vtbl;
+
+/* GPU VA -> (resource id, offset) */
+static u32 va_id(u64 va) { return (u32)(va >> 32); }
+static u32 va_off(u64 va) { return (u32)va; }
+
+/* All live upload / readback resources by id (the queue needs the shadow of an id seen in a VA). */
+#define WGS_MAX_MAPPABLE 65536
+static wgs_resource* s_mappable[WGS_MAX_MAPPABLE];
+static wgs_resource* mappable_of(u32 id) { return id < WGS_MAX_MAPPABLE ? s_mappable[id] : NULL; }
+
+static wgs_resource* resource_new(const D3D12_RESOURCE_DESC* d, D3D12_HEAP_TYPE heap)
+{
+    static int vt_ready;
+    if (!vt_ready) {
+        s_res_vtbl.QueryInterface = res_qi; s_res_vtbl.AddRef = res_addref; s_res_vtbl.Release = res_release;
+        s_res_vtbl.GetPrivateData = res_get_priv; s_res_vtbl.SetPrivateData = res_set_priv; s_res_vtbl.SetName = obj_set_name_res;
+        s_res_vtbl.Map = res_map; s_res_vtbl.Unmap = res_unmap; s_res_vtbl.GetDesc = res_get_desc;
+        s_res_vtbl.GetGPUVirtualAddress = res_gpu_va;
+        WGS_CHILD_SLOTS(s_res_vtbl); wgs_fill_vtbl(&s_res_vtbl, sizeof s_res_vtbl); vt_ready = 1;
+    }
+    wgs_resource* r = (wgs_resource*)wgs_zalloc(sizeof *r);
+    r->iface.lpVtbl = &s_res_vtbl; r->refs = 1; r->id = wgs_new_id(); r->desc = *d; r->heap = heap;
+    wgs_msg* m = &t_msg;
+    if (d->Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) {
+        r->size = d->Width;
+        const u32 h = heap == D3D12_HEAP_TYPE_UPLOAD ? WGS_HEAP_UPLOAD : heap == D3D12_HEAP_TYPE_READBACK ? WGS_HEAP_READBACK : WGS_HEAP_DEFAULT;
+        if (h != WGS_HEAP_DEFAULT) {
+            r->shadow = (u8*)wgs_zalloc((size_t)r->size);
+            if (r->id < WGS_MAX_MAPPABLE) s_mappable[r->id] = r;
+        }
+        msg_begin(m, WGS_CREATE_BUFFER); msg_u32(m, r->id); msg_u64(m, r->size); msg_u32(m, h);
+        msg_u32(m, (d->Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) ? WGS_RES_UAV : 0);
+    } else {
+        u32 fl = 0;
+        if (d->Flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET) fl |= WGS_RES_RT;
+        if (d->Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL) fl |= WGS_RES_DS;
+        if (d->Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) fl |= WGS_RES_UAV;
+        if (d->Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE) fl |= WGS_RES_NO_SRV;
+        const u32 dim = d->Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE1D ? 1 : d->Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D ? 3 : 2;
+        msg_begin(m, WGS_CREATE_TEXTURE); msg_u32(m, r->id); msg_u32(m, dim); msg_u32(m, (u32)d->Width); msg_u32(m, d->Height);
+        msg_u32(m, d->DepthOrArraySize); msg_u32(m, d->MipLevels ? d->MipLevels : 1); msg_u32(m, d->Format);
+        msg_u32(m, d->SampleDesc.Count ? d->SampleDesc.Count : 1); msg_u32(m, fl);
+    }
+    ring_post(m);
+    return r;
+}
