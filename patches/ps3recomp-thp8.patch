+/* Write generation of t's source span (resets its pages), 0 = unknown.
+ * Granule mode (default): 256 KB granules asked once per frame, shared by all
+ * textures in them (PS3_TEXDIRTY_GRAN=0: one query per texture as before). */
+static u32 ld_texdirty_gen(const rsx_dsp_texture* t)
+{
+    const u32 span = texture_source_span(t);
+    if (span < g_texdirty.min_span) return 0;   /* small: hashing is cheaper */
+    const u8* src = span ? guest_ptr(t->location, t->offset, span) : NULL;
+    if (!src || !VM_MAPPED) return 0;
+    if (g_texdirty.gran)
+        return gwt_range_gen_epoch((u32)(src - vm_base), span, g_ld_frames + 1u);
+    return gwt_range_gen((u32)(src - vm_base), span);
+}
+
+static void ld_texdirty_stats(void)
+{
+    if (!g_texdirty.init || g_ld_frames < g_texdirty.stat_frame + 600u) return;
+    const u32 frames = g_ld_frames - g_texdirty.stat_frame;
+    g_texdirty.stat_frame = g_ld_frames;
+    if (!frames || !g_texdirty.checks) return;
+    u64 calls = 0, pages = 0;
+    gwt_stats(&calls, &pages);
+    fprintf(stderr, "[texdirty] frame %u: per frame %.1f checks: %.1f clean (no hash), %.1f written (hashed), "
+            "%.1f untracked (hashed), %.1f new; write-watch calls %llu pages %llu total; in-place updates %llu, R8 uploads %llu\n",
+            g_ld_frames, (double)g_texdirty.checks / frames, (double)g_texdirty.clean / frames,
+            (double)g_texdirty.dirty / frames, (double)g_texdirty.untracked / frames,
+            (double)g_texdirty.created / frames, (unsigned long long)calls, (unsigned long long)pages,
+            (unsigned long long)g_ld_tex_inplace, (unsigned long long)g_ld_tex_r8);
+    ld_texpool_stats(frames);
+    g_texdirty.checks = g_texdirty.clean = g_texdirty.dirty = g_texdirty.untracked = g_texdirty.created = 0;
+    {   /* granule queries (PS3_GWT_MERGE) */
+        static u64 last_c, last_g, last_q;
+        u64 c = 0, gr = 0, q = 0, vc = 0, vb = 0;
+        gwt_epoch_stats(&c, &gr, &q, &vc, &vb);
+        if (c > last_c)
+            fprintf(stderr, "[texdirty] frame %u: per frame %.1f granule lookups, %.1f granules asked in %.1f queries; "
+                    "merge verify %llu checks %llu mismatches (cumulative)\n", g_ld_frames,
+                    (double)(c - last_c) / frames, (double)(gr - last_g) / frames, (double)(q - last_q) / frames,
+                    (unsigned long long)vc, (unsigned long long)vb);
+        last_c = c; last_g = gr; last_q = q;
+    }
+}
+
 /* Decode a guest texture descriptor into a cached SRV slot.  Unlike the old
  * descriptor-only cache, re-hash the source once per frame and refresh the
  * D3D resource when the game rewrites the same guest address. */
+/* PS3_DRAW_TEXIDX: a complete hash index over the texture cache keys
+ * (open addressing, entry index + 1, tombstones on eviction, rebuilt when they
+ * pile up). With the cache full (1024 entries in THP8 free skate) the
+ * direct-mapped hint below missed often and every miss scanned the whole
+ * array with an 8-field compare (texture_srv_slot ~2.5 % of the ticker).
+ * Keys are unique in the array, so the index finds exactly the entry the scan
+ * finds; it is maintained even while switched off (two mutation sites, both
+ * rare). PS3_DRAW_VERIFY compares it with the scan on every lookup. */
+static ld_switch g_ld_sw_texidx = { .name = "DRAW_TEXIDX" };
+static int ld_verify_on(void);
+static void ld_verify(int ok, const char* what, u64 a, u64 b);
+#define LD_TEXIDX_SIZE 16384u   /* 4 x MAX_TEXTURES */
+#define LD_TEXIDX_TOMB 0xFFFFu
+static u16 g_ld_texidx[LD_TEXIDX_SIZE];
+static u32 g_ld_texidx_tombs;
+static u32 ld_texidx_hash(u32 loc, u32 off, u32 fmt, u32 w, u32 h, u32 pitch, u32 remap, u32 cube)
+{
+    u64 k = ((u64)off << 32) ^ ((u64)loc << 31) ^ ((u64)fmt << 23) ^ ((u64)w << 11) ^ h;
+    k ^= ((u64)pitch * 0x9E3779B97F4A7C15ull) ^ ((u64)remap << 40) ^ ((u64)cube << 63);
+    k ^= k >> 33; k *= 0xff51afd7ed558ccdull; k ^= k >> 33; k *= 0xc4ceb9fe1a85ec53ull; k ^= k >> 33;
+    return (u32)k & (LD_TEXIDX_SIZE - 1u);
+}
+static u32 ld_texidx_hash_entry(const texcache_t* e)
+{
+    return ld_texidx_hash(e->location, e->offset, e->format, e->width, e->height, e->pitch,
+                          e->remap, e->cubemap);
+}
+static int ld_texidx_find(const rsx_dsp_texture* t, u32 remap)
+{
+    u32 h = ld_texidx_hash(t->location, t->offset, t->format, t->width, t->height, t->pitch,
+                           remap, t->cubemap);
+    for (u32 n = 0; n < LD_TEXIDX_SIZE; n++, h = (h + 1u) & (LD_TEXIDX_SIZE - 1u)) {
+        const u32 v = g_ld_texidx[h];
+        if (!v) return -1;
+        if (v == LD_TEXIDX_TOMB || v - 1u >= g.n_textures) continue;
+        const texcache_t* e = &g.textures[v - 1u];
+        if (e->location == t->location && e->offset == t->offset && e->format == t->format &&
+            e->width == t->width && e->height == t->height && e->pitch == t->pitch &&
+            e->remap == remap && e->cubemap == t->cubemap)
+            return (int)(v - 1u);
+    }
+    return -1;
+}
+static void ld_texidx_insert(u32 i)
+{
+    u32 h = ld_texidx_hash_entry(&g.textures[i]);
+    for (u32 n = 0; n < LD_TEXIDX_SIZE; n++, h = (h + 1u) & (LD_TEXIDX_SIZE - 1u)) {
+        const u32 v = g_ld_texidx[h];
+        if (!v || v == LD_TEXIDX_TOMB) {
+            if (v) g_ld_texidx_tombs--;
+            g_ld_texidx[h] = (u16)(i + 1u);
+            return;
+        }
+    }
+}
+static void ld_texidx_rebuild(void)
+{
+    memset(g_ld_texidx, 0, sizeof(g_ld_texidx));
+    g_ld_texidx_tombs = 0;
+    for (u32 i = 0; i < g.n_textures; i++) ld_texidx_insert(i);
+}
+/* before entry i's key is overwritten */
+static void ld_texidx_remove(u32 i)
+{
+    u32 h = ld_texidx_hash_entry(&g.textures[i]);
+    for (u32 n = 0; n < LD_TEXIDX_SIZE; n++, h = (h + 1u) & (LD_TEXIDX_SIZE - 1u)) {
+        const u32 v = g_ld_texidx[h];
+        if (!v) return;
+        if (v == i + 1u) { g_ld_texidx[h] = LD_TEXIDX_TOMB; g_ld_texidx_tombs++; return; }
+    }
+}
