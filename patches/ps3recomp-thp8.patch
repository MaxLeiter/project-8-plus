+static D3D12_RESOURCE_ALLOCATION_INFO* STDMETHODCALLTYPE dev_alloc_info(ID3D12Device* t, D3D12_RESOURCE_ALLOCATION_INFO* ret,
+    UINT mask, UINT n, const D3D12_RESOURCE_DESC* d)
+{
+    (void)t; (void)mask;
+    u64 size = 0;
+    for (UINT i = 0; i < n; i++) {
+        const wgs_fmt_info fi = fmt_info(d[i].Format);
+        u64 w = d[i].Width, h = d[i].Height, s = 0;
+        for (UINT k = 0; k < (d[i].MipLevels ? d[i].MipLevels : 1); k++) {
+            const u64 bw = (w + fi.block_w - 1) / fi.block_w, bh = (h + fi.block_w - 1) / fi.block_w;
+            s += bw * bh * fi.block_bytes;
+            w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1;
+        }
+        size += (s * (d[i].DepthOrArraySize ? d[i].DepthOrArraySize : 1) + 65535) & ~65535ull;
+    }
