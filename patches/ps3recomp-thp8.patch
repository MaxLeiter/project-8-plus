+    SetEndOfFile(s_lock_h);
+    WriteFile(s_lock_h, text, (DWORD)n, &wr, NULL);
+#else
+    if (ftruncate(s_lock_fd, 0) == 0 && pwrite(s_lock_fd, text, (size_t)n, 0) < 0) { /* the text is only a hint */ }
