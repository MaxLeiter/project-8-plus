+    } else {
+        ppu_icall_tab = nullptr; ppu_icall_lo = 0; ppu_icall_n = 0;
+    }
+}
+
+void lds_print_config(void)
+{
+    printf("CONFIG clobber=%s slowmem=%d icall=%d bss=%d demand=%d tracelimit=%llu memlimit_mb=%llu "
+           "tests=%u real=%u syms=%u\n",
