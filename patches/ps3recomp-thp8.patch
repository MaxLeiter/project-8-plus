+#ifdef _WIN32
+
+std::wstring exe_dir_w(void)
+{
+    std::vector<wchar_t> buf(32768);
+    DWORD n = GetModuleFileNameW(nullptr, buf.data(), (DWORD)buf.size());
+    if (!n || n >= buf.size()) return std::wstring();
+    std::wstring s(buf.data(), n);
+    size_t k = s.find_last_of(L"\\/");
+    return k == std::wstring::npos ? std::wstring() : s.substr(0, k);
+}
+
+bool is_dir_w(const std::wstring& p)
+{
+    DWORD a = GetFileAttributesW(p.c_str());
+    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+bool wiless(const std::wstring& a, const std::wstring& b) { return _wcsicmp(a.c_str(), b.c_str()) < 0; }
+
+/* Entries of dir matching pattern; dirs or files; '_' / '.' prefixes dropped. */
+std::vector<std::wstring> list_dir(const std::wstring& dir, const wchar_t* pattern, bool want_dirs)
+{
+    std::vector<std::wstring> out;
+    WIN32_FIND_DATAW fd;
+    HANDLE h = FindFirstFileW((dir + L"\\" + pattern).c_str(), &fd);
+    if (h == INVALID_HANDLE_VALUE) return out;
+    do {
+        const bool d = (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+        if (d != want_dirs) continue;
+        const wchar_t* n = fd.cFileName;
+        if (n[0] == L'.' || n[0] == L'_') {
+            if (!want_dirs)   /* (a disabled pack folder is the overlay's business) */
+                fprintf(stderr, "[mods] %s skipped (disabled by its '%c' prefix)\n",
+                        utf8((dir + L"\\" + n).c_str()).c_str(), (char)n[0]);
+            continue;
+        }
+        if (!want_dirs) {   /* "*.dll" also matches "x.dll_old" via 8.3 names */
+            size_t len = wcslen(n);
+            if (len < 5 || _wcsicmp(n + len - 4, L".dll") != 0) continue;
+        }
+        out.push_back(n);
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+    std::sort(out.begin(), out.end(), wiless);
+    return out;
+}
+
+bool read_text_w(const std::wstring& path, std::string& out)
+{
+    FILE* f = _wfopen(path.c_str(), L"rb");
+    if (!f) return false;
+    char buf[4096];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0 && out.size() < (4u << 20)) out.append(buf, n);
+    fclose(f);
+    return true;
+}
+
+/* PS3MOD_<PLUGIN>_<KEY>=value overrides, captured once at load. */
+void capture_env(plugin* p)
+{
+    const std::string prefix = "PS3MOD_" + env_norm(p->name.c_str()) + "_";
+    wchar_t* blk = GetEnvironmentStringsW();
+    if (!blk) return;
+    for (const wchar_t* e = blk; *e; e += wcslen(e) + 1) {
+        if (*e == L'=') continue;
+        const std::string s = utf8(e);
+        const size_t eq = s.find('=');
+        if (eq == std::string::npos || eq <= prefix.size()) continue;
+        if (_strnicmp(s.c_str(), prefix.c_str(), prefix.size()) != 0) continue;
+        p->env.push_back({ env_norm(s.substr(prefix.size(), eq - prefix.size()).c_str()), s.substr(eq + 1) });
+    }
+    FreeEnvironmentStringsW(blk);
+}
+
+void unload(plugin* p, bool call_shutdown)
+{
+    if (call_shutdown && p->shutdown) p->shutdown();
+    p->state = PLG_GONE;
+    for (const staged_hook& h : p->hooks) h.rec->owner = nullptr;   /* never installed; handle dead */
+    drop_services(p);
+    s_plugins.erase(std::remove(s_plugins.begin(), s_plugins.end(), p), s_plugins.end());
+    if (p->dll) FreeLibrary(p->dll);
+    delete p;
+}
+
+void refuse(plugin* p, const std::string& why, bool init_ran)
+{
+    fprintf(stderr, "[mods] plugin %s refused: %s\n", p->file.c_str(), why.c_str());
+    unload(p, init_ran);
+}
+
+bool load_one(const std::wstring& dir, const std::wstring& file)
+{
+    plugin* p = new plugin();
+    const std::wstring wpath = dir + L"\\" + file;
+    p->file = utf8(file.c_str());
+    p->path = utf8(wpath.c_str());
+    {
+        const size_t dot = file.find_last_of(L'.');
+        const std::wstring base = file.substr(0, dot);
+        p->name = utf8(base.c_str());
+        p->title = p->name;
+        std::wstring cfgw = dir + L"\\" + base + L".ini";
+        std::string text;
+        if (!read_text_w(cfgw, text)) {
+            cfgw = dir + L"\\" + base + L".toml";
+            if (!read_text_w(cfgw, text)) cfgw.clear();
+        }
+        if (!cfgw.empty()) { p->config_path = utf8(cfgw.c_str()); cfg_parse(p, text); }
+    }
+    capture_env(p);
+
+    p->dll = LoadLibraryExW(wpath.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+    if (!p->dll) {
+        fprintf(stderr, "[mods] plugin %s refused: LoadLibrary failed (error %lu)\n",
+                p->file.c_str(), (unsigned long)GetLastError());
+        delete p;
+        return false;
+    }
+    p->query    = (ps3mod_query_fn)   (void*)GetProcAddress(p->dll, PS3MOD_SYM_QUERY);
+    p->init     = (ps3mod_init_fn)    (void*)GetProcAddress(p->dll, PS3MOD_SYM_INIT);
+    p->shutdown = (ps3mod_shutdown_fn)(void*)GetProcAddress(p->dll, PS3MOD_SYM_SHUTDOWN);
+    make_host(p);
+    s_plugins.push_back(p);
+    if (!p->init) { refuse(p, "no exported " PS3MOD_SYM_INIT " (is it extern \"C\" PS3MOD_EXPORT?)", false); return false; }
+
+    memset(p->info_buf, 0, sizeof p->info_buf);
+    p->info.size = (uint32_t)sizeof(ps3mod_info);
+    std::string why;
+    if (p->query) {
+        p->state = PLG_IDLE;
+        const int qr = p->query(&p->info);
+        if (qr != 0) { refuse(p, strf("ps3mod_query returned %d", qr), false); return false; }
+        if (!validate_info(p, why)) { refuse(p, why, false); return false; }
+    }
+
+    p->state = PLG_LOADING;
+    const int ir = p->init(&p->host, &p->info);
+    p->state = PLG_IDLE;   /* no more staging; nothing is live yet */
+    if (ir != 0) {
+        fprintf(stderr, "[mods] plugin %s not loaded: ps3mod_init returned %d\n", p->file.c_str(), ir);
+        unload(p, true);
+        return false;
+    }
+    if (!validate_info(p, why)) { refuse(p, why, true); return false; }
+    if (p->init_errors) {
+        refuse(p, strf("%d hook/patch/event registration(s) failed during ps3mod_init (see above)",
+                       p->init_errors), true);
+        return false;
+    }
+    if (p->info.name && *p->info.name) p->title = p->info.name;
+
+    commit(p);
+    p->state = PLG_ACTIVE;
+    fprintf(stderr, "[mods] plugin %s loaded: %s %s%s%s (%u hooks, %u patches, %u event handlers)\n",
+            p->file.c_str(), p->title.c_str(), p->info.version ? p->info.version : "",
+            p->config_path.empty() ? "" : "; config ", p->config_path.c_str(),
+            (unsigned)p->hooks.size(), (unsigned)p->patches.size(), (unsigned)p->events.size());
+    p->hooks.clear();   p->hooks.shrink_to_fit();
+    p->patches.clear(); p->patches.shrink_to_fit();
+    p->events.clear();  p->events.shrink_to_fit();
+    return true;
+}
