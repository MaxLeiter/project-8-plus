diff --git a/web/host/gpu/replay.html b/web/host/gpu/replay.html
new file mode 100644
index 00000000..dab83984
--- /dev/null
+++ b/web/host/gpu/replay.html
@@ -0,0 +1,27 @@
+<!doctype html><meta charset="utf-8"><title>WGS replay</title>
+<style>body{background:#111;color:#ddd;font:13px system-ui;margin:12px} canvas{background:#000;display:block;margin:8px 0}</style>
+<div>WGS stream replay (test tool): <span id="s">loading</span></div>
+<canvas id="c" width="640" height="360"></canvas><pre id="o"></pre>
+<script type="module">
+// replay.html?f=<recorded .wgs file> -- runs a recorded WGS stream (WGS_RECORD) through wgs.js on this page's canvas.
+import { Wgs } from "./wgs.js";
+const q = new URLSearchParams(location.search), file = q.get("f") || "test1.wgs";
+const o = document.getElementById("o"), S = document.getElementById("s"), L = (m) => { o.textContent += m + "\n"; };
+const ad = await navigator.gpu.requestAdapter({ powerPreference: "high-performance" });
+const want = ["texture-compression-bc", "depth32float-stencil8", "float32-filterable", "depth-clip-control", "rg11b10ufloat-renderable", "texture-formats-tier1", "texture-formats-tier2"];
+const dev = await ad.requestDevice({ requiredFeatures: want.filter((f) => ad.features.has(f)) });
+const ctx = document.getElementById("c").getContext("webgpu"), fmt = navigator.gpu.getPreferredCanvasFormat();
+ctx.configure({ device: dev, format: fmt, alphaMode: "opaque" });
+const w = new Wgs(dev, { context: ctx, canvasFormat: fmt, log: (...a) => L(a.join(" ")) });
+const words = new Uint32Array(await (await fetch(file)).arrayBuffer());
+// split after each PRESENT so every frame reaches the screen
+let i = 0, start = 0, frames = 0;
+while (i < words.length) {
+  const op = words[i] >>> 16, n = words[i] & 0xffff; i += 1 + n;
+  if (op === 11 || i >= words.length) { w.process(words.subarray(start, i)); start = i; frames++; await new Promise((r) => (document.hidden ? setTimeout(r, 16) : requestAnimationFrame(r))); }
+}
+await w.pending; await dev.queue.onSubmittedWorkDone();
+window.__res = { frames, stats: w.stats };
+S.textContent = `done: ${frames} frames`;
+L(JSON.stringify(window.__res));
+</script>
diff --git a/web/host/gpu/translate-worker.js b/web/host/gpu/translate-worker.js
new file mode 100644
index 00000000..89c00c65
--- /dev/null
+++ b/web/host/gpu/translate-worker.js
@@ -0,0 +1,12 @@
+// translate-worker.js -- HLSL->WGSL translation off the device worker's thread (wgs.js opts.translateAsync, a pool
+// of these started by device-worker.js). A scene that streams in brings 100+ new shaders at once, ~2 ms each.
+//   postMessage({ id, src, entry, stage, params, statics }) -> { id, r } | { id, error }
+// Game-agnostic.
+import { translate } from "./hlsl2wgsl.js";
+import { rootBindingFor } from "./wgs.js";
+
+onmessage = (e) => {
+  const { id, src, entry, stage, params, statics } = e.data;
+  try { postMessage({ id, r: translate(src, { entry, stage, bindingFor: rootBindingFor(params, statics) }) }); }
+  catch (err) { postMessage({ id, error: String(err && err.message || err) }); }
+};
