+    smd.Filter = D3D12_FILTER_MIN_MAG_MIP_POINT; smd.AddressU = smd.AddressV = smd.AddressW = D3D12_TEXTURE_ADDRESS_MODE_WRAP; smd.MaxLOD = 1000.0f;
