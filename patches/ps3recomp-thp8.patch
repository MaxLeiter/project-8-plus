+#!/usr/bin/env python3
+"""ppucheck.py - differential test harness for PPU instruction semantics.
+
+For every reference instruction (ref_*.py Specs, written independently from
+the PowerISA / AltiVec PEM / Cell docs) the harness
+
+  1. builds instruction words: random encodings of the form (edge-biased
+     immediates, aliasing registers) plus, with --census, the title's own
+     encodings of that instruction;
+  2. asks the REAL lifter (tools/ppu_lifter.py, PPULifter._translate) for the
+     C it emits for each word, and wraps each emission as one test function;
+  3. generates randomized architectural states (GPR/FPR/VR/CR/XER/FPSCR/VSCR/
+     LR/CTR/reservation + a 512-byte guest memory window) with edge-case bias
+     -- carries, overflow, shift counts >= 32/64, wrapping masks, INT_MIN,
+     NaN/Inf/denormals, misaligned addresses -- and steers address registers
+     so loads/stores hit the window;
+  4. compiles the emissions with the game's compiler flags (clang-cl -O2,
+     -ffp-contract=off, -fno-strict-aliasing, -msse4.1) against a small
+     driver (driver_main.cpp) and runs every state through them;
+  5. compares the full resulting state with the reference model and reports
+     every mismatch, weighted by how often the instruction occurs in the
+     title (--census).
+
+    python ppucheck.py [--census census.json] [--only REGEX] [--tags fp,vmx]
+                       [--words 12] [--states 40] [--seed 1] [--work DIR]
+                       [--cxx clang-cl] [--jobs 4] [--profile default|full]
+                       [--json out.json] [--max-examples 3]
+
+Exit status: 0 = no mismatches outside --allow, 1 = mismatches, 2 = setup error.
+Run it from an environment where clang-cl can find the MSVC/SDK headers
+(a VS developer prompt, or thp8-native's tools/vsbuild.sh).
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import random
+import re
+import subprocess
+import sys
+import time
+from collections import Counter, defaultdict
+from concurrent.futures import ThreadPoolExecutor
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TOOLS = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+sys.path.insert(0, TOOLS)
+
+import ppcref                                   # noqa: E402
+from ppcref import (SPECS, F, State, Undefined, MemFault, REC_IN, REC_OUT,  # noqa: E402
+                    OUT_FAULT, compare, find_spec, encode)
+import gen                                      # noqa: E402
+
+REF_MODULES = ["ref_int", "ref_fp", "ref_vmx"]
+
+BASE_ADDR = 0x00200000      # address of the first test word (each gets 0x1000)
+
+
+def load_refs():
+    loaded = []
+    for m in REF_MODULES:
+        try:
+            __import__(m)
+            loaded.append(m)
+        except ModuleNotFoundError as e:
+            if e.name != m:
+                raise
+    return loaded
+
+
+# ---------------------------------------------------------------------------
+# lifter interface
+# ---------------------------------------------------------------------------
+
+def make_lifter():
+    import ppu_lifter
+    lf = ppu_lifter.PPULifter()
+    lf.fn_entry = False
+    if os.environ.get("PPUCHECK_VMX_SSE") == "1":   # test the --opt-vmx-sse emission
+        lf.vmx_sse = True
+    return ppu_lifter, lf
+
+
+def lift_word(ppu_lifter, lf, word, addr):
+    import ppu_disasm
+    insn = ppu_disasm.decode(word, addr)
+    # the function spans the whole bc displacement range (+-32 KiB), so any
+    # conditional branch target is an in-function label (OUT_TAKEN)
+    func = ppu_lifter.LiftedFunction(name=f"t_{addr:08X}", start_addr=addr - ppcref.FUNC_SPAN,
+                                     end_addr=addr + ppcref.FUNC_SPAN)
+    code = lf._translate(insn, func)
+    return insn, code
+
+
+def unhandled(code):
+    return code is None or "TODO" in code or "unhandled" in code or "unsupported" in code
+
+
+# ---------------------------------------------------------------------------
+# test construction
+# ---------------------------------------------------------------------------
+
+class Test:
+    __slots__ = ("idx", "spec", "word", "addr", "insn", "code", "src", "states", "refs",
+                 "census")
+
+    def __init__(self, idx, spec, word, addr):
+        self.idx, self.spec, self.word, self.addr = idx, spec, word, addr
+        self.states, self.refs = [], []
+        self.src = "gen"
+
+
+def build_tests(args, specs, census_samples):
+    rng = random.Random(args.seed)
+    ppu_lifter, lf = make_lifter()
+    tests = []
+    per_spec_words = defaultdict(list)
+    for sp in specs:
+        seen = set()
+        tries = 0
+        while len(per_spec_words[sp]) < args.words and tries < args.words * 40:
+            tries += 1
+            w = encode(sp, rng)
+            if w in seen or not ppcref.match(sp, w):
+                continue
+            f = F(w, 0)
+            if sp.valid and not sp.valid(f):
+                continue
+            seen.add(w)
+            per_spec_words[sp].append((w, "gen"))
+    # title encodings (census --samples) -> their spec
+    if census_samples:
+        spec_set = set(specs)
+        for mn, words in census_samples.items():
+            for ws in words[: args.title_words]:
+                w = int(ws, 16)
+                sp = find_spec(w)
+                if sp is None or sp not in spec_set:
+                    continue
+                if sp.valid and not sp.valid(F(w, 0)):
+                    continue
+                if any(w == x for x, _ in per_spec_words[sp]):
+                    continue
+                per_spec_words[sp].append((w, "title"))
+    for sp in specs:
+        for w, src in per_spec_words[sp]:
+            idx = len(tests)
+            addr = BASE_ADDR + idx * 0x1000
+            t = Test(idx, sp, w, addr)
+            t.src = src
+            t.insn, t.code = lift_word(ppu_lifter, lf, w, addr)
+            tests.append(t)
+    return tests, lf
+
+
+def gen_states(args, tests):
+    rng = random.Random(args.seed * 7919 + 1)
+    skipped = Counter()
+    for t in tests:
+        sp = t.spec
+        n_ok = 0
+        attempts = 0
+        while n_ok < args.states and attempts < args.states * 4:
+            attempts += 1
+            s = gen.make_state(rng, args.profile, sp.tags)
+            f = F(t.word, t.addr)
+            ea = None
+            if sp.ea:
+                ea = gen.place_ea(s, sp, f, rng)
+                if ea is None:
+                    skipped["ea-unreachable"] += 1
+                    break
+            if sp.setup:
+                sp.setup(s, f, rng, ea)
+            try:
+                r = ppcref.execute(sp, s, t.word, t.addr)
+            except Undefined:
+                skipped["undefined"] += 1
+                continue
+            t.states.append(s)
+            t.refs.append(r)
+            n_ok += 1
+    return skipped
+
+
+# ---------------------------------------------------------------------------
+# C++ generation / build / run
+# ---------------------------------------------------------------------------
+
+_LABEL_RE = re.compile(r"goto (loc_[0-9A-F]{8});")
+_FUNC_RE = re.compile(r"\bfunc_([0-9A-F]{8})\b")
+
+
+def emit_sources(work, tests, lf, chunks):
+    os.makedirs(work, exist_ok=True)
+    import ppu_lifter
+    # header: the lifter's own (declares func_X for any referenced target)
+    funcs = set()
+    for t in tests:
+        for m in _FUNC_RE.finditer(t.code or ""):
+            funcs.add(int(m.group(1), 16))
+    lf.call_targets = set(funcs)
+    lf.branch_targets = set()
+    lf.functions = []
+    files = {}
+    files["ppu_recomp.h"] = lf.emit_header()
+    pre = "\n".join(lf._preamble_lines())
+    per = (len(tests) + chunks - 1) // chunks
+    names = []
+    for c in range(chunks):
+        part = tests[c * per:(c + 1) * per]
+        if not part:
+            continue
+        lines = [pre, 'extern "C" uint32_t g_ppuc_out;', ""]
+        for t in part:
+            labels = sorted(set(_LABEL_RE.findall(t.code or "")))
+            lines.append(f"/* {t.spec.name} {t.word:08X}: {t.insn.mnemonic} {t.insn.operands} */")
+            lines.append(f"static void T_{t.idx}(ppu_context* ctx) {{")
+            lines.append("    g_ppuc_out = 2;")
+            lines.append(f"    {{ {t.code} }}")
+            lines.append("    g_ppuc_out = 0; return;")
+            for lb in labels:
+                lines.append(f"{lb}: g_ppuc_out = 1; return;")
+            lines.append("}")
+        lines.append(f'extern "C" void (*const ppuc_tab_{c}[])(ppu_context*) = {{')
+        lines.append(",\n".join(f"    T_{t.idx}" for t in part))
+        lines.append("};")
+        name = f"tests_{c:03d}.cpp"
+        files[name] = "\n".join(lines) + "\n"
+        names.append((c, len(part)))
+    glue = ['#include "ppu_recomp.h"', "#include <stdint.h>",
+            'extern "C" void ppuc_call_stub(uint32_t target, ppu_context* ctx);']
+    for c, _n in names:
+        glue.append(f'extern "C" void (*const ppuc_tab_{c}[])(ppu_context*);')
+    glue.append('typedef void (*ppuc_fn)(ppu_context*);')
+    glue.append('extern "C" const ppuc_fn* ppuc_tables[] = {' + ", ".join(f"ppuc_tab_{c}" for c, _ in names) + "};")
+    glue.append('extern "C" const uint32_t ppuc_table_sizes[] = {' + ", ".join(str(n) for _, n in names) + "};")
+    glue.append(f'extern "C" const uint32_t ppuc_ntables = {len(names)};')
+    for a in sorted(funcs):
+        glue.append(f"void func_{a:08X}(ppu_context* ctx) {{ ppuc_call_stub(0x{a:08X}u, ctx); }}")
+    files["glue.cpp"] = "\n".join(glue) + "\n"
+    changed = []
+    for name, text in files.items():
+        p = os.path.join(work, name)
+        old = None
+        if os.path.exists(p):
+            with open(p, "r", newline="") as fh:
+                old = fh.read()
+        if old != text:
+            with open(p, "w", newline="\n") as fh:
+                fh.write(text)
+            changed.append(name)
+    return [n for n in files if n.endswith(".cpp")], changed
+
+
+CXXFLAGS = ["/nologo", "/c", "/O2", "/std:c++20", "/EHs-c-", "-fno-strict-aliasing", "-msse4.1",
+            "/clang:-ffp-contract=off", "-Wno-everything", "/GS-"]
+
+
+def toolchain_env():
+    """The MSVC/clang-cl environment: the current one if it already has the
+    MSVC include paths (a VS prompt, thp8-native's tools/vsbuild.sh), else the
+    one tools/msvc_env.py derives from vcvars64.bat."""
+    if os.name != "nt" or os.environ.get("INCLUDE"):
+        return dict(os.environ)
+    from msvc_env import environ
+    return environ()
+
+
+def build(args, work, cpps, changed):
+    exe = os.path.join(work, "ppucheck_driver.exe")
+    env = toolchain_env()
+    drv_src = os.path.join(HERE, "driver_main.cpp")
+    objs = []
+    jobs = []
+    hdr_changed = "ppu_recomp.h" in changed
+    for name in cpps + ["driver_main.cpp"]:
+        src = drv_src if name == "driver_main.cpp" else os.path.join(work, name)
+        obj = os.path.join(work, name[:-4] + ".obj")
+        objs.append(obj)
+        stale = (not os.path.exists(obj) or name in changed or hdr_changed
+                 or os.path.getmtime(src) > os.path.getmtime(obj))
+        if stale:
+            jobs.append((src, obj))
+
+    flags = [f for f in CXXFLAGS if not (args.portable and f == "-msse4.1")] + (args.cxxflag or [])
+
+    def cc(job):
+        src, obj = job
+        cmd = [args.cxx] + flags + ["/I" + work, src, "/Fo" + obj]
+        r = subprocess.run(cmd, capture_output=True, text=True, env=env)
+        return src, r
+
+    t0 = time.time()
+    with ThreadPoolExecutor(max_workers=args.jobs) as ex:
+        for src, r in ex.map(cc, jobs):
+            if r.returncode != 0:
+                sys.stderr.write(f"compile failed: {src}\n{r.stdout[-6000:]}\n{r.stderr[-3000:]}\n")
+                raise SystemExit(2)
+    if jobs or not os.path.exists(exe):
+        cmd = [args.cxx, "/nologo"] + objs + ["/Fe" + exe]
+        r = subprocess.run(cmd, capture_output=True, text=True, env=env)
+        if r.returncode != 0:
+            sys.stderr.write(f"link failed\n{r.stdout[-4000:]}\n{r.stderr[-2000:]}\n")
+            raise SystemExit(2)
+    if args.verbose:
+        print(f"[build] {len(jobs)} objects compiled in {time.time() - t0:.1f}s")
+    return exe
+
+
+def run(exe, work, tests):
+    inp = os.path.join(work, "in.bin")
+    outp = os.path.join(work, "out.bin")
+    order = []
+    with open(inp, "wb") as fh:
+        for t in tests:
+            for k, s in enumerate(t.states):
+                fh.write(s.pack_in(t.idx))
+                order.append((t, k))
+    r = subprocess.run([exe, inp, outp], capture_output=True, text=True)
+    if r.returncode != 0:
+        sys.stderr.write(f"driver failed ({r.returncode}): {r.stderr[-3000:]}\n")
+        raise SystemExit(2)
+    with open(outp, "rb") as fh:
+        buf = fh.read()
+    if len(buf) != REC_OUT.size * len(order):
+        sys.stderr.write(f"driver wrote {len(buf)} bytes, expected {REC_OUT.size * len(order)}\n")
+        raise SystemExit(2)
+    results = defaultdict(list)
+    for i, (t, k) in enumerate(order):
+        results[t.idx].append(State.unpack_out(buf, i * REC_OUT.size))
+    return results
+
+
+# ---------------------------------------------------------------------------
+# reporting
+# ---------------------------------------------------------------------------
+
+def fmt_key(k):
+    if isinstance(k, tuple):
+        if k[0] == "mem":
+            return f"mem[{k[1]:#x}]"
+        return f"{k[0]}{k[1]}"
+    return k
+
+
+def fmt_val(k, v):
+    if isinstance(k, tuple) and k[0] == "vr":
+        return f"{v:032X}"
+    if isinstance(k, tuple) and k[0] == "mem":
+        return f"{v:02X}"
+    return f"{v:#x}"
+
+
+def describe_inputs(t, s):
+    """Short dump of the inputs an instruction reads (by its fields)."""
+    f = F(t.word, t.addr)
+    parts = []
+    form = t.spec.form
+    tags = t.spec.tags
+    if "fp" in tags:
+        regs = sorted({f.rt, f.ra, f.rb, f.frc})
+        parts += [f"f{r}={s.fpr[r]:016X}" for r in regs]
+        parts += [f"r{r}={s.gpr[r]:#x}" for r in sorted({f.ra, f.rb})] if t.spec.ea else []
+    elif "vmx" in tags:
+        regs = sorted({f.rt, f.ra, f.rb, f.vc})
+        parts += [f"v{r}={s.vr[r].hex().upper()}" for r in regs]
+        if t.spec.ea:
+            parts += [f"r{r}={s.gpr[r]:#x}" for r in sorted({f.ra, f.rb})]
+    else:
+        regs = sorted({f.rt, f.ra, f.rb})
+        parts += [f"r{r}={s.gpr[r]:#x}" for r in regs]
+    parts.append(f"cr={s.cr:08X} xer={s.xer:08X}")
+    if "branch" in tags or "spr" in tags:
+        parts.append(f"lr={s.lr:#x} ctr={s.ctr:#x}")
+    if t.spec.ea:
+        parts.append("mem@ea")
+    return " ".join(parts)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--census", help="census.json from census.py (counts, optional samples)")
+    ap.add_argument("--only", help="regex on spec names")
+    ap.add_argument("--tags", help="comma list of tags (int,cmp,rot,branch,cr,spr,ldst,atomic,fp,vmx,...)")
+    ap.add_argument("--used-only", action="store_true", help="only instructions the census counts")
+    ap.add_argument("--words", type=int, default=10, help="random encodings per instruction")
+    ap.add_argument("--title-words", type=int, default=32, help="title encodings per instruction (census samples)")
+    ap.add_argument("--states", type=int, default=40, help="random states per encoding")
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--profile", default="default", choices=("default", "full"))
+    ap.add_argument("--work", default=os.path.join(os.environ.get("TEMP", "."), "ppucheck_work"))
+    ap.add_argument("--cxx", default=os.environ.get("PPUCHECK_CXX", "clang-cl"))
+    ap.add_argument("--jobs", type=int, default=4)
+    ap.add_argument("--chunks", type=int, default=8)
+    ap.add_argument("--json", help="write machine-readable results here")
+    ap.add_argument("--max-examples", type=int, default=3)
+    ap.add_argument("--allow", help="file of spec names whose mismatches are known/accepted")
+    ap.add_argument("--portable", action="store_true",
+                    help="compile without -msse4.1 (exercises the lifter's portable fallbacks); "
+                         "use a separate --work directory")
+    ap.add_argument("--cxxflag", action="append",
+                    help="extra compiler flag for the test build (repeatable, e.g. -mfma); "
+                         "use a separate --work directory")
+    ap.add_argument("--lifter-dir", help="directory holding the ppu_lifter.py/ppu_disasm.py to test "
+                    "(default: this checkout's tools/)")
+    ap.add_argument("--list", action="store_true", help="list specs and exit")
+    ap.add_argument("--emit-only", action="store_true", help="generate sources/inputs, do not build or run")
+    ap.add_argument("-v", "--verbose", action="store_true")
+    args = ap.parse_args()
+
+    if args.lifter_dir:
+        sys.path.insert(0, os.path.abspath(args.lifter_dir))
+    mods = load_refs()
+    specs = list(SPECS)
+    if args.only:
+        rx = re.compile(args.only)
+        specs = [s for s in specs if rx.search(s.name)]
+    if args.tags:
+        want = set(args.tags.split(","))
+        specs = [s for s in specs if s.tags & want]
+    census = {}
+    samples = {}
+    if args.census:
+        with open(args.census) as fh:
+            cj = json.load(fh)
+        census = cj.get("counts", {})
+        samples = cj.get("samples", {})
+    if args.list:
+        for s in specs:
+            print(f"{s.name:12s} {s.form:4s} op={s.op} xo={s.xo} tags={','.join(sorted(s.tags))}")
+        return 0
+
+    # which title mnemonics map onto which spec (via the title's encodings)
+    spec_census = Counter()
+    mn_for_spec = defaultdict(set)
+    if samples:
+        for mn, words in samples.items():
+            sps = {find_spec(int(w, 16)) for w in words}
+            sps.discard(None)
+            for sp in sps:
+                mn_for_spec[sp.name].add(mn)
+                spec_census[sp.name] += census.get(mn, 0) // max(1, len(sps))
+    if args.used_only:
+        specs = [s for s in specs if spec_census.get(s.name)]
+
+    t0 = time.time()
+    tests, lf = build_tests(args, specs, samples)
+    skipped = gen_states(args, tests)
+    tests = [t for t in tests if t.states]
+    for i, t in enumerate(tests):       # function-table index (addr stays as lifted)
+        t.idx = i
+    ntests = sum(len(t.states) for t in tests)
+    print(f"[ppucheck] lifter: {sys.modules['ppu_lifter'].__file__}")
+    print(f"[ppucheck] refs: {', '.join(mods)}; {len(specs)} specs, {len(tests)} encodings, "
+          f"{ntests} cases ({dict(skipped)}) built in {time.time() - t0:.1f}s")
+
+    cpps, changed = emit_sources(args.work, tests, lf, args.chunks)
+    if args.emit_only:
+        print(f"[ppucheck] sources in {args.work} ({len(changed)} changed)")
+        return 0
+    exe = build(args, args.work, cpps, changed)
+    t1 = time.time()
+    results = run(exe, args.work, tests)
+    if args.verbose:
+        print(f"[run] {ntests} cases in {time.time() - t1:.1f}s")
+
+    allow = set()
+    if args.allow and os.path.exists(args.allow):
+        with open(args.allow) as fh:
+            allow = {ln.split("#")[0].strip() for ln in fh if ln.split("#")[0].strip()}
+
+    per_spec = defaultdict(lambda: {"cases": 0, "fail": 0, "encodings": 0, "examples": [],
+                                    "keys": Counter(), "unhandled": 0, "title_enc": 0, "title_fail": 0,
+                                    "mnemonics": set(), "notes": set()})
+    for t in tests:
+        ps = per_spec[t.spec.name]
+        ps["encodings"] += 1
+        ps["mnemonics"].add(t.insn.mnemonic)
+        if t.src == "title":
+            ps["title_enc"] += 1
+        if unhandled(t.code):
+            ps["unhandled"] += 1
+        for s_in, ref, got in zip(t.states, t.refs, results[t.idx]):
+            ps["cases"] += 1
+            ps["notes"].update(ref.notes)
+            diffs = compare(ref, got)
+            if diffs:
+                ps["fail"] += 1
+                if t.src == "title":
+                    ps["title_fail"] += 1
+                for k, _, _ in diffs:
+                    ps["keys"][fmt_key(k) if not isinstance(k, tuple) else k[0]] += 1
+                if len(ps["examples"]) < args.max_examples:
+                    ps["examples"].append({
+                        "word": f"{t.word:08X}", "asm": f"{t.insn.mnemonic} {t.insn.operands}", "src": t.src,
+                        "code": t.code, "inputs": describe_inputs(t, s_in),
+                        "diffs": [(fmt_key(k), fmt_val(k, a), fmt_val(k, b)) for k, a, b in diffs[:6]],
+                    })
+
+    # report
+    rows = []
+    for sp in specs:
+        ps = per_spec.get(sp.name)
+        if not ps or not ps["cases"]:
+            continue
+        rows.append((sp, ps))
+    rows.sort(key=lambda r: (-(r[1]["fail"] > 0), -spec_census.get(r[0].name, 0), r[0].name))
+    nfail = 0
+    total_cases = 0
+    lines = []
+    for sp, ps in rows:
+        total_cases += ps["cases"]
+        cnt = spec_census.get(sp.name, 0)
+        status = "FAIL" if ps["fail"] else "ok"
+        if ps["fail"] and sp.name in allow:
+            status = "known"
+        elif ps["fail"]:
+            nfail += 1
+        lines.append(f"{status:5s} {sp.name:12s} title={cnt:7d} enc={ps['encodings']:3d} "
+                     f"(title {ps['title_enc']:2d}) cases={ps['cases']:5d} fail={ps['fail']:5d} "
+                     f"{'(title-enc fails ' + str(ps['title_fail']) + ') ' if ps['title_fail'] else ''}"
+                     f"{'UNHANDLED ' if ps['unhandled'] else ''}"
+                     f"{' '.join(f'{k}:{v}' for k, v in ps['keys'].most_common(4))}"
+                     f"{' notes=' + ','.join(sorted(ps['notes'])) if ps['notes'] else ''}")
+        if ps["fail"] and status != "known":
+            for ex in ps["examples"]:
+                lines.append(f"        {ex['word']}  {ex['asm']}{'   [title encoding]' if ex['src'] == 'title' else ''}")
+                lines.append(f"          in:  {ex['inputs']}")
+                for k, a, b in ex["diffs"]:
+                    lines.append(f"          {k}: expected {a}  got {b}")
+                lines.append(f"          C:   {ex['code'][:400]}")
+    print("\n".join(lines))
+    used = {m for m, c in census.items() if c}
+    covered = set().union(*[ps["mnemonics"] for ps in per_spec.values()]) if per_spec else set()
+    if census and not (args.only or args.tags or args.used_only):
+        miss = sorted(used - covered, key=lambda m: -census[m])
+        print(f"[coverage] title mnemonics: {len(used)}; exercised: {len(used & covered)}; "
+              f"not exercised: {', '.join(f'{m}({census[m]})' for m in miss)}")
+    print(f"[ppucheck] {len(rows)} instructions, {total_cases} cases, {nfail} failing instructions")
+    if args.json:
+        out = {"specs": {sp.name: {k: (sorted(v) if isinstance(v, set) else
+                                       dict(v) if isinstance(v, Counter) else v)
+                                   for k, v in ps.items()} | {"title_count": spec_census.get(sp.name, 0)}
+                         for sp, ps in rows},
+               "cases": total_cases, "failing": nfail}
+        with open(args.json, "w") as fh:
+            json.dump(out, fh, indent=1)
+    return 1 if nfail else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
