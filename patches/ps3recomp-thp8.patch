+globalThis.ps3keys = async (seq, hold = 150) => {
+  for (const s of seq) {
+    if (typeof s === "number") { await new Promise((r) => setTimeout(r, s)); continue; }
+    window.dispatchEvent(new KeyboardEvent("keydown", { code: s }));
+    await new Promise((r) => setTimeout(r, hold));
+    window.dispatchEvent(new KeyboardEvent("keyup", { code: s }));
+  }
+};
+// title screen -> Free Skate in the default level (THP8 menus): ps3freeskate() once "PRESS START" is up
+globalThis.ps3freeskate = () => globalThis.ps3keys(["Enter", 6000, "Enter", 8000, "ArrowRight", 1000, "ArrowRight", 1000,
+                                                     "Enter", 6000, "Enter", 6000, "Enter"]);
+globalThis.ps3grep =(re, n = 200) => (globalThis.ps3log || []).filter((l) => re.test(l)).slice(-n).join("\n");
+// The page's log: lines are batched and written to the DOM at most every 250 ms, and the panel keeps only the
+// last 1500 lines. Appending to a 400 KB textContent per line (and console.log per line) could not keep up with
+// a chatty run -- the main thread fell behind the workers' prints and the page stopped responding.
+const LOG_KEEP = 200000, LOG_PANEL = 1500;
+let pending = [], panel = [], flushT = 0;
+function flushLog() {
+  flushT = 0;
+  if (!pending.length) return;
+  panel = panel.concat(pending); pending = [];
+  if (panel.length > LOG_PANEL) panel = panel.slice(-LOG_PANEL);
+  logEl.textContent = panel.join("\n") + "\n";
+  logEl.scrollTop = logEl.scrollHeight;
+}
+export function log(...a) {
+  const line = a.map((x) => (typeof x === "string" ? x : JSON.stringify(x))).join(" ");
+  const keep = globalThis.ps3log || (globalThis.ps3log = []);   // recent history, for ps3grep(/re/) in devtools
+  keep.push(line);
+  if (keep.length > LOG_KEEP * 1.25) keep.splice(0, keep.length - LOG_KEEP);
+  pending.push(line);
+  if (!flushT) flushT = setTimeout(flushLog, 250);
+  if (globalThis.PS3WEB_CONSOLE) console.log(line);           // opt-in: devtools' console is slow with floods
+}
+window.__ps3log = log;
+// Uncaught errors and rejected promises of the page go into the log too (so "Save log" carries them); the workers'
+// own errors arrive through their onerror below.
+globalThis.__pageErrors = 0;
+window.addEventListener("error", (e) => (globalThis.__pageErrors++, log(`[page] ERROR ${e.message || e} ${e.filename ? `(${e.filename.split("/").pop()}:${e.lineno})` : ""}`)));
+window.addEventListener("unhandledrejection", (e) => (globalThis.__pageErrors++, log(`[page] unhandled rejection: ${e.reason && (e.reason.stack || e.reason.message) || e.reason}`)));
+// "Save log": the whole kept log (not just the panel) as a text file -- local only, nothing is uploaded
+function saveLog() {
+  const head = [`ps3recomp web log, ${new Date().toISOString()}`, `page: ${location.pathname}${location.search}`, `ua: ${navigator.userAgent}`, ""];
+  const blob = new Blob([head.concat(globalThis.ps3log || []).join("\n") + "\n"], { type: "text/plain" });
+  const a = document.createElement("a");
+  a.href = URL.createObjectURL(blob);
+  a.download = `ps3web-log-${new Date().toISOString().replace(/[:.]/g, "-")}.txt`;
+  document.body.appendChild(a); a.click(); a.remove();
