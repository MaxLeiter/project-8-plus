+def _mul(sz, even, signed):
+    get, _, bits = _SZ[sz]
+    out_put = fromH if sz == "b" else fromW
+
+    def sem(s, f):
+        a, b = get(s.vr[f.ra]), get(s.vr[f.rb])
+        if signed:
+            a = [sext(x, bits) for x in a]
+            b = [sext(x, bits) for x in b]
+        idx = range(0 if even else 1, len(a), 2)
+        s.set_v(f.rt, out_put([a[i] * b[i] for i in idx]))
+    return sem
+
+
+for _sz, _o in (("b", 0), ("h", 64)):
+    vx(f"vmulou{_sz}", 8 + _o, _mul(_sz, False, False))
+    vx(f"vmulos{_sz}", 264 + _o, _mul(_sz, False, True))
+    vx(f"vmuleu{_sz}", 520 + _o, _mul(_sz, True, False))
+    vx(f"vmules{_sz}", 776 + _o, _mul(_sz, True, True))
+
