+int api_tex_redirect(const ps3mod_host* self, uint64_t key, const char* path_utf8)
+{
+    if (!find_plugin(self)) return PS3MOD_E_ARG;
+#if defined(PS3_WASM)
+    /* Browser build: texture replacement is opt-in (the page passes PS3_TEXREPL=0 by default). Off = unavailable,
+     * so a plugin that probes this at init (eye colour) does not switch on a feature that would never show. */
+    { const char* e = getenv("PS3_TEXREPL");
+      if (e && (!strcmp(e, "0") || !strcasecmp(e, "off"))) return PS3MOD_E_UNAVAILABLE; }
+    return texrepl_redirect_utf8(key, path_utf8) == 0 ? PS3MOD_OK : PS3MOD_E_NOMEM;
+#elif defined(_WIN32)
+    return texrepl_redirect_utf8(key, path_utf8) == 0 ? PS3MOD_OK : PS3MOD_E_NOMEM;
+#else
+    /* native Linux: present when the runtime has the vkd3d live-draw renderer (weak, see the declarations) */
+    if (!texrepl_redirect_utf8) { (void)key; (void)path_utf8; return PS3MOD_E_UNAVAILABLE; }
+    return texrepl_redirect_utf8(key, path_utf8) == 0 ? PS3MOD_OK : PS3MOD_E_NOMEM;
+#endif
+}
