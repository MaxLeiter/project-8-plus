diff --git a/runtime/memory/vm_ready.h b/runtime/memory/vm_ready.h
new file mode 100644
index 00000000..d41bee51
--- /dev/null
+++ b/runtime/memory/vm_ready.h
@@ -0,0 +1,36 @@
+/*
+ * ps3recomp - "is the guest VM mapped?" (VM_READY), shareable without the rest of vm.h.
+ *
+ * VM_MAPPED (the runtime's call sites) / VM_READY (vm.h): test these, never vm_base itself: under native-VA mapping and on WebAssembly vm_base is deliberately 0
+ * (guest address == host address), so a null vm_base does not mean "no VM".
+ *   - Windows / POSIX: mapped once vm_base is set or ppu_vm_size is published (native VA).
+ *   - WebAssembly (PS3_WASM): linear memory IS the guest address space, from the first instruction.
+ */
+#ifndef PS3RECOMP_VM_READY_H
+#define PS3RECOMP_VM_READY_H
+#if defined(_WIN32) && !defined(PS3_WASM)
+/* Windows: boot_main maps vm_base before any guest code runs and never uses native VA (ppu_vm_size stays 0), so
+ * VM_MAPPED is the plain pointer test the call sites had before the web port, and VM_READY keeps vm.h's own
+ * definition: the Windows build stays preprocess-identical to the pre-web runtime (users declare vm_base / ppu_vm_size
+ * themselves, as they did; this header adds no declarations here). */
+#  define VM_READY (vm_base != 0 || ppu_vm_size != 0)
+#  define VM_MAPPED vm_base
+#else
+#include <stdint.h>
+#include "../platform/ps3_wasm.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern uint8_t* vm_base;
+extern uint32_t ppu_vm_size;
+#ifdef __cplusplus
+}
+#endif
+#ifdef PS3_WASM
+#  define VM_READY 1
+#else
+#  define VM_READY (vm_base != 0 || ppu_vm_size != 0)
+#endif
+#define VM_MAPPED VM_READY   /* POSIX / WebAssembly: the same test (native VA aware) */
+#endif
+#endif
