+/* ---- Variant DLLs (SPU_VARIANT_DIR) ---- */
+u128 spu_rdch(spu_context* ctx, uint32_t channel);                 /* defined below */
+uint32_t spu_rchcnt(spu_context* ctx, uint32_t channel);
+void spu_wrch(spu_context* ctx, uint32_t channel, u128 value);
+static const spu_variant_sym s_var_syms[] = {
+#define SPU_VS_(n) { #n, (void*)&n },
+    SPU_VARIANT_FUNCS(SPU_VS_) SPU_VARIANT_DATA(SPU_VS_)
+#undef SPU_VS_
+};
+static void* spu_var_tls_addr(const char* name)
+{
+#define SPU_VT_ADDR_(n) if (!strcmp(name, #n)) return (void*)&n;
+    SPU_VARIANT_TLS(SPU_VT_ADDR_)
+#undef SPU_VT_ADDR_
+    return NULL;
+}
+#if defined(_WIN64) && defined(_MSC_VER)
+extern unsigned long _tls_index;                          /* CRT tlssup: this module's TLS slot */
+#endif
+static uint32_t spu_var_fill_tls(spu_variant_tls* t, uint32_t* index)
+{
+    uint32_t i = 0;
+    *index = 0;
+#if defined(_WIN64) && defined(_MSC_VER)
+    /* Offsets within this module's implicit-TLS block: the same for every
+     * thread (the block is a copy of one template). */
+    char* base = ((char**)__readgsqword(0x58))[_tls_index];
+#define SPU_VT_OFF_(n) t[i].name = #n; t[i].off = (uint64_t)((char*)&n - base); i++;
+    SPU_VARIANT_TLS(SPU_VT_OFF_)
+#undef SPU_VT_OFF_
+    *index = (uint32_t)_tls_index;
+#else
+#define SPU_VT_OFF_(n) t[i].name = #n; t[i].off = 0; i++;
+    SPU_VARIANT_TLS(SPU_VT_OFF_)
+#undef SPU_VT_OFF_
+#endif
+    return i;
+}
+int spu_variant_load_dir(const char* dir)
+{
+#ifdef _WIN32
+    static spu_variant_api api;
+    static spu_variant_tls tls[SPU_VT_COUNT];
+    api.version = SPU_VARIANT_API_VERSION;
+    api.size = (uint32_t)sizeof api;
+    api.add = spu_variant_add;
+    api.syms = s_var_syms;
+    api.n_syms = (uint32_t)(sizeof s_var_syms / sizeof s_var_syms[0]);
+    api.n_tls = spu_var_fill_tls(tls, &api.tls_index);
+    api.tls = tls;
+    api.tls_addr = spu_var_tls_addr;
+    char pat[600];
+    snprintf(pat, sizeof pat, "%s/*.dll", dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE) {
+        fprintf(stderr, "[spu-var] SPU_VARIANT_DIR=%s: no *.dll there\n", dir);
+        return 0;
+    }
+    int total = 0;
+    do {
+        size_t nl = strlen(fd.cFileName);
+        if (nl < 4 || _stricmp(fd.cFileName + nl - 4, ".dll") != 0) continue;   /* 8.3 wildcard quirk */
+        char path[900];
+        snprintf(path, sizeof path, "%s/%s", dir, fd.cFileName);
+        HMODULE m = LoadLibraryA(path);
+        if (!m) {
+            fprintf(stderr, "[spu-var] %s: LoadLibrary failed (error %lu)\n", path, GetLastError());
+            continue;
+        }
+        spu_variants_register_fn reg = (spu_variants_register_fn)(void*)GetProcAddress(m, SPU_VARIANTS_ENTRY);
+        int rc = reg ? reg(&api) : -100;
+        if (rc < 0) {       /* the glue binds before it registers: nothing points into it */
+            fprintf(stderr, "[spu-var] %s: %s (%d) -- not used\n", path,
+                    reg ? "cannot bind to this runtime" : "no " SPU_VARIANTS_ENTRY " export", rc);
+            FreeLibrary(m);
+            continue;
+        }
+        fprintf(stderr, "[spu-var] %s: %d variant(s) registered\n", path, rc);
+        total += rc;
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+    return total;
+#else
+    fprintf(stderr, "[spu-var] SPU_VARIANT_DIR=%s ignored: variant DLLs are Windows-only\n", dir);
+    return 0;
+#endif
+}
+static void spu_var_print_stats(void)
+{
+    spu_variant_stats s; spu_variant_get_stats(&s);
+    fprintf(stderr, "[spu-var] stats: %llu registered, %llu validations (%llu rejected), "
+            "%llu entry spot-check failures, %llu dirty code pages, %llu consumes, "
+            "%llu interpreter fallbacks\n",
+            (unsigned long long)s.registered, (unsigned long long)s.validations,
+            (unsigned long long)s.rejects, (unsigned long long)s.spot_fails,
+            (unsigned long long)s.dirty_marks, (unsigned long long)s.consumes,
+            (unsigned long long)s.misses);
+}
+/* Once per process, before the first SPU run executes anything; concurrent
+ * first runs wait for it, so registration never races a lookup. */
+static void spu_variant_init(void)
+{
+    long expect = 0;
+    if (__atomic_compare_exchange_n(&s_var_state, &expect, 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        const char* e = getenv("SPU_VARIANT_VERIFY");
+        s_var_verify = e && *e && *e != '0';
+        e = getenv("SPU_VARIANT_DIR");
+        if (e && *e) spu_variant_load_dir(e);
+        if (s_var_n)
+            fprintf(stderr, "[spu-var] %u variant(s) registered%s\n", s_var_n,
+                    s_var_verify ? " (SPU_VARIANT_VERIFY: full check on every dispatch)" : "");
+        if ((e = getenv("SPU_VARIANT_STATS")) && *e && *e != '0') atexit(spu_var_print_stats);
+        __atomic_store_n(&s_var_state, 2, __ATOMIC_RELEASE);
+        return;
+    }
+    while (__atomic_load_n(&s_var_state, __ATOMIC_ACQUIRE) != 2) {
+#ifdef _WIN32
+        Sleep(0);
+#else
+        sched_yield();
+#endif
+    }
+}
