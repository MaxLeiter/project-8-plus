+#ifdef PS3_WASM
+/* Browser: the page's keyboard layout (navigator.keyboard.getLayoutMap) arrives as PS3_WASM_KEYLAYOUT =
+ * "<HID usage>=<percent-encoded key>,..." (e.g. "20=a,26=z,16=%2C" on AZERTY). Unset = the US names. Only a
+ * single printable character is used (a-z upper-cased, as the Windows branch does); anything else keeps the name. */
+#include <pthread.h>
+#include <stdlib.h>
+static int sdl_scancode(unsigned code);
+static char s_kl[256][8];
+static pthread_once_t s_kl_once = PTHREAD_ONCE_INIT;
+static int kl_hex(char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
+static void kl_parse(void)
+{
+    const char* p = getenv("PS3_WASM_KEYLAYOUT");
+    int n = 0;
+    while (p && *p) {
+        char v[16];
+        size_t o = 0;
+        unsigned hid = 0;
+        int ok = 0;
+        while (*p >= '0' && *p <= '9') { hid = hid * 10u + (unsigned)(*p++ - '0'); ok = 1; }
+        if (*p == '=') p++; else ok = 0;
+        for (; *p && *p != ','; p++) {
+            char c = *p;
+            if (c == '%' && kl_hex(p[1]) >= 0 && kl_hex(p[2]) >= 0) { c = (char)(kl_hex(p[1]) << 4 | kl_hex(p[2])); p += 2; }
+            if (o + 1 < sizeof v) v[o++] = c;
+        }
+        if (*p == ',') p++;
+        v[o] = 0;
+        if (!ok || hid >= 256 || !o) continue;
+        {   /* exactly one code point, printable */
+            const unsigned char b = (unsigned char)v[0];
+            const size_t len = b < 0x80 ? 1 : (b >> 5) == 6 ? 2 : (b >> 4) == 14 ? 3 : (b >> 3) == 30 ? 4 : 0;
+            if (!len || len != o || (len == 1 && b < 0x21) || len >= sizeof s_kl[0]) continue;
+        }
+        if (v[0] >= 'a' && v[0] <= 'z') v[0] = (char)(v[0] - 32);
+        memcpy(s_kl[hid], v, o + 1);
+        n++;
+    }
+    if (n) fprintf(stderr, "[input] keyboard layout from the page: %d keys\n", n);
+}
+static const char* web_layout_key(unsigned code)
+{
+    int h;
+    pthread_once(&s_kl_once, kl_parse);
+    h = sdl_scancode(code);
+    return (h > 0 && h < 256 && s_kl[h][0]) ? s_kl[h] : NULL;
+}
+#endif
