+/* spu_float.h fix-up model for special float lanes (exponent-255 operands, results at / beyond FLT_MAX):
+ * PS3_SPU_FP_FASTFIX=0 -> the 128-bit integer model, default 1 -> the exact double model (same bits, ~4x
+ * cheaper). PS3_SPU_FP_FASTFIX_OFF_FILE=<path>: live A/B, present = integer model (checked every 64Ki calls). */
+static volatile int s_fpff_env = -1, s_fpff_live = 1;
+static const char* s_fpff_off;
+static unsigned s_fpff_n;
+volatile int g_spu_fp_fastfix = -1;   /* spu_float.h fast read: 0 off, 1 on, 2 on with a live off-file (ask here) */
+int spu_fp_fastfix_on(void)
+{
+    int on = s_fpff_env;
+    if (__builtin_expect(on < 0, 0)) {
+        const char* e = getenv("PS3_SPU_FP_FASTFIX");
+        s_fpff_off = getenv("PS3_SPU_FP_FASTFIX_OFF_FILE");
+        if (s_fpff_off && !*s_fpff_off) s_fpff_off = NULL;
+        on = (e && *e == '0') ? 0 : 1;
+        g_spu_fp_fastfix = on ? (s_fpff_off ? 2 : 1) : 0;
+        if (__atomic_exchange_n(&s_fpff_env, on, __ATOMIC_ACQ_REL) < 0)
+            fprintf(stderr, "[spu-fp] special-lane fix-up: %s model%s (PS3_SPU_FP_FASTFIX=0: integer model)\n",
+                    on ? "fast exact double" : "integer", s_fpff_off ? ", live off-file" : "");
+    }
+    if (!on || !s_fpff_off) return on;
+    if ((s_fpff_n++ & 0xFFFFu) == 0) s_fpff_live = GetFileAttributesA(s_fpff_off) == INVALID_FILE_ATTRIBUTES;
+    return s_fpff_live;
