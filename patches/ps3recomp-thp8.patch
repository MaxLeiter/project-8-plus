+static void fmt_reg(char* buf, size_t n, const uint8_t r[16])
+{
+    snprintf(buf, n, "%08X_%08X_%08X_%08X", get32(r), get32(r + 4), get32(r + 8), get32(r + 12));
+}
+static void fmt_out(char* buf, size_t n, const outc* o)
+{
+    if (o->kind == O_NEXT) snprintf(buf, n, "NEXT pc=0x%05X", o->pc);
+    else if (o->kind == O_STOP) snprintf(buf, n, "STOP code=0x%04X", o->code);
+    else if (o->kind == O_BADFN) snprintf(buf, n, "%s pc=0x%05X", o_name[o->kind], o->pc);
+    else snprintf(buf, n, "%s", o_name[o->kind]);
+}
+
+/* ---- float mismatch classes (for the float-helper redesign) ---- */
+static const char* const cls_name[] = {
+    "in:exp255/Inf/NaN", "in:denormal", "in:-0", "out:saturate(0x7FFFFFFF)", "out:exp255",
+    "out:+0(underflow/exact)", "ulp+1", "ulp-1", "ulp(2..16)", "out:NaN", "out:denormal(got)",
+    "sign", "other", "trap/unimplemented"
+};
+enum { C_INSPEC, C_INDEN, C_INNZ, C_SAT, C_E255, C_ZERO, C_UP1, C_DN1, C_ULPN, C_NAN, C_DEN, C_SIGN, C_OTHER, C_TRAP };
+
+static int is_dp_op(const char* mn)
+{
+    return mn[0] == 'd' && mn[1] == 'f';
+}
+static int classify_sp(uint32_t a, uint32_t b, uint32_t c, int nin, uint32_t ref, uint32_t got, int is_cmp)
+{
+    uint32_t in[3] = { a, b, c };
+    for (int i = 0; i < nin; i++) if (((in[i] >> 23) & 0xFF) == 255) return C_INSPEC;
+    for (int i = 0; i < nin; i++) if (((in[i] >> 23) & 0xFF) == 0 && (in[i] & 0x7FFFFF)) return C_INDEN;
+    if (is_cmp) {
+        for (int i = 0; i < nin; i++) if (in[i] == 0x80000000u) return C_INNZ;
+        return C_OTHER;
+    }
+    if ((ref & 0x7FFFFFFFu) == 0x7FFFFFFFu) return C_SAT;
+    if (((ref >> 23) & 0xFF) == 255) return C_E255;
+    if (ref == 0) return C_ZERO;
+    if ((ref ^ got) == 0x80000000u) return C_SIGN;
+    if ((ref >> 31) == (got >> 31)) {
+        int64_t d = (int64_t)(got & 0x7FFFFFFFu) - (int64_t)(ref & 0x7FFFFFFFu);
+        if (d == 1) return C_UP1;
+        if (d == -1) return C_DN1;
+        if (d >= -16 && d <= 16) return C_ULPN;
+    }
+    for (int i = 0; i < nin; i++) if (in[i] == 0x80000000u) return C_INNZ;
+    return C_OTHER;
+}
+static int dp_cls(uint64_t x) /* 0 normal/zero, 1 special, 2 denormal */
+{
+    uint32_t e = (uint32_t)(x >> 52) & 0x7FF;
+    if (e == 0x7FF) return 1;
+    if (e == 0 && (x & 0xFFFFFFFFFFFFFull)) return 2;
+    return 0;
+}
+static int classify_dp(uint64_t a, uint64_t b, uint64_t c, int nin, uint64_t ref, uint64_t got, int is_cmp)
+{
+    uint64_t in[3] = { a, b, c };
+    for (int i = 0; i < nin; i++) if (dp_cls(in[i]) == 1) return C_INSPEC;
+    for (int i = 0; i < nin; i++) if (dp_cls(in[i]) == 2) return C_INDEN;
+    if (is_cmp) return C_OTHER;
+    if (ref == 0x7FF8000000000000ull) return C_NAN;
+    if (dp_cls(got) == 2) return C_DEN;
+    if ((ref & 0x7FFFFFFFFFFFFFFFull) == 0) return C_ZERO;
+    if ((ref ^ got) == 0x8000000000000000ull) return C_SIGN;
+    if ((ref >> 63) == (got >> 63)) {
+        int64_t d = (int64_t)((got & 0x7FFFFFFFFFFFFFFFull) - (ref & 0x7FFFFFFFFFFFFFFFull));
+        if (d == 1) return C_UP1;
+        if (d == -1) return C_DN1;
+        if (d >= -16 && d <= 16) return C_ULPN;
+    }
+    return C_OTHER;
+}
+
+/* Record float-lane classes for one mismatching run (dest register only). */
+static void float_classes(mnstat* st, int ex, const spck_case* cs, const seedstate* in,
+                          const result* ref, const result* got, int trap)
+{
+    int regs[4]; const char* f;
+    int n = spu_ref_operand_regs(cs->insn, regs, &f);
+    int rrr = (n == 4);
+    int rd = regs[0];
+    int ra = regs[1 % n], rb = (n > 2) ? regs[2] : regs[1 % n], rc = rrr ? regs[3] : rd;
+    const char* mn = cs->mn;
+    int is_cmp = strstr(mn, "fc") == mn || strstr(mn, "dfc") == mn || !strcmp(mn, "dftsv");
+    if (trap) {
+        st->cls_n[ex][C_TRAP]++;
+        if (st->cls_n[ex][C_TRAP] == 1)
+            snprintf(st->cls_ex[ex][C_TRAP], sizeof st->cls_ex[ex][C_TRAP], "insn 0x%08X traps in the interpreter", cs->insn);
+        return;
+    }
+    if (is_dp_op(mn) || !strcmp(mn, "fesd") || !strcmp(mn, "frds")) {
+        for (int i = 0; i < 2; i++) {
+            if (!strcmp(mn, "frds")) {
+                uint32_t r = get32(ref->gpr[rd] + 8 * i), g = get32(got->gpr[rd] + 8 * i);
+                uint64_t x = get64(in->gpr[ra] + 8 * i);
+                if (r == g && get32(ref->gpr[rd] + 8 * i + 4) == get32(got->gpr[rd] + 8 * i + 4)) continue;
+                int k = dp_cls(x) == 1 ? C_INSPEC : dp_cls(x) == 2 ? C_INDEN : classify_sp(0, 0, 0, 0, r, g, 0);
+                st->cls_n[ex][k]++;
+                if (st->cls_n[ex][k] == 1)
+                    snprintf(st->cls_ex[ex][k], sizeof st->cls_ex[ex][k], "in=%016llX expect=%08X got=%08X",
+                             (unsigned long long)x, r, g);
+                continue;
+            }
+            uint64_t r = get64(ref->gpr[rd] + 8 * i), g = get64(got->gpr[rd] + 8 * i);
+            if (r == g) continue;
+            uint64_t a = get64(in->gpr[ra] + 8 * i), b = get64(in->gpr[rb] + 8 * i), c = get64(in->gpr[rd] + 8 * i);
+            int k;
+            if (!strcmp(mn, "fesd")) {
+                uint32_t s = get32(in->gpr[ra] + 8 * i);
+                k = classify_sp(s, 0, 0, 1, 0x3F800000u, 0x3F800000u, 1);
+                if (k == C_OTHER) k = classify_dp(0, 0, 0, 0, r, g, 0);
+                st->cls_n[ex][k]++;
+                if (st->cls_n[ex][k] == 1)
+                    snprintf(st->cls_ex[ex][k], sizeof st->cls_ex[ex][k], "in=%08X expect=%016llX got=%016llX",
+                             s, (unsigned long long)r, (unsigned long long)g);
+                continue;
+            }
+            int nin = (!strcmp(mn, "dftsv")) ? 1 : (!strcmp(mn, "dfma") || !strcmp(mn, "dfms") || !strcmp(mn, "dfnms") || !strcmp(mn, "dfnma")) ? 3 : 2;
+            k = classify_dp(a, b, c, nin, r, g, is_cmp);
+            st->cls_n[ex][k]++;
+            if (st->cls_n[ex][k] == 1) {
+                char* e = st->cls_ex[ex][k]; size_t es = sizeof st->cls_ex[ex][k];
+                if (nin == 3)
+                    snprintf(e, es, "a=%016llX b=%016llX t=%016llX expect=%016llX got=%016llX",
+                             (unsigned long long)a, (unsigned long long)b, (unsigned long long)c,
+                             (unsigned long long)r, (unsigned long long)g);
+                else if (nin == 1)
+                    snprintf(e, es, "a=%016llX i7=0x%02X expect=%016llX got=%016llX", (unsigned long long)a,
+                             (cs->insn >> 14) & 0x7F, (unsigned long long)r, (unsigned long long)g);
+                else
+                    snprintf(e, es, "a=%016llX b=%016llX expect=%016llX got=%016llX", (unsigned long long)a,
+                             (unsigned long long)b, (unsigned long long)r, (unsigned long long)g);
+            }
+        }
+        return;
+    }
+    for (int i = 0; i < 4; i++) {
+        uint32_t r = get32(ref->gpr[rd] + 4 * i), g = get32(got->gpr[rd] + 4 * i);
+        if (r == g) continue;
+        uint32_t a = get32(in->gpr[ra] + 4 * i), b = get32(in->gpr[rb] + 4 * i), c = get32(in->gpr[rc] + 4 * i);
+        int nin = rrr ? 3 : (!strcmp(mn, "cflts") || !strcmp(mn, "cfltu") || !strcmp(mn, "frest") || !strcmp(mn, "frsqest")) ? 1
+                : (!strcmp(mn, "csflt") || !strcmp(mn, "cuflt")) ? 0 : 2;
+        int k;
+        if (!strcmp(mn, "cflts") || !strcmp(mn, "cfltu")) {
+            k = classify_sp(a, 0, 0, 1, 0, 0, 1);
+            if (k == C_OTHER && (r == 0x7FFFFFFFu || r == 0x80000000u || r == 0xFFFFFFFFu || r == 0)) k = C_SAT;
+        } else if (!strcmp(mn, "fi")) {
+            k = classify_sp(0, 0, 0, 0, r, g, 0);
+        } else {
+            k = classify_sp(a, b, c, nin, r, g, is_cmp);
+        }
+        st->cls_n[ex][k]++;
+        if (st->cls_n[ex][k] == 1) {
+            if (nin == 3)
+                snprintf(st->cls_ex[ex][k], sizeof st->cls_ex[ex][k], "a=%08X b=%08X c=%08X expect=%08X got=%08X", a, b, c, r, g);
+            else if (nin == 0)
+                snprintf(st->cls_ex[ex][k], sizeof st->cls_ex[ex][k], "a=%08X i8=%u expect=%08X got=%08X", a, (cs->insn >> 14) & 0xFF, r, g);
+            else if (nin == 1)
+                snprintf(st->cls_ex[ex][k], sizeof st->cls_ex[ex][k], "a=%08X%s expect=%08X got=%08X", a,
+                         (!strcmp(mn, "cflts") || !strcmp(mn, "cfltu")) ? " (i8 in insn)" : "", r, g);
+            else
+                snprintf(st->cls_ex[ex][k], sizeof st->cls_ex[ex][k], "a=%08X b=%08X expect=%08X got=%08X", a, b, r, g);
+        }
+    }
+}
+
+static void report_example(int ex, const spck_case* cs, int seed, const seedstate* in,
+                           const result* ref, const result* got, int aspects, int full_ls_diff)
+{
+    char b1[64], b2[64], o1[64], o2[64];
+    int regs[4]; const char* f;
+    int n = spu_ref_operand_regs(cs->insn, regs, &f);
+    fmt_out(o1, sizeof o1, &ref->o); fmt_out(o2, sizeof o2, &got->o);
+    if (cs->seq_hi) {
+        printf("  [%s] %s program %s (img %d seed %d; listing: gen/spsq_listing.txt)\n",
+               ex_name[ex], cs->mn, cs->ops, cs->img, seed);
+        printf("      srr0=%05X ie=%u ev=%08X&%08X\n", in->srr0, in->int_enable, in->event_status, in->event_mask);
+    } else {
+    printf("  [%s] %-8s insn=0x%08X  %s %s   (case@LS 0x%05X img %d seed %d)\n",
+           ex_name[ex], cs->mn, cs->insn, cs->mn, cs->ops, cs->addr, cs->img, seed);
+    printf("      inputs:");
+    for (int i = 0; i < n; i++) {
+        fmt_reg(b1, sizeof b1, in->gpr[regs[i]]);
+        printf(" r%d=%s", regs[i], b1);
+    }
+    printf("  srr0=%05X ie=%u ev=%08X&%08X\n", in->srr0, in->int_enable, in->event_status, in->event_mask);
+    }
+    printf("      expect: %-22s got: %s%s%s%s%s%s\n", o1, o2,
+           (aspects & D_OUTCOME) ? "  [outcome]" : "", (aspects & D_LS) ? (full_ls_diff ? "  [LS(full)]" : "  [LS]") : "",
+           (aspects & D_CHAN) ? "  [channel log]" : "", (aspects & D_INTEN) ? "  [int_enable]" : "",
+           (aspects & (D_DEST | D_OTHERREG)) ? "  [regs]" : "");
+    int shown = 0;
+    for (int r = 0; r < 128 && shown < (cs->seq_hi ? 12 : 4); r++) {
+        if (!memcmp(ref->gpr[r], got->gpr[r], 16)) continue;
+        fmt_reg(b1, sizeof b1, ref->gpr[r]); fmt_reg(b2, sizeof b2, got->gpr[r]);
+        printf("      r%-3d expect %s  got %s", r, b1, b2);
+        if (cs->seq_hi) { char b3[64]; fmt_reg(b3, sizeof b3, in->gpr[r]); printf("  (in %s)", b3); }
+        printf("\n");
+        shown++;
+    }
+    if (aspects & D_INTEN) printf("      int_enable expect %u got %u\n", ref->int_enable, got->int_enable);
+    if (aspects & D_CHAN) {
+        printf("      chan expect:"); for (int i = 0; i < ref->log.n && i < 8; i++) printf(" %c%u=%08X", "?RCW"[ref->log.e[i].op], ref->log.e[i].ch, ref->log.e[i].v);
+        printf("\n      chan got:   "); for (int i = 0; i < got->log.n && i < 8; i++) printf(" %c%u=%08X", "?RCW"[got->log.e[i].op], got->log.e[i].ch, got->log.e[i].v);
+        printf("\n");
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Main loop
+ * ------------------------------------------------------------------------ */
+static int chlog_eq(const chlog* a, const chlog* b)
+{
+    if (a->n != b->n) return 0;
+    for (int i = 0; i < a->n && i < 8; i++)
+        if (a->e[i].op != b->e[i].op || a->e[i].ch != b->e[i].ch || a->e[i].v != b->e[i].v) return 0;
+    return 1;
+}
+static int outc_eq(const outc* a, const outc* b)
+{
+    if (a->kind != b->kind) return 0;
+    if (a->kind == O_NEXT) return a->pc == b->pc;
+    if (a->kind == O_STOP) return a->code == b->code;
+    return 1;
+}
+
+static char* read_file(const char* path, size_t* n)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
+    char* p = (char*)malloc((size_t)sz);
+    if (p && fread(p, 1, (size_t)sz, f) != (size_t)sz) { free(p); p = 0; }
+    fclose(f); *n = (size_t)sz; return p;
+}
+
+int main(int argc, char** argv)
+{
+    const char* gendir = argc > 1 ? argv[1] : ".";
+    int nseeds = 64;
+    if (getenv("SPUCHECK_SEEDS")) nseeds = atoi(getenv("SPUCHECK_SEEDS"));
+    if (argc > 2) nseeds = atoi(argv[2]);
+    if (getenv("SPUCHECK_EXAMPLES")) g_maxex = atoi(getenv("SPUCHECK_EXAMPLES"));
+    const char* only = getenv("SPUCHECK_ONLY");
+    const char* xf = getenv("SPUCHECK_XFAIL");
+    if (xf) snprintf(g_xfail, sizeof g_xfail, ",%s,", strcmp(xf, "none") ? xf : "");
+    if (getenv("SPUCHECK_TRACE")) sscanf(getenv("SPUCHECK_TRACE"), "%x,%d", &g_trace_addr, &g_trace_seed);
+    if (getenv("SPUCHECK_MXCSR")) g_mx_override = (int)strtoul(getenv("SPUCHECK_MXCSR"), 0, 0);
+    unsigned mx_spu; { spu_fp_env o = fp_in(); mx_spu = _mm_getcsr(); fp_out(o); }
+
+    static seedstate st;
+    static result rr, ri, rl;
+    static spu_ref_state rs;
+    long total_runs = 0, total_cases = 0;
+    int cur_img = -1;
+
+    spu_context_init(&g_ci, 0);
+    spu_context_init(&g_cl, 1);
+
+    printf("spucheck: %u cases in %u image(s), %d seeds/case, MXCSR 0x%04X, IB mask 0x%05X, build %s\n",
+           (unsigned)NCASES, (unsigned)NIMAGES, nseeds, mx_spu, SPCK_IB_MASK,
+#if defined(__SSE4_1__)
+           "SSE4.1 helpers"
+#else
+           "scalar *_ref helpers (no SSE4.1)"
+#endif
+    );
+    for (size_t ci = 0; ci < NCASES; ci++) {
+        const spck_case* cs = &spck_cases[ci];
+        if (only) { char k[64], o[1024]; snprintf(k, sizeof k, ",%s,", cs->mn); snprintf(o, sizeof o, ",%s,", only);
+                    if (!strstr(o, k) && !(cs->seq_hi && strstr(o, ",seq,"))) continue; }
+        if (cs->img != cur_img) {
+            cur_img = cs->img; g_img = &spck_images[cur_img];
+            char path[1024]; size_t n = 0;
+            snprintf(path, sizeof path, "%s/%s", gendir, g_img->blob);
+            char* blob = read_file(path, &n);
+            if (!blob || n != SPU_REF_LS_SIZE) { fprintf(stderr, "cannot read %s\n", path); return 2; }
+            g_rs = 0x1234567ull + (uint64_t)cur_img;
+            for (size_t i = 0; i < SPU_REF_LS_SIZE; i += 8) { uint64_t v = rnd(); memcpy(g_base_ls + i, &v, 8); }
+            for (size_t i = 0; i < g_img->ncode; i++)
+                if (g_img->code[i].is_code) memcpy(g_base_ls + g_img->code[i].addr, blob + g_img->code[i].addr, 4);
+            free(blob);
+            memcpy(g_ref_ls, g_base_ls, SPU_REF_LS_SIZE);
+            memcpy(g_ci.ls, g_base_ls, SPU_REF_LS_SIZE);
+            memcpy(g_cl.ls, g_base_ls, SPU_REF_LS_SIZE);
+        }
+        mnstat* ms = stat_of(cs->mn);
+        ms->cases++; total_cases++;
+        const char* refmn = spu_ref_mnemonic(cs->insn);
+        if (!cs->seq_hi && strcmp(refmn, cs->mn)) {
+            g_decode_mismatch++;
+            if (g_decode_mismatch <= 20)
+                printf("DECODE MISMATCH insn 0x%08X: decoder says '%s', ISA says '%s'\n", cs->insn, cs->mn, refmn);
+        }
+        int regs[4]; const char* f;
+        int nops = spu_ref_operand_regs(cs->insn, regs, &f);
+        const int seq = cs->seq_hi != 0;
+        if (seq) { ms->seq_words += (cs->seq_hi - cs->addr) / 4; }
+        const int is_fi = !strcmp(cs->mn, "fi");
+        const int shcls = shape_class(cs->mn);
+
+        for (int seed = 0; seed < nseeds; seed++) {
+            g_rs = 0x9E3779B97F4A7C15ull ^ ((uint64_t)ci << 20) ^ (uint64_t)seed * 0xD1B54A32D192ED03ull;
+            if (!g_rs) g_rs = 1;
+            for (int i = 0; i < 4; i++) rnd();
+            for (int r = 0; r < 128; r++) rand_reg(st.gpr[r], st.gpr, r);
+            if (!seq && nops >= 3 && rnd() % 4 == 0) relate(st.gpr[regs[2]], st.gpr[regs[1]]);
+            if (!seq && nops == 4 && rnd() % 4 == 0) relate(st.gpr[regs[3]], st.gpr[regs[(rnd() & 1) ? 1 : 2]]);
+            /* fi is used on an estimate of its own operand: on 3 seeds of 4
+             * rb = frest(ra) / frsqest(ra) lane-wise (the guest's pairs). */
+            if (!seq) shape(shcls, cs->mn, cs->insn, regs, nops, seed, &st);
+            if (is_fi && regs[1] != regs[2] && (seed & 3) != 3)
+                for (int i = 0; i < 4; i++) {
+                    uint32_t x = get32(st.gpr[regs[1]] + 4 * i);
+                    put32(st.gpr[regs[2]] + 4 * i, (seed & 1) ? spu_ref_frest(x) : spu_ref_frsqest(x));
+                }
+            st.srr0 = rnd32() & 0x3FFFCu;
+            st.int_enable = rnd32() & 1;
+            { static const uint32_t evs[] = { 0, 0, 1, 2, 0x10, 0xFFFFFFFF }; st.event_status = (rnd() & 1) ? PICK(evs) : rnd32(); }
+            { static const uint32_t evm[] = { 0, 0xFFFFFFFF, 1, 2 }; st.event_mask = (rnd() & 1) ? PICK(evm) : rnd32(); }
+            if (cs->ovr_reg >= 0 && (cs->ovr_mode == 1 || (cs->ovr_mode == 2 && !(seed & 1))))
+                put32(st.gpr[cs->ovr_reg], cs->ovr_val);
+            g_chsalt = rnd();
+
+            /* reference state; randomize the LS line a load/store touches */
+            memcpy(rs.gpr, st.gpr, sizeof rs.gpr);
+            rs.ls = g_ref_ls; rs.pc = cs->addr; rs.srr0 = st.srr0; rs.int_enable = st.int_enable;
+            rs.event_status = st.event_status; rs.event_mask = st.event_mask; rs.nwrites = 0;
+            uint32_t dirty[24]; int ndirty = 0;
+            if (seq) {                   /* fresh data window, identical in all three */
+                for (uint32_t i = 0; i < SEQ_WINSZ; i += 8) { uint64_t v = rnd(); memcpy(g_ref_ls + SEQ_WIN + i, &v, 8); }
+                if (rnd() % 4 == 0)      /* now and then float-ish data */
+                    for (uint32_t i = 0; i < SEQ_WINSZ; i += 4) put32(g_ref_ls + SEQ_WIN + i, rand_float());
+                memcpy(g_ci.ls + SEQ_WIN, g_ref_ls + SEQ_WIN, SEQ_WINSZ);
+                memcpy(g_cl.ls + SEQ_WIN, g_ref_ls + SEQ_WIN, SEQ_WINSZ);
+            } else
+            { uint32_t lsa; int is_st;
+              if (spu_ref_mem_line(&rs, cs->insn, &lsa, &is_st)) {
+                  uint8_t line[16]; for (int i = 0; i < 16; i++) line[i] = (uint8_t)rnd();
+                  memcpy(g_ref_ls + lsa, line, 16); memcpy(g_ci.ls + lsa, line, 16); memcpy(g_cl.ls + lsa, line, 16);
+                  if ((cs->addr & ~15u) == lsa) {          /* keep the instruction word */
+                      memcpy(g_ref_ls + cs->addr, g_base_ls + cs->addr, 4);
+                      memcpy(g_ci.ls + cs->addr, g_base_ls + cs->addr, 4);
+                      memcpy(g_cl.ls + cs->addr, g_base_ls + cs->addr, 4);
+                  }
+                  dirty[ndirty++] = lsa;
+              } }
+
+            /* (a) reference */
+            spu_ref_result res;
+            memset(&rr.log, 0, sizeof rr.log); g_curlog = &rr.log;
+            if (seq) {
+                g_trace = g_trace_addr == cs->addr && g_trace_seed == seed;
+                if (g_trace) printf("  trace: program @0x%05X seed %d\n", cs->addr, seed);
+                rr.o = seq_ref(&rs, cs->addr, cs->seq_hi, &ms->seq_steps);
+                g_trace = 0;
+            } else {
+            spu_ref_step(&rs, &g_refio, &res);
+            rr.o.code = 0; rr.o.pc = 0;
+            if (res.kind == SPU_REF_NEXT) { rr.o.kind = O_NEXT; rr.o.pc = res.next_pc; }
+            else if (res.kind == SPU_REF_STOP) { rr.o.kind = O_STOP; rr.o.code = res.stop_code; }
+            else if (res.kind == SPU_REF_HALT) rr.o.kind = O_HALT;
+            else { rr.o.kind = O_ILLEGAL; g_ref_illegal++; }
+            for (int i = 0; i < rs.nwrites; i++) dirty[ndirty++] = rs.writes[i];
+            }
+            memcpy(rr.gpr, rs.gpr, sizeof rr.gpr); rr.int_enable = rs.int_enable;
+
+            /* (b) interpreter, one step */
+            ctx_load(&g_ci, &st, cs->addr);
+            memset(&ri.log, 0, sizeof ri.log); g_curlog = &ri.log; g_ncurw = 0;
+            int stopped;
+            g_seq_mode = seq; g_wild = 0;
+            ri.o.code = 0; ri.o.pc = 0;
+            if (seq) {
+                spu_fp_env fo = fp_in();
+                ri.o = seq_interp(&g_ci, cs->addr, cs->seq_hi);
+                fp_out(fo);
+            } else {
+            { spu_fp_env fo = fp_in();
+              stopped = spu_interp_step1(&g_ci);
+              fp_out(fo); }
+            if (!stopped) { ri.o.kind = O_NEXT; ri.o.pc = g_ci.pc; }
+            else if (g_ci.status & SPU_STATUS_STOPPED_BY_STOP) { ri.o.kind = O_STOP; ri.o.code = g_ci.stop_code; }
+            else ri.o.kind = (g_ci.stop_code == 0xDEADBEEFu) ? O_TRAP : O_HALT;
+            }
+            ctx_save(&g_ci, &ri);
+            long interp_wild = g_wild; g_wild = 0;
+            for (int i = 0; i < g_ncurw && ndirty < 24; i++) dirty[ndirty++] = g_curw[i];
+            int interp_wrote = g_ncurw;
+
+            /* (c) lifted function */
+            ctx_load(&g_cl, &st, cs->addr);
+            memset(&rl.log, 0, sizeof rl.log); g_curlog = &rl.log; g_ncurw = 0;
+            g_spu_trampoline_fn = 0; g_ev = EV_NONE;
+            volatile int returned = 0;
+            { spu_fp_env fo = fp_in();
+              g_seq_lo = cs->addr; g_seq_hi = cs->seq_hi;
+              if (!setjmp(g_jb)) { cs->fn(&g_cl); seq_drain(&g_cl); returned = 1; }
+              fp_out(fo); }
+            g_curlog = 0;
+            ctx_save(&g_cl, &rl);
+            rl.o = lifted_outcome(cs, g_ev, returned);
+            g_spu_trampoline_fn = 0;
+            for (int i = 0; i < g_ncurw && ndirty < 24; i++) dirty[ndirty++] = g_curw[i];
+            int lifted_wrote = g_ncurw;
+            long lifted_wild = g_wild; g_seq_mode = 0;
+
+            /* compare */
+            int full = (seed == 0);      /* catches LS writes that bypass the hook */
+            (void)interp_wrote; (void)lifted_wrote;
+            result* got[EX_N] = { &ri, &rl };
+            uint8_t* gls[EX_N] = { g_ci.ls, g_cl.ls };
+            for (int ex = 0; ex < EX_N; ex++) {
+                int asp = 0, fullls = 0;
+                if (!outc_eq(&rr.o, &got[ex]->o)) asp |= D_OUTCOME;
+                for (int r = 0; r < 128; r++)
+                    if (memcmp(rr.gpr[r], got[ex]->gpr[r], 16)) asp |= (r == regs[0]) ? D_DEST : D_OTHERREG;
+                if (rr.int_enable != got[ex]->int_enable) asp |= D_INTEN;
+                if (!chlog_eq(&rr.log, &got[ex]->log)) asp |= D_CHAN;
+                for (int i = 0; i < ndirty; i++) if (memcmp(g_ref_ls + dirty[i], gls[ex] + dirty[i], 16)) asp |= D_LS;
+                if (seq && (memcmp(g_ref_ls + SEQ_WIN, gls[ex] + SEQ_WIN, SEQ_WINSZ) || (ex ? lifted_wild : interp_wild)))
+                    asp |= D_LS;
+                if (full && !(asp & D_LS) && memcmp(g_ref_ls, gls[ex], SPU_REF_LS_SIZE)) { asp |= D_LS; fullls = 1; }
+                if (!asp) continue;
+                ms->mism[ex]++;
+                ms->aspects[ex] |= asp;
+                if (is_xfail(cs->mn)) float_classes(ms, ex, cs, &st, &rr, got[ex], got[ex]->o.kind == O_TRAP);
+                if (ms->examples[ex] < g_maxex) {
+                    ms->examples[ex]++;
+                    report_example(ex, cs, seed, &st, &rr, got[ex], asp, fullls);
+                }
+                if (fullls) {    /* resync the whole LS so one stray write is reported once */
+                    memcpy(gls[ex], g_base_ls, SPU_REF_LS_SIZE);
+                }
+            }
+            /* restore every touched line in all three local stores */
+            for (int i = 0; i < ndirty; i++) {
+                memcpy(g_ref_ls + dirty[i], g_base_ls + dirty[i], 16);
+                memcpy(g_ci.ls + dirty[i], g_base_ls + dirty[i], 16);
+                memcpy(g_cl.ls + dirty[i], g_base_ls + dirty[i], 16);
+            }
+            /* interpreter vs lifted: they share spu_helpers.h, so any
+             * disagreement is a dispatch/decode/context bug even for an
+             * XFAIL (float) mnemonic. */
+            {
+                int asp = 0;
+                if (!outc_eq(&ri.o, &rl.o)) asp |= D_OUTCOME;
+                if (memcmp(ri.gpr, rl.gpr, sizeof ri.gpr)) asp |= D_DEST;
+                if (ri.int_enable != rl.int_enable) asp |= D_INTEN;
+                if (!chlog_eq(&ri.log, &rl.log)) asp |= D_CHAN;
+                if (seq && memcmp(g_ci.ls + SEQ_WIN, g_cl.ls + SEQ_WIN, SEQ_WINSZ)) asp |= D_LS;
+                if (asp) {
+                    ms->il_mism++;
+                    if (ms->il_examples < g_maxex) {
+                        ms->il_examples++;
+                        printf("  [interp!=lifted] (expect = interp)\n");
+                        report_example(EX_LIFTED, cs, seed, &st, &ri, &rl, asp, 0);
+                    }
+                }
+            }
+            ms->runs++; total_runs++;
+        }
+    }
+
+    /* ---- summary ---- */
+    int fail = 0, xfail_hit = 0, xpass = 0;
+    printf("\n==== spucheck summary: %ld cases, %ld runs (x3 executors) ====\n", total_cases, total_runs);
+    printf("%-10s %6s %8s | %10s %10s %8s | %s\n", "mnemonic", "cases", "runs", "interp", "lifted", "i!=l", "status");
+    for (int i = 0; i < g_nst; i++) {
+        mnstat* m = &g_st[i];
+        int bad = m->mism[0] || m->mism[1];
+        int xf = is_xfail(m->mn);
+        /* interp != lifted is fatal for integer/control ops. For an XFAIL
+         * (float) op it is reported only: host NaN-payload propagation
+         * depends on operand order, which the compiler may commute. */
+        const char* status = (m->il_mism && !xf) ? "FAIL (interp != lifted)" :
+                             !bad ? (xf ? "XPASS" : "ok") : (xf ? "XFAIL (expected float deviation)" : "FAIL");
+        if ((bad && !xf) || (m->il_mism && !xf)) fail++;
+        if (bad && xf) xfail_hit++;
+        if (!bad && xf) xpass++;
+        printf("%-10s %6ld %8ld | %10ld %10ld %8ld | %s", m->mn, m->cases, m->runs, m->mism[0], m->mism[1], m->il_mism, status);
+        if (bad) {
+            printf("  [");
+            for (int ex = 0; ex < EX_N; ex++) if (m->aspects[ex])
+                printf("%s:%s%s%s%s%s%s ", ex_name[ex], (m->aspects[ex] & D_OUTCOME) ? "outcome," : "",
+                       (m->aspects[ex] & D_DEST) ? "dest," : "", (m->aspects[ex] & D_OTHERREG) ? "otherreg," : "",
+                       (m->aspects[ex] & D_LS) ? "LS," : "", (m->aspects[ex] & D_CHAN) ? "chan," : "",
+                       (m->aspects[ex] & D_INTEN) ? "int_enable," : "");
+            printf("]");
+        }
+        printf("\n");
+    }
+    /* float classes */
+    int anycls = 0;
+    for (int i = 0; i < g_nst; i++) {
+        mnstat* m = &g_st[i];
+        for (int ex = 0; ex < EX_N; ex++) {
+            long t = 0; for (int k = 0; k < MAXCLS; k++) t += m->cls_n[ex][k];
+            if (!t) continue;
+            if (!anycls) { printf("\n==== expected-failing (float) mismatch classes: per lane, class, count, first example ====\n"); anycls = 1; }
+            printf("%-8s [%s] %ld lane mismatches\n", m->mn, ex_name[ex], t);
+            for (int k = 0; k < MAXCLS && k < (int)(sizeof cls_name / sizeof cls_name[0]); k++)
+                if (m->cls_n[ex][k]) printf("    %-26s %7ld   e.g. %s\n", cls_name[k], m->cls_n[ex][k], m->cls_ex[ex][k]);
+        }
+    }
+    { long sw = 0, ss = 0, sc = 0, sr = 0;
+      for (int i = 0; i < g_nst; i++) if (!strncmp(g_st[i].mn, "seq.", 4)) {
+          sw += g_st[i].seq_words; ss += g_st[i].seq_steps; sc += g_st[i].cases; sr += g_st[i].runs; }
+      if (sc) printf("\nsequence mode: %ld programs, %ld code words, %ld runs, %ld reference steps (%.1f per run)\n",
+                     sc, sw, sr, ss, sr ? (double)ss / sr : 0.0); }
+    if (g_decode_mismatch) { printf("\nDECODER MISMATCHES: %ld cases\n", g_decode_mismatch); fail++; }
+    if (g_ref_illegal) { printf("\nREFERENCE saw %ld ILLEGAL encodings (generator bug)\n", g_ref_illegal); fail++; }
+    printf("\nresult: %d mnemonic(s) FAIL, %d XFAIL, %d XPASS (xfail list: %s)\n", fail, xfail_hit, xpass, g_xfail);
+    return fail ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_channels.c b/runtime/spu/tests/test_spu_channels.c
new file mode 100644
index 00000000..4dd83fc2
--- /dev/null
+++ b/runtime/spu/tests/test_spu_channels.c
@@ -0,0 +1,1631 @@
+/*
+ * SPU channel, MFC, atomic and event semantics, asserted against the Cell
+ * Broadband Engine Architecture (CBEA) and the SPU ISA, with RPCS3 as the
+ * tie-breaker where the book is silent.
+ *
+ * Unit under test: runtime/spu/spu_channels.c (spu_rdch / spu_wrch / spu_rchcnt,
+ * spu_mfc_atomic, the channel-stall wait), runtime/spu/spu_dma.h (mfc_submit,
+ * mfc_do_transfer, list DMA, tag status, stall-and-notify),
+ * runtime/spu/spu_coherency.c (lock-line reservations and their loss) and the
+ * channel queues in runtime/spu/spu_context.h.
+ *
+ * What the title in front of this (THP8) runs through these paths, so a
+ * regression here is a regression in a shipped game:
+ *   - FMOD's mixer: blocking rdch SNR1 for the block number, GET/PUT with
+ *     WrTagMask + WrTagUpdate(all) + RdTagStat, and sys_spu_thread_send_event
+ *     (rchcnt RdInMbox == 0, wrch OutMbox, wrch OutIntrMbox, rdch RdInMbox);
+ *   - FMOD's MPEG decoder: rchcnt/rdch RdInMbox, the same event sequence;
+ *   - Havok: GETLLAR/PUTLLC + RdAtomicStat retry loops, RdDec, 16 KB GETs;
+ *   - the SPURS job policy module: a GETLLAR/PUTLLC lock-line spin.
+ *
+ * The SPU side is driven exactly as lifted code drives it -- through spu_wrch,
+ * spu_rdch and spu_rchcnt -- and the PPU side the way the runtime's PPU/lv2
+ * paths drive it (spu_channel_write + spu_ch_wake for a mailbox,
+ * spu_snr_write + spu_ch_wake for a signal register, the VM_WRITE_COH /
+ * ppu_stwcx sequence for a store into a reserved line).
+ *
+ * Section 6 covers every MFC command form (GET/PUT with barrier and fence,
+ * PUTR, every list form, sdcrz and the cache hints), issue order, EAH, the
+ * list element format, zero-size elements, list address alignment, repeated
+ * stalls, PUTLLUC / PUTQLLUC / failing-PUTLLC reservation and status rules,
+ * S1/S2 edges and their blocking wake-up, and event_status atomicity.
+ *
+ * Architected behaviour the runtime deliberately does NOT model (DMA is
+ * synchronous, so no tag is ever in flight; channel counts that only matter
+ * to a program that would stall forever on hardware) is printed as a "note:"
+ * line, not counted as a failure, so this stays a regression test.
+ *
+ * spu_channels.c is compiled in rather than linked (spu_mfc_atomic, mfc_for
+ * and spu_host_ns are file-static), like test_spu_mfc_slots.c.
+ *
+ * Build (Windows, clang-cl, from the ps3recomp root; one compile at a time):
+ *   clang-cl -nologo -MD -O2 -msse4.1 -fno-strict-aliasing /clang:-ffp-contract=off
+ *       -D_CRT_SECURE_NO_WARNINGS -I include -I runtime/spu -I runtime/platform -I runtime
+ *       runtime/spu/tests/test_spu_channels.c runtime/spu/spu_drain.c
+ *       runtime/spu/spu_lockstep.c runtime/spu/spu_coherency.c runtime/spu/spu_workload.c
+ *       runtime/spu/spurs_policy.c runtime/spu/spurs_job.c runtime/spu/spu_tsp_weak.c
+ *       runtime/spu/spu_vm_pagemap.c runtime/spu/spurs_policy_blob_weak.c
+ *       runtime/spu/spu_interp.c runtime/spu/spu_capture.c
+ *       -Fe:test_spu_channels.exe /link user32.lib advapi32.lib
+ *
+ * Exit code: 0 if all passed, 1 if any failed. The last line is a summary.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <malloc.h>
+
+/* Guest memory: a committed arena, so the MFC's EA guard (VirtualQuery) accepts
+ * every address the test uses. Assigned in main before anything runs. */
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+#define GUEST_SIZE  0x01000000u        /* 16 MB */
+
+/* The unit under test (found through -I runtime/spu). */
+#include "spu_channels.c"
+
+/* ---------------------------------------------------------------------------
+ * Harness
+ * -----------------------------------------------------------------------*/
+static int g_pass, g_fail, g_notes;
+static const char* g_test = "(none)";
+
+#define TEST(name) (g_test = (name))
+#define CHECK(cond) do {                                                     \
+    if (cond) g_pass++;                                                      \
+    else { g_fail++;                                                         \
+           printf("  FAIL [%s] %s:%d: %s\n", g_test, __FILE__, __LINE__, #cond); \
+           fflush(stdout); }                                                 \
+} while (0)
+#define CHECK_EQ(a, b) do {                                                  \
+    uint64_t _a = (uint64_t)(a), _b = (uint64_t)(b);                         \
+    if (_a == _b) g_pass++;                                                  \
+    else { g_fail++;                                                         \
+           printf("  FAIL [%s] %s:%d: %s == %s (0x%llX != 0x%llX)\n", g_test,  \
+                  __FILE__, __LINE__, #a, #b, (unsigned long long)_a,          \
+                  (unsigned long long)_b); fflush(stdout); }                  \
+} while (0)
+/* Architected, deliberately not modelled: say so, do not fail. */
+#define NOTE(cond, text) do {                                                \
+    if (!(cond)) { g_notes++; printf("  note [%s]: %s\n", g_test, text); }     \
+} while (0)
+
+static uint64_t qpc_ns(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+}
+
+/* SPU-side channel access, as lifted code performs it. */
+static void     wr(spu_context* c, uint32_t ch, uint32_t v) { spu_wrch(c, ch, spu_make_preferred_u32(v)); }
+static uint32_t rd(spu_context* c, uint32_t ch)             { return spu_rdch(c, ch)._u32[0]; }
+static uint32_t cnt(spu_context* c, uint32_t ch)            { return spu_rchcnt(c, ch); }
+
+static void mfc(spu_context* c, uint32_t cmd, uint32_t lsa, uint32_t ea, uint32_t size, uint32_t tag)
+{
+    wr(c, MFC_LSA, lsa); wr(c, MFC_EAH, 0); wr(c, MFC_EAL, ea);
+    wr(c, MFC_Size, size); wr(c, MFC_TagID, tag); wr(c, MFC_Cmd, cmd);
+}
+/* WrTagMask + WrTagUpdate + RdTagStat, the sequence every THP8 image uses. */
+static uint32_t tag_wait(spu_context* c, uint32_t mask, uint32_t mode)
+{
+    wr(c, MFC_WrTagMask, mask); wr(c, MFC_WrTagUpdate, mode);
+    return rd(c, MFC_RdTagStat);
+}
+
+static spu_context* new_ctx(uint32_t id)
+{
+    spu_context* c = (spu_context*)_aligned_malloc(sizeof(spu_context), 128);
+    spu_context_init(c, id);
+    c->status = SPU_STATUS_RUNNING;
+    return c;
+}
+static void free_ctx(spu_context* c)
+{
+    extern void spu_coh_unregister(spu_context*);
+    spu_coh_unregister(c);
+    spu_mfc_release(c);
+    _aligned_free(c);
+}
+
+static void fill(uint8_t* p, uint32_t n, uint8_t seed)
+{
+    for (uint32_t i = 0; i < n; i++) p[i] = (uint8_t)(seed + i * 7u + (i >> 8));
+}
+static uint32_t be32(const uint8_t* p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static void put_be32(uint8_t* p, uint32_t v)
+{
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+/* The PPU's store into a line an SPU may have reserved: VM_WRITE_COH
+ * (runtime/ppu/ppu_memory.h) -- the copy and the notify under the lock-line
+ * lock when the line is marked. */
+static void ppu_store32(uint32_t ea, uint32_t v)
+{
+    uint8_t b[4]; put_be32(b, v);
+    if (spu_coh_is_reserved(ea)) {
+        spu_lockline_lock();
+        memcpy(vm_base + ea, b, 4);
+        spu_coh_notify_write(ea);
+        spu_lockline_unlock();
+    } else {
+        memcpy(vm_base + ea, b, 4);
+    }
+}
+
+/* ===========================================================================
+ * Blocking reads: a reader thread parked in rdch, a producer on this thread.
+ * ===========================================================================*/
+typedef struct {
+    spu_context* ctx;
+    uint32_t     ch;
+    int          n;            /* reads to perform */
+    uint32_t*    got;          /* values read */
+    uint64_t*    t_ret;        /* qpc at return */
+    volatile LONG done;        /* reads completed */
+} reader_arg;
+
+static DWORD WINAPI reader_thread(LPVOID p)
+{
+    reader_arg* a = (reader_arg*)p;
+    for (int i = 0; i < a->n; i++) {
+        a->got[i] = rd(a->ctx, a->ch);
+        a->t_ret[i] = qpc_ns();
+        InterlockedIncrement(&a->done);
+    }
+    return 0;
+}
+
+static void spin_us(unsigned us)
+{
+    uint64_t end = qpc_ns() + (uint64_t)us * 1000u;
+    while (qpc_ns() < end) YieldProcessor();
+}
+
+/* Is host thread `tid` in a kernel wait right now (ThreadState Waiting), as
+ * opposed to running or runnable-but-not-scheduled? 1 / 0, -1 unknown.
+ *
+ * This is what makes the lost-wakeup check independent of machine load: a
+ * reader whose wake was lost is still ASLEEP on its condition variable a while
+ * after the producer wrote and woke it, whereas a reader that was woken but has
+ * not been scheduled yet is Ready. Timing alone cannot tell those apart on a
+ * busy machine (the shared test box runs at 100% CPU), the thread state can.
+ * NtQuerySystemInformation(SystemProcessInformation), x64 layouts. */
+typedef LONG (NTAPI *pfn_ntqsi)(ULONG, PVOID, ULONG, PULONG);
+static int thread_is_waiting(DWORD tid)
+{
+    static pfn_ntqsi q; static uint8_t* buf; static ULONG cap = 1u << 22;
+    if (!q) q = (pfn_ntqsi)(void*)GetProcAddress(GetModuleHandleA("ntdll.dll"), "NtQuerySystemInformation");
+    if (!q) return -1;
+    for (int tries = 0; ; tries++) {
+        if (!buf) buf = (uint8_t*)malloc(cap);
+        ULONG need = 0;
+        LONG st = q(5 /* SystemProcessInformation */, buf, cap, &need);
+        if (st >= 0) break;
+        free(buf); buf = NULL; cap = (need > cap ? need : cap) * 2;
+        if (tries == 2) return -1;
+    }
+    const DWORD pid = GetCurrentProcessId();
+    for (uint8_t* p = buf; ; ) {
+        ULONG next = *(ULONG*)p, nth = *(ULONG*)(p + 4);
+        if ((DWORD)*(uintptr_t*)(p + 0x50) == pid) {               /* UniqueProcessId */
+            const uint8_t* t = p + 0x100;                            /* SYSTEM_THREAD_INFORMATION[] */
+            for (ULONG i = 0; i < nth; i++, t += 0x50)
+                if ((DWORD)*(const uintptr_t*)(t + 0x30) == tid)     /* ClientId.UniqueThread */
+                    return *(const ULONG*)(t + 0x44) == 5;           /* ThreadState == Waiting */
+            return -1;
+        }
+        if (!next) return -1;
+        p += next;
+    }
+}
+
+/* After a producer's wake: wait for `*done` to reach `want`. If it has not
+ * within 2 ms and the reader is asleep in the kernel, the wake was lost
+ * (returns 1); then keep waiting (the re-poll completes it), up to 5 s. */
+static int await_or_lost(volatile LONG* done, LONG want, DWORD reader_tid)
+{
+    int lost = 0;
+    uint64_t t0 = qpc_ns();
+    while (*done < want) {
+        uint64_t dt = qpc_ns() - t0;
+        if (!lost && dt > 2000000u && thread_is_waiting(reader_tid) == 1 && *done < want)
+            lost = 1;
+        if (dt > 5000000000ull) return 2;              /* never completed */
+        YieldProcessor();
+    }
+    return lost;
+}
+
+/* Wait until a reader has parked in its channel wait (status set, and asleep). */
+static int await_parked(spu_context* c, DWORD tid)
+{
+    uint64_t t0 = qpc_ns();
+    while (qpc_ns() - t0 < 5000000000ull) {
+        if (c->status == SPU_STATUS_WAITING_CHANNEL && thread_is_waiting(tid) == 1) return 1;
+        Sleep(1);
+    }
+    return 0;
+}
+
+/* Producer side for each blocking channel. */
+static void produce(spu_context* c, uint32_t ch, uint32_t v)
+{
+    if (ch == SPU_RdInMbox) spu_channel_write(&c->ch_in_mbox, v);
+    else spu_snr_write(&c->ch_sig_notify[ch == SPU_RdSigNotify2], v, 0);
+    spu_ch_wake(c);
+}
+
+/* A read parks while the channel is empty, returns exactly the produced value
+ * when the producer writes, and is woken by the producer -- not by the 10 ms
+ * re-poll that backs the wait up. The producer is released at random points
+ * relative to the reader's way into the wait, which is how a wake that lands
+ * between the reader's empty-check and its sleep is found: it is lost, and the
+ * reader is still asleep long after the write (await_or_lost). */
+static void blocking_read_case(uint32_t ch, const char* name)
+{
+    TEST(name);
+    spu_context* c = new_ctx(0x100 + ch);
+    c->ch_block = 1;
+    enum { N = 1500 };
+    static uint32_t got[N]; static uint64_t t_ret[N], t_wr[N];
+    reader_arg a = { c, ch, N, got, t_ret, 0 };
+
+    HANDLE h = CreateThread(NULL, 0, reader_thread, &a, 0, NULL);
+    DWORD tid = GetThreadId(h);
+    /* First read: the reader parks (asleep, not spinning) and stays parked. */
+    CHECK(await_parked(c, tid));
+    Sleep(30);
+    CHECK_EQ(a.done, 0);
+    CHECK_EQ(c->status, SPU_STATUS_WAITING_CHANNEL);
+
+    srand(12345);
+    uint64_t worst = 0, sum = 0; int lost = 0, hung = 0;
+    for (int i = 0; i < N; i++) {
+        /* Release the write 0..~6 us after the previous read returned: the
+         * reader's whole way back into the wait, at pause granularity. */
+        for (int k = i ? rand() % 200 : 0; k; k--) YieldProcessor();
+        t_wr[i] = qpc_ns();
+        produce(c, ch, 0xC0DE0000u + (uint32_t)i);
+        int r = await_or_lost(&a.done, i + 1, tid);
+        if (r == 1) lost++;
+        if (r == 2) { hung = 1; break; }
+    }
+    CHECK(!hung);
+    DWORD w = WaitForSingleObject(h, 20000);
+    CHECK_EQ(w, WAIT_OBJECT_0);
+    CloseHandle(h);
+    int order_ok = 1;
+    for (int i = 0; i < N && !hung; i++) {
+        if (got[i] != 0xC0DE0000u + (uint32_t)i) order_ok = 0;
+        uint64_t lat = t_ret[i] > t_wr[i] ? t_ret[i] - t_wr[i] : 0;
+        sum += lat; if (lat > worst) worst = lat;
+    }
+    CHECK(order_ok);
+    printf("  [%s] %d handoffs: mean %.1f us, worst %.2f ms, lost wakes (asleep 2 ms after the write): %d\n",
+           name, N, (double)sum / N / 1000.0, (double)worst / 1e6, lost);
+    CHECK_EQ(lost, 0);
+    free_ctx(c);
+}
+
+/* ===========================================================================
+ * 1. Mailboxes
+ * ===========================================================================*/
+static void test_mailboxes(void)
+{
+    TEST("mbox.counts");
+    spu_context* c = new_ctx(1);
+
+    /* Inbound: the PPU's writes (sys_spu_thread_write_spu_mb / MMIO) queue in
+     * order; rchcnt is the number of readable words. */
+    CHECK_EQ(cnt(c, SPU_RdInMbox), 0);
+    for (uint32_t i = 0; i < SPU_IN_MBOX_HW_DEPTH; i++)
+        spu_channel_write(&c->ch_in_mbox, 0x1000u + i);
+    CHECK_EQ(cnt(c, SPU_RdInMbox), 4);
+    for (uint32_t i = 0; i < 4; i++) {
+        CHECK_EQ(rd(c, SPU_RdInMbox), 0x1000u + i);      /* FIFO */
+        CHECK_EQ(cnt(c, SPU_RdInMbox), 3 - i);
+    }
+    /* Interleaved producer/consumer keeps FIFO order across the ring wrap,
+     * never holding more than the hardware depth (the PPU polls free slots). */
+    { int ok = 1; uint32_t next_w = 0, next_r = 0;
+      spu_channel_write(&c->ch_in_mbox, next_w++);
+      for (int round = 0; round < 200; round++) {
+          for (int k = 0; k < 3; k++) spu_channel_write(&c->ch_in_mbox, next_w++);
+          if (cnt(c, SPU_RdInMbox) != 4) ok = 0;
+          for (int k = 0; k < 3; k++) if (rd(c, SPU_RdInMbox) != next_r++) ok = 0;
+      }
+      while (cnt(c, SPU_RdInMbox)) if (rd(c, SPU_RdInMbox) != next_r++) ok = 0;
+      CHECK(ok); CHECK_EQ(next_r, next_w); }
+
+    /* Outbound: one entry deep. Free-slot count 1 when empty, 0 when full. */
+    TEST("mbox.out");
+    CHECK_EQ(cnt(c, SPU_WrOutMbox), 1);
+    wr(c, SPU_WrOutMbox, 0xAABBCCDDu);
+    CHECK_EQ(cnt(c, SPU_WrOutMbox), 0);
+    CHECK_EQ(c->ch_out_mbox.count, 1);
+    CHECK_EQ(spu_channel_read(&c->ch_out_mbox), 0xAABBCCDDu);   /* PPU drains */
+    CHECK_EQ(cnt(c, SPU_WrOutMbox), 1);
+
+    /* Outbound interrupt mailbox, no lv2 user-event hook installed: the word
+     * stays in the channel for the PPU. */
+    TEST("mbox.outintr");
+    CHECK_EQ(cnt(c, SPU_WrOutIntrMbox), 1);
+    wr(c, SPU_WrOutIntrMbox, 0x11223344u);
+    CHECK_EQ(cnt(c, SPU_WrOutIntrMbox), 0);
+    CHECK_EQ(spu_channel_read(&c->ch_out_intr_mbox), 0x11223344u);
+    CHECK_EQ(cnt(c, SPU_WrOutIntrMbox), 1);
+
+    /* A synchronous (non-thread) context keeps the legacy non-blocking read:
+     * an empty inbound read returns at once instead of parking the caller. */
+    TEST("mbox.nonblocking-context");
+    CHECK_EQ(c->ch_block, 0);
+    CHECK_EQ(rd(c, SPU_RdInMbox), 0u + c->ch_in_mbox.value);   /* returns, no park */
+
+    /* sys_spu_thread_receive_event's four-word reply drains ahead of the
+     * mailbox and is counted by rchcnt. */
+    TEST("mbox.receive-event-reply");
+    spu_channel_write(&c->ch_in_mbox, 0x77u);
+    c->rcv_evt[0] = 0; c->rcv_evt[1] = 11; c->rcv_evt[2] = 22; c->rcv_evt[3] = 33;
+    c->rcv_evt_n = 4; c->rcv_evt_i = 0;
+    CHECK_EQ(cnt(c, SPU_RdInMbox), 5);
+    CHECK_EQ(rd(c, SPU_RdInMbox), 0); CHECK_EQ(rd(c, SPU_RdInMbox), 11);
+    CHECK_EQ(rd(c, SPU_RdInMbox), 22); CHECK_EQ(rd(c, SPU_RdInMbox), 33);
+    CHECK_EQ(rd(c, SPU_RdInMbox), 0x77u);
+    CHECK_EQ(cnt(c, SPU_RdInMbox), 0);
+    free_ctx(c);
+
+    blocking_read_case(SPU_RdInMbox, "mbox.blocking-read");
+}
