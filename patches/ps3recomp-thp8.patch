+    struct timespec ts;                 /* POSIX / WebAssembly: it returned 0, so no frame ever looked slow */
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (long long)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+#endif
+}
+
+void frame_trace_init(void)
+{
+    if (g_ft_on >= 0) return;
+    const char* e = getenv("PS3_SPIKE_MS");
+    if (e && *e && atof(e) > 0.0) {
+        s_thr_ms = atof(e);
+#ifdef FT_TSC_CLOCK
+        ft_clock_init();
+#endif
+        g_ft_on = 1;
+        fprintf(stderr, "[spike] frame spike attribution on: frames >= %.1f ms are itemised\n", s_thr_ms);
+    } else {
+        g_ft_on = 0;
+    }
+}
+
+void frame_trace_add(int id, long long v)
+{
+#ifdef _WIN32
+    InterlockedExchangeAdd64((volatile LONG64*)&s_ctr[id], (LONG64)v);
+#else
+    __atomic_add_fetch(&s_ctr[id], v, __ATOMIC_RELAXED);
+#endif
+}
+
+void frame_trace_max(int id, long long v)
+{
+    long long cur = s_ctr[id];
+    while (v > cur) {
+#ifdef _WIN32
+        const long long seen = InterlockedCompareExchange64((volatile LONG64*)&s_ctr[id], (LONG64)v, (LONG64)cur);
+#else
+        long long seen = cur;
+        __atomic_compare_exchange_n(&s_ctr[id], &seen, v, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+#endif
+        if (seen == cur) break;
+        cur = seen;
+    }
+}
+
+/* ---- per guest thread attribution (see frame_trace.h) ---- */
+#define FT_SLOTS 32
+typedef struct { volatile unsigned long long key; volatile long long us; } ft_slot;
+static ft_slot s_tslot[FT_TID_MAX][FT_SLOTS];
+#ifdef _WIN32
+static HANDLE volatile s_thandle[FT_TID_MAX];
+#endif
+static unsigned long long s_tcyc_prev[FT_TID_MAX];
+void frame_trace_call(unsigned tid, unsigned long long key, long long us)
+{
+    if (tid == 0 || tid >= FT_TID_MAX) return;
+#ifdef _WIN32
+    if (!s_thandle[tid]) {           /* first timed call from this guest thread: remember its host thread */
+        HANDLE h = 0;
+        if (DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h, 0, FALSE,
+                            DUPLICATE_SAME_ACCESS)) {
+            if (InterlockedCompareExchangePointer((PVOID volatile*)&s_thandle[tid], h, 0) != 0) CloseHandle(h);
+        }
+    }
+#endif
+    unsigned i = (unsigned)((key * 0x9E3779B97F4A7C15ull) >> 59) & (FT_SLOTS - 1);
+    for (unsigned n = 0; n < FT_SLOTS; n++, i = (i + 1) & (FT_SLOTS - 1)) {
+        unsigned long long k = s_tslot[tid][i].key;
+        if (k == 0) {
+#ifdef _WIN32
+            k = (unsigned long long)InterlockedCompareExchange64((volatile LONG64*)&s_tslot[tid][i].key, (LONG64)key, 0);
+#else
+            unsigned long long z = 0;
+            __atomic_compare_exchange_n(&s_tslot[tid][i].key, &z, key, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED); k = z;
+#endif
+            if (k == 0) k = key;
+        }
+        if (k != key) continue;
+#ifdef _WIN32
+        InterlockedExchangeAdd64((volatile LONG64*)&s_tslot[tid][i].us, (LONG64)us);
+#else
+        __atomic_add_fetch(&s_tslot[tid][i].us, us, __ATOMIC_RELAXED);
+#endif
+        return;
+    }
+}
+extern const char* ps3_hle_name(unsigned nid);   /* runtime/ppu/ppu_hle.cpp */
+static const char* ft_key_name(unsigned long long key, char* buf, int n)
+{
+    if (!(key & FT_KEY_SC)) return ps3_hle_name((unsigned)key);
+    switch ((unsigned)key) {
+    case 43: return "sc_yield";       case 44: return "sc_thread_join";  case 85: return "sc_evflag_wait";
+    case 92: return "sc_sema_wait";   case 97: return "sc_lwmutex_lock"; case 102: return "sc_mutex_lock";
+    case 107: return "sc_cond_wait";  case 113: return "sc_lwcond_wait"; case 130: return "sc_evq_receive";
+    case 141: return "sc_usleep";     case 142: return "sc_sleep";       case 138: return "sc_port_send";
+    }
+    snprintf(buf, n, "sc%u", (unsigned)key);
+    return buf;
+}
+/* Per frame: take every thread's slot times (always, so a spike line covers exactly one frame) and CPU cycles;
+ * on a spike, print the threads that ran or waited at least 0.5 ms. */
+static void ft_threads(int spike, unsigned long long frame_no)
+{
+    static double s_cyc_per_us = 0.0;
+    static unsigned long long s_cal_tsc = 0;
+    static long long s_cal_us = 0;
+#ifdef _WIN32
+    {   /* QueryThreadCycleTime counts TSC ticks: calibrate ticks/us against QPC over the run */
+        const unsigned long long tsc = __rdtsc();
+        const long long now = frame_trace_now_us();
+        if (!s_cal_tsc) { s_cal_tsc = tsc; s_cal_us = now; }
+        else if (now - s_cal_us > 500000) s_cyc_per_us = (double)(tsc - s_cal_tsc) / (double)(now - s_cal_us);
+    }
+#endif
+    char line[1400]; int n = 0;
+    if (spike) n = snprintf(line, sizeof line, "[spike-thr] frame %llu:", frame_no);
+    for (unsigned tid = 1; tid < FT_TID_MAX; tid++) {
+        double cpu_ms = -1.0;
+#ifdef _WIN32
+        if (s_thandle[tid]) {
+            ULONG64 cyc = 0;
+            if (QueryThreadCycleTime(s_thandle[tid], &cyc)) {
+                if (s_tcyc_prev[tid] && s_cyc_per_us > 0.0) cpu_ms = (double)(cyc - s_tcyc_prev[tid]) / s_cyc_per_us / 1000.0;
+                s_tcyc_prev[tid] = cyc;
+            }
+        }
+#endif
+        unsigned long long tk[3] = {0, 0, 0}; long long tu[3] = {0, 0, 0}; long long tot = 0;
+        for (unsigned i = 0; i < FT_SLOTS; i++) {
+            if (!s_tslot[tid][i].key) continue;
+#ifdef _WIN32
+            const long long us = (long long)InterlockedExchange64((volatile LONG64*)&s_tslot[tid][i].us, 0);
+#else
+            const long long us = __atomic_exchange_n(&s_tslot[tid][i].us, 0, __ATOMIC_RELAXED);
+#endif
+            tot += us;
+            for (int j = 0; j < 3; j++)
+                if (us > tu[j]) {
+                    for (int m = 2; m > j; m--) { tu[m] = tu[m - 1]; tk[m] = tk[m - 1]; }
+                    tu[j] = us; tk[j] = s_tslot[tid][i].key; break;
+                }
+        }
+        if (!spike || (cpu_ms < 0.5 && tot < 500) || n > (int)sizeof line - 200) continue;
+        n += snprintf(line + n, sizeof line - n, " | t%u cpu=%.1f calls=%.1f", tid, cpu_ms, (double)tot / 1000.0);
+        for (int j = 0; j < 3 && tu[j] >= 300; j++) {
+            char b[24];
+            n += snprintf(line + n, sizeof line - n, " %s=%.1f", ft_key_name(tk[j], b, sizeof b), (double)tu[j] / 1000.0);
+        }
+    }
+    if (spike) fprintf(stderr, "%s\n", line);
+}
+
+void frame_trace_frame(void)
+{
+    if (g_ft_on < 0) frame_trace_init();
+    if (!g_ft_on) return;
+    static long long last;
+    const long long t = frame_trace_now_us();
+    const double dt_ms = last ? (double)(t - last) / 1000.0 : 0.0;
+    last = t;
+    ft_threads(dt_ms >= s_thr_ms && s_frame_no >= 1, s_frame_no + 1);
+    long long d[FT_N];
+    for (int i = 0; i < FT_N; i++) {
+        const long long v = s_ctr[i];
+#if defined(PS3_WASM)
+        const int is_max = i == FT_FS_MAX_US || i == FT_W_JOB_MAX_US;
+        d[i] = is_max ? v : v - s_prev[i];
+        s_prev[i] = is_max ? 0 : v;
+#else
+        d[i] = (i == FT_FS_MAX_US) ? v : v - s_prev[i];
+        s_prev[i] = (i == FT_FS_MAX_US) ? 0 : v;
+#endif
+    }
+#if defined(PS3_WASM)
+    __atomic_store_n(&s_ctr[FT_W_JOB_MAX_US], 0, __ATOMIC_RELAXED);
+#endif
+    /* the per-frame max is reset each frame */
+#ifdef _WIN32
+    InterlockedExchange64((volatile LONG64*)&s_ctr[FT_FS_MAX_US], 0);
+#else
+    __atomic_store_n(&s_ctr[FT_FS_MAX_US], 0, __ATOMIC_RELAXED);
+#endif
+    s_frame_no++;
+    s_frames++;
+    if (dt_ms > 16.7) s_over16++;
+    if (dt_ms > 33.3) s_over33++;
+    if (dt_ms > 50.0) s_over50++;
+    if (dt_ms > s_worst) s_worst = dt_ms;
+    if (dt_ms >= s_thr_ms && s_frame_no > 1) {
+        char line[512];
+        int n = snprintf(line, sizeof line, "[spike] frame %llu %.1f ms:", s_frame_no, dt_ms);
+        for (int i = 0; i < FT_N && n < (int)sizeof line - 32; i++) {
+            if (!d[i]) continue;
+            const int is_us = (i == FT_PSO_US || i == FT_HLSL_US || i == FT_TEX_US || i == FT_FLUSH_US ||
+                               i == FT_FS_US || i == FT_FS_MAX_US || i == FT_TICKER_IDLE_US || i == FT_FLIPWAIT_US ||
+                               i == FT_PSOLIB_US || i == FT_PSOMISS_US || i == FT_TR_KEY_US || i == FT_TEX_MALLOC_US || i == FT_TEX_CREATE_US || i == FT_TEX_CCR_US ||
+#if defined(PS3_WASM)
+                               i == FT_PSOGEN_US || i == FT_PSODISK_US || i == FT_PSOLIBMISS_US
+                               || i == FT_W_PFLIP_US || i == FT_W_X_US || i == FT_W_JOB_US || i == FT_W_JOB_MAX_US
+                               || i == FT_W_PRESWAIT_US || i == FT_W_FENCE_US);
+#else
+                               i == FT_PSOGEN_US || i == FT_PSODISK_US || i == FT_PSOLIBMISS_US);
+#endif
+            if (is_us) n += snprintf(line + n, sizeof line - n, " %s=%.1f", s_name[i], (double)d[i] / 1000.0);
+            else if (i == FT_FS_BYTES || i == FT_TR_FIN_BYTES) n += snprintf(line + n, sizeof line - n, " %s=%lld", s_name[i], d[i] >> 10);
+#if defined(PS3_WASM)
+            else if (i == FT_W_FLUSHWHY) n += snprintf(line + n, sizeof line - n, " %s=0x%llx", s_name[i], (unsigned long long)d[i]);
+#endif
+            else n += snprintf(line + n, sizeof line - n, " %s=%lld", s_name[i], d[i]);
+        }
+        fprintf(stderr, "%s\n", line);
+        s_spikes++;
+    }
+    const long long now = frame_trace_now_us();
+    if (!s_sum_t0) s_sum_t0 = now;
+    if (now - s_sum_t0 >= 10000000) {
+        fprintf(stderr, "[spike-sum] %.1f s: %llu frames, >16.7 ms %llu, >33 ms %llu, >50 ms %llu, worst %.1f ms, itemised %llu\n",
+                (double)(now - s_sum_t0) / 1e6, s_frames, s_over16, s_over33, s_over50, s_worst, s_spikes);
+        s_frames = s_over16 = s_over33 = s_over50 = s_spikes = 0;
+        s_worst = 0.0;
+        s_sum_t0 = now;
+    }
+}
+
+long long frame_trace_get(int id) { return (id >= 0 && id < FT_N) ? s_ctr[id] : 0; }
diff --git a/libs/video/frame_trace.h b/libs/video/frame_trace.h
new file mode 100644
index 00000000..4f8e6dd4
--- /dev/null
+++ b/libs/video/frame_trace.h
@@ -0,0 +1,75 @@
+/*
+ * ps3recomp - per-frame spike attribution (PS3_SPIKE_MS=<ms>, off by default)
+ *
+ * Counters that the expensive, rare events add to (PSO creation, synchronous HLSL compiles, texture decodes and
+ * evictions, ring-full GPU waits, guest file reads, the ticker's idle time). At every presented frame
+ * frame_trace_frame(dt_ms) takes the deltas; a frame of at least PS3_SPIKE_MS prints one "[spike]" line with
+ * everything that happened during it, so a hitch can be attributed without a profiler. Every 10 s a "[spike-sum]"
+ * line counts frames over 16.7 / 33 / 50 ms. Cost when off: one predictable branch per call site.
+ */
+#ifndef PS3_FRAME_TRACE_H
+#define PS3_FRAME_TRACE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    FT_PSO_NEW, FT_PSO_US,             /* CreateGraphicsPipelineState calls / time */
+    FT_HLSL_N, FT_HLSL_US,             /* synchronous D3DCompile in the draw path */
+    FT_TEX_DECODE, FT_TEX_US,          /* guest texture decodes (new / refreshed / evicted-and-reloaded) */
+    FT_TEX_EVICT,                      /* texture cache LRU evictions */
+    FT_FLUSH_N, FT_FLUSH_US,           /* non-present ld_flush (ring full, readback, ...) incl. the GPU wait */
+    FT_FS_N, FT_FS_BYTES, FT_FS_US,    /* guest file reads (cellFs / AIO) */
+    FT_FS_MAX_US,                      /* longest single read in the frame (max, not sum) */
+    FT_TICKER_IDLE_US,                 /* ticker waiting for work (guest late) */
+    FT_FLIPWAIT_US,                    /* guest render thread waiting in SetWaitFlip */
+    FT_PSOLIB_N, FT_PSOLIB_US,         /* PSOs loaded from the pipeline library (PS3_PSO_LIBRARY) / time */
+    FT_PSOMISS_N, FT_PSOMISS_US,       /* get_pso misses (new key) / time incl. HLSL, blobs, library or create */
+    FT_TR_KEY_US,                      /* texrepl_find: hashing guest texture chains for the HD-pack key */
+    FT_TR_FIN_N, FT_TR_FIN_BYTES,      /* texrepl uploads recorded (finalized) this frame, bytes */
+    FT_TEX_MALLOC_US, FT_TEX_CREATE_US, FT_TEX_CCR_US,   /* decode: RGBA staging malloc, create_texture_mipped (of it CreateCommittedResource) */
+    FT_PSOGEN_US,                      /* get_pso misses: program decode + HLSL generation (before any blob / PSO work) */
+    FT_PSODISK_N, FT_PSODISK_US,       /* get_pso misses: shader blobs read from the disk cache (render thread) */
+    FT_PSOLIBMISS_US,                  /* the WHOLE time of misses that compiled and created nothing (library / dedup) */
+#if defined(PS3_WASM)
+    /* WebAssembly (wasm-lock): the browser build's own suspects for a long frame */
+    FT_W_PFLIP_US,                     /* par-draw producer held at a flip, waiting for the translation thread */
+    FT_W_X_US,                         /* translation thread (X) busy draining the ring */
+    FT_W_JOB_N, FT_W_JOB_US,           /* SPURS job batches that ended in the frame / their total time */
+    FT_W_JOB_MAX_US,                   /* longest of them (max, reset per frame) */
+    FT_W_TMO,                          /* lock-line / cellSync event waits that ran into their safety timeout */
+    FT_W_YIELD,                        /* sched_yield calls (each a ~1-2 ms browser timed wait) */
+    FT_W_PRESWAIT_US,                  /* Present throttled: the device worker 2+ frames behind */
+    FT_W_FENCE_N, FT_W_FENCE_US,       /* GPU fence waits (d3d12_webgpu fence_wait) */
+    FT_W_FLUSHWHY,                     /* mid-frame flushes by reason: hex digit r = count of rsx_live_draw ld_flush_reason r */
+#endif
+    FT_N
+};
+
+extern int g_ft_on;                    /* PS3_SPIKE_MS set */
+void frame_trace_init(void);
+void frame_trace_add(int id, long long v);
+void frame_trace_max(int id, long long v);
+long long frame_trace_now_us(void);
+long long frame_trace_get(int id);    /* running total of a counter (deltas within one call site) */
+void frame_trace_frame(void);          /* call once per presented frame (measures the interval itself) */
+
+/* Per guest thread attribution (perf-game): every HLE import and lv2 syscall a guest thread (ids 1..FT_TID_MAX-1)
+ * makes is timed (key = NID, or FT_KEY_SC | syscall number), and each such thread's CPU time is sampled per frame
+ * (QueryThreadCycleTime). A spike frame also prints one "[spike-thr]" line: per thread its CPU ms in the frame and
+ * the calls it spent the most wall time in (the blocking ones: job waits, lwmutex, event queues, sleeps, reads). */
+#define FT_TID_MAX 16
+#define FT_KEY_SC 0x100000000ull
+void frame_trace_call(unsigned tid, unsigned long long key, long long us);
+#define FT_CALL_T0(var) long long var = g_ft_on > 0 ? frame_trace_now_us() : 0
+#define FT_CALL_END(var, tid, key) do { if (g_ft_on > 0 && (var)) frame_trace_call((tid), (key), frame_trace_now_us() - (var)); } while (0)
+
+#define FT_ADD(id, v) do { if (g_ft_on > 0) frame_trace_add((id), (long long)(v)); } while (0)
+#define FT_T0(var) long long var = g_ft_on > 0 ? frame_trace_now_us() : 0
+#define FT_SINCE(var) (g_ft_on > 0 ? frame_trace_now_us() - (var) : 0)
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/guest_wtrack.c b/libs/video/guest_wtrack.c
new file mode 100644
index 00000000..7bd5c6c5
--- /dev/null
+++ b/libs/video/guest_wtrack.c
@@ -0,0 +1,273 @@
+/*
+ * ps3recomp - guest page write tracking (see guest_wtrack.h)
+ */
+#include "guest_wtrack.h"
+#include "../../runtime/memory/vm_ready.h"   /* VM_MAPPED: vm_base may be 0 (native VA, wasm) */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+extern u8* vm_base;
+
+#define GWT_PAGE_SHIFT 12u
+#define GWT_PAGES      (1u << (32u - GWT_PAGE_SHIFT))
+#define GWT_CHUNK      4096u            /* pages per GetWriteWatch call (16 MB) */
+
+static u32* s_page_gen;                 /* GWT_PAGES entries, lazily allocated */
+static u32 s_gen;
+static int s_state = -1;                /* -1 unknown, 0 unavailable, 1 available */
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static PVOID s_addr[GWT_CHUNK + 1];
+static u64 s_calls, s_dirty;
+#define GWT_GRAN_SHIFT 18u               /* 256 KB */
+#define GWT_GRANS      (1u << (32u - GWT_GRAN_SHIFT))
+static u32* s_gran_epoch;                 /* GWT_GRANS entries */
+
+int gwt_available(void)
+{
+    if (s_state >= 0) return s_state;
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_state < 0) {
+        int ok = 0;
+        const char* e = getenv("PS3_WRITE_WATCH");
+        if (VM_MAPPED && !(e && e[0] == '0')) {
+            /* Probe: GetWriteWatch fails on a region reserved without
+             * MEM_WRITE_WATCH. Query (no reset) one page of the reservation. */
+            ULONG_PTR n = 1; DWORD gran = 0;
+            ok = GetWriteWatch(0, vm_base, 4096, s_addr, &n, &gran) == 0 && gran == 4096;
+            if (ok) {
+                s_page_gen = (u32*)VirtualAlloc(NULL, (SIZE_T)GWT_PAGES * sizeof(u32),
+                                                MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+                s_gran_epoch = (u32*)VirtualAlloc(NULL, (SIZE_T)GWT_GRANS * sizeof(u32),
+                                                  MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+                ok = s_page_gen != NULL && s_gran_epoch != NULL;
+            }
+        }
+        s_state = ok;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return s_state;
+}
+
+u32 gwt_range_gen(u32 ea, u32 len)
+{
+    if (!len || !gwt_available()) return 0;
+    const u64 end = (u64)ea + len;
+    if (end > 0x100000000ull) return 0;
+    const u32 p0 = ea >> GWT_PAGE_SHIFT;
+    const u32 p1 = (u32)((end - 1u) >> GWT_PAGE_SHIFT);
+    AcquireSRWLockExclusive(&s_lock);
+    s_calls++;
+    u32 newest = 0;
+    int bumped = 0;
+    for (u32 c = p0; c <= p1; ) {
+        const u32 n = (p1 - c + 1u) < GWT_CHUNK ? (p1 - c + 1u) : GWT_CHUNK;
+        ULONG_PTR count = GWT_CHUNK; DWORD gran = 0;
+        u8* base = vm_base + ((u64)c << GWT_PAGE_SHIFT);
+        if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, base, (SIZE_T)n << GWT_PAGE_SHIFT,
+                          s_addr, &count, &gran) != 0) {
+            /* should not happen inside the reservation: report "changed" */
+            newest = ++s_gen;
+            bumped = 1;
+            for (u32 p = c; p < c + n; p++) s_page_gen[p] = newest;
+        } else if (count) {
+            if (!bumped) { ++s_gen; bumped = 1; }
+            for (ULONG_PTR i = 0; i < count; i++) {
+                const u32 p = (u32)(((u8*)s_addr[i] - vm_base) >> GWT_PAGE_SHIFT);
+                s_page_gen[p] = s_gen;
+            }
+            s_dirty += count;
+        }
+        c += n;
+        if (!c) break;   /* wrapped past the last page */
+    }
+    for (u32 p = p0; ; p++) {
+        if (s_page_gen[p] > newest) newest = s_page_gen[p];
+        if (p == p1) break;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    /* A range nobody has ever seen written (not committed yet) is still
+     * "known": generation 0 would read as unavailable, so lift it to 1. */
+    return newest ? newest : 1u;
+}
+
+/* Ask + reset pages [p0, p1] (caller holds the lock); new written-gen in *bumped. */
+static void gwt_query_pages(u32 p0, u32 p1, int* bumped)
+{
+    for (u32 c = p0; c <= p1; ) {
+        const u32 n = (p1 - c + 1u) < GWT_CHUNK ? (p1 - c + 1u) : GWT_CHUNK;
+        ULONG_PTR count = GWT_CHUNK; DWORD gran = 0;
+        u8* base = vm_base + ((u64)c << GWT_PAGE_SHIFT);
+        s_calls++;
+        if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, base, (SIZE_T)n << GWT_PAGE_SHIFT,
+                          s_addr, &count, &gran) != 0) {
+            if (!*bumped) { ++s_gen; *bumped = 1; }
+            for (u32 p = c; p < c + n; p++) s_page_gen[p] = s_gen;
+        } else if (count) {
+            if (!*bumped) { ++s_gen; *bumped = 1; }
+            for (ULONG_PTR i = 0; i < count; i++)
+                s_page_gen[(u32)(((u8*)s_addr[i] - vm_base) >> GWT_PAGE_SHIFT)] = s_gen;
+            s_dirty += count;
+        }
+        c += n;
+        if (!c) break;
+    }
+}
+
+/* PS3_GWT_MERGE (perf round): a range's run of consecutive granules not yet
+ * asked in this epoch goes to the OS as ONE query (gwt_query_pages splits at
+ * GWT_CHUNK) instead of one GetWriteWatch per 256 KB granule -- the same
+ * pages are asked and reset, in the same call of gwt_range_gen_epoch, under
+ * the same generation bump, and a granule already asked in this epoch still
+ * splits the run (it is never asked twice per epoch). PS3_GWT_MERGE=0 /
+ * PS3_GWT_MERGE_OFF_FILE (polled at most once per epoch, >= 250 ms apart):
+ * one query per granule. PS3_DRAW_VERIFY=1: before a merged query, each
+ * granule of the run is asked without reset; every page found written there
+ * must come out of the merged query written too. */
+static int s_merge = -1, s_merge_off_now, s_verify;
+static const char* s_merge_off;
+static DWORD s_merge_tick;
+static u32 s_merge_epoch;
+static u64 s_ep_calls, s_ep_grans, s_ep_runs, s_vchecks, s_vbad;
+static PVOID s_vaddr[1u << (GWT_GRAN_SHIFT - GWT_PAGE_SHIFT)];
+static int gwt_merge_on(u32 epoch)
+{
+    if (s_merge < 0) {
+        const char* e = getenv("PS3_GWT_MERGE");
+        s_merge = !(e && e[0] == '0');
+        s_merge_off = getenv("PS3_GWT_MERGE_OFF_FILE");
+        if (s_merge_off && !s_merge_off[0]) s_merge_off = NULL;
+        const char* v = getenv("PS3_DRAW_VERIFY");
+        s_verify = v && v[0] && v[0] != '0';
+        fprintf(stderr, "[gwt] PS3_GWT_MERGE %s%s\n", s_merge ? "on" : "off (PS3_GWT_MERGE=0)",
+                s_merge_off ? " (off file polled)" : "");
+    }
+    if (s_merge && s_merge_off && epoch != s_merge_epoch) {
+        s_merge_epoch = epoch;
+        const DWORD now = GetTickCount();
+        if (now - s_merge_tick >= 250u) {
+            s_merge_tick = now;
+            const int off = GetFileAttributesA(s_merge_off) != INVALID_FILE_ATTRIBUTES;
+            if (off != s_merge_off_now)
+                fprintf(stderr, "[gwt] PS3_GWT_MERGE %s\n", off ? "OFF (one query per granule)" : "on");
+            s_merge_off_now = off;
+        }
+    }
+    return s_merge && !s_merge_off_now;
+}
+
+/* Ask (and reset) granules [ga, gb] as one query; verify mode checks it. */
+static void gwt_query_run(u32 ga, u32 gb, int* bumped)
+{
+    const u32 per = 1u << (GWT_GRAN_SHIFT - GWT_PAGE_SHIFT);
+    const u32 pp0 = ga * per, pp1 = (gb + 1u) * per - 1u;
+    s_ep_runs++;
+    if (!s_verify || ga == gb) { gwt_query_pages(pp0, pp1, bumped); return; }
+    /* verify: the written pages each granule reports now (no reset) */
+    u32* seen = NULL; u32 n_seen = 0;
+    seen = (u32*)malloc((size_t)(gb - ga + 1u) * per * sizeof(u32));
+    if (seen)
+        for (u32 g = ga; g <= gb; g++) {
+            ULONG_PTR count = per; DWORD gran = 0;
+            if (GetWriteWatch(0, vm_base + ((u64)g * per << GWT_PAGE_SHIFT), (SIZE_T)per << GWT_PAGE_SHIFT,
+                              s_vaddr, &count, &gran) == 0)
+                for (ULONG_PTR i = 0; i < count; i++)
+                    seen[n_seen++] = (u32)(((u8*)s_vaddr[i] - vm_base) >> GWT_PAGE_SHIFT);
+        }
+    gwt_query_pages(pp0, pp1, bumped);
+    if (seen) {
+        int ok = 1;
+        for (u32 i = 0; i < n_seen; i++)
+            if (!*bumped || s_page_gen[seen[i]] != s_gen) ok = 0;
+        s_vchecks++;
+        if (!ok && s_vbad++ < 16)
+            fprintf(stderr, "[gwt] VERIFY MISMATCH: merged query of granules 0x%X..0x%X missed a written page\n", ga, gb);
+        free(seen);
+    }
+}
+
+u32 gwt_range_gen_epoch(u32 ea, u32 len, u32 epoch)
+{
+    if (!len || !epoch || !gwt_available()) return 0;
+    const u64 end = (u64)ea + len;
+    if (end > 0x100000000ull) return 0;
+    const u32 g0 = ea >> GWT_GRAN_SHIFT, g1 = (u32)((end - 1u) >> GWT_GRAN_SHIFT);
+    AcquireSRWLockExclusive(&s_lock);
+    const int merge = gwt_merge_on(epoch);
+    s_ep_calls++;
+    int bumped = 0;
+    u32 run0 = 0;
+    int in_run = 0;
+    for (u32 g = g0; ; g++) {
+        const int stale = s_gran_epoch[g] != epoch;
+        if (stale) {
+            s_ep_grans++;
+            if (!merge) {
+                const u32 pp0 = g << (GWT_GRAN_SHIFT - GWT_PAGE_SHIFT);
+                s_ep_runs++;
+                gwt_query_pages(pp0, pp0 + (1u << (GWT_GRAN_SHIFT - GWT_PAGE_SHIFT)) - 1u, &bumped);
+            } else if (!in_run) {
+                run0 = g; in_run = 1;
+            }
+            s_gran_epoch[g] = epoch;
+        }
+        if (in_run && (!stale || g == g1)) {
+            gwt_query_run(run0, stale ? g : g - 1u, &bumped);
+            in_run = 0;
+        }
+        if (g == g1) break;
+    }
+    u32 newest = 0;
+    const u32 p0 = ea >> GWT_PAGE_SHIFT, p1 = (u32)((end - 1u) >> GWT_PAGE_SHIFT);
+    for (u32 p = p0; ; p++) {
+        if (s_page_gen[p] > newest) newest = s_page_gen[p];
+        if (p == p1) break;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return newest ? newest : 1u;
+}
+
+void gwt_invalidate(u32 ea, u32 len)
+{
+    if (!len || s_state != 1) return;
+    const u64 end = (u64)ea + len;
+    if (end > 0x100000000ull) return;
+    const u32 g0 = ea >> GWT_GRAN_SHIFT, g1 = (u32)((end - 1u) >> GWT_GRAN_SHIFT);
+    AcquireSRWLockExclusive(&s_lock);
+    for (u32 g = g0; ; g++) { s_gran_epoch[g] = 0; if (g == g1) break; }
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+void gwt_stats(u64* calls, u64* dirty_pages)
+{
+    if (calls) *calls = s_calls;
+    if (dirty_pages) *dirty_pages = s_dirty;
+}
+
+void gwt_epoch_stats(u64* calls, u64* stale_granules, u64* queries, u64* vchecks, u64* vbad)
+{
+    if (calls) *calls = s_ep_calls;
+    if (stale_granules) *stale_granules = s_ep_grans;
+    if (queries) *queries = s_ep_runs;
+    if (vchecks) *vchecks = s_vchecks;
+    if (vbad) *vbad = s_vbad;
+}
+
+#else /* !_WIN32 */
+
+int gwt_available(void) { return 0; }
+u32 gwt_range_gen(u32 ea, u32 len) { (void)ea; (void)len; return 0; }
+u32 gwt_range_gen_epoch(u32 ea, u32 len, u32 e) { (void)ea; (void)len; (void)e; return 0; }
+void gwt_epoch_stats(u64* c, u64* g, u64* q, u64* v, u64* b)
+{ if (c) *c = 0; if (g) *g = 0; if (q) *q = 0; if (v) *v = 0; if (b) *b = 0; }
+void gwt_invalidate(u32 ea, u32 len) { (void)ea; (void)len; }
+void gwt_stats(u64* calls, u64* dirty_pages) { if (calls) *calls = 0; if (dirty_pages) *dirty_pages = 0; }
+
+#endif
diff --git a/libs/video/guest_wtrack.h b/libs/video/guest_wtrack.h
new file mode 100644
index 00000000..4f91a286
--- /dev/null
+++ b/libs/video/guest_wtrack.h
@@ -0,0 +1,67 @@
+/*
+ * ps3recomp - guest page write tracking for the renderer (Windows write watch)
+ *
+ * The renderer keeps host copies of guest memory -- decoded textures, and the
+ * guest-memory side of blits it also does on the GPU -- and has to notice when
+ * the guest rewrites the source. Re-hashing every bound texture every frame
+ * does that by reading all of it again. This asks the OS instead: boot_main
+ * reserves the 4 GB guest space with MEM_WRITE_WATCH (PS3_WRITE_WATCH=0: not),
+ * and GetWriteWatch reports which 4 KB pages were written since their last
+ * reset -- by any thread, the kernel included.
+ *
+ *   u32 g = gwt_range_gen(ea, len);
+ *
+ * resets the write state of every page in [ea, ea + len) and returns the
+ * newest "written" generation of those pages: a page found written gets a
+ * fresh generation from a global counter. A caller keeps the value it saw when
+ * it last read the range; a later call returning anything else means the range
+ * may have changed since (a page shared with another caller keeps its
+ * generation, so callers never steal each other's dirty bits). Reset happens
+ * BEFORE the caller reads the data, so a write racing the read is reported by
+ * the next call.
+ *
+ * Cost model: one GetWriteWatch syscall per call (~1-2 us), and the first
+ * guest write to a page after its reset takes a soft fault (~1 us) -- so a
+ * range the guest rewrites every frame should not be tracked (callers back off
+ * after a few consecutive dirty results). Pages nobody tracks are never reset
+ * and cost nothing.
+ *
+ * Windows only; elsewhere gwt_available() is 0 and callers keep their
+ * hashing. All calls come from the RSX thread; a lock covers the rest.
+ */
+#ifndef PS3RECOMP_GUEST_WTRACK_H
+#define PS3RECOMP_GUEST_WTRACK_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 1 when the guest VM reservation tracks writes (checked once). */
+int gwt_available(void);
+
+/* See above. Returns 0 when unavailable or for an empty / out-of-range span:
+ * callers must treat 0 as "unknown" (gwt_available() == 0) and fall back. */
+u32 gwt_range_gen(u32 ea, u32 len);
+
+/* Same contract, but each 256 KB granule of the range is asked (and reset)
+ * at most once per `epoch` (the caller's frame counter + 1): many small
+ * textures sharing granules cost one syscall per granule per frame instead of
+ * one per texture. A write the caller makes itself after a granule was asked
+ * in this epoch must be reported with gwt_invalidate so the next query asks
+ * again (writes by other threads are asynchronous to the caller anyway). */
+u32 gwt_range_gen_epoch(u32 ea, u32 len, u32 epoch);
+void gwt_invalidate(u32 ea, u32 len);
+
+/* Counters for a stats line: calls, pages found written. */
+void gwt_stats(u64* calls, u64* dirty_pages);
+/* gwt_range_gen_epoch counters (cumulative): calls, granules asked, queries
+ * made for them (PS3_GWT_MERGE: one per run of consecutive granules), merged
+ * query verifications / mismatches (PS3_DRAW_VERIFY=1). */
+void gwt_epoch_stats(u64* calls, u64* stale_granules, u64* queries, u64* vchecks, u64* vbad);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3RECOMP_GUEST_WTRACK_H */
diff --git a/libs/video/host_pacing.c b/libs/video/host_pacing.c
new file mode 100644
index 00000000..7b2ebb9c
--- /dev/null
+++ b/libs/video/host_pacing.c
@@ -0,0 +1,1253 @@
+/*
+ * ps3recomp - host frame pacing (see host_pacing.h).
+ *
+ * Decoupled path: one clock thread at TIME_CRITICAL priority ticks the guest
+ * vblank (cellGcmTickVBlank) and the flip-completion clock (cellGcmTickFlip)
+ * from a QPC schedule slept on a high-resolution waitable timer (plus a short
+ * spin), or from the monitor's own vblank (IDXGIOutput::WaitForVBlank). Each
+ * tick also kicks the FIFO walker / present thread. The present thread then
+ * only walks the FIFO, translates and presents; a slow frame or a blocking
+ * Present no longer delays or bunches the guest's vblanks.
+ *
+ * Statistics (PS3_PACE_STATS / PS3_PACE_CSV) work on both paths.
+ */
+#include "host_pacing.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if !defined(_WIN32) && !defined(PS3_WASM)
+
+int    ps3_pacing_request(const ps3_pacing_req* r) { (void)r; return 0; }
+int    ps3_pacing_init(void) { return 0; }
+int    ps3_pacing_active(void) { return 0; }
+int    ps3_pacing_vsync(void) { return 1; }
+int    ps3_pacing_max_latency(void) { return 0; }
+void   ps3_pacing_start(void* hwnd) { (void)hwnd; }
+unsigned long long ps3_pacing_vblanks(void) { return 0; }
+double ps3_pacing_vblank_hz(void) { return 62.5; }
+double ps3_pacing_display_hz(void) { return 0.0; }
+int    ps3_pacing_flip_mode(void) { return PS3_FLIPCLK_VBLANK; }
+void   ps3_pacing_on_present(void) {}
+void   ps3_pacing_note_vblank(void) {}
+int    ps3_pacing_wait_flip_tick(unsigned ms) { (void)ms; return 0; }
+void   ps3_pacing_present_hold(void) {}
+int    ps3_pacing_dxstats_on(void) { return 0; }
+void   ps3_pacing_dxstats_cost(long long t) { (void)t; }
+void   ps3_pacing_display_sample(int ok, unsigned lpc, unsigned pc, unsigned prc, unsigned src, long long t, int c)
+{ (void)ok; (void)lpc; (void)pc; (void)prc; (void)src; (void)t; (void)c; }
+int    ps3_pacing_inject_before_present(void) { return 0; }
+
+#else  /* _WIN32 || PS3_WASM */
+
+#if defined(PS3_WASM)
+/* WebAssembly (browser build): the same decoupled clock on the runtime's Win32 shims (win32_compat.h: QPC, events,
+ * CreateThread, Interlocked*). Differences from Windows, all forced by the browser:
+ *   - DEFAULT UNCHANGED: the legacy 16 ms ticker unless PS3_VBLANK_HZ or PS3_FLIP_HZ (or a pacing request) asks
+ *     for the clock -- Windows defaults to a 60 Hz clock since 2026-10-05, the browser build kept the ticker;
+ *   - no monitor vblank in a worker: "display" (vblank or flip) runs as a 60 Hz timer, as Windows does without
+ *     a window;
+ *   - sleeps: a timed futex wait (a browser rounds it up by ~1-2 ms), so it stops PS3_PACE_SPIN_US (default
+ *     2000 here) early and spins the rest on emscripten_get_now;
+ *   - PS3_VSYNC is accepted and reported, but the WebGPU present never waits for the display (the canvas takes
+ *     the frame when the GPU finishes it): vsync is effectively off either way;
+ *   - PS3_PACE_CTL (live control file) is not available. */
+#include "../../runtime/platform/win32_compat.h"
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#include <strings.h>
+#define _stricmp strcasecmp
+#define _strdup  strdup
+typedef void* HWND;
+#ifndef TIMER_ALL_ACCESS
+#define TIMER_ALL_ACCESS 0x1F0003
+#endif
+/* no waitable timers in the browser: sleep_until() with a NULL timer = timed futex wait + spin (the clock thread's path) */
+static inline HANDLE CreateWaitableTimerExW(void* sa, const void* name, DWORD flags, DWORD access)
+{ (void)sa; (void)name; (void)flags; (void)access; return NULL; }
+#else
+#include <windows.h>
+#include <dxgi.h>
+#endif
+#include <math.h>
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+/* cellGcmSys.c */
+extern void  cellGcmTickVBlank(void);
+extern void  cellGcmTickFlip(void);
+extern int   cellGcm_tick_flip_if_waiting(void);
+extern void* cellGcm_fifo_kick_event(void);
+extern unsigned cellGcm_flip_request_count(void);
+extern void  cellGcm_set_vblank_hz(double hz);
+
+/* ---- configuration ---------------------------------------------------- */
+static ps3_pacing_req s_req = { PS3_PACE_KEEP, PS3_PACE_KEEP, -1, 0, NULL };
+static char  s_req_who[96];
+static int   s_inited = 0;
+static int   s_active = 0;            /* decoupled clock path */
+static double s_vblank_hz = 60.0;      /* timer rate (when !s_vblank_display) */
+static int   s_vblank_display = 0;
+static int   s_flip_mode = PS3_FLIPCLK_VBLANK;
+static double s_flip_hz = 0.0;         /* PS3_FLIPCLK_TIMER */
+static int   s_vsync = 1;
+static int   s_max_latency = 0;
+static double s_stats_s = 0.0;
+static FILE* s_csv = NULL;
+static const char*   s_ctl_path = NULL;    /* PS3_PACE_CTL */
+static volatile LONG s_cfg_gen = 0;        /* bumped per applied control change */
+static volatile LONG s_stats_restart = 0;  /* present thread: close the window now */
+static unsigned s_spin_us = 200;
+static int   s_credit_on = 1;         /* PS3_FLIP_CREDIT=0: plain ticks (late frames wait a whole period) */
+
+/* ---- state ------------------------------------------------------------- */
+static LONGLONG s_freq = 0;
+static volatile LONG64 s_vblanks = 0;      /* guest vblank ticks issued */
+static volatile LONG64 s_flipticks = 0;    /* flip-clock ticks issued (incl. with vblank) */
+static volatile LONG   s_started = 0;
+static HANDLE s_flip_tick_ev = NULL;       /* set on each flip tick (SetWaitFlip waits on it) */
+static HWND s_sp_hwnd = NULL;              /* the window (scanprobe: its monitor) */
+static volatile LONG64 s_display_mhz = 0;  /* monitor refresh x 1000 (0 = unknown) */
+static volatile LONG64 s_disp_period_ns = 0; /* measured WaitForVBlank period (EMA) */
+
+static LONGLONG qpc(void) { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+
+static int parse_bool(const char* v, int def)
+{
+    if (!v || !*v) return def;
+    if (!_stricmp(v, "1") || !_stricmp(v, "on") || !_stricmp(v, "true") || !_stricmp(v, "yes")) return 1;
+    if (!_stricmp(v, "0") || !_stricmp(v, "off") || !_stricmp(v, "false") || !_stricmp(v, "no")) return 0;
+    return def;
+}
+
+/* "display"/"monitor" -> PS3_PACE_DISPLAY, "present" -> PRESENT, "vblank" ->
+ * VBLANK, a number -> itself, anything else -> KEEP. */
+static double parse_rate(const char* v)
+{
+    if (!v || !*v) return PS3_PACE_KEEP;
+    if (!_stricmp(v, "display") || !_stricmp(v, "monitor")) return PS3_PACE_DISPLAY;
+    if (!_stricmp(v, "present") || !_stricmp(v, "unlocked")) return PS3_PACE_PRESENT;
+    if (!_stricmp(v, "vblank")) return PS3_PACE_VBLANK;
+    char* end = NULL;
+    double hz = strtod(v, &end);
+    if (end == v || !(hz >= 1.0 && hz <= 1000.0)) {
+        fprintf(stderr, "[pace] ignoring rate '%s' (1..1000 Hz, display, present, vblank)\n", v);
+        return PS3_PACE_KEEP;
+    }
+    return hz;
+}
+
+int ps3_pacing_request(const ps3_pacing_req* r)
+{
+    if (!r || s_inited) return -1;
+    if (r->vblank_hz != PS3_PACE_KEEP) s_req.vblank_hz = r->vblank_hz;
+    if (r->flip_hz != PS3_PACE_KEEP)   s_req.flip_hz = r->flip_hz;
+    if (r->vsync >= 0)                 s_req.vsync = r->vsync ? 1 : 0;
+    if (r->max_latency > 0)            s_req.max_latency = r->max_latency;
+    snprintf(s_req_who, sizeof s_req_who, "%s", r->who ? r->who : "request");
+    s_req.who = s_req_who;
+    return 0;
+}
+
+static const char* flip_name(void)
+{
+    switch (s_flip_mode) {
+    case PS3_FLIPCLK_TIMER:   return "timer";
+    case PS3_FLIPCLK_DISPLAY: return "display vblank";
+    case PS3_FLIPCLK_PRESENT: return "on present (+ every vblank)";
+    default:                  return "every guest vblank";
+    }
+}
+
+int ps3_pacing_init(void)
+{
+    if (s_inited) return s_active;
+    s_inited = 1;
+    { LARGE_INTEGER f; QueryPerformanceFrequency(&f); s_freq = f.QuadPart; }
+
+    const char* e_force = getenv("PS3_PACE");         /* 0/legacy = ignore every request */
+    const int forced_legacy = e_force && (!_stricmp(e_force, "0") || !_stricmp(e_force, "legacy"));
+    double vhz = forced_legacy ? PS3_PACE_KEEP : s_req.vblank_hz;
+    double fhz = forced_legacy ? PS3_PACE_KEEP : s_req.flip_hz;
+    int vsync = s_req.vsync, lat = s_req.max_latency;
+    const char* src_v = (vhz != PS3_PACE_KEEP) ? s_req_who : NULL;
+    const char* src_f = (fhz != PS3_PACE_KEEP) ? s_req_who : NULL;
+
+    const char* e;
+    if ((e = getenv("PS3_VBLANK_HZ")) && *e) {
+        double v = parse_rate(e);
+        if (v == PS3_PACE_PRESENT || v == PS3_PACE_VBLANK) v = PS3_PACE_KEEP;
+        if (v != PS3_PACE_KEEP) { vhz = v; src_v = "PS3_VBLANK_HZ"; }
+    }
+    /* Default (2026-10-05): the decoupled vblank clock at 60.000 Hz for every title, not only when a plugin asks.
+     * The legacy 16 ms ticker ran the guest vblank at 62.5 Hz: vblank-timed game logic 4.2 % fast. PS3_PACE=0 =
+     * the legacy ticker (debugging only). */
+#if !defined(PS3_WASM)
+    if (!forced_legacy && vhz == PS3_PACE_KEEP) { vhz = 60.0; src_v = "default"; }
+#endif
+    if ((e = getenv("PS3_FLIP_HZ")) && *e) {
+        double v = parse_rate(e);
+        if (v != PS3_PACE_KEEP) { fhz = v; src_f = "PS3_FLIP_HZ"; }
+    }
+#if defined(PS3_WASM)
+    /* the browser build keeps the legacy ticker unless the clock is asked for; asked for (a flip clock only):
+     * the guest vblank defaults to 60 Hz, as on Windows */
+    if (!forced_legacy && vhz == PS3_PACE_KEEP && fhz != PS3_PACE_KEEP) { vhz = 60.0; src_v = "default"; }
+    s_spin_us = 2000;
+#endif
+    if ((e = getenv("PS3_VSYNC")) && *e) vsync = parse_bool(e, vsync < 0 ? 1 : vsync);
+    if ((e = getenv("PS3_FRAME_LATENCY")) && *e) lat = atoi(e);
+    if ((e = getenv("PS3_PACE_STATS")) && *e) s_stats_s = atof(e);
+    if ((e = getenv("PS3_PACE_SPIN_US")) && *e) s_spin_us = (unsigned)atoi(e);
+    if ((e = getenv("PS3_FLIP_CREDIT")) && *e) s_credit_on = parse_bool(e, 1);
+    if ((e = getenv("PS3_PACE_CSV")) && *e) {
+        s_csv = fopen(e, "wb");
+        if (s_csv) { setvbuf(s_csv, NULL, _IOFBF, 1 << 16); fprintf(s_csv, "t_ms,dt_ms,cfg\n"); }
+        else fprintf(stderr, "[pace] cannot open PS3_PACE_CSV=%s\n", e);
+    }
+
+#if defined(PS3_WASM)
+    if ((e = getenv("PS3_PACE_CTL")) && *e) fprintf(stderr, "[pace] PS3_PACE_CTL is not available in the browser build\n");
+#else
+    if ((e = getenv("PS3_PACE_CTL")) && *e) s_ctl_path = _strdup(e);
+#endif
+    s_vsync = vsync < 0 ? 1 : vsync;
+    s_max_latency = lat < 0 ? 0 : (lat > 16 ? 16 : lat);
+    s_active = (vhz != PS3_PACE_KEEP || fhz != PS3_PACE_KEEP) && !forced_legacy;
+    if (!s_active) {
+        if (s_vsync != 1 || s_max_latency)
+            fprintf(stderr, "[pace] legacy 16 ms ticker; present: vsync %s, max latency %d\n",
+                    s_vsync ? "on" : "off (tearing allowed)", s_max_latency);
+        if (forced_legacy && (s_req.vblank_hz != PS3_PACE_KEEP || s_req.flip_hz != PS3_PACE_KEEP))
+            fprintf(stderr, "[pace] PS3_PACE=%s: ignoring the clock request of %s\n", e_force, s_req_who);
+        return 0;
+    }
+
+    if (vhz == PS3_PACE_DISPLAY) s_vblank_display = 1;
+    else if (vhz > 0) s_vblank_hz = vhz;
+    else s_vblank_hz = 60.0;                       /* decoupled path, vblank not given */
+    if (fhz == PS3_PACE_DISPLAY)      s_flip_mode = PS3_FLIPCLK_DISPLAY;
+    else if (fhz == PS3_PACE_PRESENT) s_flip_mode = PS3_FLIPCLK_PRESENT;
+    else if (fhz > 0)               { s_flip_mode = PS3_FLIPCLK_TIMER; s_flip_hz = fhz; }
+    else                              s_flip_mode = PS3_FLIPCLK_VBLANK;
+    s_flip_tick_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    /* The GCM interrupt-thread mode (GCM_IRQ_THREAD=1) keeps its own vblank
+     * clock: give it the same rate (display mode: its nominal rate, below). */
+    if (!s_vblank_display) cellGcm_set_vblank_hz(s_vblank_hz);
+
+    char vb[64];
+    if (s_vblank_display) snprintf(vb, sizeof vb, "the monitor's vblank");
+    else snprintf(vb, sizeof vb, "%.3f Hz timer", s_vblank_hz);
+    char fb[64];
+    if (s_flip_mode == PS3_FLIPCLK_TIMER) snprintf(fb, sizeof fb, "%.3f Hz timer", s_flip_hz);
+    else snprintf(fb, sizeof fb, "%s", flip_name());
+    fprintf(stderr, "[pace] decoupled clock: guest vblank %s (%s), flips complete %s (%s); "
+            "present: vsync %s, max latency %d\n",
+            vb, src_v ? src_v : "default", fb, src_f ? src_f : "default",
+            s_vsync ? "on" : "off (tearing allowed)", s_max_latency);
+    return 1;
+}
+
+int    ps3_pacing_active(void) { return s_active; }
+int    ps3_pacing_vsync(void) { return s_vsync; }
+int    ps3_pacing_max_latency(void) { return s_max_latency; }
+int    ps3_pacing_flip_mode(void) { return s_active ? s_flip_mode : PS3_FLIPCLK_VBLANK; }
+unsigned long long ps3_pacing_vblanks(void) { return (unsigned long long)s_vblanks; }
+double ps3_pacing_display_hz(void)
+{
+    const LONG64 p = s_disp_period_ns;
+    if (p > 0) return 1e9 / (double)p;
+    return (double)s_display_mhz / 1000.0;
+}
+double ps3_pacing_vblank_hz(void)
+{
+    if (!s_active) return 62.5;
+    if (s_vblank_display) { double d = ps3_pacing_display_hz(); return d > 1.0 ? d : 60.0; }
+    return s_vblank_hz;
+}
+
+/* ---- ticks -------------------------------------------------------------- */
+static HANDLE s_kick = NULL;
+/* Flip credit (a token bucket of one): a flip tick that finds no flip
+ * outstanding is banked, and the next flip the guest waits for (SetWaitFlip,
+ * ps3_pacing_wait_flip_tick) completes at once instead of at the following
+ * tick. The flip rate stays capped at the clock's rate, but a frame that
+ * misses its tick by a little is not held for a whole period: without it a
+ * guest that renders at 100 fps under a 120 Hz flip clock was quantized to
+ * 60 (double-buffered vsync). PS3_FLIP_CREDIT=0 = plain ticks. */
+static volatile LONG s_flip_credit = 0;
+static volatile LONG64 s_credit_used = 0;
+/* PS3_PRESENT_FLIP_CREDIT (default on; =0 or PS3_PRESENT_FLIP_CREDIT_OFF_FILE=<path> while it exists, polled at most
+ * every 250 ms): in the PRESENT flip clock a present that finds no flip WAITING banks the same one-tick credit a
+ * vblank tick_flip banks, instead of being lost. THP8 (sub_00566484 -> cellGcmSetWaitFlip) otherwise has a flip that
+ * missed its present completed only by the next 60 Hz vblank tick -- 15-17 ms frames, the uncapped 1% lows. The
+ * flip rate stays capped by the presents (one credit at most); cellGcmSetWaitFlip's walker bound
+ * (GCM_WAITFLIP_WALKER) still keeps the title within one flip of the FIFO walker. Consumed by
+ * ps3_pacing_wait_flip_tick, i.e. only while PS3_FLIP_CREDIT is on. Counters on the [pace] stats line:
+ * present ticks lost (no flip waiting), present credits banked, credits used. */
+static int s_pcredit = -1, s_pcredit_off;
+static const char* s_pcredit_file;
+static ULONGLONG s_pcredit_chk;
+static volatile LONG64 s_present_lost = 0, s_present_banked = 0;
+static LONG64 s_win_pl0, s_win_pb0;
+static int present_credit_on(void)
+{
+    if (s_pcredit < 0) {
+        const char* e = getenv("PS3_PRESENT_FLIP_CREDIT");
+        s_pcredit = !(e && *e == '0');
+        s_pcredit_file = getenv("PS3_PRESENT_FLIP_CREDIT_OFF_FILE");
+        if (s_pcredit_file && !*s_pcredit_file) s_pcredit_file = NULL;
+        fprintf(stderr, "[pace] PS3_PRESENT_FLIP_CREDIT %s%s\n", s_pcredit ? "on" : "off",
+                s_pcredit && s_pcredit_file ? " (live off file)" : "");
+    }
+    if (!s_pcredit) return 0;
+    if (s_pcredit_file) {
+        const ULONGLONG now = GetTickCount64();
+        if (now - s_pcredit_chk >= 250) {
+            s_pcredit_chk = now;
+            const int off = GetFileAttributesA(s_pcredit_file) != INVALID_FILE_ATTRIBUTES;
+            if (off != s_pcredit_off)
+                fprintf(stderr, "[pace] PS3_PRESENT_FLIP_CREDIT %s\n", off ? "OFF (lost present ticks)" : "on");
+            s_pcredit_off = off;
+        }
+    }
+    return !s_pcredit_off;
+}
+
+/* PS3_FLIP_DISPLAY_LOCK (default on; =0, or PS3_FLIP_DISPLAY_LOCK_OFF_FILE=<path> while it exists, polled every
+ * 250 ms by the clock thread): a TIMER flip clock within 0.5 % of the monitor's refresh rate (the 120 fps cap on a
+ * 120 Hz display) ticks on the monitor's vblank -- the DISPLAY clock -- instead of on its own timer. Two clocks at
+ * nominally the same rate drift against each other: with vsync on, the frames presented a few ms after each timer
+ * tick slowly walk across the display's vblanks, and while they straddle one, refreshes alternately repeat an image
+ * and skip one. Locked, every flip tick is a vblank and each Present lands at the same point of its refresh. The
+ * flip credit, the walker bound and the 60 Hz guest vblank timer are unchanged; an unusable display clock falls
+ * back to the timer (as flip=display does). Ships only together with PS3_PRESENT_PACE: the lock alone regressed the
+ * skating phases in the exclusive A/B (C0-CB, 2026-10-10), so whenever the present pacing is off (PS3_PRESENT_PACE=0
+ * or its off file) the lock is forced off too. */
+static int present_pace_live(void);           /* below: PS3_PRESENT_PACE in effect right now */
+static int s_dlock_eff = -1;                  /* last effective lock state (lock on && pace on) */
+static int s_dlock = -1, s_dlock_off = 0;
+static const char* s_dlock_file;
+static int dlock_on(void)
+{
+    if (s_dlock < 0) {
+        const char* e = getenv("PS3_FLIP_DISPLAY_LOCK");
+        s_dlock = !(e && *e == '0');
+        s_dlock_file = getenv("PS3_FLIP_DISPLAY_LOCK_OFF_FILE");
+        if (s_dlock_file && !*s_dlock_file) s_dlock_file = NULL;
+        if (s_dlock_file) s_dlock_off = GetFileAttributesA(s_dlock_file) != INVALID_FILE_ATTRIBUTES;
+        fprintf(stderr, "[pace] PS3_FLIP_DISPLAY_LOCK %s%s\n", s_dlock ? "on" : "off",
+                s_dlock && s_dlock_file ? " (live off file)" : "");
+    }
+    const int pace = present_pace_live();
+    static int said_forced = 0;
+    if (s_dlock && !s_dlock_off && !pace && !said_forced) {
+        said_forced = 1;
+        fprintf(stderr, "[pace] PS3_FLIP_DISPLAY_LOCK forced OFF: it ships only with PS3_PRESENT_PACE, which is off\n");
+    }
+    s_dlock_eff = s_dlock && !s_dlock_off && pace;
+    return s_dlock_eff;
+}
+/* clock thread, every 250 ms: 1 if the off file appeared / went away */
+static int dlock_poll(void)
+{
+    if (s_dlock <= 0) return 0;
+    if (s_dlock_file) {
+        const int off = GetFileAttributesA(s_dlock_file) != INVALID_FILE_ATTRIBUTES;
+        if (off != s_dlock_off)
+            fprintf(stderr, "[pace] PS3_FLIP_DISPLAY_LOCK %s\n", off ? "OFF (timer flip clock)" : "on");
+        s_dlock_off = off;
+    }
+    const int eff = !s_dlock_off && present_pace_live();   /* the pace's off file also turns the lock off */
+    return s_dlock_eff >= 0 && eff != s_dlock_eff;          /* -> reconfigure (dlock_on re-evaluates) */
+}
+
+static void tick_flip(void)
+{
+    InterlockedIncrement64(&s_flipticks);
+    if (s_credit_on) {
+        if (!cellGcm_tick_flip_if_waiting()) InterlockedExchange(&s_flip_credit, 1);
+        else InterlockedExchange(&s_flip_credit, 0);
+    } else {
+        cellGcmTickFlip();
+    }
+    if (s_flip_tick_ev) SetEvent(s_flip_tick_ev);
+}
+
+static void tick_vblank(void)
+{
+    InterlockedIncrement64(&s_vblanks);
+    cellGcmTickVBlank();
+    if (s_flip_mode == PS3_FLIPCLK_VBLANK || s_flip_mode == PS3_FLIPCLK_PRESENT) tick_flip();
+    if (s_kick) SetEvent(s_kick);           /* present thread: present / drain now */
+}
+
+void ps3_pacing_note_vblank(void) { InterlockedIncrement64(&s_vblanks); InterlockedIncrement64(&s_flipticks); }
+
+int ps3_pacing_wait_flip_tick(unsigned ms)
+{
+    if (!s_active || !s_flip_tick_ev) return 0;
+    if (s_credit_on && s_flip_credit && InterlockedExchange(&s_flip_credit, 0)) {
+        InterlockedIncrement64(&s_credit_used);
+        cellGcmTickFlip();               /* a banked tick: this (late) flip completes now */
+        return 1;
+    }
+    WaitForSingleObject(s_flip_tick_ev, ms);
+    return 1;
+}
+
+/* ---- the monitor's vblank (IDXGIOutput::WaitForVBlank) ------------------ */
+#if defined(PS3_WASM)
+/* no monitor vblank in a browser worker: unknown refresh, and the display clock reports itself unusable, so the
+ * clock thread falls back to a timer (60 Hz when the refresh is unknown) exactly as on Windows */
+static void open_output(HWND hwnd) { (void)hwnd; }
+static int  display_wait(HWND hwnd) { (void)hwnd; return 0; }
+#else
+static IDXGIOutput* s_out = NULL;
+static HMONITOR     s_out_mon = NULL;
+static LONGLONG     s_out_check = 0;
+static int          s_out_bad = 0;      /* consecutive implausible waits */
+
+static void query_display_hz(HMONITOR m)
+{
+    MONITORINFOEXW mi; memset(&mi, 0, sizeof mi); mi.cbSize = sizeof mi;
+    DEVMODEW dm; memset(&dm, 0, sizeof dm); dm.dmSize = sizeof dm;
+    if (GetMonitorInfoW(m, (MONITORINFO*)&mi) &&
+        EnumDisplaySettingsW(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm) && dm.dmDisplayFrequency > 1) {
+        /* 59/119/143 Hz are the NTSC-style 1000/1001 rates */
+        double hz = (double)dm.dmDisplayFrequency;
+        const DWORD f = dm.dmDisplayFrequency;
+        if (f == 59 || f == 119 || f == 143 || f == 239 || f == 29) hz = (f + 1) * 1000.0 / 1001.0;
+        InterlockedExchange64(&s_display_mhz, (LONG64)(hz * 1000.0 + 0.5));
+    }
+}
+
+static void open_output(HWND hwnd)
+{
+    HMONITOR m = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+    if (s_out && m == s_out_mon) return;
+    if (s_out) { s_out->lpVtbl->Release(s_out); s_out = NULL; }
+    s_out_mon = m;
+    query_display_hz(m);
+    IDXGIFactory1* f = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory1, (void**)&f)) || !f) return;
+    IDXGIAdapter1* a = NULL;
+    for (UINT i = 0; !s_out && f->lpVtbl->EnumAdapters1(f, i, &a) != DXGI_ERROR_NOT_FOUND; i++) {
+        IDXGIOutput* o = NULL;
+        for (UINT j = 0; a->lpVtbl->EnumOutputs(a, j, &o) != DXGI_ERROR_NOT_FOUND; j++) {
+            DXGI_OUTPUT_DESC d;
+            if (SUCCEEDED(o->lpVtbl->GetDesc(o, &d)) && d.Monitor == m) { s_out = o; break; }
+            o->lpVtbl->Release(o);
+        }
+        a->lpVtbl->Release(a);
+    }
+    f->lpVtbl->Release(f);
+    fprintf(stderr, "[pace] display: %s, refresh %.3f Hz (mode)\n",
+            s_out ? "vblank wait on the window's output" : "NO DXGI output for the window's monitor",
+            (double)s_display_mhz / 1000.0);
+}
+
+/* 1 = waited for a vblank; 0 = unusable (caller falls back to a timer). */
+static int display_wait(HWND hwnd)
+{
+    const LONGLONG t0 = qpc();
+    if (!s_out || t0 - s_out_check > s_freq) {           /* window moved? once a second */
+        s_out_check = t0;
+        open_output(hwnd);
+    }
+    if (!s_out) return 0;
+    const HRESULT hr = s_out->lpVtbl->WaitForVBlank(s_out);
+    const LONGLONG t1 = qpc();
+    const double ms = (double)(t1 - t0) * 1000.0 / (double)s_freq;
+    /* A failed or instant return (display off, remote session, mode change):
+     * tolerate a few, then give up on the display clock. */
+    if (FAILED(hr) || ms < 0.5) {
+        if (++s_out_bad > 120) return 0;
+        if (FAILED(hr)) Sleep(1);
+        return 1;   /* still "a tick": keeps the guest moving meanwhile */
+    }
+    s_out_bad = 0;
+    /* period estimate from consecutive waits (ignore stalls) */
+    static LONGLONG last = 0;
+    if (last) {
+        const double dt_ns = (double)(t1 - last) * 1e9 / (double)s_freq;
+        const double cur = (double)s_disp_period_ns;
+        const double nominal = s_display_mhz ? 1e12 / (double)s_display_mhz : 16666666.0;
+        if (dt_ns > nominal * 0.5 && dt_ns < nominal * 1.5) {
+            const double next = cur > 0 ? cur * 0.98 + dt_ns * 0.02 : dt_ns;
+            InterlockedExchange64(&s_disp_period_ns, (LONG64)next);
+        }
+    }
+    last = t1;
+    return 1;
+}
+#endif /* !PS3_WASM */
+
+/* ---- the clock thread ------------------------------------------------------ */
+#if defined(PS3_WASM)
+static volatile int s_sleep_word = 0;    /* nobody wakes it: a timed sleep */
+/* The timed wait's real granularity depends on the host (Chrome ~1-2 ms; node on Windows rounds to the 15.6 ms
+ * system tick), so the early-stop margin adapts: it jumps to the latest overshoot + 0.3 ms when a wait wakes later
+ * than that, decays 2% per wait otherwise, never below PS3_PACE_SPIN_US (default 2 ms here); the rest is spun. */
+static double s_margin_ticks = 0.0;
+/* PS3_PACE_MARGIN_CAP_US (default 2500; 0 = the ratchet below, unchanged): the ratchet learns from EVERY late
+ * wake, and on a busy machine a descheduled wait wakes 10-30 ms late -- the margin then sits near a whole period
+ * and the clock thread spins ~98% of a core (P8Plus browser profile prof5, 2026-10-10), which starves the guest
+ * threads that make the machine busy in the first place. Capped mode: the margin is an average of the ordinary
+ * timer lateness (+0.2 ms), never above the cap; a wake later than the cap is descheduling, not timer granularity,
+ * and is not learned. The spin floor is 0 unless PS3_PACE_SPIN_US is set. A tick is then at most ~cap late,
+ * which neither the guest's vblank-counted timers nor a browser present (rAF-bound) can see. */
+static int s_mcap_us = -1;
+static volatile LONG64 s_spin_ticks = 0;   /* time spent spinning (tests, stats) */
+static double s_mfloor_t = 0.0;
+static void sleep_until_capped(LONGLONG target)
+{
+    const double cap_t = (double)s_freq * (double)s_mcap_us / 1e6;
+    double m = s_margin_ticks;
+    if (m > cap_t) m = cap_t;
+    if (m < s_mfloor_t) m = s_mfloor_t;
+    const LONGLONG now = qpc();
+    if ((double)(target - now) > m) {
+        const double want = (double)(target - now) - m;
+        emscripten_futex_wait((void*)&s_sleep_word, 0, want * 1000.0 / (double)s_freq);
+        const double late = (double)(qpc() - now) - want;
+        if (late <= cap_t) {
+            const double obs = (late > 0.0 ? late : 0.0) + (double)s_freq * 0.0002;
+            s_margin_ticks = s_margin_ticks * 0.9 + obs * 0.1;
+        }
+    }
+    const LONGLONG s0 = qpc(); LONGLONG s1 = s0;
+    while (s1 < target) s1 = qpc();
+    s_spin_ticks += s1 - s0;
+}
+static void sleep_until(HANDLE tmr, LONGLONG target)
+{
+    (void)tmr;
+    if (s_mcap_us < 0) {
+        const char* e = getenv("PS3_PACE_MARGIN_CAP_US");
+        int v = (e && *e) ? atoi(e) : 2500;
+        const char* sp = getenv("PS3_PACE_SPIN_US");
+        s_mfloor_t = (sp && *sp) ? (double)s_freq * (double)s_spin_us / 1e6 : 0.0;
+        s_mcap_us = v > 0 ? v : 0;
+        if (s_mcap_us)
+            fprintf(stderr, "[pace] wasm sleep: capped margin (cap %d us, spin floor %.0f us)\n", s_mcap_us,
+                    s_mfloor_t * 1e6 / (double)s_freq);
+        else
+            fprintf(stderr, "[pace] wasm sleep: ratchet margin (PS3_PACE_MARGIN_CAP_US=0, spin floor %u us)\n",
+                    s_spin_us);
+    }
+    if (s_mcap_us > 0) { sleep_until_capped(target); return; }
+    const double floor_t = (double)s_freq * (double)s_spin_us / 1e6;
+    if (s_margin_ticks < floor_t) s_margin_ticks = floor_t;
+    const LONGLONG now = qpc();
+    if ((double)(target - now) > s_margin_ticks) {
+        const double want = (double)(target - now) - s_margin_ticks;
+        emscripten_futex_wait((void*)&s_sleep_word, 0, want * 1000.0 / (double)s_freq);
+        const double over = (double)(qpc() - now) - want + (double)s_freq * 0.0003;
+        s_margin_ticks = over > s_margin_ticks ? over : s_margin_ticks * 0.98;
+    }
+    const LONGLONG s0 = qpc(); LONGLONG s1 = s0;
+    while (s1 < target) s1 = qpc();
+    s_spin_ticks += s1 - s0;
+}
+#else
+static void sleep_until(HANDLE tmr, LONGLONG target)
+{
+    const LONGLONG spin = (LONGLONG)((double)s_freq * (double)s_spin_us / 1e6);
+    LONGLONG now = qpc();
+    if (target - now > spin) {
+        const LONGLONG wait = target - now - spin;
+        if (tmr) {
+            LARGE_INTEGER due;
+            due.QuadPart = -(LONGLONG)((double)wait * 1e7 / (double)s_freq);   /* 100 ns, relative */
+            if (due.QuadPart < 0 && SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE))
+                WaitForSingleObject(tmr, INFINITE);
+        } else {
+            const DWORD ms = (DWORD)((double)wait * 1000.0 / (double)s_freq);
+            if (ms) Sleep(ms);
+        }
+    }
+    while (qpc() < target) YieldProcessor();
+}
+#endif
+
+/* next deadline after a tick at `now`: one period on; more than 4 periods
+ * behind (stall, debugger) drops the backlog instead of bursting it. */
+static void advance(double* next, double period, LONGLONG now)
+{
+    *next += period;
+    if ((double)now - *next > 4.0 * period) *next = (double)now + period;
+}
+
+/* PS3_PACE_CTL=<file>: live re-configuration for A/B measurements in one
+ * boot. The clock thread re-reads the file when its mtime changes (checked
+ * every ~250 ms); words: vblank=<hz>|display  flip=vblank|<hz>|display|present
+ * vsync=0|1  credit=0|1. Each change bumps the configuration generation (CSV column 3,
+ * "[pace] config N:" line) and restarts the statistics window. */
+
+static void log_config(const char* why)
+{
+    char vb[48], fb[48];
+    if (s_vblank_display) snprintf(vb, sizeof vb, "display");
+    else snprintf(vb, sizeof vb, "%.3f", s_vblank_hz);
+    if (s_flip_mode == PS3_FLIPCLK_TIMER) snprintf(fb, sizeof fb, "%.3f", s_flip_hz);
+    else snprintf(fb, sizeof fb, "%s", s_flip_mode == PS3_FLIPCLK_DISPLAY ? "display" :
+                  s_flip_mode == PS3_FLIPCLK_PRESENT ? "present" : "vblank");
+    fprintf(stderr, "[pace] config %ld (%s): vblank=%s flip=%s vsync=%d credit=%d\n", (long)s_cfg_gen, why, vb, fb,
+            s_vsync, s_credit_on);
+    fflush(stderr);
+}
+
+/* 1 if the control file changed and was applied. */
+#if defined(PS3_WASM)
+static int ctl_poll(void) { return 0; }   /* PS3_PACE_CTL: not in the browser build (s_ctl_path stays NULL) */
+#else
+static int ctl_poll(void)
+{
+    static FILETIME last = {0, 0};
+    WIN32_FILE_ATTRIBUTE_DATA a;
+    if (!s_ctl_path || !GetFileAttributesExA(s_ctl_path, GetFileExInfoStandard, &a)) return 0;
+    if (CompareFileTime(&a.ftLastWriteTime, &last) == 0) return 0;
+    last = a.ftLastWriteTime;
+    char buf[256] = {0};
+    FILE* f = fopen(s_ctl_path, "rb");
+    if (!f) return 0;
+    const size_t n = fread(buf, 1, sizeof buf - 1, f);
+    fclose(f);
+    buf[n] = 0;
+    int changed = 0;
+    for (char* tok = strtok(buf, " \t\r\n"); tok; tok = strtok(NULL, " \t\r\n")) {
+        char* eq = strchr(tok, '=');
+        if (!eq) continue;
+        *eq = 0;
+        const char* k = tok; const char* v = eq + 1;
+        if (!_stricmp(k, "vblank")) {
+            const double r = parse_rate(v);
+            if (r == PS3_PACE_DISPLAY) { s_vblank_display = 1; changed = 1; }
+            else if (r > 0) { s_vblank_display = 0; s_vblank_hz = r; changed = 1; }
+        } else if (!_stricmp(k, "flip")) {
+            const double r = parse_rate(v);
+            if (r == PS3_PACE_DISPLAY)      { s_flip_mode = PS3_FLIPCLK_DISPLAY; changed = 1; }
+            else if (r == PS3_PACE_PRESENT) { s_flip_mode = PS3_FLIPCLK_PRESENT; changed = 1; }
+            else if (r == PS3_PACE_VBLANK)  { s_flip_mode = PS3_FLIPCLK_VBLANK; changed = 1; }
+            else if (r > 0) { s_flip_mode = PS3_FLIPCLK_TIMER; s_flip_hz = r; changed = 1; }
+        } else if (!_stricmp(k, "vsync")) {
+            s_vsync = parse_bool(v, s_vsync); changed = 1;
+        } else if (!_stricmp(k, "credit")) {
+            s_credit_on = parse_bool(v, s_credit_on); changed = 1;
+        }
+    }
+    if (changed) {
+        InterlockedIncrement(&s_cfg_gen);
+        InterlockedExchange(&s_stats_restart, 1);
+        if (!s_vblank_display) cellGcm_set_vblank_hz(s_vblank_hz);
+        log_config("PS3_PACE_CTL");
+    }
+    return changed;
+}
+#endif
+
+static DWORD WINAPI pace_clock_thread(LPVOID arg)
+{
+    HWND hwnd = (HWND)arg;
+    s_sp_hwnd = hwnd;
+#if defined(PS3_WASM)
+    HANDLE tmr = NULL; const int hires = 1;   /* sleep_until: timed futex wait + spin */
+#else
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    HANDLE tmr = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    const int hires = tmr != NULL;
+    if (!tmr) tmr = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+#endif
+    int disp_ok = 1;                      /* 0 after WaitForVBlank proved unusable */
+    double pv = 0.0, pf = 0.0, nv = 0.0, nf = 0.0;
+    int vblank_disp = 0, flip_disp = 0, use_disp = 0, flip_lock = 0, lock_logged = 0;
+    LONGLONG now = qpc(), next_ctl = now, next_lock = now;
+    if (s_vblank_display && s_display_mhz) cellGcm_set_vblank_hz((double)s_display_mhz / 1000.0);
+#if defined(PS3_WASM)
+    (void)hires;
+    fprintf(stderr, "[pace] clock thread up (timed futex wait, spin %u us)\n", s_spin_us);
+#else
+    fprintf(stderr, "[pace] clock thread up (%s waitable timer, spin %u us)\n",
+            hires ? "high-resolution" : "standard", s_spin_us);
+#endif
+    log_config("start");
+    int reconfigure = 1;
+    for (;;) {
+        if (reconfigure) {
+            reconfigure = 0;
+            now = qpc();
+            vblank_disp = s_vblank_display && disp_ok;
+            flip_disp = s_flip_mode == PS3_FLIPCLK_DISPLAY && disp_ok;
+            if (s_vblank_display && !disp_ok) {        /* display clock unusable: its rate on a timer */
+                double hz = (double)s_display_mhz / 1000.0;
+                s_vblank_display = 0; s_vblank_hz = hz >= 20.0 ? hz : 60.0;
+            }
+            if (s_flip_mode == PS3_FLIPCLK_DISPLAY && !disp_ok) {
+                double hz = (double)s_display_mhz / 1000.0;
+                s_flip_mode = PS3_FLIPCLK_TIMER; s_flip_hz = hz >= 20.0 ? hz : 60.0;
+            }
+            flip_lock = 0;
+            if (s_flip_mode == PS3_FLIPCLK_TIMER && disp_ok && s_display_mhz && dlock_on()) {
+                const double dhz = (double)s_display_mhz / 1000.0;
+                flip_lock = fabs(s_flip_hz - dhz) <= 0.005 * dhz;
+            }
+            if (flip_lock) flip_disp = 1;
+            if (flip_lock != lock_logged) {
+                fprintf(stderr, "[pace] flip clock: %.3f Hz %s the display vblank (%.3f Hz mode, PS3_FLIP_DISPLAY_LOCK)\n",
+                        s_flip_hz, flip_lock ? "timer locked to" : "timer, no longer locked to",
+                        (double)s_display_mhz / 1000.0);
+                lock_logged = flip_lock;
+            }
+            use_disp = vblank_disp || flip_disp;
+            if (use_disp) open_output(hwnd);
+            pv = vblank_disp ? 0.0 : (double)s_freq / s_vblank_hz;
+            pf = (s_flip_mode == PS3_FLIPCLK_TIMER && !flip_lock) ? (double)s_freq / s_flip_hz : 0.0;
+            nv = (double)now + pv; nf = (double)now + pf;
+        }
+        if (s_ctl_path && now >= next_ctl) {
+            next_ctl = now + s_freq / 4;
+            if (ctl_poll()) { reconfigure = 1; continue; }
+        }
+        if (s_flip_mode == PS3_FLIPCLK_TIMER && now >= next_lock) {
+            next_lock = now + s_freq / 4;
+            if (dlock_poll()) { reconfigure = 1; continue; }
+        }
+        if (use_disp) {
+            if (!display_wait(hwnd)) {   /* (a locked TIMER flip clock returns to its own timer) */
+                fprintf(stderr, "[pace] display vblank wait unusable -- falling back to a %.3f Hz timer\n",
+                        (double)s_display_mhz / 1000.0);
+                disp_ok = 0; reconfigure = 1;
+                continue;
+            }
+            now = qpc();
+            if (vblank_disp) tick_vblank();
+            else if ((double)now >= nv) { tick_vblank(); advance(&nv, pv, now); }
+            if (flip_disp) {
+                tick_flip();
+                if (flip_lock && s_kick) SetEvent(s_kick);   /* as the timer's flip ticks do */
+            }
+            else if (pf > 0.0 && (double)now >= nf) { tick_flip(); advance(&nf, pf, now); }
+            continue;
+        }
+        double target = nv;
+        if (pf > 0.0 && nf < target) target = nf;
+        if (s_ctl_path && (double)next_ctl < target) target = (double)next_ctl;
+        sleep_until(tmr, (LONGLONG)target);
+        now = qpc();
+        if ((double)now >= nv) { tick_vblank(); advance(&nv, pv, now); }
+        if (pf > 0.0 && (double)now >= nf) {
+            tick_flip();
+            if (s_kick) SetEvent(s_kick);
+            advance(&nf, pf, now);
+        }
+    }
+    return 0;
+}
+
+void ps3_pacing_start(void* hwnd)
+{
+    if (!s_active || InterlockedCompareExchange(&s_started, 1, 0) != 0) return;
+    s_kick = (HANDLE)cellGcm_fifo_kick_event();
+    if (!hwnd && (s_vblank_display || s_flip_mode == PS3_FLIPCLK_DISPLAY)) {
+        fprintf(stderr, "[pace] no window for the display clock -- using 60 Hz timers\n");
+        if (s_vblank_display) { s_vblank_display = 0; s_vblank_hz = 60.0; }
+        if (s_flip_mode == PS3_FLIPCLK_DISPLAY) { s_flip_mode = PS3_FLIPCLK_TIMER; s_flip_hz = 60.0; }
+    }
+#if !defined(PS3_WASM)
+    if (hwnd) query_display_hz(MonitorFromWindow((HWND)hwnd, MONITOR_DEFAULTTONEAREST));
+#endif
+    HANDLE h = CreateThread(NULL, 256 * 1024, pace_clock_thread, hwnd, 0, NULL);
+    if (!h) { fprintf(stderr, "[pace] clock thread could not be created\n"); return; }
+    CloseHandle(h);
+}
+
+/* ---- present pacing (PS3_PRESENT_PACE) ---------------------------------- */
+/* PS3_PRESENT_PACE (default on; =0, or PS3_PRESENT_PACE_OFF_FILE=<path> while it exists, polled at most every 250 ms;
+ * PS3_PRESENT_PACE_SLACK_US, default 300): with a capped flip clock (TIMER, DISPLAY) the presenting thread holds a
+ * guest frame's Present until one flip period, less the slack, after the previous Present -- at most half a period.
+ * The flip clock completes the guest's flips on its ticks, but each frame then reaches Present only once the FIFO
+ * walker and the translation thread have processed its tail, 2-7 ms after the flip request and varying frame to
+ * frame (census18, flip=120: 120.0 presents/s with present intervals p99 10.4-10.8 ms while the flip requests'
+ * intervals are p99 9.4-9.9 ms; a long interval = the present lag grew ~1.5 ms over the previous frame's, corr
+ * 0.6-0.94). Held, the present cadence follows the flip clock: a late frame presents at once (no hold), the frames
+ * after it are held at most the slack per frame until the cadence is recovered, so the long-run present rate is the
+ * flip rate. Only the presenting thread waits. Uncapped clocks (PRESENT, VBLANK) are never held. */
+static int s_ppace = -1, s_ppace_off = 0;
+static const char* s_ppace_file;
+static ULONGLONG s_ppace_chk;
+static double s_ppace_slack_s = 300e-6;
+static LONGLONG s_pp_last = 0;
+static HANDLE s_pp_tmr = NULL;
+static LONG64 s_pp_holds = 0, s_pp_hold_qpc = 0, s_pp_capped = 0;     /* presenting thread only */
+#define PP_WIN_CAP 8192
+static float s_pp_win[PP_WIN_CAP];   /* this stats window: the hold of every paced present in us (0 = not held) */
+static unsigned s_pp_win_n = 0;
+static int present_pace_on(void);
+static int present_pace_live(void) { return present_pace_on(); }
+static int present_pace_on(void)
+{
+    if (s_ppace < 0) {
+        const char* e = getenv("PS3_PRESENT_PACE");
+        s_ppace = !(e && *e == '0');
+        s_ppace_file = getenv("PS3_PRESENT_PACE_OFF_FILE");
+        if (s_ppace_file && !*s_ppace_file) s_ppace_file = NULL;
+        if ((e = getenv("PS3_PRESENT_PACE_SLACK_US")) && *e) s_ppace_slack_s = atof(e) * 1e-6;
+        fprintf(stderr, "[pace] PS3_PRESENT_PACE %s (slack %.0f us)%s\n", s_ppace ? "on" : "off",
+                s_ppace_slack_s * 1e6, s_ppace && s_ppace_file ? " (live off file)" : "");
+    }
+    if (!s_ppace) return 0;
+    if (s_ppace_file) {
+        const ULONGLONG now = GetTickCount64();
+        if (now - s_ppace_chk >= 250) {
+            s_ppace_chk = now;
+            const int off = GetFileAttributesA(s_ppace_file) != INVALID_FILE_ATTRIBUTES;
+            if (off != s_ppace_off)
+                fprintf(stderr, "[pace] PS3_PRESENT_PACE %s\n", off ? "OFF (presents as the frames finish)" : "on");
+            s_ppace_off = off;
+        }
+    }
+    return !s_ppace_off;
+}
+
+void ps3_pacing_present_hold(void)
+{
+    if (!s_active) return;
+    double hz = 0.0;
+    if (s_flip_mode == PS3_FLIPCLK_TIMER) hz = s_flip_hz;
+    else if (s_flip_mode == PS3_FLIPCLK_DISPLAY) hz = ps3_pacing_display_hz();
+    LONGLONG rel = qpc();
+    if (hz >= 20.0 && present_pace_on() && s_pp_last) {
+        const double period = (double)s_freq / hz;
+        const LONGLONG target = s_pp_last + (LONGLONG)(period - s_ppace_slack_s * (double)s_freq);
+        LONGLONG wait = target - rel;
+        if (wait > 0) {
+            const LONGLONG cap = (LONGLONG)(period * 0.5);
+            if (wait > cap) { wait = cap; s_pp_capped++; }
+            if (!s_pp_tmr) {
+                s_pp_tmr = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+                if (!s_pp_tmr) s_pp_tmr = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+            }
+            const LONGLONG t0 = rel;
+            sleep_until(s_pp_tmr, t0 + wait);
+            rel = qpc();
+            s_pp_holds++; s_pp_hold_qpc += rel - t0;
+            if (s_pp_win_n < PP_WIN_CAP) s_pp_win[s_pp_win_n++] = (float)((double)(rel - t0) * 1e6 / (double)s_freq);
+        } else if (s_pp_win_n < PP_WIN_CAP) s_pp_win[s_pp_win_n++] = 0.0f;
+    }
+    s_pp_last = rel;
+}
+
+/* ---- on-screen cadence (PS3_PACE_DXSTATS) --------------------------------- */
+/* PS3_PACE_DXSTATS=1 (with PS3_PACE_STATS; default off). Fed after each Present with the swap chain's
+ * GetFrameStatistics (presenting thread only). Between two samples, `dp` more presents reached the screen over `dr`
+ * refreshes: dr > dp = refreshes that showed an old image again (a repeat: the on-screen hitch that the [pace] frame
+ * times cannot see while Present does not block), dp > dr = presents that were never shown. Samples that advanced by
+ * one present give the displayed frame's time on screen in refreshes (1/2/3+). With a variable refresh rate the
+ * refresh count follows the frames, so the cadence is also measured in time: when the newest displayed present is the
+ * one on screen at the sample's sync refresh (PresentRefreshCount == SyncRefreshCount), SyncQPCTime is the scan-out
+ * of that present; two such samples one present apart give its on-screen interval (ms p50/p99/max). */
+static int s_dxs = -1;
+static int s_ds_have = 0, s_ds_t_ok = 0;
+static unsigned s_ds_pc0 = 0, s_ds_prc0 = 0, s_ds_t_pc = 0;
+static LONGLONG s_ds_t = 0;
+static LONG64 s_ds_shown = 0, s_ds_repeat = 0, s_ds_never = 0, s_ds_bad = 0, s_ds_h[4];
+static LONG64 s_ds_comp[5], s_win_comp0[5];   /* per sample: composed, overlay, independent flip, failure, unknown */
+static LONG64 s_win_ds0[4 + 4];
+#define DS_WIN_CAP 8192
+static float s_ds_win[DS_WIN_CAP];
+static unsigned s_ds_win_n = 0;
+/* PS3_PACE_DXSTATS_OFF_FILE=<path>: no statistics calls while <path> exists (polled at most every 250 ms) -- on/off
+ * A/B of the measurement's own cost. */
+static const char* s_dxs_file = NULL;
+static ULONGLONG s_dxs_chk = 0;
+static int s_dxs_off = 0;
+#define DXC_WIN_CAP 8192
+static float s_dxc_win[DXC_WIN_CAP];
+static unsigned s_dxc_n = 0;
+int ps3_pacing_dxstats_on(void)
+{
+    if (s_dxs < 0) {
+        const char* e = getenv("PS3_PACE_DXSTATS");
+        s_dxs = (s_stats_s > 0.0) && e && *e == '1';   /* default OFF (shipping); PS3_PACE_DXSTATS=1 = on */
+        s_dxs_file = getenv("PS3_PACE_DXSTATS_OFF_FILE");
+        if (s_dxs_file && !*s_dxs_file) s_dxs_file = NULL;
+    }
+    if (s_dxs <= 0) return 0;
+    if (s_dxs_file) {
+        const ULONGLONG now = GetTickCount64();
+        if (now - s_dxs_chk >= 250) {
+            s_dxs_chk = now;
+            const int off = GetFileAttributesA(s_dxs_file) != INVALID_FILE_ATTRIBUTES;
+            if (off != s_dxs_off) fprintf(stderr, "[pace] PS3_PACE_DXSTATS %s\n", off ? "OFF (no statistics calls)" : "on");
+            s_dxs_off = off;
+        }
+    }
+    return !s_dxs_off;
+}
+void ps3_pacing_dxstats_cost(long long t)
+{
+    if (s_dxc_n < DXC_WIN_CAP) s_dxc_win[s_dxc_n++] = (float)((double)t * 1e6 / (double)s_freq);
+}
+/* PS3_PACE_DXCSV=<file> (diagnostic, off): one row per Present -- qpc_ms (after Present), last_present (this
+ * Present's id, GetLastPresentCount), inj (PS3_PACE_INJECT: 1 = this Present was delayed by the injected sleep, 2 = the
+ * previous frame's Present was skipped), ok, present_count, present_refresh, sync_refresh, sync_qpc_ms (the swap
+ * chain's frame statistics after it). Offline, each present id's scan-out time (sync_qpc_ms of a row where
+ * present_count = id and present_refresh = sync_refresh) gives every frame's own on-screen interval, injected ones
+ * tagged. */
+static FILE* s_dxcsv = NULL;
+static int s_dxcsv_init = 0;
+static int s_inj_mark = 0;               /* injector -> the next sample: 1 sleep, 2 after a skip */
+static void dxcsv_row(int ok, unsigned lastpc, unsigned pc, unsigned prc, unsigned src, long long sync_qpc)
+{
+    if (!s_dxcsv_init) {
+        s_dxcsv_init = 1;
+        const char* e = getenv("PS3_PACE_DXCSV");
+        if (e && *e) {
+            s_dxcsv = fopen(e, "wb");
+            if (s_dxcsv) { setvbuf(s_dxcsv, NULL, _IOFBF, 1 << 16);
+                           fprintf(s_dxcsv, "qpc_ms,last_present,inj,ok,present_count,present_refresh,sync_refresh,sync_qpc_ms,cfg\n"); }
+        }
+    }
+    if (!s_dxcsv) return;
+    fprintf(s_dxcsv, "%.3f,%u,%d,%d,%u,%u,%u,%.3f,%ld\n", (double)qpc() * 1000.0 / (double)s_freq, lastpc, s_inj_mark, ok,
+            pc, prc, src, (double)sync_qpc * 1000.0 / (double)s_freq, (long)s_cfg_gen);
+}
+void ps3_pacing_display_sample(int ok, unsigned lastpc, unsigned pc, unsigned prc, unsigned src, long long sync_qpc,
+                               int comp)
+{
+    dxcsv_row(ok, lastpc, pc, prc, src, sync_qpc);
+    if (comp != -2) s_ds_comp[(comp >= 0 && comp <= 3) ? comp : 4]++;
+    s_inj_mark = 0;
+    if (!ok) { s_ds_have = 0; s_ds_t_ok = 0; s_ds_bad++; return; }
+    if (!s_ds_have) { s_ds_pc0 = pc; s_ds_prc0 = prc; s_ds_have = 1; return; }
+    if (pc == s_ds_pc0) return;                       /* nothing new on screen yet */
+    const unsigned dp = pc - s_ds_pc0, dr = prc - s_ds_prc0;
+    s_ds_pc0 = pc; s_ds_prc0 = prc;
+    if (dp > 1000u || dr > 1000u || dr == 0u) { s_ds_bad++; s_ds_t_ok = 0; return; }   /* wrapped / reset statistics */
+    s_ds_shown += dp;
+    if (dr > dp) s_ds_repeat += dr - dp;
+    else if (dp > dr) s_ds_never += dp - dr;
+    if (dp == 1u) s_ds_h[dr >= 3u ? 3 : dr]++;
+    if (prc == src && sync_qpc > 0) {
+        if (s_ds_t_ok && pc - s_ds_t_pc == 1u && s_ds_win_n < DS_WIN_CAP && sync_qpc > s_ds_t)
+            s_ds_win[s_ds_win_n++] = (float)((double)(sync_qpc - s_ds_t) * 1000.0 / (double)s_freq);
+        s_ds_t = sync_qpc; s_ds_t_pc = pc; s_ds_t_ok = 1;
+    } else s_ds_t_ok = 0;
+}
+
+/* ---- test injector (PS3_PACE_INJECT) ---------------------------------------- */
+/* PS3_PACE_INJECT=sleep<ms>:<N>,skip:<M> (off by default; validation of PS3_PACE_DXSTATS only): before the Present of
+ * every N-th guest frame sleep <ms> ms (after the PS3_PRESENT_PACE hold), and drop the Present of every M-th guest
+ * frame altogether (its image never reaches the swap chain; the display shows the previous one a refresh longer).
+ * Counted on the display line (injected sleeps / skips per second). PS3_PACE_INJECT_ON_FILE=<path>: inject only while
+ * <path> exists (polled at most every 250 ms), for one-boot A/B segments. Presenting thread only. */
+static int s_inj = -1;
+static unsigned s_inj_sleep_ms = 0, s_inj_sleep_n = 0, s_inj_skip_m = 0, s_inj_frame = 0;
+static LONG64 s_inj_sleeps = 0, s_inj_skips = 0;
+static HANDLE s_inj_tmr = NULL;
+static const char* s_inj_file = NULL;
+static ULONGLONG s_inj_chk = 0;
+static int s_inj_live = 1;
+static volatile LONG s_inj_last = 0;   /* this frame was sleep-delayed (scanprobe tag) */
+int ps3_pacing_inject_before_present(void)
+{
+    if (s_inj < 0) {
+        s_inj = 0;
+        const char* e = getenv("PS3_PACE_INJECT");
+        if (e && *e) {
+            char buf[128]; snprintf(buf, sizeof buf, "%s", e);
+            for (char* t = strtok(buf, ","); t; t = strtok(NULL, ",")) {
+                unsigned a = 0, n = 0;
+                if (sscanf(t, "sleep%u:%u", &a, &n) == 2 && a && n) { s_inj_sleep_ms = a; s_inj_sleep_n = n; }
+                else if (sscanf(t, "skip:%u", &n) == 1 && n) s_inj_skip_m = n;
+            }
+            s_inj = s_inj_sleep_n || s_inj_skip_m;
+            s_inj_file = getenv("PS3_PACE_INJECT_ON_FILE");
+            if (s_inj_file && !*s_inj_file) s_inj_file = NULL;
+            if (s_inj_file) fprintf(stderr, "[pace] PS3_PACE_INJECT only while %s exists\n", s_inj_file);
+            fprintf(stderr, "[pace] PS3_PACE_INJECT (TEST): sleep %u ms every %u frames, skip the Present every %u "
+                    "frames\n", s_inj_sleep_ms, s_inj_sleep_n, s_inj_skip_m);
+        }
+    }
+    if (!s_inj) return 0;
+    if (s_inj_file) {
+        const ULONGLONG now = GetTickCount64();
+        if (now - s_inj_chk >= 250) {
+            s_inj_chk = now;
+            const int on = GetFileAttributesA(s_inj_file) != INVALID_FILE_ATTRIBUTES;
+            if (on != s_inj_live) fprintf(stderr, "[pace] PS3_PACE_INJECT %s\n", on ? "ON" : "off");
+            s_inj_live = on;
+        }
+        if (!s_inj_live) return 0;
+    }
+    s_inj_frame++;
+    s_inj_last = 0;
+    if (s_inj_skip_m && s_inj_frame % s_inj_skip_m == 0) { s_inj_skips++; s_inj_mark = 2; return 1; }
+    if (s_inj_sleep_n && s_inj_frame % s_inj_sleep_n == 0) {
+        if (!s_inj_tmr) {
+            s_inj_tmr = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+            if (!s_inj_tmr) s_inj_tmr = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+        }
+        sleep_until(s_inj_tmr, qpc() + (LONGLONG)((double)s_freq * s_inj_sleep_ms / 1000.0));
+        s_inj_sleeps++;
+        s_inj_last = 1;
+        if (!s_inj_mark) s_inj_mark = 1;
+    }
+    return 0;
+}
+
+/* ---- scanline regime probe (PS3_PACE_SCANPROBE=1, default off) --------------- */
+/* VRR vs fixed refresh without DXGI frame statistics: a probe thread reads the output's scanline
+ * (D3DKMTGetScanLine, gdi32, read-only) PS3_PACE_SCANPROBE_US (default 1000) us after each guest-frame Present
+ * returns. Under VRR scan-out restarts on the flip, so the line shortly after a present clusters at the top (or in
+ * vblank); under a fixed refresh it is uniform over the frame. Per stats window: histogram in tenths of the visible
+ * height + vblank share, plain presents and PS3_PACE_INJECT sleep-delayed presents separately. */
+#if !defined(PS3_WASM)   /* gdi32 / D3DKMT types: the browser build's probe thread is a stub */
+typedef struct { HDC hDc; UINT hAdapter; LUID AdapterLuid; UINT VidPnSourceId; } sp_open_hdc;
+typedef struct { UINT hAdapter; UINT VidPnSourceId; BOOLEAN InVerticalBlank; UINT ScanLine; } sp_get_scanline;
+typedef LONG (APIENTRY* sp_open_fn)(sp_open_hdc*);
+typedef LONG (APIENTRY* sp_scan_fn)(sp_get_scanline*);
+#endif
+static int s_sp = -1;
+static HANDLE s_sp_ev = NULL;
+static volatile LONGLONG s_sp_t = 0;
+static volatile LONG s_sp_inj = 0;
+static volatile LONG s_sp_h[2][12];          /* [plain/injected][0..9 tenths, 10 vblank, 11 errors] */
+static LONG s_sp_h0[2][12];
+static DWORD WINAPI scanprobe_thread(LPVOID arg)
+{
+    (void)arg;
+#if defined(PS3_WASM)
+    fprintf(stderr, "[pace] scanprobe: no display scanline in a browser -- off" "\n");   /* no gdi32 / D3DKMT */
+    return 0;
+#else
+    HMODULE g32 = GetModuleHandleA("gdi32.dll");
+    if (!g32) g32 = LoadLibraryA("gdi32.dll");
+    sp_open_fn op = g32 ? (sp_open_fn)(void*)GetProcAddress(g32, "D3DKMTOpenAdapterFromHdc") : NULL;
+    sp_scan_fn sc = g32 ? (sp_scan_fn)(void*)GetProcAddress(g32, "D3DKMTGetScanLine") : NULL;
+    if (!op || !sc) { fprintf(stderr, "[pace] scanprobe: D3DKMT entry points missing -- off" "\n"); return 0; }
+    MONITORINFOEXA mi; memset(&mi, 0, sizeof mi); mi.cbSize = sizeof mi;
+    HMONITOR m = MonitorFromWindow(s_sp_hwnd, MONITOR_DEFAULTTONEAREST);
+    if (!GetMonitorInfoA(m, (MONITORINFO*)&mi)) { fprintf(stderr, "[pace] scanprobe: no monitor info -- off" "\n"); return 0; }
+    HDC dc = CreateDCA(NULL, mi.szDevice, NULL, NULL);
+    sp_open_hdc oa; memset(&oa, 0, sizeof oa); oa.hDc = dc;
+    const LONG os = dc ? op(&oa) : -1;
+    if (dc) DeleteDC(dc);
+    if (os != 0) { fprintf(stderr, "[pace] scanprobe: D3DKMTOpenAdapterFromHdc failed 0x%08lX -- off" "\n", (unsigned long)os); return 0; }
+    const int vis = mi.rcMonitor.bottom - mi.rcMonitor.top;
+    const char* e = getenv("PS3_PACE_SCANPROBE_US");
+    const double delay_us = (e && *e) ? atof(e) : 1000.0;
+    fprintf(stderr, "[pace] scanprobe on: %s, %d visible lines, sample %.0f us after each Present" "\n", mi.szDevice, vis, delay_us);
+    for (;;) {
+        WaitForSingleObject(s_sp_ev, INFINITE);
+        const LONGLONG t = s_sp_t; const int inj = s_sp_inj ? 1 : 0;
+        const LONGLONG due = t + (LONGLONG)(delay_us * (double)s_freq / 1e6);
+        while (qpc() < due) { if (due - qpc() > s_freq / 2000) Sleep(0); else YieldProcessor(); }
+        sp_get_scanline gs; memset(&gs, 0, sizeof gs); gs.hAdapter = oa.hAdapter; gs.VidPnSourceId = oa.VidPnSourceId;
+        int bin;
+        if (sc(&gs) != 0) bin = 11;
+        else if (gs.InVerticalBlank) bin = 10;
+        else { bin = vis > 0 ? (int)((long long)gs.ScanLine * 10 / vis) : 0; if (bin > 9) bin = 9; if (bin < 0) bin = 0; }
+        InterlockedIncrement(&s_sp_h[inj][bin]);
+    }
+#endif
+}
+static void scanprobe_kick(void)
+{
+    if (s_sp < 0) {
+        const char* e = getenv("PS3_PACE_SCANPROBE");
+        s_sp = (e && *e == '1' && s_sp_hwnd) ? 1 : 0;
+        if (s_sp) {
+            s_sp_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+            HANDLE h = CreateThread(NULL, 64 * 1024, scanprobe_thread, NULL, 0, NULL);
+            if (h) CloseHandle(h); else s_sp = 0;
+        }
+    }
+    if (s_sp <= 0) return;
+    s_sp_t = qpc();
+    s_sp_inj = s_inj_last;
+    SetEvent(s_sp_ev);
+}
+static void scanprobe_report(long gen)
+{
+    if (s_sp <= 0) return;
+    for (int k = 0; k < 2; k++) {
+        LONG d[12], n = 0;
+        for (int i = 0; i < 12; i++) { d[i] = s_sp_h[k][i] - s_sp_h0[k][i]; s_sp_h0[k][i] = s_sp_h[k][i]; n += d[i]; }
+        if (!n) continue;
+        fprintf(stderr, "[pace] cfg %ld scanprobe %s n %ld: vblank %.0f%% tenths", gen,
+                k ? "injected" : "plain", (long)n, 100.0 * d[10] / n);
+        for (int i = 0; i < 10; i++) fprintf(stderr, " %.0f", 100.0 * d[i] / n);
+        fprintf(stderr, " %%%s" "\n", d[11] ? " (read errors)" : "");
+    }
+}
+
+/* ---- statistics ------------------------------------------------------------ */
+#define PACE_WIN_CAP 8192
+static float    s_win_dt[PACE_WIN_CAP];
+static unsigned s_win_n = 0, s_win_lost = 0;
+static LONGLONG s_win_t0 = 0, s_last_present = 0, s_first_present = 0;
+static LONG64   s_win_vb0 = 0, s_win_fl0 = 0, s_win_cr0 = 0;
+static unsigned s_win_flips0 = 0;
+static LONG     s_win_gen = 0;   /* the config generation of the window being collected (a window closed by a
+                                   * PS3_PACE_CTL change is reported under its own generation, not the new one) */
+
+static int cmp_desc(const void* a, const void* b)
+{
+    const float x = *(const float*)a, y = *(const float*)b;
+    return (x < y) - (x > y);
+}
+
+static void stats_report(LONGLONG now)
+{
+    const double secs = (double)(now - s_win_t0) / (double)s_freq;
+    const LONG64 vb = s_vblanks, fl = s_flipticks;
+    const unsigned flips = cellGcm_flip_request_count();
+    static float sorted[PACE_WIN_CAP];
+    const unsigned n = s_win_n;
+    double sum = 0.0;
+    for (unsigned i = 0; i < n; i++) { sorted[i] = s_win_dt[i]; sum += s_win_dt[i]; }
+    qsort(sorted, n, sizeof sorted[0], cmp_desc);              /* worst first */
+    const double avg = n ? sum / n : 0.0;
+    const double p50 = n ? sorted[n / 2] : 0.0;
+    const double p99 = n ? sorted[n / 100] : 0.0;
+    const unsigned k1 = n >= 100 ? n / 100 : 1, k01 = n >= 1000 ? n / 1000 : 1;
+    double w1 = 0.0, w01 = 0.0;
+    for (unsigned i = 0; i < k1 && i < n; i++) w1 += sorted[i];
+    for (unsigned i = 0; i < k01 && i < n; i++) w01 += sorted[i];
+    const double low1 = (n && w1 > 0) ? 1000.0 / (w1 / (k1 < n ? k1 : n)) : 0.0;
+    const double low01 = (n && w01 > 0) ? 1000.0 / (w01 / (k01 < n ? k01 : n)) : 0.0;
+    fprintf(stderr, "[pace] cfg %ld %.1fs presents %.1f/s  frame ms avg %.2f p50 %.2f p99 %.2f max %.2f  "
+            "lows 1%% %.1f 0.1%% %.1f fps  guest flips %.1f/s  vblank %.1f/s  flip ticks %.1f/s  "
+            "late flips %.1f/s  display %.2f Hz%s\n",
+            (long)s_win_gen, secs, n / (secs > 0 ? secs : 1), avg, p50, p99, n ? sorted[0] : 0.0, low1, low01,
+            (double)(flips - s_win_flips0) / secs, (double)(vb - s_win_vb0) / secs,
+            (double)(fl - s_win_fl0) / secs, (double)(s_credit_used - s_win_cr0) / secs, ps3_pacing_display_hz(),
+            s_win_lost ? " (window full: samples dropped)" : "");
+    { extern long cellGcm_waitflip_race_count(void);
+      const LONG64 pl = s_present_lost, pb = s_present_banked;
+      fprintf(stderr, "[pace] cfg %ld present ticks lost %.1f/s, present credits banked %.1f/s, flip credits used %.1f/s, "
+              "SetWaitFlip returns >1 flip ahead of the walker (race) %ld total\n", (long)s_win_gen,
+              (double)(pl - s_win_pl0) / secs, (double)(pb - s_win_pb0) / secs,
+              (double)(s_credit_used - s_win_cr0) / secs, cellGcm_waitflip_race_count());
+      s_win_pl0 = pl; s_win_pb0 = pb; }
+    if (s_ppace > 0 || s_pp_holds) {
+        /* the latency the hold adds, over every paced present (an unheld one = 0): mean, p99, max */
+        static LONG64 h0, q0, c0;
+        static float srt[PP_WIN_CAP];
+        const LONG64 h = s_pp_holds - h0;
+        const unsigned m = s_pp_win_n;
+        double tot = 0.0;
+        for (unsigned i = 0; i < m; i++) { srt[i] = s_pp_win[i]; tot += s_pp_win[i]; }
+        qsort(srt, m, sizeof srt[0], cmp_desc);
+        fprintf(stderr, "[pace] cfg %ld present pace: held %.1f/s (avg %.0f us when held), added latency per paced "
+                "present avg %.0f p99 %.0f max %.0f us (n %u), capped %.1f/s\n", (long)s_win_gen,
+                (double)h / secs, h ? (double)(s_pp_hold_qpc - q0) * 1e6 / (double)s_freq / (double)h : 0.0,
+                m ? tot / m : 0.0, m ? (double)srt[m / 100] : 0.0, m ? (double)srt[0] : 0.0, m,
+                (double)(s_pp_capped - c0) / secs);
+        h0 = s_pp_holds; q0 = s_pp_hold_qpc; c0 = s_pp_capped;
+        s_pp_win_n = 0;
+    }
+    if (s_dxs > 0) {
+        static LONG64 is0, ik0;
+        static float srt[DS_WIN_CAP];
+        const LONG64 sh = s_ds_shown - s_win_ds0[0], rp = s_ds_repeat - s_win_ds0[1], nv = s_ds_never - s_win_ds0[2];
+        const LONG64 h1 = s_ds_h[1] - s_win_ds0[4], h2 = s_ds_h[2] - s_win_ds0[5], h3 = s_ds_h[3] - s_win_ds0[6];
+        const double hn = (double)(h1 + h2 + h3);
+        const unsigned m = s_ds_win_n;
+        for (unsigned i = 0; i < m; i++) srt[i] = s_ds_win[i];
+        qsort(srt, m, sizeof srt[0], cmp_desc);
+        fprintf(stderr, "[pace] cfg %ld display: shown %.1f/s, repeated refreshes %.2f/s, never shown %.2f/s, "
+                "frames on screen 1/2/3+ refreshes %.2f/%.2f/%.2f %%, on-screen ms p50 %.2f p99 %.2f max %.2f (n %u)"
+                "%s", (long)s_win_gen,
+                (double)sh / secs, (double)rp / secs, (double)nv / secs,
+                hn > 0 ? 100.0 * h1 / hn : 0.0, hn > 0 ? 100.0 * h2 / hn : 0.0, hn > 0 ? 100.0 * h3 / hn : 0.0,
+                m ? (double)srt[m / 2] : 0.0, m ? (double)srt[m / 100] : 0.0, m ? (double)srt[0] : 0.0, m,
+                s_ds_bad != s_win_ds0[3] ? " (statistics resets)" : "");
+        if (s_inj > 0) fprintf(stderr, ", injected sleeps %.2f/s skips %.2f/s", (double)(s_inj_sleeps - is0) / secs,
+                               (double)(s_inj_skips - ik0) / secs);
+        {   /* how DWM presented the frames: composed (no tearing possible), overlay (MPO), independent flip */
+            LONG64 c[5], cn = 0;
+            for (int i = 0; i < 5; i++) { c[i] = s_ds_comp[i] - s_win_comp0[i]; cn += c[i]; s_win_comp0[i] = s_ds_comp[i]; }
+            if (cn) fprintf(stderr, ", presentation composed/overlay/independent/failed/unknown %.0f/%.0f/%.0f/%.0f/%.0f %%",
+                            100.0 * c[0] / cn, 100.0 * c[1] / cn, 100.0 * c[2] / cn, 100.0 * c[3] / cn, 100.0 * c[4] / cn);
+            /* mostly composed: say why (read-only window / swap chain / output / topmost-window check) -- once each time
+             * a stats window turns mostly-composed after not being so (steady state: never; no per-frame work) */
+            static int was_composed = 0;
+            const int composed = cn && c[0] * 2 > cn;
+            if (composed && !was_composed) {
+                extern void rsx_live_draw_log_present_env(const char* why);
+                fprintf(stderr, "\n");
+                rsx_live_draw_log_present_env("frames composed by DWM");
+            }
+            if (cn) was_composed = composed;
+        }
+        {   /* the statistics calls' own cost per present (us): mean / p99 / max */
+            static float srt2[DXC_WIN_CAP];
+            const unsigned m2 = s_dxc_n;
+            double t2 = 0.0;
+            for (unsigned i = 0; i < m2; i++) { srt2[i] = s_dxc_win[i]; t2 += s_dxc_win[i]; }
+            qsort(srt2, m2, sizeof srt2[0], cmp_desc);
+            if (m2) fprintf(stderr, ", stats call us avg %.1f p99 %.1f max %.1f (n %u)", t2 / m2, (double)srt2[m2 / 100],
+                            (double)srt2[0], m2);
+            else if (s_dxs_off) fprintf(stderr, ", stats calls OFF");
+            s_dxc_n = 0;
+        }
+        fprintf(stderr, "\n");
+        is0 = s_inj_sleeps; ik0 = s_inj_skips;
+        scanprobe_report((long)s_win_gen);
+        s_win_ds0[0] = s_ds_shown; s_win_ds0[1] = s_ds_repeat; s_win_ds0[2] = s_ds_never; s_win_ds0[3] = s_ds_bad;
+        s_win_ds0[4] = s_ds_h[1]; s_win_ds0[5] = s_ds_h[2]; s_win_ds0[6] = s_ds_h[3];
+        s_ds_win_n = 0;
+    }
+    fflush(stderr);
+    if (s_csv) fflush(s_csv);
+    if (s_dxcsv) fflush(s_dxcsv);
+    s_win_n = 0; s_win_lost = 0; s_win_t0 = now; s_win_gen = s_cfg_gen;
+    s_win_vb0 = vb; s_win_fl0 = fl; s_win_flips0 = flips; s_win_cr0 = s_credit_used;
+}
+
+void ps3_pacing_on_present(void)
+{
+    scanprobe_kick();   /* PS3_PACE_SCANPROBE=1 only */
+    if (s_active && s_flip_mode == PS3_FLIPCLK_PRESENT) {
+        InterlockedIncrement64(&s_flipticks);
+        /* = cellGcmTickFlip(), which completes a flip only if one is WAITING */
+        if (cellGcm_tick_flip_if_waiting()) {
+            if (present_credit_on()) InterlockedExchange(&s_flip_credit, 0);
+        } else {
+            InterlockedIncrement64(&s_present_lost);
+            if (present_credit_on()) { InterlockedExchange(&s_flip_credit, 1); InterlockedIncrement64(&s_present_banked); }
+        }
+        if (s_flip_tick_ev) SetEvent(s_flip_tick_ev);
+    }
+    if (s_stats_s <= 0.0 && !s_csv) return;
+    if (!s_freq) { LARGE_INTEGER f; QueryPerformanceFrequency(&f); s_freq = f.QuadPart; }
+    const LONGLONG now = qpc();
+    if (s_last_present) {
+        const float dt = (float)((double)(now - s_last_present) * 1000.0 / (double)s_freq);
+        if (s_win_n < PACE_WIN_CAP) s_win_dt[s_win_n++] = dt; else s_win_lost++;
+        if (s_csv) fprintf(s_csv, "%.3f,%.3f,%ld\n",
+                           (double)(now - s_first_present) * 1000.0 / (double)s_freq, dt, (long)s_cfg_gen);
+    } else {
+        s_first_present = now;
+        s_win_t0 = now; s_win_gen = s_cfg_gen; s_win_vb0 = s_vblanks; s_win_fl0 = s_flipticks;
+        s_win_flips0 = cellGcm_flip_request_count();
+        if (s_csv) fprintf(s_csv, "0.000,0.000,%ld\n", (long)s_cfg_gen);
+    }
+    s_last_present = now;
+    if (s_stats_restart && InterlockedExchange(&s_stats_restart, 0)) {
+        /* a PS3_PACE_CTL change: report what ran before it, start a clean window */
+        if (s_stats_s > 0.0 && s_win_n >= 30) stats_report(now);
+        else { s_win_n = 0; s_win_lost = 0; s_win_t0 = now; s_win_gen = s_cfg_gen; s_win_vb0 = s_vblanks; s_win_fl0 = s_flipticks;
+               s_win_flips0 = cellGcm_flip_request_count(); }
+        return;
+    }
+    if (s_stats_s > 0.0 && (double)(now - s_win_t0) >= s_stats_s * (double)s_freq) stats_report(now);
+}
+
+#endif /* _WIN32 */
diff --git a/libs/video/host_pacing.h b/libs/video/host_pacing.h
new file mode 100644
index 00000000..335fddfd
--- /dev/null
+++ b/libs/video/host_pacing.h
@@ -0,0 +1,127 @@
+/*
+ * ps3recomp - host frame pacing: the guest vblank clock, the flip-completion
+ * clock, the swap chain's present mode and frame-time statistics.
+ *
+ * The boot harness (runtime/ppu/tests/boot_main.cpp) used to synthesize the
+ * RSX vblank inside its present/FIFO thread from GetTickCount64 in 16 ms steps
+ * (62.5 Hz), completing a pending flip on every tick. That path is unchanged
+ * and still the default. Setting any of the variables below, or a plugin
+ * calling ps3mod_host::set_pacing, selects the decoupled path instead:
+ *
+ *   PS3_VBLANK_HZ=<hz>|display     guest vblank rate. A number (59.94, 60, 120,
+ *                                  144 ...) runs a QPC + high-resolution
+ *                                  waitable timer clock on its own thread;
+ *                                  "display" ticks on the monitor's own vblank
+ *                                  (IDXGIOutput::WaitForVBlank on the window's
+ *                                  output). Default with the decoupled path: 60.
+ *   PS3_FLIP_HZ=vblank|<hz>|display|present
+ *                                  when a requested flip completes (status DONE,
+ *                                  flip handler). vblank (default) = on every
+ *                                  guest vblank, as before; <hz> = its own
+ *                                  timer, independent of the guest vblank;
+ *                                  display = on the monitor's vblank; present =
+ *                                  as soon as the host presented that frame
+ *                                  (plus every vblank as a liveness floor).
+ *   PS3_VSYNC=1|0                  1 (default) = Present(1, 0); 0 = Present(0)
+ *                                  with DXGI_PRESENT_ALLOW_TEARING when the
+ *                                  system supports it (VRR / uncapped).
+ *   PS3_FRAME_LATENCY=<1..3>       frames the swap chain may queue; the present
+ *                                  thread waits on the frame-latency waitable
+ *                                  object instead of blocking inside Present.
+ *   PS3_PACE_STATS=<seconds>       "[pace]" line every N s: presents/s, frame
+ *                                  time avg/p50/p99/max, 1% and 0.1% lows,
+ *                                  guest vblanks/s, flip-clock ticks/s, flips/s.
+ *                                  Works on the legacy path too.
+ *   PS3_PACE_CSV=<path>            one line per presented guest frame
+ *                                  (t_ms,dt_ms) for frame-time graphs.
+ *
+ * Environment values win over a plugin's request (a player or a test can
+ * always override the mod). The game decides the frame rate: THP8's render
+ * thread presents at most once per `render lock` vblanks and waits for its
+ * previous flip, so lock 1 + PS3_VBLANK_HZ=120 = 120 fps, and lock 0 +
+ * PS3_FLIP_HZ=120 = 120 fps with a 60 Hz guest vblank.
+ */
+#ifndef PS3RECOMP_HOST_PACING_H
+#define PS3RECOMP_HOST_PACING_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Flip-completion clock. */
+enum {
+    PS3_FLIPCLK_VBLANK  = 0,   /* every guest vblank (legacy semantics) */
+    PS3_FLIPCLK_TIMER   = 1,   /* own timer at flip_hz */
+    PS3_FLIPCLK_DISPLAY = 2,   /* the monitor's vblank */
+    PS3_FLIPCLK_PRESENT = 3    /* right after the host presented the frame */
+};
+
+/* Special values for ps3_pacing_req.vblank_hz / flip_hz. */
+#define PS3_PACE_KEEP     0.0    /* leave the host's setting */
+#define PS3_PACE_DISPLAY (-1.0)  /* the monitor's refresh / vblank */
+#define PS3_PACE_PRESENT (-2.0)  /* flip_hz only: complete on present */
+#define PS3_PACE_VBLANK  (-3.0)  /* flip_hz only: complete on each guest vblank */
+
+typedef struct ps3_pacing_req {
+    double      vblank_hz;     /* PS3_PACE_KEEP, PS3_PACE_DISPLAY or a rate in Hz */
+    double      flip_hz;       /* PS3_PACE_KEEP/DISPLAY/PRESENT/VBLANK or a rate */
+    int         vsync;         /* -1 = keep, 1 = sync interval 1, 0 = tearing allowed */
+    int         max_latency;   /* 0 = keep, 1..3 */
+    const char* who;           /* for the log line */
+} ps3_pacing_req;
+
+/* A request (plugin / title) made before ps3_pacing_init. Fields set to
+ * "keep" do not touch the current value; later requests override earlier
+ * ones; environment variables always win. Returns 0, -1 after init. */
+int    ps3_pacing_request(const ps3_pacing_req* req);
+
+/* Resolve env + requests (once). Returns 1 when the decoupled clock path is
+ * selected, 0 for the legacy 16 ms ticker. */
+int    ps3_pacing_init(void);
+int    ps3_pacing_active(void);
+
+/* Present configuration for the swap chain (after init). */
+int    ps3_pacing_vsync(void);          /* 1 = Present(1, 0), 0 = Present(0, tearing) */
+int    ps3_pacing_max_latency(void);    /* 0 = DXGI default */
+
+/* Decoupled path: start the clock thread once the window exists. */
+void   ps3_pacing_start(void* hwnd);
+
+/* Counters / rates (any thread). */
+unsigned long long ps3_pacing_vblanks(void);
+double ps3_pacing_vblank_hz(void);      /* configured (or measured, display mode) guest vblank rate */
+double ps3_pacing_display_hz(void);     /* monitor refresh rate, 0 = unknown */
+int    ps3_pacing_flip_mode(void);      /* PS3_FLIPCLK_* */
+
+/* Present thread: after each presented guest frame / each legacy vblank tick. */
+void   ps3_pacing_on_present(void);
+void   ps3_pacing_note_vblank(void);
+
+/* cellGcmSetWaitFlip (pump mode): wait up to `ms` for the next flip tick
+ * instead of a blind Sleep. Returns 1 if the decoupled path handled the wait. */
+int    ps3_pacing_wait_flip_tick(unsigned ms);
+
+/* Presenting thread, right before the swap-chain Present of a guest frame (PS3_PRESENT_PACE): in a capped flip clock
+ * (TIMER / DISPLAY) hold the Present until one flip period (less a small slack) after the previous one, so the
+ * present cadence follows the flip clock instead of the per-frame translation time. */
+void   ps3_pacing_present_hold(void);
+/* Presenting thread, after a successful Present (PS3_PACE_DXSTATS): the swap chain's frame statistics
+ * (IDXGISwapChain::GetFrameStatistics PresentCount / PresentRefreshCount / SyncRefreshCount / SyncQPCTime; ok = 0
+ * when the call failed or was disjoint) -> the on-screen cadence on the [pace] stats line: refreshes that repeated an
+ * old image, presents never shown, displayed-frame intervals in refreshes and in ms. last_present = this Present's
+ * id (GetLastPresentCount, 0 = unknown) for the PS3_PACE_DXCSV per-present rows. */
+int    ps3_pacing_dxstats_on(void);
+void   ps3_pacing_dxstats_cost(long long qpc_ticks);   /* the statistics calls' cost per present (QPC ticks) */
+void   ps3_pacing_display_sample(int ok, unsigned last_present, unsigned present_count, unsigned present_refresh,
+                                 unsigned sync_refresh, long long sync_qpc, int composition);
+/* composition: IDXGISwapChainMedia::GetFrameStatisticsMedia CompositionMode (0 composed by DWM, 1 overlay, 2 none =
