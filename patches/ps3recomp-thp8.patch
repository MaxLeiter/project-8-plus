+static void L_bind(wgs_list* l, int cs)
+{
+    wgs_rootsig* rs = l->rs[cs];
+    if (!rs) return;
+    u32 tmp[2048]; u32 n = 0, k = 1;                  /* tmp[0] = entry count */
+#define PUT(x) do { if (k < 2048) tmp[k++] = (u32)(x); } while (0)
+    for (u32 i = 0; i < rs->nparams; i++) {
+        const wgs_param* p = &rs->params[i];
+        const u64 a = l->arg[cs][i];
+        switch (p->type) {
+        case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+            for (u32 r = 0; r < p->nranges; r++) {
+                const wgs_range* g = &p->ranges[r];
+                const u32 cnt = g->count == 0xFFFFFFFFu ? 64u : g->count;
+                const u32 cls = g->type == D3D12_DESCRIPTOR_RANGE_TYPE_SRV ? 't' : g->type == D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER ? 's'
+                              : g->type == D3D12_DESCRIPTOR_RANGE_TYPE_CBV ? 'b' : 'u';
+                for (u32 j = 0; j < cnt; j++) {
+                    const u32 binding = bind_num(cls, g->base + j, p->vis);
+                    const wgs_desc* s = a ? gpu_slot(a + (u64)(g->offset + j) * sizeof(wgs_desc)) : NULL;
+                    n++;
+                    if (!s || !s->kind || s->kind == WGS_B_NULL || s->kind >= WGS_D_RTV) {
+                        PUT(WGS_B_NULL); PUT(binding);
+                        PUT(cls == 't' ? WGS_B_TEXTURE : cls == 's' ? WGS_B_SAMPLER : cls == 'b' ? WGS_B_UNIFORM : WGS_B_STORAGE_TEX);
+                        continue;
+                    }
+                    PUT(s->kind); PUT(binding);
+                    switch (s->kind) {
+                    case WGS_B_TEXTURE: for (int q = 0; q < 8; q++) PUT(s->w[q]); break;
+                    case WGS_B_SAMPLER: for (int q = 0; q < 13; q++) PUT(s->w[q]); break;
+                    case WGS_B_UNIFORM: case WGS_B_STORAGE: case WGS_B_STORAGE_RW:
+                        PUT(s->w[0]); PUT(s->w[1]); PUT(s->w[2]);
+                        L_track_upload(l, s->w[0], s->w[1], (u64)s->w[1] + s->w[2]);
+                        break;
+                    case WGS_B_STORAGE_TEX: PUT(s->w[0]); PUT(s->w[1]); PUT(s->w[2]); break;
+                    }
+                }
+            }
+            break;
+        case D3D12_ROOT_PARAMETER_TYPE_CBV: {
+            n++; PUT(a ? WGS_B_UNIFORM : WGS_B_NULL); PUT(bind_num('b', p->reg, p->vis));
+            if (!a) { PUT(WGS_B_UNIFORM); break; }
+            wgs_resource* r = mappable_of(va_id(a));
+            const u32 size = 65536;                         /* the worker clamps to the shader's cbuffer size */
+            PUT(va_id(a)); PUT(va_off(a)); PUT(size);
+            if (r) L_track_upload(l, va_id(a), va_off(a), (u64)va_off(a) + size);
+            break;
+        }
+        case D3D12_ROOT_PARAMETER_TYPE_SRV: case D3D12_ROOT_PARAMETER_TYPE_UAV: {
+            const u32 kind = p->type == D3D12_ROOT_PARAMETER_TYPE_SRV ? WGS_B_STORAGE : WGS_B_STORAGE_RW;
+            n++; PUT(a ? kind : WGS_B_NULL); PUT(bind_num(p->type == D3D12_ROOT_PARAMETER_TYPE_SRV ? 't' : 'u', p->reg, p->vis));
+            if (!a) { PUT(kind); break; }
+            wgs_resource* r = mappable_of(va_id(a));
+            const u32 size = 0xFFFFFFFFu;                   /* to the end of the buffer */
+            PUT(va_id(a)); PUT(va_off(a)); PUT(size);
+            if (r) L_track_upload(l, va_id(a), va_off(a), r->size);
+            break;
+        }
+        case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS: {
+            const u32 off = cpool_put(l->cst[cs][i], p->num ? p->num : 1);
+            n++; PUT(WGS_B_UNIFORM); PUT(bind_num('b', p->reg, p->vis)); PUT(s_cpool->id); PUT(off); PUT(((p->num * 4) + 15) & ~15u);
+            break;
+        }
+        }
+    }
+#undef PUT
+    tmp[0] = n;
+    u32* c = L_cmd(l, cs ? WGS_L_COMPUTE_BIND : WGS_L_BIND, k);
+    memcpy(c, tmp, k * 4);
+    l->dirty[cs] = 0;
+}
