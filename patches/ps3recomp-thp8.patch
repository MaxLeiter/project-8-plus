+bool env_off(const char* v)
+{
+    if (!v) return false;
+    return !*v || !strcmp(v, "0") || !_stricmp(v, "off") || !_stricmp(v, "no") ||
+           !_stricmp(v, "false") || !_stricmp(v, "none");
+}
+
+bool ieq(const std::string& a, const char* b)
+{
+    return _stricmp(a.c_str(), b) == 0;
+}
+
+/* Env / key normalisation: ASCII upper case, anything not [A-Z0-9] -> '_'. */
+std::string env_norm(const char* s)
+{
+    std::string o;
+    for (; s && *s; s++) {
+        char c = *s;
+        if (c >= 'a' && c <= 'z') c = (char)(c - 32);
+        o += ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) ? c : '_';
+    }
+    return o;
+}
+
+std::string trim(const std::string& s)
+{
+    size_t a = 0, b = s.size();
+    while (a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r' || s[a] == '\n')) a++;
+    while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '\n')) b--;
+    return s.substr(a, b - a);
+}
+
+std::string strf(const char* fmt, ...)
+{
+    char buf[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof buf, fmt, ap);
+    va_end(ap);
+    return buf;
+}
