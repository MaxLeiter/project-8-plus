+    if (res_of(dst)->desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) L_track_readback(l, res_of(dst)->id, 0, res_of(dst)->size);
+}
+static void STDMETHODCALLTYPE cl_copy_texture(ID3D12GraphicsCommandList* t, const D3D12_TEXTURE_COPY_LOCATION* dst, UINT dx, UINT dy, UINT dz,
