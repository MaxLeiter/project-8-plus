+#ifdef _WIN32
+std::string utf8(const wchar_t* w)
+{
+    if (!w || !*w) return std::string();
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, nullptr, 0, nullptr, nullptr);
+    if (n <= 1) return std::string();
+    std::string s((size_t)n - 1, '\0');
+    WideCharToMultiByte(CP_UTF8, 0, w, -1, &s[0], n, nullptr, nullptr);
+    return s;
+}
+#endif
+
+/* ======================================================================== */
+/* The running image: PPU hash, lift id, function_table index                */
+
+char     s_ppu_hash[48] = "";   /* "PPU-<40 hex>", "" if it could not be computed */
+char     s_lift_id[64]  = "";
+bool     s_index_built  = false;
+std::vector<uint32_t> s_by_addr;     /* function_table indices sorted by address */
+std::vector<uint8_t>  s_is_stub;     /* per index: 1 = HLE import stub (unguarded) */
+uint32_t s_code_lo = 0, s_code_hi = 0;   /* [lowest entry, highest entry + 4) */
+
+uint16_t rd16(const uint8_t* p) { return (uint16_t)((p[0] << 8) | p[1]); }
+uint32_t rd32(const uint8_t* p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+uint64_t rd64(const uint8_t* p) { return ((uint64_t)rd32(p) << 32) | rd32(p + 4); }
+
+/* RPCS3 PPU executable hash of the ELF file (see the file comment). */
+bool compute_ppu_hash(const char* path, char out[48])
+{
+    out[0] = 0;
+    if (!path) return false;
+    FILE* f = fopen(path, "rb");
+    if (!f) return false;
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (sz < 64) { fclose(f); return false; }
+    uint8_t* d = (uint8_t*)malloc((size_t)sz);
+    if (!d || fread(d, 1, (size_t)sz, f) != (size_t)sz) { fclose(f); free(d); return false; }
+    fclose(f);
+    const uint64_t fsz = (uint64_t)sz;
+    bool ok = memcmp(d, "\x7F" "ELF", 4) == 0 && d[4] == 2 /*ELF64*/ && d[5] == 2 /*MSB*/;
+    if (ok) {
+        const uint64_t phoff     = rd64(d + 0x20);
+        const uint16_t phentsize = rd16(d + 0x36);
+        const uint16_t phnum     = rd16(d + 0x38);
+        ps3_sha1_ctx sha;
+        ps3_sha1_init(&sha);
+        for (uint16_t i = 0; ok && i < phnum; i++) {
+            const uint64_t o = phoff + (uint64_t)i * phentsize;
+            if (phentsize < 56 || o + 56 > fsz) { ok = false; break; }
+            const uint8_t* ph = d + o;
+            ps3_sha1_update(&sha, ph + 0, 4);              /* p_type  (BE, as stored) */
+            ps3_sha1_update(&sha, ph + 4, 4);              /* p_flags */
+            const uint32_t p_type   = rd32(ph + 0);
+            const uint64_t p_offset = rd64(ph + 8);
+            const uint64_t p_filesz = rd64(ph + 32);
+            const uint64_t p_memsz  = rd64(ph + 40);
+            if (p_type == 1 /*PT_LOAD*/ && p_memsz) {
+                ps3_sha1_update(&sha, ph + 16, 8);         /* p_vaddr */
+                ps3_sha1_update(&sha, ph + 40, 8);         /* p_memsz */
+                if (p_offset > fsz || p_filesz > fsz - p_offset) { ok = false; break; }
+                ps3_sha1_update(&sha, d + p_offset, (size_t)p_filesz);
+            }
+        }
+        if (ok) {
+            uint8_t dg[20];
+            ps3_sha1_final(&sha, dg);
+            static const char hx[] = "0123456789abcdef";
+            memcpy(out, "PPU-", 4);
+            for (int k = 0; k < 20; k++) { out[4 + 2 * k] = hx[dg[k] >> 4]; out[5 + 2 * k] = hx[dg[k] & 15]; }
+            out[44] = 0;
+        }
+    }
+    free(d);
+    return ok;
+}
+
+void build_index(void)
+{
+    if (s_index_built) return;
+    s_index_built = true;
+    const uint64_t n = function_table_count;
+    s_by_addr.resize((size_t)n);
+    s_is_stub.assign((size_t)n, 0);
+    uint64_t h = 1469598103934665603ull;   /* FNV-1a 64 */
+    uint32_t lo = 0xFFFFFFFFu, hi = 0;
+    for (uint64_t i = 0; i < n; i++) {
+        s_by_addr[(size_t)i] = (uint32_t)i;
+        const uint32_t a = (uint32_t)function_table[i].addr;
+        const uint8_t be[4] = { (uint8_t)(a >> 24), (uint8_t)(a >> 16), (uint8_t)(a >> 8), (uint8_t)a };
+        for (int k = 0; k < 4; k++) { h ^= be[k]; h *= 1099511628211ull; }
+        if (a < lo) lo = a;
+        if (a > hi) hi = a;
+    }
+    std::sort(s_by_addr.begin(), s_by_addr.end(), [](uint32_t x, uint32_t y) {
+        return function_table[x].addr < function_table[y].addr;
+    });
+    for (const uint32_t* p = function_table_unguarded; *p != 0xFFFFFFFFu; p++)
+        if (*p < n) s_is_stub[*p] = 1;
+    s_code_lo = n ? lo : 0;
+    s_code_hi = n ? hi + 4 : 0;
+    snprintf(s_lift_id, sizeof s_lift_id, "LIFT-%llu-%016llx",
+             (unsigned long long)n, (unsigned long long)h);
+}
+
+/* function_table[] index of the entry at addr, or -1. */
+int64_t fn_find(uint32_t addr)
+{
+    build_index();
+    size_t lo = 0, hi = s_by_addr.size();
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if ((uint32_t)function_table[s_by_addr[mid]].addr < addr) lo = mid + 1; else hi = mid;
+    }
+    if (lo < s_by_addr.size() && (uint32_t)function_table[s_by_addr[lo]].addr == addr)
+        return (int64_t)s_by_addr[lo];
+    return -1;
+}
+
+/* 0 = hookable entry, else the PS3MOD_E_* reason. */
+int hookable(uint32_t addr)
+{
+    int64_t i = fn_find(addr);
+    if (i < 0) return PS3MOD_E_NOT_ENTRY;
+    if (s_is_stub[(size_t)i]) return PS3MOD_E_IMPORT_STUB;
+    if (!ppu_hook_is_entry(addr)) return PS3MOD_E_NOT_ENTRY;
+    return PS3MOD_OK;
+}
+
+/* ======================================================================== */
+/* Plugin records                                                            */
+
+enum plugin_state { PLG_IDLE, PLG_LOADING, PLG_ACTIVE, PLG_GONE };
+
+struct plugin;
+
+/* A hook as the dispatcher sees it (user pointer of hook_adapter). Never
+ * freed: the dispatcher keeps pointers to it, and a thread may be inside the
+ * chain at any time. `enabled` is hook_enable's switch (ABI 1.2). */
+struct hook_rec {
+    ps3mod_hook_fn   fn;
+    void*            user;
+    uint32_t         mode;
+    uint32_t         n_lr;
+    uint32_t*        lr;
+    uint32_t         addr;
+    uint32_t         handle;      /* 1-based index into s_handles */
+    const plugin*    owner;
+    std::atomic<int> enabled;
+};
+
+struct staged_hook  { uint32_t addr; hook_rec* rec; uint32_t mode; std::vector<uint32_t> lrs; };
+struct staged_patch { uint32_t addr; std::vector<uint8_t> expect, bytes; uint32_t flags; };
+struct staged_event { uint32_t ev; ps3mod_event_fn fn; void* user; };
+struct cfg_entry    { std::string section, key, value; };
+
+struct plugin {
+    ps3mod_host         host;          /* the pointer handed to the plugin ("self") */
+    std::string         file;          /* DLL file name, for log lines */
+    std::string         name;          /* DLL base name (no extension) */
+    std::string         path, config_path;
+    std::string         title;         /* info.name, else name */
+    ps3mod_query_fn     query    = nullptr;
+    ps3mod_init_fn      init     = nullptr;
+    ps3mod_shutdown_fn  shutdown = nullptr;
+#ifdef _WIN32
+    HMODULE             dll      = nullptr;
+#else
+    void*               dll      = nullptr;   /* dlopen handle */
+#endif
+    int                 state    = PLG_IDLE;
+    int                 init_errors = 0;   /* failed hook/patch calls during init */
+    std::vector<staged_hook>  hooks;
+    std::vector<staged_patch> patches;
+    std::vector<staged_event> events;
+    bool                      has_pacing = false;   /* set_pacing during init (ABI 1.1) */
+    ps3mod_pacing             pacing{};
+    std::vector<cfg_entry>    cfg;
+    std::vector<std::pair<std::string, std::string>> env;   /* KEY (normalised) -> value */
+    union { ps3mod_info info; unsigned char info_buf[PS3MOD_INFO_STORAGE]; };
+    plugin() : host(), info_buf() {}
+};
+
+/* Plugins being loaded or loaded. Written only by the loader (main thread,
+ * before any guest or ticker thread exists), read-only afterwards. */
+std::vector<plugin*> s_plugins;
+std::string          s_mods_root;
+bool                 s_debug = false;
+
+plugin* find_plugin(const ps3mod_host* self)
+{
+    for (plugin* p : s_plugins)
+        if (&p->host == self) return p;
+    return nullptr;
+}
+
+const char* pname(const plugin* p) { return p ? p->name.c_str() : "?"; }
+
+/* Committed REPLACE hooks without a call-site filter: one per function. */
+struct replace_owner { uint32_t addr; const plugin* p; };
+std::vector<replace_owner> s_replaced;
+
+/* Every hook record ever made (handle = index + 1); grows only. */
+std::vector<hook_rec*> s_handles;
+std::atomic<int>       s_handle_lock{0};
+struct spin_guard {
+    std::atomic<int>& l;
+    explicit spin_guard(std::atomic<int>& x) : l(x) { while (l.exchange(1, std::memory_order_acquire)) {} }
+    ~spin_guard() { l.store(0, std::memory_order_release); }
+};
+
+hook_rec* new_hook_rec(const plugin* owner, uint32_t addr, ps3mod_hook_fn fn, void* user, uint32_t mode,
+                       const uint32_t* lrs, uint32_t n_lrs)
+{
+    hook_rec* r = new hook_rec();
+    r->fn = fn; r->user = user; r->mode = mode; r->addr = addr; r->owner = owner;
+    r->n_lr = n_lrs;
+    r->lr = nullptr;
+    if (n_lrs) {
+        r->lr = new uint32_t[n_lrs];
+        memcpy(r->lr, lrs, n_lrs * sizeof(uint32_t));
+    }
+    r->enabled.store(1, std::memory_order_relaxed);
+    spin_guard g(s_handle_lock);
+    s_handles.push_back(r);
+    r->handle = (uint32_t)s_handles.size();
+    return r;
+}
+
+/* Every committed hook goes through this adapter: on/off switch, call-site
+ * filter, and a REPLACE hook gets next == NULL. */
+void hook_adapter(struct ppu_context* ctx, const ppu_hook_link* next, void* user, uint32_t entry_lr)
+{
+    const hook_rec* r = (const hook_rec*)user;
+    if (!r->enabled.load(std::memory_order_relaxed)) { ppu_hook_call_next(ctx, next); return; }
+    if (r->n_lr) {
+        uint32_t i = 0;
+        while (i < r->n_lr && r->lr[i] != entry_lr) i++;
+        if (i == r->n_lr) { ppu_hook_call_next(ctx, next); return; }   /* other call site */
+    }
+    r->fn((ps3mod_ctx*)ctx,
+          r->mode == PS3MOD_HOOK_REPLACE ? nullptr : (const ps3mod_link*)next,
+          r->user, entry_lr);
+}
+
+/* ======================================================================== */
+/* Host display state + events                                               */
+
+std::atomic<int>      s_active{0};       /* >= 1 plugin loaded */
+std::atomic<int>      s_ready{0};
+std::atomic<uint64_t> s_client{0};       /* (w << 32) | h, last non-zero client size */
+std::atomic<uint32_t> s_render_w{1280}, s_render_h{720};
+std::atomic<uint64_t> s_frames{0}, s_vblanks{0}, s_resizes{0};
+#ifdef _WIN32
+HWND                  s_hwnd = nullptr;  /* written once by display_ready (ticker thread) */
+#endif
+
+const int kMaxEvents = 128;
+struct event_reg { uint32_t ev; ps3mod_event_fn fn; void* user; };
+event_reg        s_ev[kMaxEvents];
+std::atomic<int> s_nev{0};
+std::atomic<int> s_ev_lock{0};
+
+int add_event(uint32_t ev, ps3mod_event_fn fn, void* user)
+{
+    while (s_ev_lock.exchange(1, std::memory_order_acquire)) {}
+    int n = s_nev.load(std::memory_order_relaxed);
+    int r = PS3MOD_OK;
+    if (n >= kMaxEvents) r = PS3MOD_E_NOMEM;
+    else {
+        s_ev[n].ev = ev; s_ev[n].fn = fn; s_ev[n].user = user;
+        s_nev.store(n + 1, std::memory_order_release);   /* publish after the slot is written */
+    }
+    s_ev_lock.store(0, std::memory_order_release);
+    return r;
+}
+
+#if defined(PS3_WASM)
+extern "C" __attribute__((weak)) int rsx_live_draw_backbuffer(uint32_t* w, uint32_t* h);   /* rsx_live_draw.c */
+#endif
+void fill_display(ps3mod_display* d)
+{
+    memset(d, 0, sizeof *d);
+    d->size  = (uint32_t)sizeof *d;
+    d->ready = s_ready.load(std::memory_order_acquire) ? 1u : 0u;
+    const uint64_t c = s_client.load(std::memory_order_relaxed);
+    d->window_w = (uint32_t)(c >> 32);
+    d->window_h = (uint32_t)c;
+    d->render_w = s_render_w.load(std::memory_order_relaxed);
+    d->render_h = s_render_h.load(std::memory_order_relaxed);
+    /* Both D3D12 paths create the swap chain at the render size and never
+     * resize it; DXGI stretches it to the window. */
+    d->backbuffer_w = d->render_w;
+    d->backbuffer_h = d->render_h;
+#if defined(PS3_WASM)
+    /* browser build: the swap chain follows the canvas when the present pass is on (rsx_live_draw.c) */
+    { uint32_t bw = 0, bh = 0;
+      if (rsx_live_draw_backbuffer && rsx_live_draw_backbuffer(&bw, &bh) && bw && bh) { d->backbuffer_w = bw; d->backbuffer_h = bh; } }
+#endif
+    if (d->window_w && d->window_h)  d->aspect = (float)d->window_w / (float)d->window_h;
+    else if (d->render_w && d->render_h) d->aspect = (float)d->render_w / (float)d->render_h;
+    else d->aspect = 16.0f / 9.0f;
+    /* legacy 16 ms clock: nominal 60 (as ABI 1.0 always said), exact 62.5 */
+    const double vhz = ps3_pacing_vblank_hz();
+    d->refresh_hz = ps3_pacing_active() ? (uint32_t)(vhz + 0.5) : 60u;
+    d->vblank_hz  = (float)vhz;
+    d->display_hz = (float)ps3_pacing_display_hz();
+    d->frames  = s_frames.load(std::memory_order_relaxed);
+    d->vblanks = s_vblanks.load(std::memory_order_relaxed);
+}
+
+void fire(uint32_t ev, uint64_t count)
+{
+    const int n = s_nev.load(std::memory_order_acquire);
+    if (!n) return;
+    ps3mod_event e;
+    memset(&e, 0, sizeof e);
+    e.size  = (uint32_t)sizeof e;
+    e.ev    = ev;
+    e.count = count;
+    fill_display(&e.display);
+    for (int i = 0; i < n; i++)
+        if (s_ev[i].ev == ev) s_ev[i].fn(&e, s_ev[i].user);
+}
+
+#if defined(PS3_WASM)
+/* Browser build: the "window" is the canvas, whose backing size (CSS size x devicePixelRatio) the WebGPU device worker
+ * publishes (libs/video/webgpu d3d12_webgpu.c). PS3_WASM_CANVAS_DISPLAY=1 (opt-in until its ultrawide gate passes):
+ * plugins see it as window_w/h (aspect, Hor+) and get EV_RESIZE when it changes; off = 1280x720 render aspect as before. */
+extern "C" int wgs_canvas_size(unsigned* w, unsigned* h);
+static int canvas_display_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3_WASM_CANVAS_DISPLAY"); on = (e && *e == '1') ? 1 : 0; }
+    return on;
+}
+#endif
+/* Re-read the window's client size; true if it changed (and is non-zero). */
+bool poll_client_size(void)
+{
+#ifdef _WIN32
+    if (!s_hwnd) return false;
+    RECT rc;
+    if (!GetClientRect(s_hwnd, &rc)) return false;
+    const uint32_t w = (uint32_t)(rc.right - rc.left), h = (uint32_t)(rc.bottom - rc.top);
+    if (!w || !h) return false;               /* minimised: keep the last real size */
+    const uint64_t v = ((uint64_t)w << 32) | h;
+    return s_client.exchange(v, std::memory_order_relaxed) != v;
+#elif defined(PS3_WASM)
+    if (!canvas_display_on()) return false;
+    unsigned w = 0, h = 0;
+    if (!wgs_canvas_size(&w, &h) || !w || !h) return false;   /* not published yet: keep the last real size */
+    const uint64_t v = ((uint64_t)w << 32) | h;
+    return s_client.exchange(v, std::memory_order_relaxed) != v;
+#else
+    uint32_t w = 0, h = 0;
+    if (!rsx_live_draw_vkd3d_window_size || !rsx_live_draw_vkd3d_window_size(&w, &h)) return false;
+    if (!w || !h) return false;               /* minimised / no window: keep the last real size */
+    const uint64_t v = ((uint64_t)w << 32) | h;
+    return s_client.exchange(v, std::memory_order_relaxed) != v;
+#endif
+}
+
+#ifdef _WIN32
+BOOL CALLBACK pick_thread_window(HWND h, LPARAM lp)
+{
+    HWND* out = (HWND*)lp;
+    if (!*out) *out = h;                       /* any window as a fallback */
+    if (IsWindowVisible(h) && !GetParent(h)) { *out = h; return FALSE; }
+    return TRUE;
+}
+#endif
