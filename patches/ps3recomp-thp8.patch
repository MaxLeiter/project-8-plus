+#!/usr/bin/env python3
+"""xprof_report.py -- analyse an xprof sample file against the exe's /MAP.
+
+  python xprof_report.py SAMPLES --map thp8.map [--log GAMELOG] [--top 40]
+                         [--thread TID] [--json OUT] [--exe EXE] [--no-verify]
+                         [--busy N]
+
+Every sample is weighted by the CPU cycles its thread used since its previous
+sample (QueryThreadCycleTime delta), so all percentages are "% of sampled CPU"
+unless labelled samp%. Stack candidates (words on the stack pointing into the
+exe's code) are checked against the exe file on disk: only those preceded by a
+call instruction count as return addresses (disable with --no-verify).
+
+  --map     MSVC/lld-link /MAP of the profiled exe (Publics + Static symbols)
+  --log     game log; names PPU host threads ([THREAD n] ... hosttid=, etc.)
+  --thread  restrict every table to one host thread id
+  --json    dump the report data (for xprof_diff.py)
+  --busy    per-thread symbol tables for the N busiest threads (default 8)
+  --symcats print the category of each map symbol class and exit (sanity check)
+"""
+import argparse, bisect, collections, json, mmap, os, re, struct, sys
+
+# ---------------------------------------------------------------------------
+# Category rules -- first match wins.  (category, field, regex)
+#   field 'sym'    undecorated exe symbol      (RIP inside the main exe)
+#         'obj'    map object column, e.g. 'ps3recomp_runtime:spu_interp.c.obj'
+#         'mod'    lower-case module file name (RIP outside the exe)
+#         'modsym' 'module.dll!Name'           (RIP outside the exe; Name from the
+#                  DLL's export table or 'sub_<rva>' via .pdata, see PEImage)
+# Exe RIPs are only tested against sym/obj rules, other RIPs against mod/modsym.
+# Not in any module -> 'unknown'.
+# ---------------------------------------------------------------------------
+RULES = [
+    # --- main exe -----------------------------------------------------------
+    ('ppu_lifted',  'sym', r'^func_[0-9A-Fa-f]{8}$'),
+    ('spu_lifted',  'sym', r'_spu_func_[0-9A-Fa-f]{8}$'),
+    ('spu_lifted',  'obj', r'(^|[:\\/])spu_recomp\.c\.obj$|spu_gen'),
+    ('mem_helper',  'sym', r'^(vm_\w+|ppu_(stwcx|stdcx|lwarx|ldarx|lbarx|resv_)\w*|ppu_guard_page|ppu_ww_note_atomic'
+                           r'|ps3_ww_report_inline|ydkj_memmove\w*)$'),
+    ('icall',       'sym', r'^(ps3_indirect_call\w*|ppu_lookup\w*|ppu_opd_resolve|icall_hist|ppu_active_lr'
+                           r'|_guard_(xfg_)?dispatch_icall\w*|_guard_check_icall\w*)$'),
+    ('trampoline',  'sym', r'^(ppu_thread_entry_trampoline|ppu_guest_call(_ct|_run)?|ppu_run|ppu_unlifted_stub'
+                           r'|fiber_trampoline|harness_guest_caller)$'),
+    ('ppu_lifted',  'obj', r'^ppu_recomp_\d+\.cpp\.obj$'),       # codegen helpers (ppc_sraw ...) in lifted TUs
+    ('rsx',         'obj', r'(^|:)(rsx_\w+|cellGcmSys|sys_rsx|cellResc)\.c\.obj$'),
+    ('rsx',         'sym', r'^(rsx_|gcm_|_cellGcm|cellGcm)'),
+    ('spu_runtime', 'obj', r'(^|:)(spu_\w+|spurs_(job|pm|policy|taskset)\w*)\.c\.obj$'),
+    ('spu_runtime', 'sym', r'^(spu_|ps3_spu_|spurs_)'),
+    ('hle_syscall', 'sym', r'^(lv2_|sys_|_sys_|cell|_cell|sce|_sce|ps3_hle_|hle_|ppu_hle)'),
+    ('hle_syscall', 'obj', r'(^|:)(lv2_\w+|sys\w+|cell\w+|sce\w+|ppu_sysprx|ppu_fs|ppu_hle\w*|prx_loader|edat'
+                           r'|vfs_mods|at3_bridge|atrac\w*|fft|get_bits|mem|milestone)\.c(pp)?\.obj$'),
+    ('crt',         'sym', r'^(memcpy|memset|memmove|memcmp|memchr|strlen|strcmp|strncmp|malloc|free|calloc|realloc)$'),
+    ('crt',         'obj', r'^(ucrt|msvcrt|vcruntime|libcmt|libvcruntime|libucrt|msvcprt|libcpmt)\w*:'),
+    ('gpu_driver',  'obj', r'^(d3d12|dxgi|d3dcompiler)\w*:'),
+    ('os_other',    'obj', r'^(kernel32|ntdll|user32|gdi32|ws2_32|ole32|bcrypt|winmm|advapi32|xinput)\w*:'),
+    ('other_exe',   'obj', r'.'),
+    # --- other modules ------------------------------------------------------
+    ('os_wait',     'modsym', r'^(ntdll|win32u)\.dll!(Nt|Zw)(WaitFor\w*|Wait\w*|DelayExecution|RemoveIoCompletion\w*'
+                              r'|SignalAndWait\w*|YieldExecution|ReplyWaitReceivePort\w*|AlpcSendWaitReceivePort'
+                              r'|GdiDdDDIWaitFor\w*|UserMsgWaitForMultipleObjectsEx)$'),
+    ('gpu_driver',  'modsym', r'^win32u\.dll!NtGdiDdDDI'),       # D3DKMT kernel thunks (non-wait)
+    ('gpu_driver',  'mod', r'^(nv\w+|amd\w+|atidxx\w*|ati\w+|igd\w+|igxe\w*|igc\w*|d3d12\w*|dxgi|dxcore|d3d11'
+                           r'|d3d10warp|d3dscache|dxilconv|dxcompiler|dxil)\.dll$'),
+    ('crt',         'mod', r'^(ucrtbase\w*|vcruntime\d+\w*|msvcp\d+\w*|msvcrt|concrt\d+|vcomp\d+)\.dll$'),
+    ('os_other',    'mod', r'^(ntdll|kernelbase|kernel32|win32u|user32|gdi32\w*|combase|rpcrt4|ws2_32|mswsock'
+                           r'|sechost|advapi32|ole32|oleaut32|bcrypt\w*|cfgmgr32|shell32|winmm|dwmapi|uxtheme|imm32'
+                           r'|msctf|audioses|mmdevapi|xinput\d_\d|dinput8|hid|setupapi|powrprof|ucrtbased)\.dll$'),
+    ('other_dll',   'mod', r'.'),
+]
+CATEGORIES = ['ppu_lifted', 'mem_helper', 'icall', 'trampoline', 'hle_syscall', 'spu_lifted', 'spu_runtime',
+              'rsx', 'crt', 'gpu_driver', 'os_wait', 'os_other', 'other_exe', 'other_dll', 'unknown']
+_RULES = [(c, f, re.compile(r)) for c, f, r in RULES]
+FUNC_RX = re.compile(r'^func_[0-9A-Fa-f]{8}$')
+
+
+def categorize(sym=None, obj=None, mod=None, modsym=None):
+    fields = {'sym': sym, 'obj': obj, 'mod': mod, 'modsym': modsym}
+    for cat, field, rx in _RULES:
+        v = fields[field]
+        if v is not None and rx.search(v):
+            return cat
+    return 'unknown'
+
+
+# ---------------------------------------------------------------------------
+# /MAP parsing (lld-link / link.exe); cf. work/perf/symrva.py
+# ---------------------------------------------------------------------------
+MAP_SEC = re.compile(r'^\s*([0-9a-fA-F]{4}):([0-9a-fA-F]{8})\s+([0-9a-fA-F]{8})H\s+(\S+)\s+(\w+)\s*$')
+MAP_SYM = re.compile(r'^\s*([0-9a-fA-F]{4}):([0-9a-fA-F]{8})\s+(\S+)\s+([0-9a-fA-F]{16})\s+(?:f\s+)?(?:i\s+)?(\S+)\s*$')
+_LOCAL_SCOPE = re.compile(r'^\?\d+\?+(.*)$')
+
+
+def undecorate(n):
+    """'?func_0069A11C@@YAXPEAUppu_context@@@Z' -> 'func_0069A11C';
+    '?__invoke@<lambda_0>@?0??main@@9@...' -> 'main::<lambda_0>::__invoke'."""
+    if not n.startswith('?'):
+        return n
+    if n.startswith('??'):
+        m = re.match(r'^\?\?([01])([^@]+)@(.*)$', n)          # ctor / dtor
+        if not m:
+            return n if len(n) <= 60 else n[:57] + '...'
+        base, rest = ('' if m.group(1) == '0' else '~') + m.group(2), m.group(3)
+        scopes = [m.group(2)]
+    else:
+        m = re.match(r'^\?([^@]+)@(.*)$', n)
+        if not m:
+            return n
+        base, rest, scopes = m.group(1), m.group(2), []
+    for part in rest.split('@'):
+        if part == '':
+            break
+        if part.startswith('?A0x') or part.startswith('?$'):
+            continue
+        lm = _LOCAL_SCOPE.match(part)
+        scopes.append(lm.group(1) if lm else part)
+    return '::'.join(list(reversed(scopes)) + [base]) if scopes else base
+
+
+class ExeMap:
+    def __init__(self, path):
+        self.base, self.timestamp = 0x140000000, None
+        code_secs, best = set(), {}
+        bad = ('.weak.', '__guard', '__imp_', '$', '.refptr')
+        with open(path, errors='replace') as f:
+            for line in f:
+                if 'Preferred load address is' in line:
+                    self.base = int(line.split()[-1], 16)
+                    continue
+                if self.timestamp is None and line.startswith(' Timestamp is'):
+                    self.timestamp = int(line.split()[2], 16)
+                    continue
+                m = MAP_SYM.match(line)
+                if m:
+                    if int(m.group(1), 16) not in code_secs:
+                        continue
+                    va = int(m.group(4), 16)
+                    if va < self.base:
+                        continue
+                    rva, raw, obj = va - self.base, m.group(3), m.group(5)
+                    old = best.get(rva)
+                    if old is None or (old[0].startswith(bad) and not raw.startswith(bad)):
+                        best[rva] = (raw, obj)
+                    continue
+                m = MAP_SEC.match(line)
+                if m and m.group(5) == 'CODE':
+                    code_secs.add(int(m.group(1), 16))
+        self.rvas = sorted(best)
+        self.raw = [best[r][0] for r in self.rvas]
+        self.obj = [best[r][1] for r in self.rvas]
+        self.name = [undecorate(r) for r in self.raw]
+        self._cat = [None] * len(self.rvas)
+
+    def lookup(self, rva):
+        """index of the symbol containing rva, or -1"""
+        return bisect.bisect_right(self.rvas, rva) - 1
+
+    def category(self, i):
+        c = self._cat[i]
+        if c is None:
+            c = self._cat[i] = categorize(sym=self.name[i], obj=self.obj[i])
+        return c
+
+
+# ---------------------------------------------------------------------------
+# PE files on disk: DLL export/.pdata symbolisation and exe call-site checks
+# ---------------------------------------------------------------------------
+class PEImage:
+    def __init__(self, path):
+        self.ok, self.secs, self.timestamp = False, [], None
+        self.exp_rvas, self.exp_names, self.exp_by_rva = [], [], {}
+        self.pd_begin, self.pd_end = [], []
+        try:
+            f = open(path, 'rb')
+            self.mm = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
+            f.close()
+        except (OSError, ValueError):
+            return
+        mm = self.mm
+        try:
+            lfa = struct.unpack_from('<I', mm, 0x3C)[0]
+            if mm[lfa:lfa + 4] != b'PE\0\0':
+                return
+            nsec, self.timestamp = struct.unpack_from('<HI', mm, lfa + 6)
+            optsz = struct.unpack_from('<H', mm, lfa + 20)[0]
+            opt = lfa + 24
+            if struct.unpack_from('<H', mm, opt)[0] != 0x20B:
+                return
+            ndd = struct.unpack_from('<I', mm, opt + 108)[0]
+            dd = [struct.unpack_from('<II', mm, opt + 112 + 8 * i) for i in range(min(ndd, 16))]
+            so = opt + optsz
+            for i in range(nsec):
+                vsz, va, rawsz, rawp = struct.unpack_from('<IIII', mm, so + 40 * i + 8)
+                self.secs.append((va, max(vsz, rawsz), rawp, rawsz))
+            self.ok = True
+            if len(dd) > 0 and dd[0][0]:
+                self._exports(*dd[0])
+            if len(dd) > 3 and dd[3][0]:
+                off = self.rva2off(dd[3][0])
+                if off is not None:
+                    ents = sorted(struct.iter_unpack('<III', mm[off:off + dd[3][1] // 12 * 12]))
+                    self.pd_begin = [e[0] for e in ents]
+                    self.pd_end = [e[1] for e in ents]
+        except struct.error:
+            pass
+
+    def rva2off(self, rva):
+        for va, sz, rawp, rawsz in self.secs:
+            if va <= rva < va + sz:
+                return rva - va + rawp if rva - va < rawsz else None
+        return None
+
+    def _exports(self, erva, esize):
+        mm, off = self.mm, self.rva2off(erva)
+        if off is None:
+            return
+        nfun, nnam, afun, anam, aord = struct.unpack_from('<IIIII', mm, off + 20)
+        fo, no, oo = self.rva2off(afun), self.rva2off(anam), self.rva2off(aord)
+        if fo is None:
+            return
+        funcs = struct.unpack_from('<%dI' % nfun, mm, fo)
+        names = {}
+        if no is not None and oo is not None:
+            for i in range(nnam):
+                nrva, ordi = struct.unpack_from('<I', mm, no + 4 * i)[0], struct.unpack_from('<H', mm, oo + 2 * i)[0]
+                so = self.rva2off(nrva)
+                if so is None:
+                    continue
+                end = mm.find(b'\0', so, so + 512)
+                names.setdefault(ordi, mm[so:end].decode('ascii', 'replace'))
+        for ordi, frva in enumerate(funcs):
+            if frva and not (erva <= frva < erva + esize) and ordi in names:   # skip forwarders
+                self.exp_by_rva.setdefault(frva, names[ordi])
+        self.exp_rvas = sorted(self.exp_by_rva)
+        self.exp_names = [self.exp_by_rva[r] for r in self.exp_rvas]
+
+    def symbol(self, rva):
+        """export name (or sub_<rva>) for a code rva"""
+        i = bisect.bisect_right(self.pd_begin, rva) - 1
+        if i >= 0 and rva < self.pd_end[i]:
+            fs = self.pd_begin[i]
+            n = self.exp_by_rva.get(fs)
+            return n if n else 'sub_%X' % fs
+        j = bisect.bisect_right(self.exp_rvas, rva) - 1          # leaf (no .pdata), e.g. syscall stubs
+        if j >= 0 and rva - self.exp_rvas[j] < 0x200:
+            return self.exp_names[j]
+        return 'rva_%X' % (rva & ~0xF)
+
+    def is_call_site(self, rva):
+        """is rva (a candidate return address) preceded by a call instruction?"""
+        off = self.rva2off(rva)
+        if off is None or off < 8:
+            return False
+        b = self.mm[off - 8:off]
+        if b[3] == 0xE8:                                         # call rel32
+            return True
+        for k in (2, 3, 4, 6, 7, 8):                             # FF /2  call r/m64
+            if b[8 - k] != 0xFF:
+                continue
+            modrm = b[8 - k + 1]
+            if (modrm >> 3) & 7 != 2:
+                continue
+            mod, rm, ln = modrm >> 6, modrm & 7, 2
+            if mod != 3:
+                if rm == 4:
+                    ln += 1
+                    if k < 3:
+                        continue
+                    if mod == 0 and (b[8 - k + 2] & 7) == 5:
+                        ln += 4
+                if mod == 0 and rm == 5:
+                    ln += 4
+                elif mod == 1:
+                    ln += 1
+                elif mod == 2:
+                    ln += 4
+            if ln == k:
+                return True
+        return False
+
+
+# ---------------------------------------------------------------------------
+# game log thread names (cf. work/perf/symrva.py load_names)
+# ---------------------------------------------------------------------------
+def load_names(path):
+    names, gname = {}, {}
+    with open(path, errors='replace') as f:
+        for line in f:
+            m = re.search(r'sys_ppu_thread_create tid=(\d+) name="([^"]*)"', line)
+            if m:
+                gname[m.group(1)] = m.group(2)
+            m = re.search(r'\[THREAD (\d+)\] host thread started.*hosttid=(\d+)', line)
+            if m:
+                names[int(m.group(2))] = 'ppu%s "%s"' % (m.group(1), gname.get(m.group(1), '?'))
+            m = re.search(r'MAIN guest thread tid=(\d+)', line)
+            if m:
+                names[int(m.group(1))] = 'ppu1 MAIN'
+            m = re.search(r'\[hosttid\] (\d+) (.*)$', line)
+            if m:
+                names[int(m.group(1))] = m.group(2).strip()
+    return names
+
+
+# ---------------------------------------------------------------------------
+# sample file
+# ---------------------------------------------------------------------------
+def read_header(path):
+    h = {'modules': {}, 'exec': [], 't0': collections.defaultdict(list), 't1': collections.defaultdict(list),
+         'opts': {}, 'W': {}, 'exe': None, 'pid': None, 'pname': '?', 'text': None}
+    with open(path, errors='replace') as f:
+        for line in f:
+            if line[0] == 'S' and line[1] == ' ':
+                continue
+            line = line.rstrip('\r\n')
+            tag = line.split(' ', 1)[0]
+            if tag == 'T0':
+                p = line.split(' ', 8) + ['']
+                h['t0'][int(p[1])].append({'late': int(p[2]), 'create_ft': int(p[3], 16), 'user': int(p[4]),
+                                           'kernel': int(p[5]), 'cyc': int(p[6]), 'start': int(p[7], 16),
+                                           'name': p[8].strip()})
+            elif tag == 'T1':
+                p = line.split(' ', 10) + ['']
+                h['t1'][int(p[1])].append({'alive': int(p[2]), 'user': int(p[3]), 'kernel': int(p[4]),
+                                           'cyc': int(p[5]), 'samples': int(p[6]), 'idle': int(p[7]),
+                                           'fails': int(p[8]), 'start': int(p[9], 16), 'name': p[10].strip()})
+            elif tag == 'M':
+                p = line.split(' ', 4) + ['']
+                h['modules'][int(p[1], 16)] = (int(p[2], 16), p[3], p[4])
+            elif tag == 'E':
+                p = line.split(' ', 4) + ['']
+                h['exe'] = {'base': int(p[1], 16), 'size': int(p[2], 16), 'timestamp': int(p[3], 16), 'path': p[4]}
+            elif tag == 'X':
+                p = line.split()
+                h['exec'].append((p[1], int(p[2], 16), int(p[3], 16)))
+            elif tag == 'TEXT':
+                p = line.split()
+                h['text'] = (int(p[1], 16), int(p[2], 16))
+            elif tag == 'P':
+                p = line.split(' ', 2) + ['']
+                h['pid'], h['pname'] = int(p[1]), p[2]
+            elif tag in ('OPT', 'W'):
+                for kv in line.split()[1:]:
+                    k, _, v = kv.partition('=')
+                    h['opts' if tag == 'OPT' else 'W'][k] = v
+    return h
+
+
+class Symbolizer:
+    def __init__(self, hdr, exemap, exe_pe, verify):
+        self.map, self.exe_pe, self.verify = exemap, exe_pe, verify
+        self.exe_base = hdr['exe']['base']
+        self.exe_end = self.exe_base + hdr['exe']['size']
+        mods = sorted((b, s, n, p) for b, (s, n, p) in hdr['modules'].items() if b != self.exe_base)
+        self.mod_bases = [m[0] for m in mods]
+        self.mods = mods
+        self.pe = {}
+        self.rip_cache, self.ra_cache = {}, {}
+
+    def _dll(self, path):
+        pe = self.pe.get(path)
+        if pe is None:
+            pe = self.pe[path] = PEImage(path)
+        return pe
+
+    def rip(self, va):
+        """-> (key, category, where, is_func)"""
+        r = self.rip_cache.get(va)
+        if r is not None:
+            return r
+        if self.exe_base <= va < self.exe_end:
+            i = self.map.lookup(va - self.exe_base)
+            if i < 0:
+                r = ('exe+0x%X' % (va - self.exe_base), 'other_exe', '', False)
+            else:
+                name = self.map.name[i]
+                r = (name, self.map.category(i), self.map.obj[i].split(':')[-1], bool(FUNC_RX.match(name)))
+        else:
+            j = bisect.bisect_right(self.mod_bases, va) - 1
+            if j >= 0 and va < self.mods[j][0] + self.mods[j][1]:
+                base, size, mname, path = self.mods[j]
+                lname = mname.lower()
+                pe = self._dll(path)
+                sym = pe.symbol(va - base) if pe.ok else 'rva_%X' % ((va - base) & ~0xF)
+                key = '%s!%s' % (mname, sym)
+                r = (key, categorize(mod=lname, modsym='%s!%s' % (lname, sym)), mname, False)
+            else:
+                r = ('?0x%X' % va, 'unknown', '', False)
+        self.rip_cache[va] = r
+        return r
+
+    def ra_func(self, hexrva):
+        """lifted func_ name for a stack candidate (exe rva hex string), or '' """
+        r = self.ra_cache.get(hexrva)
+        if r is not None:
+            return r
+        rva = int(hexrva, 16)
+        r = ''
+        if not self.verify or self.exe_pe.is_call_site(rva):
+            i = self.map.lookup(rva)
+            if i >= 0 and FUNC_RX.match(self.map.name[i]):
+                r = self.map.name[i]
+        self.ra_cache[hexrva] = r
+        return r
+
+
+def analyse(path, hdr, sym, want_tid):
+    cat_w = collections.Counter()
+    cat_n = collections.Counter()
+    sym_w = collections.Counter()
+    sym_n = collections.Counter()
+    sym_info = {}
+    thr_w = collections.Counter()
+    thr_n = collections.Counter()
+    thr_cat = collections.defaultdict(collections.Counter)
+    thr_sym = collections.defaultdict(collections.Counter)
+    attr = collections.defaultdict(collections.Counter)   # guest func -> category -> weight
+    incl = collections.Counter()
+    no_guest = collections.Counter()                      # category -> weight with no lifted caller found
+    total_w = total_n = 0
+    with open(path, errors='replace') as f:
+        for line in f:
+            if line[0] != 'S' or line[1] != ' ':
+                continue
+            p = line.split()
+            tid = int(p[1])
+            if want_tid is not None and tid != want_tid:
+                continue
+            w = int(p[3])
+            key, cat, where, is_func = sym.rip(int(p[2], 16))
+            total_w += w
+            total_n += 1
+            cat_w[cat] += w
+            cat_n[cat] += 1
+            sym_w[key] += w
+            sym_n[key] += 1
+            if key not in sym_info:
+                sym_info[key] = (cat, where)
+            thr_w[tid] += w
+            thr_n[tid] += 1
+            thr_cat[tid][cat] += w
+            thr_sym[tid][key] += w
+            seen = set()
+            if is_func:
+                seen.add(key)
+                attr[key]['ppu_lifted'] += w
+            guest = None
+            for ra in p[4:]:
+                fn = sym.ra_func(ra)
+                if fn:
+                    if guest is None:
+                        guest = fn
+                    seen.add(fn)
+            if not is_func:
+                if guest:
+                    attr[guest][cat] += w
+                else:
+                    no_guest[cat] += w
+            for fn in seen:
+                incl[fn] += w
+    return dict(cat_w=cat_w, cat_n=cat_n, sym_w=sym_w, sym_n=sym_n, sym_info=sym_info, thr_w=thr_w, thr_n=thr_n,
+                thr_cat=thr_cat, thr_sym=thr_sym, attr=attr, incl=incl, no_guest=no_guest,
+                total_w=total_w, total_n=total_n)
+
+
+def thread_table(hdr, sym, lognames, tsc_hz, wall):
+    rows = []
+    for tid in sorted(set(hdr['t0']) | set(hdr['t1'])):
+        t0s, t1s = hdr['t0'].get(tid, []), hdr['t1'].get(tid, [])
+        cpu = cyc = 0
+        name = start = ''
+        samples = idle = 0
+        alive = 0
+        for i, t1 in enumerate(t1s):
+            t0 = t0s[i] if i < len(t0s) else None
+            late = t0 is None or t0['late']
+            cpu += t1['user'] + t1['kernel'] - (0 if late else t0['user'] + t0['kernel'])
+            cyc += t1['cyc'] - (0 if late else t0['cyc'])
+            samples += t1['samples']
+            idle += t1['idle']
+            alive |= t1['alive']
+            name = t1['name'] or (t0['name'] if t0 else '') or name
+            start = t1['start'] or start
+        if not t1s and t0s:
+            name, start = t0s[-1]['name'], t0s[-1]['start']
+        if not name:
+            name = lognames.get(tid, '')
+        elif tid in lognames:
+            name = '%s / %s' % (name, lognames[tid])
+        ssym = sym.rip(start)[0] if start else '?'
+        rows.append({'tid': tid, 'name': name, 'start': ssym, 'start_va': start,
+                     'cores': cpu / 1e7 / wall if wall else 0.0,
+                     'cores_cyc': cyc / tsc_hz / wall if wall and tsc_hz else 0.0,
+                     'samples': samples, 'idle_rounds': idle, 'alive': alive})
+    return rows
+
+
+def pct(a, b):
+    return 100.0 * a / b if b else 0.0
+
+
+def symcats(mappath, names):
+    m = ExeMap(mappath)
+    cnt, ex = collections.Counter(), collections.defaultdict(list)
+    for i in range(len(m.rvas)):
+        c = m.category(i)
+        cnt[c] += 1
+        if len(ex[c]) < 4:
+            ex[c].append(m.name[i])
+    print('%s: %d code symbols, preferred base 0x%X, timestamp %s'
+          % (mappath, len(m.rvas), m.base, '%08x' % m.timestamp if m.timestamp is not None else '?'))
+    for c in CATEGORIES:
+        if cnt[c]:
+            print('  %-12s %7d   e.g. %s' % (c, cnt[c], ', '.join(ex[c])))
+    idx = collections.defaultdict(list)
+    for i, n in enumerate(m.name):
+        idx[n].append(i)
+    for n in names:
+        if n not in idx:
+            print('  %-40s (not in map)' % n)
+        for i in idx.get(n, [])[:2]:
+            print('  %-40s rva 0x%08X  %-12s %s' % (n, m.rvas[i], m.category(i), m.obj[i]))
+
+
+def main():
+    ap = argparse.ArgumentParser(description='xprof sample analyser')
+    ap.add_argument('samples', nargs='?')
+    ap.add_argument('--map', required=True)
+    ap.add_argument('--symcats', nargs='*', metavar='NAME',
+                    help='just categorise the map: counts per category (+ the category of each NAME)')
+    ap.add_argument('--log')
+    ap.add_argument('--top', type=int, default=40)
+    ap.add_argument('--thread', type=int)
+    ap.add_argument('--json')
+    ap.add_argument('--exe', help='exe for call-site checks (default: the path xprof recorded)')
+    ap.add_argument('--no-verify', action='store_true', help='accept every stack word into .text as a return address')
+    ap.add_argument('--busy', type=int, default=8)
+    a = ap.parse_args()
+    out = sys.stdout
+    if a.symcats is not None:
+        return symcats(a.map, a.symcats)
+    if not a.samples:
+        ap.error('SAMPLES is required')
+
+    hdr = read_header(a.samples)
+    if not hdr['exe']:
+        sys.exit('xprof_report: %s has no E (exe) line -- not an xprof file?' % a.samples)
+    W = hdr['W']
+    wall = float(W.get('wall_s', 0) or 0)
+    tsc_hz = float(W.get('tsc_hz', 0) or 0)
+    if not wall or not tsc_hz:
+        sys.exit('xprof_report: no W line (xprof did not finish?)')
+    exemap = ExeMap(a.map)
+    warnings = []
+    if exemap.timestamp is not None and exemap.timestamp != hdr['exe']['timestamp']:
+        warnings.append('MAP TIMESTAMP %08x != profiled exe %08x -- symbols are probably wrong'
+                        % (exemap.timestamp, hdr['exe']['timestamp']))
+    verify = not a.no_verify
+    exe_pe = None
+    if verify:
+        exe_pe = PEImage(a.exe or hdr['exe']['path'])
+        if not exe_pe.ok:
+            warnings.append('cannot read exe %s -- stack candidates not call-site verified' % (a.exe or hdr['exe']['path']))
+            verify = False
+        elif exe_pe.timestamp != hdr['exe']['timestamp']:
+            warnings.append('exe on disk (%08x) differs from the profiled one (%08x) -- stack candidates not '
+                            'call-site verified' % (exe_pe.timestamp, hdr['exe']['timestamp']))
+            verify = False
+    sym = Symbolizer(hdr, exemap, exe_pe, verify)
+    lognames = load_names(a.log) if a.log else {}
+    R = analyse(a.samples, hdr, sym, a.thread)
+    threads = thread_table(hdr, sym, lognames, tsc_hz, wall)
+    tw = R['total_w']
+    def cores(w):
+        return w / tsc_hz / wall
+
+    proc_cores = sum(t['cores'] for t in threads)
+    proc_cores_cyc = sum(t['cores_cyc'] for t in threads)
+    rounds = int(W.get('rounds', 0) or 0)
+    J = {'meta': {'file': a.samples, 'pid': hdr['pid'], 'process': hdr['pname'], 'exe': hdr['exe']['path'],
+                  'exe_timestamp': '%08x' % hdr['exe']['timestamp'], 'map': a.map, 'wall_s': wall,
+                  'rounds': rounds, 'samples': R['total_n'], 'tsc_hz': tsc_hz, 'thread_filter': a.thread,
+                  'opts': hdr['opts'], 'sampler': W, 'verified_stack': verify, 'warnings': warnings},
+         'process': {'cores': proc_cores, 'cores_cyc': proc_cores_cyc, 'cores_sampled': cores(tw)}}
+
+    P = lambda *s: print(*s, file=out)
+    P('xprof report: %s   pid %s %s' % (a.samples, hdr['pid'], hdr['pname']))
+    P('  exe %s (ts %08x), map %s' % (hdr['exe']['path'], hdr['exe']['timestamp'], a.map))
+    P('  wall %.2f s, %d rounds (%.2f ms/round), %d samples; sampler: suspend avg %s us max %s us, busy %s%% of wall'
+      % (wall, rounds, wall * 1e3 / rounds if rounds else 0, R['total_n'], W.get('susp_avg_us', '?'),
+         W.get('susp_max_us', '?'), W.get('sampler_busy_pct', '?')))
+    P('  process CPU %.2f cores (thread times) / %.2f cores (cycles); sampled CPU %.2f cores%s'
+      % (proc_cores, proc_cores_cyc, cores(tw), ('  [thread %d only]' % a.thread) if a.thread is not None else ''))
+    P('  stack candidates: %s' % ('call-site verified against the exe' if verify else 'UNVERIFIED (raw .text words)'))
+    for wmsg in warnings:
+        P('  WARNING: ' + wmsg)
+
+    # ---- categories
+    P('\n== categories (weighted by CPU) ==')
+    P('  %-12s %7s %7s %7s' % ('category', 'cores', 'cpu%', 'samp%'))
+    J['categories'] = {}
+    for c in CATEGORIES:
+        if not R['cat_n'].get(c):
+            continue
+        J['categories'][c] = {'cores': cores(R['cat_w'][c]), 'pct': pct(R['cat_w'][c], tw),
+                              'samples': R['cat_n'][c], 'samp_pct': pct(R['cat_n'][c], R['total_n'])}
+        P('  %-12s %7.2f %6.1f%% %6.1f%%' % (c, cores(R['cat_w'][c]), pct(R['cat_w'][c], tw), pct(R['cat_n'][c], R['total_n'])))
+
+    # ---- threads
+    P('\n== threads (by CPU) ==')
+    P('  %-6s %-34s %-30s %6s %7s %5s  %s' % ('tid', 'name', 'start', 'cores', 'samples', 'idle%', 'categories (% of thread CPU)'))
+    J['threads'] = []
+    for t in sorted(threads, key=lambda t: -t['cores']):
+        if a.thread is not None and t['tid'] != a.thread:
+            continue
+        tc = R['thr_cat'].get(t['tid'], {})
+        twt = R['thr_w'].get(t['tid'], 0)
+        cats = sorted(((pct(v, twt), c) for c, v in tc.items()), reverse=True)
+        t['cats'] = {c: p for p, c in cats}
+        t['sampled_cores'] = cores(twt)
+        J['threads'].append(t)
+        if t['cores'] < 0.005 and not t['samples']:
+            continue
+        rounds_t = t['samples'] + t['idle_rounds']
+        P('  %-6d %-34.34s %-30.30s %6.2f %7d %4.0f%%  %s' % (
+            t['tid'], t['name'] + ('' if t['alive'] else ' [exited]'), t['start'], t['cores'], t['samples'],
+            pct(t['idle_rounds'], rounds_t), ' '.join('%s %.0f' % (c, p) for p, c in cats[:5] if p >= 1)))
+    quiet = sum(1 for t in threads if t['cores'] < 0.005 and not t['samples'])
+    if quiet and a.thread is None:
+        P('  (+%d threads with ~0 CPU and no samples)' % quiet)
+
+    # ---- top symbols
+    ntop = a.top
+    njs = max(ntop, 200)
+    P('\n== top symbols (self, CPU-weighted) ==')
+    P('  %6s %6s %8s  %-11s %-50s %s' % ('cpu%', 'cores', 'samples', 'category', 'symbol', 'object/module'))
+    J['top_symbols'] = []
+    for i, (k, w) in enumerate(R['sym_w'].most_common(njs)):
+        c, where = R['sym_info'][k]
+        J['top_symbols'].append({'sym': k, 'cat': c, 'where': where, 'pct': pct(w, tw), 'cores': cores(w),
+                                 'samples': R['sym_n'][k]})
+        if i < ntop:
+            P('  %5.2f%% %6.3f %8d  %-11s %-50.50s %s' % (pct(w, tw), cores(w), R['sym_n'][k], c, k, where))
+
+    # ---- lifted functions
+    lifted = [(w, k) for k, w in R['sym_w'].items() if R['sym_info'][k][0] == 'ppu_lifted']
+    lifted.sort(reverse=True)
+    P('\n== top lifted PPU code (self) ==   [%.1f%% of sampled CPU is lifted PPU code]' % pct(R['cat_w']['ppu_lifted'], tw))
+    P('  %6s %6s %8s %7s  %s' % ('self%', 'cores', 'samples', 'incl~%', 'function'))
+    J['lifted_self'] = []
+    for i, (w, k) in enumerate(lifted[:njs]):
+        J['lifted_self'].append({'func': k, 'pct': pct(w, tw), 'cores': cores(w), 'samples': R['sym_n'][k],
+                                 'incl_pct': pct(R['incl'].get(k, 0), tw)})
+        if i < ntop:
+            P('  %5.2f%% %6.3f %8d %6.1f%%  %s' % (pct(w, tw), cores(w), R['sym_n'][k], pct(R['incl'].get(k, 0), tw), k))
+
+    attr = R['attr']
+    rows = sorted(((sum(cc.values()), f) for f, cc in attr.items()), reverse=True)
+    show = ['ppu_lifted', 'mem_helper', 'icall', 'trampoline', 'hle_syscall', 'rsx', 'crt', 'os_wait', 'os_other']
+    hdrs = ['self', 'mem', 'icall', 'tramp', 'hle', 'rsx', 'crt', 'os_wt', 'os_ot']
+    P('\n== top lifted functions: self + charged callees (guest-caller attribution) ==')
+    P('  non-lifted samples are charged to the first lifted func_ found among the stack\'s return addresses')
+    P('  %6s  ' % 'total%' + ' '.join('%6s' % h for h in hdrs) + ' %6s  %s' % ('other', 'function'))
+    J['lifted_attr'] = []
+    for i, (w, f) in enumerate(rows[:njs]):
+        cc = attr[f]
+        other = w - sum(cc.get(c, 0) for c in show)
+        J['lifted_attr'].append({'func': f, 'pct': pct(w, tw), 'cores': cores(w),
+                                 'by_cat': {c: pct(v, tw) for c, v in cc.items()},
+                                 'incl_pct': pct(R['incl'].get(f, 0), tw)})
+        if i < ntop:
+            P('  %5.2f%%  ' % pct(w, tw) + ' '.join('%6.2f' % pct(cc.get(c, 0), tw) for c in show)
+              + ' %6.2f  %s' % (pct(other, tw), f))
+    ng = R['no_guest']
+    J['no_guest'] = {c: pct(v, tw) for c, v in ng.items()}
+    P('  not attributable (no lifted caller on the stack): ' +
+      (', '.join('%s %.1f%%' % (c, pct(v, tw)) for c, v in ng.most_common() if pct(v, tw) >= 0.1) or 'none'))
+
+    # ---- busiest threads
+    busy = [t for t in sorted(threads, key=lambda t: -R['thr_w'].get(t['tid'], 0)) if R['thr_w'].get(t['tid'], 0)]
+    if a.thread is None:
+        busy = busy[:a.busy]
+    J['thread_top'] = {}
+    for t in busy:
+        twt = R['thr_w'][t['tid']]
+        P('\n== thread %d %s  (%.2f cores sampled, start %s) ==' % (t['tid'], t['name'], cores(twt), t['start']))
+        lst = []
+        for k, w in R['thr_sym'][t['tid']].most_common(max(15, min(ntop, 25))):
+            lst.append({'sym': k, 'cat': R['sym_info'][k][0], 'pct': pct(w, twt)})
+            P('  %5.1f%%  %-11s %s' % (pct(w, twt), R['sym_info'][k][0], k))
+        J['thread_top'][str(t['tid'])] = lst
+
+    if a.json:
+        with open(a.json, 'w') as f:
+            json.dump(J, f, indent=1)
+        P('\njson -> %s' % a.json)
+
+
+if __name__ == '__main__':
+    main()
