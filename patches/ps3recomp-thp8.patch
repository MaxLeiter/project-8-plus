+
+/* PS3_DRAW_SMPVAR: variable-length sampler tables. The shader-visible sampler
+ * heap holds 2048 descriptors (the D3D12 maximum), i.e. 128 tables of 16; the
+ * Houses spawn view needs more distinct sampler combinations per frame than
+ * that and hit a DESCRIPTOR_RING flush (a full GPU-idle wait, plus a DCL
+ * drain) about once per frame. A table only needs the units up to the highest
+ * one the fragment program samples (g_ld_current_pso.fp_sampled, the mask the
+ * PSO key and PS3_DRAW_SAMPLED already trust): the root signature is version
+ * 1.0, whose descriptors are volatile, so the entries past that -- which the
+ * shader never reads -- may hold anything. Tables are packed at their real
+ * length (start + 16 <= heap size, so every 16-entry range stays inside the
+ * heap) and found again by (length, slots). The mode is fixed per ring
+ * generation (ld_smp_ring_reset). */
+static ld_switch g_ld_sw_smpvar = { .name = "DRAW_SMPVAR" };
+#define LD_SMPV_MAX 1024u
+#define LD_SMPV_IDX 2048u
+static struct {
+    int mode;                         /* this generation uses variable tables */
+    u32 used, n;                      /* descriptors / tables allocated */
+    u16 index[LD_SMPV_IDX];           /* entry + 1, open addressing */
+    struct { u32 start, len; u32 slots[SMP_TABLE_SIZE]; } e[LD_SMPV_MAX];
+    u64 built, reused, flushes;
+} g_ld_smpv;
+
+#if defined(PS3_WASM)
+/* [ld-rings]: sampler descriptors in use this ring generation (variable-length tables count their real length) */
+static u32 ld_smp_ring_fill(u32* tables)
+{
+    if (g_ld_smpv.mode) { *tables = g_ld_smpv.n; return g_ld_smpv.used; }
+    *tables = g.smp_ring_used;
+    return g.smp_ring_used * SMP_TABLE_SIZE;
+}
+#endif
+static void ld_smp_ring_reset(void)
+{
+    g.smp_ring_used = 0;
+    if (g_ld_smpv.n || g_ld_smpv.used) memset(g_ld_smpv.index, 0, sizeof(g_ld_smpv.index));
+    g_ld_smpv.used = g_ld_smpv.n = 0;
+    g_ld_smpv.mode = ld_switch_on(&g_ld_sw_smpvar);
+}
+static u32 ld_smpv_len(void)
+{
+    u32 m = g_ld_current_pso.valid ? (g_ld_current_pso.fp_sampled & 0xFFFFu) : 0xFFFFu;
+    u32 n = 1;
+    while (n < SMP_TABLE_SIZE && (m >> n)) n++;
+    return n;
+}
+static u32 ld_smpv_hash(const u32* slots, u32 len)
+{
+    u64 h = 0x9E3779B97F4A7C15ull ^ len;
+    for (u32 i = 0; i < len; i++) h = (h ^ slots[i]) * 0x100000001B3ull;
+    return (u32)(h ^ (h >> 31)) & (LD_SMPV_IDX - 1u);
+}
+static int ld_smpv_find(const u32* slots, u32 len, u32* hslot)
+{
+    u32 h = ld_smpv_hash(slots, len);
+    for (u32 k = 0; k < LD_SMPV_IDX; k++, h = (h + 1u) & (LD_SMPV_IDX - 1u)) {
