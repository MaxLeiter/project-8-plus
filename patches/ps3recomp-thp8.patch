+/*
+ * ps3recomp - D3D12 over WebGPU: the subset of D3D12 + DXGI + D3DCompile that the live-draw renderer
+ * (rsx_live_draw.c, rsx_live_gfx.c, rsx_live_overlay.c) uses, implemented as a command stream for the WebGPU
+ * device worker (web/host/gpu/device-worker.js). It takes the place of rsx_live_draw_vkd3d.c in a PS3_WASM build:
+ * the renderer compiles in its RSX_LIVE_VKD3D mode (Wine/vkd3d's C COM headers) and calls these entry points.
+ *
+ * Model (see wgs_proto.h):
+ *   - Objects are C structs with a COM vtable; each GPU-side object has an id the worker maps to a GPU object.
+ *   - Command lists record WGS list words into their allocator's memory. ExecuteCommandLists posts a REF to
+ *     those words on the queue ring, preceded by UPLOAD refs for the upload-heap ranges the lists read. The worker
+ *     reads both straight out of the shared wasm memory, so nothing is copied on this side. Allocator memory and
+ *     upload-heap bytes stay untouched until the title's fence says the GPU is done, exactly as D3D12 requires.
+ *   - Descriptors are plain structs in descriptor heaps; draws resolve the bound tables into WGS_L_BIND entries.
+ *   - Fences: the worker stores each signalled value at the fence's address in wasm memory and notifies; waits
+ *     here block on that word.
+ *   - D3DCompile does not compile: the blob carries the HLSL, entry point and stage, and the worker translates it
+ *     to WGSL (hlsl2wgsl.js) when a pipeline uses it.
+ * Built for PS3_WASM, and natively with WGS_RECORD for tests (the stream goes to a file with REFs inlined).
+ * Game-agnostic; no title content.
+ */
+#if defined(PS3_WASM) || defined(WGS_RECORD)
+
+#define COM_NO_WINDOWS_H
+#define INITGUID              /* this TU owns the IID storage (rsx_live_draw_vkd3d.c does on Linux) */
+#include <vkd3d_windows.h>
+#include <vkd3d_d3d12.h>
+#include <vkd3d_d3d12sdklayers.h>
+#include <vkd3d_dxgi1_4.h>
+#include <vkd3d_d3dcompiler.h>
+#include <vkd3d_utils.h>      /* the exact prototypes this file implements (D3D12CreateDeviceVKD3D, ...) */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(PS3_WASM)
+#include "../frame_trace.h"   /* PS3_SPIKE_MS: fence / present waits per frame */
+#endif
+#include <pthread.h>
+#include "wgs_proto.h"
+
+#ifdef PS3_WASM
+#  ifdef __EMSCRIPTEN__
+#    include <emscripten.h>
+#    define WGS_EXPORT EMSCRIPTEN_KEEPALIVE
+#  else
+#    define WGS_EXPORT __attribute__((export_name("ps3_web_gpu_ring")))
+#  endif
+#endif
+
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef uint8_t  u8;
+
+/* ------------------------------------------------------------------------------------------------ helpers */
+#define WGS_LOG(...) fprintf(stderr, "[wgs] " __VA_ARGS__)
+static void* wgs_zalloc(size_t n) { void* p = calloc(1, n); if (!p) { WGS_LOG("out of memory (%zu)\n", n); abort(); } return p; }
+static u32 f2u(float f) { u32 u; memcpy(&u, &f, 4); return u; }
+static int iid_eq(REFIID a, const IID* b) { return memcmp(a, b, sizeof(IID)) == 0; }
+
+static volatile u32 s_next_id = 1;
+static u32 wgs_new_id(void) { return __atomic_fetch_add(&s_next_id, 1u, __ATOMIC_RELAXED); }
+
+/* Any vtable slot this layer does not implement lands here (filled in by wgs_fill_vtbl). */
+static HRESULT STDMETHODCALLTYPE wgs_unimplemented(void* self)
+{
+    (void)self;
+    WGS_LOG("unimplemented D3D12/DXGI method called\n");
+    return E_NOTIMPL;
+}
+/* The ID3D12Object / ID3D12DeviceChild slots every interface has, typed generically: at the WebAssembly level each
+ * parameter is an i32 whatever the interface, so one function per slot shape is safe in any vtable -- unlike the
+ * catch-all below, which only matches its own shape (a call through a slot of another type traps in wasm). */
+static HRESULT STDMETHODCALLTYPE wgs_obj_get_priv(void* t, const void* g, UINT* s, void* d) { (void)t; (void)g; (void)d; if (s) *s = 0; return 0x887A0002L; /* DXGI_ERROR_NOT_FOUND */ }
+static HRESULT STDMETHODCALLTYPE wgs_obj_set_priv(void* t, const void* g, UINT s, const void* d) { (void)t; (void)g; (void)s; (void)d; return S_OK; }
+static HRESULT STDMETHODCALLTYPE wgs_obj_set_priv_if(void* t, const void* g, const void* u) { (void)t; (void)g; (void)u; return S_OK; }
+static HRESULT STDMETHODCALLTYPE wgs_obj_set_name(void* t, const void* n) { (void)t; (void)n; return S_OK; }
+static HRESULT STDMETHODCALLTYPE wgs_child_get_device(void* t, const void* iid, void** out);
+#define WGS_OBJECT_SLOTS(vt) do {     if (!(vt).GetPrivateData) *(void**)&(vt).GetPrivateData = (void*)wgs_obj_get_priv;     if (!(vt).SetPrivateData) *(void**)&(vt).SetPrivateData = (void*)wgs_obj_set_priv;     if (!(vt).SetPrivateDataInterface) *(void**)&(vt).SetPrivateDataInterface = (void*)wgs_obj_set_priv_if;     if (!(vt).SetName) *(void**)&(vt).SetName = (void*)wgs_obj_set_name; } while (0)
+#define WGS_CHILD_SLOTS(vt) do { WGS_OBJECT_SLOTS(vt);     if (!(vt).GetDevice) *(void**)&(vt).GetDevice = (void*)wgs_child_get_device; } while (0)
+
+static HRESULT STDMETHODCALLTYPE wgs_dxgi_get_parent(void* t, const void* iid, void** out) { (void)t; (void)iid; if (out) *out = NULL; return E_NOINTERFACE; }
+#define WGS_DXGI_SLOTS(vt) do {     if (!(vt).GetPrivateData) *(void**)&(vt).GetPrivateData = (void*)wgs_obj_get_priv;     if (!(vt).SetPrivateData) *(void**)&(vt).SetPrivateData = (void*)wgs_obj_set_priv;     if (!(vt).GetPrivateDataInterface) *(void**)&(vt).GetPrivateDataInterface = (void*)wgs_obj_set_priv_if; /* vkd3d's name for slot 4 */     if (!(vt).GetParent) *(void**)&(vt).GetParent = (void*)wgs_dxgi_get_parent; } while (0)
+
+static void wgs_fill_vtbl(void* vtbl, size_t bytes)
+{
+    void** v = (void**)vtbl;
+    for (size_t i = 0; i < bytes / sizeof(void*); i++) if (!v[i]) v[i] = (void*)wgs_unimplemented;
+}
+
+/* ------------------------------------------------------------------------------------------------ transport
+ * The queue ring: one producer lock, the device worker is the only consumer. Messages are whole words. When the
+ * ring is full the producer waits for the worker to advance `tail`. */
+typedef struct wgs_ring {
+    u32 magic;              /* +0  WGS_MAGIC */
+    u32 cap_words;          /* +4  */
+    volatile u32 head;      /* +8  producer, in words (free-running) */
+    volatile u32 tail;      /* +12 consumer */
+    volatile u32 doorbell;  /* +16 bumped per post; the worker waits on it */
+    u32 flags;              /* +20 WGS_FLAG_* */
+    volatile u32 canvas_w;  /* +24 the page canvas' backing size, written by the device worker (0 = not known yet) */
+    volatile u32 canvas_h;  /* +28 */
+    u32 words[1 << 20];     /* +32 4 MiB */
+} wgs_ring;
+
+static wgs_ring s_ring = { WGS_MAGIC, 1u << 20, 0, 0, 0,
+#ifdef WGS_RECORD
+    WGS_FLAG_INLINE,
+#else
+    0,
+#endif
+    0, 0, {0} };
+static pthread_mutex_t s_ring_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* The canvas size the device worker publishes (ring +24 / +28): the "window" the swap chain follows on wasm.
+ * 1 = known, 0 = not yet (or no worker: WGS_RECORD). */
+int wgs_canvas_size(unsigned* w, unsigned* h)
+{
+    const u32 cw = __atomic_load_n(&s_ring.canvas_w, __ATOMIC_ACQUIRE), ch = __atomic_load_n(&s_ring.canvas_h, __ATOMIC_ACQUIRE);
+    if (!cw || !ch) return 0;
+    if (w) *w = cw;
+    if (h) *h = ch;
+    return 1;
+}
+
+#ifdef PS3_WASM
+WGS_EXPORT wgs_ring* ps3_web_gpu_ring(void) { return &s_ring; }
+static void wgs_wait32(volatile u32* addr, u32 expect, long long timeout_ns)
+{ __builtin_wasm_memory_atomic_wait32((int*)addr, (int)expect, timeout_ns); }
+static void wgs_notify(volatile u32* addr) { __builtin_wasm_memory_atomic_notify((int*)addr, 0xFFFFFFFFu); }
+#else
+#include <time.h>
+static void wgs_wait32(volatile u32* addr, u32 expect, long long timeout_ns)
+{ (void)addr; (void)expect; struct timespec t = { 0, timeout_ns > 1000000 ? 1000000 : timeout_ns }; nanosleep(&t, NULL); }
+static void wgs_notify(volatile u32* addr) { (void)addr; }
+static FILE* s_rec;                       /* WGS_RECORD: the stream file (WGS_RECORD_FILE, default wgs_stream.bin) */
+#endif
+
+/* WGS_STATS=<s>: every <s> seconds, how long the renderer's threads sat waiting on the device worker -- fences
+ * (GPU idle / frame-in-flight waits) and a full command ring -- the two places a slow worker shows up. */
+#include <time.h>
+static double wgs_now_ms(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e3 + t.tv_nsec / 1e6; }
+static struct { volatile long n_fence, n_ring, n_pres; volatile double ms_fence, ms_ring, max_fence, ms_pres; double next; int sec; } s_wst = { 0, 0, 0, 0, 0, 0, 0, 0, -1 };
+static void wgs_stats_note(int ring, double ms)
+{
+    if (s_wst.sec < 0) { const char* e = getenv("WGS_STATS"); s_wst.sec = e ? atoi(e) : 0; }
+    if (!s_wst.sec) return;
+    if (ring == 2) { __atomic_add_fetch(&s_wst.n_pres, 1, __ATOMIC_RELAXED); s_wst.ms_pres += ms; }
+    else if (ring) { __atomic_add_fetch(&s_wst.n_ring, 1, __ATOMIC_RELAXED); s_wst.ms_ring += ms; }
+    else { __atomic_add_fetch(&s_wst.n_fence, 1, __ATOMIC_RELAXED); s_wst.ms_fence += ms; if (ms > s_wst.max_fence) s_wst.max_fence = ms; }
+    const double now = wgs_now_ms();
+    if (now >= s_wst.next) {
+        if (s_wst.next) fprintf(stderr, "[wgs-wait] %ds: fence waits %ld (%.0f ms, max %.1f) ring-full waits %ld (%.0f ms) present waits %ld (%.0f ms)\n",
+                                s_wst.sec, s_wst.n_fence, s_wst.ms_fence, s_wst.max_fence, s_wst.n_ring, s_wst.ms_ring, s_wst.n_pres, s_wst.ms_pres);
+        s_wst.n_fence = s_wst.n_ring = s_wst.n_pres = 0; s_wst.ms_fence = s_wst.ms_ring = s_wst.max_fence = s_wst.ms_pres = 0;
+        s_wst.next = now + s_wst.sec * 1000.0;
+    }
+}
+
+/* A message under construction (thread-local scratch, posted whole). */
+typedef struct { u32* w; u32 n, cap; } wgs_msg;
+static void msg_grow(wgs_msg* m, u32 need) { if (m->n + need > m->cap) { m->cap = (m->n + need) * 2 + 64; m->w = (u32*)realloc(m->w, m->cap * 4); } }
+static void msg_u32(wgs_msg* m, u32 v) { msg_grow(m, 1); m->w[m->n++] = v; }
+static void msg_u64(wgs_msg* m, u64 v) { msg_u32(m, (u32)v); msg_u32(m, (u32)(v >> 32)); }
+static void msg_bytes(wgs_msg* m, const void* p, u32 len)
+{
+    msg_u32(m, len);
+    const u32 words = (len + 3) / 4;
+    msg_grow(m, words);
+    if (words) m->w[m->n + words - 1] = 0;        /* zero the pad bytes of the last word */
+    if (len) memcpy(&m->w[m->n], p, len);
+    m->n += words;
+}
+/* REF: pointer + length (live) or inline bytes (record). */
+static void msg_ref(wgs_msg* m, const void* p, u32 len)
+{
+#ifdef WGS_RECORD
+    msg_bytes(m, p, len);
+#else
+    msg_u32(m, (u32)(uintptr_t)p); msg_u32(m, len);
+#endif
+}
+static void msg_begin(wgs_msg* m, u32 op) { m->n = 0; msg_u32(m, op << 16); }
+
+static void ring_post(wgs_msg* m)
+{
+    m->w[0] = (m->w[0] & 0xFFFF0000u) | ((m->n - 1) & 0xFFFFu);
+    if (m->n - 1 > 0xFFFFu) {                       /* oversized payload: escape with an explicit length word */
+        WGS_LOG("message too large (%u words)\n", m->n);
+        abort();
+    }
+    pthread_mutex_lock(&s_ring_lock);
+#ifdef WGS_RECORD
+    if (!s_rec) {
+        const char* fn = getenv("WGS_RECORD_FILE");
+        s_rec = fopen(fn && *fn ? fn : "wgs_stream.bin", "wb");
+        u32 hdr[3] = { WGS_BEGIN << 16 | 2, WGS_MAGIC, WGS_FLAG_INLINE };
+        fwrite(hdr, 4, 3, s_rec);
+    }
+    fwrite(m->w, 4, m->n, s_rec); fflush(s_rec);
+#else
+    const u32 cap = s_ring.cap_words;
+    double w0 = 0;
+    for (;;) {
+        const u32 used = s_ring.head - __atomic_load_n(&s_ring.tail, __ATOMIC_ACQUIRE);
+        if (cap - used >= m->n) break;
+        if (!w0) w0 = wgs_now_ms();
+        const u32 t = s_ring.tail;
+        pthread_mutex_unlock(&s_ring_lock);
+        wgs_wait32(&s_ring.tail, t, 2000000);       /* the worker notifies when it advances */
+        pthread_mutex_lock(&s_ring_lock);
+    }
+    if (w0) wgs_stats_note(1, wgs_now_ms() - w0);
+    u32 h = s_ring.head;
+    for (u32 i = 0; i < m->n; i++, h++) s_ring.words[h & (cap - 1)] = m->w[i];
+    __atomic_store_n(&s_ring.head, h, __ATOMIC_RELEASE);
+    __atomic_add_fetch(&s_ring.doorbell, 1u, __ATOMIC_RELEASE);
+    wgs_notify(&s_ring.doorbell);
+#endif
+    pthread_mutex_unlock(&s_ring_lock);
+}
+static __thread wgs_msg t_msg;
+
+/* ------------------------------------------------------------------------------------------------ blobs */
+typedef struct wgs_blob { ID3DBlob iface; volatile LONG refs; SIZE_T size; u8* data; } wgs_blob;
+static HRESULT STDMETHODCALLTYPE blob_qi(ID3DBlob* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D10Blob)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE blob_addref(ID3DBlob* t) { return (ULONG)__atomic_add_fetch(&((wgs_blob*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE blob_release(ID3DBlob* t)
+{
+    wgs_blob* b = (wgs_blob*)t;
+    const LONG r = __atomic_sub_fetch(&b->refs, 1, __ATOMIC_ACQ_REL);
+    if (!r) { free(b->data); free(b); }
+    return (ULONG)r;
+}
+static void* STDMETHODCALLTYPE blob_ptr(ID3DBlob* t) { return ((wgs_blob*)t)->data; }
+static SIZE_T STDMETHODCALLTYPE blob_size(ID3DBlob* t) { return ((wgs_blob*)t)->size; }
+static ID3D10BlobVtbl s_blob_vtbl = { blob_qi, blob_addref, blob_release, blob_ptr, blob_size };
+static wgs_blob* blob_new(SIZE_T size)
+{
+    wgs_blob* b = (wgs_blob*)wgs_zalloc(sizeof *b);
+    b->iface.lpVtbl = &s_blob_vtbl; b->refs = 1; b->size = size; b->data = (u8*)wgs_zalloc(size ? size : 1);
+    return b;
+}
+
+HRESULT WINAPI D3DCreateBlob(SIZE_T size, ID3DBlob** blob)
+{
+    if (!blob) return E_INVALIDARG;
+    *blob = &blob_new(size)->iface;
+    return S_OK;
+}
+
+/* Shader "bytecode": 'WGSH' magic, stage char, entry length + entry, source length + source. The worker translates
+ * the HLSL when a pipeline uses it; a broken shader surfaces there (logged), not here. */
+#define WGSH_MAGIC 0x48534757u
+HRESULT WINAPI D3DCompile(const void* data, SIZE_T size, const char* file, const D3D_SHADER_MACRO* defines,
+                          ID3DInclude* include, const char* entry, const char* target, UINT flags1, UINT flags2,
+                          ID3DBlob** code, ID3DBlob** errors)
+{
+    (void)file; (void)defines; (void)include; (void)flags1; (void)flags2;
+    if (errors) *errors = NULL;
+    if (!data || !entry || !target || !code) return E_INVALIDARG;
+    const u32 elen = (u32)strlen(entry);
+    wgs_blob* b = blob_new(12 + elen + 4 + size);
+    u8* p = b->data;
+    const u32 magic = WGSH_MAGIC;
+    memcpy(p, &magic, 4); p += 4;
+    *p++ = (u8)target[0]; *p++ = 0; *p++ = 0; *p++ = 0;   /* 'v' / 'p' / 'c' */
+    memcpy(p, &elen, 4); p += 4; memcpy(p, entry, elen); p += elen;
+    const u32 slen = (u32)size;
+    memcpy(p, &slen, 4); p += 4; memcpy(p, data, size);
+    *code = &b->iface;
+    return S_OK;
+}
+static int shader_blob_ok(const void* p, SIZE_T n) { u32 m; return p && n >= 12 && (memcpy(&m, p, 4), m == WGSH_MAGIC); }
+static void msg_shader(wgs_msg* m, const void* p, SIZE_T n)
+{
+    if (!shader_blob_ok(p, n)) { msg_u32(m, 0); return; }        /* stage 0 = absent */
+    const u8* q = (const u8*)p;
+    msg_u32(m, q[4]);
+    u32 elen; memcpy(&elen, q + 8, 4);
+    msg_bytes(m, q + 12, elen);
+    u32 slen; memcpy(&slen, q + 12 + elen, 4);
+    msg_bytes(m, q + 16 + elen, slen);
+}
+
+/* ------------------------------------------------------------------------------------------------ root signatures
+ * Serialized form (ours, not DXIL's): words. version 1, num params, then per param: type, visibility, and
+ *   table: num ranges, per range: range type, count, base register, space, offset in table (0xFFFFFFFF = append)
+ *   constants: register, space, num 32-bit values;   CBV/SRV/UAV: register, space
+ * then num static samplers, each: filter, addr u v w, lod bias (bits), max aniso, compare, border color, min lod,
+ * max lod (bits), register, space, visibility; then flags. */
+HRESULT WINAPI D3D12SerializeRootSignature(const D3D12_ROOT_SIGNATURE_DESC* d, D3D_ROOT_SIGNATURE_VERSION v,
+                                           ID3DBlob** blob, ID3DBlob** err)
+{
+    (void)v;
+    if (err) *err = NULL;
+    if (!d || !blob) return E_INVALIDARG;
+    wgs_msg m = {0};
+    msg_u32(&m, 1); msg_u32(&m, d->NumParameters);
+    for (UINT i = 0; i < d->NumParameters; i++) {
+        const D3D12_ROOT_PARAMETER* p = &d->pParameters[i];
+        msg_u32(&m, p->ParameterType); msg_u32(&m, p->ShaderVisibility);
+        switch (p->ParameterType) {
+        case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+            msg_u32(&m, p->DescriptorTable.NumDescriptorRanges);
+            for (UINT r = 0; r < p->DescriptorTable.NumDescriptorRanges; r++) {
+                const D3D12_DESCRIPTOR_RANGE* g = &p->DescriptorTable.pDescriptorRanges[r];
+                msg_u32(&m, g->RangeType); msg_u32(&m, g->NumDescriptors); msg_u32(&m, g->BaseShaderRegister);
+                msg_u32(&m, g->RegisterSpace); msg_u32(&m, g->OffsetInDescriptorsFromTableStart);
+            }
+            break;
+        case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS:
+            msg_u32(&m, p->Constants.ShaderRegister); msg_u32(&m, p->Constants.RegisterSpace); msg_u32(&m, p->Constants.Num32BitValues);
+            break;
+        default:
+            msg_u32(&m, p->Descriptor.ShaderRegister); msg_u32(&m, p->Descriptor.RegisterSpace);
+            break;
+        }
+    }
+    msg_u32(&m, d->NumStaticSamplers);
+    for (UINT i = 0; i < d->NumStaticSamplers; i++) {
+        const D3D12_STATIC_SAMPLER_DESC* s = &d->pStaticSamplers[i];
+        msg_u32(&m, s->Filter); msg_u32(&m, s->AddressU); msg_u32(&m, s->AddressV); msg_u32(&m, s->AddressW);
+        msg_u32(&m, f2u(s->MipLODBias)); msg_u32(&m, s->MaxAnisotropy); msg_u32(&m, s->ComparisonFunc);
+        msg_u32(&m, s->BorderColor); msg_u32(&m, f2u(s->MinLOD)); msg_u32(&m, f2u(s->MaxLOD));
+        msg_u32(&m, s->ShaderRegister); msg_u32(&m, s->RegisterSpace); msg_u32(&m, s->ShaderVisibility);
+    }
+    msg_u32(&m, d->Flags);
+    wgs_blob* b = blob_new(m.n * 4);
+    memcpy(b->data, m.w, m.n * 4);
+    free(m.w);
+    *blob = &b->iface;
+    return S_OK;
+}
