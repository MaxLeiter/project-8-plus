+/* Stale temp files (a save cut short by a kill, > 10 min old) and all but the
+ * 4 most recently written libraries in the directory of `path`. */
+static void ld_psolib_tidy(const char* path)
+{
+    char dir[MAX_PATH], pat[MAX_PATH + 16], fn[MAX_PATH * 2];
+    snprintf(dir, sizeof dir, "%s", path);
+    char* s1 = strrchr(dir, '/');
+    char* s2 = strrchr(dir, '\\');
+    char* sl = s1 > s2 ? s1 : s2;
+    if (!sl) return;
+    const char* own = path + (sl - dir) + 1;
+    *sl = 0;
+    snprintf(pat, sizeof pat, "%s/pso_library_*", dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE) return;
+    static struct { char name[MAX_PATH]; u64 t; } libs[32];
+    u32 nlib = 0;
+    FILETIME now;
+    GetSystemTimeAsFileTime(&now);
+    const u64 tn = ((u64)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    do {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        const u64 tw = ((u64)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+        if (strstr(fd.cFileName, ".tmp.")) {
+            if (tn > tw && tn - tw > 6000000000ull) {   /* 10 min in 100 ns units */
+                snprintf(fn, sizeof fn, "%s/%s", dir, fd.cFileName);
+                DeleteFileA(fn);
+            }
+            continue;
+        }
+        if (nlib < 32) {
+            snprintf(libs[nlib].name, sizeof libs[nlib].name, "%s", fd.cFileName);
+            libs[nlib].t = tw;
+            nlib++;
+        }
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+    for (u32 i = 0; i < nlib; i++) {
+        u32 newer = 0;
+        for (u32 j = 0; j < nlib; j++) newer += libs[j].t > libs[i].t;
+        if (newer >= 4 && _stricmp(libs[i].name, own) != 0) {
+            snprintf(fn, sizeof fn, "%s/%s", dir, libs[i].name);
+            if (DeleteFileA(fn)) fprintf(stderr, "[pso-library] removed old library %s\n", libs[i].name);
+        }
+    }
+}
+
+static void ld_psolib_ix_add(const ld_psolib_ix* x)
+{
+    if (!x) return;
+    AcquireSRWLockExclusive(&g_psolib.ixlock);
+    if (g_psolib.ix_n == g_psolib.ix_cap) {
+        const u32 cap = g_psolib.ix_cap ? g_psolib.ix_cap * 2u : 1024u;
+        ld_psolib_ix* n = (ld_psolib_ix*)realloc(g_psolib.ix, (size_t)cap * sizeof(ld_psolib_ix));
+        if (n) { g_psolib.ix = n; g_psolib.ix_cap = cap; }
+    }
+    if (g_psolib.ix_n < g_psolib.ix_cap) g_psolib.ix[g_psolib.ix_n++] = *x;
+    ReleaseSRWLockExclusive(&g_psolib.ixlock);
+}
+
+/* The names in the library (g_psolib.lock held exclusively, or before any
+ * thread). StorePipeline never sees a name twice: a refused duplicate store
+ * followed by a later Serialize read freed memory inside the runtime (pool
+ * run pw1: a prewarm on an intact library, then a background save). */
+static int ld_psolib_name_known(u64 h)
+{
+    if (!g_psolib.names_cap) return 0;
+    if (!h) h = 1;
+    for (u32 i = (u32)ld_fmix64(h) & (g_psolib.names_cap - 1u), probe = 0; probe < g_psolib.names_cap;
+         probe++, i = (i + 1u) & (g_psolib.names_cap - 1u)) {
+        if (!g_psolib.names[i]) return 0;
+        if (g_psolib.names[i] == h) return 1;
+    }
+    return 0;
+}
+static void ld_psolib_name_mark(u64 h)
+{
+    if (!h) h = 1;
+    if ((g_psolib.names_n + 1u) * 2u > g_psolib.names_cap) {   /* keep it at most half full */
+        const u32 cap = g_psolib.names_cap ? g_psolib.names_cap * 2u : 4096u;
+        u64* t = (u64*)calloc(cap, sizeof(u64));
+        if (!t) return;
+        for (u32 j = 0; j < g_psolib.names_cap; j++) {
+            const u64 v = g_psolib.names[j];
+            if (!v) continue;
+            u32 i = (u32)ld_fmix64(v) & (cap - 1u);
+            while (t[i]) i = (i + 1u) & (cap - 1u);
+            t[i] = v;
+        }
+        free(g_psolib.names);
+        g_psolib.names = t;
+        g_psolib.names_cap = cap;
+    }
+    u32 i = (u32)ld_fmix64(h) & (g_psolib.names_cap - 1u);
+    while (g_psolib.names[i]) { if (g_psolib.names[i] == h) return; i = (i + 1u) & (g_psolib.names_cap - 1u); }
+    g_psolib.names[i] = h;
+    g_psolib.names_n++;
+}
+
+/* One store. Caller holds g_psolib.lock exclusively. */
+static void ld_psolib_store_locked(const WCHAR* name, ID3D12PipelineState* pso, const ld_psolib_ix* ix)
+{
+    if (ix && ld_psolib_name_known(ix->name)) return;
+    const HRESULT hr = g_psolib.lib->lpVtbl->StorePipeline(g_psolib.lib, name, pso);
+    if (SUCCEEDED(hr)) {
+        if (ix) ld_psolib_name_mark(ix->name);
+        InterlockedIncrement(&g_psolib.dirty);
+        InterlockedIncrement(&g_psolib.pipelines);
+        InterlockedExchange64(&g_psolib.last_new_us, ld_psolib_now_us());
+        ld_psolib_ix_add(ix);
+    } else if (InterlockedIncrement(&g_psolib.store_fails) <= 8) {
+        fprintf(stderr, "[pso-library] StorePipeline hr=0x%08lX\n", (unsigned long)hr);
+    }
+}
+
+/* Store the queued PSOs. Caller holds g_psolib.lock exclusively. */
+static void ld_psolib_store_pending_locked(void)
+{
+    AcquireSRWLockExclusive(&g_psolib.plock);
+    for (u32 i = 0; i < g_psolib.n_pending; i++) {
+        ld_psolib_store_locked(g_psolib.pending[i].name, g_psolib.pending[i].pso,
+                               g_psolib.pending[i].has_ix ? &g_psolib.pending[i].ix : NULL);
+        g_psolib.pending[i].pso->lpVtbl->Release(g_psolib.pending[i].pso);
+    }
+    g_psolib.n_pending = 0;
+    ReleaseSRWLockExclusive(&g_psolib.plock);
+}
+
+static int ld_psolib_save(const char* why)
+{
+    if (g_psolib.state != 1) return 0;
+    /* The library's own lock is held through Serialize: the buffer is
+     * allocated and touched before it. Draws do not wait for it (no loads while
+     * serializing, render-thread stores are queued), so the save keeps its low
+     * priority -- background mode on the save thread. */
+    size_t cap = g_psolib.lib->lpVtbl->GetSerializedSize(g_psolib.lib) + ((size_t)1 << 20);
+    u8* buf = (u8*)malloc(sizeof(ld_psolib_header) + cap);
+    if (!buf) return -1;
+    memset(buf, 0, sizeof(ld_psolib_header) + cap);
+    const long long t0 = ld_psolib_now_us();
+    AcquireSRWLockExclusive(&g_psolib.lock);
+    ld_psolib_store_pending_locked();
+    const LONG dirty = g_psolib.dirty;
+    SIZE_T n = 0;
+    HRESULT hr = S_OK;
+    if (dirty) {
+        /* draws do not load from the library while it serializes (ld_psolib_load): a load would wait on the
+         * runtime's library lock for the whole Serialize */
+        InterlockedExchange(&g_psolib.serializing, 1);
+        n = g_psolib.lib->lpVtbl->GetSerializedSize(g_psolib.lib);
+        hr = n <= cap ? g_psolib.lib->lpVtbl->Serialize(g_psolib.lib, buf + sizeof(ld_psolib_header), n)
+                      : E_OUTOFMEMORY;
+        InterlockedExchange(&g_psolib.serializing, 0);
+        if (SUCCEEDED(hr)) g_psolib.dirty = 0;
+    }
+    const LONG pipes = g_psolib.pipelines;
+    ReleaseSRWLockExclusive(&g_psolib.lock);
+    const long long t1 = ld_psolib_now_us();
+    if (!dirty) {
+        free(buf);
+        if (!strcmp(why, "exit"))
+            fprintf(stderr, "[pso-library] exit: %ld pipelines, nothing new since the last save; session: %ld loaded "
+                            "(longest load %.2f ms), %ld created, %ld loads skipped during a save\n",
+                    (long)pipes, (long)g_psolib.loads, (double)g_psolib.load_max_us / 1000.0,
+                    (long)g_psolib.creates, (long)g_psolib.load_skips);
+        return 0;
+    }
+    if (FAILED(hr)) {
+        free(buf);
+        fprintf(stderr, "[pso-library] serialize failed hr=0x%08lX (%s)\n", (unsigned long)hr, why);
+        return -1;
+    }
+    AcquireSRWLockShared(&g_psolib.ixlock);
+    const u32 ixn = g_psolib.ix_n;
+    ld_psolib_ix* ixc = ixn ? (ld_psolib_ix*)malloc((size_t)ixn * sizeof(ld_psolib_ix)) : NULL;
+    if (ixc) memcpy(ixc, g_psolib.ix, (size_t)ixn * sizeof(ld_psolib_ix));
+    ReleaseSRWLockShared(&g_psolib.ixlock);
+    const u32 ixw = ixc ? ixn : 0u;
+    ld_psolib_header h = g_psolib.id;
+    h.pipelines = (u32)pipes;
+    h.payload_bytes = n;
+    h.payload_hash = ld_psolib_hash(buf + sizeof(h), n, LD_PSOLIB_MAGIC);
+    h.ix_count = ixw;
+    h.ix_entry_bytes = (u32)sizeof(ld_psolib_ix);
+    h.ix_hash = ld_psolib_hash(ixc, (size_t)ixw * sizeof(ld_psolib_ix), LD_PSOLIB_MAGIC + 1u);
+    memcpy(buf, &h, sizeof(h));
+    char tmp[MAX_PATH + 32];
+    snprintf(tmp, sizeof tmp, "%s.tmp.%lu", g_psolib.path, (unsigned long)GetCurrentProcessId());
+    FILE* f = fopen(tmp, "wb");
+    int ok = f && fwrite(buf, 1, sizeof(h) + n, f) == sizeof(h) + n &&
+             (!ixw || fwrite(ixc, sizeof(ld_psolib_ix), ixw, f) == ixw);
+    if (f) ok = (fclose(f) == 0) && ok;
+    free(buf);
+    free(ixc);
+    if (!ok || !MoveFileExA(tmp, g_psolib.path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+        DeleteFileA(tmp);
+        fprintf(stderr, "[pso-library] write %s failed (%s)\n", g_psolib.path, why);
+        InterlockedExchangeAdd(&g_psolib.dirty, dirty);   /* try again later */
+        return -1;
+    }
+    InterlockedIncrement(&g_psolib.saves);
+    fprintf(stderr, "[pso-library] saved %ld pipelines (+%ld) %.1f MB: serialize %.1f ms, write %.1f ms (%s); "
+                    "session: %ld loaded (longest load %.2f ms), %ld created, %ld loads skipped during a save\n",
+            (long)pipes, (long)dirty, (double)n / 1048576.0, (double)(t1 - t0) / 1000.0,
+            (double)(ld_psolib_now_us() - t1) / 1000.0, why, (long)g_psolib.loads,
+            (double)g_psolib.load_max_us / 1000.0, (long)g_psolib.creates, (long)g_psolib.load_skips);
+    return 1;
+}
+
+static DWORD LD_THREAD_CC ld_psolib_save_thread(LPVOID arg)
+{
+    (void)arg;
+    /* below normal + background mode (CPU, I/O and memory priority): a save
+     * must never take time from the game's or Bink's boosted threads */
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN);
+    ld_psolib_save("background");
+    SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_END);
+    InterlockedExchange(&g_psolib.saving, 0);
+    return 0;
+}
+
+/* PS3_PSO_LIBRARY_OFF_FILE=<path> (same-boot A/B, polled once per frame):
+ * while <path> exists build_pso neither loads from nor stores into the
+ * library. Each switch drops the in-process PSO cache after a full GPU wait,
+ * so the next frames bind freshly created PSOs (off) or library copies (on). */
+static int g_psolib_ab_off;
+static void ld_pso_async_drain(void);
+static void ld_psolib_ab_poll(void)
+{
+    static const char* f = (const char*)-1;
+    if (f == (const char*)-1) f = getenv("PS3_PSO_LIBRARY_OFF_FILE");
+    if (!f) return;
+    struct stat st;
+    const int off = stat(f, &st) == 0;
+    if (off == g_psolib_ab_off) return;
+    g_psolib_ab_off = off;
+    ld_pso_async_drain();          /* PS3_PSO_ASYNC: no job may still point into g.psos */
+    ld_flush(LD_FLUSH_READBACK);   /* GPU idle, deferred list drained, state shadow cleared */
+    const u32 n = g.n_psos;
+    for (u32 i = 0; i < n; i++)
+        if (g.psos[i].pso) g.psos[i].pso->lpVtbl->Release(g.psos[i].pso);
+    g.n_psos = 0;
+    memset(g_ld_pso_index, 0, sizeof(g_ld_pso_index));
+    ld_pso_dedup_clear();
+    fprintf(stderr, "[pso-library] frame %u: library %s (PS3_PSO_LIBRARY_OFF_FILE); %u cached PSOs dropped\n",
+            g_ld_frames, off ? "OFF" : "on", n);
+}
+
+/* once per presented frame (render thread): queued stores, a due background save */
+static void ld_psolib_tick(void)
+{
+    if (g_psolib.state != 1) return;
+    ld_psolib_ab_poll();
+    if (g_psolib.n_pending && TryAcquireSRWLockExclusive(&g_psolib.lock)) {
+        ld_psolib_store_pending_locked();
+        ReleaseSRWLockExclusive(&g_psolib.lock);
+    }
+    const LONG d = g_psolib.dirty;
+    if (!d || g_psolib.saving) return;
+    const long long quiet = ld_psolib_now_us() - g_psolib.last_new_us;
+    if (quiet < 3000000 || (d < (LONG)g_psolib.save_n && quiet < 20000000)) return;
+    if (InterlockedCompareExchange(&g_psolib.saving, 1, 0) != 0) return;
+    HANDLE th = CreateThread(NULL, 0, ld_psolib_save_thread, NULL, 0, NULL);
+    if (th) CloseHandle(th);
+    else InterlockedExchange(&g_psolib.saving, 0);
+}
+
+void rsx_live_draw_save_pipelines(void)
+{
+    if (g_psolib.state != 1) return;
+    for (int i = 0; i < 500 && g_psolib.saving; i++) Sleep(10);   /* a background save in flight */
+    ld_psolib_save("exit");
+}
+static void ld_psolib_atexit(void) { rsx_live_draw_save_pipelines(); }
