+/*
+ * ps3recomp - live-draw overlay: debug lines + frame captures (see rsx_live_overlay.h)
+ * Windows (D3D12) and the vkd3d build of the live-draw renderer (native Linux: the same D3D12 code on vkd3d's
+ * headers + the Win32 shim); the browser build and renderer-less builds get the stubs.
+ */
+#if !defined(_WIN32) && !(defined(RSX_LIVE_VKD3D) && !defined(PS3_WASM))
+#include "rsx_live_overlay.h"
+
+int rsx_live_screenshot(const char* p, uint32_t f, rsx_live_shot_fn d, void* u)
+{ (void)p; (void)f; (void)d; (void)u; return -1; }
+int rsx_live_debug_lines(uint32_t o, const rsx_live_line* v, uint32_t n, uint32_t f)
+{ (void)o; (void)v; (void)n; (void)f; return -1; }
+
+#else /* _WIN32 || RSX_LIVE_VKD3D */
+
+#define _CRT_SECURE_NO_WARNINGS
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <d3dcompiler.h>
+#else
+#include "rsx_live_draw_vkd3d.h"   /* vkd3d's d3d12 / d3dcompiler headers + the Win32 shim */
+#include <strings.h>
+#endif
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "rsx_live_overlay.h"   /* after d3d12.h: declares the render-thread entry too */
+#include "rsx_live_draw.h"
+
+#define OV_OWNERS     16u
+#define OV_MAX_LINES  262144u
+#define OV_MAX_SHOTS  4
+
+volatile long g_ldov_active = 0;
+
+typedef struct { rsx_live_line* v; uint32_t n; uint32_t flags; } ov_set;
+typedef struct { char path[1024]; uint32_t flags; rsx_live_shot_fn done; void* user; } ov_shot;
+
+static SRWLOCK  s_lock = SRWLOCK_INIT;
+static ov_set   s_sets[OV_OWNERS];
+static uint32_t s_total;                    /* lines over all owners */
+static ov_set   s_tsets[OV_OWNERS];         /* RSX_LIVE_LINES_TRIS sets: vertex triples, drawn under the lines */
+static uint32_t s_ttotal;                   /* triangle vertices over all owners */
+
+/* PS3_LIVE_TRIS=0: kill switch for the triangle sets (TRIS sets and the QUERY answer are refused) */
+static int ov_tris_enabled(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("PS3_LIVE_TRIS");
+        v = (e && e[0] == '0' && !e[1]) ? 0 : 1;
+    }
+    return v;
+}
+static ov_shot  s_shots[OV_MAX_SHOTS];
+static int      s_nshots;
+
+static void ov_update_active(void)          /* under s_lock */
+{
+    InterlockedExchange(&g_ldov_active, (s_total || s_ttotal || s_nshots) ? 1 : 0);
+}
+
+int rsx_live_screenshot(const char* path, uint32_t flags, rsx_live_shot_fn done, void* user)
+{
+    if (!rsx_live_draw_enabled()) return -1;
+    if (!path || !*path || strlen(path) >= sizeof s_shots[0].path) return -3;
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_nshots >= OV_MAX_SHOTS) { ReleaseSRWLockExclusive(&s_lock); return -2; }
+    ov_shot* s = &s_shots[s_nshots++];
+    strcpy(s->path, path);
+    s->flags = flags; s->done = done; s->user = user;
+    ov_update_active();
+    ReleaseSRWLockExclusive(&s_lock);
+    return 0;
+}
+
+int rsx_live_debug_lines(uint32_t owner, const rsx_live_line* v, uint32_t n, uint32_t flags)
+{
+    if (!rsx_live_draw_enabled()) return -1;
+    if (flags & RSX_LIVE_LINES_QUERY)                   /* capability probe: 1 = triangle sets supported */
+        return (n == 0 && ov_tris_enabled()) ? 1 : -2;
+    const int tris = (flags & RSX_LIVE_LINES_TRIS) != 0;
+    if (owner >= OV_OWNERS || (n && !v)) return -2;
+    if (tris && (!ov_tris_enabled() || n % 3)) return -2;
+    rsx_live_line* copy = NULL;
+    if (n) {
+        copy = (rsx_live_line*)malloc((size_t)n * sizeof *copy);
+        if (!copy) return -2;
+        memcpy(copy, v, (size_t)n * sizeof *copy);
+    }
+    ov_set* sets = tris ? s_tsets : s_sets;
+    uint32_t* total = tris ? &s_ttotal : &s_total;
+    AcquireSRWLockExclusive(&s_lock);
+    if (*total - sets[owner].n + n > OV_MAX_LINES) {
+        ReleaseSRWLockExclusive(&s_lock);
+        free(copy);
+        return -2;
+    }
+    rsx_live_line* old = sets[owner].v;
+    *total = *total - sets[owner].n + n;
+    sets[owner].v = copy; sets[owner].n = n; sets[owner].flags = flags;
+    ov_update_active();
+    ReleaseSRWLockExclusive(&s_lock);
+    free(old);
+    return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* file writers (worker thread)                                              */
+
+static uint32_t s_crc_table[256];
+static void crc_init(void)
+{
+    for (uint32_t i = 0; i < 256; i++) {
+        uint32_t c = i;
+        for (int k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+        s_crc_table[i] = c;
+    }
+}
+static uint32_t crc_upd(uint32_t c, const uint8_t* p, size_t n)
+{
+    for (size_t i = 0; i < n; i++) c = s_crc_table[(c ^ p[i]) & 0xFF] ^ (c >> 8);
+    return c;
+}
+static void be32(uint8_t* p, uint32_t v) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+
+static int png_chunk(FILE* f, const char* type, const uint8_t* data, uint32_t n)
+{
+    uint8_t h[8];
+    be32(h, n); memcpy(h + 4, type, 4);
+    uint32_t c = crc_upd(0xFFFFFFFFu, (const uint8_t*)type, 4);
+    if (n) c = crc_upd(c, data, n);
+    uint8_t t[4]; be32(t, c ^ 0xFFFFFFFFu);
+    return fwrite(h, 1, 8, f) == 8 && (!n || fwrite(data, 1, n, f) == n) && fwrite(t, 1, 4, f) == 4;
+}
+
+/* 8-bit RGB PNG with stored (uncompressed) deflate blocks. */
+static int write_png(FILE* f, const uint8_t* rgb, uint32_t w, uint32_t h)
+{
+    static const uint8_t sig[8] = { 0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A };
+    if (fwrite(sig, 1, 8, f) != 8) return 0;
+    uint8_t ihdr[13];
+    be32(ihdr, w); be32(ihdr + 4, h);
+    ihdr[8] = 8; ihdr[9] = 2; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;
+    if (!png_chunk(f, "IHDR", ihdr, 13)) return 0;
+    const size_t row = (size_t)w * 3 + 1;
+    const size_t raw = row * h;
+    const size_t nblk = raw / 65535 + 1;
+    const size_t zn = 2 + raw + nblk * 5 + 4;
+    if (zn > 0x7FFFFFFFull) return 0;
+    uint8_t* z = (uint8_t*)malloc(zn);
+    if (!z) return 0;
+    size_t o = 0;
+    z[o++] = 0x78; z[o++] = 0x01;
+    uint32_t a = 1, b = 0;
+    size_t left = raw, y = 0, x = 0;   /* position in the filtered stream: row y, byte x */
+    while (left || o == 2) {
+        const uint16_t len = (uint16_t)(left > 65535 ? 65535 : left);
+        z[o++] = left <= 65535 ? 1 : 0;
+        z[o++] = (uint8_t)len; z[o++] = (uint8_t)(len >> 8);
+        z[o++] = (uint8_t)~len; z[o++] = (uint8_t)(~len >> 8);
+        for (uint32_t i = 0; i < len; i++) {
+            const uint8_t v = x == 0 ? 0 : rgb[y * (size_t)w * 3 + (x - 1)];
+            z[o++] = v;
+            a = (a + v) % 65521u; b = (b + a) % 65521u;
+            if (++x == row) { x = 0; y++; }
+        }
+        left -= len;
+        if (!len) break;
+    }
+    be32(z + o, (b << 16) | a); o += 4;
+    const int ok = png_chunk(f, "IDAT", z, (uint32_t)o) && png_chunk(f, "IEND", NULL, 0);
+    free(z);
+    return ok;
+}
+
+typedef struct {
+    ov_shot  shot;
+    uint8_t* rgb;
+    uint32_t w, h;
+} ov_job;
+
+/* thread entry: WINAPI on Windows; vkd3d build: the SysV CreateThread shim (vkd3d makes WINAPI ms_abi) */
+#if defined(_WIN32)
+#define OV_THREAD_CC WINAPI
+#define OV_STRICMP _stricmp
+#else
+#define OV_THREAD_CC
+#define OV_STRICMP strcasecmp
+#endif
+static DWORD OV_THREAD_CC ov_writer(LPVOID arg)
+{
+    ov_job* j = (ov_job*)arg;
+    int rc = -4;
+#if defined(_WIN32)
+    wchar_t wp[1024];
+    if (MultiByteToWideChar(CP_UTF8, 0, j->shot.path, -1, wp, 1024)) {
+        FILE* f = _wfopen(wp, L"wb");
+#else
+    {   /* the UTF-8 path as is */
+        FILE* f = fopen(j->shot.path, "wb");
+#endif
+        if (f) {
+            const size_t n = strlen(j->shot.path);
+            const int png = n > 4 && OV_STRICMP(j->shot.path + n - 4, ".png") == 0;
+            int ok;
+            if (png) ok = write_png(f, j->rgb, j->w, j->h);
+            else ok = fprintf(f, "P6\n%u %u\n255\n", j->w, j->h) > 0 &&
+                      fwrite(j->rgb, 1, (size_t)j->w * j->h * 3, f) == (size_t)j->w * j->h * 3;
+            if (fclose(f) != 0) ok = 0;
+            rc = ok ? 0 : -5;
+        }
+    }
+    fprintf(stderr, "[overlay] capture %s %ux%u: %s\n", j->shot.path, j->w, j->h,
+            rc == 0 ? "written" : "FAILED");
+    if (j->shot.done) j->shot.done(j->shot.path, rc, j->w, j->h, j->shot.user);
+    free(j->rgb);
+    free(j);
+    return 0;
+}
+
+static float half_to_float(uint16_t h)
+{
+    const uint32_t s = (uint32_t)(h >> 15) << 31, e = (h >> 10) & 0x1F, m = h & 0x3FF;
+    uint32_t u;
+    if (e == 0) { if (!m) u = s; else { float f = (float)m * (1.0f / 16777216.0f); return s ? -f : f; } }
+    else if (e == 31) u = s | 0x7F800000u | (m << 13);
+    else u = s | ((e + 112) << 23) | (m << 13);
+    float f; memcpy(&f, &u, 4);
+    return f;
+}
+
+static uint8_t to8(float v)
+{
+    if (!(v > 0.0f)) return 0;
+    if (v >= 1.0f) return 255;
+    return (uint8_t)(v * 255.0f + 0.5f);
+}
+
+/* Copy res (in `state`) to a readback buffer, wait, convert to RGB8. NULL on failure. */
+static uint8_t* ov_readback(ID3D12Device* dev, ID3D12GraphicsCommandList* list, ID3D12Resource* res,
+                            D3D12_RESOURCE_STATES state, DXGI_FORMAT fmt, uint32_t w, uint32_t h,
+                            void (*flush)(void))
+{
+    uint32_t texel;
+    switch (fmt) {
+    case DXGI_FORMAT_R8G8B8A8_UNORM: case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8A8_UNORM: case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_UNORM: texel = 4; break;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT: texel = 8; break;
+    default:
+        fprintf(stderr, "[overlay] capture: unsupported surface format %d\n", (int)fmt);
+        return NULL;
+    }
+    const uint32_t pitch = (w * texel + 255u) & ~255u;
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)pitch * h;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.Format = DXGI_FORMAT_UNKNOWN;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                                                    D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                                                    &IID_ID3D12Resource, (void**)&rb)))
+        return NULL;
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = res;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = state;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    list->lpVtbl->ResourceBarrier(list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src, dst;
+    memset(&src, 0, sizeof src); memset(&dst, 0, sizeof dst);
+    src.pResource = res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = fmt;
+    dst.PlacedFootprint.Footprint.Width = w;
+    dst.PlacedFootprint.Footprint.Height = h;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    list->lpVtbl->CopyTextureRegion(list, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = state;
+    list->lpVtbl->ResourceBarrier(list, 1, &b);
+    flush();
+    uint8_t* rgb = (uint8_t*)malloc((size_t)w * h * 3);
+    uint8_t* px = NULL;
+    D3D12_RANGE rr = { 0, (SIZE_T)pitch * h };
+    if (rgb && SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        const int bgr = fmt == DXGI_FORMAT_B8G8R8A8_UNORM || fmt == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB ||
+                        fmt == DXGI_FORMAT_B8G8R8X8_UNORM;
+        for (uint32_t y = 0; y < h; y++) {
+            const uint8_t* row = px + (size_t)y * pitch;
+            uint8_t* o = rgb + (size_t)y * w * 3;
+            for (uint32_t x = 0; x < w; x++, o += 3) {
+                if (texel == 4) {
+                    const uint8_t* p = row + x * 4;
+                    o[0] = bgr ? p[2] : p[0]; o[1] = p[1]; o[2] = bgr ? p[0] : p[2];
+                } else {
+                    uint16_t c[3]; memcpy(c, row + x * 8, 6);
+                    o[0] = to8(half_to_float(c[0])); o[1] = to8(half_to_float(c[1])); o[2] = to8(half_to_float(c[2]));
+                }
+            }
+        }
+        D3D12_RANGE wr = { 0, 0 };
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+    } else {
+        free(rgb);
+        rgb = NULL;
+    }
+    rb->lpVtbl->Release(rb);
+    return rgb;
+}
+
+static void ov_finish(const ov_shot* s, uint8_t* rgb, uint32_t w, uint32_t h)
+{
+    ov_job* j = (ov_job*)calloc(1, sizeof *j);
+    if (!j || !rgb) {
+        fprintf(stderr, "[overlay] capture %s: FAILED (readback)\n", s->path);
+        if (s->done) s->done(s->path, -4, 0, 0, s->user);
+        free(j); free(rgb);
+        return;
+    }
+    j->shot = *s; j->rgb = rgb; j->w = w; j->h = h;
+    HANDLE t = CreateThread(NULL, 0, ov_writer, j, 0, NULL);
+    if (t) CloseHandle(t);
+    else ov_writer(j);
+}
+
+/* ------------------------------------------------------------------------ */
+/* line pass                                                                 */
+
+static const char s_line_hlsl[] =
+"cbuffer C : register(b0) { float4 k; };\n"
+"struct VI { float2 p : POSITION; float4 c : COLOR; };\n"
+"struct VO { float4 pos : SV_Position; float4 c : COLOR; };\n"
+"VO vs_main(VI i) { VO o; o.pos = float4(i.p.x * k.x - 1.0, 1.0 - i.p.y * k.y, 0.0, 1.0); o.c = i.c; return o; }\n"
+"float4 ps_main(VO i) : SV_Target { return i.c; }\n";
+
+static ID3D12RootSignature* s_rs;
+static ID3D12PipelineState* s_pso;
+static int                  s_pso_failed;
+static ID3D12Resource*      s_vb;
+static ID3D12Resource*      s_vb_old;      /* released one present later (the GPU is done by then) */
+static uint8_t*             s_vb_map;
+static size_t               s_vb_cap;
+static float*               s_verts;       /* staging, 3 floats per vertex (x, y, rgba bits) */
+static size_t               s_verts_cap;
+
+static ID3DBlob* ov_compile(const char* entry, const char* target)
+{
+    ID3DBlob* blob = NULL;
+    ID3DBlob* err = NULL;
+    if (FAILED(D3DCompile(s_line_hlsl, sizeof s_line_hlsl - 1, "ldov_lines", NULL, NULL, entry, target,
+                          D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &blob, &err))) {
+        fprintf(stderr, "[overlay] line shader %s: %s\n", entry,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "compile failed");
+        if (blob) blob->lpVtbl->Release(blob);
+        blob = NULL;
+    }
+    if (err) err->lpVtbl->Release(err);
+    return blob;
+}
+
+static int ov_pso(ID3D12Device* dev)
+{
+    if (s_pso) return 1;
+    if (s_pso_failed) return 0;
+    s_pso_failed = 1;
+    D3D12_ROOT_PARAMETER rp; memset(&rp, 0, sizeof rp);
+    rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp.Constants.ShaderRegister = 0; rp.Constants.Num32BitValues = 4;
+    rp.ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    D3D12_ROOT_SIGNATURE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.NumParameters = 1; rd.pParameters = &rp;
+    rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ID3DBlob* sig = NULL;
+    ID3DBlob* err = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err)) ||
+        FAILED(dev->lpVtbl->CreateRootSignature(dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature,
+                                                (void**)&s_rs))) {
+        fprintf(stderr, "[overlay] root signature failed\n");
+        if (sig) sig->lpVtbl->Release(sig);
+        if (err) err->lpVtbl->Release(err);
+        return 0;
+    }
+    sig->lpVtbl->Release(sig);
+    if (err) err->lpVtbl->Release(err);
+    ID3DBlob* vs = ov_compile("vs_main", "vs_5_0");
+    ID3DBlob* ps = ov_compile("ps_main", "ps_5_0");
+    if (!vs || !ps) {
+        if (vs) vs->lpVtbl->Release(vs);
+        if (ps) ps->lpVtbl->Release(ps);
+        return 0;
+    }
+    static const D3D12_INPUT_ELEMENT_DESC il[2] = {
+        { "POSITION", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 0, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "COLOR", 0, DXGI_FORMAT_R8G8B8A8_UNORM, 0, 8, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+    };
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_rs;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    D3D12_RENDER_TARGET_BLEND_DESC* bt = &pd.BlendState.RenderTarget[0];
+    bt->BlendEnable = TRUE;
+    bt->SrcBlend = D3D12_BLEND_SRC_ALPHA; bt->DestBlend = D3D12_BLEND_INV_SRC_ALPHA; bt->BlendOp = D3D12_BLEND_OP_ADD;
+    bt->SrcBlendAlpha = D3D12_BLEND_ONE; bt->DestBlendAlpha = D3D12_BLEND_INV_SRC_ALPHA; bt->BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    bt->LogicOp = D3D12_LOGIC_OP_NOOP;
+    bt->RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.InputLayout.pInputElementDescs = il; pd.InputLayout.NumElements = 2;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pd.SampleDesc.Count = 1;
+    HRESULT hr = dev->lpVtbl->CreateGraphicsPipelineState(dev, &pd, &IID_ID3D12PipelineState, (void**)&s_pso);
+    vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+    if (FAILED(hr)) { s_pso = NULL; fprintf(stderr, "[overlay] line PSO failed hr=0x%08lX\n", (unsigned long)hr); return 0; }
+    s_pso_failed = 0;
+    fprintf(stderr, "[overlay] debug line pass ready\n");
+    return 1;
+}
+
+static size_t ov_build(uint32_t bb_w, uint32_t bb_h)   /* under s_lock; returns vertices */
+{
+    const size_t need = ((size_t)s_total * 6 + s_ttotal) * 3;
+    if (need > s_verts_cap) {
+        float* nv = (float*)realloc(s_verts, need * sizeof *nv);
+        if (!nv) return 0;
+        s_verts = nv; s_verts_cap = need;
+    }
+    size_t nv = 0;
+    for (uint32_t o = 0; o < OV_OWNERS; o++) {          /* triangle sets first: lines draw over them */
+        const ov_set* set = &s_tsets[o];
+        const int ndc = (set->flags & RSX_LIVE_LINES_NDC) != 0;
+        for (uint32_t i = 0; i + 2 < set->n; i += 3) {
+            float px[3][2];
+            int ok = 1;
+            for (int k = 0; k < 3; k++) {
+                float x = set->v[i + k].x0, y = set->v[i + k].y0;
+                if (ndc) { x = (x + 1.0f) * 0.5f * (float)bb_w; y = (1.0f - y) * 0.5f * (float)bb_h; }
+                if (!isfinite(x) || !isfinite(y)) ok = 0;
+                px[k][0] = x; px[k][1] = y;
+            }
+            if (!ok) continue;
+            for (int k = 0; k < 3; k++) {
+                const uint32_t c = set->v[i + k].rgba;
+                const uint32_t abgr = (c >> 24) | ((c >> 8) & 0xFF00u) | ((c << 8) & 0xFF0000u) | (c << 24);
+                float cf; memcpy(&cf, &abgr, 4);
+                float* vv = s_verts + nv * 3;
+                vv[0] = px[k][0]; vv[1] = px[k][1]; vv[2] = cf;
+                nv++;
+            }
+        }
+    }
+    for (uint32_t o = 0; o < OV_OWNERS; o++) {
+        const ov_set* set = &s_sets[o];
+        const int ndc = (set->flags & RSX_LIVE_LINES_NDC) != 0;
+        for (uint32_t i = 0; i < set->n; i++) {
+            const rsx_live_line* l = &set->v[i];
+            float x0 = l->x0, y0 = l->y0, x1 = l->x1, y1 = l->y1;
+            if (ndc) {
+                x0 = (x0 + 1.0f) * 0.5f * (float)bb_w; y0 = (1.0f - y0) * 0.5f * (float)bb_h;
+                x1 = (x1 + 1.0f) * 0.5f * (float)bb_w; y1 = (1.0f - y1) * 0.5f * (float)bb_h;
+            }
+            const float dx = x1 - x0, dy = y1 - y0, len = sqrtf(dx * dx + dy * dy);
+            if (!(len > 1e-4f) || !isfinite(len)) continue;
+            const float hw = 0.5f * (l->width > 0.0f ? l->width : 1.5f);
+            const float nx = -dy / len * hw, ny = dx / len * hw;
+            const float ex = dx / len * hw * 0.5f, ey = dy / len * hw * 0.5f;   /* small end caps */
+            const float px[4][2] = { { x0 - ex + nx, y0 - ey + ny }, { x0 - ex - nx, y0 - ey - ny },
+                                     { x1 + ex + nx, y1 + ey + ny }, { x1 + ex - nx, y1 + ey - ny } };
+            const uint32_t c = l->rgba;
+            const uint32_t abgr = (c >> 24) | ((c >> 8) & 0xFF00u) | ((c << 8) & 0xFF0000u) | (c << 24);
+            float cf; memcpy(&cf, &abgr, 4);
+            static const int tri[6] = { 0, 1, 2, 2, 1, 3 };
+            for (int k = 0; k < 6; k++) {
+                float* v = s_verts + nv * 3;
+                v[0] = px[tri[k]][0]; v[1] = px[tri[k]][1]; v[2] = cf;
+                nv++;
+            }
+        }
+    }
+    return nv;
+}
+
+static void ov_draw(ID3D12Device* dev, ID3D12GraphicsCommandList* list, ID3D12Resource* bb,
+                    D3D12_CPU_DESCRIPTOR_HANDLE rtv, uint32_t w, uint32_t h, size_t nv)
+{
+    if (!nv || !ov_pso(dev)) return;
+    if (s_vb_old) { s_vb_old->lpVtbl->Release(s_vb_old); s_vb_old = NULL; }
+    const size_t bytes = nv * 12;
+    if (bytes > s_vb_cap) {
+        size_t cap = s_vb_cap ? s_vb_cap : (1u << 20);
+        while (cap < bytes) cap *= 2;
+        D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = cap; bd.Height = 1;
+        bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        ID3D12Resource* vb = NULL;
+        if (FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                                                        D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                                                        &IID_ID3D12Resource, (void**)&vb)))
+            return;
+        uint8_t* map = NULL;
+        D3D12_RANGE none = { 0, 0 };
+        if (FAILED(vb->lpVtbl->Map(vb, 0, &none, (void**)&map))) { vb->lpVtbl->Release(vb); return; }
+        s_vb_old = s_vb;
+        s_vb = vb; s_vb_map = map; s_vb_cap = cap;
+    }
+    memcpy(s_vb_map, s_verts, bytes);   /* the previous frame's draw has completed (present flush waits) */
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = bb;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    list->lpVtbl->ResourceBarrier(list, 1, &b);
+    list->lpVtbl->OMSetRenderTargets(list, 1, &rtv, FALSE, NULL);
+    D3D12_VIEWPORT vp = { 0.0f, 0.0f, (float)w, (float)h, 0.0f, 1.0f };
+    D3D12_RECT sc = { 0, 0, (LONG)w, (LONG)h };
+    list->lpVtbl->RSSetViewports(list, 1, &vp);
+    list->lpVtbl->RSSetScissorRects(list, 1, &sc);
+    list->lpVtbl->SetGraphicsRootSignature(list, s_rs);
+    const float k[4] = { 2.0f / (float)w, 2.0f / (float)h, 0.0f, 0.0f };
+    list->lpVtbl->SetGraphicsRoot32BitConstants(list, 0, 4, k, 0);
+    list->lpVtbl->SetPipelineState(list, s_pso);
+    list->lpVtbl->IASetPrimitiveTopology(list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    D3D12_VERTEX_BUFFER_VIEW vbv;
+    vbv.BufferLocation = s_vb->lpVtbl->GetGPUVirtualAddress(s_vb);
+    vbv.SizeInBytes = (UINT)bytes; vbv.StrideInBytes = 12;
+    list->lpVtbl->IASetVertexBuffers(list, 0, 1, &vbv);
+    list->lpVtbl->DrawInstanced(list, (UINT)nv, 1, 0, 0);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    list->lpVtbl->ResourceBarrier(list, 1, &b);
+}
+
+void ldov_present(ID3D12Device* dev, ID3D12GraphicsCommandList* list,
+                  ID3D12Resource* bb, D3D12_CPU_DESCRIPTOR_HANDLE bb_rtv, uint32_t bb_w, uint32_t bb_h,
+                  ID3D12Resource* guest_rt, DXGI_FORMAT guest_fmt, uint32_t guest_w, uint32_t guest_h,
+                  void (*flush_readback)(void))
+{
+    static int crc_ready;
+    if (!crc_ready) { crc_init(); crc_ready = 1; }
+    ov_shot shots[OV_MAX_SHOTS];
+    AcquireSRWLockExclusive(&s_lock);
+    const int ns = s_nshots;
+    memcpy(shots, s_shots, sizeof shots);
+    s_nshots = 0;
+    const size_t nv = ov_build(bb_w, bb_h);
+    ov_update_active();
+    ReleaseSRWLockExclusive(&s_lock);
+
+    for (int i = 0; i < ns; i++) {
+        if (!(shots[i].flags & RSX_LIVE_SHOT_GUEST)) continue;
+        uint8_t* rgb = guest_rt ? ov_readback(dev, list, guest_rt, D3D12_RESOURCE_STATE_RENDER_TARGET, guest_fmt,
+                                              guest_w, guest_h, flush_readback) : NULL;
+        ov_finish(&shots[i], rgb, guest_w, guest_h);
+    }
+    ov_draw(dev, list, bb, bb_rtv, bb_w, bb_h, nv);
+    for (int i = 0; i < ns; i++) {
+        if (shots[i].flags & RSX_LIVE_SHOT_GUEST) continue;
+        uint8_t* rgb = ov_readback(dev, list, bb, D3D12_RESOURCE_STATE_PRESENT, DXGI_FORMAT_R8G8B8A8_UNORM,
+                                   bb_w, bb_h, flush_readback);
+        ov_finish(&shots[i], rgb, bb_w, bb_h);
+    }
+}
+
+#endif /* _WIN32 || RSX_LIVE_VKD3D */
diff --git a/libs/video/rsx_live_overlay.h b/libs/video/rsx_live_overlay.h
new file mode 100644
index 00000000..797d09ac
--- /dev/null
+++ b/libs/video/rsx_live_overlay.h
@@ -0,0 +1,77 @@
+/*
+ * ps3recomp - live-draw overlay: host debug lines over the presented frame and
+ * frame captures on request (editor live link; plugin ABI 1.2 screenshot /
+ * debug_lines, runtime/ppu/ppu_mod_loader.cpp).
+ *
+ * Nothing here runs unless asked: with no lines and no capture pending, the
+ * present hook is one load + branch. D3D12 live-draw backend only (the other
+ * backends answer -1).
+ *
+ * Captures are written by a worker thread: .png (8-bit RGB, stored deflate --
+ * large but lossless; recompress offline) or .ppm (P6) by extension.
+ */
+#ifndef PS3RECOMP_RSX_LIVE_OVERLAY_H
+#define PS3RECOMP_RSX_LIVE_OVERLAY_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Completion of a capture: result 0 = written, < 0 = failed. Called on the
+ * writer thread, once per request. path is valid during the call. */
+typedef void (*rsx_live_shot_fn)(const char* path, int result, uint32_t w, uint32_t h, void* user);
+
+enum {
+    RSX_LIVE_SHOT_GUEST = 1u << 0   /* the guest's presented render target (render-scale size, no
+                                       FXAA/resample, no overlay) instead of the backbuffer */
+};
+
+/* Capture the next presented frame to path_utf8. Any thread. 0 = queued,
+ * -1 = no live-draw backend, -2 = too many captures pending (4), -3 = bad path. */
+int rsx_live_screenshot(const char* path_utf8, uint32_t flags, rsx_live_shot_fn done, void* user);
+
+typedef struct rsx_live_line {
+    float    x0, y0, x1, y1;   /* backbuffer pixels (0,0 = top left), or NDC with RSX_LIVE_LINES_NDC */
+    uint32_t rgba;             /* 0xRRGGBBAA */
+    float    width;            /* pixels; <= 0 = 1.5 */
+} rsx_live_line;
+
+enum {
+    RSX_LIVE_LINES_NDC = 1u << 0,  /* x, y in -1..1, +y up */
+    RSX_LIVE_LINES_TRIS = 1u << 1, /* the array is triangles: 3 entries per triangle, each one vertex (x0, y0 =
+                                      position, rgba = its colour; x1, y1, width unused); a separate set per
+                                      owner, drawn under the lines (alpha blended, no depth); n % 3 == 0.
+                                      Kill switch PS3_LIVE_TRIS=0 (refused, -2) */
+    RSX_LIVE_LINES_QUERY = 1u << 2 /* with n = 0: returns 1 when TRIS sets are supported (older runtimes: 0) */
+};
+
+/* Replace the line set of `owner` (0..15, e.g. a plugin slot); n = 0 clears it.
+ * Any thread; the array is copied; drawn over every presented frame until
+ * replaced. 0 = OK, -1 = no backend, -2 = bad owner / too many lines (262144). */
+int rsx_live_debug_lines(uint32_t owner, const rsx_live_line* v, uint32_t n, uint32_t flags);
+
+#if (defined(_WIN32) && defined(__d3d12_h__)) || \
+    (defined(RSX_LIVE_VKD3D) && !defined(PS3_WASM) && !defined(_WIN32) && defined(__vkd3d_d3d12_h__))
+/* Render thread, from rsx_live_draw_present() right before the present flush.
+ * bb is in PRESENT state on entry and on return; guest_rt (may be NULL) is the
+ * presented guest surface in RENDER_TARGET state. flush_readback() submits the
+ * list, waits for the GPU and leaves the list open (ld_flush). */
+void ldov_present(ID3D12Device* dev, ID3D12GraphicsCommandList* list,
+                  ID3D12Resource* bb, D3D12_CPU_DESCRIPTOR_HANDLE bb_rtv, uint32_t bb_w, uint32_t bb_h,
+                  ID3D12Resource* guest_rt, DXGI_FORMAT guest_fmt, uint32_t guest_w, uint32_t guest_h,
+                  void (*flush_readback)(void));
+/* Fast gate: 1 while lines are set or a capture is pending. */
+extern volatile long g_ldov_active;
+#elif !defined(_WIN32)
+/* Windows + the vkd3d build only (rsx_live_overlay.c); off in the WebGPU build and where d3d12 is not included. */
+#define g_ldov_active 0L
+#define ldov_present(...) ((void)0)
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_RSX_LIVE_OVERLAY_H */
