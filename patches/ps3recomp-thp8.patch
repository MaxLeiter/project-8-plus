+/*
+ * ps3recomp - pad_map_test.c on Linux: the same checks against the POSIX pad pipeline (cellPad.c PAD_XI_SDL:
+ * SDL GameController feeding the XInput code -- button table, PS3_PAD_MAP, slot map, test controllers).
+ *
+ *   gcc -O1 -w -D_GNU_SOURCE -I. -Iinclude -Ilibs/input -I/usr/include/SDL2 libs/input/tests/pad_map_test_posix.c -lSDL2 -lm
+ *   SDL_VIDEODRIVER=dummy ./a.out      -> "pad_map_test: N checks, 0 failed"
+ * (2026-10-18, WSL1 Ubuntu 26.04, SDL 2.32.10: slotmap 29/0, map 209/0.)
+ */
+#include <stdlib.h>
+#include "runtime/platform/win32_compat.h"
+static inline DWORD GetTempPathA(DWORD n, char* buf) { snprintf(buf, n, "/tmp/"); return (DWORD)strlen(buf); }
+static inline int SetEnvironmentVariableA(const char* k, const char* v) { return (v ? setenv(k, v, 1) : unsetenv(k)) == 0; }
+void cellGcm_inputlat_poll(void) {}   /* cellGcmSys.c (PS3_INPUT_LAT), not linked here */
+#include "pad_map_test.c"
diff --git a/libs/input/tests/pad_slotmap_test.c b/libs/input/tests/pad_slotmap_test.c
new file mode 100644
index 00000000..513d8b8e
--- /dev/null
+++ b/libs/input/tests/pad_slotmap_test.c
@@ -0,0 +1,158 @@
+/*
+ * ps3recomp - unit test for cellPad's guest-port assignment of XInput controllers (hot-plug, 2 players,
+ * virtual pads) and the virtual test controllers (PAD_TEST_XINPUT_OFF / PAD_TEST_VPAD / _FILE).
+ * No window, no controller (real XInput is switched off), no guest. Windows only.
+ *
+ *   clang-cl -nologo -O1 -D_CRT_SECURE_NO_WARNINGS -I. -Iinclude libs/input/tests/pad_slotmap_test.c user32.lib
+ *   pad_slotmap_test.exe        -> "pad_slotmap_test: N checks, 0 failed", exit 0
+ */
+#include <stdint.h>
+#include <stdio.h>
+
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void cellGcm_inputlat_poll(void) {}
+
+#include "../cellPad.c"
+#include "../pad_keyboard.c"
+#include "../host_input.c"
+
+static int s_checks, s_failed;
+#define CHECK(cond, ...) do { s_checks++; if (!(cond)) { s_failed++; printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+                              printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static char s_file[MAX_PATH];
+
+static void put(const char* path, const char* line)
+{
+    FILE* f = fopen(path, "wb");
+    if (f) { fputs(line, f); fclose(f); }
+}
+
+static void sweep(void) { pad_poll_xinput(); }   /* one host sweep (no 4 ms poll interval) */
+
+/* virtual controller k: plugged in (from now) / pulled */
+static void plug(int k, int slot)
+{
+    const double t = (double)(pad_now_ms() - s_vpad_t0) / 1000.0;
+    s_vpad[k].slot = slot; s_vpad[k].on = t - 0.001; s_vpad[k].off = -1.0;
+}
+static void pull(int k) { s_vpad[k].on = 0.0; s_vpad[k].off = 0.0; }
+static void press(int k, const char* line) { put(s_vpad[k].file, line); }
+
+static void reset_map(void)
+{
+    memset(s_slot, 0, sizeof s_slot);
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) { s_port_slot[p] = -1; s_port_mem[p] = 0; }
+    for (int k = 0; k < s_n_vpad; k++) { pull(k); memset(&s_vpad[k].held, 0, sizeof s_vpad[k].held); s_vpad[k].until = 0; }
+    sweep();
+}
+
+int main(void)
+{
+    char tmp[MAX_PATH], f2[MAX_PATH + 8], f3[MAX_PATH + 8];
+    GetTempPathA(sizeof tmp, tmp);
+    snprintf(s_file, sizeof s_file, "%spad_slotmap_test.txt", tmp);   /* reused by every run */
+    snprintf(f2, sizeof f2, "%s.0", s_file);
+    snprintf(f3, sizeof f3, "%s.3", s_file);
+    put(s_file, ""); put(f2, ""); put(f3, "");
+    /* three virtual controllers: k0 an Xbox Series pad that turns up on slot 2 0.3 s in; k1 a ViGEm-style
+       Xbox 360 pad on slot 0 from the start; k2 another Series pad (slot 3, not plugged until used below) */
+    SetEnvironmentVariableA("PAD_TEST_XINPUT_OFF", "1");
+    SetEnvironmentVariableA("PAD_TEST_VPAD", "2:0.3,0:1e9:045E:028E,3:1e9");
+    SetEnvironmentVariableA("PAD_TEST_VPAD_FILE", s_file);
+    SetEnvironmentVariableA("PAD_NO_KEYBOARD", "1");
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) pad_host_idle(&s_host_state[i]);
+
+    /* ---- 1. hot-plug on slot 2 -> port 0 */
+    sweep();
+    CHECK(s_n_vpad == 3 && s_vpad[1].vid == 0x045E && s_vpad[1].pid == 0x028E, "PAD_TEST_VPAD parsed (%d)", s_n_vpad);
+    CHECK(!s_host_state[0].connected && !s_host_state[2].connected, "nothing connected before the hot-plug");
+    CHECK(s_xinput_mask == 0, "xinput mask 0 before (got 0x%X)", s_xinput_mask);
+    Sleep(400);
+    sweep();
+    CHECK(s_host_state[0].connected && s_port_slot[0] == 2, "the hot-plugged controller (slot 2) is port 0 (%d)", s_port_slot[0]);
+    CHECK(!s_host_state[2].connected, "port 2 stays empty");
+    CHECK(s_xinput_mask == 4u, "xinput mask = slot 2 (got 0x%X)", s_xinput_mask);
+    CHECK(pad_port_slot(0) == 2 && pad_port_slot(1) == -1, "rumble goes to slot 2");
+    CHECK(s_host_state[0].analog_lx == 0x80 && s_host_state[0].buttons == 0, "idle pad: centred, no buttons");
+    press(0, "0x1000 0 32767 0\n");        /* A held, left stick right */
+    sweep();
+    CHECK(s_host_state[0].buttons & CELL_PAD_CTRL_CROSS, "A -> CROSS on port 0 (buttons 0x%04X)", s_host_state[0].buttons);
+    CHECK(s_host_state[0].press_cross == 255, "A pressure 255");
+    CHECK(s_host_state[0].analog_lx == 255, "stick right -> lx 255 (got %u)", s_host_state[0].analog_lx);
+    CHECK(s_last_dev == PAD_DEV_XINPUT, "device tracking: controller in use");
+    press(0, "0 30\n");
+    sweep();
+    CHECK(!(s_host_state[0].buttons & CELL_PAD_CTRL_CROSS), "A released");
+    Sleep(50);
+    sweep();
+    CHECK(s_host_state[0].buttons == 0 && s_host_state[0].analog_lx == 0x80, "pulse over: idle");
+    s_slotmap = 0;                         /* the old 1:1 mapping: the same controller is port 2 */
+    sweep();
+    CHECK(!s_host_state[0].connected && s_host_state[2].connected, "PS3_PAD_SLOTMAP=0: slot 2 = port 2");
+    s_slotmap = 1;
+    sweep();
+    CHECK(s_host_state[0].connected && s_port_slot[0] == 2, "slot map again: port 0");
+    pull(0);
+    sweep();
+    CHECK(!s_host_state[0].connected && s_port_slot[0] == -1, "unplugged: port 0 free");
+    plug(0, 1);
+    sweep();
+    CHECK(s_host_state[0].connected && s_port_slot[0] == 1, "re-plugged on slot 1: port 0 (got %d)", s_port_slot[0]);
+
+    /* ---- 2. an idle virtual (ViGEm 360) pad on slot 0 never takes port 0 from the real pad on slot 1 */
+    reset_map();
+    plug(1, 0);                            /* the virtual one first, on slot 0 */
+    sweep();
+    CHECK(s_port_slot[0] == -1 && !s_host_state[0].connected, "idle virtual pad: no port");
+    plug(0, 1);                            /* the user's real pad arrives on slot 1 */
+    sweep();
+    CHECK(s_port_slot[0] == 1, "real pad on slot 1 -> port 0 (got %d)", s_port_slot[0]);
+    CHECK(s_port_slot[1] == -1, "virtual pad still waiting");
+    press(1, "0x1000 0\n");                /* someone uses the virtual pad (Sunshine stream): it becomes port 1 */
+    sweep();
+    CHECK(s_port_slot[1] == 0 && (s_host_state[1].buttons & CELL_PAD_CTRL_CROSS), "used virtual pad -> port 1 with its press");
+    CHECK(s_port_slot[0] == 1, "the real pad keeps port 0");
+    press(1, "0 1\n"); Sleep(5); sweep();
+
+    /* ---- 3. two real pads at start-up: ports 0 / 1 in slot order; 4. pulling player 1 never swaps */
+    reset_map();
+    plug(0, 0); plug(2, 3);
+    sweep();
+    CHECK(s_port_slot[0] == 0 && s_port_slot[1] == 3, "two pads: slot 0 -> port 0, slot 3 -> port 1 (%d %d)",
+          s_port_slot[0], s_port_slot[1]);
+    pull(0);
+    sweep();
+    CHECK(s_port_slot[0] == -1 && s_port_slot[1] == 3, "player 1 pulled: port 0 free, player 2 stays port 1");
+    plug(1, 1); press(1, "0x1000 30\n");   /* a virtual pad is used meanwhile: not on player 1's port */
+    sweep();
+    CHECK(s_port_slot[0] == -1 && s_port_slot[2] == 1, "used virtual pad takes port 2, not player 1's port 0 (%d %d)",
+          s_port_slot[0], s_port_slot[2]);
+    plug(0, 0);                            /* player 1 back on its slot */
+    sweep();
+    CHECK(s_port_slot[0] == 0 && s_port_slot[1] == 3, "player 1 back -> port 0, player 2 port 1");
+    pull(0); pull(1);
+    sweep();
+    plug(0, 2);                            /* player 1 back on ANOTHER slot (same ids) */
+    sweep();
+    CHECK(s_port_slot[0] == 2 && s_port_slot[1] == 3, "player 1 back on slot 2 -> port 0 again (%d)", s_port_slot[0]);
+    pull(2);                               /* player 2 leaves, player 1 alone */
+    sweep();
+    pull(0);
+    sweep();
+    plug(2, 0);                            /* alone: player 2's pad (it had port 1) comes back -> port 0 */
+    sweep();
+    CHECK(s_port_slot[0] == 0 && s_port_slot[1] == -1, "alone: the pad gets port 0, not its old port 1 (%d %d)",
+          s_port_slot[0], s_port_slot[1]);
+
+    printf("pad_slotmap_test: %d checks, %d failed\n", s_checks, s_failed);
+    return s_failed ? 1 : 0;
+}
