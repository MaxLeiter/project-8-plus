+++ b/tools/liftdiff/liftdiff.py
@@ -0,0 +1,1010 @@
+#!/usr/bin/env python3
+"""liftdiff -- differential test harness for two lifts of the same PS3 PPU binary.
+
+Proves that lift B (e.g. an optimized code generator) behaves bit-identically to
+lift A (the reference) on randomized inputs, one guest function at a time.
+
+    python liftdiff.py --a DIR_A --b DIR_B --elf EBOOT.elf \
+        (--funcs N [--sel-seed S] | --func-list FILE) [--seeds K] [--clobber abi|all] \
+        [--slowmem] [--icall] [--opt KEY=VAL ...] [--closure 0|1] \
+        [--work WORKDIR] [-j J] [--timeout-ms MS] [--explain N] \
+        [--cflags-b FLAGS] [--save-selection FILE] [--build-only]
+
+    --funcs N        N functions stratified over features seen in A's text (direct /
+                     indirect calls, trampolines, loops, FP, VMX, record-form CR,
+                     jump tables, lwarx/stwcx, sc, plain, large); import stubs skipped
+    --func-list F    explicit addresses (hex, first token per line; '#' comments)
+    --slowmem        harness option SLOWMEM=1: ppu_line_flags[*] = 3 (B's slow path)
+    --icall          ICALL=1: ppu_icall_tab maps every func_X of the build (B fast path)
+    --opt K=V        any harness_rt.cpp option: CLOBBER, SLOWMEM=1|ld|st, ICALL,
+                     TRACELIMIT, MEMLIMIT (MB), BSS=0|1, DEMAND=pattern|zero
+    --cflags-b F     extra clang-cl flags for B only (A vs A under another optimizer)
+
+DIR_A / DIR_B are `ppu_lifter.py -o DIR` outputs (ppu_recomp.h + ppu_recomp_NNN.cpp).
+For each variant ONE test executable is built from: lds_driver.cpp + harness_rt.cpp
+(runtime stubs) + the selected functions cut textually out of that variant's own
+chunks (with that variant's own chunk preamble and header) + generated lds_gen.cpp
+(a stub for every func_X the selection references but does not define, the
+test-entry table). Selected functions are renamed lds_T_X so every call -- self
+calls included -- goes to a stub; --closure 1 also links the direct callees for real.
+
+Each test = (function, seed). The driver seeds a pointer-rich 16 MB heap, 1 MB
+stack and the ELF's .bss (per seed), fills any other touched 64 KB granule with the
+same mix (per seed+address; the null granule stays zero), seeds all registers (per
+function+seed; r1 = stack, r2 = the function's TOC from the OPD table, r13 fixed),
+runs the function the way the runtime does (func(ctx); drain g_trampoline_fn), and
+reports
+    status (OK / HANG / AV / MEMLIMIT / TRACELIMIT / STKOVF / EXC:code / CRASH)
+    regs   hash of the final register file (incl. reserve_*)
+    mem    hash of every guest page that differs from the pristine image
+    trace  hash of the stub-call sequence (kind, target, hash of ALL registers at entry)
+Stubbed callees / ps3_indirect_call / ps3_hle_call / lv2_syscall clobber registers
+deterministically from their entry state (CLOBBER=abi|all) and write 8 bytes
+through r3 when it points into the heap, so A and B agree iff they hand callees
+the same state and use the results the same way.
+
+Comparison: OK vs OK compares regs, mem, trace; AV / MEMLIMIT / TRACELIMIT / EXC
+compare status + trace; HANG / STKOVF / CRASH compare status only. A test that hangs
+in one variant only is re-run on both with --hang-factor x the timeout first. Up to
+--explain mismatches are re-run with full dumps to name the first differing
+register, the first differing trace event (and which entry registers differ) and the
+first differing memory byte. Report: WORKDIR/runs/<stamp>/report.txt + report.json.
+
+Builds are cached by content hash (WORKDIR/objcache, WORKDIR/exe): a rerun only
+recompiles translation units whose text changed. Exit code: 0 all match,
+1 any mismatch, 2 usage/build error.
+"""
+import argparse
+import hashlib
+import json
+import os
+import queue
+import random
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+HARNESS_SRCS = ["lds_driver.cpp", "harness_rt.cpp"]
+HARNESS_HDRS = ["lds_rt.h"]
+# MSVC/clang-cl environment script of the title project (env LIFTDIFF_DEVENV), e.g. <project>\tools\devenv.cmd
+DEFAULT_DEVENV = os.environ.get("LIFTDIFF_DEVENV", "")
+
+CXXFLAGS = ["/nologo", "-O2", "-fno-strict-aliasing", "-msse4.1", "/clang:-ffp-contract=off",
+            "-std:c++20", "/EHsc-", "/bigobj"]
+LINKFLAGS = ["/nologo", "/STACK:67108864", "/INCREMENTAL:NO", "/SUBSYSTEM:CONSOLE", "kernel32.lib"]
+PRIO = getattr(subprocess, "BELOW_NORMAL_PRIORITY_CLASS", 0)
+
+FEATURES = ["direct_call", "indirect_call", "trampoline", "loop", "fp", "vmx",
+            "record_cr", "jumptable", "atomic", "syscall"]
+STATUS_ONLY = {"HANG", "STKOVF", "CRASH"}
+STARTUP_GRACE = 180.0     # s until a driver's first output line (heavily loaded shared machine)
+
+DEF_RE = re.compile(rb"^(?P<pre>[A-Za-z_][^(\n;]*?)\bfunc_(?P<a>[0-9A-Fa-f]{8})\s*\((?P<params>[^)]*)\)"
+                    rb"(?P<post>[^;{\n]*)\{(?P<rest>[^\n]*)$")
+PROTO_RE = re.compile(r"^(?P<pre>[^\n;{]*?)\bfunc_(?P<a>[0-9A-Fa-f]{8})\s*\((?P<params>[^)]*)\)"
+                      r"(?P<post>[^;{\n]*);\s*$")
+FUNC_TOK = re.compile(rb"\bfunc_([0-9A-Fa-f]{8})\b")
+CALL_TOK = re.compile(rb"\bfunc_([0-9A-Fa-f]{8})\(ctx\)")
+LABEL_RE = re.compile(rb"^loc_([0-9A-Fa-f]{8}):", re.M)
+GOTO_RE = re.compile(rb"goto loc_([0-9A-Fa-f]{8});")
+IMPORT_STUB_RE = re.compile(rb"^\s*ps3_hle_call\(0x[0-9A-Fa-f]+u?, ctx\); return;\s*(/\*[^\n]*\*/)?\s*$")
+
+
+def log(*a):
+    print(*a, flush=True)
+
+
+def sha(*parts) -> str:
+    h = hashlib.sha1()
+    for p in parts:
+        h.update(p if isinstance(p, bytes) else str(p).encode())
+        h.update(b"\0")
+    return h.hexdigest()
+
+
+# --------------------------------------------------------------------------- toolchain
+def toolchain_env(work: Path, devenv: str) -> dict:
+    if os.environ.get("THP8_DEVENV") and shutil.which("clang-cl"):
+        env = dict(os.environ)
+    else:
+        cache = work / "toolchain_env.json"
+        stamp = str(os.path.getmtime(devenv)) if os.path.exists(devenv) else "none"
+        env = None
+        if cache.exists():
+            j = json.loads(cache.read_text())
+            if j.get("stamp") == stamp:
+                env = j["env"]
+        if env is None:
+            out = subprocess.run(["cmd.exe", "/d", "/c", f"call {devenv} >nul && set"],
+                                 capture_output=True, text=True, stdin=subprocess.DEVNULL)
+            if out.returncode != 0:
+                sys.exit(f"liftdiff: devenv failed: {out.stderr}")
+            env = {}
+            for line in out.stdout.splitlines():
+                k, sep, v = line.partition("=")
+                if sep and k:
+                    env[k] = v
+            cache.write_text(json.dumps({"stamp": stamp, "env": env}))
+    path = env.get("PATH") or env.get("Path") or ""
+    for tool in ("clang-cl", "lld-link"):
+        if not shutil.which(tool, path=path):
+            sys.exit(f"liftdiff: {tool} not found on the toolchain PATH")
+    exe = shutil.which("clang-cl", path=path)
+    env["LIFTDIFF_CLANG"] = exe
+    env["LIFTDIFF_LLD"] = shutil.which("lld-link", path=path)
+    r = subprocess.run([exe, "--version"], capture_output=True, text=True, env=env)
+    env["LIFTDIFF_CC_ID"] = exe + "|" + (r.stdout.splitlines()[0] if r.stdout else "")
+    return env
+
+
+# --------------------------------------------------------------------------- lift index
+def index_lift(lift: Path, work: Path) -> dict:
+    """Index a lift directory: per function its chunk, byte ranges, def line and
+    features; per chunk its preamble; the header prototypes. Cached by size+mtime."""
+    hdr = lift / "ppu_recomp.h"
+    chunks = sorted(lift.glob("ppu_recomp_[0-9][0-9][0-9].cpp"))
+    if not hdr.exists() or not chunks:
+        sys.exit(f"liftdiff: {lift} has no ppu_recomp.h / ppu_recomp_NNN.cpp")
+    stamp = [(c.name, c.stat().st_size, c.stat().st_mtime_ns) for c in [hdr] + chunks]
+    cpath = work / "index" / (sha(str(lift.resolve())) + ".json")
+    if cpath.exists():
+        j = json.loads(cpath.read_text())
+        if j.get("stamp") == [list(s) for s in stamp]:
+            j["funcs"] = {int(k): v for k, v in j["funcs"].items()}
+            return j
+    t0 = time.time()
+    hdr_bytes = hdr.read_bytes()
+    protos = {}
+    for line in hdr_bytes.decode("latin-1").splitlines():
+        if "func_" not in line:
+            continue
+        m = PROTO_RE.match(line)
+        if m:
+            protos[int(m.group("a"), 16)] = [m.group("pre"), m.group("params"), m.group("post")]
+    funcs = {}
+    preambles = []
+    dups = 0
+    for ci, c in enumerate(chunks):
+        data = c.read_bytes()
+        lines = data.split(b"\n")
+        pos = 0
+        offs = []
+        for ln in lines:
+            offs.append(pos)
+            pos += len(ln) + 1
+        pre_end = None
+        prev_end = None
+        i = 0
+        n = len(lines)
+        while i < n:
+            ln = lines[i]
+            if ln[:1] in (b" ", b"\t", b"}", b"/", b"#", b"") or b"func_" not in ln:
+                i += 1
+                continue
+            m = DEF_RE.match(ln.rstrip(b"\r"))
+            if not m:
+                i += 1
+                continue
+            j = i + 1
+            while j < n and lines[j].rstrip(b"\r") != b"}":
+                j += 1
+            if j >= n:
+                sys.exit(f"liftdiff: {c}: unterminated function at line {i + 1}")
+            addr = int(m.group("a"), 16)
+            if pre_end is None:
+                pre_end = offs[i]
+                prev_end = offs[i]
+            body = data[offs[i + 1]:offs[j]]
+            end = offs[j] + len(lines[j]) + 1
+            feat = func_features(body)
+            if addr in funcs:
+                dups += 1
+            else:
+                funcs[addr] = {
+                    "chunk": ci, "pre": prev_end, "def": offs[i], "body": offs[i + 1], "end": end,
+                    "lines": j - i + 1, "f": feat,
+                    "callees": sorted({int(x, 16) for x in CALL_TOK.findall(body)}),
+                }
+            prev_end = end
+            i = j + 1
+        if pre_end is None:
+            pre_end = len(data)
+        preambles.append({"end": pre_end, "hash": sha(data[:pre_end])})
+    idx = {"stamp": [list(s) for s in stamp], "dir": str(lift.resolve()),
+           "chunks": [c.name for c in chunks], "preambles": preambles,
+           "header_hash": sha(hdr_bytes), "protos": {str(k): v for k, v in protos.items()},
+           "funcs": funcs, "dups": dups}
+    cpath.parent.mkdir(parents=True, exist_ok=True)
+    cpath.write_text(json.dumps(idx))
+    log(f"  indexed {lift}: {len(funcs)} functions in {len(chunks)} chunks "
+        f"({time.time() - t0:.1f}s{', %d duplicates ignored' % dups if dups else ''})")
+    return idx
+
+
+def func_features(body: bytes) -> list:
+    f = []
+    s = body.strip()
+    if b"\n" not in s and IMPORT_STUB_RE.match(s):
+        return ["import_stub"]
+    if b"ctx->lr = 0x" in body and CALL_TOK.search(body):
+        f.append("direct_call")
+    if b"ps3_indirect_call" in body:
+        f.append("indirect_call")
+    if b"g_trampoline_fn =" in body:
+        f.append("trampoline")
+    if b"goto loc_" in body:
+        labels = {m.group(1): m.start() for m in LABEL_RE.finditer(body)}
+        for m in GOTO_RE.finditer(body):
+            p = labels.get(m.group(1))
+            if p is not None and p < m.start():
+                f.append("loop")
+                break
+    if b"ctx->fpr[" in body:
+        f.append("fp")
+    if b"ctx->vr[" in body:
+        f.append("vmx")
+    if b"(_c << 28)" in body or b"ctx->cr=(ctx->cr & ~(0xFu<<4))" in body:   # Rc=1 integer / VMX
+        f.append("record_cr")
+    if b"switch ((uint32_t)ctx->ctr)" in body:
+        f.append("jumptable")
+    if b"reserve_addr" in body:
+        f.append("atomic")
+    if b"lv2_syscall(" in body:
+        f.append("syscall")
+    return f
+
+
+# --------------------------------------------------------------------------- ELF / TOC
+def parse_elf(path: Path):
+    d = path.read_bytes()
+    if d[:4] != b"\x7fELF" or d[4] != 2 or d[5] != 2:
+        sys.exit("liftdiff: --elf is not an ELF64 big-endian file")
+    entry, phoff, shoff = struct.unpack(">QQQ", d[0x18:0x30])
+    phentsize, phnum, shentsize, shnum = struct.unpack(">HHHH", d[0x36:0x3E])
+    segs = []
+    for i in range(phnum):
+        o = phoff + i * phentsize
+        typ, = struct.unpack(">I", d[o:o + 4])
+        off, va, _, fsz, msz = struct.unpack(">QQQQQ", d[o + 8:o + 48])
+        if typ == 1 and msz:
+            segs.append((va, off, fsz, msz))
+
+    def rd32(a):
+        for va, off, fsz, msz in segs:
+            if va <= a < va + fsz:
+                return struct.unpack(">I", d[off + a - va:off + a - va + 4])[0]
+        return 0
+    opd_lo = opd_hi = None
+    for i in range(shnum):
+        o = shoff + i * shentsize
+        _, typ, _, addr, _, size = struct.unpack(">IIQQQQ", d[o:o + 40])
+        if typ == 1 and addr <= entry < addr + size:
+            opd_lo, opd_hi = addr, addr + size
+    opd = []
+    if opd_lo is not None:
+        for a in range(opd_lo, opd_hi - 7, 8):
+            code, toc = rd32(a), rd32(a + 4)
+            if code and toc:
+                opd.append((a, code, toc))
+    return {"segs": segs, "entry": entry, "opd": opd, "opd_range": (opd_lo, opd_hi)}
+
+
+def toc_resolver(elf):
+    exact = {}
+    for _, code, toc in elf["opd"]:
+        exact.setdefault(code, toc)
+    codes = sorted(exact)
+
+    import bisect
+
+    def toc_of(addr):
+        if addr in exact:
+            return exact[addr]
+        i = bisect.bisect_right(codes, addr) - 1
+        return exact[codes[i]] if i >= 0 else (exact[codes[0]] if codes else 0)
+    return toc_of
+
+
+# --------------------------------------------------------------------------- selection
+def select_functions(idx_a, args) -> list:
+    funcs = idx_a["funcs"]
+    if args.func_list:
+        want = []
+        for line in Path(args.func_list).read_text().splitlines():
+            line = line.split("#", 1)[0]
+            for tok in re.split(r"[\s,;]+", line):
+                tok = tok.strip()
+                if tok.lower().startswith("func_"):
+                    tok = tok[5:]
+                try:
+                    want.append(int(tok, 16))
+                    break
+                except ValueError:
+                    continue
+        out = []
+        for a in want:
+            if a not in funcs:
+                log(f"  warning: 0x{a:08X} is not a lifted function in A -- skipped")
+            elif "import_stub" in funcs[a]["f"]:
+                log(f"  warning: 0x{a:08X} is an import stub -- skipped")
+            elif a not in out:
+                out.append(a)
+        return out
+    rng = random.Random(args.sel_seed)
+    cands = sorted(a for a, f in funcs.items() if "import_stub" not in f["f"])
+    by_feat = {k: [a for a in cands if k in funcs[a]["f"]] for k in FEATURES}
+    by_feat["plain"] = [a for a in cands if not funcs[a]["f"]]
+    by_feat["large"] = [a for a in cands if funcs[a]["lines"] > 300]
+    for v in by_feat.values():
+        rng.shuffle(v)
+    cats = FEATURES + ["plain", "large"]
+    chosen, seen = [], set()
+    ptr = {k: 0 for k in cats}
+    while len(chosen) < min(args.funcs, len(cands)):
+        progressed = False
+        for k in cats:
+            lst = by_feat[k]
+            while ptr[k] < len(lst) and lst[ptr[k]] in seen:
+                ptr[k] += 1
+            if ptr[k] < len(lst):
+                a = lst[ptr[k]]
+                ptr[k] += 1
+                seen.add(a)
+                chosen.append(a)
+                progressed = True
+                if len(chosen) >= args.funcs:
+                    break
+        if not progressed:
+            break
+    return sorted(chosen)
+
+
+# --------------------------------------------------------------------------- source generation
+class Lift:
+    def __init__(self, name, idx):
+        self.name = name
+        self.idx = idx
+        self.dir = Path(idx["dir"])
+        self._chunk_cache = {}
+
+    def chunk(self, ci) -> bytes:
+        if ci not in self._chunk_cache:
+            if len(self._chunk_cache) > 6:
+                self._chunk_cache.clear()
+            self._chunk_cache[ci] = (self.dir / self.idx["chunks"][ci]).read_bytes()
+        return self._chunk_cache[ci]
+
+    def preamble(self, ci) -> bytes:
+        return self.chunk(ci)[:self.idx["preambles"][ci]["end"]]
+
+    def func_text(self, addr, rename: bool) -> bytes:
+        f = self.idx["funcs"][addr]
+        data = self.chunk(f["chunk"])
+        prefix = data[f["pre"]:f["def"]]
+        defline = data[f["def"]:f["body"]]
+        rest = data[f["body"]:f["end"]]
+        if rename:
+            defline = re.sub(rb"\bfunc_" + (b"%08X" % addr) + rb"(\s*\()",
+                             b"lds_T_" + (b"%08X" % addr) + rb"\1", defline, count=1, flags=re.I)
+        return prefix + defline + rest
+
+    def proto_parts(self, addr):
+        p = self.idx["protos"].get(str(addr))
+        return p if p else ["void ", "ppu_context* ctx", ""]
+
+    def def_parts(self, addr):
+        f = self.idx["funcs"][addr]
+        data = self.chunk(f["chunk"])
+        m = DEF_RE.match(data[f["def"]:f["body"]].rstrip(b"\r\n"))
+        return [m.group("pre").decode("latin-1"), m.group("params").decode("latin-1"),
+                m.group("post").decode("latin-1")]
+
+
+def partition(addrs, idx_a, max_lines=12000, max_funcs=200):
+    groups, cur, cur_lines = [], [], 0
+    for a in addrs:
+        n = idx_a["funcs"][a]["lines"]
+        if cur and (cur_lines + n > max_lines or len(cur) >= max_funcs):
+            groups.append(cur)
+            cur, cur_lines = [], 0
+        cur.append(a)
+        cur_lines += n
+    if cur:
+        groups.append(cur)
+    return groups
+
+
+def gen_sources(lift: Lift, tests, closure, groups_t, groups_c):
+    """Returns {filename: bytes} for one variant."""
+    out = {}
+    ffuncs = lift.idx["funcs"]
+    missing = [a for a in list(tests) + list(closure) if a not in ffuncs]
+    if missing:
+        raise KeyError(missing)
+    refs = set()
+
+    def emit(groups, rename, tag):
+        for gi, g in enumerate(groups):
+            by_pre = {}
+            for a in g:
+                ci = ffuncs[a]["chunk"]
+                by_pre.setdefault(lift.idx["preambles"][ci]["hash"], (ci, []))[1].append(a)
+            for si, (ci, lst) in enumerate(by_pre.values()):
+                parts = [lift.preamble(ci), b"\n/* ---- liftdiff extract ---- */\n"]
+                for a in lst:
+                    t = lift.func_text(a, rename)
+                    parts.append(t)
+                    refs.update(int(x, 16) for x in FUNC_TOK.findall(t))
+                out[f"{tag}_{gi:03d}_{si}.cpp"] = b"".join(parts)
+    emit(groups_t, True, "tu")
+    emit(groups_c, False, "cl")
+
+    stubs = sorted(refs - set(closure))
+    g = ['#include "ppu_recomp.h"', '#include "lds_rt.h"', "", "/* stubbed callees */"]
+    for a in stubs:
+        pre, params, post = lift.proto_parts(a)
+        if "ppu_context" not in params or "," in params:
+            raise ValueError(f"func_{a:08X}: unexpected parameter list '{params}' -- extend gen_sources")
+        g.append(f"{pre}func_{a:08X}(ppu_context* ctx){post} "
+                 f"{{ lds_record_and_clobber(ctx, LDS_EV_CALL, 0x{a:08X}u); }}")
+    g.append("")
+    g.append("/* functions under test (renamed lds_T_X) and their wrappers */")
+    for a in sorted(tests):
+        pre, params, post = lift.def_parts(a)
+        g.append(f"{pre}lds_T_{a:08X}({params}){post};")
+        g.append(f"static void lds_run_{a:08X}(ppu_context* c) {{ lds_T_{a:08X}(c); }}")
+    for a in sorted(closure):
+        g.append(f"static void lds_real_{a:08X}(ppu_context* c) {{ func_{a:08X}(c); }}")
+    for a in stubs:
+        g.append(f"static void lds_stub_{a:08X}(ppu_context* c) {{ func_{a:08X}(c); }}")
+
+    def table(name, items):
+        g.append(f'extern "C" const LdsFn {name}[] = {{')
+        for a, fn in items:
+            g.append(f"    {{ 0x{a:08X}u, {fn} }},")
+        g.append("    { 0xFFFFFFFFu, nullptr }")
+        g.append("};")
+        g.append(f'extern "C" const uint32_t {name.replace("_fns", "_count")} = {len(items)};')
+    table("lds_test_fns", [(a, f"lds_run_{a:08X}") for a in sorted(tests)])
+    table("lds_real_fns", [(a, f"lds_real_{a:08X}") for a in sorted(closure)])
+    allf = sorted([(a, f"lds_real_{a:08X}") for a in closure] + [(a, f"lds_stub_{a:08X}") for a in stubs])
+    table("lds_all_fns", allf)
+    out["lds_gen.cpp"] = ("\n".join(g) + "\n").encode()
+    return out, stubs
+
+
+# --------------------------------------------------------------------------- build
+def run_tool(cmd, env, cwd=None):
+    r = subprocess.run(cmd, env=env, cwd=cwd, capture_output=True, text=True,
+                       creationflags=PRIO, stdin=subprocess.DEVNULL)
+    return r.returncode, (r.stdout + r.stderr)
+
+
+def prepare_variant(lift: Lift, sources: dict, work: Path, env: dict, extra_cflags=()):
+    """Write the variant's build dir; returns its compile jobs (src, cache key, extra flags)."""
+    bdir = work / "build" / lift.name
+    if bdir.exists():
+        shutil.rmtree(bdir)
+    bdir.mkdir(parents=True)
+    # every header of the lift dir travels with it (a variant may add its own .h files)
+    hparts = []
+    for h in sorted(lift.dir.glob("*.h")):
+        b = h.read_bytes()
+        (bdir / h.name).write_bytes(b)
+        hparts += [h.name, b]
+    hh = sha(*hparts)
+    flags = CXXFLAGS + list(extra_cflags)
+    harness_text = b"".join((HERE / f).read_bytes() for f in HARNESS_SRCS + HARNESS_HDRS)
+    cc = env["LIFTDIFF_CC_ID"]
+    jobs = []
+    for name, text in sorted(sources.items()):
+        (bdir / name).write_bytes(text)
+        key = sha("v3", cc, flags, hh, text, harness_text if name == "lds_gen.cpp" else b"")
+        jobs.append((lift.name, bdir, bdir / name, key, flags + ["-w"]))
+    for f in HARNESS_SRCS:
+        key = sha("v3", cc, flags, hh, f, harness_text)
+        jobs.append((lift.name, bdir, HERE / f, key, flags + ["-D_CRT_SECURE_NO_WARNINGS"]))
+    return jobs
+
+
+def build_all(jobs, work: Path, env: dict, pool: ThreadPoolExecutor):
+    """Compile every job of every variant through one pool (content-addressed object
+    cache), then link one exe per variant. Returns {variant: (exe, stats)}."""
+    objdir = work / "objcache"
+    objdir.mkdir(parents=True, exist_ok=True)
+
+    def compile_one(job):
+        v, bdir, src, key, flags = job
+        obj = objdir / f"{key}.obj"
+        if obj.exists():
+            return obj, True, 0.0, ""
+        tmp = objdir / f"{key}.{os.getpid()}.{threading.get_ident()}.tmp.obj"
+        t0 = time.time()
+        cmd = [env["LIFTDIFF_CLANG"], "/c", *flags, f"/I{bdir}", f"/I{HERE}", f"/Fo{tmp}", str(src)]
+        rc, out = run_tool(cmd, env)
+        if rc != 0:
+            try:
+                tmp.unlink()
+            except OSError:
+                pass
+            errs = [ln for ln in out.splitlines() if "error" in ln]
+            return None, False, time.time() - t0, (f"[{v}] {src.name}:\n" + "\n".join(errs[:20]) +
+                                                    "\n--- full output (head) ---\n" + out[:3000])
+        os.replace(tmp, obj)
+        return obj, False, time.time() - t0, ""
+
+    t0 = time.time()
+    # biggest sources first so the slow TUs do not trail at the end
+    # one compile per distinct cache key (A and B often share TUs), biggest first
+    first = {}
+    for i, j in enumerate(jobs):
+        first.setdefault(j[3], i)
+    order = sorted(first.values(), key=lambda i: -jobs[i][2].stat().st_size)
+    done = dict(zip((jobs[i][3] for i in order), pool.map(compile_one, [jobs[i] for i in order])))
+    results = []
+    for i, j in enumerate(jobs):
+        r = done[j[3]]
+        results.append(r if first[j[3]] == i else (r[0], True, 0.0, r[3]))
+    errs = [r[3] for r in results if r[0] is None]
+    if errs:
+        log("liftdiff: BUILD FAILED:\n" + "\n".join(errs[:4]))
+        sys.exit(2)
+    t_compile = time.time() - t0
+    out = {}
+    for v in dict.fromkeys(j[0] for j in jobs):
+        mine = [(j, r) for j, r in zip(jobs, results) if j[0] == v]
+        objs = [r[0] for _, r in mine]
+        bdir = mine[0][0][1]
+        exedir = work / "exe"
+        exedir.mkdir(exist_ok=True)
+        ekey = sha("link-v1", LINKFLAGS, *[o.name for o in objs])
+        exe = exedir / f"lds_{v}_{ekey[:16]}.exe"
+        linked = False
+        if not exe.exists():
+            rsp = bdir / "link.rsp"
+            rsp.write_text("\n".join(f'"{o}"' for o in objs))
+            tmp = exe.with_suffix(".tmp.exe")
+            rc, lout = run_tool([env["LIFTDIFF_LLD"], *LINKFLAGS, f"/OUT:{tmp}", f"@{rsp}"], env)
+            if rc != 0:
+                log(f"liftdiff: LINK FAILED for variant {v} (a runtime symbol harness_rt.cpp does not "
+                    f"define? extend it):\n{lout[-6000:]}")
+                sys.exit(2)
+            os.replace(tmp, exe)
+            linked = True
+        out[v] = (exe, {"objs": len(objs), "cached": sum(1 for _, r in mine if r[1]),
+                        "cpu": sum(r[2] for _, r in mine), "slowest_tu": max(r[2] for _, r in mine),
+                        "linked": linked, "secs": t_compile})
+    return out
+
+
+# --------------------------------------------------------------------------- running
+class Runner:
+    restarts = []                      # (tag, test id, reason) of every process restart
+
+    def __init__(self, exe: Path, elf: Path, pool_file: Path, opts, timeout_ms, rundir: Path, tag):
+        self.exe, self.elf, self.pool_file = exe, elf, pool_file
+        self.opts, self.timeout_ms, self.rundir, self.tag = opts, timeout_ms, rundir, tag
+
+    def run(self, tests, detail=False, timeout_ms=None):
+        """tests: list of (id, addr, toc, seed). Returns {id: result dict}."""
+        timeout_ms = timeout_ms or self.timeout_ms
+        results = {}
+        remaining = list(tests)
+        attempt = 0
+        while remaining:
+            attempt += 1
+            tfile = self.rundir / f"{self.tag}_{attempt}.tests"
+            tfile.write_text("".join(f"{i} {a:08X} {t:08X} {s}\n" for i, a, t, s in remaining))
+            cmd = [str(self.exe), "--elf", str(self.elf), "--tests", str(tfile),
+                   "--pool", str(self.pool_file), "--timeout-ms", str(timeout_ms)]
+            for o in self.opts:
+                cmd += ["--opt", o]
+            if detail:
+                cmd.append("--detail")
+            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                 stdin=subprocess.DEVNULL, creationflags=PRIO, bufsize=1 << 16)
+            q = queue.Queue()
+
+            def reader():
+                for raw in p.stdout:
+                    q.put(raw.decode("latin-1").rstrip("\r\n"))
+                q.put(None)
+            th = threading.Thread(target=reader, daemon=True)
+            th.start()
+            cur = None
+            dlines = []
+            done_ids = set()
+            kill_after = timeout_ms / 1000.0 * 3 + 10.0
+            last = time.time()
+            ended = False
+            stuck = False
+            seen_output = False
+            while True:
+                try:
+                    line = q.get(timeout=1.0)
+                except queue.Empty:
+                    # before the first line (CONFIG) allow STARTUP_GRACE: on a saturated machine a
+                    # below-normal-priority driver can need well over kill_after just to start
+                    limit = kill_after if seen_output else max(kill_after, STARTUP_GRACE)
+                    if time.time() - last > limit:           # watchdog failed / startup hang
+                        p.kill()
+                        if cur is not None:
+                            results[cur] = {"status": "HANG", "note": "killed by runner"}
+                            done_ids.add(cur)
+                        else:
+                            stuck = True
+                        break
+                    continue
+                if line is None:
+                    break
+                last = time.time()
+                seen_output = True
+                if line.startswith("BEGIN "):
+                    cur = int(line.split()[1])
+                    dlines = []
+                elif line.startswith("END "):
+                    f = line.split()
+                    tid = int(f[1])
+                    r = {"status": f[2], "regs": f[3], "mem": f[4], "trace": f[5],
+                         "ntrace": int(f[6]), "nchg": int(f[7]), "ndemand": int(f[8])}
+                    if detail:
+                        r["detail"] = dlines
+                    results[tid] = r
+                    done_ids.add(tid)
+                    cur = None
+                elif line.startswith("D "):
+                    dlines.append(line)
+                elif line.startswith("DONE"):
+                    ended = True
+                elif line.startswith("FATAL"):
+                    log(f"  [{self.tag}] {line}")
+            try:
+                p.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                p.kill()
+            if cur is not None and cur not in done_ids:
+                results[cur] = {"status": "CRASH", "note": f"exit code {p.returncode}"}
+                done_ids.add(cur)
+            if not ended:
+                Runner.restarts.append((self.tag, cur, results.get(cur, {}).get("note") if cur is not None
+                                        else f"exit code {p.returncode}"))
+            remaining = [t for t in remaining if t[0] not in done_ids]
+            if remaining and not ended and (stuck or (cur is None and not done_ids)):
+                # died / stuck before running anything: do not loop forever
+                for t in remaining:
+                    results[t[0]] = {"status": "CRASH", "note": f"exe failed (rc={p.returncode})"}
+                break
+            if ended:
+                for t in remaining:
+                    results.setdefault(t[0], {"status": "CRASH", "note": "not run"})
+                break
+        return results
+
+
+def run_all(runners, shards, jobs, tag="s"):
+    """runners: {variant: Runner}; shards: list of test lists. Runs every (variant, shard)."""
+    out = {v: {} for v in runners}
+    work = [(v, k, sh) for k, sh in enumerate(shards) for v in runners]
+    lock = threading.Lock()
+
+    def go(item):
+        v, k, sh = item
+        r = runners[v]
+        sub = Runner(r.exe, r.elf, r.pool_file, r.opts, r.timeout_ms, r.rundir, f"{v}_{tag}{k}")
+        res = sub.run(sh)
+        with lock:
+            out[v].update(res)
+    with ThreadPoolExecutor(max_workers=jobs) as ex:
+        list(ex.map(go, work))
+    return out
+
+
+# --------------------------------------------------------------------------- compare / explain
+def compare(a, b):
+    if a is None or b is None:
+        return ["norun"]
+    if a["status"] != b["status"]:
+        return ["status"]
+    st = a["status"]
+    if st in STATUS_ONLY:
+        return []
+    if st == "MISSING":
+        return ["missing"]
+    d = []
+    if st == "OK":
+        if a["regs"] != b["regs"]:
+            d.append("regs")
+        if a["mem"] != b["mem"] or a["nchg"] != b["nchg"]:
+            d.append("mem")
+    if a["trace"] != b["trace"] or a["ntrace"] != b["ntrace"]:
+        d.append("trace")
+    return d
+
+
+REG_ORDER = ([f"r{i}" for i in range(32)] + [f"f{i}" for i in range(32)] + [f"v{i}" for i in range(32)]
+             + ["cr", "lr", "ctr", "xer", "fpscr", "vscr", "reserve_addr", "reserve_value", "reserve_valid"])
+
+
+def parse_detail(lines):
+    regs, events, evregs, pages = {}, [], {}, {}
+    for ln in lines:
+        f = ln.split()
+        if f[1] == "R":
+            regs[f[2]] = f[3]
+        elif f[1] == "EV":
+            events.append((int(f[3]), f[4], f[5]))
+        elif f[1] == "ER":
+            evregs.setdefault(int(f[2]), {})[f[3]] = f[4]
+        elif f[1] == "PAGE":
+            pages[int(f[2], 16)] = f[3]
+    return regs, events, evregs, pages
+
+
+def reg_diff(ra, rb, limit=6):
+    names = [n for n in REG_ORDER if ra.get(n) != rb.get(n)]
+    return names, ", ".join(f"{n}: A={ra.get(n)} B={rb.get(n)}" for n in names[:limit])
+
+
+KIND = {1: "CALL", 2: "HLE", 3: "SYSCALL"}
+
+
+def explain(da, db, comps):
+    ra, ea, era, pa = parse_detail(da)
+    rb, eb, erb, pb = parse_detail(db)
+    out = []
+    if "regs" in comps:
+        names, txt = reg_diff(ra, rb)
+        out.append(f"regs: {len(names)} differ, first {txt}")
+    if "trace" in comps:
+        n = min(len(ea), len(eb))
+        k = next((i for i in range(n) if ea[i] != eb[i]), None)
+        if k is None:
+            out.append(f"trace: first {n} events equal (A has {len(ea)}, B has {len(eb)} recorded); "
+                       f"difference is later or in the count")
+        else:
+            ka, kb = ea[k], eb[k]
+            s = (f"trace: event #{k} A={KIND.get(ka[0], ka[0])} 0x{ka[1]} "
+                 f"B={KIND.get(kb[0], kb[0])} 0x{kb[1]}")
+            if ka[:2] == kb[:2]:
+                names, txt = reg_diff(era.get(k, {}), erb.get(k, {}))
+                s += f"; same target, entry state differs in {len(names)} regs: {txt}"
+            out.append(s)
+    if "mem" in comps:
+        addrs = sorted(set(pa) | set(pb))
+        bad = [x for x in addrs if pa.get(x) != pb.get(x)]
+        if not bad:
+            out.append("mem: differing pages beyond the 64 dumped")
+        else:
+            x = bad[0]
+            ha, hb = pa.get(x), pb.get(x)
+            if ha is None or hb is None:
+                out.append(f"mem: page 0x{x:08X} changed only in {'B' if ha is None else 'A'} "
+                           f"({len(bad)} pages differ)")
+            else:
+                i = next(i for i in range(0, len(ha), 2) if ha[i:i + 2] != hb[i:i + 2])
+                o = i // 2
+                s0 = (o // 8) * 16
+                out.append(f"mem: {len(bad)} pages differ; first at 0x{x + o:08X}: "
+                           f"A={ha[s0:s0 + 32]} B={hb[s0:s0 + 32]} (16 bytes from 0x{x + o // 8 * 8:08X})")
+    if "status" in comps:
+        out.append("status differs")
+    return out
+
+
+# --------------------------------------------------------------------------- main
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--a", required=True, help="reference lift directory")
+    ap.add_argument("--b", required=True, help="candidate lift directory")
+    ap.add_argument("--elf", required=True)
+    g = ap.add_mutually_exclusive_group(required=True)
+    g.add_argument("--funcs", type=int, help="pick N functions stratified by feature")
+    g.add_argument("--func-list", help="file of function addresses (hex, one per line; extra columns ignored)")
+    ap.add_argument("--sel-seed", type=int, default=1)
+    ap.add_argument("--seeds", type=int, default=3)
+    ap.add_argument("--seed-base", type=int, default=1)
+    ap.add_argument("--clobber", choices=["abi", "all"], default="abi")
+    ap.add_argument("--slowmem", action="store_true", help="every ppu_line_flags entry = 3 (B slow path)")
+    ap.add_argument("--icall", action="store_true", help="populate ppu_icall_tab (B indirect fast path)")
+    ap.add_argument("--opt", action="append", default=[], help="extra harness option KEY=VAL")
+    ap.add_argument("--closure", type=int, default=0, help="1: link direct callees for real")
+    ap.add_argument("--work", default=os.environ.get("LIFTDIFF_WORK", str(Path.cwd() / "liftdiff_work")))
+    ap.add_argument("-j", "--jobs", type=int, default=4)
+    ap.add_argument("--timeout-ms", type=int, default=1000)
+    ap.add_argument("--hang-factor", type=int, default=10, help="timeout multiplier for one-sided HANG rechecks")
+    ap.add_argument("--explain", type=int, default=20, help="detail-rerun up to N mismatches")
+    ap.add_argument("--devenv", default=DEFAULT_DEVENV)
+    ap.add_argument("--cflags", default="", help="extra compiler flags for both variants (space separated)")
+    ap.add_argument("--cflags-b", default="", help="extra compiler flags for variant B only "
+                    "(e.g. '-O1' to check A against itself under a different optimizer)")
+    ap.add_argument("--build-only", action="store_true")
+    ap.add_argument("--save-selection", help="write the selected function addresses to this file")
+    args = ap.parse_args()
+    if args.jobs > 4:
+        log("liftdiff: -j capped at 4 (shared machine)")
+        args.jobs = 4
+
+    if PRIO:
+        try:
+            import ctypes, ctypes.wintypes as wt
+            k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+            k32.GetCurrentProcess.restype = wt.HANDLE          # untyped: the -1 pseudo-handle was truncated and the call failed
+            k32.SetPriorityClass.argtypes = (wt.HANDLE, wt.DWORD)
+            k32.SetPriorityClass.restype = wt.BOOL
+            if not k32.SetPriorityClass(k32.GetCurrentProcess(), 0x4000):   # BELOW_NORMAL_PRIORITY_CLASS
+                log(f"liftdiff: SetPriorityClass failed (error {ctypes.get_last_error()})")
+        except Exception:
+            pass
+    t_start = time.time()
+    work = Path(args.work)
+    work.mkdir(parents=True, exist_ok=True)
+    env = toolchain_env(work, args.devenv)
+
+    log("liftdiff: indexing lifts")
+    t0 = time.time()
+    idx_a = index_lift(Path(args.a), work)
+    idx_b = index_lift(Path(args.b), work)
+    t_index = time.time() - t0
+
+    elf_path = Path(args.elf).resolve()
+    elf = parse_elf(elf_path)
+    toc_of = toc_resolver(elf)
+    pool_file = work / "pool.txt"
+    pool = sorted({a for a, _, _ in elf["opd"]} | {c for _, c, _ in elf["opd"]})
+    pool_file.write_text("".join(f"{x:08X}\n" for x in pool))
+
+    sel = select_functions(idx_a, args)
+    if not sel:
+        sys.exit("liftdiff: no functions selected")
+    if args.save_selection:
+        Path(args.save_selection).write_text("".join(f"{a:08X}\n" for a in sel))
+    missing_b = [a for a in sel if a not in idx_b["funcs"]]
+    sel_b = [a for a in sel if a in idx_b["funcs"]]
+    closure = []
+    if args.closure:
+        cs = set()
+        for a in sel_b:
+            cs.update(idx_a["funcs"][a]["callees"])
+        closure = sorted(c for c in cs if c in idx_a["funcs"] and c in idx_b["funcs"])
+    feat_count = {k: sum(1 for a in sel if k in idx_a["funcs"][a]["f"]) for k in FEATURES}
+    log(f"  selected {len(sel)} functions ({sum(idx_a['funcs'][a]['lines'] for a in sel)} lines in A)"
+        f"{', closure +%d' % len(closure) if closure else ''}; features: "
+        + " ".join(f"{k}={v}" for k, v in feat_count.items()))
+    if missing_b:
+        log(f"  {len(missing_b)} selected functions are MISSING from B: "
+            + " ".join(f"{a:08X}" for a in missing_b[:10]))
+
+    groups_t = partition(sel_b, idx_a)
+    groups_c = partition(closure, idx_a)
+    lifts = {"A": Lift("A", idx_a), "B": Lift("B", idx_b)}
+    exes, bstats = {}, {}
+    extra = args.cflags.split() if args.cflags else []
+    t0 = time.time()
+    jobs, nstubs = [], {}
+    for v, lf in lifts.items():
+        srcs, stubs = gen_sources(lf, sel_b, closure, groups_t, groups_c)
+        nstubs[v] = len(stubs)
+        jobs += prepare_variant(lf, srcs, work, env,
+                                extra + (args.cflags_b.split() if v == "B" and args.cflags_b else []))
+    with ThreadPoolExecutor(max_workers=args.jobs) as pool_ex:
+        built = build_all(jobs, work, env, pool_ex)
+    t_build = time.time() - t0
+    for v, (exe, st) in built.items():
+        exes[v], bstats[v] = exe, st
+        log(f"  build {v}: {st['objs']} objects ({st['cached']} cached), {nstubs[v]} stubs, "
+            f"compile cpu {st['cpu']:.1f}s (slowest TU {st['slowest_tu']:.1f}s)"
+            f"{', linked' if st['linked'] else ''} -> {exe.name}")
+    log(f"  build wall time {t_build:.1f}s")
+    if args.build_only:
+        return 0
+
+    tests = []
+    for a in sel_b:
+        for k in range(args.seeds):
+            tests.append((len(tests), a, toc_of(a), args.seed_base + k))
+    test_by_id = {t[0]: t for t in tests}
+    opts = [f"CLOBBER={args.clobber}"]
+    if args.slowmem:
+        opts.append("SLOWMEM=1")
+    if args.icall:
+        opts.append("ICALL=1")
+    opts += args.opt
+    stamp = time.strftime("%Y%m%d_%H%M%S")
+    rundir = work / "runs" / stamp
+    rundir.mkdir(parents=True, exist_ok=True)
+    runners = {v: Runner(exes[v], elf_path, pool_file, opts, args.timeout_ms, rundir, v) for v in exes}
+
+    nsh = max(1, min(args.jobs, (len(tests) + 199) // 200))
+    shards = [sorted(tests[k::nsh], key=lambda t: (t[3], t[1])) for k in range(nsh)]
+    t0 = time.time()
+    res = run_all(runners, shards, args.jobs)
+    t_run = time.time() - t0
+
+    # one-sided HANGs: recheck both sides with a longer timeout
+    flaky = [i for i in test_by_id
+             if (res["A"].get(i, {}).get("status") == "HANG") != (res["B"].get(i, {}).get("status") == "HANG")]
+    if flaky:
+        log(f"  rechecking {len(flaky)} one-sided HANG tests with {args.hang_factor}x timeout")
+        ts = sorted((test_by_id[i] for i in flaky), key=lambda t: (t[3], t[1]))
+        slow = {v: Runner(r.exe, elf_path, pool_file, opts, args.timeout_ms * args.hang_factor, rundir,
+                          f"{v}_hang") for v, r in runners.items()}
+        nh = max(1, min(args.jobs // 2 or 1, len(ts)))
+        rec = run_all(slow, [ts[k::nh] for k in range(nh)], args.jobs, tag="hang")
+        for v in rec:
+            res[v].update(rec[v])
+
+    mism, statuses, hangs = [], {}, 0
+    for i, t in test_by_id.items():
+        a, b = res["A"].get(i), res["B"].get(i)
+        d = compare(a, b)
+        sa = a["status"] if a else "NORUN"
+        statuses[sa] = statuses.get(sa, 0) + 1
+        if sa == "HANG" and b and b["status"] == "HANG":
+            hangs += 1
+        if d:
+            mism.append((i, d))
+
+    # explain mismatches with a detail rerun
+    expl = {}
+    if mism and args.explain:
+        ex_ids = [i for i, _ in mism[:args.explain]]
+        ts = sorted((test_by_id[i] for i in ex_ids), key=lambda t: (t[3], t[1]))
+        det = {}
+        for v in runners:
+            rr = Runner(runners[v].exe, elf_path, pool_file, opts, args.timeout_ms, rundir, f"{v}_detail")
+            det[v] = rr.run(ts, detail=True)
+        for i, d in mism[:args.explain]:
+            da, db = det["A"].get(i, {}), det["B"].get(i, {})
+            if da.get("detail") is not None and db.get("detail") is not None:
+                expl[i] = explain(da["detail"], db["detail"], d)
+
+    # report
+    lines = []
+    lines.append(f"liftdiff A={args.a} B={args.b}")
+    lines.append(f"  options: {' '.join(opts)} seeds={args.seeds} closure={args.closure} "
+                 f"timeout={args.timeout_ms}ms")
+    lines.append(f"  functions: {len(sel)} selected, {len(missing_b)} missing in B; tests: {len(tests)}")
+    lines.append(f"  time: index {t_index:.1f}s, build {t_build:.1f}s (compile cpu A {bstats['A']['cpu']:.0f}s "
+                 f"B {bstats['B']['cpu']:.0f}s), run {t_run:.1f}s, total {time.time() - t_start:.1f}s")
+    lines.append("  statuses (A): " + " ".join(f"{k}={v}" for k, v in sorted(statuses.items())))
+    bad_funcs = sorted({test_by_id[i][1] for i, _ in mism} | set(missing_b))
+    lines.append(f"  RESULT: {len(tests) - len(mism)} match, {len(mism)} MISMATCH "
+                 f"({len(bad_funcs)} functions), {hangs} hang in both")
+    if Runner.restarts:
+        lines.append(f"  process restarts: {len(Runner.restarts)} "
+                     + "; ".join(f"{t}@{i}:{why}" for t, i, why in Runner.restarts[:8]))
+    rep = []
+    for i, d in mism:
+        _, a, toc, s = test_by_id[i]
+        ra, rb = res["A"].get(i) or {}, res["B"].get(i) or {}
+        head = (f"  MISMATCH func_{a:08X} seed {s} [{','.join(d)}] "
+                f"A={ra.get('status')} B={rb.get('status')} "
+                f"ntrace A={ra.get('ntrace')} B={rb.get('ntrace')}")
+        lines.append(head)
+        for e in expl.get(i, []):
+            lines.append("      " + e)
+        rep.append({"id": i, "func": f"{a:08X}", "seed": s, "components": d, "A": ra, "B": rb,
+                    "explain": expl.get(i, [])})
+    for a in missing_b:
+        lines.append(f"  MISMATCH func_{a:08X}: missing in B")
+    text = "\n".join(lines)
+    log(text)
+    (rundir / "report.txt").write_text(text + "\n")
+    (rundir / "report.json").write_text(json.dumps({
+        "a": args.a, "b": args.b, "opts": opts, "tests": len(tests), "mismatches": rep,
+        "missing_in_b": [f"{a:08X}" for a in missing_b], "statuses": statuses,
+        "results": {v: {str(k): x for k, x in r.items()} for v, r in res.items()},
+        "tests_list": [[t[0], f"{t[1]:08X}", f"{t[2]:08X}", t[3]] for t in tests]}, indent=1))
+    log(f"  report: {rundir / 'report.txt'}")
+    return 1 if (mism or missing_b) else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
