diff --git a/libs/video/rsx_live_draw_vkd3d.c b/libs/video/rsx_live_draw_vkd3d.c
new file mode 100644
index 00000000..5d3bfbde
--- /dev/null
+++ b/libs/video/rsx_live_draw_vkd3d.c
@@ -0,0 +1,267 @@
+/*
+ * ps3recomp - vkd3d glue for the live-draw renderer off Windows (RSX_LIVE_VKD3D)
+ *
+ *  - D3D12 / D3DCompile entry points resolved from libvkd3d-utils with dlopen
+ *    ($PS3_VKD3D_UTILS, default libvkd3d-utils.so.1), so nothing links against vkd3d.
+ *  - A minimal DXGI: CreateDXGIFactory1 -> IDXGIFactory4 whose CreateSwapChainForHwnd makes
+ *    an IDXGISwapChain3 over two offscreen R8G8B8A8 render targets. With a display,
+ *    rsx_live_draw_vkd3d_wsi.c puts them on screen (SDL2 window, Vulkan swapchain on vkd3d's
+ *    device); without one Present() only flips the index and LD_FRAME_DUMP shows the frames.
+ *
+ * Everything here is inert unless RSX_LIVE_VKD3D is defined (the file is globbed on every
+ * platform, Windows included).
+ */
+#if defined(RSX_LIVE_VKD3D) && !defined(_WIN32) && !defined(PS3_WASM)   /* wasm: libs/video/webgpu */
+
+#define INITGUID
+#include "rsx_live_draw_vkd3d.h"
+#include <dlfcn.h>
+#include <string.h>
+
+/* ---- libvkd3d-utils, resolved at run time ------------------------------------------ */
+static void* s_utils;
+static void* utils_sym(const char* name)
+{
+    if (!s_utils) {
+        const char* lib = getenv("PS3_VKD3D_UTILS");
+        if (!lib || !*lib) lib = "libvkd3d-utils.so.1";
+        s_utils = dlopen(lib, RTLD_NOW | RTLD_LOCAL);
+        fprintf(stderr, "[vkd3d] %s %s%s%s\n", lib, s_utils ? "loaded" : "NOT loadable",
+                s_utils ? "" : ": ", s_utils ? "" : dlerror());
+        if (!s_utils) return NULL;
+    }
+    void* p = dlsym(s_utils, name);
+    if (!p) fprintf(stderr, "[vkd3d] missing %s\n", name);
+    return p;
+}
+void* ld_vkd3d_utils_sym(const char* name) { return utils_sym(name); }
+
+/* rsx_live_draw_vkd3d_wsi.c: SDL2 window + Vulkan swapchain when a display is there */
+int     ld_wsi_wanted(void);
+HRESULT ld_wsi_create_device(D3D_FEATURE_LEVEL level, REFIID iid, void** device);
+int     ld_wsi_attach(ID3D12CommandQueue* queue, ID3D12Device* dev, ID3D12Resource* const* bufs,
+                      UINT count, DXGI_FORMAT fmt, UINT w, UINT h);
+void    ld_wsi_present(UINT index);
+
+#define UTILS_FN(type, name) static type p_##name; \
+    if (!p_##name) p_##name = (type)utils_sym(#name)
+
+typedef HRESULT (WINAPI *pfn_create_device)(IUnknown*, D3D_FEATURE_LEVEL, REFIID, void**, enum vkd3d_api_version);
+typedef HRESULT (WINAPI *pfn_get_debug)(REFIID, void**);
+typedef HRESULT (WINAPI *pfn_serialize_rs)(const D3D12_ROOT_SIGNATURE_DESC*, D3D_ROOT_SIGNATURE_VERSION, ID3DBlob**, ID3DBlob**);
+typedef HRESULT (WINAPI *pfn_compile)(const void*, SIZE_T, const char*, const D3D_SHADER_MACRO*, ID3DInclude*,
+                                      const char*, const char*, UINT, UINT, ID3DBlob**, ID3DBlob**);
+typedef HRESULT (WINAPI *pfn_create_blob)(SIZE_T, ID3DBlob**);
+typedef HANDLE (*pfn_create_event)(void);
+typedef unsigned int (*pfn_wait_event)(HANDLE, unsigned int);
+
+HRESULT WINAPI D3D12CreateDeviceVKD3D(IUnknown* adapter, D3D_FEATURE_LEVEL level, REFIID iid, void** device,
+                                      enum vkd3d_api_version api)
+{
+    if (ld_wsi_wanted()) {   /* a display: libvkd3d device with the WSI extensions */
+        HRESULT whr = ld_wsi_create_device(level, iid, device);
+        if (SUCCEEDED(whr)) return whr;
+        fprintf(stderr, "[vkd3d] windowed device failed (0x%08x) -- offscreen\n", (unsigned)whr);
+    }
+    UTILS_FN(pfn_create_device, D3D12CreateDeviceVKD3D);
+    HRESULT hr = p_D3D12CreateDeviceVKD3D ? p_D3D12CreateDeviceVKD3D(adapter, level, iid, device, api) : E_FAIL;
+    fprintf(stderr, "[vkd3d] D3D12CreateDevice(FL 0x%x) hr=0x%08x\n", (unsigned)level, (unsigned)hr);
+    return hr;
+}
+HRESULT WINAPI D3D12GetDebugInterface(REFIID iid, void** debug)
+{
+    UTILS_FN(pfn_get_debug, D3D12GetDebugInterface);
+    return p_D3D12GetDebugInterface ? p_D3D12GetDebugInterface(iid, debug) : E_NOINTERFACE;
+}
+HRESULT WINAPI D3D12SerializeRootSignature(const D3D12_ROOT_SIGNATURE_DESC* desc, D3D_ROOT_SIGNATURE_VERSION v,
+                                           ID3DBlob** blob, ID3DBlob** err)
+{
+    UTILS_FN(pfn_serialize_rs, D3D12SerializeRootSignature);
+    return p_D3D12SerializeRootSignature ? p_D3D12SerializeRootSignature(desc, v, blob, err) : E_FAIL;
+}
+HRESULT WINAPI D3DCompile(const void* data, SIZE_T size, const char* file, const D3D_SHADER_MACRO* defines,
+                          ID3DInclude* include, const char* entry, const char* profile, UINT f1, UINT f2,
+                          ID3DBlob** code, ID3DBlob** errors)
+{
+    UTILS_FN(pfn_compile, D3DCompile);
+    return p_D3DCompile ? p_D3DCompile(data, size, file, defines, include, entry, profile, f1, f2, code, errors)
+                        : E_FAIL;
+}
+HRESULT WINAPI D3DCreateBlob(SIZE_T size, ID3DBlob** blob)
+{
+    UTILS_FN(pfn_create_blob, D3DCreateBlob);
+    return p_D3DCreateBlob ? p_D3DCreateBlob(size, blob) : E_FAIL;
+}
+HANDLE ld_vkd3d_create_event(void)
+{
+    UTILS_FN(pfn_create_event, vkd3d_create_event);
+    return p_vkd3d_create_event ? p_vkd3d_create_event() : NULL;
+}
+unsigned ld_vkd3d_wait_event(HANDLE event, unsigned ms)
+{
+    UTILS_FN(pfn_wait_event, vkd3d_wait_event);
+    return p_vkd3d_wait_event ? p_vkd3d_wait_event(event, ms) : 0xFFFFFFFFu;
+}
+
+/* ---- minimal DXGI ------------------------------------------------------------------- */
+#define LD_SC_BUFFERS 4
+typedef struct ld_swapchain {
+    IDXGISwapChain3 iface;
+    LONG refs;
+    ID3D12Device* dev;
+    ID3D12Resource* buf[LD_SC_BUFFERS];
+    UINT count, index, width, height;
+    DXGI_FORMAT format;
+    unsigned long long presents;
+} ld_swapchain;
+
+static ld_swapchain* sc_of(IDXGISwapChain3* i) { return (ld_swapchain*)i; }
+
+static HRESULT STDMETHODCALLTYPE sc_query(IDXGISwapChain3* This, REFIID riid, void** out)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDXGISwapChain) ||
+        IsEqualGUID(riid, &IID_IDXGISwapChain1) || IsEqualGUID(riid, &IID_IDXGISwapChain2) ||
+        IsEqualGUID(riid, &IID_IDXGISwapChain3)) {
+        This->lpVtbl->AddRef(This);
+        *out = This;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE sc_addref(IDXGISwapChain3* This) { return (ULONG)InterlockedIncrement(&sc_of(This)->refs); }
+static ULONG STDMETHODCALLTYPE sc_release(IDXGISwapChain3* This)
+{
+    ld_swapchain* s = sc_of(This);
+    LONG r = InterlockedDecrement(&s->refs);
+    if (r == 0) {
+        for (UINT i = 0; i < s->count; i++) if (s->buf[i]) s->buf[i]->lpVtbl->Release(s->buf[i]);
+        if (s->dev) s->dev->lpVtbl->Release(s->dev);
+        free(s);
+    }
+    return (ULONG)r;
+}
+static HRESULT STDMETHODCALLTYPE sc_present(IDXGISwapChain3* This, UINT sync, UINT flags)
+{
+    (void)sync; (void)flags;
+    ld_swapchain* s = sc_of(This);
+    ld_wsi_present(s->index);   /* no-op without a window */
+    s->index = (s->index + 1) % s->count;
+    if (++s->presents <= 3 || (s->presents & (s->presents - 1)) == 0)
+        fprintf(stderr, "[vkd3d] present #%llu\n", s->presents);
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE sc_get_buffer(IDXGISwapChain3* This, UINT i, REFIID riid, void** out)
+{
+    ld_swapchain* s = sc_of(This);
+    if (i >= s->count || !s->buf[i]) return DXGI_ERROR_INVALID_CALL;
+    return s->buf[i]->lpVtbl->QueryInterface(s->buf[i], riid, out);
+}
+static UINT STDMETHODCALLTYPE sc_index(IDXGISwapChain3* This) { return sc_of(This)->index; }
+static HRESULT STDMETHODCALLTYPE sc_resize(IDXGISwapChain3* This, UINT count, UINT w, UINT h, DXGI_FORMAT f, UINT flags)
+{
+    (void)This; (void)count; (void)w; (void)h; (void)f; (void)flags;
+    return S_OK;   /* fixed-size offscreen targets */
+}
+static HRESULT STDMETHODCALLTYPE sc_get_desc1(IDXGISwapChain3* This, DXGI_SWAP_CHAIN_DESC1* d)
+{
+    ld_swapchain* s = sc_of(This);
+    memset(d, 0, sizeof *d);
+    d->Width = s->width; d->Height = s->height; d->Format = s->format;
+    d->SampleDesc.Count = 1; d->BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    d->BufferCount = s->count; d->SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    return S_OK;
+}
+static IDXGISwapChain3Vtbl s_sc_vtbl = {
+    .QueryInterface = sc_query, .AddRef = sc_addref, .Release = sc_release,
+    .Present = sc_present, .GetBuffer = sc_get_buffer, .ResizeBuffers = sc_resize,
+    .GetDesc1 = sc_get_desc1, .GetCurrentBackBufferIndex = sc_index,
+};
+
+typedef struct ld_factory { IDXGIFactory4 iface; LONG refs; } ld_factory;
+
+static HRESULT STDMETHODCALLTYPE fac_query(IDXGIFactory4* This, REFIID riid, void** out)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDXGIFactory) ||
+        IsEqualGUID(riid, &IID_IDXGIFactory1) || IsEqualGUID(riid, &IID_IDXGIFactory2) ||
+        IsEqualGUID(riid, &IID_IDXGIFactory3) || IsEqualGUID(riid, &IID_IDXGIFactory4)) {
+        This->lpVtbl->AddRef(This);
+        *out = This;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE fac_addref(IDXGIFactory4* This) { return (ULONG)InterlockedIncrement(&((ld_factory*)This)->refs); }
+static ULONG STDMETHODCALLTYPE fac_release(IDXGIFactory4* This)
+{
+    LONG r = InterlockedDecrement(&((ld_factory*)This)->refs);
+    if (r == 0) free(This);
+    return (ULONG)r;
+}
+static HRESULT STDMETHODCALLTYPE fac_create_swapchain_for_hwnd(IDXGIFactory4* This, IUnknown* device, HWND window,
+    const DXGI_SWAP_CHAIN_DESC1* desc, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* fs, IDXGIOutput* output,
+    IDXGISwapChain1** out)
+{
+    (void)This; (void)window; (void)fs; (void)output;
+    *out = NULL;
+    ID3D12CommandQueue* queue = NULL;
+    if (FAILED(device->lpVtbl->QueryInterface(device, &IID_ID3D12CommandQueue, (void**)&queue)))
+        return DXGI_ERROR_INVALID_CALL;
+    ld_swapchain* s = (ld_swapchain*)calloc(1, sizeof *s);
+    if (!s) { queue->lpVtbl->Release(queue); return E_OUTOFMEMORY; }
+    s->iface.lpVtbl = &s_sc_vtbl;
+    s->refs = 1;
+    s->count = desc->BufferCount < LD_SC_BUFFERS ? desc->BufferCount : LD_SC_BUFFERS;
+    if (!s->count) s->count = 2;
+    s->width = desc->Width ? desc->Width : 1280;
+    s->height = desc->Height ? desc->Height : 720;
+    s->format = desc->Format;
+    HRESULT hr = queue->lpVtbl->GetDevice(queue, &IID_ID3D12Device, (void**)&s->dev);
+    if (FAILED(hr)) { queue->lpVtbl->Release(queue); free(s); return hr; }
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp);
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = s->width; rd.Height = s->height; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = s->format; rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    for (UINT i = 0; i < s->count; i++) {
+        hr = s->dev->lpVtbl->CreateCommittedResource(s->dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_PRESENT, NULL, &IID_ID3D12Resource, (void**)&s->buf[i]);
+        if (FAILED(hr)) { queue->lpVtbl->Release(queue); sc_release(&s->iface); return hr; }
+    }
+    /* the live-draw queue lives as long as the renderer; the presenter keeps using it */
+    const int windowed = ld_wsi_attach(queue, s->dev, s->buf, s->count, s->format, s->width, s->height);
+    queue->lpVtbl->Release(queue);
+    fprintf(stderr, "[vkd3d] swap chain %ux%u x%u %s\n", s->width, s->height, s->count,
+            windowed ? "-> SDL2/Vulkan window" : "offscreen (no display: frames only via LD_FRAME_DUMP)");
+    *out = (IDXGISwapChain1*)&s->iface;
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE fac_enum_adapter_by_luid(IDXGIFactory4* This, LUID luid, REFIID riid, void** out)
+{
+    (void)This; (void)luid; (void)riid;
+    *out = NULL;
+    return DXGI_ERROR_NOT_FOUND;   /* only the YZ_PERF_PROFILE budget readout asks */
+}
+static IDXGIFactory4Vtbl s_fac_vtbl = {
+    .QueryInterface = fac_query, .AddRef = fac_addref, .Release = fac_release,
+    .CreateSwapChainForHwnd = fac_create_swapchain_for_hwnd,
+    .EnumAdapterByLuid = fac_enum_adapter_by_luid,
+};
+
+HRESULT __stdcall CreateDXGIFactory1(REFIID riid, void** out)
+{
+    ld_factory* f = (ld_factory*)calloc(1, sizeof *f);
+    if (!f) return E_OUTOFMEMORY;
+    f->iface.lpVtbl = &s_fac_vtbl;
+    f->refs = 1;
+    HRESULT hr = fac_query(&f->iface, riid, out);
+    fac_release(&f->iface);
+    return hr;
+}
+
+#else
+typedef int ps3_rsx_live_draw_vkd3d_unused;   /* ISO C: no empty translation unit */
+#endif
diff --git a/libs/video/rsx_live_draw_vkd3d.h b/libs/video/rsx_live_draw_vkd3d.h
new file mode 100644
index 00000000..70368a5d
--- /dev/null
+++ b/libs/video/rsx_live_draw_vkd3d.h
@@ -0,0 +1,88 @@
+/*
+ * ps3recomp - the D3D12 live-draw renderer off Windows, on vkd3d (RSX_LIVE_VKD3D)
+ *
+ * rsx_live_draw.c is D3D12 + DXGI + D3DCompile. Upstream vkd3d (Wine's, LGPL-2.1) is the
+ * same API on Vulkan: libvkd3d-utils exports D3D12CreateDevice(VKD3D), D3D12SerializeRoot-
+ * Signature, D3D12GetDebugInterface, D3DCompile (vkd3d-shader HLSL -> the whole THP8 shader
+ * corpus compiles, docs/LINUX.md) and D3DCreateBlob, and its widl headers are the Windows
+ * SDK's C COM headers. What it lacks is DXGI, so rsx_live_draw_vkd3d.c brings a minimal
+ * IDXGIFactory4 / IDXGISwapChain3 (offscreen back buffers today; a Vulkan-WSI present on an
+ * SDL window is the next step) and resolves the vkd3d entry points with dlopen at run time,
+ * so the binary has no link-time vkd3d dependency.
+ *
+ * Included by rsx_live_draw.c in place of <windows.h>/<d3d12.h>/<dxgi1_4.h>/<d3dcompiler.h>
+ * when RSX_LIVE_VKD3D is defined (CMake PS3RECOMP_LIVE_DRAW_VKD3D, non-Windows only).
+ */
+#ifndef PS3RECOMP_RSX_LIVE_DRAW_VKD3D_H
+#define PS3RECOMP_RSX_LIVE_DRAW_VKD3D_H
+
+#define COM_NO_WINDOWS_H
+#include <vkd3d_windows.h>
+#include <vkd3d_d3d12.h>
+#include <vkd3d_d3d12sdklayers.h>
+#include <vkd3d_dxgi1_4.h>
+#include <vkd3d_d3dcompiler.h>
+#include <vkd3d_utils.h>
+
+/* The ps3recomp Win32 shim (threads, interlocked, QPC, SRW locks, file attributes ...).
+ * Its only clash with vkd3d_windows.h is LONG64 (long long vs vkd3d's int64_t). */
+#define LONG64 PS3_SHIM_LONG64
+#include "../../runtime/platform/win32_compat.h"
+#undef LONG64
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <strings.h>
+#include <unistd.h>
+
+/* MSVC CRT spellings */
+#ifndef _strtoui64
+#define _strtoui64 strtoull
+#endif
+#ifndef _stricmp
+#define _stricmp strcasecmp
+#endif
+#define _popen popen
+#define _pclose pclose
+
+/* The few Win32 file calls the shim does not carry. */
+#ifndef MOVEFILE_REPLACE_EXISTING
+#define MOVEFILE_REPLACE_EXISTING 0x1u
+#define MOVEFILE_WRITE_THROUGH    0x8u
+#endif
+static inline BOOL MoveFileExA(const char* from, const char* to, DWORD flags)
+{ (void)flags; return rename(from, to) == 0; }
+static inline BOOL DeleteFileA(const char* path) { return unlink(path) == 0; }
+static inline BOOL GetProcessTimes(HANDLE p, FILETIME* c, FILETIME* e, FILETIME* k, FILETIME* u)
+{ (void)p; (void)c; (void)e; (void)k; (void)u; return FALSE; }
+
+/* Fence events: vkd3d-utils' D3D12CreateDevice signals ITS events (vkd3d_create_event), so
+ * the one fence event rsx_live_draw.c creates and waits on must be one of those. */
+HANDLE   ld_vkd3d_create_event(void);
+unsigned ld_vkd3d_wait_event(HANDLE event, unsigned milliseconds);
+#define CreateEventA(sa, manual, initial, name) ld_vkd3d_create_event()
+/* DXGI 1.5+ names the renderer uses for tearing / frame-latency presents. vkd3d's headers stop at DXGI 1.4 and
+ * neither vkd3d's glue nor the WebGPU layer offers IDXGIFactory5 (QueryInterface fails), so the tearing path
+ * stays off: this is compile-only (the vtable below is never called). */
+#ifndef DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT
+#define DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT 64
+#endif
+#ifndef DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING
+#define DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING 2048
+#endif
+#ifndef DXGI_PRESENT_ALLOW_TEARING
+#define DXGI_PRESENT_ALLOW_TEARING 0x00000200u
+#endif
+#define DXGI_FEATURE_PRESENT_ALLOW_TEARING 0
+typedef struct IDXGIFactory5 IDXGIFactory5;
+typedef struct IDXGIFactory5Vtbl {
+    HRESULT (STDMETHODCALLTYPE* QueryInterface)(IDXGIFactory5*, REFIID, void**);
+    ULONG (STDMETHODCALLTYPE* AddRef)(IDXGIFactory5*);
+    ULONG (STDMETHODCALLTYPE* Release)(IDXGIFactory5*);
+    HRESULT (STDMETHODCALLTYPE* CheckFeatureSupport)(IDXGIFactory5*, UINT, void*, UINT);
+} IDXGIFactory5Vtbl;
+struct IDXGIFactory5 { const IDXGIFactory5Vtbl* lpVtbl; };
+static const IID IID_IDXGIFactory5 = { 0x7632e1f5, 0xee65, 0x4dca, { 0x87, 0xfd, 0x84, 0xcd, 0x75, 0xf8, 0x83, 0x8d } };
+#define WaitForSingleObject(h, ms)              ld_vkd3d_wait_event((h), (ms))
+
+#endif /* PS3RECOMP_RSX_LIVE_DRAW_VKD3D_H */
diff --git a/libs/video/rsx_live_draw_vkd3d_wsi.c b/libs/video/rsx_live_draw_vkd3d_wsi.c
new file mode 100644
index 00000000..5b40f6b0
--- /dev/null
+++ b/libs/video/rsx_live_draw_vkd3d_wsi.c
@@ -0,0 +1,608 @@
+/*
+ * ps3recomp - on-screen presentation for the live-draw renderer on vkd3d (RSX_LIVE_VKD3D)
+ *
+ * With a display ($DISPLAY / $WAYLAND_DISPLAY, and PS3_VKD3D_WINDOW not "0") the D3D12
+ * device is created through libvkd3d itself (vkd3d_create_device) with the surface
+ * extensions SDL2 asks for plus VK_KHR_swapchain, an SDL2 window gets a Vulkan swapchain on
+ * vkd3d's VkDevice, and every swapchain image is wrapped as a D3D12 resource
+ * (vkd3d_create_image_resource) -- the recipe of vkd3d's own demos.
+ *
+ * Live-draw keeps rendering into its offscreen R8G8B8A8 back buffers (rsx_live_draw_vkd3d.c);
+ * Present() draws the current one into the acquired swapchain image with a full-screen
+ * triangle (aspect-fit, black bars unless PS3_FULLSCREEN_ASPECT is empty), so the swapchain
+ * may use whatever format the surface offers (BGRA on most X11/Wayland drivers), then
+ * presents it on vkd3d's queue between vkd3d_acquire_vk_queue / vkd3d_release_vk_queue.
+ *
+ * No CPU wait per frame: the blit is recorded into one of LD_WSI_FRAMES command lists (a slot is
+ * reused only once the D3D12 fence says its previous blit finished), and the image goes to the
+ * presentation engine behind a binary semaphore. vkd3d submits ExecuteCommandLists to the VkQueue
+ * synchronously (no queue Wait() is pending in live-draw), so an empty vkQueueSubmit right after it
+ * whose signal semaphore covers "all queue operations previously submitted" (Vulkan spec, semaphore
+ * signal) is exactly "the blit is done"; vkQueuePresentKHR waits on that semaphore (one per swapchain
+ * image: an image is acquired again only after its previous present consumed the wait).
+ * PS3_VKD3D_PRESENT_WAIT=1 restores the old behaviour (CPU waits for the blit before each present).
+ *
+ * Window events are pumped from boot_main's frame loop (rsx_null_backend_pump_messages ->
+ * rsx_live_draw_vkd3d_pump): closing the window hides it and reports "closed" once, which
+ * boot_main turns into the console's Quit Game request -- as on Windows. F11 toggles
+ * borderless fullscreen.
+ */
+#if defined(RSX_LIVE_VKD3D) && !defined(_WIN32) && !defined(PS3_WASM)   /* wasm: presents via the WebGPU worker */
+
+#include "rsx_live_draw_vkd3d.h"
+#include <vkd3d.h>
+#include <SDL.h>
+#include <SDL_vulkan.h>
+#include <dlfcn.h>
+#include <string.h>
+
+void* ld_vkd3d_utils_sym(const char* name);   /* rsx_live_draw_vkd3d.c */
+
+#define LD_WSI_MAX_IMAGES 8
+#define LD_WSI_MAX_SRC    4
+#define LD_WSI_FRAMES     3   /* blit command lists in flight */
+
+static struct {
+    int checked, wanted;
+    SDL_Window* win;
+    int quit_reported, hidden, fullscreen, keep_aspect;
+    void* lib;
+    PFN_vkd3d_create_device create_device;
+    PFN_vkd3d_instance_from_device instance_from_device;
+    PFN_vkd3d_instance_get_vk_instance get_vk_instance;
+    PFN_vkd3d_get_vk_device get_vk_device;
+    PFN_vkd3d_get_vk_physical_device get_vk_physical_device;
+    PFN_vkd3d_get_vk_queue_family_index get_queue_family;
+    PFN_vkd3d_acquire_vk_queue acquire_queue;
+    PFN_vkd3d_release_vk_queue release_queue;
+    PFN_vkd3d_create_image_resource create_image_resource;
+
+    PFN_vkGetPhysicalDeviceSurfaceSupportKHR      surf_support;
+    PFN_vkGetPhysicalDeviceSurfaceCapabilitiesKHR surf_caps;
+    PFN_vkGetPhysicalDeviceSurfaceFormatsKHR      surf_formats;
+    PFN_vkCreateSwapchainKHR    create_swapchain;
+    PFN_vkDestroySwapchainKHR   destroy_swapchain;
+    PFN_vkGetSwapchainImagesKHR get_images;
+    PFN_vkAcquireNextImageKHR   acquire_image;
+    PFN_vkQueuePresentKHR       queue_present;
+    PFN_vkCreateFence  create_fence;
+    PFN_vkWaitForFences wait_fences;
+    PFN_vkResetFences  reset_fences;
+    PFN_vkCreateSemaphore create_semaphore;
+    PFN_vkQueueSubmit     queue_submit;
+
+    VkInstance inst; VkPhysicalDevice phys; VkDevice vkdev; uint32_t qfi;
+    VkSurfaceKHR surf; VkSwapchainKHR swap; VkFence acq_fence;
+    VkFormat vkfmt; DXGI_FORMAT dxfmt; VkExtent2D extent;
+    uint32_t img_count, img_index; int need_recreate, attached;
+    ID3D12Resource* img[LD_WSI_MAX_IMAGES];
+
+    ID3D12Device* dev; ID3D12CommandQueue* queue;
+    ID3D12RootSignature* rs; ID3D12PipelineState* pso; DXGI_FORMAT pso_fmt;
+    ID3D12DescriptorHeap* srv_heap; ID3D12DescriptorHeap* rtv_heap; UINT srv_step, rtv_step;
+    ID3D12CommandAllocator* alloc; ID3D12GraphicsCommandList* list;   /* the current frame slot's */
+    ID3D12CommandAllocator* falloc[LD_WSI_FRAMES]; ID3D12GraphicsCommandList* flist[LD_WSI_FRAMES];
+    UINT64 fdone[LD_WSI_FRAMES]; unsigned long long frame;
+    VkSemaphore present_sem[LD_WSI_MAX_IMAGES]; int sync_present;
+    ID3D12Fence* fence; UINT64 fence_val; HANDLE fence_event;
+    ID3D12Resource* src[LD_WSI_MAX_SRC]; UINT src_count, src_w, src_h; DXGI_FORMAT src_fmt;
+} W;
+
+int ld_wsi_wanted(void)
+{
+    if (W.checked) return W.wanted;
+    W.checked = 1;
+    const char* e = getenv("PS3_VKD3D_WINDOW");
+    if (e && *e == '0') return W.wanted = 0;
+    const char* d = getenv("DISPLAY");
+    const char* wl = getenv("WAYLAND_DISPLAY");
+    W.wanted = (d && *d) || (wl && *wl) || (e && *e == '1');
+    return W.wanted;
+}
+
+static void* lib_sym(const char* name)
+{
+    void* p = W.lib ? dlsym(W.lib, name) : NULL;
+    if (!p) fprintf(stderr, "[vkd3d-wsi] missing %s\n", name);
+    return p;
+}
+
+/* SDL window + vkd3d instance/device with the WSI extensions. */
+HRESULT ld_wsi_create_device(D3D_FEATURE_LEVEL level, REFIID iid, void** device)
+{
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) {
+        fprintf(stderr, "[vkd3d-wsi] SDL video init failed: %s -- offscreen\n", SDL_GetError());
+        W.wanted = 0; return E_FAIL;
+    }
+    if (SDL_Vulkan_LoadLibrary(NULL) != 0) {
+        fprintf(stderr, "[vkd3d-wsi] SDL_Vulkan_LoadLibrary: %s -- offscreen\n", SDL_GetError());
+        W.wanted = 0; return E_FAIL;
+    }
+    int ww = 1280, wh = 720;
+    { const char* e = getenv("PS3_WINDOW"); unsigned a = 0, b = 0;
+      if (e && sscanf(e, "%ux%u", &a, &b) == 2 && a >= 320 && b >= 180) { ww = (int)a; wh = (int)b; } }
+    /* A window larger than the desktop (the 1920x1080 default on a 1280x800 Steam Deck desktop, a small laptop
+     * screen) opens partly off screen, and some window systems (Xvfb + lavapipe here) then show nothing at all:
+     * shrink it to fit, same aspect. Fullscreen is not affected. */
+    {   SDL_DisplayMode dm;
+        if (SDL_GetDesktopDisplayMode(0, &dm) == 0 && dm.w > 0 && dm.h > 0 && (ww > dm.w || wh > dm.h)) {
+            const double s = (double)dm.w / ww < (double)dm.h / wh ? (double)dm.w / ww : (double)dm.h / wh;
+            const int nw = (int)(ww * s * 0.95), nh = (int)(wh * s * 0.95);
+            fprintf(stderr, "[vkd3d-wsi] window %dx%d is larger than the desktop %dx%d: %dx%d\n", ww, wh, dm.w, dm.h, nw, nh);
+            ww = nw; wh = nh;
+        }
+    }
+    { const char* e = getenv("PS3_FULLSCREEN"); W.fullscreen = e && *e && *e != '0'; }
+    { const char* e = getenv("PS3_FULLSCREEN_ASPECT"); W.keep_aspect = !e || (*e && *e != '0'); }
+    const char* title = getenv("PS3_TITLE");
+    W.win = SDL_CreateWindow(title && *title ? title : "Tony Hawk's Project 8",
+                             SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, ww, wh,
+                             SDL_WINDOW_VULKAN | SDL_WINDOW_RESIZABLE |
+                             (W.fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0));
+    if (!W.win) {
+        fprintf(stderr, "[vkd3d-wsi] SDL_CreateWindow: %s -- offscreen\n", SDL_GetError());
+        W.wanted = 0; return E_FAIL;
+    }
+    unsigned n = 0;
+    const char* exts[16];
+    if (!SDL_Vulkan_GetInstanceExtensions(W.win, &n, NULL) || n > 16 ||
+        !SDL_Vulkan_GetInstanceExtensions(W.win, &n, exts)) {
+        fprintf(stderr, "[vkd3d-wsi] SDL_Vulkan_GetInstanceExtensions: %s\n", SDL_GetError());
+        return E_FAIL;
+    }
+    const char* lib = getenv("PS3_VKD3D_LIB");
+    if (!lib || !*lib) lib = "libvkd3d.so.1";
+    W.lib = dlopen(lib, RTLD_NOW | RTLD_LOCAL);
+    if (!W.lib) { fprintf(stderr, "[vkd3d-wsi] %s: %s\n", lib, dlerror()); return E_FAIL; }
+    W.create_device          = (PFN_vkd3d_create_device)lib_sym("vkd3d_create_device");
+    W.instance_from_device   = (PFN_vkd3d_instance_from_device)lib_sym("vkd3d_instance_from_device");
+    W.get_vk_instance        = (PFN_vkd3d_instance_get_vk_instance)lib_sym("vkd3d_instance_get_vk_instance");
+    W.get_vk_device          = (PFN_vkd3d_get_vk_device)lib_sym("vkd3d_get_vk_device");
+    W.get_vk_physical_device = (PFN_vkd3d_get_vk_physical_device)lib_sym("vkd3d_get_vk_physical_device");
+    W.get_queue_family       = (PFN_vkd3d_get_vk_queue_family_index)lib_sym("vkd3d_get_vk_queue_family_index");
+    W.acquire_queue          = (PFN_vkd3d_acquire_vk_queue)lib_sym("vkd3d_acquire_vk_queue");
+    W.release_queue          = (PFN_vkd3d_release_vk_queue)lib_sym("vkd3d_release_vk_queue");
+    W.create_image_resource  = (PFN_vkd3d_create_image_resource)lib_sym("vkd3d_create_image_resource");
+    PFN_vkd3d_signal_event signal = (PFN_vkd3d_signal_event)ld_vkd3d_utils_sym("vkd3d_signal_event");
+    if (!W.create_device || !W.instance_from_device || !W.get_vk_instance || !W.get_vk_device ||
+        !W.get_vk_physical_device || !W.get_queue_family || !W.acquire_queue || !W.release_queue ||
+        !W.create_image_resource || !signal)
+        return E_FAIL;
+
+    static const char* const dev_exts[] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+    struct vkd3d_instance_create_info ici;
+    memset(&ici, 0, sizeof ici);
+    ici.type = VKD3D_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+    ici.pfn_signal_event = signal;
+    ici.wchar_size = sizeof(WCHAR);
+    ici.instance_extensions = exts;
+    ici.instance_extension_count = n;
+    struct vkd3d_device_create_info dci;
+    memset(&dci, 0, sizeof dci);
+    dci.type = VKD3D_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
+    dci.minimum_feature_level = level;
+    dci.instance_create_info = &ici;
+    dci.device_extensions = dev_exts;
+    dci.device_extension_count = 1;
+    HRESULT hr = W.create_device(&dci, iid, device);
+    fprintf(stderr, "[vkd3d-wsi] window %dx%d%s, vkd3d device with %u instance extension(s) + "
+                    "VK_KHR_swapchain hr=0x%08x\n", ww, wh, W.fullscreen ? " fullscreen" : "", n, (unsigned)hr);
+    return hr;
+}
+
+static int load_vk(void)
+{
+    PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)SDL_Vulkan_GetVkGetInstanceProcAddr();
+    if (!gipa) return 0;
+#define IFN(m, n) W.m = (PFN_##n)gipa(W.inst, #n); if (!W.m) { fprintf(stderr, "[vkd3d-wsi] no %s\n", #n); return 0; }
+    IFN(surf_support, vkGetPhysicalDeviceSurfaceSupportKHR)
+    IFN(surf_caps, vkGetPhysicalDeviceSurfaceCapabilitiesKHR)
+    IFN(surf_formats, vkGetPhysicalDeviceSurfaceFormatsKHR)
+    PFN_vkGetDeviceProcAddr gdpa = (PFN_vkGetDeviceProcAddr)gipa(W.inst, "vkGetDeviceProcAddr");
+    if (!gdpa) return 0;
+#define DFN(m, n) W.m = (PFN_##n)gdpa(W.vkdev, #n); if (!W.m) { fprintf(stderr, "[vkd3d-wsi] no %s\n", #n); return 0; }
+    DFN(create_swapchain, vkCreateSwapchainKHR)
+    DFN(destroy_swapchain, vkDestroySwapchainKHR)
+    DFN(get_images, vkGetSwapchainImagesKHR)
+    DFN(acquire_image, vkAcquireNextImageKHR)
+    DFN(queue_present, vkQueuePresentKHR)
+    DFN(create_fence, vkCreateFence)
+    DFN(wait_fences, vkWaitForFences)
+    DFN(reset_fences, vkResetFences)
+    DFN(create_semaphore, vkCreateSemaphore)
+    DFN(queue_submit, vkQueueSubmit)
+#undef IFN
+#undef DFN
+    return 1;
+}
+
+static void wait_value(UINT64 v)
+{
+    if (W.fence->lpVtbl->GetCompletedValue(W.fence) < v) {
+        W.fence->lpVtbl->SetEventOnCompletion(W.fence, v, W.fence_event);
+        ld_vkd3d_wait_event(W.fence_event, 0xFFFFFFFFu);
+    }
+}
+
+static void wait_gpu(void)
+{
+    W.fence_val++;
+    W.queue->lpVtbl->Signal(W.queue, W.fence, W.fence_val);
+    wait_value(W.fence_val);
+}
+
+static void release_images(void)
+{
+    for (uint32_t i = 0; i < W.img_count; i++)
+        if (W.img[i]) { W.img[i]->lpVtbl->Release(W.img[i]); W.img[i] = NULL; }
+    W.img_count = 0;
+}
+
+static int build_pso(DXGI_FORMAT fmt);
+
+/* (Re)create the VkSwapchain, wrap its images, RTVs. */
+static int make_swapchain(void)
+{
+    VkSurfaceCapabilitiesKHR caps;
+    if (W.surf_caps(W.phys, W.surf, &caps) != VK_SUCCESS) return 0;
+    uint32_t nf = 0;
+    W.surf_formats(W.phys, W.surf, &nf, NULL);
+    VkSurfaceFormatKHR fmts[64];
+    if (nf > 64) nf = 64;
+    W.surf_formats(W.phys, W.surf, &nf, fmts);
+    W.vkfmt = VK_FORMAT_UNDEFINED;
+    for (uint32_t pass = 0; pass < 2 && W.vkfmt == VK_FORMAT_UNDEFINED; pass++)
+        for (uint32_t i = 0; i < nf; i++) {
+            VkFormat f = fmts[i].format;
+            if ((pass == 0 && f == VK_FORMAT_B8G8R8A8_UNORM) || (pass == 1 && f == VK_FORMAT_R8G8B8A8_UNORM)) {
+                W.vkfmt = f; break;
+            }
+        }
+    if (W.vkfmt == VK_FORMAT_UNDEFINED) { fprintf(stderr, "[vkd3d-wsi] no BGRA8/RGBA8 surface format\n"); return 0; }
+    W.dxfmt = W.vkfmt == VK_FORMAT_B8G8R8A8_UNORM ? DXGI_FORMAT_B8G8R8A8_UNORM : DXGI_FORMAT_R8G8B8A8_UNORM;
+    VkExtent2D ext = caps.currentExtent;
+    if (ext.width == 0xFFFFFFFFu) {
+        int dw = 0, dh = 0;
+        SDL_Vulkan_GetDrawableSize(W.win, &dw, &dh);
+        ext.width = (uint32_t)dw; ext.height = (uint32_t)dh;
+    }
+    if (!ext.width || !ext.height) return 0;   /* minimised: try again next frame */
+    uint32_t count = caps.minImageCount + 1;
+    if (caps.maxImageCount && count > caps.maxImageCount) count = caps.maxImageCount;
+    if (count > LD_WSI_MAX_IMAGES) count = LD_WSI_MAX_IMAGES;
+    VkSwapchainCreateInfoKHR sci;
+    memset(&sci, 0, sizeof sci);
+    sci.sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR;
+    sci.surface = W.surf;
+    sci.minImageCount = count;
+    sci.imageFormat = W.vkfmt;
+    sci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    sci.imageExtent = ext;
+    sci.imageArrayLayers = 1;
+    sci.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    sci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    sci.preTransform = caps.currentTransform;
+    sci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    sci.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+    sci.clipped = VK_TRUE;
+    sci.oldSwapchain = W.swap;
+    VkSwapchainKHR sw = VK_NULL_HANDLE;
+    if (W.create_swapchain(W.vkdev, &sci, NULL, &sw) != VK_SUCCESS) {
+        fprintf(stderr, "[vkd3d-wsi] vkCreateSwapchainKHR failed\n");
+        return 0;
+    }
+    if (W.swap) { release_images(); W.destroy_swapchain(W.vkdev, W.swap, NULL); }
+    W.swap = sw;
+    W.extent = ext;
+    VkImage imgs[LD_WSI_MAX_IMAGES];
+    uint32_t ni = LD_WSI_MAX_IMAGES;
+    W.get_images(W.vkdev, W.swap, &ni, imgs);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    W.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(W.rtv_heap, &rtv);
+    for (uint32_t i = 0; i < ni; i++) {
+        struct vkd3d_image_resource_create_info ric;
+        memset(&ric, 0, sizeof ric);
+        ric.type = VKD3D_STRUCTURE_TYPE_IMAGE_RESOURCE_CREATE_INFO;
+        ric.vk_image = imgs[i];
+        ric.desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        ric.desc.Width = ext.width; ric.desc.Height = ext.height;
+        ric.desc.DepthOrArraySize = 1; ric.desc.MipLevels = 1;
+        ric.desc.Format = W.dxfmt; ric.desc.SampleDesc.Count = 1;
+        ric.desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        ric.flags = VKD3D_RESOURCE_INITIAL_STATE_TRANSITION | VKD3D_RESOURCE_PRESENT_STATE_TRANSITION;
+        ric.present_state = D3D12_RESOURCE_STATE_PRESENT;
+        if (FAILED(W.create_image_resource(W.dev, &ric, &W.img[i]))) {
+            fprintf(stderr, "[vkd3d-wsi] vkd3d_create_image_resource failed\n");
+            return 0;
+        }
+        D3D12_CPU_DESCRIPTOR_HANDLE h = rtv; h.ptr += (SIZE_T)i * W.rtv_step;
+        W.dev->lpVtbl->CreateRenderTargetView(W.dev, W.img[i], NULL, h);
+    }
+    W.img_count = ni;
+    if (W.pso_fmt != W.dxfmt && !build_pso(W.dxfmt)) return 0;
+    fprintf(stderr, "[vkd3d-wsi] swapchain %ux%u, %u images, %s\n", ext.width, ext.height, ni,
+            W.vkfmt == VK_FORMAT_B8G8R8A8_UNORM ? "B8G8R8A8" : "R8G8B8A8");
+    W.need_recreate = 0;
+    return 1;
+}
+
+static int acquire_next(void)
+{
+    for (int tries = 0; tries < 2; tries++) {
+        if (W.need_recreate && !make_swapchain()) return 0;
+        VkResult r = W.acquire_image(W.vkdev, W.swap, UINT64_MAX, VK_NULL_HANDLE, W.acq_fence, &W.img_index);
+        if (r == VK_SUCCESS || r == VK_SUBOPTIMAL_KHR) {
+            W.wait_fences(W.vkdev, 1, &W.acq_fence, VK_TRUE, UINT64_MAX);
+            W.reset_fences(W.vkdev, 1, &W.acq_fence);
+            if (r == VK_SUBOPTIMAL_KHR) W.need_recreate = 1;   /* after this frame */
+            return 1;
+        }
+        if (r != VK_ERROR_OUT_OF_DATE_KHR) return 0;
+        wait_gpu();
+        W.need_recreate = 1;
+    }
+    return 0;
+}
+
+static const char k_blit_hlsl[] =
+    "Texture2D src : register(t0);\n"
+    "SamplerState smp : register(s0);\n"
+    "struct V { float4 pos : SV_POSITION; float2 uv : TEXCOORD0; };\n"
+    "V vs_main(uint id : SV_VertexID) {\n"
+    "    V o; o.uv = float2((id << 1) & 2, id & 2);\n"
+    "    o.pos = float4(o.uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0); return o; }\n"
+    "float4 ps_main(V i) : SV_TARGET { return float4(src.Sample(smp, i.uv).rgb, 1.0); }\n";
+
+static int build_pso(DXGI_FORMAT fmt)
+{
+    if (!W.rs) {
+        D3D12_DESCRIPTOR_RANGE range = { D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0 };
+        D3D12_ROOT_PARAMETER param;
+        memset(&param, 0, sizeof param);
+        param.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        param.DescriptorTable.NumDescriptorRanges = 1;
+        param.DescriptorTable.pDescriptorRanges = &range;
+        param.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_STATIC_SAMPLER_DESC smp;
+        memset(&smp, 0, sizeof smp);
+        smp.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        smp.AddressU = smp.AddressV = smp.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        smp.MaxLOD = 1000.0f;
+        smp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_ROOT_SIGNATURE_DESC rsd;
+        memset(&rsd, 0, sizeof rsd);
+        rsd.NumParameters = 1; rsd.pParameters = &param;
+        rsd.NumStaticSamplers = 1; rsd.pStaticSamplers = &smp;
+        ID3DBlob *sig = NULL, *err = NULL;
+        if (FAILED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err))) return 0;
+        HRESULT hr = W.dev->lpVtbl->CreateRootSignature(W.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                         sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&W.rs);
+        sig->lpVtbl->Release(sig);
+        if (FAILED(hr)) return 0;
+    }
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL;
+    if (FAILED(D3DCompile(k_blit_hlsl, sizeof k_blit_hlsl - 1, "blit", NULL, NULL, "vs_main", "vs_5_0", 0, 0, &vs, &err)) ||
+        FAILED(D3DCompile(k_blit_hlsl, sizeof k_blit_hlsl - 1, "blit", NULL, NULL, "ps_main", "ps_5_0", 0, 0, &ps, &err))) {
+        fprintf(stderr, "[vkd3d-wsi] blit shader: %s\n", err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        return 0;
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = W.rs;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = fmt;
+    pd.SampleDesc.Count = 1;
+    if (W.pso) { W.pso->lpVtbl->Release(W.pso); W.pso = NULL; }
+    HRESULT hr = W.dev->lpVtbl->CreateGraphicsPipelineState(W.dev, &pd, &IID_ID3D12PipelineState, (void**)&W.pso);
+    vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+    if (FAILED(hr)) { fprintf(stderr, "[vkd3d-wsi] blit PSO failed hr=0x%08x\n", (unsigned)hr); return 0; }
+    W.pso_fmt = fmt;
+    return 1;
+}
+
+/* Called by the DXGI shim once the offscreen back buffers exist. */
+int ld_wsi_attach(ID3D12CommandQueue* queue, ID3D12Device* dev, ID3D12Resource* const* bufs,
+                  UINT count, DXGI_FORMAT fmt, UINT w, UINT h)
+{
+    if (!W.wanted || !W.win || W.attached) return 0;
+    W.dev = dev; W.queue = queue;
+    W.inst = W.get_vk_instance(W.instance_from_device(dev));
+    W.phys = W.get_vk_physical_device(dev);
+    W.vkdev = W.get_vk_device(dev);
+    W.qfi = W.get_queue_family(queue);
+    if (!load_vk()) return 0;
+    if (!SDL_Vulkan_CreateSurface(W.win, W.inst, &W.surf)) {
+        fprintf(stderr, "[vkd3d-wsi] SDL_Vulkan_CreateSurface: %s\n", SDL_GetError());
+        return 0;
+    }
+    VkBool32 ok = VK_FALSE;
+    W.surf_support(W.phys, W.qfi, W.surf, &ok);
+    if (!ok) { fprintf(stderr, "[vkd3d-wsi] queue family %u cannot present\n", W.qfi); return 0; }
+    VkFenceCreateInfo fci;
+    memset(&fci, 0, sizeof fci);
+    fci.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    if (W.create_fence(W.vkdev, &fci, NULL, &W.acq_fence) != VK_SUCCESS) return 0;
+    { const char* e = getenv("PS3_VKD3D_PRESENT_WAIT"); W.sync_present = e && *e && *e != '0'; }
+    if (!W.sync_present) {
+        VkSemaphoreCreateInfo sci;
+        memset(&sci, 0, sizeof sci);
+        sci.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+        for (int i = 0; i < LD_WSI_MAX_IMAGES; i++)
+            if (W.create_semaphore(W.vkdev, &sci, NULL, &W.present_sem[i]) != VK_SUCCESS) { W.sync_present = 1; break; }
+    }
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd;
+    memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; hd.NumDescriptors = LD_WSI_MAX_IMAGES;
+    if (FAILED(dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&W.rtv_heap))) return 0;
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = LD_WSI_MAX_SRC;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&W.srv_heap))) return 0;
+    W.rtv_step = dev->lpVtbl->GetDescriptorHandleIncrementSize(dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    W.srv_step = dev->lpVtbl->GetDescriptorHandleIncrementSize(dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    W.src_count = count < LD_WSI_MAX_SRC ? count : LD_WSI_MAX_SRC;
+    W.src_w = w; W.src_h = h; W.src_fmt = fmt;
+    D3D12_CPU_DESCRIPTOR_HANDLE srv;
+    W.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(W.srv_heap, &srv);
+    for (UINT i = 0; i < W.src_count; i++) {
+        W.src[i] = bufs[i];
+        D3D12_SHADER_RESOURCE_VIEW_DESC sd;
+        memset(&sd, 0, sizeof sd);
+        sd.Format = fmt; sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        sd.Texture2D.MipLevels = 1;
+        D3D12_CPU_DESCRIPTOR_HANDLE h = srv; h.ptr += (SIZE_T)i * W.srv_step;
+        dev->lpVtbl->CreateShaderResourceView(dev, bufs[i], &sd, h);
+    }
+    for (int f = 0; f < LD_WSI_FRAMES; f++) {
+        if (FAILED(dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                       &IID_ID3D12CommandAllocator, (void**)&W.falloc[f])) ||
+            FAILED(dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, W.falloc[f], NULL,
+                       &IID_ID3D12GraphicsCommandList, (void**)&W.flist[f])))
+            return 0;
+        W.flist[f]->lpVtbl->Close(W.flist[f]);
+    }
+    W.alloc = W.falloc[0]; W.list = W.flist[0];
+    if (FAILED(dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&W.fence)))
+        return 0;
+    W.fence_event = ld_vkd3d_create_event();
+    if (!make_swapchain() || !acquire_next()) return 0;
+    W.attached = 1;
+    fprintf(stderr, "[vkd3d-wsi] on-screen presentation up (F11 fullscreen, close = Quit Game; %s)\n",
+            W.sync_present ? "CPU waits for each blit (PS3_VKD3D_PRESENT_WAIT)" : "present behind a semaphore, no per-frame wait");
+    return 1;
+}
+
+static void barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    D3D12_RESOURCE_BARRIER b;
+    memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = from; b.Transition.StateAfter = to;
+    W.list->lpVtbl->ResourceBarrier(W.list, 1, &b);
+}
+
+/* Draw offscreen back buffer `index` into the acquired swapchain image and present it. */
+void ld_wsi_present(UINT index)
+{
+    if (!W.attached || W.hidden || index >= W.src_count) return;
+    if (W.need_recreate) { wait_gpu(); if (!make_swapchain() || !acquire_next()) return; }
+    ID3D12Resource* dst = W.img[W.img_index];
+    const unsigned slot = (unsigned)(W.frame % LD_WSI_FRAMES);
+    wait_value(W.fdone[slot]);          /* that slot's previous blit (normally long done) */
+    W.alloc = W.falloc[slot]; W.list = W.flist[slot];
+    W.alloc->lpVtbl->Reset(W.alloc);
+    W.list->lpVtbl->Reset(W.list, W.alloc, W.pso);
+    barrier(W.src[index], D3D12_RESOURCE_STATE_PRESENT, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    barrier(dst, D3D12_RESOURCE_STATE_PRESENT, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    W.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(W.rtv_heap, &rtv);
+    rtv.ptr += (SIZE_T)W.img_index * W.rtv_step;
+    static const float black[4] = { 0, 0, 0, 1 };
+    W.list->lpVtbl->ClearRenderTargetView(W.list, rtv, black, 0, NULL);
+    W.list->lpVtbl->OMSetRenderTargets(W.list, 1, &rtv, FALSE, NULL);
+    /* aspect-fit (black bars) unless PS3_FULLSCREEN_ASPECT is set empty/0 */
+    float vw = (float)W.extent.width, vh = (float)W.extent.height, vx = 0, vy = 0;
+    if (W.keep_aspect && W.src_w && W.src_h) {
+        const float sa = (float)W.src_w / (float)W.src_h, da = vw / vh;
+        if (da > sa) { float nw = vh * sa; vx = (vw - nw) * 0.5f; vw = nw; }
+        else         { float nh = vw / sa; vy = (vh - nh) * 0.5f; vh = nh; }
+    }
+    D3D12_VIEWPORT vp = { vx, vy, vw, vh, 0.0f, 1.0f };
+    D3D12_RECT sc = { 0, 0, (LONG)W.extent.width, (LONG)W.extent.height };
+    W.list->lpVtbl->RSSetViewports(W.list, 1, &vp);
+    W.list->lpVtbl->RSSetScissorRects(W.list, 1, &sc);
+    W.list->lpVtbl->SetGraphicsRootSignature(W.list, W.rs);
+    ID3D12DescriptorHeap* heaps[] = { W.srv_heap };
+    W.list->lpVtbl->SetDescriptorHeaps(W.list, 1, heaps);
+    D3D12_GPU_DESCRIPTOR_HANDLE g;
+    W.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(W.srv_heap, &g);
+    g.ptr += (UINT64)index * W.srv_step;
+    W.list->lpVtbl->SetGraphicsRootDescriptorTable(W.list, 0, g);
+    W.list->lpVtbl->IASetPrimitiveTopology(W.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    W.list->lpVtbl->DrawInstanced(W.list, 3, 1, 0, 0);
+    barrier(dst, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PRESENT);
+    barrier(W.src[index], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_PRESENT);
+    W.list->lpVtbl->Close(W.list);
+    ID3D12CommandList* lists[] = { (ID3D12CommandList*)W.list };
+    W.queue->lpVtbl->ExecuteCommandLists(W.queue, 1, lists);
+    W.fence_val++;
+    W.queue->lpVtbl->Signal(W.queue, W.fence, W.fence_val);
+    W.fdone[slot] = W.fence_val;
+    W.frame++;
+    if (W.sync_present) wait_value(W.fence_val);   /* old path: the blit is done before the present */
+
+    VkPresentInfoKHR pi;
+    memset(&pi, 0, sizeof pi);
+    pi.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR;
+    pi.swapchainCount = 1; pi.pSwapchains = &W.swap; pi.pImageIndices = &W.img_index;
+    VkQueue q = W.acquire_queue(W.queue);
+    if (!W.sync_present) {
+        /* GPU-side handoff: signalled once everything submitted before it (the blit) completed */
+        VkSubmitInfo si;
+        memset(&si, 0, sizeof si);
+        si.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+        si.signalSemaphoreCount = 1; si.pSignalSemaphores = &W.present_sem[W.img_index];
+        if (W.queue_submit(q, 1, &si, VK_NULL_HANDLE) == VK_SUCCESS) {
+            pi.waitSemaphoreCount = 1; pi.pWaitSemaphores = &W.present_sem[W.img_index];
+        } else {
+            W.release_queue(W.queue);
+            fprintf(stderr, "[vkd3d-wsi] semaphore submit failed: CPU waits for each blit from now on\n");
+            W.sync_present = 1;
+            wait_value(W.fence_val);
+            q = W.acquire_queue(W.queue);
+        }
+    }
+    VkResult r = W.queue_present(q, &pi);
+    W.release_queue(W.queue);
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR) W.need_recreate = 1;
+    if (W.need_recreate) wait_gpu();
+    acquire_next();
+}
+
+/* boot_main's frame loop (via rsx_null_backend_pump_messages): 1 once, when the window closes. */
+int rsx_live_draw_vkd3d_pump(void)
+{
+    if (!W.win) return 0;
+    SDL_Event ev;
+    while (SDL_PollEvent(&ev)) {
+        if (ev.type == SDL_QUIT ||
+            (ev.type == SDL_WINDOWEVENT && ev.window.event == SDL_WINDOWEVENT_CLOSE)) {
+            if (!W.hidden) { SDL_HideWindow(W.win); W.hidden = 1; }
+        } else if (ev.type == SDL_KEYDOWN && ev.key.keysym.sym == SDLK_F11 && !ev.key.repeat) {
+            W.fullscreen = !W.fullscreen;
+            SDL_SetWindowFullscreen(W.win, W.fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+            W.need_recreate = 1;
+        } else if (ev.type == SDL_WINDOWEVENT && ev.window.event == SDL_WINDOWEVENT_SIZE_CHANGED) {
+            W.need_recreate = 1;
+        }
+    }
+    if (W.hidden && !W.quit_reported) { W.quit_reported = 1; return 1; }
+    return 0;
+}
+int rsx_live_draw_vkd3d_window_hidden(void) { return W.hidden; }
+
+/* ppu_mod_loader.cpp (plugins: display info, PS3MOD_EV_RESIZE): the window's size. 1 = there is one. */
+int rsx_live_draw_vkd3d_window_size(uint32_t* w, uint32_t* h)
+{
+    if (!W.win || W.hidden) return 0;
+    int ww = 0, wh = 0;
+    SDL_GetWindowSize(W.win, &ww, &wh);
+    if (ww <= 0 || wh <= 0) return 0;
+    *w = (uint32_t)ww; *h = (uint32_t)wh;
+    return 1;
+}
