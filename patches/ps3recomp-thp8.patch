+    if (dimension != 2 || cubemap || (raw_fmt & 0x40))   /* 0x40 UN */
+        return 0;
+    if (!width || !height || width > 4096 || height > 4096)
+        return 0;
+    uint32_t block = 0, bpp = 0;
+    switch (raw_fmt & 0x9F) {
+    case 0x86: block = 8;  break;              /* DXT1 */
+    case 0x87: case 0x88: block = 16; break;   /* DXT3, DXT5 */
+    case 0x81: bpp = 1; break;                 /* B8 */
+    case 0x82: case 0x83: case 0x84: case 0x8B: bpp = 2; break; /* A1R5G5B5 A4R4G4B4 R5G6B5 G8B8 */
+    case 0x85: bpp = 4; break;                 /* A8R8G8B8 */
+    default: return 0;
+    }
+    /* LN (0x20, pitch-linear): keyed for block-compressed formats only, with one
+     * level and the natural row pitch (pitch 0 or one row of blocks). Such a
+     * texture is laid out exactly like a non-LN one -- the live-draw decoder
+     * ignores LN/pitch for DXT -- so its chain is the same bytes. THP8's font
+     * atlases (text_a1, buttonsps3) are LN DXT5 (format byte 0xA8), as are all
+     * 97 of its LN DXT textures (NPOT, 1 mip). The seed carries the format byte,
+     * so an LN key never collides with a non-LN one. LN uncompressed data
+     * (a real pitch, row padding) stays unkeyed. */
+    if (raw_fmt & 0x20) {
+        if (!block || mips > 1) return 0;
+        const uint32_t natural = ((width + 3) / 4) * block;
+        if (pitch && pitch != natural) return 0;
+    }
+    /* Swizzled uncompressed data is power-of-two only (the decoder skips the rest). */
+    if (bpp && ((width & (width - 1)) || (height & (height - 1))))
+        return 0;
+    const uint32_t n = mips ? mips : 1;
+    if (n > 16) return 0;
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        const uint32_t lw = (width >> i) ? (width >> i) : 1;
+        const uint32_t lh = (height >> i) ? (height >> i) : 1;
+        if (block) {
+            const uint32_t bw = (lw + 3) / 4 ? (lw + 3) / 4 : 1;
+            const uint32_t bh = (lh + 3) / 4 ? (lh + 3) / 4 : 1;
+            total += (uint64_t)bw * bh * block;
+        } else {
+            total += (uint64_t)lw * lh * bpp;
+        }
+    }
+    return total > 0x7FFFFFFFull ? 0 : (uint32_t)total;
+}
+
+static uint64_t tr_key(const texrepl_guest* gt, const void* chain, uint32_t len)
+{
+    const uint64_t seed = ((uint64_t)(gt->raw_fmt & 0xFF) << 56) |
+                          ((uint64_t)(gt->mips & 0xFF) << 48) |
+                          ((uint64_t)(gt->width & 0xFFFF) << 32) |
+                          ((uint64_t)(gt->height & 0xFFFF) << 16);
+    return XXH3_64bits_withSeed(chain, len, seed);
+}
+
+static uint32_t tr_mix(uint64_t k)
+{
+    k ^= k >> 33; k *= 0xff51afd7ed558ccdull; k ^= k >> 33;
+    return (uint32_t)k;
+}
+
+static int tr_ht_find(uint64_t key)
+{
+    if (!s_ht) return -1;
+    for (uint32_t i = tr_mix(key) & s_ht_mask;; i = (i + 1) & s_ht_mask) {
+        const int32_t r = s_ht[i];
+        if (r < 0) return -1;
+        if (s_rec[r].key == key) return r;
+    }
+}
+
+/* ------------------------------------------------------------------------- */
+/* index scan                                                                 */
+static int hexval(wchar_t c)
+{
+    if (c >= L'0' && c <= L'9') return c - L'0';
+    if (c >= L'a' && c <= L'f') return c - L'a' + 10;
+    if (c >= L'A' && c <= L'F') return c - L'A' + 10;
+    return -1;
+}
+
+static int s_rescanning;   /* tr_add during a live rescan (render thread / texrepl off) */
+
+static void tr_add(uint64_t key, const wchar_t* path, int src, uint64_t fsize, uint64_t fmtime)
+{
+    /* duplicates: later source (higher src index) wins; scan order is priority order */
+    if (s_ht) {
+        const int r = tr_ht_find(key);
+        if (r >= 0) {
+            tr_rec* x = &s_rec[r];
+            if (s_rescanning) {
+                /* first sighting in this scan = the indexed record; later ones override it */
+                if (x->seen) {
+                    s_dups++;
+                    s_src_count[x->npack]--;
+                }
+                x->seen = 1;
+                free(x->npath);
+                x->npath = _wcsdup(path);
+                x->npack = src;
+                x->nsize = fsize; x->nmtime = fmtime;
+                s_src_count[src]++;
+                return;
+            }
+            s_dups++;
+            if (s_verbose)
+                fprintf(stderr, "[texrepl] %016llx: '%s' overrides '%s'\n",
+                        (unsigned long long)key, s_src[src], s_src[s_rec[r].pack]);
+            free(s_rec[r].path);
+            s_rec[r].path = _wcsdup(path);
+            s_src_count[s_rec[r].pack]--;
+            s_rec[r].pack = src;
+            s_rec[r].fsize = fsize; s_rec[r].fmtime = fmtime;
+            s_src_count[src]++;
+            return;
+        }
+    }
+    if (s_nrec == s_caprec) {
+        const uint32_t nc = s_caprec ? s_caprec * 2 : 1024;
+        tr_rec* nr = (tr_rec*)realloc(s_rec, (size_t)nc * sizeof *nr);
+        if (!nr) return;
+        s_rec = nr; s_caprec = nc;
+    }
+    /* grow the hash table at 50% load */
+    if ((s_nrec + 1) * 2 > (s_ht ? s_ht_mask + 1 : 0)) {
+        const uint32_t nsz = s_ht ? (s_ht_mask + 1) * 2 : 4096;
+        int32_t* nh = (int32_t*)malloc((size_t)nsz * sizeof *nh);
+        if (!nh) return;
+        memset(nh, 0xFF, (size_t)nsz * sizeof *nh);
+        for (uint32_t r = 0; r < s_nrec; r++) {
+            if (s_rec[r].is_alt) continue;   /* redirect targets are not keyed */
+            uint32_t i = tr_mix(s_rec[r].key) & (nsz - 1);
+            while (nh[i] >= 0) i = (i + 1) & (nsz - 1);
+            nh[i] = (int32_t)r;
+        }
+        free(s_ht); s_ht = nh; s_ht_mask = nsz - 1;
+    }
+    tr_rec* e = &s_rec[s_nrec];
+    memset(e, 0, sizeof *e);
+    e->key = key;
+    e->path = _wcsdup(path);
+    e->pack = src;
+    e->fsize = fsize; e->fmtime = fmtime;
+    e->seen = e->isnew = (uint8_t)(s_rescanning != 0);
+    uint32_t i = tr_mix(key) & s_ht_mask;
+    while (s_ht[i] >= 0) i = (i + 1) & s_ht_mask;
+    s_ht[i] = (int32_t)s_nrec++;
+    s_src_count[src]++;
+}
+
+static void tr_scan(const wchar_t* dir, int src, int depth)
+{
+    if (depth > 8) return;
+    wchar_t pat[MAX_PATH * 2];
+    if (_snwprintf(pat, MAX_PATH * 2, L"%ls\\*", dir) < 0) return;
+    WIN32_FIND_DATAW fd;
+    HANDLE h = FindFirstFileW(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE) return;
+    do {
+        const wchar_t* n = fd.cFileName;
+        if (n[0] == L'.' && (!n[1] || (n[1] == L'.' && !n[2]))) continue;
+        wchar_t full[MAX_PATH * 2];
+        if (_snwprintf(full, MAX_PATH * 2, L"%ls\\%ls", dir, n) < 0) continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+            tr_scan(full, src, depth + 1);
+            continue;
+        }
+        const size_t len = wcslen(n);
+        if (len != 20 || _wcsicmp(n + 16, L".dds") != 0) continue;
+        uint64_t key = 0;
+        int ok = 1;
+        for (int i = 0; i < 16 && ok; i++) {
+            const int v = hexval(n[i]);
+            if (v < 0) ok = 0; else key = (key << 4) | (uint64_t)v;
+        }
+        if (ok) tr_add(key, full, src, ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow,
+                       ((uint64_t)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime);
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+}
+
+static int is_dir_w(const wchar_t* p)
+{
+    const DWORD a = GetFileAttributesW(p);
+    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+/* Pack order = the VFS overlay's (vfs_mods.c cmp_name: ASCII upper-case compare), so a texture pack and
+ * a data pack of the same names stack the same way ('_' sorts after letters there; _wcsicmp folds to
+ * lower case and would put it before them). */
+static int cmp_wname(const void* a, const void* b)
+{
+    const wchar_t* x = *(const wchar_t* const*)a;
+    const wchar_t* y = *(const wchar_t* const*)b;
+    for (;; x++, y++) {
+        const wchar_t cx = (*x >= L'a' && *x <= L'z') ? (wchar_t)(*x - 32) : *x;
+        const wchar_t cy = (*y >= L'a' && *y <= L'z') ? (wchar_t)(*y - 32) : *y;
+        if (cx != cy || !cx) return (int)cx - (int)cy;
+    }
+}
+
+/* PS3_TEXREPL_EXTRA_PACKS=<dir>[;<dir>...]: pack folders named explicitly, scanned
+ * in the order given after the named packs (so they win over them) and before the
+ * loose folder. A relative dir is taken under the mods root. The '.'/'_' rule of
+ * the normal scan does not apply here: naming a pack is what switches it on, so a
+ * pack shipped disabled as <mods>\_name stays off unless something names it.
+ * Read with GetEnvironmentVariableW, i.e. the process environment block: a ps3mod
+ * plugin sets it with SetEnvironmentVariable during ps3mod_init (before the device
+ * and texrepl_init exist), which one CRT's getenv() copy would not see. */
+static void tr_scan_extra(const wchar_t* root)
+{
+    wchar_t list[4096];
+    const DWORD n = GetEnvironmentVariableW(L"PS3_TEXREPL_EXTRA_PACKS", list,
+                                            (DWORD)(sizeof list / sizeof list[0]));
+    if (!n) return;
+    if (n >= sizeof list / sizeof list[0]) {
+        fprintf(stderr, "[texrepl] PS3_TEXREPL_EXTRA_PACKS is too long: ignored\n");
+        return;
+    }
+    for (wchar_t *tok = list, *next; tok; tok = next) {
+        next = wcschr(tok, L';');
+        if (next) *next++ = 0;
+        while (*tok == L' ' || *tok == L'\t') tok++;
+        size_t len = wcslen(tok);
+        while (len && (tok[len - 1] == L' ' || tok[len - 1] == L'\t' ||
+                       tok[len - 1] == L'\\' || tok[len - 1] == L'/'))
+            tok[--len] = 0;
+        if (!len) continue;
+        for (wchar_t* p = tok; *p; p++) if (*p == L'/') *p = L'\\';
+        const int abs = tok[0] == L'\\' || (len > 1 && tok[1] == L':');
+        wchar_t dir[MAX_PATH * 2], td[MAX_PATH * 2];
+        const int w = abs ? _snwprintf(dir, MAX_PATH * 2, L"%ls", tok)
+                          : _snwprintf(dir, MAX_PATH * 2, L"%ls\\%ls", root, tok);
+        if (w < 0) continue;
+        if (_snwprintf(td, MAX_PATH * 2, L"%ls\\textures", dir) < 0) continue;
+        char name[96];
+        const wchar_t* base = wcsrchr(dir, L'\\');
+        WideCharToMultiByte(CP_UTF8, 0, base ? base + 1 : dir, -1, name, sizeof name, NULL, NULL);
+        name[sizeof name - 1] = 0;
+        if (!is_dir_w(td)) {
+            fprintf(stderr, "[texrepl] PS3_TEXREPL_EXTRA_PACKS: '%s' has no textures folder: skipped\n",
+                    name);
+            continue;
+        }
+        if (s_nsrc >= 63) {
+            fprintf(stderr, "[texrepl] PS3_TEXREPL_EXTRA_PACKS: too many packs, '%s' skipped\n", name);
+            continue;
+        }
+        snprintf(s_src[s_nsrc], sizeof s_src[0], "%s (extra)", name);
+        tr_scan(td, s_nsrc++, 0);
+    }
+}
+
+static void tr_scan_root(const wchar_t* root)
+{
+    /* packs in name order, then loose: a later scan overrides an earlier one */
+    wchar_t* packs[62];
+    int npacks = 0;
+    wchar_t pat[MAX_PATH * 2];
+    _snwprintf(pat, MAX_PATH * 2, L"%ls\\*", root);
+    WIN32_FIND_DATAW fd;
+    HANDLE h = FindFirstFileW(pat, &fd);
+    if (h != INVALID_HANDLE_VALUE) {
+        do {
+            const wchar_t* n = fd.cFileName;
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) continue;
+            if (n[0] == L'.' || n[0] == L'_') continue;   /* ".", "..", disabled packs */
+            if (_wcsicmp(n, L"textures") == 0 || _wcsicmp(n, L"PS3_GAME") == 0) continue;
+            if (npacks < 62) packs[npacks++] = _wcsdup(n);
+        } while (FindNextFileW(h, &fd));
+        FindClose(h);
+    }
+    qsort(packs, (size_t)npacks, sizeof packs[0], cmp_wname);
+    for (int i = 0; i < npacks; i++) {
+        wchar_t td[MAX_PATH * 2];
+        _snwprintf(td, MAX_PATH * 2, L"%ls\\%ls\\textures", root, packs[i]);
+        if (is_dir_w(td) && s_nsrc < 63) {
+            WideCharToMultiByte(CP_UTF8, 0, packs[i], -1, s_src[s_nsrc], sizeof s_src[0], NULL, NULL);
+            tr_scan(td, s_nsrc++, 0);
+        }
+        free(packs[i]);
+    }
+    tr_scan_extra(root);
+    wchar_t td[MAX_PATH * 2];
+    _snwprintf(td, MAX_PATH * 2, L"%ls\\textures", root);
+    if (is_dir_w(td)) {
+        snprintf(s_src[s_nsrc], sizeof s_src[0], "(loose)");
+        tr_scan(td, s_nsrc++, 0);
+    }
+}
+
+/* ------------------------------------------------------------------------- */
+/* DDS                                                                        */
+typedef struct {
+    DXGI_FORMAT fmt;
+    uint32_t w, h, mips, block;   /* block bytes for BC, 0 for 4-byte texels */
+    const uint8_t* data;
+    size_t size;
+} dds_info;
+
+static uint32_t rd32(const uint8_t* p) { uint32_t v; memcpy(&v, p, 4); return v; }
+#define FOURCC(a, b, c, d) ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | ((uint32_t)(d) << 24))
+
+static uint64_t dds_level_size(const dds_info* d, uint32_t i, uint32_t* row_bytes, uint32_t* rows)
+{
+    const uint32_t lw = (d->w >> i) ? (d->w >> i) : 1;
+    const uint32_t lh = (d->h >> i) ? (d->h >> i) : 1;
+    if (d->block) {
+        const uint32_t bw = (lw + 3) / 4, bh = (lh + 3) / 4;
+        *row_bytes = bw * d->block; *rows = bh;
+    } else {
+        *row_bytes = lw * 4; *rows = lh;
+    }
+    return (uint64_t)*row_bytes * *rows;
+}
+
+static const char* dds_parse(const uint8_t* b, size_t n, dds_info* o)
+{
+    if (n < 128 || rd32(b) != FOURCC('D', 'D', 'S', ' ') || rd32(b + 4) != 124)
+        return "not a DDS file";
+    const uint8_t* hd = b + 4;
+    const uint32_t height = rd32(hd + 8), width = rd32(hd + 12);
+    const uint32_t mipc = rd32(hd + 24);
+    const uint32_t pf_flags = rd32(hd + 76), fourcc = rd32(hd + 80), bits = rd32(hd + 84);
+    const uint32_t rm = rd32(hd + 88), gm = rd32(hd + 92), bm = rd32(hd + 96), am = rd32(hd + 100);
+    const uint32_t caps2 = rd32(hd + 108);
+    size_t off = 128;
+    memset(o, 0, sizeof *o);
+    if (caps2 & (0x200u | 0x200000u)) return "cube map / volume DDS";
+    if ((pf_flags & 0x4u) && fourcc == FOURCC('D', 'X', '1', '0')) {
+        if (n < 148) return "truncated DX10 header";
+        const uint32_t dxgi = rd32(b + 128), dim = rd32(b + 132), misc = rd32(b + 136), arr = rd32(b + 140);
+        if (dim != 3 /* TEXTURE2D */ || (misc & 0x4u) || arr > 1) return "not a single 2D texture";
+        off = 148;
+        switch (dxgi) {
+        case 71: case 72: o->fmt = DXGI_FORMAT_BC1_UNORM; o->block = 8; break;
+        case 74: case 75: o->fmt = DXGI_FORMAT_BC2_UNORM; o->block = 16; break;
+        case 77: case 78: o->fmt = DXGI_FORMAT_BC3_UNORM; o->block = 16; break;
+        case 98: case 99: o->fmt = DXGI_FORMAT_BC7_UNORM; o->block = 16; break;
+        case 28: case 29: o->fmt = DXGI_FORMAT_R8G8B8A8_UNORM; break;
+        case 87: case 91: o->fmt = DXGI_FORMAT_B8G8R8A8_UNORM; break;
+        default: return "unsupported DXGI format";
+        }
+    } else if (pf_flags & 0x4u) {
+        switch (fourcc) {
+        case FOURCC('D', 'X', 'T', '1'): o->fmt = DXGI_FORMAT_BC1_UNORM; o->block = 8; break;
+        case FOURCC('D', 'X', 'T', '2'):
+        case FOURCC('D', 'X', 'T', '3'): o->fmt = DXGI_FORMAT_BC2_UNORM; o->block = 16; break;
+        case FOURCC('D', 'X', 'T', '4'):
+        case FOURCC('D', 'X', 'T', '5'): o->fmt = DXGI_FORMAT_BC3_UNORM; o->block = 16; break;
+        default: return "unsupported FourCC";
+        }
+    } else if ((pf_flags & 0x40u) && bits == 32) {
+        if (rm == 0x00FF0000u && gm == 0x0000FF00u && bm == 0x000000FFu)
+            o->fmt = (am == 0xFF000000u) ? DXGI_FORMAT_B8G8R8A8_UNORM : DXGI_FORMAT_B8G8R8X8_UNORM;
+        else if (rm == 0x000000FFu && gm == 0x0000FF00u && bm == 0x00FF0000u)
+            o->fmt = DXGI_FORMAT_R8G8B8A8_UNORM;   /* no-alpha variant: alpha bytes as stored */
+        else return "unsupported RGB masks";
+    } else {
+        return "unsupported pixel format";
+    }
+    if (!width || !height || width > 16384 || height > 16384) return "bad dimensions";
+    o->w = width; o->h = height;
+    uint32_t full = 1 + ilog2u(width > height ? width : height);
+    uint32_t want = mipc ? mipc : 1;
+    if (want > full) want = full;
+    if (want > TR_MAX_MIPS) want = TR_MAX_MIPS;
+    o->data = b + off;
+    o->size = n - off;
+    /* keep the levels the file actually holds */
+    uint64_t acc = 0;
+    uint32_t have = 0;
+    for (uint32_t i = 0; i < want; i++) {
+        uint32_t rb, rows;
+        const uint64_t sz = dds_level_size(o, i, &rb, &rows);
+        if (acc + sz > o->size) break;
+        acc += sz; have++;
+    }
+    if (!have) return "truncated pixel data";
+    o->mips = have;
+    return NULL;
+}
+
+/* ------------------------------------------------------------------------- */
+/* loader                                                                     */
+#if defined(RSX_TEXREPL_POSIX)
+/* POSIX: one fread of the whole file. Browser: a /mods file streams through the IO worker (web_vfs: an
+ * in-memory LRU, never browser storage); this runs on a loader thread, never on the translation thread. */
+static uint8_t* read_file_w(const wchar_t* path, size_t* size_out)
+{
+    char p[MAX_PATH * 2];
+    if (!tr_wpath(path, p, sizeof p)) return NULL;
+    tr_ci_fix(p);
+    FILE* f = fopen(p, "rb");
+    if (!f) return NULL;
+    struct stat st;
+    if (fstat(fileno(f), &st) != 0 || st.st_size <= 0 || st.st_size > (1ll << 31)) { fclose(f); return NULL; }
+    uint8_t* buf = (uint8_t*)malloc((size_t)st.st_size);
+    size_t got = buf ? fread(buf, 1, (size_t)st.st_size, f) : 0;
+    fclose(f);
+    if (buf && got != (size_t)st.st_size) { free(buf); buf = NULL; }
+    if (buf) *size_out = got;
+    return buf;
+}
+#else
+static uint8_t* read_file_w(const wchar_t* path, size_t* size_out)
+{
+    HANDLE f = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                           FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (f == INVALID_HANDLE_VALUE) return NULL;
+    LARGE_INTEGER sz;
+    if (!GetFileSizeEx(f, &sz) || sz.QuadPart <= 0 || sz.QuadPart > (1ll << 31)) {
+        CloseHandle(f); return NULL;
+    }
+    uint8_t* buf = (uint8_t*)malloc((size_t)sz.QuadPart);
+    size_t got = 0;
+    while (buf && got < (size_t)sz.QuadPart) {
+        DWORD n = 0;
+        const DWORD want = (DWORD)(((size_t)sz.QuadPart - got) > (1u << 30) ? (1u << 30)
+                                                                           : ((size_t)sz.QuadPart - got));
+        if (!ReadFile(f, buf + got, want, &n, NULL) || !n) { free(buf); buf = NULL; break; }
+        got += n;
+    }
+    CloseHandle(f);
+    if (buf) *size_out = got;
+    return buf;
+}
+#endif
+
+static void tr_fail(tr_rec* r, const char* why)
+{
+    char p[MAX_PATH * 2];
+    WideCharToMultiByte(CP_UTF8, 0, r->path, -1, p, sizeof p, NULL, NULL);
+    fprintf(stderr, "[texrepl] %016llx: %s -- %s (guest %ux%u fmt 0x%02X mips %u): using the original\n",
+            (unsigned long long)r->key, why, p, r->gw, r->gh, r->gfmt, r->gmips);
+    InterlockedIncrement64(&s_loads_failed);
+    InterlockedExchange(&r->state, TR_FAILED);
+}
+
+#if defined(PS3_WASM)
+/* The WebGPU device's maxTextureDimension2D: the page passes the limit it requested (PS3_WASM_MAX_TEX2D, from
+ * the adapter); unset = 8192, the WebGPU default a device has unless it asks for more. */
+static uint32_t tr_max_tex2d(void)
+{
+    static volatile uint32_t lim;
+    if (!lim) {
+        const char* e = getenv("PS3_WASM_MAX_TEX2D");
+        const unsigned long v = (e && *e) ? strtoul(e, NULL, 10) : 0;
+        const uint32_t l = (v >= 2048 && v <= 16384) ? (uint32_t)v : 8192u;
+        if (!__atomic_exchange_n(&lim, l, __ATOMIC_RELAXED))
+            fprintf(stderr, "[texrepl] WebGPU max 2D texture size %u (%s)\n", l, (e && *e) ? "page" : "default");
+    }
+    return lim;
+}
+#endif
+
+static void tr_load(tr_rec* r)
+{
+    LARGE_INTEGER t0, t1, fq;
+    QueryPerformanceCounter(&t0);
+    size_t n = 0;
+    uint8_t* buf = read_file_w(r->path, &n);
+    if (!buf) { tr_fail(r, "cannot read"); return; }
+    dds_info d;
+    const char* err = dds_parse(buf, n, &d);
+    if (err) { free(buf); tr_fail(r, err); return; }
+    const uint32_t k = d.w / r->gw;
+    if (!k || k > 16 || d.w != k * r->gw || d.h != k * r->gh) {
+        char m[128];
+        snprintf(m, sizeof m, "size %ux%u is not an integer multiple k*W x k*H of the guest's", d.w, d.h);
+        free(buf); tr_fail(r, m); return;
+    }
+    if (d.block && ((d.w & 3) || (d.h & 3))) { free(buf); tr_fail(r, "BC size not a multiple of 4"); return; }
+#if defined(PS3_WASM)
+    {   /* WebGPU: a texture past the device's maxTextureDimension2D fails validation and so does every draw
+         * sampling it -- keep the original instead */
+        const uint32_t lim = tr_max_tex2d();
+        if (d.w > lim || d.h > lim) {
+            char m[128];
+            snprintf(m, sizeof m, "size %ux%u exceeds the WebGPU device's max 2D size %u", d.w, d.h, lim);
+            free(buf); tr_fail(r, m); return;
+        }
+    }
+#endif
+
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = d.w; rd.Height = d.h; rd.DepthOrArraySize = 1;
+    rd.MipLevels = (UINT16)d.mips; rd.Format = d.fmt; rd.SampleDesc.Count = 1;
+    ID3D12Resource* tex = NULL;
+    if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                                                     D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                                                     &IID_ID3D12Resource, (void**)&tex))) {
+        free(buf); tr_fail(r, "CreateCommittedResource failed"); return;
+    }
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp =
+        (D3D12_PLACED_SUBRESOURCE_FOOTPRINT*)calloc(d.mips, sizeof *fp);
+    UINT rows[TR_MAX_MIPS]; UINT64 rowsz[TR_MAX_MIPS]; UINT64 total = 0;
+    s_dev->lpVtbl->GetCopyableFootprints(s_dev, &rd, 0, d.mips, 0, fp, rows, rowsz, &total);
+    D3D12_HEAP_PROPERTIES up = {0};
+    up.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = total; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* upload = NULL;
+    uint8_t* map = NULL;
+    D3D12_RANGE none = {0, 0};
+    if (!fp || FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &up, D3D12_HEAP_FLAG_NONE, &bd,
+                                                            D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                                                            &IID_ID3D12Resource, (void**)&upload)) ||
+        FAILED(upload->lpVtbl->Map(upload, 0, &none, (void**)&map))) {
+        if (upload) upload->lpVtbl->Release(upload);
+        tex->lpVtbl->Release(tex); free(fp); free(buf);
+        tr_fail(r, "upload buffer failed"); return;
+    }
+    const uint8_t* src = d.data;
+    for (uint32_t i = 0; i < d.mips; i++) {
+        uint32_t rb, nr;
+        const uint64_t sz = dds_level_size(&d, i, &rb, &nr);
+        const uint32_t copy = rb < rowsz[i] ? rb : (uint32_t)rowsz[i];
+        for (uint32_t y = 0; y < nr && y < rows[i]; y++)
+            memcpy(map + fp[i].Offset + (size_t)y * fp[i].Footprint.RowPitch,
+                   src + (size_t)y * rb, copy);
+        src += sz;
+    }
+    upload->lpVtbl->Unmap(upload, 0, NULL);
+    free(buf);
+
+    D3D12_RESOURCE_ALLOCATION_INFO ai = {0};
+    s_dev->lpVtbl->GetResourceAllocationInfo(s_dev, &ai, 0, 1, &rd);
+    r->tex = tex;
+    r->upload = upload;
+    r->fp = fp;
+    r->fmt = d.fmt;
+    r->w = d.w; r->h = d.h; r->n_mips = d.mips;
+    r->shift_fx = (uint32_t)(log2((double)k) * 256.0 + 0.5);
+    r->bytes = ai.SizeInBytes ? ai.SizeInBytes : total;
+    r->upload_bytes = total;
+    QueryPerformanceCounter(&t1);
+    QueryPerformanceFrequency(&fq);
+    InterlockedAdd64(&s_io_bytes, (LONG64)n);
+    InterlockedAdd64(&s_io_us, (LONG64)((t1.QuadPart - t0.QuadPart) * 1000000 / fq.QuadPart));
+    InterlockedAdd64(&s_inflight, (LONG64)total);
+    InterlockedIncrement64(&s_loads_done);
+    if (s_verbose)
+        fprintf(stderr, "[texrepl] loaded %016llx %ux%u mips %u fmt %d k=%u (%llu KB VRAM)\n",
+                (unsigned long long)r->key, d.w, d.h, d.mips, (int)d.fmt, k,
+                (unsigned long long)(r->bytes >> 10));
+    InterlockedExchange(&r->state, TR_LOADED);   /* publishes the fields above */
+}
+
+/* Loader thread entry: WINAPI on Windows (and in the browser build, as before). Native Linux: CreateThread is the
+ * SysV shim (win32_compat.h) while vkd3d_windows.h makes WINAPI ms_abi -- the same as LD_THREAD_CC in rsx_live_draw.c. */
+#if defined(RSX_TEXREPL_POSIX) && !defined(PS3_WASM)
+#define TR_THREAD_CC
+#else
+#define TR_THREAD_CC WINAPI
+#endif
+static DWORD TR_THREAD_CC tr_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        EnterCriticalSection(&s_qlock);
+        while (!s_qcount && !s_stop)
+            SleepConditionVariableCS(&s_qcv, &s_qlock, INFINITE);
+        if (s_stop) { LeaveCriticalSection(&s_qlock); break; }
+        const int32_t id = s_queue[s_qhead];
+        s_qhead = (s_qhead + 1) % s_caprec;
+        s_qcount--;
+        LeaveCriticalSection(&s_qlock);
+        /* the render thread copies at most TR_FINALIZE_CAP per frame: wait
+         * while too much is loaded but not copied yet */
+        while (s_inflight > (LONG64)TR_INFLIGHT_CAP && !s_stop) Sleep(2);
+        if (s_stop) break;
+        tr_load(&s_rec[id]);
+    }
+    return 0;
+}
+
+static void tr_enqueue(int32_t id)
+{
+    EnterCriticalSection(&s_qlock);
+    s_queue[(s_qhead + s_qcount) % s_caprec] = id;
+    s_qcount++;
+    LeaveCriticalSection(&s_qlock);
+    WakeConditionVariable(&s_qcv);
+}
+
+/* ------------------------------------------------------------------------- */
+/* key dump                                                                   */
+static int tr_seen_insert(uint64_t key)
+{
+    if ((s_seen_n + 1) * 2 > s_seen_mask + 1) {
+        const uint32_t nsz = (s_seen_mask + 1) * 2;
+        uint64_t* ns = (uint64_t*)calloc(nsz, sizeof *ns);
+        if (!ns) return 0;
+        for (uint32_t i = 0; i <= s_seen_mask; i++) {
+            if (!s_seen[i]) continue;
+            uint32_t j = tr_mix(s_seen[i]) & (nsz - 1);
+            while (ns[j]) j = (j + 1) & (nsz - 1);
+            ns[j] = s_seen[i];
+        }
+        free(s_seen); s_seen = ns; s_seen_mask = nsz - 1;
+    }
+    const uint64_t k = key ? key : 1;   /* 0 marks an empty slot */
+    uint32_t i = tr_mix(k) & s_seen_mask;
+    for (; s_seen[i]; i = (i + 1) & s_seen_mask)
+        if (s_seen[i] == k) return 0;
+    s_seen[i] = k;
+    s_seen_n++;
+    return 1;
+}
+
+static uint32_t morton2(uint32_t x, uint32_t y, uint32_t lw, uint32_t lh)
+{
+    uint32_t idx = 0, shift = 0;
+    while (lw || lh) {
+        if (lw) { idx |= (x & 1) << shift; x >>= 1; shift++; lw--; }
+        if (lh) { idx |= (y & 1) << shift; y >>= 1; shift++; lh--; }
+    }
+    return idx;
+}
+
+static void tr_dump_dds(uint64_t key, const texrepl_guest* gt, const uint8_t* chain, uint32_t len)
+{
+    const uint32_t base = gt->raw_fmt & 0x9F;
+    uint32_t block = base == 0x86 ? 8 : (base == 0x87 || base == 0x88) ? 16 : 0;
+    if (!block && base != 0x85) return;
+    const uint32_t full = 1 + ilog2u(gt->width > gt->height ? gt->width : gt->height);
+    uint32_t mips = gt->mips ? gt->mips : 1;
+    if (mips > full) mips = full;
+    wchar_t path[MAX_PATH * 2];
+    _snwprintf(path, MAX_PATH * 2, L"%ls\\%016llx.dds", s_dump_dds_dir, (unsigned long long)key);
+    FILE* f = _wfopen(path, L"wb");
+    if (!f) return;
+    uint8_t h[128] = {0};
+    uint32_t v;
+#define W32(o, x) (v = (x), memcpy(h + (o), &v, 4))
+    W32(0, FOURCC('D', 'D', 'S', ' '));
+    W32(4, 124);
+    W32(8, 0x1u | 0x2u | 0x4u | 0x1000u | 0x20000u | (block ? 0x80000u : 0x8u));
+    W32(12, gt->height); W32(16, gt->width);
+    W32(20, block ? ((gt->width + 3) / 4) * ((gt->height + 3) / 4) * block : gt->width * 4);
+    W32(28, mips);
+    W32(76, 32);
+    if (block) {
+        W32(80, 0x4u);
+        W32(84, base == 0x86 ? FOURCC('D', 'X', 'T', '1') : base == 0x87 ? FOURCC('D', 'X', 'T', '3')
+                                                          : FOURCC('D', 'X', 'T', '5'));
+    } else {
+        W32(80, 0x40u | 0x1u); W32(88, 32);
+        W32(92, 0x000000FFu); W32(96, 0x0000FF00u); W32(100, 0x00FF0000u); W32(104, 0xFF000000u);
+    }
+    W32(108, 0x1000u | (mips > 1 ? 0x400008u : 0));
+#undef W32
+    fwrite(h, 1, 128, f);
+    if (block) {
+        uint32_t used = 0;
+        for (uint32_t i = 0; i < mips; i++) {
+            const uint32_t lw = (gt->width >> i) ? (gt->width >> i) : 1;
+            const uint32_t lh = (gt->height >> i) ? (gt->height >> i) : 1;
+            used += ((lw + 3) / 4) * ((lh + 3) / 4) * block;
+        }
+        fwrite(chain, 1, used < len ? used : len, f);
+    } else {
+        /* A8R8G8B8 swizzled (bytes A,R,G,B) -> linear R,G,B,A */
+        uint32_t off = 0;
+        for (uint32_t i = 0; i < mips; i++) {
+            const uint32_t lw = (gt->width >> i) ? (gt->width >> i) : 1;
+            const uint32_t lh = (gt->height >> i) ? (gt->height >> i) : 1;
+            uint8_t* row = (uint8_t*)malloc((size_t)lw * 4);
+            if (!row) break;
+            for (uint32_t y = 0; y < lh; y++) {
+                for (uint32_t x = 0; x < lw; x++) {
+                    const uint8_t* p = chain + off + (size_t)morton2(x, y, ilog2u(lw), ilog2u(lh)) * 4;
+                    row[x * 4 + 0] = p[1]; row[x * 4 + 1] = p[2];
+                    row[x * 4 + 2] = p[3]; row[x * 4 + 3] = p[0];
+                }
+                fwrite(row, 1, (size_t)lw * 4, f);
+            }
+            free(row);
+            off += lw * lh * 4;
+        }
+    }
+    fclose(f);
+}
+
+/* ------------------------------------------------------------------------- */
+int texrepl_find(const texrepl_guest* gt, const void* chain, uint32_t chain_len,
+                 uint64_t* key_out)
+{
+    LARGE_INTEGER q0, q1;
+    QueryPerformanceCounter(&q0);
+    const uint64_t key = tr_key(gt, chain, chain_len);
+    QueryPerformanceCounter(&q1);
+    s_key_bytes += chain_len;
+    s_key_qpc += (uint64_t)(q1.QuadPart - q0.QuadPart);
+    if (g_ft_on > 0) { static LARGE_INTEGER s_qf; if (!s_qf.QuadPart) QueryPerformanceFrequency(&s_qf);
+                       FT_ADD(FT_TR_KEY_US, (q1.QuadPart - q0.QuadPart) * 1000000 / s_qf.QuadPart); }
+    if (key_out) *key_out = key;
+    int r = tr_ht_find(key);
+    if (r >= 0 && s_rec[r].state == TR_GONE) r = -1;
+    if (r >= 0) {
+        tr_rec* e = &s_rec[r];
+        if (!e->hits++) {
+            e->gw = gt->width; e->gh = gt->height;
+            e->gmips = gt->mips; e->gfmt = gt->raw_fmt;
+            s_unique_hit++;
+        }
+        s_find_hit++;
+    } else {
+        s_find_miss++;
+    }
+    if ((s_dump || s_dump_dds_dir[0]) && tr_seen_insert(key)) {
+        if (s_dump) {
+            fprintf(s_dump, "%016llx\t%s\t0x%02X\t%u\t%u\t%u\t%u\t%u\t0x%08X\t0x%04X\t%u\n",
+                    (unsigned long long)key, r >= 0 ? "hit" : "miss", gt->raw_fmt & 0xFF,
+                    gt->mips, gt->width, gt->height, chain_len, gt->location, gt->offset,
+                    gt->remap & 0xFFFF, s_frame);
+            s_dump_dirty = 1;
+        }
+        if (s_dump_dds_dir[0])
+            tr_dump_dds(key, gt, (const uint8_t*)chain, chain_len);
+    }
+    return r;
+}
+
+static void tr_finalize(tr_rec* r, ID3D12GraphicsCommandList* list)
+{
+    for (uint32_t i = 0; i < r->n_mips; i++) {
+        D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+        dst.pResource = r->tex;
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        dst.SubresourceIndex = i;
+        src.pResource = r->upload;
+        src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        src.PlacedFootprint = r->fp[i];
+        list->lpVtbl->CopyTextureRegion(list, &dst, 0, 0, 0, &src, NULL);
+    }
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r->tex;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    list->lpVtbl->ResourceBarrier(list, 1, &b);
+    ID3D12Resource* up = r->upload;
+    r->upload = NULL;
+    free(r->fp); r->fp = NULL;
+    InterlockedAdd64(&s_inflight, -(LONG64)r->upload_bytes);
+    s_frame_finalized += r->upload_bytes;
+    FT_ADD(FT_TR_FIN_N, 1); FT_ADD(FT_TR_FIN_BYTES, r->upload_bytes);
+    r->gen = ++s_gen_counter ? s_gen_counter : ++s_gen_counter;   /* never 0 */
+    r->state = TR_READY;
+    s_resident += r->bytes;
+    s_resident_n++;
+    if (s_resident > s_resident_peak) s_resident_peak = s_resident;
+    s_retire(up);   /* may flush the list: the copies above execute first */
+}
+
+static int tr_take(int id, ID3D12GraphicsCommandList* list, texrepl_view* out)
+{
+    tr_rec* r = &s_rec[id];
+    r->last_use = s_frame;
+    LONG st = r->state;
+    if (st == TR_LOADED) {
+        MemoryBarrier();
+        if (s_frame_finalized >= TR_FINALIZE_CAP) { s_binds_wait++; return 0; }
+        if (!list) return 0;   /* the caller cannot record now: texrepl_wants_list() */
+        tr_finalize(r, list);
+        st = TR_READY;
+    }
+    if (st == TR_READY) {
+        out->tex = r->tex;
+        out->fmt = r->fmt;
+        out->gen = r->gen;
+        out->shift_fx = r->shift_fx;
+        s_binds_repl++;
+        return 1;
+    }
+    if (st == TR_NONE && s_nthreads && r->gw) {
+        r->state = TR_QUEUED;
+        tr_enqueue(id);
+    }
+    s_binds_wait++;
+    return 0;
+}
+
+/* A key's record samples its redirect target if it has one, else its own file (none for a
+ * redirect-only key: the guest texture). While the record to sample is still loading, the
+ * one sampled before the last switch stays on screen (no flash of the original). */
+int texrepl_acquire(int id, ID3D12GraphicsCommandList* list, texrepl_view* out)
+{
+    if (id < 0 || (uint32_t)id >= s_nrec) return 0;
+    tr_rec* r = &s_rec[id];
+    r->last_use = s_frame;
+    const int tid = r->alt1 ? r->alt1 - 1 : (r->noself ? -1 : id);
+    if (tid >= 0) {
+        tr_rec* t = &s_rec[tid];
+        if (t != r && !t->gw) { t->gw = r->gw; t->gh = r->gh; t->gmips = r->gmips; t->gfmt = r->gfmt; }
+        if (tr_take(tid, list, out)) { r->prev1 = 0; return 1; }
+        /* loaded, only the upload copies are missing and the caller has no list now: answer 0, so it
+         * comes back with one (texrepl_wants_list) -- the previous image would hide that for good */
+        if (!list && t->state == TR_LOADED && s_frame_finalized < TR_FINALIZE_CAP) return 0;
+    }
+    if (r->prev1) {
+        tr_rec* p = &s_rec[r->prev1 - 1];
+        if (r->prev1 - 1 != tid && p->state == TR_READY) {
+            p->last_use = s_frame;
+            out->tex = p->tex;
+            out->fmt = p->fmt;
+            out->gen = p->gen;
+            out->shift_fx = p->shift_fx;
+            s_binds_repl++;
+            return 1;
+        }
+        if (p->state != TR_READY) r->prev1 = 0;   /* evicted meanwhile: nothing to bridge with */
+    }
+    return 0;
+}
+
+/* texrepl_acquire(id, NULL, ..) returned 0 only because it needs a command list
+ * to record the record's upload copies (rsx_live_draw.c PS3_DCL: the caller
+ * drains its deferred list and calls again with the list). */
+int texrepl_wants_list(int id)
+{
+    if (id < 0 || (uint32_t)id >= s_nrec) return 0;
+    if (s_rec[id].alt1) id = s_rec[id].alt1 - 1;
+    return s_rec[id].state == TR_LOADED && s_frame_finalized < TR_FINALIZE_CAP;
+}
+
+static void tr_evict(tr_rec* r)
+{
+    if (s_verbose)
+        fprintf(stderr, "[texrepl] evict %016llx (%llu KB, last use frame %u)\n",
+                (unsigned long long)r->key, (unsigned long long)(r->bytes >> 10), r->last_use);
+    s_retire(r->tex);
+    r->tex = NULL;
+    s_resident -= r->bytes;
+    s_resident_n--;
+    r->gen = 0;
+    r->state = TR_NONE;
+    s_evictions++;
+}
+
+static int cmp_lru(const void* a, const void* b)
+{
+    const uint32_t ua = s_rec[*(const int32_t*)a].last_use, ub = s_rec[*(const int32_t*)b].last_use;
+    return ua < ub ? -1 : ua > ub;
+}
+
+static void tr_rescan_apply(void);
+static volatile LONG s_rescan_req, s_rescan_done;
+static void tr_redirect_apply(void);
+static volatile LONG s_redir_pending;
+
+void texrepl_frame(uint32_t frame, int print)
+{
+    if (!g_texrepl_on) return;
+    s_frame = frame;
+    s_frame_finalized = 0;
+    if (s_rescan_req != s_rescan_done) tr_rescan_apply();
+    if (s_redir_pending) tr_redirect_apply();
+
+    /* over budget (checked every 8th frame): evict the least recently used replacements that
+     * were not drawn for TR_EVICT_IDLE frames, down to 90% of the budget; a working set
+     * above the budget stays resident (warned) rather than reloading every frame */
+    if (s_resident > s_budget && (frame & 7) == 0) {
+        int32_t* cand = (int32_t*)malloc((size_t)s_nrec * sizeof *cand);
+        uint32_t nc = 0;
+        for (uint32_t i = 0; cand && i < s_nrec; i++)
+            if (s_rec[i].state == TR_READY && s_rec[i].last_use + TR_EVICT_IDLE < frame)
+                cand[nc++] = (int32_t)i;
+        if (nc) qsort(cand, nc, sizeof *cand, cmp_lru);
+        const uint64_t target = s_budget - s_budget / 10;
+        for (uint32_t i = 0; i < nc && s_resident > target; i++)
+            tr_evict(&s_rec[cand[i]]);
+        free(cand);
+        static uint32_t warned;
+        if (s_resident > s_budget && (warned < 4 && ++warned))
+            fprintf(stderr, "[texrepl] in-use replacements exceed the budget: %.1f MB > %llu MB "
+                            "(PS3_TEXREPL_BUDGET_MB)\n",
+                    (double)s_resident / 1048576.0, (unsigned long long)(s_budget >> 20));
+    }
+    /* loaded but never bound since: drop (not yet referenced by the GPU) */
+    if ((frame & 63) == 0) {
+        for (uint32_t i = 0; i < s_nrec; i++) {
+            tr_rec* r = &s_rec[i];
+            if (r->state != TR_LOADED || r->last_use + TR_STALE_LOADED >= frame) continue;
+            MemoryBarrier();
+            InterlockedAdd64(&s_inflight, -(LONG64)r->upload_bytes);
+            r->upload->lpVtbl->Release(r->upload); r->upload = NULL;
+            r->tex->lpVtbl->Release(r->tex); r->tex = NULL;
+            free(r->fp); r->fp = NULL;
+            r->state = TR_NONE;
+            s_dropped++;
+        }
+    }
+    if (s_dump && s_dump_dirty) { fflush(s_dump); s_dump_dirty = 0; }
+    if (!print) return;
+    /* print = 1: only when lookups/loads/evictions moved since the last line, or every 1024th
+     * frame (binds move every frame and alone say nothing new); print = 2: always */
+    static uint64_t last_sig = ~0ull;
+    const uint64_t sig = (s_find_hit + s_find_miss) * 0x9E3779B97F4A7C15ull ^
+                         (uint64_t)s_loads_done * 0xC2B2AE3D27D4EB4Full ^ (uint64_t)s_loads_failed << 40 ^
+                         s_evictions << 20 ^ s_dropped << 50 ^ s_resident_n;
+    if (print == 1 && sig == last_sig && (frame & 1023) != 0) return;
+    last_sig = sig;
+    uint32_t queued = 0, loaded = 0, failed = 0;
+    for (uint32_t i = 0; i < s_nrec; i++) {
+        const LONG st = s_rec[i].state;
+        queued += st == TR_QUEUED; loaded += st == TR_LOADED; failed += st == TR_FAILED;
+    }
+    double vram_mb = -1.0;
+#if !defined(RSX_TEXREPL_POSIX)
+    if (s_adapter) {
+        DXGI_QUERY_VIDEO_MEMORY_INFO mi;
+        if (SUCCEEDED(s_adapter->lpVtbl->QueryVideoMemoryInfo(s_adapter, 0,
+                                                               DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &mi)))
+            vram_mb = (double)mi.CurrentUsage / 1048576.0;
+    }
+#endif
+    const LONG64 done = s_loads_done;
+    LARGE_INTEGER qpf;
+    QueryPerformanceFrequency(&qpf);
+    fprintf(stderr,
+            "[texrepl] frame %u entries=%u find[hit=%llu miss=%llu unique-hit=%u hashed=%.1f MB %.2f ms] "
+            "binds[repl=%llu 1x=%llu] resident[%u tex %.1f MB peak %.1f MB budget %llu MB] "
+            "loads[done=%lld queued=%u pending-copy=%u failed=%u io=%.1f MB %.1f ms avg] "
+            "evicted=%llu dropped=%llu vram=%.0f MB%s\n",
+            frame, s_nrec, (unsigned long long)s_find_hit, (unsigned long long)s_find_miss,
+            s_unique_hit, (double)s_key_bytes / 1048576.0, (double)s_key_qpc * 1000.0 / (double)qpf.QuadPart, (unsigned long long)s_binds_repl, (unsigned long long)s_binds_wait,
+            s_resident_n, (double)s_resident / 1048576.0, (double)s_resident_peak / 1048576.0,
+            (unsigned long long)(s_budget >> 20), (long long)done, queued, loaded, failed,
+            (double)s_io_bytes / 1048576.0, done ? (double)s_io_us / 1000.0 / (double)done : 0.0,
+            (unsigned long long)s_evictions, (unsigned long long)s_dropped, vram_mb,
+            s_dump ? " (dumping keys)" : "");
+}
+
+/* ------------------------------------------------------------------------- */
+static int s_qlock_ready;
+
+/* Loader queue (a ring sized s_caprec) + threads; the ring grows in tr_rescan_apply. */
+static void tr_start_loaders(void)
+{
+    if (!s_qlock_ready) {
+        InitializeCriticalSection(&s_qlock);
+        InitializeConditionVariable(&s_qcv);
+        s_qlock_ready = 1;
+    }
+    if (!s_queue) s_queue = (int32_t*)malloc((size_t)s_caprec * sizeof *s_queue);
+    if (s_nthreads) return;
+    int nt = 2;
+    { const char* t = getenv("PS3_TEXREPL_THREADS"); if (t && *t) nt = atoi(t); }
+    if (nt < 1) nt = 1;
+    if (nt > 8) nt = 8;
+    for (int i = 0; s_queue && i < nt; i++) {
+        s_threads[i] = CreateThread(NULL, 0, tr_worker, NULL, 0, NULL);
+        if (!s_threads[i]) break;
+        SetThreadPriority(s_threads[i], THREAD_PRIORITY_BELOW_NORMAL);
+        s_nthreads++;
+    }
+}
+
+int texrepl_init(ID3D12Device* dev, texrepl_retire_fn retire)
+{
+    const char* e = getenv("PS3_TEXREPL");
+    if (e && (!strcmp(e, "0") || !_stricmp(e, "off"))) {
+        fprintf(stderr, "[texrepl] off (PS3_TEXREPL=0)\n");
+        return 0;
+    }
+    s_dev = dev;
+    s_retire = retire;
+    { const char* v = getenv("PS3_TEXREPL_VERBOSE"); s_verbose = v && *v && *v != '0'; }
+    { const char* b = getenv("PS3_TEXREPL_BUDGET_MB");
+      if (b && *b) { const unsigned long long mb = strtoull(b, NULL, 0); if (mb) s_budget = mb << 20; } }
+
+    /* index */
+#if defined(RSX_TEXREPL_POSIX)
+    LARGE_INTEGER ts0, ts1, tsf;
+    QueryPerformanceCounter(&ts0);
+#endif
+    const char* root = ps3_mods_root();
+    if (root && root[0]) {
+        wchar_t wroot[MAX_PATH];
+        if (MultiByteToWideChar(CP_ACP, 0, root, -1, wroot, MAX_PATH)) {
+            for (wchar_t* p = wroot; *p; p++) if (*p == L'/') *p = L'\\';
+            tr_scan_root(wroot);
+        }
+    }
+#if defined(RSX_TEXREPL_POSIX)
+    /* browser: the scan is WasmFS readdir + stat over the streamed /mods index (metadata only); Linux: readdir + stat */
+    QueryPerformanceCounter(&ts1);
+    QueryPerformanceFrequency(&tsf);
+    if (s_nrec)
+        fprintf(stderr, "[texrepl] scan of '%s': %u entries in %.1f ms\n", root ? root : "", s_nrec,
+                (double)(ts1.QuadPart - ts0.QuadPart) * 1000.0 / (double)tsf.QuadPart);
+#endif
+
+    /* key dump */
+    const char* d = getenv("PS3_TEXREPL_DUMP");
+    if (d && *d && strcmp(d, "0") != 0) {
+        const char* path = strcmp(d, "1") == 0 ? "texrepl_seen.tsv" : d;
+        s_dump = fopen(path, "w");
+        if (s_dump) {
+            fprintf(s_dump, "# ps3recomp texrepl key dump: key = XXH3_64bits_withSeed(chain, len, "
+                            "fmt<<56|mips<<48|w<<32|h<<16)\n"
+                            "#key\tlookup\tfmt\tmips\tw\th\tchain_len\tlocation\toffset\tremap\tframe\n");
+            fprintf(stderr, "[texrepl] dumping the keys of all replaceable textures seen to '%s'\n", path);
+        } else {
+            fprintf(stderr, "[texrepl] cannot write PS3_TEXREPL_DUMP '%s'\n", path);
+        }
+    }
+    const char* dd = getenv("PS3_TEXREPL_DUMP_DDS");
+    if (dd && *dd) {
+        MultiByteToWideChar(CP_ACP, 0, dd, -1, s_dump_dds_dir, MAX_PATH);
+        CreateDirectoryW(s_dump_dds_dir, NULL);
+        if (!is_dir_w(s_dump_dds_dir)) {
+            fprintf(stderr, "[texrepl] PS3_TEXREPL_DUMP_DDS '%s' is not a directory\n", dd);
+            s_dump_dds_dir[0] = 0;
+        } else {
+            fprintf(stderr, "[texrepl] writing every replaceable texture seen as 1x DDS to '%s'\n", dd);
+        }
+    }
+    /* redirects named before the device existed (a ps3mod plugin's ps3mod_init) */
+    tr_redirect_apply();
+    if (!s_nrec && !s_dump && !s_dump_dds_dir[0])
+        return 0;   /* nothing to do: stay off, zero cost */
+    if ((s_dump || s_dump_dds_dir[0]) && !s_seen) {
+        s_seen = (uint64_t*)calloc(4096, sizeof *s_seen);
+        s_seen_mask = s_seen ? 4095 : 0;
+        if (!s_seen) { if (s_dump) fclose(s_dump); s_dump = NULL; s_dump_dds_dir[0] = 0; }
+    }
+
+    if (s_nrec) {
+        char srcs[1024] = "";
+        size_t o = 0;
+        for (int i = 0; i < s_nsrc && o + 8 < sizeof srcs; i++)
+            o += (size_t)snprintf(srcs + o, sizeof srcs - o, "%s%s %u", i ? ", " : "", s_src[i],
+                                  s_src_count[i]);
+        char dups[96] = "";
+        if (s_dups)
+            snprintf(dups, sizeof dups, "; %u keys in more than one source: the later one wins", s_dups);
+        fprintf(stderr, "[texrepl] mods textures: %u entries (root '%s'; %s%s), budget %llu MB\n",
+                s_nrec, root, srcs, dups, (unsigned long long)(s_budget >> 20));
+        tr_start_loaders();
+    }
+    /* VRAM figure for the stats line */
+#if !defined(RSX_TEXREPL_POSIX)   /* browser / Linux: no DXGI adapter memory query (vram=-1 in the stats line) */
+    {
+        IDXGIFactory4* f = NULL;
+        LUID luid;
+        dev->lpVtbl->GetAdapterLuid(dev, &luid);
+        if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f)) && f) {
+            f->lpVtbl->EnumAdapterByLuid(f, luid, &IID_IDXGIAdapter3, (void**)&s_adapter);
+            f->lpVtbl->Release(f);
+        }
+    }
+#endif
+    g_texrepl_on = 1;
+    return 1;
+}
+
+/* ------------------------------------------------------------------------- */
+/* live rescan (texrepl_rescan)                                               */
+
+static SRWLOCK  s_rescan_lock = SRWLOCK_INIT;   /* one rescan at a time */
+static uint32_t s_rescan_out[4];                /* indexed, added, removed, changed */
+
+/* Drop whatever a record holds on the GPU / in upload memory. Render thread (or texrepl off),
+ * never while the record is QUEUED (a loader thread owns it then). */
+static void tr_release(tr_rec* r)
+{
+    if (r->state == TR_READY) {
+        if (r->tex) s_retire(r->tex);
+        r->tex = NULL;
+        s_resident -= r->bytes;
+        s_resident_n--;
+    } else if (r->state == TR_LOADED) {
+        InterlockedAdd64(&s_inflight, -(LONG64)r->upload_bytes);
+        if (r->upload) r->upload->lpVtbl->Release(r->upload);
+        if (r->tex) r->tex->lpVtbl->Release(r->tex);
+        r->upload = NULL; r->tex = NULL;
+        free(r->fp); r->fp = NULL;
+    }
+    r->gen = 0;
+}
+
+/* Re-scan the mods root and fold the result into the record table. Record ids stay stable (the
+ * live-draw cache holds them): a changed file drops its loaded texture and reloads on the next bind,
+ * a removed one becomes TR_GONE, a new key is appended. Runs on the render thread from
+ * texrepl_frame() -- or inline while texrepl is off -- and only when no record is QUEUED, so no
+ * loader thread is inside s_rec (it may be reallocated here). */
+static void tr_rescan_apply(void)
+{
+    for (uint32_t i = 0; i < s_nrec; i++)
+        if (s_rec[i].state == TR_QUEUED) return;          /* loads in flight: next frame */
+    LARGE_INTEGER t0, t1, fq;
+    QueryPerformanceCounter(&t0);
+    const uint32_t old_n = s_nrec, old_cap = s_caprec;
+    for (uint32_t i = 0; i < s_nrec; i++) { s_rec[i].seen = 0; s_rec[i].isnew = 0; }
+    s_nsrc = 0;
+    s_dups = 0;
+    memset(s_src_count, 0, sizeof s_src_count);
+    s_rescanning = 1;
+    const char* root = ps3_mods_root();
+    if (root && root[0]) {
+        wchar_t wroot[MAX_PATH];
+        if (MultiByteToWideChar(CP_ACP, 0, root, -1, wroot, MAX_PATH)) {
+            for (wchar_t* p = wroot; *p; p++) if (*p == L'/') *p = L'\\';
+            tr_scan_root(wroot);
+        }
+    }
+    s_rescanning = 0;
+    uint32_t added = 0, removed = 0, changed = 0, live = 0;
+    for (uint32_t i = 0; i < s_nrec; i++) {
+        tr_rec* r = &s_rec[i];
+        if (r->is_alt) continue;                        /* redirect targets are not part of the scan */
+        if (r->noself) {
+            if (!r->seen) continue;                     /* still redirect-only */
+            r->noself = 0;                              /* a pack now has this key */
+            r->path = r->npath; r->npath = NULL;
+            r->pack = r->npack; r->fsize = r->nsize; r->fmtime = r->nmtime;
+            r->state = TR_NONE;
+            live++; added++;
+            continue;
+        }
+        if (!r->seen && r->alt1) {                      /* its file went away, the redirect stays */
+            tr_release(r);
+            r->state = TR_NONE;
+            r->noself = 1;
+            free(r->path); r->path = NULL;
+            removed++;
+            continue;
+        }
+        if (!r->seen) {
+            if (r->state != TR_GONE) {
+                if (s_verbose) fprintf(stderr, "[texrepl] rescan: removed %016llx\n", (unsigned long long)r->key);
+                tr_release(r);
+                r->state = TR_GONE;
+                removed++;
+            }
+            continue;
+        }
+        live++;
+        if (r->isnew) { added++; continue; }
+        const int moved = wcscmp(r->npath, r->path) != 0;
+        const int differs = moved || r->nsize != r->fsize || r->nmtime != r->fmtime;
+        if (moved) { free(r->path); r->path = r->npath; r->npath = NULL; }
+        r->pack = r->npack;
+        r->fsize = r->nsize; r->fmtime = r->nmtime;
+        if (r->state == TR_GONE) {
+            r->state = TR_NONE;
+            added++;
+        } else if (differs) {
+            if (s_verbose) fprintf(stderr, "[texrepl] rescan: changed %016llx\n", (unsigned long long)r->key);
+            tr_release(r);
+            r->state = TR_NONE;
+            changed++;
+        }
+        free(r->npath); r->npath = NULL;
+    }
+    /* the loader ring is sized s_caprec and is empty here (nothing QUEUED) */
+    if (s_caprec != old_cap || (!s_queue && s_nrec)) {
+        if (s_qlock_ready) EnterCriticalSection(&s_qlock);
+        int32_t* nq = (int32_t*)realloc(s_queue, (size_t)s_caprec * sizeof *nq);
+        if (nq) { s_queue = nq; s_qhead = 0; s_qcount = 0; }
+        if (s_qlock_ready) LeaveCriticalSection(&s_qlock);
+    }
+    if (s_nrec && !s_nthreads) tr_start_loaders();
+    if (added || removed || changed) InterlockedIncrement((volatile LONG*)&g_texrepl_epoch);
+    QueryPerformanceCounter(&t1);
+    QueryPerformanceFrequency(&fq);
+    fprintf(stderr, "[texrepl] rescan: %u live (%u records), +%u -%u ~%u in %.1f ms%s\n", live, s_nrec,
+            added, removed, changed, (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)fq.QuadPart,
+            s_nrec != old_n ? " (table grew)" : "");
+    s_rescan_out[0] = live; s_rescan_out[1] = added; s_rescan_out[2] = removed; s_rescan_out[3] = changed;
+    InterlockedExchange(&s_rescan_done, s_rescan_req);
+}
+
+/* Live re-scan of the texture packs (plugin ABI 1.2 mods_rescan). Any thread. With texrepl
+ * running, the render thread applies it at its next frame (this waits up to 5 s for that); with
+ * texrepl off (no textures at start-up) it is applied here and turns texrepl on when files were
+ * found. out = {indexed, added, removed, changed}. 0 = OK, -1 = unavailable (no device /
+ * PS3_TEXREPL=0), -2 = the render thread did not apply it in time (it still will). */
+int texrepl_rescan(uint32_t out[4])
+{
+    if (out) out[0] = out[1] = out[2] = out[3] = 0;
+    if (!s_dev) return -1;
+    AcquireSRWLockExclusive(&s_rescan_lock);
+    int rc;
+    if (!g_texrepl_on) {
+        InterlockedIncrement(&s_rescan_req);
+        tr_rescan_apply();                      /* nothing else touches texrepl while it is off */
+        if (s_nrec) {
+            MemoryBarrier();
+            g_texrepl_on = 1;                   /* the render thread starts using it next frame */
+            fprintf(stderr, "[texrepl] on (live rescan found %u entries)\n", s_nrec);
+        }
+        rc = 0;
+    } else {
+        const LONG req = InterlockedIncrement(&s_rescan_req);
+        rc = -2;
+        for (int i = 0; i < 2500; i++) {
+            if (s_rescan_done - req >= 0) { rc = 0; break; }
+            Sleep(2);
+        }
+        if (rc) fprintf(stderr, "[texrepl] rescan: the render thread has not applied it after 5 s "
+                                "(no frames presented?) -- it will at the next frame\n");
+    }
+    if (out && rc == 0) memcpy(out, s_rescan_out, sizeof s_rescan_out);
+    ReleaseSRWLockExclusive(&s_rescan_lock);
+    return rc;
+}
+
+/* ------------------------------------------------------------------------- */
+/* redirects (texrepl_redirect)                                               */
+
+typedef struct { uint64_t key; wchar_t* path; } tr_redir;
+static SRWLOCK  s_redir_lock = SRWLOCK_INIT;
+static tr_redir s_redir[64];
+static uint32_t s_nredir;
+
+/* Append a record (grows the table and, for a keyed one, the hash). -1 = out of memory. */
+static int tr_new_rec(uint64_t key, const wchar_t* path, int keyed)
+{
+    if (s_nrec == s_caprec) {
+        const uint32_t nc = s_caprec ? s_caprec * 2 : 1024;
+        tr_rec* nr = (tr_rec*)realloc(s_rec, (size_t)nc * sizeof *nr);
+        if (!nr) return -1;
+        s_rec = nr; s_caprec = nc;
+    }
+    if (keyed && (s_nrec + 1) * 2 > (s_ht ? s_ht_mask + 1 : 0)) {
+        const uint32_t nsz = s_ht ? (s_ht_mask + 1) * 2 : 4096;
+        int32_t* nh = (int32_t*)malloc((size_t)nsz * sizeof *nh);
+        if (!nh) return -1;
+        memset(nh, 0xFF, (size_t)nsz * sizeof *nh);
+        for (uint32_t r = 0; r < s_nrec; r++) {
+            if (s_rec[r].is_alt) continue;
+            uint32_t i = tr_mix(s_rec[r].key) & (nsz - 1);
+            while (nh[i] >= 0) i = (i + 1) & (nsz - 1);
+            nh[i] = (int32_t)r;
+        }
+        free(s_ht); s_ht = nh; s_ht_mask = nsz - 1;
+    }
+    tr_rec* e = &s_rec[s_nrec];
+    memset(e, 0, sizeof *e);
+    e->key = key;
+    e->path = path ? _wcsdup(path) : NULL;
+    e->is_alt = (uint8_t)!keyed;
+    e->noself = (uint8_t)(keyed && !path);
+    if (path) {
+        WIN32_FILE_ATTRIBUTE_DATA fa;
+        if (GetFileAttributesExW(path, GetFileExInfoStandard, &fa)) {
+            e->fsize = ((uint64_t)fa.nFileSizeHigh << 32) | fa.nFileSizeLow;
+            e->fmtime = ((uint64_t)fa.ftLastWriteTime.dwHighDateTime << 32) | fa.ftLastWriteTime.dwLowDateTime;
+        }
+    }
+    if (keyed) {
+        uint32_t i = tr_mix(key) & s_ht_mask;
+        while (s_ht[i] >= 0) i = (i + 1) & s_ht_mask;
+        s_ht[i] = (int32_t)s_nrec;
+    }
+    return (int)s_nrec++;
+}
+
+/* Fold the pending redirects into the table. Render thread (texrepl_frame), texrepl_init, or
+ * inline while texrepl is off; only when no record is QUEUED (the table may grow while a
+ * loader thread would be inside it). */
+static void tr_redirect_apply(void)
+{
+    if (!s_redir_pending) return;
+    for (uint32_t i = 0; i < s_nrec; i++)
+        if (s_rec[i].state == TR_QUEUED) return;          /* loads in flight: next frame */
+    tr_redir list[64];
+    uint32_t n;
+    AcquireSRWLockExclusive(&s_redir_lock);
+    n = s_nredir;
+    memcpy(list, s_redir, n * sizeof list[0]);
+    s_nredir = 0;
+    InterlockedExchange(&s_redir_pending, 0);
+    ReleaseSRWLockExclusive(&s_redir_lock);
+    const uint32_t old_cap = s_caprec;
+    int new_keys = 0;
+    for (uint32_t k = 0; k < n; k++) {
+        const uint64_t key = list[k].key;
+        const wchar_t* path = list[k].path;
+        int b = s_ht ? tr_ht_find(key) : -1;
+        if (b >= 0 && s_rec[b].state == TR_GONE) {         /* a pack file removed by a rescan: reuse */
+            s_rec[b].state = TR_NONE;
+            s_rec[b].noself = 1;
+            free(s_rec[b].path); s_rec[b].path = NULL;
+        }
+        if (b < 0) {
+            b = tr_new_rec(key, NULL, 1);
+            if (b < 0) { free(list[k].path); continue; }
+            new_keys = 1;
+        }
+        int a = -1;
+        if (path) {
+            for (uint32_t i = 0; i < s_nrec && a < 0; i++)
+                if (s_rec[i].is_alt && s_rec[i].path && _wcsicmp(s_rec[i].path, path) == 0) a = (int)i;
+            if (a < 0) {
+                a = tr_new_rec(key, path, 0);
+                if (a < 0) { free(list[k].path); continue; }
+            } else {
+                /* the file may have been rewritten since (a plugin regenerating it): reload */
+                tr_rec* t = &s_rec[a];
+                WIN32_FILE_ATTRIBUTE_DATA fa;
+                if (GetFileAttributesExW(path, GetFileExInfoStandard, &fa)) {
+                    const uint64_t sz = ((uint64_t)fa.nFileSizeHigh << 32) | fa.nFileSizeLow;
+                    const uint64_t mt = ((uint64_t)fa.ftLastWriteTime.dwHighDateTime << 32) |
+                                        fa.ftLastWriteTime.dwLowDateTime;
+                    if (sz != t->fsize || mt != t->fmtime) {
+                        tr_release(t);
+                        t->state = TR_NONE;
+                        t->fsize = sz; t->fmtime = mt;
+                    }
+                }
+            }
+        }
+        tr_rec* r = &s_rec[b];
+        const int cur = r->alt1 ? r->alt1 : (r->noself ? 0 : b + 1);   /* what it sampled so far (id + 1) */
+        const int nxt = a >= 0 ? a + 1 : (r->noself ? 0 : b + 1);
+        if (cur != nxt) {
+            r->prev1 = cur;
+            r->alt1 = a >= 0 ? a + 1 : 0;
+        }
+        if (a >= 0) {
+            tr_rec* t = &s_rec[a];
+            if (!t->gw && r->gw) { t->gw = r->gw; t->gh = r->gh; t->gmips = r->gmips; t->gfmt = r->gfmt; }
+            if (t->state == TR_FAILED) t->state = TR_NONE;   /* a fixed file gets another try */
+        }
+        if (s_verbose || n <= 8) {
+            char pa[MAX_PATH * 2] = "(the packs / the original)";
+            if (path) WideCharToMultiByte(CP_UTF8, 0, path, -1, pa, sizeof pa, NULL, NULL);
+#if defined(RSX_TEXREPL_POSIX) && !defined(PS3_WASM)
+            if (path) for (char* q = pa; *q; q++) if (*q == '\\') *q = '/';   /* Linux: the path as the player wrote it */
+#endif
+            fprintf(stderr, "[texrepl] redirect %016llx -> %s\n", (unsigned long long)key, pa);
+        }
+        free(list[k].path);
+    }
+    if (s_caprec != old_cap || (!s_queue && s_nrec)) {
+        if (s_qlock_ready) EnterCriticalSection(&s_qlock);
+        int32_t* nq = (int32_t*)realloc(s_queue, (size_t)s_caprec * sizeof *nq);
+        if (nq) { s_queue = nq; s_qhead = 0; s_qcount = 0; }
+        if (s_qlock_ready) LeaveCriticalSection(&s_qlock);
+    }
+    /* preload the targets whose guest size is known, so a switch shows the new image within a
+     * frame or two (the next bind would queue it as well, one frame later) */
+    if (s_nrec && !s_nthreads && s_dev) tr_start_loaders();
+    for (uint32_t i = 0; i < s_nrec; i++) {
+        tr_rec* r = &s_rec[i];
+        if (!r->alt1) continue;
+        tr_rec* t = &s_rec[r->alt1 - 1];
+        if (t->state == TR_NONE && t->gw && s_nthreads) { t->state = TR_QUEUED; tr_enqueue(r->alt1 - 1); }
+    }
+    if (new_keys) InterlockedIncrement((volatile LONG*)&g_texrepl_epoch);
+}
+
+int texrepl_redirect(uint64_t key, const wchar_t* path)
+{
+    wchar_t* dup = NULL;
+    if (path && path[0]) {
+        dup = _wcsdup(path);
+        if (!dup) return -1;
+    }
+    AcquireSRWLockExclusive(&s_redir_lock);
+    uint32_t i = 0;
+    while (i < s_nredir && s_redir[i].key != key) i++;
+    if (i == s_nredir) {
+        if (s_nredir == sizeof s_redir / sizeof s_redir[0]) {
+            ReleaseSRWLockExclusive(&s_redir_lock);
+            free(dup);
+            return -1;
+        }
+        s_nredir++;
+    } else {
+        free(s_redir[i].path);
+    }
+    s_redir[i].key = key;
+    s_redir[i].path = dup;
+    InterlockedExchange(&s_redir_pending, 1);
+    ReleaseSRWLockExclusive(&s_redir_lock);
+
+    /* texrepl initialised but off (nothing at start-up): nothing else touches it, apply here */
+    if (s_dev && !g_texrepl_on) {
+        AcquireSRWLockExclusive(&s_rescan_lock);
+        if (!g_texrepl_on) {
+            tr_redirect_apply();
+            if (s_nrec) {
+                MemoryBarrier();
+                g_texrepl_on = 1;
+                fprintf(stderr, "[texrepl] on (redirect)\n");
+            }
+        }
+        ReleaseSRWLockExclusive(&s_rescan_lock);
+    }
+    return 0;
+}
+
+int texrepl_redirect_utf8(uint64_t key, const char* path_utf8)
+{
+    if (!path_utf8 || !path_utf8[0]) return texrepl_redirect(key, NULL);
+    wchar_t w[MAX_PATH * 2];
+    if (!MultiByteToWideChar(CP_UTF8, 0, path_utf8, -1, w, MAX_PATH * 2)) return -1;
+    for (wchar_t* p = w; *p; p++) if (*p == L'/') *p = L'\\';
+    return texrepl_redirect(key, w);
+}
+
+void texrepl_shutdown(void)
+{
+    if (!g_texrepl_on) return;
+    InterlockedExchange(&s_stop, 1);
+    if (s_nthreads) {
+        WakeAllConditionVariable(&s_qcv);
+        WaitForMultipleObjects((DWORD)s_nthreads, s_threads, TRUE, 2000);
+    }
+    if (s_dump) { fclose(s_dump); s_dump = NULL; }
+    texrepl_frame(s_frame, 2);
+    g_texrepl_on = 0;
+}
+
+#endif /* _WIN32 || PS3_WASM || RSX_LIVE_VKD3D */
diff --git a/libs/video/rsx_texrepl.h b/libs/video/rsx_texrepl.h
new file mode 100644
index 00000000..adbff53d
--- /dev/null
+++ b/libs/video/rsx_texrepl.h
@@ -0,0 +1,204 @@
+/*
+ * ps3recomp - host-side texture replacement for the D3D12 live-draw backend
+ *
+ * A mods folder supplies DDS files that the backend samples INSTEAD of a guest
+ * texture. The guest keeps its own 1x data in emulated RSX memory, so a
+ * replacement may have any size: there is no guest VRAM budget involved.
+ *
+ * Opt-in and generic: active only when the mods root (PS3_MODS_ROOT, see
+ * vfs_mods.h) holds a textures\ folder, or when the key dump is requested.
+ * Otherwise texrepl_init() returns 0 and the live-draw hot path costs one
+ * branch on g_texrepl_on.
+ *
+ * KEY (agreed with the pack tools; computable offline from the game files):
+ *   key  = XXH3_64bits_withSeed(chain, chain_len, seed)          (xxHash >= 0.8)
+ *   seed = (u64)fmt << 56 | (u64)mips << 48 | (u64)width << 32 | (u64)height << 16
+ *          fmt   = raw NV4097 TEXTURE_FORMAT format byte (= CellGcmTexture.format,
+ *                  incl. the 0x20 LN / 0x40 UN modifier bits)
+ *          mips  = TEXTURE_FORMAT mipmap count (= CellGcmTexture.mipmap)
+ *          width/height = IMAGE_RECT (= CellGcmTexture.width/height)
+ *   chain = the guest bytes at the texture offset, levels 0 .. max(1,mips)-1
+ *          contiguous, no early stop at 1x1, level dims max(1,w>>i) x max(1,h>>i):
+ *          DXT1 max(1,(lw+3)/4)*max(1,(lh+3)/4)*8, DXT3/DXT5 the same *16,
+ *          swizzled uncompressed lw*lh*bpp (B8 1; A1R5G5B5, A4R4G4B4, R5G6B5,
+ *          G8B8 2; A8R8G8B8 4).
+ *   LN (pitch-linear, 0x20) is keyed only for DXT1/3/5 with one level and the
+ *   natural pitch (0 or (w+3)/4 * block bytes): laid out like non-LN DXT, same
+ *   chain, and the 0x20 bit stays in the seed's fmt byte (e.g. 0xA8 = LN DXT5).
+ *   Never keyed (never replaced): cube maps, non-2D, other linear/pitch (LN),
+ *   unnormalized (UN) and every other format; render targets and vertex textures
+ *   never reach the lookup.
+ *
+ * FILES: <mods root>/textures/[subdirs/]<key>.dds (loose, highest priority) and
+ *   <mods root>/<pack>/textures/[subdirs/]<key>.dds; packs apply in folder-name order
+ *   (case-insensitive), a later pack wins for the same key, a pack whose name
+ *   starts with '.' or '_' is disabled -- the same rules as the VFS overlay.
+ *   Extra packs (PS3_TEXREPL_EXTRA_PACKS) are scanned after the named packs and
+ *   before the loose folder, so they win over every named pack.
+ *   <key> = 16 hex digits. The directory scan IS the index (index.json and other
+ *   files are ignored).
+ *
+ * DDS: BC1 / BC2 / BC3 (FourCC DXT1/DXT3/DXT5 or DX10), BC7 (DX10), R8G8B8A8 /
+ *   B8G8R8A8 (DX10 or legacy 32-bit masks); *_SRGB is read as UNORM. Top level
+ *   k*W x k*H (integer k >= 1, the guest's aspect), ideally the full chain
+ *   (k-scaled levels, then the guest's levels). Channels = the guest data decoded
+ *   with the IDENTITY remap; the guest's remap is applied as the SRV component
+ *   mapping. The guest sampler is kept, its LOD clamps are shifted by log2(k).
+ *
+ * Environment:
+ *   PS3_TEXREPL=0               off (no scan, no hashing)
+ *   PS3_TEXREPL_BUDGET_MB=<n>   resident replacement budget, LRU (default 4096)
+ *   PS3_TEXREPL_DUMP=<file>|1   append the key of every replaceable guest texture
+ *                               seen (once per key) as TSV; "1" = texrepl_seen.tsv
+ *                               in the working directory
+ *   PS3_TEXREPL_DUMP_DDS=<dir>  also write each seen texture as <dir>\<key>.dds at
+ *                               1x (DXT raw, A8R8G8B8 de-swizzled) -- pack sources
+ *   PS3_TEXREPL_THREADS=<n>     loader threads (default 2)
+ *   PS3_TEXREPL_VERBOSE=1       log every load/eviction
+ *   PS3_TEXREPL_EXTRA_PACKS=<dir>[;<dir>...]
+ *                               extra pack folders (each holding textures\), scanned
+ *                               in the order given after the named packs; a relative
+ *                               dir is taken under the mods root. A folder named
+ *                               '_name' is accepted here, so a pack shipped disabled
+ *                               (mods\_xbox_prompts) is switched on by naming it --
+ *                               e.g. by a ps3mod plugin during ps3mod_init, which runs
+ *                               before texrepl_init. Read with GetEnvironmentVariable
+ *                               (the process environment, not one CRT's copy). Unset:
+ *                               no change. Needs a mods root (PS3_MODS_ROOT).
+ *
+ * Browser build (PS3_WASM): the same code on POSIX + WasmFS (rsx_texrepl_wasm.h) and the D3D12-over-WebGPU layer.
+ *   The mods root is /mods (?mods=<pack>, streamed read-only); the page opts in with PS3_TEXREPL=1 (it passes 0 by
+ *   default, which also makes the plugin tex_redirect report "unavailable"). Default budget 1024 MB; the transient
+ *   upload copies (wasm heap) are capped lower than on Windows; no adapter VRAM figure in the stats line.
+ *
+ * Native Linux (RSX_LIVE_VKD3D, the live-draw renderer on vkd3d): the same POSIX file layer (rsx_texrepl_wasm.h)
+ *   over the host file system, with the Windows budgets. Paths stay wchar_t with '\' inside; a path component that
+ *   does not exist with its exact case is matched case-insensitively (packs made on Windows: Textures\, *.DDS).
+ *   PS3_TEXREPL_EXTRA_PACKS is read with getenv (the process environment, which setenv in a plugin updates).
+ *   No adapter VRAM figure in the stats line (vram=-1).
+ */
+#ifndef RSX_TEXREPL_H
+#define RSX_TEXREPL_H
+
+#if defined(PS3_WASM) || (defined(RSX_LIVE_VKD3D) && !defined(_WIN32))
+#define RSX_TEXREPL_POSIX 1   /* rsx_texrepl.c on the POSIX file layer (rsx_texrepl_wasm.h) + vkd3d's D3D12 headers */
+#endif
+
+#if defined(_WIN32) || defined(RSX_TEXREPL_POSIX)
+#include <stdint.h>
+#include <stddef.h>
+#if defined(RSX_TEXREPL_POSIX)
+/* Browser build: D3D12 through the WebGPU layer (libs/video/webgpu); native Linux: vkd3d. Both on vkd3d's C COM
+ * headers + the Win32 shim. */
+#include "rsx_live_draw_vkd3d.h"
+#else
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Releases a resource once the GPU no longer uses it (live-draw retire queue). */
+typedef void (*texrepl_retire_fn)(ID3D12Resource* res);
+
+/* Fast gate for the live-draw hot path: 1 once texrepl_init() found work. */
+extern int g_texrepl_on;
+/* Bumped by every live rescan that changed the replacement set: the live-draw
+ * cache re-keys an entry whose key predates it (a new file may match it). */
+extern volatile uint32_t g_texrepl_epoch;
+
+/* Scan the mods root, start the loader threads. Call once the device exists.
+ * Returns 1 when active (index non-empty or a dump requested), else 0. */
+int texrepl_init(ID3D12Device* dev, texrepl_retire_fn retire);
+
+/* Bytes of the keyed chain for this guest texture, or 0 when the texture is
+ * never replaced (format/dimension/cube/UN, LN other than single-level DXT with
+ * the natural pitch). pitch = TEX_SIZE1 pitch in bytes (0 = unset). */
+uint32_t texrepl_chain_len(uint32_t raw_fmt, uint32_t mips, uint32_t width,
+                           uint32_t height, uint32_t dimension, uint32_t cubemap,
+                           uint32_t pitch);
+
+typedef struct texrepl_guest {
+    uint32_t raw_fmt, mips, width, height;
+    uint32_t location, offset, remap;
+} texrepl_guest;
+
+/* Key the chain (guest bytes, texrepl_chain_len() long) and look it up.
+ * Returns a record id >= 0 on a hit, -1 on a miss. Counts hits/misses and
+ * feeds the key dump. */
+int texrepl_find(const texrepl_guest* gt, const void* chain, uint32_t chain_len,
+                 uint64_t* key_out);
+
+typedef struct texrepl_view {
+    ID3D12Resource* tex;
+    DXGI_FORMAT     fmt;
+    uint32_t        gen;        /* changes whenever the resource behind the record changes */
+    uint32_t        shift_fx;   /* log2(scale) in 1/256 LOD units */
+} texrepl_view;
+
+/* Bind time (render thread, command list open). Returns 1 with *out filled when
+ * the replacement can be sampled now; 0 = use the guest texture this time (load
+ * queued / in flight / failed / evicted). May record upload copies on `list`. */
+int texrepl_acquire(int rec, ID3D12GraphicsCommandList* list, texrepl_view* out);
+/* list == NULL in texrepl_acquire: a LOADED record is not finalized (returns 0);
+ * texrepl_wants_list(rec) says whether a call with a list would finalize it. */
+int texrepl_wants_list(int rec);
+
+/* Once per presented frame (render thread): budget/LRU, dump flush, and the
+ * "[texrepl]" stats line: print = 1 when lookups/loads/evictions changed since
+ * the last line (or every 1024th frame), print = 2 always, 0 never. */
+void texrepl_frame(uint32_t frame, int print);
+
+void texrepl_shutdown(void);
+
+/* Redirect: sample the DDS file `path` for every guest texture with this key, instead of what
+ * the packs give it (or the original); path NULL / "" = back to the packs / the original. For
+ * replacements chosen while the game runs (plugin ABI 1.3 tex_redirect: e.g. button prompts
+ * that follow the device in use). Any thread, also before texrepl_init (a ps3mod plugin's
+ * ps3mod_init); applied by the render thread at its next texrepl_frame(). The image shown so
+ * far stays on screen until the new file is loaded, and a target that was loaded once stays
+ * resident (LRU), so switching back and forth is immediate. A rewritten file (size / last
+ * write changed) is reloaded when it is named again. No directory scan is involved. A key no
+ * pack has gets a record of its own (live-draw entries keyed before are keyed once more).
+ * 0 = queued, -1 = out of memory / more than 64 redirects pending at once. */
+int texrepl_redirect(uint64_t key, const wchar_t* path);
+int texrepl_redirect_utf8(uint64_t key, const char* path_utf8);
+
+/* Live re-scan of the mods root (editor hot reload; plugin ABI 1.2 mods_rescan), any
+ * thread. Record ids stay stable: a changed DDS (size / last write / path) reloads at
+ * its next bind, a removed one falls back to the guest texture, a new one is found
+ * when the live-draw cache re-keys (g_texrepl_epoch). Applied by the render thread at
+ * its next texrepl_frame() (waits up to 5 s), or here while texrepl is off -- which
+ * turns it on when files were found. out = {indexed, added, removed, changed}.
+ * 0 OK, -1 unavailable (no device / PS3_TEXREPL=0), -2 not applied yet (it will be). */
+int texrepl_rescan(uint32_t out[4]);
+
+#ifdef __cplusplus
+}
+#endif
+#else  /* not Windows, the browser build or the vkd3d live-draw build: texture replacement is off */
+#include <stdint.h>
+#include <wchar.h>
+static const int g_texrepl_on = 0;
+static const uint32_t g_texrepl_epoch = 0;
+typedef struct texrepl_guest { uint32_t raw_fmt, mips, width, height; uint32_t location, offset, remap; } texrepl_guest;
+typedef struct texrepl_view { void* tex; uint32_t fmt; uint32_t gen; uint32_t shift_fx; } texrepl_view;
+typedef void (*texrepl_retire_fn)(void* res);
+static inline int texrepl_init(void* dev, void* retire) { (void)dev; (void)retire; return 0; }
+static inline uint32_t texrepl_chain_len(uint32_t f, uint32_t m, uint32_t w, uint32_t h, uint32_t d, uint32_t c, uint32_t p)
+{ (void)f; (void)m; (void)w; (void)h; (void)d; (void)c; (void)p; return 0; }
+static inline int texrepl_find(const texrepl_guest* g, const void* c, uint32_t n, uint64_t* k) { (void)g; (void)c; (void)n; (void)k; return -1; }
+static inline int texrepl_acquire(int rec, void* list, texrepl_view* out) { (void)rec; (void)list; (void)out; return 0; }
+static inline int texrepl_wants_list(int rec) { (void)rec; return 0; }
+static inline void texrepl_frame(uint32_t frame, int print) { (void)frame; (void)print; }
+static inline void texrepl_shutdown(void) {}
+static inline int texrepl_redirect(uint64_t key, const wchar_t* path) { (void)key; (void)path; return -1; }
+static inline int texrepl_redirect_utf8(uint64_t key, const char* path) { (void)key; (void)path; return -1; }
+static inline int texrepl_rescan(uint32_t out[4]) { (void)out; return -1; }
+#endif /* _WIN32 || RSX_TEXREPL_POSIX */
+#endif /* RSX_TEXREPL_H */
diff --git a/libs/video/rsx_texrepl_wasm.h b/libs/video/rsx_texrepl_wasm.h
new file mode 100644
index 00000000..671c151f
--- /dev/null
+++ b/libs/video/rsx_texrepl_wasm.h
@@ -0,0 +1,265 @@
+/*
+ * ps3recomp - rsx_texrepl.c in the browser build (PS3_WASM) and on native Linux (RSX_LIVE_VKD3D): the Win32 file
+ * and wide-string calls it makes, on POSIX (+ WasmFS in the browser). Included by rsx_texrepl.c only.
+ *
+ * Native Linux: wchar_t is UTF-32 there too, so everything below applies unchanged. File names are case-sensitive
+ * on Linux and packs are made on Windows (textures\ vs Textures\, .dds vs .DDS): a path that does not exist as
+ * given is resolved one component at a time, case-insensitively (tr_ci_fix; only on a miss, ASCII folding).
+ *
+ * Paths stay wchar_t (UTF-32 in wasm) with '\' separators, exactly as on Windows, so the scanner, the redirect table
+ * and the logs are the same code; tr_wpath() turns one into UTF-8 with '/' at each POSIX call. Threads, locks,
+ * Interlocked*, QPC and Sleep come from the runtime's Win32 shim (win32_compat.h, through rsx_live_draw_vkd3d.h);
+ * the D3D12 calls go to the WebGPU layer (libs/video/webgpu). The mods tree is /mods (web_vfs: every indexed entry
+ * exists for readdir/stat, file bytes stream through the IO worker), so a scan is metadata only.
+ */
+#ifndef RSX_TEXREPL_WASM_H
+#define RSX_TEXREPL_WASM_H
+
+#include <dirent.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <wchar.h>
+
+/* Windows' MAX_PATH for this file: the shim's (PATH_MAX, 4096) would put 64 KB of wchar_t buffers on the stack
+ * per directory level of the recursive scan (tr_scan), on a thread with a small wasm stack. /mods paths are short. */
+#undef MAX_PATH
+#if defined(PS3_WASM)
+#define MAX_PATH 260
+#else
+#define MAX_PATH 1024   /* native Linux: install paths can be long; tr_scan's two buffers are 16 KB a level */
+#endif
+
+#ifndef CP_ACP
+#define CP_ACP  0u
+#endif
+#ifndef CP_UTF8
+#define CP_UTF8 65001u
+#endif
+
+/* ---- UTF-32 <-> UTF-8 (the CRT's mbstowcs is locale-bound; these are not) ---- */
+static size_t tr_w2u_n(const wchar_t* w, char* o, size_t cap, int fs)
+{
+    size_t n = 0;
+    for (; *w; w++) {
+        uint32_t c = (uint32_t)*w;
+        if (fs && c == '\\') c = '/';
+        char b[4]; size_t k;
+        if (c < 0x80) { b[0] = (char)c; k = 1; }
+        else if (c < 0x800) { b[0] = (char)(0xC0 | (c >> 6)); b[1] = (char)(0x80 | (c & 0x3F)); k = 2; }
+        else if (c < 0x10000) { b[0] = (char)(0xE0 | (c >> 12)); b[1] = (char)(0x80 | ((c >> 6) & 0x3F));
+                                b[2] = (char)(0x80 | (c & 0x3F)); k = 3; }
+        else { b[0] = (char)(0xF0 | (c >> 18)); b[1] = (char)(0x80 | ((c >> 12) & 0x3F));
+               b[2] = (char)(0x80 | ((c >> 6) & 0x3F)); b[3] = (char)(0x80 | (c & 0x3F)); k = 4; }
+        if (n + k + 1 > cap) return 0;
+        memcpy(o + n, b, k); n += k;
+    }
+    if (n + 1 > cap) return 0;
+    o[n] = 0;
+    return n + 1;
+}
+/* a path for a POSIX call: UTF-8, '/' separators; 0 = too long */
+static int tr_wpath(const wchar_t* w, char* o, size_t cap) { return tr_w2u_n(w, o, cap, 1) != 0; }
+
+static size_t tr_u2w_n(const char* s, wchar_t* o, size_t cap)
+{
+    const unsigned char* p = (const unsigned char*)s;
+    size_t n = 0;
+    while (*p) {
+        uint32_t c = *p++;
+        int more = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : 0;
+        if (more) {
+            c &= 0x3Fu >> more;
+            for (int i = 0; i < more && (*p & 0xC0) == 0x80; i++) c = (c << 6) | (*p++ & 0x3F);
+        }
+        if (n + 2 > cap) return 0;
+        o[n++] = (wchar_t)c;
+    }
+    if (n + 1 > cap) return 0;
+    o[n] = 0;
+    return n + 1;
+}
+
+/* The two conversions as rsx_texrepl.c calls them (always NUL-terminated input, length -1): chars written incl. NUL. */
+#define MultiByteToWideChar(cp, fl, s, n, d, cap)          ((int)tr_u2w_n((s), (d), (size_t)(cap)))
+#define WideCharToMultiByte(cp, fl, s, n, d, cap, def, us) ((int)tr_w2u_n((s), (d), (size_t)(cap), 0))
+#define _wcsdup   wcsdup
+#define _wcsicmp  wcscasecmp
+#define _snwprintf swprintf
+
+/* ---- case-insensitive path resolution (native Linux) ----
+ * p is a UTF-8 '/' path. When it does not exist as given, each component that is missing is replaced in place by
+ * a directory entry that matches it ignoring ASCII case (same length, so the buffer never grows). Stops at the
+ * first component with no match (the caller's call then fails as it would have). The browser's /mods index is
+ * served as packed, so this is native only. */
+#if !defined(PS3_WASM)
+#include <strings.h>
+static void tr_ci_fix(char* p)
+{
+    struct stat st;
+    if (!p[0] || stat(p, &st) == 0) return;
+    char* comp = p;
+    if (*comp == '/') comp++;
+    while (*comp) {
+        char* end = strchr(comp, '/');
+        const char saved = end ? *end : 0;
+        if (end) *end = 0;
+        if (stat(p, &st) != 0) {
+            /* look in the parent (everything before comp) for a case-insensitive match */
+            char* const parent_end = comp > p ? comp - 1 : NULL;
+            DIR* d;
+            if (parent_end) { const char c = *parent_end; *parent_end = 0; d = opendir(parent_end == p ? "/" : p); *parent_end = c; }
+            else d = opendir(".");
+            int found = 0;
+            if (d) {
+                struct dirent* e;
+                while ((e = readdir(d)) != NULL)
+                    if (strcasecmp(e->d_name, comp) == 0 && strlen(e->d_name) == strlen(comp)) {
+                        memcpy(comp, e->d_name, strlen(comp)); found = 1; break;
+                    }
+                closedir(d);
+            }
+            if (!found) { if (end) *end = saved; return; }
+        }
+        if (!end) return;
+        *end = saved;
+        comp = end + 1;
+    }
+}
+#else
+#define tr_ci_fix(p) ((void)0)
+#endif
+
+/* ---- FindFirstFileW / FindNextFileW / FindClose over opendir (the pattern is always "<dir>\*") ---- */
+typedef struct {
+    DWORD    dwFileAttributes;
+    FILETIME ftLastWriteTime;
+    DWORD    nFileSizeHigh, nFileSizeLow;
+    wchar_t  cFileName[MAX_PATH];
+} tr_find_data;
+#define WIN32_FIND_DATAW tr_find_data
+
+typedef struct { DIR* d; char dir[MAX_PATH * 2]; } tr_find_state;
+
+static void tr_fill_times(const struct stat* st, FILETIME* ft)
+{
+    /* FILETIME units (100 ns); only compared for equality, so the epoch does not matter */
+    const uint64_t t = (uint64_t)st->st_mtim.tv_sec * 10000000ull + (uint64_t)st->st_mtim.tv_nsec / 100u;
+    ft->dwLowDateTime = (DWORD)t; ft->dwHighDateTime = (DWORD)(t >> 32);
+}
+
+static BOOL tr_find_next(HANDLE h, tr_find_data* fd)
+{
+    tr_find_state* s = (tr_find_state*)h;
+    for (;;) {
+        struct dirent* e = readdir(s->d);
+        if (!e) return FALSE;
+        if (!tr_u2w_n(e->d_name, fd->cFileName, MAX_PATH)) continue;   /* longer than MAX_PATH: not ours */
+        char full[MAX_PATH * 3];
+        struct stat st;
+        memset(&st, 0, sizeof st);
+        if (snprintf(full, sizeof full, "%s/%s", s->dir, e->d_name) < (int)sizeof full) stat(full, &st);
+        fd->dwFileAttributes = S_ISDIR(st.st_mode) ? FILE_ATTRIBUTE_DIRECTORY : 0x80u /* NORMAL */;
+        fd->nFileSizeHigh = (DWORD)((uint64_t)st.st_size >> 32);
+        fd->nFileSizeLow = (DWORD)(uint64_t)st.st_size;
+        tr_fill_times(&st, &fd->ftLastWriteTime);
+        return TRUE;
+    }
+}
+
+static HANDLE tr_find_first(const wchar_t* pattern, tr_find_data* fd)
+{
+    tr_find_state* s = (tr_find_state*)calloc(1, sizeof *s);
+    if (!s) return INVALID_HANDLE_VALUE;
+    if (!tr_wpath(pattern, s->dir, sizeof s->dir)) { free(s); return INVALID_HANDLE_VALUE; }
+    size_t n = strlen(s->dir);
+    if (n >= 2 && s->dir[n - 1] == '*' && s->dir[n - 2] == '/') s->dir[n - 2] = 0;   /* "<dir>/*" -> "<dir>" */
+    tr_ci_fix(s->dir);
+    s->d = opendir(s->dir);
+    if (!s->d) { free(s); return INVALID_HANDLE_VALUE; }
+    if (!tr_find_next((HANDLE)s, fd)) { closedir(s->d); free(s); return INVALID_HANDLE_VALUE; }
+    return (HANDLE)s;
+}
+
+static BOOL tr_find_close(HANDLE h)
+{
+    tr_find_state* s = (tr_find_state*)h;
+    if (s) { closedir(s->d); free(s); }
+    return TRUE;
+}
+#define FindFirstFileW tr_find_first
+#define FindNextFileW  tr_find_next
+#define FindClose      tr_find_close
+
+/* ---- attributes ---- */
+static DWORD tr_get_attrs_w(const wchar_t* path)
+{
+    char p[MAX_PATH * 2];
+    struct stat st;
+    if (!tr_wpath(path, p, sizeof p)) return INVALID_FILE_ATTRIBUTES;
+    tr_ci_fix(p);
+    if (stat(p, &st) != 0) return INVALID_FILE_ATTRIBUTES;
+    return S_ISDIR(st.st_mode) ? FILE_ATTRIBUTE_DIRECTORY : 0x80u;
+}
+#define GetFileAttributesW tr_get_attrs_w
+
+typedef struct {
+    DWORD    dwFileAttributes;
+    FILETIME ftCreationTime, ftLastAccessTime, ftLastWriteTime;
+    DWORD    nFileSizeHigh, nFileSizeLow;
+} tr_file_attr_data;
+#define WIN32_FILE_ATTRIBUTE_DATA tr_file_attr_data
+#define GetFileExInfoStandard 0
+
+static BOOL tr_get_attrs_ex_w(const wchar_t* path, int level, tr_file_attr_data* a)
+{
+    (void)level;
+    char p[MAX_PATH * 2];
+    struct stat st;
+    if (!tr_wpath(path, p, sizeof p)) return FALSE;
+    tr_ci_fix(p);
+    if (stat(p, &st) != 0) return FALSE;
+    memset(a, 0, sizeof *a);
+    a->dwFileAttributes = S_ISDIR(st.st_mode) ? FILE_ATTRIBUTE_DIRECTORY : 0x80u;
+    a->nFileSizeHigh = (DWORD)((uint64_t)st.st_size >> 32);
+    a->nFileSizeLow = (DWORD)(uint64_t)st.st_size;
+    tr_fill_times(&st, &a->ftLastWriteTime);
+    return TRUE;
+}
+#define GetFileAttributesExW tr_get_attrs_ex_w
+
+static BOOL tr_create_dir_w(const wchar_t* path, void* sa)
+{
+    (void)sa;
+    char p[MAX_PATH * 2];
+    return tr_wpath(path, p, sizeof p) && mkdir(p, 0777) == 0;
+}
+#define CreateDirectoryW tr_create_dir_w
+
+static FILE* tr_wfopen(const wchar_t* path, const wchar_t* mode)
+{
+    char p[MAX_PATH * 2], m[8];
+    if (!tr_wpath(path, p, sizeof p) || !tr_w2u_n(mode, m, sizeof m, 0)) return NULL;
+    if (m[0] == 'r') tr_ci_fix(p);
+    return fopen(p, m);
+}
+#define _wfopen tr_wfopen
+
+/* the process environment (a ps3mod plugin sets PS3_TEXREPL_EXTRA_PACKS with setenv during ps3mod_init) */
+static DWORD tr_getenv_w(const wchar_t* name, wchar_t* buf, DWORD cap)
+{
+    char n[128];
+    if (!tr_w2u_n(name, n, sizeof n, 0)) return 0;
+    const char* v = getenv(n);
+    if (!v) return 0;
+    const size_t need = strlen(v) + 1;   /* UTF-32 never needs more units than UTF-8 bytes */
+    if (need > cap) return (DWORD)need;
+    const size_t got = tr_u2w_n(v, buf, cap);
+    return got ? (DWORD)(got - 1) : (DWORD)need;
+}
+#define GetEnvironmentVariableW tr_getenv_w
+
+#endif /* RSX_TEXREPL_WASM_H */
