+ *     order (at start-up: real pads first, then slot order);
+ *   - a port remembers the controller it had (slot + vendor/product id; the ids alone if it comes back on
+ *     another slot). While another port is in use (a
+ *     2-player game), a controller that comes back gets its old port again and a different one does not
+ *     take a remembered port while a never-used one is free: pulling and re-plugging player 1's pad never
+ *     swaps the players. With nobody else connected the lowest free port wins (port 0);
+ *   - a probably-virtual pad (ids above) gets no port until it is USED (a button, trigger or stick): an idle
+ *     ViGEm / Sunshine / Steam pad never takes port 0 from the real one. Used, it is a normal controller
+ *     (streaming through Sunshine works as before; a real 360 pad simply gets its port on its first press).
+ * Every change logs "[cellPad] ports: ...". PS3_PAD_SLOTMAP=0 restores the old slot = port mapping. */
+typedef struct { int conn, used, virt; WORD vid, pid; } pad_slot_info;
+static pad_slot_info s_slot[PAD_MAX_HOST_PORTS];
+static int s_port_slot[PAD_MAX_HOST_PORTS] = { -1, -1, -1, -1 };   /* guest port -> XInput slot, -1 none */
+static unsigned long long s_port_mem[PAD_MAX_HOST_PORTS];                    /* last occupant's id key, 0 none */
+
+static int s_slotmap = -1;
+
+static int pad_slotmap_on(void)
+{
+    if (s_slotmap < 0) {
+        char v[8];
+        s_slotmap = !(pad_env("PS3_PAD_SLOTMAP", v, sizeof v) && v[0] == '0');
+        if (!s_slotmap) { printf("[cellPad] PS3_PAD_SLOTMAP=0: guest port = XInput slot\n"); fflush(stdout); }
+    }
+    return s_slotmap;
+}
+
+/* XInput slot that drives guest port <port> (rumble), -1 none */
+static int pad_port_slot(u32 port)
+{
+    if (port >= PAD_MAX_HOST_PORTS) return -1;
+    return pad_slotmap_on() ? s_port_slot[port] : (int)port;
+}
+
+static unsigned long long pad_slot_key(int s) { return 1ull << 40 | (unsigned long long)s << 32 | (unsigned long long)s_slot[s].vid << 16 | s_slot[s].pid; }
+
+static void pad_log_ports(const char* why)
+{
+    char line[400];
+    size_t o = 0;
+    o += (size_t)snprintf(line + o, sizeof line - o, "[cellPad] ports (%s):", why);
+    for (int p = 0; p < PAD_MAX_HOST_PORTS && o < sizeof line; p++) {
+        const int s = s_port_slot[p];
+        if (s >= 0) o += (size_t)snprintf(line + o, sizeof line - o, " %d=slot %d %04X:%04X%s", p, s, s_slot[s].vid,
+                                          s_slot[s].pid, s_slot[s].virt ? " (virtual?)" : "");
+        else        o += (size_t)snprintf(line + o, sizeof line - o, " %d=-", p);
+    }
+    for (int s = 0; s < PAD_MAX_HOST_PORTS && o < sizeof line; s++) {
+        int has = 0;
+        for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) has |= s_port_slot[p] == s;
+        if (s_slot[s].conn && !has)
+            o += (size_t)snprintf(line + o, sizeof line - o, " | slot %d %04X:%04X waiting (virtual?, unused)", s,
+                                  s_slot[s].vid, s_slot[s].pid);
+    }
+    printf("%s\n", line);
+    fflush(stdout);
+}
+
+/* One sweep of the port table from this sweep's connected slots (ok[]) and their input (gp[]). */
+static void pad_slotmap_update(const int ok[PAD_MAX_HOST_PORTS], const XINPUT_GAMEPAD gp[PAD_MAX_HOST_PORTS])
+{
+    int changed = 0;
+    const char* why = "";
+    for (int s = 0; s < PAD_MAX_HOST_PORTS; s++) {
+        pad_slot_info* si = &s_slot[s];
+        if (ok[s] && !si->conn) {                    /* plugged in */
+            memset(si, 0, sizeof *si);
+            si->conn = 1;
+            pad_xinput_ids(s, &si->vid, &si->pid);
+            si->virt = pad_ids_virtual(si->vid, si->pid);
+            changed = 1; why = "controller connected";
+        } else if (!ok[s] && si->conn) {             /* pulled */
+            si->conn = 0;
+            changed = 1; why = "controller disconnected";
+        }
+        if (ok[s] && !si->used) {
+            const XINPUT_GAMEPAD* g = &gp[s];
+            const int half = 16384;
+            if (g->wButtons || g->bLeftTrigger > 128 || g->bRightTrigger > 128 ||
+                g->sThumbLX > half || g->sThumbLX < -half || g->sThumbLY > half || g->sThumbLY < -half ||
+                g->sThumbRX > half || g->sThumbRX < -half || g->sThumbRY > half || g->sThumbRY < -half) {
+                si->used = 1;
+                if (si->virt) { changed = 1; why = "virtual? controller used"; }
+            }
+        }
+    }
+    if (!changed) return;
+    int busy = 0;
+    for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) {   /* a port whose controller went away is free (remembered) */
+        const int s = s_port_slot[p];
+        if (s >= 0 && !s_slot[s].conn) s_port_slot[p] = -1;
+        if (s_port_slot[p] >= 0) busy++;
+    }
+    for (int pass = 0; pass < 2; pass++) {           /* real controllers first, then used virtual ones */
+        for (int s = 0; s < PAD_MAX_HOST_PORTS; s++) {
+            const pad_slot_info* si = &s_slot[s];
+            int has = 0, port = -1;
+            if (!si->conn || si->virt != pass || (si->virt && !si->used)) continue;
+            for (int p = 0; p < PAD_MAX_HOST_PORTS; p++) has |= s_port_slot[p] == s;
+            if (has) continue;
+            const unsigned long long key = pad_slot_key(s);
+            for (int p = 0; p < PAD_MAX_HOST_PORTS && port < 0 && !busy; p++)   /* alone: the lowest port */
+                if (s_port_slot[p] < 0) port = p;
+            for (int p = 0; p < PAD_MAX_HOST_PORTS && port < 0; p++)        /* its own port, if free */
+                if (s_port_slot[p] < 0 && s_port_mem[p] == key) port = p;
+            for (int p = 0; p < PAD_MAX_HOST_PORTS && port < 0; p++)        /* back on another slot: same ids */
+                if (s_port_slot[p] < 0 && (s_port_mem[p] & 0xFFFFFFFFull) == (key & 0xFFFFFFFFull)) port = p;
+            for (int p = 0; p < PAD_MAX_HOST_PORTS && port < 0; p++)        /* else a free one nobody else had */
+                if (s_port_slot[p] < 0 && (!busy || !s_port_mem[p])) port = p;
+            for (int p = 0; p < PAD_MAX_HOST_PORTS && port < 0; p++)        /* else any free one */
+                if (s_port_slot[p] < 0) port = p;
+            if (port < 0) continue;
+            s_port_slot[port] = s;
+            s_port_mem[port] = key;
+            busy++;
+        }
+    }
+    pad_log_ports(why);
+}
