diff --git a/runtime/spu/spu_variant_api.h b/runtime/spu/spu_variant_api.h
new file mode 100644
index 00000000..f4aeebfa
--- /dev/null
+++ b/runtime/spu/spu_variant_api.h
@@ -0,0 +1,224 @@
+/*
+ * ps3recomp - content-keyed lifted SPU variants: shared definitions
+ *
+ * A VARIANT is SPU code lifted offline from a captured local store (SPU_MISS_DIR
+ * dumps -> tools/spucheck/lift_variants.py) for code that has no fixed (image,
+ * LS address) identity: an overlay the title assembles or patches itself, a
+ * self-modified stub, a module loaded from an address nothing registered. It is
+ * identified by the code that will actually run:
+ *
+ *   entry       the LS address dispatch lands on;
+ *   [lo, lo+len) the code extent its lifted C embodies -- the function body
+ *               (in-function branch targets and jump-table case labels lie
+ *               inside it) plus every function it calls or jumps to DIRECTLY,
+ *               transitively (those calls bypass dispatch, so their bytes are
+ *               part of what this variant assumes);
+ *   hash        spu_code_hash() of those bytes.
+ *
+ * The runtime (spu_channels.c, "Content-keyed lifted variants") runs a variant
+ * only after the live LS bytes of the whole extent hash the same; see there for
+ * how the verdict is cached and invalidated.
+ *
+ * Two ways in:
+ *   static  the generated spu_variants.c is linked into the title; a constructor
+ *           calls spu_variant_add().
+ *   DLL     SPU_VARIANT_DIR=<dir>: at the first SPU run the runtime loads every
+ *           *.dll there and calls its exported spu_variants_register() with a
+ *           spu_variant_api. lift_variants.py --dll builds one; nothing else of
+ *           the title is rebuilt or relinked.
+ *
+ * DLL linkage. Lifted code calls runtime helpers (spu_rdch, spu_indirect_branch,
+ * spu_drain_call_full, ...), reads runtime globals (g_spu_hop_slow, ...) and the
+ * host's thread-locals (g_spu_trampoline_fn, ...). A DLL cannot link against the
+ * executable: the port runs renamed copies of it, and thread-locals cannot be
+ * imported at all. So the lifted sources of a DLL are compiled with
+ * -DSPU_VARIANT_DLL, which turns every such name into a macro over an inline
+ * accessor (spu_context.h includes this header before its own declarations):
+ *   - functions and globals read a table (spu_vdll_sym) the DLL fills BY NAME
+ *     from api->syms at registration -- a DLL built from another revision binds
+ *     as long as every name it uses exists, and refuses loudly otherwise. A call
+ *     is one indirect call; a function used as a VALUE is the host's own address
+ *     (g_spu_trampoline_fn = spu_indirect_branch must compare equal to the
+ *     host's spu_indirect_branch in spu_drain_call_full);
+ *   - thread-locals are reached through the host module's implicit-TLS slot the
+ *     way host code itself does (Windows x64: TEB.ThreadLocalStoragePointer
+ *     [_tls_index] + offset; one extra load for the offset), and the DLL checks
+ *     the addresses it computes against api->tls_addr() before registering
+ *     anything. Elsewhere every access calls api->tls_addr (correct, slower).
+ * The DLL glue (tools/spucheck/spu_variant_dll.c) and the generated
+ * spu_variants.c are the only other DLL-side sources.
+ */
+#ifndef SPU_VARIANT_API_H
+#define SPU_VARIANT_API_H
+
+#include <stdint.h>
+#include "../../include/ps3emu/ps3types.h"   /* u128 */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct spu_context;
+
+/* Registered variants (all images, all DLLs). Per context the runtime keeps one
+ * validated and one mismatched bit per variant (spu_context.var_ok / var_bad). */
+#define SPU_VARIANT_MAX 8192
+
+#define SPU_VARIANT_API_VERSION 1
+
+typedef struct spu_variant_desc {
+    uint32_t entry;                       /* LS address dispatch lands on          */
+    uint32_t lo, len;                     /* code extent LS [lo, lo+len)           */
+    uint64_t hash;                        /* spu_code_hash(ls + lo, len)           */
+    void   (*fn)(struct spu_context*);    /* the lifted function                   */
+} spu_variant_desc;
+
+typedef struct spu_variant_sym { const char* name; void* addr; } spu_variant_sym;
+typedef struct spu_variant_tls { const char* name; uint64_t off; } spu_variant_tls;
+
+typedef struct spu_variant_api {
+    uint32_t version;                     /* SPU_VARIANT_API_VERSION               */
+    uint32_t size;                        /* sizeof(spu_variant_api)               */
+    /* Register n variants; returns how many were added (duplicates and malformed
+     * entries are skipped). */
+    int    (*add)(const spu_variant_desc* v, uint32_t n);
+    const spu_variant_sym* syms;          /* runtime functions + globals, by name  */
+    uint32_t n_syms;
+    const spu_variant_tls* tls;           /* host thread-locals: offset in the     */
+    uint32_t n_tls;                       /* module's TLS block (_tls_index)       */
+    uint32_t tls_index;
+    void*  (*tls_addr)(const char* name); /* &thread-local on the calling thread   */
+} spu_variant_api;
+
+/* Exported by a variant DLL. Returns the number of variants registered, or < 0
+ * when it cannot bind to this host (it registers nothing then). */
+#define SPU_VARIANTS_ENTRY "spu_variants_register"
+typedef int (*spu_variants_register_fn)(const spu_variant_api* api);
+
+/* Host side (spu_channels.c). */
+int      spu_variant_add(const spu_variant_desc* v, uint32_t n);
+int      spu_variant_load_dir(const char* dir);          /* -> variants added      */
+uint64_t spu_code_hash(const uint8_t* p, uint32_t len);
+/* The dispatch-miss variant lookup alone (tests / benchmarks): the validated
+ * variant for this context at pc, or NULL. */
+void   (*spu_variant_find(struct spu_context* ctx, uint32_t pc))(struct spu_context*);
+/* Slow-path event counters (tests / SPU_VARIANT_STATS). */
+typedef struct spu_variant_stats {
+    uint64_t validations;   /* full-extent hashes computed                         */
+    uint64_t rejects;       /* ...that did not match                               */
+    uint64_t spot_fails;    /* cached-valid variants whose entry bytes changed     */
+    uint64_t dirty_marks;   /* known code pages a GET rewrote with different bytes */
+    uint64_t consumes;      /* lookups that dropped verdicts for dirty pages        */
+    uint64_t misses;        /* dispatch fallbacks to the interpreter               */
+    uint64_t registered;
+} spu_variant_stats;
+void     spu_variant_get_stats(spu_variant_stats* out);
+
+/* Runtime symbols lifted code can reference -- the DLL import list. X-macro
+ * users must only stringify (#) or paste (##) the argument: in a DLL build the
+ * names themselves are macros. */
+#define SPU_VARIANT_FUNCS(X)                                                    \
+    X(spu_indirect_branch) X(spu_stop) X(spu_halt)                              \
+    X(spu_rdch) X(spu_rchcnt) X(spu_wrch)                                       \
+    X(spu_drain_call_full) X(spu_depth_guard) X(spu_take_interrupt)             \
+    X(spu_hop_slow_init) X(yz_lockstep_tick) X(spu_task_launch_check)           \
+    X(spu_tailret_enabled) X(spu_ch_wake) X(spu_ls_watch_slow)
+#define SPU_VARIANT_DATA(X) X(g_spu_hop_slow) X(g_spu_ls_watch_n)
+#define SPU_VARIANT_TLS(X)                                                      \
+    X(g_spu_trampoline_fn) X(g_spu_pch) X(g_spu_pch_n) X(g_spu_recent) X(g_spu_recent_n)
+
+enum {
+#define SPU_VI_(n) SPU_VI_##n,
+    SPU_VARIANT_FUNCS(SPU_VI_) SPU_VARIANT_DATA(SPU_VI_)
+#undef SPU_VI_
+    SPU_VI_COUNT
+};
+enum {
+#define SPU_VT_(n) SPU_VT_##n,
+    SPU_VARIANT_TLS(SPU_VT_)
+#undef SPU_VT_
+    SPU_VT_COUNT
+};
+
+/* ---- DLL side: runtime names -> accessors over the bound tables ---------- */
+#ifdef SPU_VARIANT_DLL
+#if defined(_MSC_VER) && defined(_M_X64)
+#  include <intrin.h>
+#  define SPU_VDLL_TLS_FAST 1
+#endif
+extern void*     spu_vdll_sym[SPU_VI_COUNT];
+extern uint32_t  spu_vdll_tls_index;
+extern uintptr_t spu_vdll_tls_off[SPU_VT_COUNT];
+#if defined(SPU_VDLL_TLS_FAST)
+#  define SPU_VDLL_TLS(i) ((void*)(((char**)__readgsqword(0x58))[spu_vdll_tls_index] + spu_vdll_tls_off[i]))
+#else
+void* spu_vdll_tls_slow(int i);
+#  define SPU_VDLL_TLS(i) spu_vdll_tls_slow(i)
+#endif
+
+/* `name` becomes (*spu_vdll_f_name()): calls, address-of and later
+ * redeclarations (`void spu_halt(spu_context*);` -> a redeclaration of the
+ * accessor, which keeps its internal linkage) all keep working. */
+#define SPU_VDLL_FN(name, ret, params)                                          \
+    typedef ret (*spu_vdll_t_##name) params;                                    \
+    static inline spu_vdll_t_##name spu_vdll_f_##name(void)                     \
+    { return (spu_vdll_t_##name)spu_vdll_sym[SPU_VI_##name]; }
+typedef void (*spu_vdll_fnp)(struct spu_context*);
+SPU_VDLL_FN(spu_indirect_branch, void, (struct spu_context*))
+SPU_VDLL_FN(spu_stop, void, (struct spu_context*))
+SPU_VDLL_FN(spu_halt, void, (struct spu_context*))
+SPU_VDLL_FN(spu_rdch, u128, (struct spu_context*, uint32_t))
+SPU_VDLL_FN(spu_rchcnt, uint32_t, (struct spu_context*, uint32_t))
+SPU_VDLL_FN(spu_wrch, void, (struct spu_context*, uint32_t, u128))
+SPU_VDLL_FN(spu_drain_call_full, void, (struct spu_context*, uint32_t))
+SPU_VDLL_FN(spu_depth_guard, void, (struct spu_context*))
+SPU_VDLL_FN(spu_take_interrupt, spu_vdll_fnp, (struct spu_context*, spu_vdll_fnp))
+SPU_VDLL_FN(spu_hop_slow_init, void, (void))
+SPU_VDLL_FN(yz_lockstep_tick, void, (struct spu_context*))
+SPU_VDLL_FN(spu_task_launch_check, void, (struct spu_context*, void*))
+SPU_VDLL_FN(spu_tailret_enabled, int, (void))
+SPU_VDLL_FN(spu_ch_wake, void, (struct spu_context*))
+SPU_VDLL_FN(spu_ls_watch_slow, void, (uint32_t, int, const uint8_t*, uint32_t, uint32_t))
+#undef SPU_VDLL_FN
+#define spu_indirect_branch   (*spu_vdll_f_spu_indirect_branch())
+#define spu_stop              (*spu_vdll_f_spu_stop())
+#define spu_halt              (*spu_vdll_f_spu_halt())
+#define spu_rdch              (*spu_vdll_f_spu_rdch())
+#define spu_rchcnt            (*spu_vdll_f_spu_rchcnt())
+#define spu_wrch              (*spu_vdll_f_spu_wrch())
+#define spu_drain_call_full   (*spu_vdll_f_spu_drain_call_full())
+#define spu_depth_guard       (*spu_vdll_f_spu_depth_guard())
+#define spu_take_interrupt    (*spu_vdll_f_spu_take_interrupt())
+#define spu_hop_slow_init     (*spu_vdll_f_spu_hop_slow_init())
+#define yz_lockstep_tick      (*spu_vdll_f_yz_lockstep_tick())
+#define spu_task_launch_check (*spu_vdll_f_spu_task_launch_check())
+#define spu_tailret_enabled   (*spu_vdll_f_spu_tailret_enabled())
+#define spu_ch_wake           (*spu_vdll_f_spu_ch_wake())
+#define spu_ls_watch_slow     (*spu_vdll_f_spu_ls_watch_slow())
+
+/* Globals and thread-locals: `name` becomes (*spu_vdll_v_name()), so the
+ * header's `extern int g_spu_hop_slow;` redeclares the accessor. */
+static inline int* spu_vdll_v_g_spu_hop_slow(void)   { return (int*)spu_vdll_sym[SPU_VI_g_spu_hop_slow]; }
+static inline int* spu_vdll_v_g_spu_ls_watch_n(void) { return (int*)spu_vdll_sym[SPU_VI_g_spu_ls_watch_n]; }
+static inline spu_vdll_fnp* spu_vdll_v_g_spu_trampoline_fn(void)
+{ return (spu_vdll_fnp*)SPU_VDLL_TLS(SPU_VT_g_spu_trampoline_fn); }
+static inline uint32_t (*spu_vdll_v_g_spu_pch(void))[8]
+{ return (uint32_t (*)[8])SPU_VDLL_TLS(SPU_VT_g_spu_pch); }
+static inline unsigned* spu_vdll_v_g_spu_pch_n(void) { return (unsigned*)SPU_VDLL_TLS(SPU_VT_g_spu_pch_n); }
+static inline uint32_t (*spu_vdll_v_g_spu_recent(void))[32]
+{ return (uint32_t (*)[32])SPU_VDLL_TLS(SPU_VT_g_spu_recent); }
+static inline uint32_t* spu_vdll_v_g_spu_recent_n(void) { return (uint32_t*)SPU_VDLL_TLS(SPU_VT_g_spu_recent_n); }
+#define g_spu_hop_slow      (*spu_vdll_v_g_spu_hop_slow())
+#define g_spu_ls_watch_n    (*spu_vdll_v_g_spu_ls_watch_n())
+#define g_spu_trampoline_fn (*spu_vdll_v_g_spu_trampoline_fn())
+#define g_spu_pch           (*spu_vdll_v_g_spu_pch())
+#define g_spu_pch_n         (*spu_vdll_v_g_spu_pch_n())
+#define g_spu_recent        (*spu_vdll_v_g_spu_recent())
+#define g_spu_recent_n      (*spu_vdll_v_g_spu_recent_n())
+#endif /* SPU_VARIANT_DLL */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SPU_VARIANT_API_H */
