--- /dev/null
+++ b/tools/shader_warm/make_keys.py
@@ -0,0 +1,145 @@
+"""make_keys.py OUT.txt DATA_DIR HARVEST_DIR... -- shader warm-up key list v2 from LD_SHADER_HARVEST tours.
+
+Locates every harvested vertex program (big-endian words, verbatim) and fragment program (instruction slots
+verbatim; inline constant slots may differ -- the game patches them) in the game's own files under DATA_DIR,
+and writes LOCATIONS + hashes + variant parameters only (format: rsx_shader_warm in libs/video/rsx_live_draw.c).
+v2: one G line per harvested pipeline (V/P line ordinals + vertex layout + render state, from the harvest's rs=
+field; harvests made before rs= existed give shaders only) -- the warm-up prebuilds those PSOs into the
+PSO library. The output contains no game bytes. Run on the developer's machine; the builder ships OUT.txt.
+"""
+import glob
+import os
+import struct
+import sys
+from collections import OrderedDict
+
+FNV0 = 1469598103934665603
+FNVP = 1099511628211
+M64 = (1 << 64) - 1
+# candidate source files, in search order (relative to DATA_DIR)
+SOURCES = ['FXFILES/E9BD3C19.CHK', '../EBOOT.elf']
+
+
+def fnv(b, h=FNV0):
+    for x in b:
+        h = ((h ^ x) * FNVP) & M64
+    return h
+
+
+def rw(b, o):
+    be = struct.unpack_from('>I', b, o)[0]
+    return ((be << 16) | (be >> 16)) & 0xFFFFFFFF
+
+
+def fp_slots(d):
+    """[(offset, is_instruction)] of a fragment program, through its END instruction."""
+    out, o = [], 0
+    while o + 16 <= len(d):
+        w0, w1, w2, w3 = (rw(d, o + k) for k in (0, 4, 8, 12))
+        out.append((o, True)); o += 16
+        if any((w & 3) == 2 for w in (w1, w2, w3)):
+            out.append((o, False)); o += 16
+        if w0 & 1:
+            break
+    return out
+
+
+def fp_instr_hash(d):
+    h = FNV0
+    for o, ins in fp_slots(d):
+        if ins:
+            h = fnv(d[o:o + 16], h)
+    return h
+
+
+def main():
+    out, data = sys.argv[1], sys.argv[2]
+    dirs = sys.argv[3:]
+    srcs = []
+    for rel in SOURCES:
+        p = os.path.normpath(os.path.join(data, rel))
+        if os.path.exists(p):
+            srcs.append((rel, open(p, 'rb').read()))
+    vps, fps, rows = {}, {}, []
+    for d in dirs:
+        for p in glob.glob(os.path.join(d, 'vp_*.bin')):
+            vps[os.path.basename(p)[3:-4]] = open(p, 'rb').read()
+        for p in glob.glob(os.path.join(d, 'fp_*.bin')):
+            fps[os.path.basename(p)[3:-4]] = open(p, 'rb').read()
+        for line in open(os.path.join(d, 'variants.txt')):
+            rows.append(dict(kv.split('=', 1) for kv in line.split()))
+    vloc, floc, missing = {}, {}, []
+    for k, b in vps.items():
+        for si, (rel, blob) in enumerate(srcs):
+            i = blob.find(b)
+            if i >= 0:
+                vloc[k] = (si, i, len(b), fnv(b)); break
+        else:
+            missing.append('vp_' + k)
+    for k, b in fps.items():
+        slots = fp_slots(b)
+        if not slots:
+            missing.append('fp_' + k); continue
+        size = slots[-1][0] + 16
+        found = None
+        for si, (rel, blob) in enumerate(srcs):
+            s = 0
+            while found is None:
+                i = blob.find(b[:16], s)
+                if i < 0:
+                    break
+                if all(blob[i + o:i + o + 16] == b[o:o + 16] for o, ins in slots if ins):
+                    found = (si, i, size, fp_instr_hash(blob[i:i + size]))
+                s = i + 1
+            if found:
+                break
+        if found:
+            floc[k] = found
+        else:
+            missing.append('fp_' + k)
+    vs, ps, gs = OrderedDict(), OrderedDict(), OrderedDict()
+    for r in rows:
+        if r['vp'] in vloc:
+            for gpf in (1, 0):
+                vs[(vloc[r['vp']], int(r['vpstart']), r['vtex'], r['in'], gpf)] = 1
+        if r['fp'] in floc and r.get('buffered') == '1':
+            sh = bytes.fromhex(r['shadow'])
+            mask, pcf, d16, flt = struct.unpack_from('<4I', sh, 0)
+            zf = sh[16:32].hex()
+            aen, afunc = (int(x) for x in r['alpha'].split(',')[:2])
+            un = r['unnorm'].split(':')
+            unm, dims = un[0], ' '.join(un[1:])   # "u=WxH" pairs -> "u:WxH"
+            dims = ' '.join('%x:%s' % (int(p.split('=')[0]), p.split('=')[1]) for p in un[1:])
+            # keyed by the program's LOCATION: the game patches inline constants, so one program is harvested
+            # under many byte hashes (fp_*.bin) that all locate to the same instruction slots
+            pk = (floc[r['fp']], r['ctrl'], r['cube'], aen, afunc if aen else 0, mask, pcf, d16, flt, zf, unm, dims)
+            ps[pk] = 1
+            # a pipeline: masked layouts only (the warm-up builds masked VS), with a recorded render state
+            if r['vp'] in vloc and r.get('masked') == '1' and 'rs' in r:
+                vk = (vloc[r['vp']], int(r['vpstart']), r['vtex'], r['in'], int(r['gpf']))
+                gs[(vk, pk, r['in'], int(r['packed']), int(r['gpf']), r['rs'])] = 1
+    with open(out, 'w', newline='\n') as f:
+        f.write('# THP8 shader warm-up key list v2 -- locations in the player\'s game files, hashes, PSO variant\n')
+        f.write('# parameters and render state only (no game bytes). Consumer: thp8.exe --warm-shaders <this> <DATA dir> [jobs].\n')
+        f.write('# %d vertex-shader, %d pixel-shader and %d pipeline entries from %d harvested PSO variants\n'
+                % (len(vs), len(ps), len(gs), len(rows)))
+        used = sorted(set(v[0] for v in vloc.values()) | set(v[0] for v in floc.values()))
+        for si in used:   # only sources an entry refers to (EBOOT.elf is not under DATA on a player's install)
+            f.write('S %x %s\n' % (si, srcs[si][0]))
+        for (loc, start, vtex, inm, gpf) in vs:
+            si, off, n, h = loc
+            f.write('V %x %x %x %016x %x %s %s %x\n' % (si, off, n, h, start, vtex, inm, gpf))
+        for (loc, ctrl, cube, aen, afunc, mask, pcf, d16, flt, zf, unm, dims) in ps:
+            si, off, n, h = loc
+            f.write('P %x %x %x %016x %s %s %x %x %x %x %x %x %s %s%s\n'
+                    % (si, off, n, h, ctrl, cube, aen, afunc, mask, pcf, d16, flt, zf, unm, (' ' + dims) if dims else ''))
+        vord = {k: i for i, k in enumerate(vs)}
+        pord = {k: i for i, k in enumerate(ps)}
+        for (vk, pk, inm, packed, gpf, rs) in gs:
+            f.write('G %x %x %s %x %x %s\n' % (vord[vk], pord[pk], inm, packed, gpf, rs))
+    print('%s: %d VS + %d PS + %d pipeline entries; vp located %d/%d, fp located %d/%d; missing %s'
+          % (out, len(vs), len(ps), len(gs), len(vloc), len(vps), len(floc), len(fps), missing[:10]))
+
+
+if __name__ == '__main__':
+    main()
