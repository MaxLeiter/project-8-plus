@@ -0,0 +1,26 @@
+# ps3mod_example -- example plugin DLL for include/ps3mod.h.
+# NOT part of the ps3recomp build (nothing add_subdirectory()s this folder).
+# Build it on its own, with the same toolchain family as the game exe is fine but
+# not required (the ABI is plain C, no CRT objects cross it):
+#
+#   cmake -S examples/ps3mod_example -B build-ps3mod-example -G Ninja ^
+#         -DCMAKE_C_COMPILER=clang-cl -DCMAKE_BUILD_TYPE=Release
+#   cmake --build build-ps3mod-example
+#
+# or with no CMake at all (from the repo root, in a VS dev prompt):
+#   clang-cl /LD /O2 /I include examples\ps3mod_example\example.c /Fe:ps3mod_example.dll
+#
+# Install: copy ps3mod_example.dll (and ps3mod_example.ini if wanted) to
+#   <game exe dir>\mods\plugins\      or   %PS3_MODS_ROOT%\plugins\
+cmake_minimum_required(VERSION 3.20)
+project(ps3mod_example C)
+
+add_library(ps3mod_example SHARED example.c)
+target_include_directories(ps3mod_example PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../../include")
+# ps3mod_example.dll on every toolchain (MinGW would otherwise name it libps3mod_example.dll).
+set_target_properties(ps3mod_example PROPERTIES PREFIX "")
+if(MSVC)
+    target_compile_options(ps3mod_example PRIVATE /W4)
+else()
+    target_compile_options(ps3mod_example PRIVATE -Wall -Wextra)
+endif()
diff --git a/examples/ps3mod_example/example.c b/examples/ps3mod_example/example.c
new file mode 100644
index 00000000..69c84ca7
--- /dev/null
+++ b/examples/ps3mod_example/example.c
@@ -0,0 +1,102 @@
+/*
+ * ps3mod_example -- the smallest useful ps3mod.h plugin (documentation; not
+ * part of the ps3recomp build).
+ *
+ * Wraps the game's main() and logs every entry and return. For THP8
+ * (BLUS30011, PPU-de89165d4428c218f9ade10050ea093f7bde9e8d) main() is the
+ * lifted function at guest 0x0069A11C. Also logs the first presented frame and
+ * the display size, and counts presents until shutdown.
+ *
+ * Install: ps3mod_example.dll (+ optional ps3mod_example.ini) into
+ *          <game exe dir>\mods\plugins\  (or %PS3_MODS_ROOT%\plugins\).
+ * Config (ps3mod_example.ini, or env PS3MOD_PS3MOD_EXAMPLE_<KEY>):
+ *   [hook]
+ *   addr     = 0x0069A11C     function entry to wrap
+ *   ppu_hash = PPU-...        override the required PPU hash (refusal test)
+ * Build: see CMakeLists.txt next to this file.
+ */
+#include "ps3mod.h"
+
+static const ps3mod_host* H;
+static uint32_t           g_addr = 0x0069A11Cu;
+static volatile long      g_presents;
+
+/* WRAP hook: log, run the original (and everything it tail-calls), log r3. */
+static void main_hook(ps3mod_ctx* ctx, const ps3mod_link* next, void* user, uint32_t entry_lr)
+{
+    (void)user;
+    H->log(H, PS3MOD_LOG_INFO, "func_%08X entered: entry_lr=0x%08X r1=0x%08X r3=0x%llX r4=0x%llX thread=%llu",
+           g_addr, entry_lr, (unsigned)ctx->gpr[1], (unsigned long long)ctx->gpr[3],
+           (unsigned long long)ctx->gpr[4], (unsigned long long)ctx->thread_id);
+    H->call_next(ctx, next);
+    H->log(H, PS3MOD_LOG_INFO, "func_%08X returned r3=0x%llX", g_addr, (unsigned long long)ctx->gpr[3]);
+}
+
+static void on_display_ready(const ps3mod_event* ev, void* user)
+{
+    (void)user;
+    H->log(H, PS3MOD_LOG_INFO, "display ready: window %ux%u, backbuffer %ux%u, aspect %.4f",
+           ev->display.window_w, ev->display.window_h,
+           ev->display.backbuffer_w, ev->display.backbuffer_h, (double)ev->display.aspect);
+}
+
+static void on_present(const ps3mod_event* ev, void* user)
+{
+    (void)user;
+    g_presents++;
+    if (ev->count == 1)
+        H->log(H, PS3MOD_LOG_INFO, "first frame presented (vblank %llu)",
+               (unsigned long long)ev->display.vblanks);
+}
+
+static void on_resize(const ps3mod_event* ev, void* user)
+{
+    (void)user;
+    H->log(H, PS3MOD_LOG_INFO, "window resized to %ux%u (aspect %.4f)",
+           ev->display.window_w, ev->display.window_h, (double)ev->display.aspect);
+}
+
+static void fill_info(ps3mod_info* out)
+{
+    out->abi_version       = PS3MOD_ABI_VERSION;
+    out->ctx_layout        = PS3MOD_CTX_LAYOUT;
+    out->lift_abi          = PS3MOD_LIFT_ABI;
+    out->name              = "ps3mod example";
+    out->version           = "1.0";
+    out->author            = "ps3recomp";
+    out->description       = "logs main() entry/return through a wrap hook";
+    out->required_ppu_hash = "PPU-de89165d4428c218f9ade10050ea093f7bde9e8d";   /* THP8 BLUS30011 */
+}
+
+/* Optional: lets the loader reject a wrong game/ABI before init runs. */
+PS3MOD_EXPORT int ps3mod_query(ps3mod_info* out)
+{
+    fill_info(out);
+    return 0;
+}
+
+PS3MOD_EXPORT int ps3mod_init(const ps3mod_host* host, ps3mod_info* out)
+{
+    H = host;
+    fill_info(out);
+    {   /* test knob: a wrong hash here makes the loader refuse the plugin after init */
+        const char* h = host->cfg_str(host, "hook.ppu_hash", 0);
+        if (h && *h) out->required_ppu_hash = h;
+    }
+    g_addr = (uint32_t)host->cfg_int(host, "hook.addr", (int64_t)g_addr);
+    host->log(host, PS3MOD_LOG_INFO, "init: exe %s, %s, hooks %s; wrapping 0x%08X",
+              host->ppu_hash, host->lift_id, host->hooks_available ? "on" : "off", g_addr);
+
+    /* A failed registration is logged by the loader, which then refuses the
+     * whole plugin; returning the error yourself works too. */
+    host->hook_register(host, g_addr, main_hook, 0, PS3MOD_HOOK_WRAP, 0, 0);
+    host->on_event(host, PS3MOD_EV_DISPLAY_READY, on_display_ready, 0);
+    host->on_event(host, PS3MOD_EV_PRESENT, on_present, 0);
+    host->on_event(host, PS3MOD_EV_RESIZE, on_resize, 0);
+    return 0;
+}
+
+PS3MOD_EXPORT void ps3mod_shutdown(void)
+{
+    if (H) H->log(H, PS3MOD_LOG_INFO, "shutdown after %ld presented frames", (long)g_presents);
+}
