+/* ===========================================================================
+ * GPU vertex fetch (PS3_GPU_VFETCH, default on; compact vertex mode only)
+ *
+ * The compact CPU path decodes every referenced vertex, attribute by attribute
+ * and component by component, into float4s on the render thread (~22 % of the
+ * vblank ticker in free skate: rsx_vertex_decode_element / fetch_one / remap /
+ * fetch_batches). Here the CPU only
+ *   - reads the index data once (byte swap, primitive-restart cuts, min/max),
+ *   - copies each attribute's raw guest byte window [first .. last element]
+ *     into the vertex upload ring (interleaved attributes share one window),
+ *   - writes the per-draw fetch descriptors into the vertex constant block,
+ * and the vertex shader (rsx_vp_decompile_gpufetch_ex) decodes the big-endian
+ * RSX formats itself: index -> element (base index, frequency divider modulo /
+ * divide), element -> byte address, then float / half / u8n / u8 / s16n / s16 /
+ * cmp. Divisions come from a LUT the host fills with the very C expressions of
+ * rsx_vertex_decode_element, so the VS sees the same float bits the IA used to.
+ * The guest memory is read at the same point of the FIFO walk as before.
+ *
+ * Draw arrays need no index buffer at all: SV_VertexID is the occurrence and
+ * the VS expands lists / strips / fans / quads itself. Indexed draws put the
+ * guest index values (byte-swapped, topology-expanded exactly like
+ * write_topology_indices) into the index ring; the GPU's post-transform cache
+ * does what rsx_vertex_remap_build did on the CPU.
+ *
+ * Falls back to the compact CPU path for: mixed array + indexed packets, an
+ * index window that wraps the 20-bit element space, a non-contiguous or
+ * unresolvable guest window, a sparse window (an indexed draw touching a few
+ * vertices of a huge shared buffer), RSX_DRAW_CSV / RSX_A010_GEOM diagnostics
+ * (they hash the CPU-decoded vertices), and while PS3_GPU_VFETCH_OFF_FILE
+ * exists (same-scene A/B). PS3_GPU_VFETCH=0: always the CPU path.
+ * =========================================================================*/
+#define VF_WIN_SLACK   16u             /* vf_ld reads up to 7 bytes past an element */
+#define VF_MAX_WIN     17u
+
+typedef struct {
+    u32 attr[16][4];
+    u32 lim[16][4];
+    float def[16][4];
+    u32 draw[4];
+} ld_vf_consts;
+
+typedef struct {
+    int mode;            /* 0 = indexed through the IB, 1..4 = array list/strip/fan/quads */
+    int native_strip;    /* mode 0 strip drawn as a D3D strip (cut value 0xFFFFFFFF) */
+    u32 n_tri, n_occ, ib_bytes, win_bytes, n_win;
+    u32 win_loc[VF_MAX_WIN];
+    u64 win_start[VF_MAX_WIN], win_end[VF_MAX_WIN];   /* guest offsets; inline: stream offsets */
+    const u8* win_src[VF_MAX_WIN];
+    u32 win_ring[VF_MAX_WIN];                         /* offset within this draw's ring bytes */
+    int win_inline[VF_MAX_WIN];
+    s32 attr_win[16];
+    u64 attr_prefix[16];                              /* guest offset of element 0 */
+    ld_vf_consts c;
+} ld_vf_plan;
+
+enum { VF_FB_OFF, VF_FB_MIXED, VF_FB_PRIM, VF_FB_WRAP, VF_FB_SPAN, VF_FB_SPARSE, VF_FB_INLINE,
+       VF_FB_ALLOC, VF_FB_INDEX, VF_FB_VSCOMPILE, VF_FB_COUNT };
+static const char* const k_vf_fb_names[VF_FB_COUNT] = {
+    "off", "mixed", "prim", "wrap", "span", "sparse", "inline", "alloc", "index", "vs-compiling" };
+
+static struct {
+    int init;
+    int enabled;                 /* PS3_GPU_VFETCH (default 1) and prerequisites */
+    const char* off_file;        /* PS3_GPU_VFETCH_OFF_FILE */
+    int off_now;
+    u32 off_frame;
+    /* Indexed triangle strips as native D3D strips (restart -> strip cut)
+     * instead of a CPU strip -> list expansion (write_topology_indices).
+     * PS3_VF_STRIP=0: always expand; PS3_VF_STRIP_OFF_FILE: expand while it exists. */
+    int strip, strip_off_now;
+    const char* strip_off_file;
+    ID3D12Resource* lut;
+    ID3D12Resource* lut_upload;
+    u32* vids; u32 cap_vids;
+    u64 draws_gpu, draws_cpu, fb[VF_FB_COUNT];
+    u64 win_bytes, ib_bytes, occ, strips;
+    u32 stat_frame;
+} g_vf;
+
+static void ld_vf_init(void)
+{
+    g_vf.init = 1;
+    const char* e = getenv("PS3_GPU_VFETCH");
+    g_vf.enabled = !(e && e[0] == '0');
+    g_vf.off_file = getenv("PS3_GPU_VFETCH_OFF_FILE");
+    { const char* st = getenv("PS3_VF_STRIP"); g_vf.strip = !(st && st[0] == '0'); }
+    g_vf.strip_off_file = getenv("PS3_VF_STRIP_OFF_FILE");
+    const char* why = NULL;
+    if (g.vertex_mode != 'C') why = "RSX_VERTEX_MODE is not C";
+    else if (getenv("RSX_DRAW_CSV")) why = "RSX_DRAW_CSV hashes CPU-decoded vertices";
+    else if (getenv("RSX_A010_GEOM")) why = "RSX_A010_GEOM";
+    else if (!g_vf.lut) why = "no LUT";
+    else if (!g.vf_cb_mapped) why = "no descriptor ring";
+    if (g_vf.enabled && why) g_vf.enabled = 0;
+    fprintf(stderr, "[gpu-vfetch] %s%s%s%s\n", g_vf.enabled ? "on" : "off",
+            why ? " (" : "", why ? why : "", why ? ")" : "");
+}
+
+/* Once per frame: PS3_GPU_VFETCH_OFF_FILE poll + the stats line. */
+static int ld_vf_active(void)
+{
+    if (!g_vf.init) ld_vf_init();
+    if (!g_vf.enabled) return 0;
+    if ((g_vf.off_file || g_vf.strip_off_file) && g_vf.off_frame != g_ld_frames + 1u) {
+        g_vf.off_frame = g_ld_frames + 1u;
+        if (g_vf.strip_off_file) {
+            struct stat sst;
+            const int soff = stat(g_vf.strip_off_file, &sst) == 0;
+            if (soff != g_vf.strip_off_now)
+                fprintf(stderr, "[gpu-vfetch] frame %u: strips %s\n", g_ld_frames,
+                        soff ? "expanded on the CPU" : "native");
+            g_vf.strip_off_now = soff;
+        }
+        if (!g_vf.off_file) goto vf_poll_done;
+        struct stat st;
+        const int off = stat(g_vf.off_file, &st) == 0;
+        if (off != g_vf.off_now)
+            fprintf(stderr, "[gpu-vfetch] frame %u: %s (%s)\n", g_ld_frames,
+                    off ? "CPU path" : "GPU path", g_vf.off_file);
+        g_vf.off_now = off;
+    }
+vf_poll_done:
+    if (g_vf.off_now) { g_vf.fb[VF_FB_OFF]++; g_vf.draws_cpu++; return 0; }
+    return 1;
+}
+
+/* Constant-block reuse (PS3_CB_REUSE, default on): see sink_end_impl. In the
+ * free-skate draw stream 75 % of consecutive draws carry the same transform
+ * constants and viewport (work/glitch/run/v1.csv), and each one re-uploaded
+ * 8 KB into the write-combined ring. PS3_CB_REUSE=0: upload every draw (old).
+ * PS3_CB_REUSE_OFF_FILE=<path>: the same while <path> exists (per frame). */
+static struct {
+    int init, enabled, off_now;
+    const char* off_file;
+    u32 off_frame;
+    u64 reused, uploaded;
+} g_ld_cb_reuse;
+
+static int ld_cb_reuse_active(void)
+{
+    if (!g_ld_cb_reuse.init) {
+        g_ld_cb_reuse.init = 1;
+        const char* e = getenv("PS3_CB_REUSE");
+        g_ld_cb_reuse.enabled = !(e && e[0] == '0');
+        g_ld_cb_reuse.off_file = getenv("PS3_CB_REUSE_OFF_FILE");
+        fprintf(stderr, "[cb-reuse] %s\n", g_ld_cb_reuse.enabled ? "on" : "off");
+    }
+    if (!g_ld_cb_reuse.enabled) return 0;
+    if (g_ld_cb_reuse.off_file && g_ld_cb_reuse.off_frame != g_ld_frames + 1u) {
+        g_ld_cb_reuse.off_frame = g_ld_frames + 1u;
+        struct stat st;
+        const int off = stat(g_ld_cb_reuse.off_file, &st) == 0;
+        if (off != g_ld_cb_reuse.off_now)
+            fprintf(stderr, "[cb-reuse] frame %u: %s\n", g_ld_frames, off ? "upload every draw" : "reuse");
+        g_ld_cb_reuse.off_now = off;
+    }
+    return !g_ld_cb_reuse.off_now;
+}
+
+/* async gpufetch VS compile counters (ld_gpf_vs_ready) */
+static u64 g_gpf_submitted, g_gpf_compiled, g_gpf_failed, g_gpf_cache_hits;
+
+static void ld_vf_stats(void)
+{
+    if (!g_vf.init || g_ld_frames < g_vf.stat_frame + 600u) return;
+    const u32 frames = g_ld_frames - g_vf.stat_frame;
+    g_vf.stat_frame = g_ld_frames;
+    if (!frames || !(g_vf.draws_gpu | g_vf.draws_cpu)) return;
+    char fb[256]; int n = 0; fb[0] = 0;
+    for (u32 i = 0; i < VF_FB_COUNT; i++)
+        if (g_vf.fb[i] && n < (int)sizeof(fb) - 32)
+            n += snprintf(fb + n, sizeof(fb) - (size_t)n, " %s=%llu", k_vf_fb_names[i],
+                          (unsigned long long)g_vf.fb[i]);
+    fprintf(stderr, "[gpu-vfetch] frame %u: %u frames, draws gpu %.0f/frame cpu %.1f/frame (%s ), "
+            "windows %.2f MB/frame, indices %.2f MB/frame, %.0f vertex refs/frame, %.1f native strips/frame\n",
+            g_ld_frames, frames, (double)g_vf.draws_gpu / frames, (double)g_vf.draws_cpu / frames,
+            n ? fb : " none", (double)g_vf.win_bytes / frames / 1048576.0,
+            (double)g_vf.ib_bytes / frames / 1048576.0, (double)g_vf.occ / frames,
+            (double)g_vf.strips / frames);
+    if (g_gpf_submitted | g_gpf_cache_hits | g_gpf_failed)
+        fprintf(stderr, "[gpu-vfetch] async VS (total): %llu compiles submitted, %llu done, %llu failed, "
+                "%llu found in the caches\n", (unsigned long long)g_gpf_submitted,
+                (unsigned long long)g_gpf_compiled, (unsigned long long)g_gpf_failed,
+                (unsigned long long)g_gpf_cache_hits);
+    if (g_ld_cb_reuse.reused | g_ld_cb_reuse.uploaded)
+        fprintf(stderr, "[cb-reuse] frame %u: constant blocks per frame: %.1f reused, %.1f uploaded\n",
+                g_ld_frames, (double)g_ld_cb_reuse.reused / frames, (double)g_ld_cb_reuse.uploaded / frames);
+    g_ld_cb_reuse.reused = g_ld_cb_reuse.uploaded = 0;
+    g_vf.draws_gpu = g_vf.draws_cpu = g_vf.win_bytes = g_vf.ib_bytes = g_vf.occ = g_vf.strips = 0;
+    memset(g_vf.fb, 0, sizeof(g_vf.fb));
+}
+
+static int ld_vf_reserve(u32 n)
+{
+    if (n <= g_vf.cap_vids) return 1;
+    u32 cap = g_vf.cap_vids ? g_vf.cap_vids : 65536u;
+    while (cap < n) { if (cap > 0x7FFFFFFFu) return 0; cap *= 2u; }
+    u32* v = (u32*)realloc(g_vf.vids, (size_t)cap * sizeof(u32));
+    if (!v) return 0;
+    g_vf.vids = v; g_vf.cap_vids = cap;
+    return 1;
+}
+
+/* Element range [emin, emax] of one attribute for vertex ids in [vmin, vmax]
+ * (rsx_vertex_element_index). 0 = the range wraps the 20-bit element space. */
+static int ld_vf_elem_range(u32 vmin, u32 vmax, u32 base_index, u32 freq, u32 modulo,
+                            u32* emin, u32* emax)
+{
+    if (freq <= 1) {
+        const u64 lo = (u64)vmin + base_index, hi = (u64)vmax + base_index;
+        if ((lo >> 20) != (hi >> 20)) return 0;
+        *emin = (u32)(lo & 0xFFFFFu); *emax = (u32)(hi & 0xFFFFFu);
+        return 1;
+    }
+    if (!modulo) { *emin = vmin / freq; *emax = vmax / freq; return 1; }
+    if ((u64)vmax - vmin + 1u >= freq) { *emin = 0; *emax = freq - 1u; return 1; }
+    const u32 a = vmin % freq, b = vmax % freq;
+    if (a <= b) { *emin = a; *emax = b; } else { *emin = 0; *emax = freq - 1u; }
+    return 1;
+}
+
+/* Plan one draw. 1 = GPU plan ready; 0 = take the CPU path (fallback reason
+ * counted); -1 = the CPU path would fail the fetch (drop_fetch); -2 = no
+ * triangles (drop_degenerate). */
+/* ---------------------------------------------------------------------------
+ * Asynchronous gpufetch VS compile. A gpufetch vertex shader is new HLSL for
+ * every vertex program, so a cold shader cache compiled ~60 of them
+ * (D3DCompile, 100-300 ms each) on the walker at every first level load --
+ * long enough for the guest's ring wait to give up ("walker stalled ...
+ * going on anyway"). Now: per (VP, vertex-texture mask, input mask) the walker
+ * decompiles once and looks in the memory and disk caches; a miss goes to a
+ * compile worker and every draw of that VS takes the CPU fetch path (its
+ * compact VS is the cached one) until the blob is back. Finished blobs are
+ * drained into the VS blob cache + disk cache on the walker before each draw.
+ * Never a gpufetch D3DCompile on the walker. PS3_GPU_VFETCH_SYNC=1: compile
+ * on the walker as before (A/B).
+ * -----------------------------------------------------------------------*/
+#define GPF_VS_TABLE 8192u
+enum { GPF_VS_NONE = 0, GPF_VS_READY = 1, GPF_VS_PENDING = 2, GPF_VS_FAILED = 3 };
+typedef struct { u64 key; u8 state; } gpf_vs_entry;
+typedef struct gpf_job {
+    struct gpf_job* next;
+    u64 key, hash;
+    char* hlsl;
+    u32 len;
+    ID3DBlob* blob;
+    HRESULT hr;
+} gpf_job;
+static gpf_vs_entry g_gpf_vs[GPF_VS_TABLE];
+static SRWLOCK g_gpf_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE g_gpf_cv = CONDITION_VARIABLE_INIT;
+static gpf_job *g_gpf_todo, *g_gpf_todo_tail, *g_gpf_done;
+static int g_gpf_workers;
+
+static DWORD LD_THREAD_CC gpf_worker(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        AcquireSRWLockExclusive(&g_gpf_lock);
+        while (!g_gpf_todo)
+            SleepConditionVariableSRW(&g_gpf_cv, &g_gpf_lock, INFINITE, 0);
+        gpf_job* j = g_gpf_todo;
+        g_gpf_todo = j->next;
+        if (!g_gpf_todo) g_gpf_todo_tail = NULL;
+        ReleaseSRWLockExclusive(&g_gpf_lock);
+        ID3DBlob* err = NULL;
+        j->hr = D3DCompile(j->hlsl, j->len, "xvs", NULL, NULL, "main", "vs_5_0", 0, 0, &j->blob, &err);
+        if (FAILED(j->hr)) {
+            fprintf(stderr, "[gpu-vfetch] async VS compile failed hr=0x%08lX: %.400s\n", (unsigned long)j->hr,
+                    err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "no diagnostic");
+            if (j->blob) { j->blob->lpVtbl->Release(j->blob); j->blob = NULL; }
+        }
+        if (err) err->lpVtbl->Release(err);
+        AcquireSRWLockExclusive(&g_gpf_lock);
+        j->next = g_gpf_done;
+        g_gpf_done = j;
+        ReleaseSRWLockExclusive(&g_gpf_lock);
+    }
+}
+
+static gpf_vs_entry* gpf_vs_slot(u64 key, int create)
+{
+    u32 h = (u32)ld_fmix64(key) & (GPF_VS_TABLE - 1u);
+    for (u32 n = 0; n < GPF_VS_TABLE; n++) {
+        gpf_vs_entry* e = &g_gpf_vs[h];
+        if (e->state == GPF_VS_NONE) {
+            if (!create) return NULL;
+            e->key = key;
+            return e;
+        }
+        if (e->key == key) return e;
+        h = (h + 1u) & (GPF_VS_TABLE - 1u);
+    }
+    return NULL;
+}
+
+/* Walker: move finished compiles into the caches. */
+static void gpf_drain(void)
+{
+    if (!g_gpf_done) return;                        /* racy peek; next draw sees it */
+    AcquireSRWLockExclusive(&g_gpf_lock);
+    gpf_job* j = g_gpf_done;
+    g_gpf_done = NULL;
+    ReleaseSRWLockExclusive(&g_gpf_lock);
+    while (j) {
+        gpf_job* next = j->next;
+        gpf_vs_entry* e = gpf_vs_slot(j->key, 1);
+        if (j->blob) {
+            shader_disk_cache_store('V', j->hlsl, j->len, j->hash, j->blob);
+            shader_blob_cache_insert_accounted(&g.vs_blobs, j->hlsl, j->len, j->hash, j->blob, 'V', 0);
+            j->blob->lpVtbl->Release(j->blob);
+            if (e) e->state = GPF_VS_READY;
+            g_gpf_compiled++;
+        } else {
+            if (e) e->state = GPF_VS_FAILED;
+            g_gpf_failed++;
+        }
+        free(j->hlsl);
+        free(j);
+        j = next;
+    }
+}
+
+/* 1 = this draw's gpufetch VS is in the blob cache (get_pso will not
+ * compile), 0 = not yet / never: take the CPU fetch path. */
+static int ld_gpf_vs_ready(const rsx_vertex_layout_plan* layout)
+{
+    static int sync = -1;
+    if (sync < 0) sync = getenv("PS3_GPU_VFETCH_SYNC") ? 1 : 0;
+    if (sync) return 1;
+    gpf_drain();
+    const u32 start = rsx_dsp_vp_start(&g.rsx);
+    if (start >= RSX_DSP_VP_INSTR) return 1;        /* get_pso bails anyway */
+    const u8* vp_uc = (const u8*)(g.rsx.vp + start * 4);
+    const u32 vp_instrs = rsx_vp_program_size_instrs(vp_uc, (RSX_DSP_VP_INSTR - start) * 16);
+    if (!vp_instrs) return 1;
+    const u32 vtex_mask = vertex_texture_mask();
+    const u64 key = ld_hash_words(vp_uc, vp_instrs * 16,
+                                  0x47504656u ^ ((u64)vtex_mask << 32) ^ ((u64)layout->mask << 40) ^ start);
+    gpf_vs_entry* e = gpf_vs_slot(key, 1);
+    if (!e) return 1;                               /* table full: old behaviour */
+    if (e->state == GPF_VS_READY) return 1;
+    if (e->state != GPF_VS_NONE) return 0;
+    /* first sight: the exact HLSL get_pso will build */
+    static char hlsl[256 * 1024];
+    rsx_vp_set_branch_base(start);
+    const int vi = rsx_vp_decompile_gpufetch_ex(vp_uc, vp_instrs * 16, vtex_mask, layout->mask,
+                                                hlsl, sizeof(hlsl));
+    if (vi <= 0) { e->state = GPF_VS_FAILED; return 0; }
+    const u32 len = (u32)strlen(hlsl);
+    const u64 hash = fnv1a(hlsl, len, 1469598103934665603ull);
+    ID3DBlob* b = shader_blob_cache_find(&g.vs_blobs, hlsl, len, hash, NULL, NULL);
+    if (!b) {
+        b = ld_disk_load_rt('V', hlsl, len, hash);
+        if (b) shader_blob_cache_insert_accounted(&g.vs_blobs, hlsl, len, hash, b, 'V', 0);
+    }
+    if (b) {
+        b->lpVtbl->Release(b);
+        e->state = GPF_VS_READY;
+        g_gpf_cache_hits++;
+        return 1;
+    }
+    gpf_job* j = (gpf_job*)calloc(1, sizeof(*j));
+    char* copy = j ? (char*)malloc((size_t)len + 1u) : NULL;
+    if (!copy) { free(j); return 1; }               /* no memory: old behaviour */
+    memcpy(copy, hlsl, (size_t)len + 1u);
+    j->key = key; j->hash = hash; j->hlsl = copy; j->len = len;
+    AcquireSRWLockExclusive(&g_gpf_lock);
+    if (g_gpf_todo_tail) g_gpf_todo_tail->next = j; else g_gpf_todo = j;
+    g_gpf_todo_tail = j;
+    while (g_gpf_workers < 2) {
+        HANDLE h = CreateThread(NULL, 0, gpf_worker, NULL, 0, NULL);
+        if (!h) break;
+        CloseHandle(h);
+        g_gpf_workers++;
+    }
+    ReleaseSRWLockExclusive(&g_gpf_lock);
+    WakeConditionVariable(&g_gpf_cv);
+    e->state = GPF_VS_PENDING;
+    g_gpf_submitted++;
+    return 0;
+}
+
+
+/* PS3_VF_SIMD (perf round): the GPU-fetch index read (ld_vf_prepare) for
+ * 16-bit indices, 8 at a time: big-endian -> host, restart compare, min/max,
+ * widen to u32. THP8's strips are short (a cut every ~10 indices), so most
+ * groups of 8 hold a restart value: such a group is compressed with a pshufb
+ * table (the kept lanes, in order), its cut positions pushed in lane order
+ * (n_occ + kept lanes before the cut, as the scalar loop pushes them), and
+ * min/max taken over the kept lanes only (cut lanes forced to 0xFFFF / 0).
+ * The output (indices, cut positions, min, max) is exactly the scalar loop's;
+ * stores of 8 at out + n_occ stay below the caller's reserve (n_occ <= indices
+ * read so far). A restart value above 0xFFFF never matches a 16-bit index.
+ * Returns the new n_occ; *vmin / *vmax updated. -1: cut-list allocation
+ * failed (the caller's fallback). PS3_VF_SIMD=0 / _OFF_FILE: the scalar loop
+ * only; PS3_DRAW_VERIFY compares both on every draw. */
+static ld_switch g_ld_sw_vfsimd = { .name = "VF_SIMD" };
+#if defined(__SSE4_1__)
+static u8 g_ld_idx16_cmp[256][16];   /* keep mask -> pshufb control (kept 16-bit lanes first) */
+static u8 g_ld_idx16_pop[256];
+static int g_ld_idx16_ready;
+#endif
+static void ld_vf_idx16_init(void)
+{
+#if defined(__SSE4_1__)
+    for (u32 m = 0; m < 256; m++) {
+        u32 j = 0;
+        memset(g_ld_idx16_cmp[m], 0x80, 16);
+        for (u32 k = 0; k < 8; k++)
+            if ((m >> k) & 1u) {
+                g_ld_idx16_cmp[m][2u * j] = (u8)(2u * k);
+                g_ld_idx16_cmp[m][2u * j + 1u] = (u8)(2u * k + 1u);
+                j++;
+            }
+        g_ld_idx16_pop[m] = (u8)j;
+    }
+    g_ld_idx16_ready = 1;
+#endif
+}
+static long ld_vf_read_idx16(const u8* src, u32 count, int restart_en, u32 restart_val,
+                             u32* out, u32 n_occ, u32* vmin, u32* vmax, int simd)
+{
+    u32 lo = *vmin, hi = *vmax, i = 0;
+#if defined(__SSE4_1__)
+    if (simd && count >= 8) {
+        const __m128i swap = _mm_setr_epi8(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14);
+        const int r16 = restart_en && restart_val <= 0xFFFFu;   /* else no 16-bit index matches */
+        const __m128i rv = _mm_set1_epi16((short)(r16 ? restart_val : 0u));
+        const __m128i zero = _mm_setzero_si128();
+        __m128i vlo = _mm_set1_epi16(-1), vhi = zero;
+        int any = 0;
+        for (; i + 8 <= count; ) {
+            const __m128i v = _mm_shuffle_epi8(_mm_loadu_si128((const __m128i*)(src + (size_t)i * 2u)), swap);
+            const __m128i eq = r16 ? _mm_cmpeq_epi16(v, rv) : zero;
+            const u32 cut = (u32)_mm_movemask_epi8(_mm_packs_epi16(eq, eq)) & 0xFFu;
+            if (cut && simd > 1 && g_ld_idx16_ready) {
+                /* cuts in this group: compress the kept lanes, cuts in lane order */
+                const u32 keep = ~cut & 0xFFu;
+                for (u32 m = cut; m; m &= m - 1u) {
+                    const u32 k = (u32)__builtin_ctz(m);
+                    if (!rsx_restart_cut_push(&dc.cuts, &dc.n_cuts, &dc.cap_cuts,
+                                              n_occ + g_ld_idx16_pop[keep & ((1u << k) - 1u)])) return -1;
+                }
+                if (keep) {
+                    any = 1;
+                    vlo = _mm_min_epu16(vlo, _mm_or_si128(v, eq));
+                    vhi = _mm_max_epu16(vhi, _mm_andnot_si128(eq, v));
+                    const __m128i c = _mm_shuffle_epi8(v, _mm_loadu_si128((const __m128i*)g_ld_idx16_cmp[keep]));
+                    _mm_storeu_si128((__m128i*)(out + n_occ), _mm_unpacklo_epi16(c, zero));
+                    _mm_storeu_si128((__m128i*)(out + n_occ + 4), _mm_unpackhi_epi16(c, zero));
+                    n_occ += g_ld_idx16_pop[keep];
+                }
+                i += 8;
+                continue;
+            }
+            if (cut) {
+                /* (no table) this group has a cut: scalar for these 8 */
+                for (u32 k = 0; k < 8; k++, i++) {
+                    const u32 x = ((u32)src[i * 2u] << 8) | src[i * 2u + 1u];
+                    if (x == restart_val) {
+                        if (!rsx_restart_cut_push(&dc.cuts, &dc.n_cuts, &dc.cap_cuts, n_occ)) return -1;
+                        continue;
+                    }
+                    out[n_occ++] = x;
+                    lo = x < lo ? x : lo;
+                    hi = x > hi ? x : hi;
+                }
+                continue;
+            }
+            any = 1;
+            vlo = _mm_min_epu16(vlo, v);
+            vhi = _mm_max_epu16(vhi, v);
+            _mm_storeu_si128((__m128i*)(out + n_occ), _mm_unpacklo_epi16(v, zero));
+            _mm_storeu_si128((__m128i*)(out + n_occ + 4), _mm_unpackhi_epi16(v, zero));
+            n_occ += 8; i += 8;
+        }
+        if (any) {
+            const u32 mn = (u32)_mm_extract_epi16(_mm_minpos_epu16(vlo), 0) & 0xFFFFu;
+            const u32 mx = 0xFFFFu - ((u32)_mm_extract_epi16(
+                _mm_minpos_epu16(_mm_xor_si128(vhi, _mm_set1_epi16(-1))), 0) & 0xFFFFu);
+            if (mn < lo) lo = mn;
+            if (mx > hi) hi = mx;
+        }
+    }
+#else
+    (void)simd;
+#endif
+    for (; i < count; i++) {
+        const u32 x = ((u32)src[i * 2u] << 8) | src[i * 2u + 1u];
+        if (restart_en && x == restart_val) {
+            if (!rsx_restart_cut_push(&dc.cuts, &dc.n_cuts, &dc.cap_cuts, n_occ)) return -1;
+            continue;
+        }
+        out[n_occ++] = x;
+        lo = x < lo ? x : lo;
+        hi = x > hi ? x : hi;
+    }
+    *vmin = lo; *vmax = hi;
+    return (long)n_occ;
+}
+
+LD_NOINLINE static int ld_vf_prepare(u32 prim, const rsx_vertex_layout_plan* layout, ld_vf_plan* p)
+{
+    /* A fallback hands dc back exactly as sink_begin left it (the CPU path
+     * appends its own restart cuts). */
+#define VF_FALLBACK(r) do { g_vf.fb[(r)]++; g_vf.draws_cpu++; dc.n_cuts = 0; dc.n_verts = 0; \
+                            dc.n_source_refs = 0; dc.refs_remapped = 0; return 0; } while (0)
+    if (prim != PRIM_TRIANGLES && prim != PRIM_TRIANGLE_STRIP &&
+        prim != PRIM_TRIANGLE_FAN && prim != PRIM_QUADS)
+        VF_FALLBACK(VF_FB_PRIM);
+    if (dc.n_arr && dc.n_idx) VF_FALLBACK(VF_FB_MIXED);
+    if (g_ld_micro) {
+        /* PS3_DRAW_MICRO: the counts, win_inline (a new guest window leaves it
+         * 0) and c (unfetched attributes stay zero); win_loc .. win_ring and
+         * attr_prefix are written before they are read (index < n_win /
+         * attr_win[attr] >= 0), attr_win is set for every attribute below */
+        memset(p, 0, offsetof(ld_vf_plan, win_loc));
+        memset(p->win_inline, 0, sizeof(p->win_inline));
+        memset(&p->c, 0, sizeof(p->c));
+    } else
+    memset(p, 0, sizeof(*p));
+    dc.n_cuts = 0;
+    u32 vmin = 0xFFFFFFFFu, vmax = 0, base_index = 0, n_occ = 0;
+    int use_vids = 0;
+    if (dc.n_idx) {
+        u64 total = 0;
+        for (u32 b = 0; b < dc.n_idx; b++) total += dc.idx[b].count;
+        if (total > 0x3FFFFFFFu || !ld_vf_reserve((u32)total + 8u)) VF_FALLBACK(VF_FB_ALLOC);
+        base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+        rsx_dsp_index_array ia;
+        rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 esz = ia.is_u32 ? 4u : 2u;
+        static int no_restart = -1;
+        if (no_restart < 0) no_restart = getenv("RSX_NO_RESTART") ? 1 : 0;
+        const int restart_en = !no_restart && rsx_dsp_restart_index_enabled(&g.rsx, ia.is_u32);
+        const u32 restart_val = rsx_dsp_restart_index(&g.rsx);
+        u32* out = g_vf.vids;
+        for (u32 b = 0; b < dc.n_idx; b++) {
+            const u32 first = dc.idx[b].first, count = dc.idx[b].count;
+            if (!count) continue;
+            const u64 start = (u64)ia.offset + (u64)first * esz, bytes = (u64)count * esz;
+            if (start + bytes > 0x100000000ull) VF_FALLBACK(VF_FB_INDEX);
+            const u8* src = guest_ptr(ia.location, (u32)start, (u32)bytes);
+            if (!src || guest_ptr(ia.location, (u32)(start + bytes - 1u), 1) != src + bytes - 1u)
+                VF_FALLBACK(VF_FB_INDEX);
+            if (ia.is_u32) {
+                for (u32 i = 0; i < count; i++) {
+                    u32 v; memcpy(&v, src + (size_t)i * 4u, 4);
+                    v = __builtin_bswap32(v);
+                    if (restart_en && v == restart_val) {
+                        if (!rsx_restart_cut_push(&dc.cuts, &dc.n_cuts, &dc.cap_cuts, n_occ))
+                            VF_FALLBACK(VF_FB_ALLOC);
+                        continue;
+                    }
+                    out[n_occ++] = v;
+                    if (v < vmin) vmin = v;
+                    if (v > vmax) vmax = v;
+                }
+            } else {
+                /* 16-bit (PS3_VF_SIMD: 8 at a time, exact) */
+                const int simd = ld_switch_on(&g_ld_sw_vfsimd);
+                const u32 cuts0 = dc.n_cuts, n0 = n_occ, lo0 = vmin, hi0 = vmax;
+                const long r = ld_vf_read_idx16(src, count, restart_en, restart_val, out, n_occ,
+                                                &vmin, &vmax, simd ? 1 + g_ld_micro : 0);
+                if (r < 0) VF_FALLBACK(VF_FB_ALLOC);
+                if (simd && ld_verify_on()) {   /* the scalar result into scratch, compare */
+                    static u32* chk; static u32 chk_cap;
+                    if (chk_cap < count + 8u) { free(chk); chk_cap = count + 64u; chk = (u32*)malloc(chk_cap * 4u); }
+                    const u32 cuts1 = dc.n_cuts;
+                    u32* cuts_save = cuts1 > cuts0 ? (u32*)malloc((cuts1 - cuts0) * 4u) : NULL;
+                    if (cuts_save) memcpy(cuts_save, dc.cuts + cuts0, (cuts1 - cuts0) * 4u);
+                    dc.n_cuts = cuts0;
+                    u32 l2 = lo0, h2 = hi0;
+                    const long r2 = chk ? ld_vf_read_idx16(src, count, restart_en, restart_val, chk, 0, &l2, &h2, 0) : -1;
+                    int ok = r2 >= 0 && (u32)r2 == (u32)r - n0 && l2 == vmin && h2 == vmax &&
+                             memcmp(chk, out + n0, (size_t)r2 * 4u) == 0 && dc.n_cuts == cuts1;
+                    if (ok && cuts_save) {
+                        for (u32 c = cuts0; c < cuts1; c++)
+                            if (dc.cuts[c] + n0 != cuts_save[c - cuts0]) ok = 0;
+                    }
+                    if (cuts_save) { memcpy(dc.cuts + cuts0, cuts_save, (cuts1 - cuts0) * 4u); free(cuts_save); }
+                    dc.n_cuts = cuts1;
+                    ld_verify(ok, "vf simd index read", (u64)r, (u64)r2);
+                }
+                n_occ = (u32)r;
+            }
+        }
+        use_vids = 1;
+        p->mode = 0;
+    } else {
+        if (dc.n_arr == 1) {
+            const u32 first = dc.arr[0].first, count = dc.arr[0].count;
+            if (count && (u64)first + count - 1u > 0xFFFFFFFFull) VF_FALLBACK(VF_FB_WRAP);
+            n_occ = count;
+            vmin = first; vmax = count ? first + count - 1u : first;
+            p->mode = prim == PRIM_TRIANGLES ? 1 : prim == PRIM_TRIANGLE_STRIP ? 2
+                    : prim == PRIM_TRIANGLE_FAN ? 3 : 4;
+            p->c.draw[1] = first;
+        } else {
+            u64 total = 0;
+            for (u32 b = 0; b < dc.n_arr; b++) total += dc.arr[b].count;
+            if (total > 0x3FFFFFFFu || !ld_vf_reserve((u32)total + 8u)) VF_FALLBACK(VF_FB_ALLOC);
+            for (u32 b = 0; b < dc.n_arr; b++)
+                for (u32 i = 0; i < dc.arr[b].count; i++) {
+                    const u32 v = dc.arr[b].first + i;
+                    g_vf.vids[n_occ++] = v;
+                    if (v < vmin) vmin = v;
+                    if (v > vmax) vmax = v;
+                }
+            use_vids = 1;
+            p->mode = 0;
+        }
+    }
+    if (!n_occ) return -1;                         /* CPU path: !n_verts -> drop_fetch */
+    dc.n_source_refs = n_occ;
+    dc.n_verts = n_occ;
+    dc.refs_remapped = 0;
+    p->n_occ = n_occ;
+    /* PS3_DRAW_MICRO: a native-strip candidate only needs to know whether some
+     * segment holds a triangle (its n_tri becomes n_occ + n_cuts below); the
+     * full count walks every segment of every strip draw. */
+    const int vf_simd = ld_switch_on(&g_ld_sw_vfsimd);
+    const int strip_cand = p->mode == 0 && prim == PRIM_TRIANGLE_STRIP && vmax != 0xFFFFFFFFu &&
+                           g_vf.strip && !g_vf.strip_off_now;
+    int has_tri = -1;
+    if (strip_cand && g_ld_micro) {
+        has_tri = 0;
+        for (u32 seg = 0; seg <= dc.n_cuts; seg++) {
+            const u32 b0 = seg ? dc.cuts[seg - 1u] : 0u;
+            const u32 e0 = seg < dc.n_cuts ? dc.cuts[seg] : n_occ;
+            if (e0 > b0 && e0 - b0 >= 3u) { has_tri = 1; break; }
+        }
+    }
+    if (has_tri >= 0 && !ld_verify_on()) p->n_tri = (u32)has_tri;
+    else {
+    p->n_tri = (p->mode == 0 && prim != PRIM_TRIANGLES)
+        ? topology_index_count(prim) : n_occ - n_occ % 3u;
+    if (has_tri >= 0) ld_verify(has_tri == (p->n_tri != 0), "vf strip has a triangle", (u64)has_tri, p->n_tri);
+    }
+    if (p->mode != 0 && prim != PRIM_TRIANGLES)
+        p->n_tri = prim == PRIM_QUADS ? (n_occ / 4u) * 6u : n_occ >= 3 ? (n_occ - 2u) * 3u : 0u;
+    p->c.draw[0] = (u32)p->mode;
+    p->c.draw[2] = base_index;
+    /* Native strip: the index buffer is the guest index list with a cut at
+     * every restart (same triangles, same winding and vertex order as the CPU
+     * expansion). Not when an index value is 0xFFFFFFFF itself (it would read
+     * as a cut) or the strip has no triangle at all (degenerate drop below). */
+    p->native_strip = 0;
+    if (p->mode == 0 && prim == PRIM_TRIANGLE_STRIP && p->n_tri && vmax != 0xFFFFFFFFu &&
+        g_vf.strip && !g_vf.strip_off_now) {
+        p->native_strip = 1;
+        p->n_tri = n_occ + dc.n_cuts;
+    }
+
+    /* Per-attribute windows. */
+    const u32 base_offset = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    const u32 divider_mask = rsx_dsp_reg(&g.rsx, 0x1FC0);
+    u32 inline_stride = 0, inline_verts = 0;
+    if (dc.inl) inline_stride = dc.inl_stride;
+    u64 est = 0;
+    /* PS3_VF_SIMD + PS3_DRAW_MICRO also skip the decode of attributes the
+     * gpufetch VS does not fetch (not in layout->mask): their c.def / c.attr
+     * stay zero (p->c was cleared) instead of holding defaults nothing reads.
+     * (Under MICRO too, so MICRO + CBTRIM off is batch8c's translation.) */
+    const int vf_skip_unused = vf_simd && g_ld_micro;
+    for (u32 attr = 0; attr < 16; attr++) {
+        p->attr_win[attr] = -1;
+        if (vf_skip_unused && !(layout->mask & (1u << attr))) {
+            p->c.lim[attr][0] = 0xFFFFFFFFu;
+            continue;
+        }
+        rsx_dsp_vertex_attr a;
+        rsx_dsp_get_vertex_attr(&g.rsx, attr, &a);
+        float def[4];
+        rsx_dsp_vertex_default(&g.rsx, attr, def);
+        if (attr == 3 && def[0] == 0.0f && def[1] == 0.0f && def[2] == 0.0f && def[3] == 1.0f)
+            def[0] = def[1] = def[2] = 1.0f;
+        memcpy(p->c.def[attr], def, 16);
+        p->c.lim[attr][0] = 0xFFFFFFFFu;
+        if (!(layout->mask & (1u << attr)) || !a.type || !a.size) continue;
+        const u32 elem = rsx_vertex_attrib_size(a.type, a.size);
+        const u32 stride = a.stride ? a.stride : elem;
+        const u32 modulo = (divider_mask >> attr) & 1u;
+        u32 emin, emax;
+        if (!ld_vf_elem_range(vmin, vmax, dc.inl ? 0u : base_index, a.frequency, modulo, &emin, &emax))
+            VF_FALLBACK(VF_FB_WRAP);
+        if (a.frequency >= 2) g_ld_divider_fetches += n_occ;
+        if (dc.inl) {
+            /* rsx_vertex_fetch_plan_prepare's inline rules: one contiguous
+             * stream at the declared stride; an element past its end, or an
+             * attribute that does not fit the stride, takes the default --
+             * and fails the whole draw for ATTR0. */
+            const u32 st = inline_stride ? inline_stride : stride;
+            const u32 off = dc.inl_off[attr];
+            const u32 verts = st ? dc.inl_bytes / st : 0;
+            if (!st || off + elem > st || !verts) {
+                if (attr == 0) return -1;
+                continue;
+            }
+            if (emax > verts - 1u) {
+                if (attr == 0) {
+                    if (a.frequency > 1 && modulo) VF_FALLBACK(VF_FB_INLINE);   /* range is a bound only */
+                    return -1;
+                }
+            }
+            if (!p->n_win) {
+                p->win_inline[0] = 1;
+                p->win_src[0] = dc.inl;
+                p->win_start[0] = 0;
+                p->win_end[0] = dc.inl_bytes;
+                p->win_loc[0] = 0;
+                p->n_win = 1;
+            }
+            p->attr_win[attr] = 0;
+            p->attr_prefix[attr] = off;
+            p->c.attr[attr][1] = st;
+            p->c.lim[attr][0] = verts - 1u;
+            inline_verts = verts;
+        } else {
+            const u64 prefix = (u64)base_offset + a.offset;
+            const u64 start = prefix + (u64)emin * stride;
+            const u64 end = prefix + (u64)emax * stride + elem;
+            if (end > 0x100000000ull) VF_FALLBACK(VF_FB_SPAN);
+            /* merge with a window of the same location it overlaps or touches */
+            u32 w = 0;
+            for (; w < p->n_win; w++)
+                if (p->win_loc[w] == a.location &&
+                    start <= p->win_end[w] + 64u && end + 64u >= p->win_start[w]) {
+                    if (start < p->win_start[w]) p->win_start[w] = start;
+                    if (end > p->win_end[w]) p->win_end[w] = end;
+                    break;
+                }
+            if (w == p->n_win) {
+                if (p->n_win >= VF_MAX_WIN) VF_FALLBACK(VF_FB_SPAN);
+                p->win_loc[w] = a.location;
+                p->win_start[w] = start;
+                p->win_end[w] = end;
+                p->n_win++;
+            }
+            p->attr_win[attr] = (s32)w;
+            p->attr_prefix[attr] = prefix;
+            p->c.attr[attr][1] = stride;
+        }
+        est += (u64)elem;
+        p->c.attr[attr][2] = a.type | (a.size << 4) | (modulo << 8) | 0x200u;
+        p->c.attr[attr][3] = a.frequency;
+    }
+    (void)inline_verts;
+    /* Merging can make two windows overlap; fold until stable. */
+    for (int again = 1; again; ) {
+        again = 0;
+        for (u32 i = 0; i < p->n_win && !again; i++)
+            for (u32 j = i + 1; j < p->n_win && !again; j++) {
+                if (p->win_inline[i] || p->win_inline[j] || p->win_loc[i] != p->win_loc[j]) continue;
+                if (p->win_start[j] > p->win_end[i] + 64u || p->win_end[j] + 64u < p->win_start[i]) continue;
+                if (p->win_start[j] < p->win_start[i]) p->win_start[i] = p->win_start[j];
+                if (p->win_end[j] > p->win_end[i]) p->win_end[i] = p->win_end[j];
+                for (u32 k = 0; k < 16; k++)
+                    if (p->attr_win[k] == (s32)j) p->attr_win[k] = (s32)i;
+                    else if (p->attr_win[k] > (s32)j) p->attr_win[k]--;
+                memmove(&p->win_loc[j], &p->win_loc[j + 1], (p->n_win - j - 1) * sizeof(p->win_loc[0]));
+                memmove(&p->win_start[j], &p->win_start[j + 1], (p->n_win - j - 1) * sizeof(u64));
+                memmove(&p->win_end[j], &p->win_end[j + 1], (p->n_win - j - 1) * sizeof(u64));
+                p->n_win--;
+                again = 1;
+            }
+    }
+    /* Resolve, size and place the windows (4-byte aligned guest start). */
+    u64 total = 0;
+    for (u32 w = 0; w < p->n_win; w++) {
+        if (!p->win_inline[w]) {
+            p->win_start[w] &= ~3ull;
+            const u64 len = p->win_end[w] - p->win_start[w];
+            const u8* src = guest_ptr(p->win_loc[w], (u32)p->win_start[w], (u32)len);
+            if (!src || guest_ptr(p->win_loc[w], (u32)(p->win_end[w] - 1u), 1) != src + len - 1u)
+                VF_FALLBACK(VF_FB_SPAN);
+            p->win_src[w] = src;
+        }
+        p->win_ring[w] = (u32)total;
+        total += ((p->win_end[w] - p->win_start[w] + 15u) & ~15ull) + VF_WIN_SLACK;
+    }
+    if (total > 0x0FFFFFFFu) VF_FALLBACK(VF_FB_SPARSE);
+    if (total > 256u * 1024u && total > 8u * est * n_occ + 4096u) VF_FALLBACK(VF_FB_SPARSE);
+    p->win_bytes = (u32)total;
+    p->ib_bytes = p->mode == 0 ? p->n_tri * 4u : 0u;
