+    "ByteAddressBuffer vf_lut : register(t21);\n"
+    "uint vf_bswap(uint x) { return (x >> 24) | ((x >> 8) & 0xFF00u) | ((x << 8) & 0xFF0000u) | (x << 24); }\n"
+    /* the 4 bytes at byte address a, first byte in bits 0-7 */
+    "uint vf_ld(uint a) {\n"
+    "    uint al = a & ~3u; uint s = (a & 3u) << 3;\n"
+    "    uint lo = vf_data.Load(al);\n"
+    "    if (s == 0u) return lo;\n"
+    "    uint hi = vf_data.Load(al + 4u);\n"
+    "    return (lo >> s) | (hi << (32u - s));\n"
+    "}\n"
+    "float vf_lutf(uint i) { return asfloat(vf_lut.Load(i << 2)); }\n"
+    "uint vf_be16(uint w) { return ((w & 0xFFu) << 8) | ((w >> 8) & 0xFFu); }\n"
+    /* rsx_compact_be_f16: half denormals flush to zero */
+    "float vf_half(uint h) {\n"
