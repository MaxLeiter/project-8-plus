+/* GPU vertex-fetch variant (rsx_live_draw.c PS3_GPU_VFETCH). No input-
+ * assembler inputs: the shader reads SV_VertexID and decodes each attribute in
+ * input_mask (taken verbatim -- the caller prepared exactly those) straight
+ * out of the guest's raw big-endian vertex bytes:
+ *   ByteAddressBuffer vf_data : t20   raw guest bytes (upload ring)
+ *   ByteAddressBuffer vf_lut  : t21   exact normalisation tables, RSX_VF_LUT_*
+ *   VFConst (b2):  uint4 vf_attr[16]  x = byte address of
+ *       element 0 (mod 2^32), y = stride, z = type | size << 4 | modulo << 8 |
+ *       fetch << 9, w = frequency;  uint4 vf_lim[16]  x = last valid element
+ *       (inline streams; else 0xFFFFFFFF);  float4 vf_def[16]  the value of an
+ *       attribute that is not fetched or out of range;  uint4 vf_draw  x = vertex
+ *       id mode (0 = SV_VertexID is the guest index, 1..4 = first + occurrence
+ *       of a list / strip / fan / quad list expanded to triangles), y = first,
+ *       z = base index.
+ * Decoding matches rsx_vertex_decode_element bit for bit (the divisions come
+ * from the LUT, which the host fills with the same C expressions). */
+int rsx_vp_decompile_gpufetch_ex(
+    const u8* ucode, u32 max_bytes, u32 vtex_mask, u32 input_mask,
+    char* out, u32 out_size);
+
+/* Float offsets of the vf_lut tables. */
+#define RSX_VF_LUT_U8     0u        /* 256:   u8 / 255.0f                   */
+#define RSX_VF_LUT_S16    256u      /* 65536: (s16)u16 / 32767.0f            */
+#define RSX_VF_LUT_CMP11  65792u    /* 2048:  signed 11-bit / 1023.0f        */
+#define RSX_VF_LUT_CMP10  67840u    /* 1024:  signed 10-bit / 511.0f         */
+#define RSX_VF_LUT_COUNT  68864u
+
 /* Mnemonics for the vector / scalar opcode fields ("?" if unknown). */
