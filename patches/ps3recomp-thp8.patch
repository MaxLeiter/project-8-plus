new file mode 100644
index 00000000..874b335b
--- /dev/null
+++ b/web/host/screen.js
@@ -0,0 +1,68 @@
+// screen.js -- classify a THP8 frame by its pixels (port of thp8-native tools/harness/screen.py classify(), same
+// thresholds and sample grids). Input: RGBA bytes of the presented frame at 1280x720 (other sizes are sampled
+// through scaled coordinates). Labels: black, menu N (0 CAREER, 1 2PLAYER, 2 FREESKATE, ...), loading, legal,
+// press_start, menu_intro, title, skater_select K, freeskate_ready K (0 READY / 1 REMAP TRICKS), panel K, other.
+const W = 1280, H = 720;
+const MENU_XS = [145, 325, 535, 743, 948, 1142];
+
+export function classify(rgba, w, h) {
+  const sx = w / W, sy = h / H;
+  const px = (x, y) => { const i = (Math.min(h - 1, Math.floor(y * sy)) * w + Math.min(w - 1, Math.floor(x * sx))) * 4; return [rgba[i], rgba[i + 1], rgba[i + 2]]; };
+  const red = (p) => p[0] > 100 && p[1] < 85 && p[2] < 95 && p[0] - p[1] > 50;
+  const light = (p) => Math.min(p[0], p[1], p[2]) > 140 && Math.max(p[0], p[1], p[2]) - Math.min(p[0], p[1], p[2]) < 45;
+  const white = (p) => Math.min(p[0], p[1], p[2]) > 190;
+  const black = (p) => p[0] + p[1] + p[2] < 40;
+  const blue = (p) => p[2] > p[0] + 30;
+  const frac = (x0, y0, x1, y1, pred, stx = 8, sty = 6) => {
+    let n = 0, k = 0;
+    for (let y = y0; y < y1; y += sty) for (let x = x0; x < x1; x += stx) { n++; if (pred(px(x, y))) k++; }
+    return k / (n || 1);
+  };
+  // mean brightness (screen.py: 32x18 thumbnail)
+  let sum = 0, cnt = 0;
+  for (let y = 10; y < H; y += 40) for (let x = 20; x < W; x += 40) { const p = px(x, y); sum += p[0] + p[1] + p[2]; cnt++; }
+  const mean = sum / (3 * cnt);
+  if (mean < 6) return "black";
+  // main-menu bar
+  { const sel = []; let bl = 0;
+    MENU_XS.forEach((x, i) => {
+      let r = 0, b = 0, n = 0;
+      for (let dx = -40; dx <= 40; dx += 8) for (let y = 190; y < 226; y += 4) { const p = px(x + dx, y); r += p[0]; b += p[2]; n++; }
+      r /= n; b /= n;
+      if (r > 140 && r > b + 20) sel.push(i); else if (b > r + 30) bl++;
+    });
+    let line = 0; for (let x = 20; x < 1260; x += 40) { const p = px(x, 181); if (p[0] > p[2] + 40) line++; }
+    if (sel.length === 1 && bl >= 4 && line >= 28) return "menu " + sel[0]; }
+  const redRows = (x0, x1, y0, y1, minlen = 24, gap = 10) => {
+    const runs = []; let start = null, last = null;
+    for (let y = y0; y < y1; y++) {
+      let n = 0, k = 0; for (let x = x0; x < x1; x += 8) { n++; if (red(px(x, y))) k++; }
+      if (k >= n * 0.4) {
+        if (start === null || y - last > gap) { if (start !== null && last - start + 1 >= minlen) runs.push((start + last) >> 1); start = y; }
+        last = y;
+      }
+    }
+    if (start !== null && last - start + 1 >= minlen) runs.push((start + last) >> 1);
+    return runs;
+  };
+  const band = frac(20, 250, 230, 432, red);
+  if (band > 0.85) {
+    if (frac(250, 250, 450, 432, red) < 0.80) return "loading";
+    if (frac(80, 560, 1200, 640, white, 2, 2) > 0.05) return "legal";
+    if (frac(485, 646, 775, 668, white, 2, 2) > 0.15) return "press_start";
+    if (frac(0, 692, 1280, 718, black, 10, 5) > 0.80) return "menu_intro";
+    return "title";
+  }
+  if (frac(0, 692, 1280, 718, black, 10, 5) > 0.80) {
+    const lst = frac(150, 300, 440, 560, light);
+    const rows = redRows(120, 440, 150, 620);
+    if (lst > 0.5 && rows.length) { const c = rows[0]; return "skater_select " + (c < 232 ? 0 : 1 + Math.round((c - 278) / 45.3)); }
+    const sky = frac(700, 300, 1240, 600, blue);
+    if (sky > 0.85 && rows.length && rows[0] < 420) {
+      const k = Math.max(0, Math.round((rows[0] - 184) / 45.0));
+      if (frac(150, 262, 440, 340, blue) > 0.8 && k <= 1) return "freeskate_ready " + k;
+      return "panel " + k;
+    }
+  }
+  return "other";
+}
diff --git a/web/host/vfs-client.js b/web/host/vfs-client.js
new file mode 100644
index 00000000..8a9544d0
--- /dev/null
+++ b/web/host/vfs-client.js
@@ -0,0 +1,59 @@
+// vfs-client.js -- the blocking side of the IO worker protocol (io-worker.js), for code running on a worker
+// thread (wasm pthreads, tests). Every call blocks the calling thread with Atomics.wait until the IO worker answers.
+// The port calls these from its WasmFS JS backend; tests call them directly.
+import { SLOTS, SLOT_I32, NAME_BYTES, OP } from "./vfs-proto.js";
+
+export class VfsClient {
+  constructor(ctlSab, namesSab) { this.ctl = new Int32Array(ctlSab); this.names = new Uint8Array(namesSab); this.enc = new TextEncoder(); }
+  claim() {
+    for (;;) {
+      for (let s = 0; s < SLOTS; s++) {
+        const b = 1 + s * SLOT_I32;
+        if (Atomics.compareExchange(this.ctl, b, 0, 1) === 0) return [s, b];
+      }
+      Atomics.wait(this.ctl, 0, Atomics.load(this.ctl, 0), 1);     // all busy: back off briefly
+    }
+  }
+  call(s, b) {
+    Atomics.store(this.ctl, b, 2);
+    Atomics.add(this.ctl, 0, 1); Atomics.notify(this.ctl, 0);      // doorbell
+    while (Atomics.load(this.ctl, b) !== 3) Atomics.wait(this.ctl, b, Atomics.load(this.ctl, b), 1000);
+    const r = this.ctl[b + 7];
+    return r;
+  }
+  release(b) { Atomics.store(this.ctl, b, 0); }
+  open(path) {
+    const [s, b] = this.claim();
+    const bytes = this.enc.encode(path);
+    if (bytes.length > NAME_BYTES) { this.release(b); return { fd: -36 }; }
+    this.names.set(bytes, s * NAME_BYTES);
+    this.ctl[b + 1] = OP.OPEN; this.ctl[b + 5] = bytes.length;
+    const r = this.call(s, b);
+    const size = (this.ctl[b + 8] >>> 0) + (this.ctl[b + 9] >>> 0) * 0x100000000;
+    this.release(b);
+    return { fd: r, size };
+  }
+  read(fd, off, len, dst) {
+    const [s, b] = this.claim();
+    const c = this.ctl;
+    c[b + 1] = OP.READ; c[b + 2] = fd; c[b + 3] = off % 0x100000000 | 0; c[b + 4] = Math.floor(off / 0x100000000);
+    c[b + 5] = len; c[b + 6] = dst;
+    const r = this.call(s, b);
+    this.release(b);
+    return r;
+  }
+  prefetch(fd, off, len) {
+    const [s, b] = this.claim();
+    const c = this.ctl;
+    c[b + 1] = OP.PREFETCH; c[b + 2] = fd; c[b + 3] = off % 0x100000000 | 0; c[b + 4] = Math.floor(off / 0x100000000); c[b + 5] = len;
+    this.call(s, b); this.release(b);
+  }
+  stats() {
+    const [s, b] = this.claim();
+    this.ctl[b + 1] = OP.STATS; this.call(s, b);
+    const v = Array.from(this.ctl.subarray(b + 8, b + 14));
+    this.release(b);
+    return { reads: v[0], hits: v[1], missChunks: v[2], fetches: v[3], fetchedKiB: v[4], errors: v[5] };
+  }
+}
+export { CTL_BYTES, NAMES_BYTES } from "./vfs-proto.js";
