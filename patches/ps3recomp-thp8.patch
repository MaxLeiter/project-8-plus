+    if (s->fmt != DXGI_FORMAT_R8G8B8A8_UNORM && s->fmt != DXGI_FORMAT_R16G16B16A16_FLOAT)
+        return SRV_SURFACE_BASE + sidx;
+    const u32 slot = SRV_ZVIEW_UNIT_BASE + unit;
+    if (g_ld_unit_surf_key[unit].tex == s->tex && g_ld_unit_surf_key[unit].remap == remap)
+        return slot;                 /* this unit's slot already holds exactly this view */
+    static const u32 sel2d3d[4] = { 3, 0, 1, 2 };     /* ARGB select -> RGBA memory component */
+    static const u32 out2comp[4] = { 1, 2, 3, 0 };    /* D3D RGBA output -> ARGB index */
+    u32 mapping[4];
+    for (u32 out = 0; out < 4; out++) {
+        const u32 comp = out2comp[out];
+        const u32 op = (remap >> (8 + comp * 2)) & 3;
+        const u32 sel = (remap >> (comp * 2)) & 3;
+        mapping[out] = op == 0 ? D3D12_SHADER_COMPONENT_MAPPING_FORCE_VALUE_0
+                     : op == 1 ? D3D12_SHADER_COMPONENT_MAPPING_FORCE_VALUE_1
+                               : sel2d3d[sel];
+    }
+    D3D12_SHADER_RESOURCE_VIEW_DESC sd = {0};
+    sd.Format = s->fmt;
+    sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sd.Shader4ComponentMapping = D3D12_ENCODE_SHADER_4_COMPONENT_MAPPING(
+        mapping[0], mapping[1], mapping[2], mapping[3]);
+    sd.Texture2D.MipLevels = 1;
+    g.dev->lpVtbl->CreateShaderResourceView(g.dev, s->tex, &sd, srv_cpu(slot));
+    g_ld_unit_surf_key[unit].tex = s->tex;
+    g_ld_unit_surf_key[unit].remap = remap;
+    { static u32 said = 0;
+      if (said < 16 && ++said)
+          fprintf(stderr, "[surf-remap] unit %u surface %u:0x%X %ux%u sampled as fmt 0x%02X remap 0x%04X"
+                  " -> view mapping %u%u%u%u\n", unit, s->location, s->offset, s->w, s->h,
+                  tex_format, remap, mapping[0], mapping[1], mapping[2], mapping[3]); }
+    return slot;
+}
