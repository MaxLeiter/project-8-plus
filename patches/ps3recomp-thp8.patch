diff --git a/runtime/platform/ps3_tls.h b/runtime/platform/ps3_tls.h
new file mode 100644
index 00000000..d40006bc
--- /dev/null
+++ b/runtime/platform/ps3_tls.h
@@ -0,0 +1,25 @@
+/*
+ * ps3_tls.h -- the ONE spelling of implicit thread-local storage for the runtime and libs.
+ *
+ *   PS3_TLS int x;          // one x per host thread
+ *
+ * Do NOT write  #ifdef _WIN32 / __declspec(thread)  at a declaration. clang targeting MinGW (zig cc -target
+ * x86_64-windows-gnu, the builder's toolchain) parses __declspec but has no "thread" attribute: it prints
+ * "unknown attribute 'thread' ignored" and the variable silently becomes a plain GLOBAL shared by every thread.
+ * That broke sys_ppu_thread_exit's per-thread jmp_buf (every guest thread overwrote the same buffer; the first exit
+ * then longjmp'ed into another thread's frame -> fast-fail 0xC0000409, reported by MSYS bash as rc=127), the SPURS job
+ * mailboxes, the sysutil completion drain guard and the sub-ms sleep timer handle. Only MSVC and clang-cl
+ * (_MSC_VER) take __declspec(thread); everything else (GCC, clang for MinGW or POSIX) takes GNU __thread.
+ * The runtime build also passes -Werror=unknown-attributes (packaging/build_runtime_release.sh) so this cannot
+ * come back unnoticed.
+ */
+#ifndef PS3_TLS_H
+#define PS3_TLS_H
+
+#if defined(_MSC_VER)
+#  define PS3_TLS __declspec(thread)
+#else
+#  define PS3_TLS __thread
+#endif
+
+#endif /* PS3_TLS_H */
diff --git a/runtime/platform/ps3_wasm.h b/runtime/platform/ps3_wasm.h
new file mode 100644
index 00000000..2b0602b5
--- /dev/null
+++ b/runtime/platform/ps3_wasm.h
@@ -0,0 +1,23 @@
+/*
+ * ps3recomp - WebAssembly-wide shims (PS3_WASM builds). Included by vm_ready.h and win32_compat.h, so every
+ * runtime unit that can meet these sees them first. Empty everywhere else.
+ */
+#ifndef PS3RECOMP_PS3_WASM_H
+#define PS3RECOMP_PS3_WASM_H
+#ifdef PS3_WASM
+/* No return addresses on wasm: emscripten can only produce them with its offset converter (slow, large), and
+ * aborts without it. Every user in the runtime is a diagnostic argument (watches, null reports, profilers). */
+#define __builtin_return_address(n) ((void*)0)
+
+/* Thread stacks: the runtime asks for 256 MB host stacks (Windows reserves them lazily). On wasm a pthread stack is
+ * a real allocation from the 1 GiB host region and only holds the shadow stack (address-taken locals); the call
+ * frames themselves live on the engine's stack. Every request is capped. */
+#include <pthread.h>
+#ifndef PS3_WASM_MAX_THREAD_STACK
+#define PS3_WASM_MAX_THREAD_STACK (8u << 20)
+#endif
+static inline int ps3_wasm_setstacksize(pthread_attr_t* a, size_t s)
+{ return pthread_attr_setstacksize(a, s > PS3_WASM_MAX_THREAD_STACK ? (size_t)PS3_WASM_MAX_THREAD_STACK : s); }
+#define pthread_attr_setstacksize ps3_wasm_setstacksize
+#endif
+#endif
diff --git a/runtime/platform/ps3_wasm_llwake.c b/runtime/platform/ps3_wasm_llwake.c
new file mode 100644
index 00000000..4346ed49
--- /dev/null
+++ b/runtime/platform/ps3_wasm_llwake.c
@@ -0,0 +1,214 @@
+/*
+ * ps3recomp - lock-line waits that wake on the event, on WebAssembly. See ps3_wasm_llwake.h.
+ */
+#if defined(__EMSCRIPTEN__)
+#include "ps3_wasm_llwake.h"
+#include "../../libs/video/frame_trace.h"   /* PS3_SPIKE_MS: wait timeouts per frame */
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#include <errno.h>
+#include <limits.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define LLW_SEQ __ATOMIC_SEQ_CST
+
+volatile long long g_llw_stat[LLW_NSTAT];
+__thread int t_llw_yield_site;
+volatile long long g_llw_ysite[LLW_Y_NSITE][2];
+
+static int s_on = -1;
+static unsigned s_spin = 1024, s_ms = 8;
+
+static void llw_init(void)
+{
+    const char* e = getenv("PS3_WASM_LLWAKE");
+    int on = !(e && *e == '0');
+    if ((e = getenv("PS3_WASM_LLWAKE_SPIN")) && atoi(e) >= 0) s_spin = (unsigned)atoi(e);
+    if ((e = getenv("PS3_WASM_LLWAKE_MS")) && atoi(e) > 0) s_ms = (unsigned)atoi(e);
+    if (__atomic_exchange_n(&s_on, on, LLW_SEQ) < 0)
+        fprintf(stderr, "[wasm-wait] lock-line event wakes %s (PS3_WASM_LLWAKE=%d, spin %u, safety %u ms)\n",
+                on ? "ON" : "OFF", on, s_spin, s_ms);
+}
+int ps3_llwake_on(void)
+{
+    int v = __atomic_load_n(&s_on, __ATOMIC_RELAXED);
+    if (__builtin_expect(v < 0, 0)) { llw_init(); v = s_on; }
+    return v;
+}
+unsigned ps3_llwake_ms(void) { ps3_llwake_on(); return s_ms; }
+
+double ps3_llw_now_us(void) { return emscripten_get_now() * 1000.0; }
+
+/* ---- futex mutex (Drepper mutex2) ---------------------------------------------------------------------------- */
+void ps3_llw_mutex_lock(int* w)
+{
+    int c = 0;
+    if (__atomic_compare_exchange_n(w, &c, 1, 0, LLW_SEQ, LLW_SEQ)) return;
+    /* short spin: the lock-line critical sections are a few hundred ns (one 128-byte line + its notify) */
+    for (unsigned i = 0; i < s_spin; i++) {
+        c = __atomic_load_n(w, __ATOMIC_RELAXED);
+        if (c == 0) {
+            if (__atomic_compare_exchange_n(w, &c, 1, 0, LLW_SEQ, LLW_SEQ)) return;
+        }
+    }
+    ps3_llw_stat_add(LLW_LL_SLOW, 1);
+    if (emscripten_is_main_browser_thread()) {          /* never block the page's thread: plain spin there */
+        for (;;) {
+            c = 0;
+            if (__atomic_load_n(w, __ATOMIC_RELAXED) == 0 && __atomic_compare_exchange_n(w, &c, 1, 0, LLW_SEQ, LLW_SEQ))
+                return;
+        }
+    }
+    if (c != 2) c = __atomic_exchange_n(w, 2, LLW_SEQ);
+    while (c != 0) {
+        const double t0 = ps3_llw_now_us();
+        /* the main browser thread may not Atomics.wait; emscripten_futex_wait busy-waits there */
+        emscripten_futex_wait(w, 2, 100.0);     /* 100 ms: never needed (the unlock wakes), just bounded */
+        ps3_llw_stat_add(LLW_LL_SLEEP, 1);
+        ps3_llw_stat_add(LLW_LL_SLEEP_US, (long long)(ps3_llw_now_us() - t0));
+        c = __atomic_exchange_n(w, 2, LLW_SEQ);
+    }
+}
+void ps3_llw_mutex_unlock(int* w)
+{
+    if (__atomic_exchange_n(w, 0, LLW_SEQ) == 2) emscripten_futex_wake(w, 1);
+}
+
+/* ---- line events ---------------------------------------------------------------------------------------------- */
+#define LLW_BITS 10
+typedef struct { uint32_t seq; uint32_t waiters; uint32_t pad[14]; } llw_bucket;   /* 64 B: own cache line */
+static llw_bucket s_b[1u << LLW_BITS] __attribute__((aligned(64)));
+static inline llw_bucket* llw_b(uint32_t line) { return &s_b[((line >> 7) * 2654435761u) >> (32 - LLW_BITS)]; }
+
+void ps3_llw_line_event(uint32_t line)
+{
+    llw_bucket* b = llw_b(line);
+    __atomic_fetch_add(&b->seq, 1, LLW_SEQ);
+    if (__atomic_load_n(&b->waiters, LLW_SEQ)) {
+        emscripten_futex_wake(&b->seq, INT_MAX);
+        ps3_llw_stat_add(LLW_EV_WAKE, 1);
+    }
+    ps3_llw_stat_add(LLW_EV, 1);
+}
+uint32_t ps3_llw_wait_begin(uint32_t line)
+{
+    llw_bucket* b = llw_b(line);
+    __atomic_fetch_add(&b->waiters, 1, LLW_SEQ);
+    return __atomic_load_n(&b->seq, LLW_SEQ);
+}
+void ps3_llw_wait_cancel(uint32_t line)
+{
+    __atomic_fetch_sub(&llw_b(line)->waiters, 1, LLW_SEQ);
+}
+int ps3_llw_wait_end(uint32_t line, uint32_t snap, double timeout_ms)
+{
+    llw_bucket* b = llw_b(line);
+    int tmo = 0;
+    if (emscripten_is_main_browser_thread()) {          /* never block the page's thread: poll the counter */
+        const double end = emscripten_get_now() + timeout_ms;
+        while (__atomic_load_n(&b->seq, LLW_SEQ) == snap && !(tmo = emscripten_get_now() >= end)) {}
+    } else if (__atomic_load_n(&b->seq, LLW_SEQ) == snap) {
+        const int r = emscripten_futex_wait(&b->seq, snap, timeout_ms);
+        /* Woken with the counter still at `snap`: a writer bumped the counter BEFORE this wait's begin read it,
+         * and its notify (issued after the bump) found this waiter already queued -- the wake belongs to an event
+         * the caller has already seen through its re-check. Benign; the caller re-checks and waits again. */
+        if (__atomic_load_n(&b->seq, LLW_SEQ) == snap) {
+            tmo = r == -ETIMEDOUT;
+            ps3_llw_stat_add(tmo ? LLW_W_TMO : LLW_W_SPUR, 1);
+            if (tmo) FT_ADD(FT_W_TMO, 1);   /* PS3_SPIKE_MS */
+        }
+    }
+    __atomic_fetch_sub(&b->waiters, 1, LLW_SEQ);
+    return !tmo;
+}
+
+/* ---- stats ---------------------------------------------------------------------------------------------------- */
+void ps3_llw_stats_line(double secs)
+{
+    long long v[LLW_NSTAT];
+    for (int i = 0; i < LLW_NSTAT; i++) v[i] = __atomic_exchange_n(&g_llw_stat[i], 0, __ATOMIC_RELAXED);
+    if (secs <= 0) secs = 1;
+    {   static const char* const nm[LLW_Y_NSITE] = { "other(Sleep0/SwitchToThread shims, ...)", "ppu-thread-yield", "cellSync-spin", "unused", "spu-park" };
+        char b[400]; int p = snprintf(b, sizeof b, "[wasm-wait] sched_yield by site:");
+        for (int s = 0; s < LLW_Y_NSITE; s++) {
+            const long long n = __atomic_exchange_n(&g_llw_ysite[s][0], 0, __ATOMIC_RELAXED);
+            const long long us = __atomic_exchange_n(&g_llw_ysite[s][1], 0, __ATOMIC_RELAXED);
+            if (n) p += snprintf(b + p, sizeof b - p, " %s %.0f/s %.1f ms/s |", nm[s], n / secs, us / 1000.0 / secs);
+        }
+        fprintf(stderr, "%s\n", b);
+    }
+    fprintf(stderr, "[wasm-wait] llwake %s | lockline slow %.0f/s sleeps %.0f/s %.1f ms/s | line events %.0f/s wakes %.0f/s"
+                    " | sync-mutex waits %.0f/s woken %.0f timeout %.0f late %.0f %.1f ms/s"
+                    " | park-fallback %.0f/s woken %.0f late %.0f %.1f ms/s | sched_yield %.0f/s %.1f ms/s"
+                    " | llar-park %.0f/s woken %.0f avg %.0f us %.1f ms/s | event waits unchanged: timeout %.0f/s spurious %.0f/s\n",
+            ps3_llwake_on() ? "ON" : "OFF",
+            v[LLW_LL_SLOW] / secs, v[LLW_LL_SLEEP] / secs, v[LLW_LL_SLEEP_US] / 1000.0 / secs,
+            v[LLW_EV] / secs, v[LLW_EV_WAKE] / secs,
+            v[LLW_SYNC_WAIT] / secs, v[LLW_SYNC_WOKEN] / secs, v[LLW_SYNC_TMO] / secs, v[LLW_SYNC_LATE] / secs,
+            v[LLW_SYNC_US] / 1000.0 / secs,
+            v[LLW_FB_WAIT] / secs, v[LLW_FB_WOKEN] / secs, v[LLW_FB_LATE] / secs, v[LLW_FB_US] / 1000.0 / secs,
+            v[LLW_YIELD] / secs, v[LLW_YIELD_US] / 1000.0 / secs,
+            v[LLW_RP] / secs, v[LLW_RP_WOKEN] / secs, v[LLW_RP] ? (double)v[LLW_RP_US] / v[LLW_RP] : 0.0,
+            v[LLW_RP_US] / 1000.0 / secs, v[LLW_W_TMO] / secs, v[LLW_W_SPUR] / secs);
+}
+
+/* ---- latency histograms (PS3_WASM_LAT=1, wasm-perf 2026-10-15) ------------------------------------------------
+ * Where does a guest thread lose time to the browser's scheduling? Per site, a log-spaced histogram of milliseconds:
+ * sleep overshoot (actual - requested, by requested size), wake latency (signal -> waiter running again) of event
+ * queues and condition variables, and SPU job batch durations. One "[wasm-wait] lat ..." line per site every 5 s
+ * (n/s, p50, p90, p99, max), read-and-cleared; the page's measure context keeps "[wasm-wait]" lines. Off: one load. */
+static const char* const k_lat_name[PS3_LAT_NSITE] = { "sleep<0.1ms", "sleep<1ms", "sleep<4ms", "sleep>=4ms",
+    "evq-wake", "cond-wake", "sema-wake", "job-batch", "evq-block" };
+static const double k_lat_edge[PS3_LAT_NB - 1] = { 0.025, 0.05, 0.1, 0.2, 0.5, 1, 2, 4, 8, 16, 32 };   /* ms */
+volatile long long g_lat_hist[PS3_LAT_NSITE][PS3_LAT_NB];
+static volatile long long s_lat_max_us[PS3_LAT_NSITE];
+int g_lat_on = -1;
+static long long s_lat_t0_us;
+int ps3_lat_init(void)
+{
+    const char* e = getenv("PS3_WASM_LAT");
+    const int on = e && *e == '1';
+    if (__atomic_exchange_n(&g_lat_on, on, LLW_SEQ) < 0 && on)
+        fprintf(stderr, "[wasm-wait] latency histograms on (PS3_WASM_LAT=1): sleep overshoot, evq/cond wake, job batches\n");
+    s_lat_t0_us = (long long)(emscripten_get_now() * 1000.0);
+    return on;
+}
+double ps3_lat_now(void) { return emscripten_get_now(); }
+static double lat_pct(const long long* h, long long n, double q)
+{
+    long long want = (long long)(q * (double)n + 0.5), acc = 0;
+    if (want < 1) want = 1;
+    for (int b = 0; b < PS3_LAT_NB; b++) { acc += h[b]; if (acc >= want) return b < PS3_LAT_NB - 1 ? k_lat_edge[b] : 64.0; }
+    return 64.0;
+}
+void ps3_lat_add_slow(int site, double ms)
+{
+    if (ms < 0) ms = 0;
+    int b = 0;
+    while (b < PS3_LAT_NB - 1 && ms > k_lat_edge[b]) b++;
+    __atomic_fetch_add(&g_lat_hist[site][b], 1, __ATOMIC_RELAXED);
+    const long long us = (long long)(ms * 1000.0);
+    long long m = __atomic_load_n(&s_lat_max_us[site], __ATOMIC_RELAXED);
+    while (us > m && !__atomic_compare_exchange_n(&s_lat_max_us[site], &m, us, 1, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+    /* every 5 s one thread prints and clears (a racing add lands in the next window or is lost: diagnostics) */
+    const long long now = (long long)(emscripten_get_now() * 1000.0);
+    long long t0 = __atomic_load_n(&s_lat_t0_us, __ATOMIC_RELAXED);
+    if (now - t0 < 5000000) return;
+    if (!__atomic_compare_exchange_n(&s_lat_t0_us, &t0, now, 0, LLW_SEQ, LLW_SEQ)) return;
+    const double secs = (double)(now - t0) / 1e6;
+    for (int s = 0; s < PS3_LAT_NSITE; s++) {
+        long long h[PS3_LAT_NB], n = 0;
+        for (int k = 0; k < PS3_LAT_NB; k++) { h[k] = __atomic_exchange_n(&g_lat_hist[s][k], 0, __ATOMIC_RELAXED); n += h[k]; }
+        const long long mx = __atomic_exchange_n(&s_lat_max_us[s], 0, __ATOMIC_RELAXED);
+        if (!n) continue;
+        fprintf(stderr, "[wasm-wait] lat %-11s %7.1f/s  p50 <=%g  p90 <=%g  p99 <=%g  max %.2f ms  (>1ms %.1f%%, >4ms %.1f%%)\n",
+                k_lat_name[s], (double)n / secs, lat_pct(h, n, 0.5), lat_pct(h, n, 0.9), lat_pct(h, n, 0.99), mx / 1000.0,
+                100.0 * (double)(h[6] + h[7] + h[8] + h[9] + h[10] + h[11]) / (double)n,
+                100.0 * (double)(h[8] + h[9] + h[10] + h[11]) / (double)n);
+    }
+}
+#else
+typedef int ps3_wasm_llwake_unused;
+#endif
diff --git a/runtime/platform/ps3_wasm_llwake.h b/runtime/platform/ps3_wasm_llwake.h
new file mode 100644
index 00000000..3c6d640c
--- /dev/null
+++ b/runtime/platform/ps3_wasm_llwake.h
@@ -0,0 +1,84 @@
+/*
+ * ps3recomp - lock-line waits that wake on the event, on WebAssembly (Emscripten builds only).
+ *
+ * The browser's only way to give up a time slice is a timed Atomics.wait, and Chrome rounds its timeout up to
+ * ~1-2 ms (ps3_wasm_sched.c). Every spin loop that fell back to sched_yield() therefore slept that long even when
+ * the thing it waited for was released microseconds later: the global lock-line spinlock (spu_lockline_lock),
+ * cellSyncMutexLock's ticket wait, and the SPU park fallbacks. In THP8 the SPURS job-queue lock line is hammered by
+ * three policy-module lanes and the PPU job-wait loop, so a lane HOLDING the queue mutex lost ~2 ms whenever one of
+ * its own lock-line ops yielded, and everyone queued behind it.
+ *
+ * Two primitives, both with a direct futex wake from the releasing side:
+ *   - ps3_llw_mutex_*: a 3-state futex mutex (0 free, 1 locked, 2 locked with possible sleepers; Drepper,
+ *     "Futexes Are Tricky", mutex2). The unlock that finds 2 wakes one sleeper. No lost wakes by construction.
+ *   - line events: a hashed table of 32-bit event counters, one bucket per 128-byte line hash. Every coherent write
+ *     to a lock line (the spu_coh_notify_write* paths, cellSync's CAS) bumps its bucket AFTER the store and wakes
+ *     the bucket's sleepers. A waiter registers (waiters++), reads the counter, RE-CHECKS its own condition, and only
+ *     then sleeps while the counter still holds that value. With every one of these ops sequentially consistent
+ *     (wasm atomics are), either the writer sees the waiter registered and wakes it, or the waiter's counter read /
+ *     condition re-check sees the write: the Dekker pattern, no window for a lost wake. Hash collisions and the
+ *     wake-all only cause spurious wakes; every waiter re-checks its condition.
+ * Timeouts stay as a safety net for writers that bypass the coherence hooks (lifted vector stores, raw host
+ * writes); a timeout that finds the condition already met is counted as "late" (a would-be lost wake).
+ *
+ * Switch: PS3_WASM_LLWAKE (default 1; =0 restores the spin + sched_yield behaviour everywhere). Read once.
+ *   PS3_WASM_LLWAKE_SPIN=<n>  probes before the lock-line mutex sleeps (default 1024, ~2-4 us)
+ *   PS3_WASM_LLWAKE_MS=<ms>   safety timeout of a line-event wait (default 8)
+ */
+#ifndef PS3RECOMP_PS3_WASM_LLWAKE_H
+#define PS3RECOMP_PS3_WASM_LLWAKE_H
+#if defined(__EMSCRIPTEN__)
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int  ps3_llwake_on(void);            /* the switch (cached after the first call) */
+unsigned ps3_llwake_ms(void);        /* PS3_WASM_LLWAKE_MS */
+
+/* futex mutex over an int word (0 / 1 / 2) */
+void ps3_llw_mutex_lock(int* w);
+static inline int ps3_llw_mutex_trylock(int* w)
+{ int c = 0; return __atomic_compare_exchange_n(w, &c, 1, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); }
+void ps3_llw_mutex_unlock(int* w);
+
+/* line events: `line` is any address in the line (masked internally) */
+void     ps3_llw_line_event(uint32_t line);                 /* writer: AFTER the store */
+uint32_t ps3_llw_wait_begin(uint32_t line);                 /* waiter: register + snapshot; then re-check */
+void     ps3_llw_wait_cancel(uint32_t line);                /* condition already met after begin */
+int      ps3_llw_wait_end(uint32_t line, uint32_t snap, double timeout_ms);   /* 0 = timed out, 1 = woken */
+
+/* stats (PS3_GAME_STATS): cumulative counters, read-and-cleared by ps3_llw_stats_line */
+enum { LLW_LL_SLOW, LLW_LL_SLEEP, LLW_LL_SLEEP_US, LLW_EV, LLW_EV_WAKE,
+       LLW_SYNC_WAIT, LLW_SYNC_WOKEN, LLW_SYNC_TMO, LLW_SYNC_LATE, LLW_SYNC_US,
+       LLW_FB_WAIT, LLW_FB_WOKEN, LLW_FB_LATE, LLW_FB_US,
+       LLW_YIELD, LLW_YIELD_US, LLW_RP, LLW_RP_WOKEN, LLW_RP_US, LLW_W_TMO, LLW_W_SPUR, LLW_NSTAT };
+extern volatile long long g_llw_stat[LLW_NSTAT];
+static inline void ps3_llw_stat_add(int k, long long v) { __atomic_fetch_add(&g_llw_stat[k], v, __ATOMIC_RELAXED); }
+double ps3_llw_now_us(void);
+
+/* sched_yield attribution ([wasm-wait] "yield by site"): a caller names itself, sched_yield (ps3_wasm_sched.c)
+ * books the call + its time under that site and resets it to OTHER. */
+enum { LLW_Y_OTHER, LLW_Y_PPU, LLW_Y_SYNC, LLW_Y_WIN32, LLW_Y_SPU, LLW_Y_NSITE };
+extern __thread int t_llw_yield_site;
+extern volatile long long g_llw_ysite[LLW_Y_NSITE][2];      /* [site][0] calls, [1] us */
+int sched_yield(void);
+static inline int ps3_llw_yield_at(int site) { t_llw_yield_site = site; return sched_yield(); }
+void   ps3_llw_stats_line(double secs);                     /* prints "[wasm-wait] ..." to stderr */
+
+/* latency histograms (PS3_WASM_LAT=1; ps3_wasm_llwake.c): ms per site, "[wasm-wait] lat ..." every 5 s */
+enum { PS3_LAT_SLEEP_S, PS3_LAT_SLEEP_M, PS3_LAT_SLEEP_L, PS3_LAT_SLEEP_XL, PS3_LAT_EVQ, PS3_LAT_COND, PS3_LAT_SEMA,
+       PS3_LAT_JOB, PS3_LAT_EVQ_BLOCK, PS3_LAT_NSITE };
+#define PS3_LAT_NB 12
+extern int g_lat_on;
+int    ps3_lat_init(void);
+double ps3_lat_now(void);                                   /* ms */
+void   ps3_lat_add_slow(int site, double ms);
+static inline int  ps3_lat_on(void) { int o = __atomic_load_n(&g_lat_on, __ATOMIC_RELAXED); return o < 0 ? ps3_lat_init() : o; }
+static inline void ps3_lat_add(int site, double ms) { if (ps3_lat_on() > 0) ps3_lat_add_slow(site, ms); }
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* __EMSCRIPTEN__ */
+#endif
diff --git a/runtime/platform/ps3_wasm_sbrk.c b/runtime/platform/ps3_wasm_sbrk.c
new file mode 100644
index 00000000..efc39d6d
--- /dev/null
+++ b/runtime/platform/ps3_wasm_sbrk.c
@@ -0,0 +1,73 @@
+/*
+ * ps3recomp - the host heap ceiling on WebAssembly (PS3_WASM + Emscripten builds).
+ *
+ * Linear memory is the guest's 4 GiB address space (vm_base == 0). The host's static data, stacks and heap live in
+ * 0x80000000..0xC0000000, the range the guest map never uses (vm.h); above it are RSX local memory, PPU stacks and
+ * raw SPU MMIO. Emscripten's sbrk would grow the heap until the end of memory, straight over those, so this file
+ * replaces it (same symbols, so libc's sbrk.o is never linked) with one that stops at PS3_WASM_HEAP_END.
+ * malloc then reports ENOMEM instead of corrupting guest memory.
+ */
+#if defined(PS3_WASM) && defined(__EMSCRIPTEN__)
+#include <errno.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <emscripten.h>
+
+#ifndef PS3_WASM_HEAP_END
+#define PS3_WASM_HEAP_END 0xC0000000u
+#endif
+
+extern size_t __heap_base;
+static uintptr_t s_brk;
+
+uintptr_t* emscripten_get_sbrk_ptr(void)
+{
+    if (!s_brk) {
+        uintptr_t expect = 0;
+        __atomic_compare_exchange_n(&s_brk, &expect, (uintptr_t)&__heap_base, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    }
+    return &s_brk;
+}
+
+void* _sbrk64(int64_t inc)
+{
+    const int64_t align = 16;
+    inc = inc >= 0 ? (inc + align - 1) & ~(align - 1) : -((-inc) & ~(align - 1));
+    uintptr_t* p = emscripten_get_sbrk_ptr();
+    for (;;) {
+        uintptr_t old = __atomic_load_n(p, __ATOMIC_SEQ_CST);
+        const int64_t nb = (int64_t)old + inc;
+        if (nb < (int64_t)(uintptr_t)&__heap_base || nb > (int64_t)PS3_WASM_HEAP_END) {
+            static int told;
+            if (!told++) {
+                char m[160]; int n = snprintf(m, sizeof m, "[wasm-heap] ceiling hit: heap_base=0x%08x brk=0x%08x request=%lld ceiling=0x%08x\n",
+                                              (unsigned)(uintptr_t)&__heap_base, (unsigned)old, (long long)inc, (unsigned)PS3_WASM_HEAP_END);
+                (void)write(2, m, (size_t)n);
+            }
+            errno = ENOMEM; return (void*)-1;
+        }
+        if (__atomic_compare_exchange_n(p, &old, (uintptr_t)nb, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+#ifdef PS3_WASM_HEAP_TRACE
+            if (inc >= (16ll << 20)) {         /* who grows the heap by a lot (diagnostic builds only) */
+                static volatile int n;
+                if (n++ < 40) emscripten_log(EM_LOG_CONSOLE | EM_LOG_C_STACK, "[wasm-heap] +%lld MB -> brk 0x%08x", (long long)(inc >> 20), (unsigned)nb);
+            }
+#endif
+            return (void*)old;
+        }
+    }
+}
+
+/* 32-bit sbrk takes its argument as unsigned, as Emscripten's does. */
+void* sbrk(intptr_t inc) { return _sbrk64((int64_t)(uintptr_t)inc); }
+
+int brk(void* ptr)
+{
+    uintptr_t cur = (uintptr_t)sbrk(0);
+    return _sbrk64((int64_t)(uintptr_t)ptr - (int64_t)cur) == (void*)-1 ? -1 : 0;
+}
+#else
+typedef int ps3_wasm_sbrk_unused;
+#endif
diff --git a/runtime/platform/ps3_wasm_sched.c b/runtime/platform/ps3_wasm_sched.c
new file mode 100644
index 00000000..3681603b
--- /dev/null
+++ b/runtime/platform/ps3_wasm_sched.c
@@ -0,0 +1,122 @@
+/*
+ * ps3recomp - a sched_yield that yields, on WebAssembly (PS3_WASM + Emscripten builds).
+ *
+ * Emscripten's sched_yield() returns at once: a Web Worker has no way to give up its time slice. The runtime's spin
+ * loops (spu_lockline_lock, cellSyncMutexLock, the SPU lock-line and SPURS pollers, Sleep(0) / SwitchToThread in
+ * win32_compat.h) all fall back to sched_yield after a few thousand probes, so in the browser they never stopped
+ * spinning: THP8's loading screen ran at 2 fps with 7.5 cores busy, the threads holding the tickets starved by the
+ * ~30 workers polling them. This definition replaces libc's (same symbol, so its sched_yield.o is never linked) and
+ * parks the caller for the shortest timed futex wait the browser offers -- Atomics.wait with a timeout, which
+ * Chrome rounds up to about a millisecond. Callers only get here after spinning, so the hot uncontended paths are
+ * unchanged.
+ */
+#if defined(PS3_WASM) && defined(__EMSCRIPTEN__)
+#include <emscripten/threading.h>
+#include <sched.h>
+#include <stdint.h>
+
+static volatile uint32_t s_never;   /* nobody wakes it: every wait runs to its timeout */
+
+#include "ps3_wasm_llwake.h"
+extern int g_game_stats_on;   /* runtime/spu/spu_coherency.c (PS3_GAME_STATS) */
+#include "../../libs/video/frame_trace.h"   /* PS3_SPIKE_MS: sched_yield calls per frame */
+
+int sched_yield(void)
+{
+    if (emscripten_is_main_browser_thread()) return 0;   /* Atomics.wait is not allowed there */
+    FT_ADD(FT_W_YIELD, 1);   /* PS3_SPIKE_MS */
+    if (g_game_stats_on) {     /* [wasm-wait] sched_yield count + time: what the timer floor costs */
+        const double t0 = ps3_llw_now_us();
+        emscripten_futex_wait(&s_never, 0, 0.05);
+        const long long us = (long long)(ps3_llw_now_us() - t0);
+        ps3_llw_stat_add(LLW_YIELD, 1);
+        ps3_llw_stat_add(LLW_YIELD_US, us);
+        const int s = (unsigned)t_llw_yield_site < LLW_Y_NSITE ? t_llw_yield_site : LLW_Y_OTHER;
+        __atomic_fetch_add(&g_llw_ysite[s][0], 1, __ATOMIC_RELAXED);
+        __atomic_fetch_add(&g_llw_ysite[s][1], us, __ATOMIC_RELAXED);
+        t_llw_yield_site = LLW_Y_OTHER;
+        return 0;
+    }
+    t_llw_yield_site = LLW_Y_OTHER;
+    emscripten_futex_wait(&s_never, 0, 0.05);
+    return 0;
+}
+
+/* A clock_gettime without the WASI round trip (PS3_WASM_FASTCLOCK, default on; =0 = libc's).
+ *
+ * libc's clock_gettime calls the JS import __wasi_clock_time_get, which reads performance.now() / Date.now()
+ * and hands the 64-bit result back through a BigInt: ~300 ns per call in a worker (node), against ~130 ns for a
+ * direct emscripten_get_now(). The runtime reads the clock everywhere (QueryPerformanceCounter / GetTickCount /
+ * frame_trace_now_us / game_stats_now_us / the guest timebase all end here), and the browser profile of the
+ * translation thread had ~1/3 of its busy time in clock reads (wasm-lock, wr2p cdpprof 2026-10-09).
+ * The value is computed exactly as Emscripten's clock_time_get computes it (src/lib/libwasi.js): REALTIME from
+ * emscripten_date_now(), every other WASI clock from emscripten_get_now(), nsec = Math.round(now * 1000 * 1000)
+ * (two multiplications in that order, ties toward +inf), split like __wasi_timestamp_to_timespec. This
+ * definition replaces libc's weak clock_gettime; libc-internal callers of __clock_gettime are unchanged. */
+#include <emscripten/emscripten.h>
+#include <errno.h>
+#include <math.h>
+#include <stdlib.h>
+#include <time.h>
+int __clock_gettime(clockid_t clk, struct timespec* ts);
+static int s_fastclock = -1;
+/* ms -> ns exactly as JS Math.round(ms * 1000 * 1000) (ms >= 0). Not static: runtime/platform/tests check it. */
+unsigned long long ps3_wasm_ms_to_ns(double x)
+{
+    x = x * 1000; x = x * 1000;                      /* as JS evaluates now * 1000 * 1000 */
+    double r = floor(x);
+    if (x - r >= 0.5) r += 1.0;                      /* Math.round for x >= 0 */
+    return (unsigned long long)r;
+}
+int clock_gettime(clockid_t clk, struct timespec* ts)
+{
+    int on = s_fastclock;
+    if (__builtin_expect(on < 0, 0)) { const char* e = getenv("PS3_WASM_FASTCLOCK"); on = s_fastclock = !(e && *e == '0'); }
+    if (!on || clk < CLOCK_REALTIME || clk > CLOCK_THREAD_CPUTIME_ID) return __clock_gettime(clk, ts);
+    const unsigned long long ns = ps3_wasm_ms_to_ns(clk == CLOCK_REALTIME ? emscripten_date_now() : emscripten_get_now());
+    ts->tv_sec = (time_t)(ns / 1000000000ull);
+    ts->tv_nsec = (long)(ns % 1000000000ull);
+    return 0;
+}
+
+/* memcmp in wasm SIMD (PS3_WASM_MEMCMP, default on; =0 = musl's loop). Emscripten's musl memcmp compares
+ * bytewise unless both pointers are 4-aligned (~0.6 GB/s in V8); the runtime compares 128-byte lock lines on every
+ * SPU PUTLLC / GETLLAR park and the renderer compares state blocks per draw (1% of the RSX translation thread in
+ * the browser profile). Same result as musl's: 0, or the difference of the first differing bytes as unsigned
+ * char. This definition replaces libc's (same symbol). */
+#if defined(__wasm_simd128__)
+#include <wasm_simd128.h>
+#include <stddef.h>
+static int s_memcmp_simd = -1;
+static int memcmp_bytes(const unsigned char* l, const unsigned char* r, size_t n)
+{
+    for (; n && *l == *r; n--, l++, r++) {}
+    return n ? *l - *r : 0;
+}
+int memcmp(const void* vl, const void* vr, size_t n)
+{
+    const unsigned char* l = (const unsigned char*)vl;
+    const unsigned char* r = (const unsigned char*)vr;
+    int on = s_memcmp_simd;
+    if (__builtin_expect(on < 0, 0)) {
+        /* no getenv here: getenv itself may call memcmp/strncmp during start-up; read it once, lazily */
+        s_memcmp_simd = 1;
+        const char* e = getenv("PS3_WASM_MEMCMP");
+        on = s_memcmp_simd = !(e && *e == '0');
+    }
+    if (on) {
+        while (n >= 16) {
+            const int m = wasm_i8x16_bitmask(wasm_i8x16_eq(wasm_v128_load(l), wasm_v128_load(r)));
+            if (m != 0xFFFF) {
+                const int k = __builtin_ctz(~m & 0xFFFF);
+                return l[k] - r[k];
+            }
+            l += 16; r += 16; n -= 16;
+        }
+    }
+    return memcmp_bytes(l, r, n);
+}
+#endif
+#else
+typedef int ps3_wasm_sched_unused;
+#endif
diff --git a/runtime/platform/ps3_wasm_sleep.c b/runtime/platform/ps3_wasm_sleep.c
new file mode 100644
index 00000000..3e4008d3
--- /dev/null
+++ b/runtime/platform/ps3_wasm_sleep.c
@@ -0,0 +1,195 @@
+/*
+ * ps3recomp - nanosleep / usleep / clock_nanosleep without the busy tail, on WebAssembly (PS3_WASM + Emscripten).
+ *
+ * Emscripten's emscripten_thread_sleep() (behind every libc sleep) waits on a futex in slices but busy-spins the
+ * last 0.1 ms of every sleep, and the whole of any sleep shorter than that, calling emscripten_get_now() and the
+ * queued-call pump on each turn. THP8's MAIN sleeps through it constantly -- sys_timer_usleep from its frame loop
+ * and cellGcmSetWaitFlip's Sleep(1) flip poll -- and a browser profile of the in-level game showed MAIN 17% busy in
+ * that spin (performance.now + the pump), on a machine where every core is already shared with ~30 workers.
+ *
+ * These definitions replace libc's (same symbols, so musl's nanosleep.o / usleep.o / clock_nanosleep.o are never
+ * linked; the sched_yield override in ps3_wasm_sched.c works the same way). PS3_WASM_SLEEP selects (read once):
+ *   0  Emscripten's own sleep (emscripten_thread_sleep), exactly as before -- the default (A/B with =1, =2)
+ *   1  futex waits only, to the deadline: no spin at all (a sub-millisecond request may overshoot to the
+ *      browser's timed-wait granularity, ~1 ms in Chrome)
+ *   2  futex waits while more than PS3_WASM_SLEEP_SPIN_US (default 100) remain, then a get_now-only spin
+ *      (no queued-call pump) for the tail: Emscripten's precision at a lower cost per turn
+ *   3  exact sleeps from ONE timer thread (wasm-perf 2026-10-15): the browser's timed Atomics.wait overshoots by up
+ *      to the 15.6 ms Windows timer quantum (PS3_WASM_LAT: 10% of THP8's 1-4 ms usleeps came back > 4 ms late,
+ *      which is the 33 ms "guest late" frame), while an Atomics.notify wake lands in ~25 us. A sleeper futex-waits
+ *      on its own until PS3_WASM_SLEEP_SPIN_US (default 16000 in this mode) remain, then registers its deadline and
+ *      waits for a notify (no CPU); the timer thread waits (timed) until 17 ms before the earliest deadline, then
+ *      spins on the clock and notifies every sleeper that is due. One spinning thread instead of every sleeper.
+ * The browser main thread (no Atomics.wait there) always takes Emscripten's sleep.
+ */
+#if defined(PS3_WASM) && defined(__EMSCRIPTEN__)
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+
+static volatile uint32_t s_never;          /* nobody wakes it: every wait runs to its timeout */
+static int s_mode = -1, s_spin_us = 100;
+
+/* ---- mode 3: the timer thread ---------------------------------------------------------------------------------- */
+#include <pthread.h>
+#define TS_SLOTS 128
+static struct { double deadline; volatile uint32_t word; volatile uint32_t used; } s_ts[TS_SLOTS];
+static volatile uint32_t s_ts_bell;                  /* bumped + notified when a sleeper registers */
+static volatile int s_ts_up;                         /* 0 not started, 1 running, -1 failed (mode 3 falls back to 2) */
+static double s_ts_spin_ms = 17.0;                   /* PS3_WASM_SLEEP_TIMER_MS: the timer thread's spin window */
+/* The renderer stores the time of every presented frame here (rsx_live_draw.c). Mode 3 serves sleeps only while
+ * frames are being presented (the last one < 250 ms ago): a hidden tab, a stalled or not yet started game makes
+ * plain timed waits again, so the timer thread has nothing pending and does not spin. */
+volatile double g_ps3_wasm_present_ms;
+/* PS3_WASM_SLEEP_THREADS=<name,name,...> (substrings of guest thread names; sys_timer.c sets this per call): only
+ * those threads' sleeps go through the timer thread. Unset: every thread (1). */
+__thread int g_ps3_sleep_precise = 1;
+static void* ps3_wasm_timer_thread(void* arg)
+{
+    (void)arg;
+    for (;;) {
+        const uint32_t bell = __atomic_load_n(&s_ts_bell, __ATOMIC_SEQ_CST);
+        double first = 0;
+        for (int i = 0; i < TS_SLOTS; i++)
+            if (__atomic_load_n(&s_ts[i].used, __ATOMIC_ACQUIRE) == 2u && (first == 0 || s_ts[i].deadline < first)) first = s_ts[i].deadline;
+        const double now = emscripten_get_now();
+        if (first == 0) { emscripten_futex_wait((void*)&s_ts_bell, bell, 100.0); continue; }
+        /* a timed wait can overshoot by the 15.6 ms timer quantum: hand over to the clock 17 ms before */
+        if (first - now > s_ts_spin_ms) { emscripten_futex_wait((void*)&s_ts_bell, bell, first - now - s_ts_spin_ms); continue; }
+        if (now < first) continue;                                         /* spin (re-scan: an earlier one may come) */
+        for (int i = 0; i < TS_SLOTS; i++)
+            if (__atomic_load_n(&s_ts[i].used, __ATOMIC_ACQUIRE) == 2u && s_ts[i].deadline <= now) {
+                uint32_t two = 2u;                                         /* fired: the sleeper frees it */
+                if (!__atomic_compare_exchange_n(&s_ts[i].used, &two, 3u, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) continue;
+                __atomic_store_n(&s_ts[i].word, 1u, __ATOMIC_SEQ_CST);
+                emscripten_futex_wake((void*)&s_ts[i].word, 1);
+            }
+    }
+    return 0;
+}
+static int ps3_wasm_timer_start(void)
+{
+    int up = __atomic_load_n(&s_ts_up, __ATOMIC_ACQUIRE);
+    if (up) return up;
+    static volatile int once;
+    if (__atomic_exchange_n(&once, 1, __ATOMIC_SEQ_CST)) {               /* another thread is starting it */
+        while (!(up = __atomic_load_n(&s_ts_up, __ATOMIC_ACQUIRE))) emscripten_futex_wait((void*)&s_never, 0, 1.0);
+        return up;
+    }
+    pthread_t t;
+    up = pthread_create(&t, NULL, ps3_wasm_timer_thread, NULL) == 0 ? 1 : -1;
+    if (up > 0) pthread_detach(t);
+    __atomic_store_n(&s_ts_up, up, __ATOMIC_RELEASE);
+    return up;
+}
+/* the exact part of a mode-3 sleep: 1 = woken at the deadline by the timer thread, 0 = no slot / no thread */
+static int ps3_wasm_timer_wait(double deadline)
+{
+    if (ps3_wasm_timer_start() < 0) return 0;
+    int i = 0;
+    for (; i < TS_SLOTS; i++) { uint32_t z = 0; if (__atomic_compare_exchange_n(&s_ts[i].used, &z, 1u, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) break; }
+    if (i == TS_SLOTS) return 0;
+    s_ts[i].deadline = deadline;
+    __atomic_store_n(&s_ts[i].word, 0u, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&s_ts[i].used, 2u, __ATOMIC_SEQ_CST);               /* armed */
+    __atomic_add_fetch(&s_ts_bell, 1u, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake((void*)&s_ts_bell, 1);
+    /* the safety timeout covers a stalled timer thread: never later than the plain wait would have been */
+    while (!__atomic_load_n(&s_ts[i].word, __ATOMIC_SEQ_CST)) {
+        const double rem = deadline - emscripten_get_now();
+        if (rem < -50.0) break;
+        emscripten_futex_wait((void*)&s_ts[i].word, 0, rem > 0 ? rem + 50.0 : 50.0);
+    }
+    uint32_t two = 2u;                                     /* timed out (stalled timer): take the slot back */
+    if (!__atomic_compare_exchange_n(&s_ts[i].used, &two, 0u, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+        while (!__atomic_load_n(&s_ts[i].word, __ATOMIC_SEQ_CST)) {}     /* fired concurrently: its word store is next */
+        __atomic_store_n(&s_ts[i].used, 0u, __ATOMIC_SEQ_CST);
+    }
+    return 1;
+}
+
+static void ps3_wasm_sleep_cfg(void)
+{
+    const char* e = getenv("PS3_WASM_SLEEP");
+    const char* s = getenv("PS3_WASM_SLEEP_SPIN_US");
+    int m = e ? atoi(e) : 0;
+    if (m < 0 || m > 3) m = 0;
+    if (m == 3) s_spin_us = 16000;                      /* mode 3: the last 16 ms (> one timer quantum) go to the timer thread */
+    if (s) { s_spin_us = atoi(s); if (s_spin_us < 0) s_spin_us = 0; if (s_spin_us > 20000) s_spin_us = 20000; }
+    { const char* t = getenv("PS3_WASM_SLEEP_TIMER_MS"); if (t && atof(t) >= 0.0 && atof(t) <= 50.0) s_ts_spin_ms = atof(t); }
+    __atomic_store_n(&s_mode, m, __ATOMIC_RELEASE);
+}
+
+static void ps3_wasm_sleep_ms(double ms)
+{
+    if (!(ms > 0)) return;
+    int m = __atomic_load_n(&s_mode, __ATOMIC_ACQUIRE);
+    if (m < 0) { ps3_wasm_sleep_cfg(); m = s_mode; }
+    if (m == 0 || emscripten_is_main_browser_thread()) { emscripten_thread_sleep(ms); return; }
+    /* mode 3 for a thread not on PS3_WASM_SLEEP_THREADS, or while no frames are presented: exactly mode 0 */
+    if (m == 3 && !(g_ps3_sleep_precise && g_ps3_wasm_present_ms > 0 && emscripten_get_now() - g_ps3_wasm_present_ms < 250.0)) {
+        emscripten_thread_sleep(ms);
+        return;
+    }
+    const double deadline = emscripten_get_now() + ms;
+    const double tail = m >= 2 ? s_spin_us / 1000.0 : 0.0;
+    emscripten_current_thread_process_queued_calls();    /* once per sleep (Emscripten does it every turn) */
+    for (;;) {
+        const double rem = deadline - emscripten_get_now();
+        if (rem <= 0) return;
+        if (rem <= tail) {                                 /* mode 2: precise tail, clock only */
+            if (m == 3) {                                  /* mode 3: the timer thread's notify */
+                if (ps3_wasm_timer_wait(deadline)) return;
+                emscripten_thread_sleep(rem);              /* no slot / no thread: mode 0 */
+                return;
+            }
+            while (emscripten_get_now() < deadline) {}
+            return;
+        }
+        emscripten_futex_wait((void*)&s_never, 0, rem - tail);
+    }
+}
+
+static int ps3_wasm_sleep_ts(const struct timespec* req)
+{
+    if (!req || req->tv_nsec < 0 || req->tv_nsec > 999999999L || req->tv_sec < 0) return EINVAL;
+    ps3_wasm_sleep_ms((double)req->tv_sec * 1000.0 + (double)req->tv_nsec / 1e6);
+    return 0;
+}
+
+int nanosleep(const struct timespec* req, struct timespec* rem)
+{
+    const int r = ps3_wasm_sleep_ts(req);
+    if (r) { errno = r; return -1; }
+    if (rem) { rem->tv_sec = 0; rem->tv_nsec = 0; }
+    return 0;
+}
+
+int usleep(unsigned us)
+{
+    ps3_wasm_sleep_ms((double)us / 1000.0);
+    return 0;
+}
+
+int clock_nanosleep(clockid_t clk, int flags, const struct timespec* req, struct timespec* rem)
+{
+    if (clk == CLOCK_THREAD_CPUTIME_ID) return EINVAL;
+    if (!req || req->tv_nsec < 0 || req->tv_nsec > 999999999L || req->tv_sec < 0) return EINVAL;
+    struct timespec d = *req;
+    if (flags & TIMER_ABSTIME) {
+        struct timespec now;
+        clock_gettime(clk, &now);
+        if (now.tv_sec > req->tv_sec || (now.tv_sec == req->tv_sec && now.tv_nsec >= req->tv_nsec)) return 0;
+        d.tv_sec = req->tv_sec - now.tv_sec;
+        d.tv_nsec = req->tv_nsec - now.tv_nsec;
+        if (d.tv_nsec < 0) { d.tv_nsec += 1000000000L; d.tv_sec--; }
+    }
+    if (rem) { rem->tv_sec = 0; rem->tv_nsec = 0; }
+    return ps3_wasm_sleep_ts(&d);
+}
+#else
+typedef int ps3_wasm_sleep_unused;
+#endif
diff --git a/runtime/platform/tests/test_wasm_fastclock.c b/runtime/platform/tests/test_wasm_fastclock.c
new file mode 100644
index 00000000..de0544e5
--- /dev/null
+++ b/runtime/platform/tests/test_wasm_fastclock.c
@@ -0,0 +1,82 @@
+/*
+ * Test for the WebAssembly clock_gettime override (runtime/platform/ps3_wasm_sched.c, PS3_WASM_FASTCLOCK):
+ *  1. ps3_wasm_ms_to_ns(ms) == JS Math.round(ms * 1000 * 1000) for random and edge-case ms values;
+ *  2. in a worker, the override and libc's __clock_gettime agree (interleaved reads stay ordered: libc <= ours <=
+ *     libc taken right after, for MONOTONIC and REALTIME) and the override is monotonic;
+ *  3. timing of both paths.
+ * Build: emcc -O2 -pthread -sPTHREAD_POOL_SIZE=2 -sEXIT_RUNTIME -DPS3_WASM -I runtime/platform -I runtime/spu \
+ *        runtime/platform/tests/test_wasm_fastclock.c runtime/platform/ps3_wasm_sched.c runtime/platform/ps3_wasm_llwake.c
+ */
+#if !defined(__EMSCRIPTEN__)
+int main(void) { return 0; }
+#else
+#include <emscripten.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+int g_game_stats_on;                                     /* spu_coherency.c */
+int g_ft_on;                                         /* frame_trace.c (PS3_SPIKE_MS): off */
+void frame_trace_add(int id, long long v) { (void)id; (void)v; }
+long long frame_trace_now_us(void) { return 0; }
+unsigned long long ps3_wasm_ms_to_ns(double ms);
+int __clock_gettime(clockid_t clk, struct timespec* ts);
+static long long fails;
+static unsigned long long r64(void) { static unsigned long long s = 0x243F6A8885A308D3ull; s ^= s << 13; s ^= s >> 7; s ^= s << 17; return s; }
+static long long ns_of(const struct timespec* t) { return (long long)t->tv_sec * 1000000000ll + t->tv_nsec; }
+static void* worker(void* u)
+{
+    (void)u;
+    for (int clk = 0; clk <= 1; clk++) {
+        long long prev = 0;
+        for (int i = 0; i < 200000; i++) {
+            struct timespec a, b, c;
+            __clock_gettime(clk, &a); clock_gettime(clk, &b); __clock_gettime(clk, &c);
+            if (!(ns_of(&a) <= ns_of(&b) && ns_of(&b) <= ns_of(&c)) || ns_of(&b) < prev || b.tv_nsec < 0 || b.tv_nsec >= 1000000000) {
+                if (fails++ < 10) printf("FAIL clk %d: libc %lld ours %lld libc %lld prev %lld\n", clk, ns_of(&a), ns_of(&b), ns_of(&c), prev);
+            }
+            prev = ns_of(&b);
+        }
+    }
+    const int N = 200000; double best[2] = { 1e9, 1e9 }; volatile long long sink = 0;
+    for (int k = 0; k < 10; k++) {
+        struct timespec t;
+        double t0 = emscripten_get_now(); for (int i = 0; i < N; i++) { __clock_gettime(CLOCK_MONOTONIC, &t); sink += t.tv_nsec; }
+        double t1 = emscripten_get_now(); for (int i = 0; i < N; i++) { clock_gettime(CLOCK_MONOTONIC, &t); sink += t.tv_nsec; }
+        double t2 = emscripten_get_now();
+        if (t1 - t0 < best[0]) best[0] = t1 - t0;
+        if (t2 - t1 < best[1]) best[1] = t2 - t1;
+    }
+    printf("worker ns/call (min of 10): libc __clock_gettime %.0f, override %.0f\n", best[0] * 1e6 / N, best[1] * 1e6 / N);
+    struct timespec bad; errno = 0;
+    if (clock_gettime((clockid_t)17, &bad) == 0) { fails++; printf("FAIL: invalid clock accepted\n"); }
+    return NULL;
+}
+int main(void)
+{
+    /* 1: conversion */
+    static const double edge[] = { 0, 0.0000005, 0.0000004999999999, 0.0000015, 1e-7, 0.4999999999, 123.4565, 123.4564995,
+                                   1759900000000.0, 1759900000000.0004995, 1759900000000.000501, 86400000.0000005, 3.0e9 };
+    long long n = 0;
+    for (int i = 0; i < (int)(sizeof edge / sizeof edge[0]) + 4000000; i++) {
+        double ms;
+        if (i < (int)(sizeof edge / sizeof edge[0])) ms = edge[i];
+        else switch (i & 3) {
+            case 0: ms = (double)(r64() >> 11) * 0x1p-53 * 1e7; break;                       /* performance.now() range */
+            case 1: ms = (double)(r64() % 4000000000000ull) / 1000.0 + 1.7e12; break;         /* Date.now()-sized, us steps */
+            case 2: ms = (double)(r64() % 100000000000ull) * 0.0005; break;                   /* exact half-ns ties */
+            default: { unsigned long long b = (r64() >> 2) & 0x7FEFFFFFFFFFFFFFull; double d; memcpy(&d, &b, 8); ms = d < 1e12 ? d : 1.0; }
+        }
+        const double js = EM_ASM_DOUBLE({ return Math.round($0 * 1000 * 1000); }, ms);
+        const unsigned long long c = ps3_wasm_ms_to_ns(ms);
+        n++;
+        if ((double)c != js && fails++ < 10) printf("FAIL ms=%.17g: C %llu JS %.17g\n", ms, c, js);
+    }
+    printf("conversion: %lld values compared\n", n);
+    pthread_t t; pthread_create(&t, NULL, worker, NULL); pthread_join(t, NULL);
+    printf("%s (%lld failures)\n", fails ? "FAILED" : "ALL PASS", fails);
+    return fails ? 1 : 0;
+}
+#endif
diff --git a/runtime/platform/tests/test_wasm_memcmp.c b/runtime/platform/tests/test_wasm_memcmp.c
new file mode 100644
index 00000000..8b53a65a
--- /dev/null
+++ b/runtime/platform/tests/test_wasm_memcmp.c
@@ -0,0 +1,61 @@
+/*
+ * Test for the WebAssembly memcmp override (runtime/platform/ps3_wasm_sched.c, PS3_WASM_MEMCMP): exact musl return
+ * values (0 or the difference of the first differing bytes) for every length 0..300, misaligned pointers, mismatch
+ * at every position, equal buffers; plus timing on 128-byte lock lines and 64 KB blocks.
+ * Build: emcc -O2 -msimd128 -pthread -DPS3_WASM -I runtime/platform -I runtime/spu \
+ *        runtime/platform/tests/test_wasm_memcmp.c runtime/platform/ps3_wasm_sched.c runtime/platform/ps3_wasm_llwake.c
+ */
+#if !defined(__EMSCRIPTEN__)
+int main(void) { return 0; }
+#else
+#include <emscripten.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+int g_game_stats_on;
+int g_ft_on;                                         /* frame_trace.c (PS3_SPIKE_MS): off */
+void frame_trace_add(int id, long long v) { (void)id; (void)v; }
+long long frame_trace_now_us(void) { return 0; }
+static int ref(const unsigned char* l, const unsigned char* r, size_t n)
+{
+    for (size_t i = 0; i < n; i++) if (l[i] != r[i]) return l[i] - r[i];
+    return 0;
+}
+static unsigned long long s = 0x2545F4914F6CDD1Dull;
+static unsigned r8(void) { s ^= s << 13; s ^= s >> 7; s ^= s << 17; return (unsigned)(s >> 24) & 0xFF; }
+int main(void)
+{
+    static unsigned char a[4096 + 64], b[4096 + 64];
+    long long checks = 0, fails = 0;
+    for (int oa = 0; oa < 16; oa++)
+    for (int ob = 0; ob < 16; ob++)
+    for (size_t n = 0; n <= 300; n++) {
+        for (size_t i = 0; i < n + 32; i++) a[oa + i] = b[ob + i] = (unsigned char)r8();
+        int (*volatile cmp)(const void*, const void*, size_t) = memcmp;   /* force the library call */
+        int got = cmp(a + oa, b + ob, n), want = ref(a + oa, b + ob, n);
+        checks++; if (got != want && fails++ < 10) printf("FAIL equal n=%zu oa=%d ob=%d got %d want %d\n", n, oa, ob, got, want);
+        if (!n) continue;
+        const size_t p = (size_t)(r8() * 257 + r8()) % n;
+        unsigned char v = (unsigned char)r8(); if (v == a[oa + p]) v ^= 0x80;
+        b[ob + p] = v;
+        got = cmp(a + oa, b + ob, n); want = ref(a + oa, b + ob, n);
+        checks++; if (got != want && fails++ < 10) printf("FAIL diff n=%zu p=%zu oa=%d ob=%d got %d want %d\n", n, p, oa, ob, got, want);
+        if (p + 1 < n) { b[ob + n - 1] ^= 0x55; got = cmp(a + oa, b + ob, n); want = ref(a + oa, b + ob, n);
+                         checks++; if (got != want && fails++ < 10) printf("FAIL two n=%zu\n", n); }
+    }
+    printf("%lld memcmp results compared, %lld wrong\n", checks, fails);
+    static unsigned char big[2][65536]; memset(big, 7, sizeof big);
+    int (*volatile cmp)(const void*, const void*, size_t) = memcmp; volatile int sink = 0;
+    double b0 = 1e9, b1 = 1e9;
+    for (int k = 0; k < 5; k++) {
+        double t0 = emscripten_get_now(); for (int i = 0; i < 200000; i++) sink += cmp(a + 1, b + 1, 128) + ref(a, a, 0);
+        double t1 = emscripten_get_now(); for (int i = 0; i < 2000; i++) sink += cmp(big[0], big[1], 65536);
+        double t2 = emscripten_get_now();
+        if (t1 - t0 < b0) b0 = t1 - t0; if (t2 - t1 < b1) b1 = t2 - t1;
+    }
+    memcpy(b, a, 200);
+    printf("timing: 128 B equal-ish line %.1f ns/call, 64 KB equal %.2f GB/s\n", b0 * 1e6 / 200000, 65536.0 * 2000 / (b1 / 1e3) / 1e9);
+    printf("%s\n", fails ? "FAILED" : "ALL PASS");
+    return fails != 0;
+}
+#endif
