+static int is_xfail(const char* mn)
+{
+    char k[64]; snprintf(k, sizeof k, ",%s,", mn);
+    return strstr(g_xfail, k) != 0;
+}
+static mnstat* stat_of(const char* mn)
+{
+    for (int i = 0; i < g_nst; i++) if (!strcmp(g_st[i].mn, mn)) return &g_st[i];
+    if (g_nst >= MAXMN) { fprintf(stderr, "too many mnemonics\n"); exit(2); }
