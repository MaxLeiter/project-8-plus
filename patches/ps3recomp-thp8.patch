+    WCHAR w[512];
+    DWORD k = GetEnvironmentVariableW(name, w, (DWORD)(sizeof w / sizeof w[0]));
+    if (k == 0 || k >= sizeof w / sizeof w[0]) return NULL;
+    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, n, NULL, NULL)) return NULL;
+    return out;
+}
