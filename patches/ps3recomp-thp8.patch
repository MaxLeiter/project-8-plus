+    if (!g_dcl.on) { g.list->lpVtbl->IASetIndexBuffer(g.list, v); return; }
+    DCL_PUT(dcl_ia_ib, DCL_IA_IB); o_->has = v != NULL; if (v) o_->v = *v;
