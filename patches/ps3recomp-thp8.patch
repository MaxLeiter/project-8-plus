+# ---------------------------------------------------------------------------
+# reservations (lwarx/ldarx/stwcx./stdcx.). The runtime models a reservation
+# as (address, value seen by the load); a store-conditional succeeds when the
+# reservation is for this EA and memory still holds that value. In a single-
+# threaded test that is exactly "no intervening store to the granule".
+# ---------------------------------------------------------------------------
+
+def _larx(size):
+    def sem(s, f):
+        ea = _ea_x(s, f, False)
+        if ea & (size - 1):
+            raise Undefined          # alignment interrupt on hardware
+        v = s.ld_u(ea, size)
+        s.gpr[f.rt] = v
+        s.resv_addr = ea & MASK32
+        s.resv_val = v
+    return sem
+
+
+def _stcx(size):
+    def sem(s, f):
+        ea = _ea_x(s, f, False)
+        if ea & (size - 1):
+            raise Undefined
+        ok = (s.resv_addr == ea & MASK32 and s.resv_addr != 0
+              and s.ld_u(ea, size) == (s.resv_val & ((1 << (8 * size)) - 1)))
+        if ok:
+            s.st_u(ea, size, s.gpr[f.rt])
+        s.set_crf(0, (2 if ok else 0) | ((s.xer >> 31) & 1))
+        s.resv_addr = 0
+        s.dontcare("resv_val", MASK64)      # meaningless once the reservation is gone
+    return sem
+
+
+def _resv_setup(size, stcx):
+    def setup(s, f, rng, ea):
+        cur = s.ld_u(ea, size)
+        r = rng.random()
+        if not stcx and r < 0.5:
+            s.resv_addr, s.resv_val = 0, 0
+        elif r < 0.55:                               # live reservation, word unchanged
+            s.resv_addr, s.resv_val = ea & MASK32, cur
+        elif r < 0.70:                               # word changed since the larx
+            s.resv_addr, s.resv_val = ea & MASK32, cur ^ (1 << rng.randrange(8 * size))
+        elif r < 0.85:                               # reservation on another address
+            s.resv_addr, s.resv_val = (ea + rng.choice((4, 8, 16, 128, -8))) & MASK32, cur
+        else:                                        # no reservation
+            s.resv_addr, s.resv_val = 0, 0
+    return setup
+
+
+add_spec("lwarx", "X", 31, 20, _larx(4), ea=("X", 4, True), fixed={"rc": 0},
+         setup=_resv_setup(4, False), tags=("atomic",))
+add_spec("ldarx", "X", 31, 84, _larx(8), ea=("X", 8, True), fixed={"rc": 0},
+         setup=_resv_setup(8, False), tags=("atomic",))
+add_spec("stwcx.", "X", 31, 150, _stcx(4), ea=("X", 4, True), fixed={"rc": 1},
+         setup=_resv_setup(4, True), tags=("atomic",))
+add_spec("stdcx.", "X", 31, 214, _stcx(8), ea=("X", 8, True), fixed={"rc": 1},
+         setup=_resv_setup(8, True), tags=("atomic",))
+
+
+@spec("dcbz", "X", 31, 1014, ea=("X", 128), fixed={"rt": 0, "rc": 0}, tags=("ldst", "store"))
+def _dcbz(s, f):
+    ea = _ea_x(s, f, False) & ~127
+    s.store(ea, bytes(128))           # Cell PPU cache line = 128 bytes
