+        if (s_names[i].code == code) { e = &s_names[i]; break; }
+#ifdef _WIN32
+    if ((!e || e->layout) && code && code < HK_MOUSE_LEFT) {
+        /* the character this key types on the active layout, unshifted (letters upper-case) */
+        const UINT sc = (code & 0xFF) | ((code & HK_EXT) ? 0xE000u : 0u);
+        const UINT vk = MapVirtualKeyW(sc, MAPVK_VSC_TO_VK_EX);
+        const UINT ch = vk ? MapVirtualKeyW(vk, MAPVK_VK_TO_CHAR) : 0;
+        wchar_t w[2] = { (wchar_t)(ch & 0xFFFF), 0 };
+        if ((ch & 0x7FFFFFFFu) >= 0x21 && !(ch & 0x80000000u)) {   /* printable, not a dead key */
+            if (w[0] >= L'a' && w[0] <= L'z') w[0] = (wchar_t)(w[0] - 32);
+            const int nb = WideCharToMultiByte(CP_UTF8, 0, w, 1, out, (int)cap - 1, NULL, NULL);
+            if (nb > 0) { out[nb] = 0; return (size_t)nb; }
+        }
+        if (ch & 0x80000000u) {   /* dead key: show its base character anyway */
+            w[0] = (wchar_t)(ch & 0xFFFF);
+            const int nb = WideCharToMultiByte(CP_UTF8, 0, w, 1, out, (int)cap - 1, NULL, NULL);
+            if (nb > 0) { out[nb] = 0; return (size_t)nb; }
+        }
+    }
+#endif
+#ifdef PS3_WASM
+    if ((!e || e->layout) && code && code < HK_MOUSE_LEFT) {
+        const char* k = web_layout_key(code);
+        if (k) { snprintf(out, cap, "%s", k); return strlen(out); }
+    }
+#endif
+    if (!e) return 0;
+    snprintf(out, cap, "%s", e->name);
+    return strlen(out);
+}
+
+/* ---------------------------------------------------------------------------
+ * State
+ * -----------------------------------------------------------------------*/
+
+static volatile unsigned char s_down[HK_CODES];
+static volatile uint32_t s_presses;
+static volatile int s_seen;
+
+/* wheel: notches queue up and are handed out as short presses */
+#define HK_WHEEL_PRESS_MS   60
+#define HK_WHEEL_GAP_MS     50
+#define HK_WHEEL_MAX_QUEUE  6
+static volatile int s_wheel_queue[2];
+static unsigned long long s_wheel_until[2];
+static int s_wheel_on[2];
+
+static unsigned long long hk_now_ms(void)
+{
+#ifdef _WIN32
+    return (unsigned long long)GetTickCount64();
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000ull + (unsigned long long)ts.tv_nsec / 1000000ull;
+#endif
+}
+
+static int wheel_down(int i)
+{
+    const unsigned long long now = hk_now_ms();
+    if (s_wheel_on[i]) {
+        if (now >= s_wheel_until[i]) { s_wheel_on[i] = 0; s_wheel_until[i] = now + HK_WHEEL_GAP_MS; }
+    } else if (s_wheel_queue[i] > 0 && now >= s_wheel_until[i]) {
+        s_wheel_queue[i]--;
+        s_wheel_on[i] = 1;
+        s_wheel_until[i] = now + HK_WHEEL_PRESS_MS;
+    }
+    return s_wheel_on[i];
+}
+
+#ifdef PS3_WASM
+/* Browser wheel: the page adds notches to ps3_web_input.wheel_y (cumulative, + = up); every new notch is
+ * queued exactly like a WM_MOUSEWHEEL notch on Windows. The exchange makes concurrent pollers consume a
+ * delta once. */
+static int32_t s_web_wheel_last;
+static void web_wheel_pump(void)
+{
+    const int32_t now = __atomic_load_n(&ps3_web_input_state()->wheel_y, __ATOMIC_RELAXED);
+    const int32_t prev = __atomic_exchange_n(&s_web_wheel_last, now, __ATOMIC_RELAXED);
+    const int32_t d = (int32_t)((uint32_t)now - (uint32_t)prev);
+    int i, n;
+    if (!d) return;
+    s_seen = 1;
+    i = d > 0 ? 0 : 1;
+    n = d > 0 ? (d < HK_WHEEL_MAX_QUEUE ? d : HK_WHEEL_MAX_QUEUE)
+              : (d > -HK_WHEEL_MAX_QUEUE ? -d : HK_WHEEL_MAX_QUEUE);
+    while (n-- && s_wheel_queue[i] < HK_WHEEL_MAX_QUEUE) { s_wheel_queue[i]++; s_presses++; }
+}
+#endif
+
+void host_keys_release_all(void)
+{
+    memset((void*)s_down, 0, sizeof s_down);
+    s_wheel_queue[0] = s_wheel_queue[1] = 0;
+#ifdef PS3_WASM
+    __atomic_store_n(&s_web_wheel_last, __atomic_load_n(&ps3_web_input_state()->wheel_y, __ATOMIC_RELAXED), __ATOMIC_RELAXED);
+#endif
+}
+
+uint32_t host_keys_press_count(void) { return s_presses; }
+int host_keys_seen(void) { return s_seen; }
+
+#ifdef _WIN32
+
+int host_key_down(unsigned code)
+{
+    if (code == HK_WHEEL_UP) return wheel_down(0);
+    if (code == HK_WHEEL_DOWN) return wheel_down(1);
+    return code < HK_CODES ? s_down[code] : 0;
+}
+
+static void key_set(unsigned code, int down)
+{
+    if (!code || code >= HK_CODES) return;
+    if (down && !s_down[code]) s_presses++;
+    s_down[code] = (unsigned char)(down ? 1 : 0);
+}
+
+/* WM_KEYDOWN/UP lParam -> code. Messages without a scancode (synthesized with only a
+ * virtual-key code) get the scancode the layout maps that key to. Shift: the right one
+ * has its own scancode (0x36). */
+static unsigned key_code(WPARAM vk, LPARAM lp)
+{
+    unsigned sc = (unsigned)((lp >> 16) & 0xFF);
+    unsigned ext = (lp & (1 << 24)) ? HK_EXT : 0;
+    if (!sc) {
+        const UINT m = MapVirtualKeyW((UINT)vk, MAPVK_VK_TO_VSC_EX);
+        sc = m & 0xFF;
+        ext = ((m >> 8) == 0xE0 || (m >> 8) == 0xE1) ? HK_EXT : 0;
+    }
+    if (sc == 0x45) ext = (vk == VK_NUMLOCK) ? HK_EXT : 0;   /* NumLock comes extended, Pause not */
+    if (sc == 0x2A || sc == 0x36) ext = 0;                    /* fake-shift prefixes of some keys */
+    return sc ? (sc | ext) : 0;
+}
+
+static int s_skip_button;   /* the click that activated the window is not a game input */
+
+static void mouse_button(HWND hwnd, unsigned code, int down)
+{
+    if (down && s_skip_button) { s_skip_button = 0; return; }
+    key_set(code, down);
+    if (down) SetCapture(hwnd);
+    else if (!s_down[HK_MOUSE_LEFT] && !s_down[HK_MOUSE_RIGHT] && !s_down[HK_MOUSE_MIDDLE] &&
+             !s_down[HK_MOUSE_X1] && !s_down[HK_MOUSE_X2] && GetCapture() == hwnd)
+        ReleaseCapture();
+}
+
+/* Cursor: hidden after a few seconds without mouse movement while the window has the focus
+ * (keyboard / pad play), shown again by the next movement. */
+#define HK_CURSOR_IDLE_MS 2500
+#define HK_CURSOR_TIMER   0x7E11
+static unsigned long long s_mouse_moved;
+static int s_cursor_hidden;
+static int s_last_x = -100000, s_last_y = -100000;
+
+int host_input_wndmsg(void* hwnd_, unsigned msg, uintptr_t wp, intptr_t lp)
+{
+    HWND hwnd = (HWND)hwnd_;
+    switch (msg) {
+    case WM_CREATE:
+        SetTimer(hwnd, HK_CURSOR_TIMER, 500, NULL);
+        return 0;
+    case WM_KEYDOWN: case WM_SYSKEYDOWN:
+        s_seen = 1;
+        /* Alt+<key> is a system shortcut (Alt+Enter fullscreen, Alt+F4, Alt+Tab), not a game key */
+        if (!(msg == WM_SYSKEYDOWN && (lp & (1 << 29)) && wp != VK_MENU))
+            key_set(key_code((WPARAM)wp, (LPARAM)lp), 1);
+        /* Alt / F10 alone: no menu mode. Alt+F4 still closes, Alt+Space still opens the system menu. */
+        return msg == WM_SYSKEYDOWN && (wp == VK_MENU || wp == VK_F10);
+    case WM_KEYUP: case WM_SYSKEYUP: {
+        const unsigned c = key_code((WPARAM)wp, (LPARAM)lp);
+        key_set(c, 0);
+        /* both Shift keys up when Windows reports only one release (it does when both were down) */
+        if (wp == VK_SHIFT) {
+            if (!(GetKeyState(VK_LSHIFT) & 0x8000)) key_set(0x2A, 0);
+            if (!(GetKeyState(VK_RSHIFT) & 0x8000)) key_set(0x36, 0);
+        }
+        return msg == WM_SYSKEYUP && (wp == VK_MENU || wp == VK_F10);
+    }
+    case WM_SYSCHAR:
+        return wp != ' ';   /* no beep for Alt+<key>; Alt+Space keeps the system menu */
+    case WM_KILLFOCUS:
+        host_keys_release_all();
+        return 0;
+    case WM_ACTIVATEAPP:
+        if (!wp) host_keys_release_all();
+        return 0;
+    case WM_ACTIVATE:
+        if (LOWORD(wp) == WA_INACTIVE) host_keys_release_all();
+        return 0;
+    case WM_MOUSEACTIVATE:
+        if (GetForegroundWindow() != hwnd) s_skip_button = 1;
+        return 0;
+    case WM_LBUTTONDOWN: case WM_LBUTTONDBLCLK: s_seen = 1; mouse_button(hwnd, HK_MOUSE_LEFT, 1); return 0;
+    case WM_LBUTTONUP:   mouse_button(hwnd, HK_MOUSE_LEFT, 0); return 0;
+    case WM_RBUTTONDOWN: case WM_RBUTTONDBLCLK: s_seen = 1; mouse_button(hwnd, HK_MOUSE_RIGHT, 1); return 0;
+    case WM_RBUTTONUP:   mouse_button(hwnd, HK_MOUSE_RIGHT, 0); return 0;
+    case WM_MBUTTONDOWN: case WM_MBUTTONDBLCLK: s_seen = 1; mouse_button(hwnd, HK_MOUSE_MIDDLE, 1); return 0;
+    case WM_MBUTTONUP:   mouse_button(hwnd, HK_MOUSE_MIDDLE, 0); return 0;
+    case WM_XBUTTONDOWN: case WM_XBUTTONDBLCLK:
+        s_seen = 1;
+        mouse_button(hwnd, HIWORD(wp) == XBUTTON1 ? HK_MOUSE_X1 : HK_MOUSE_X2, 1);
+        return 0;
+    case WM_XBUTTONUP:
+        mouse_button(hwnd, HIWORD(wp) == XBUTTON1 ? HK_MOUSE_X1 : HK_MOUSE_X2, 0);
+        return 0;
+    case WM_MOUSEWHEEL: {
+        const int notches = (short)HIWORD(wp) / WHEEL_DELTA;
+        const int i = notches > 0 ? 0 : 1;
+        int n = notches > 0 ? notches : -notches;
+        s_seen = 1;
+        if (!n) return 0;
+        while (n-- && s_wheel_queue[i] < HK_WHEEL_MAX_QUEUE) { s_wheel_queue[i]++; s_presses++; }
+        return 0;
+    }
+    case WM_MOUSEMOVE: {
+        const int x = (short)LOWORD(lp), y = (short)HIWORD(lp);
+        if (x != s_last_x || y != s_last_y) {   /* Windows repeats WM_MOUSEMOVE without motion */
+            s_last_x = x; s_last_y = y;
+            s_mouse_moved = GetTickCount64();
+            if (s_cursor_hidden) { s_cursor_hidden = 0; SetCursor(LoadCursor(NULL, IDC_ARROW)); }
+        }
+        return 0;
+    }
+    case WM_TIMER:
+        if (wp == HK_CURSOR_TIMER && !s_cursor_hidden && GetForegroundWindow() == hwnd &&
+            GetTickCount64() - s_mouse_moved > HK_CURSOR_IDLE_MS) {
+            POINT pt; RECT rc;
+            if (GetCursorPos(&pt) && ScreenToClient(hwnd, &pt) && GetClientRect(hwnd, &rc) && PtInRect(&rc, pt)) {
+                s_cursor_hidden = 1;
+                SetCursor(NULL);
+            }
+        }
+        return wp == HK_CURSOR_TIMER;
+    case WM_SETCURSOR:
+        if (LOWORD(lp) == HTCLIENT && s_cursor_hidden) { SetCursor(NULL); return 1; }
+        return 0;
+    }
+    return 0;
+}
+
+#else /* POSIX: SDL2 keyboard state (web: the same subset over the page's input state) */
+
+#ifdef PS3_WASM
+#include "web_sdl_keys.h"
+#else
+#include <SDL2/SDL.h>
+#endif
+
+/* set-1 code -> SDL scancode (USB HID usage) for the named keys */
+static int sdl_scancode(unsigned code)
+{
+    static const struct { unsigned short c; unsigned short s; } t[] = {
+        {0x01,SDL_SCANCODE_ESCAPE},{0x02,SDL_SCANCODE_1},{0x03,SDL_SCANCODE_2},{0x04,SDL_SCANCODE_3},
+        {0x05,SDL_SCANCODE_4},{0x06,SDL_SCANCODE_5},{0x07,SDL_SCANCODE_6},{0x08,SDL_SCANCODE_7},
+        {0x09,SDL_SCANCODE_8},{0x0A,SDL_SCANCODE_9},{0x0B,SDL_SCANCODE_0},{0x0C,SDL_SCANCODE_MINUS},
+        {0x0D,SDL_SCANCODE_EQUALS},{0x0E,SDL_SCANCODE_BACKSPACE},{0x0F,SDL_SCANCODE_TAB},{0x10,SDL_SCANCODE_Q},
+        {0x11,SDL_SCANCODE_W},{0x12,SDL_SCANCODE_E},{0x13,SDL_SCANCODE_R},{0x14,SDL_SCANCODE_T},
+        {0x15,SDL_SCANCODE_Y},{0x16,SDL_SCANCODE_U},{0x17,SDL_SCANCODE_I},{0x18,SDL_SCANCODE_O},
+        {0x19,SDL_SCANCODE_P},{0x1A,SDL_SCANCODE_LEFTBRACKET},{0x1B,SDL_SCANCODE_RIGHTBRACKET},
+        {0x1C,SDL_SCANCODE_RETURN},{0x1D,SDL_SCANCODE_LCTRL},{0x1E,SDL_SCANCODE_A},{0x1F,SDL_SCANCODE_S},
+        {0x20,SDL_SCANCODE_D},{0x21,SDL_SCANCODE_F},{0x22,SDL_SCANCODE_G},{0x23,SDL_SCANCODE_H},
+        {0x24,SDL_SCANCODE_J},{0x25,SDL_SCANCODE_K},{0x26,SDL_SCANCODE_L},{0x27,SDL_SCANCODE_SEMICOLON},
+        {0x28,SDL_SCANCODE_APOSTROPHE},{0x29,SDL_SCANCODE_GRAVE},{0x2A,SDL_SCANCODE_LSHIFT},
+        {0x2B,SDL_SCANCODE_BACKSLASH},{0x2C,SDL_SCANCODE_Z},{0x2D,SDL_SCANCODE_X},{0x2E,SDL_SCANCODE_C},
+        {0x2F,SDL_SCANCODE_V},{0x30,SDL_SCANCODE_B},{0x31,SDL_SCANCODE_N},{0x32,SDL_SCANCODE_M},
+        {0x33,SDL_SCANCODE_COMMA},{0x34,SDL_SCANCODE_PERIOD},{0x35,SDL_SCANCODE_SLASH},
+        {0x36,SDL_SCANCODE_RSHIFT},{0x37,SDL_SCANCODE_KP_MULTIPLY},{0x38,SDL_SCANCODE_LALT},
+        {0x39,SDL_SCANCODE_SPACE},{0x3A,SDL_SCANCODE_CAPSLOCK},{0x3B,SDL_SCANCODE_F1},{0x3C,SDL_SCANCODE_F2},
+        {0x3D,SDL_SCANCODE_F3},{0x3E,SDL_SCANCODE_F4},{0x3F,SDL_SCANCODE_F5},{0x40,SDL_SCANCODE_F6},
+        {0x41,SDL_SCANCODE_F7},{0x42,SDL_SCANCODE_F8},{0x43,SDL_SCANCODE_F9},{0x44,SDL_SCANCODE_F10},
+        {0x46,SDL_SCANCODE_SCROLLLOCK},{0x47,SDL_SCANCODE_KP_7},{0x48,SDL_SCANCODE_KP_8},{0x49,SDL_SCANCODE_KP_9},
+        {0x4A,SDL_SCANCODE_KP_MINUS},{0x4B,SDL_SCANCODE_KP_4},{0x4C,SDL_SCANCODE_KP_5},{0x4D,SDL_SCANCODE_KP_6},
+        {0x4E,SDL_SCANCODE_KP_PLUS},{0x4F,SDL_SCANCODE_KP_1},{0x50,SDL_SCANCODE_KP_2},{0x51,SDL_SCANCODE_KP_3},
+        {0x52,SDL_SCANCODE_KP_0},{0x53,SDL_SCANCODE_KP_PERIOD},{0x56,SDL_SCANCODE_NONUSBACKSLASH},
+        {0x57,SDL_SCANCODE_F11},{0x58,SDL_SCANCODE_F12},
+        {HK_EXT|0x1C,SDL_SCANCODE_KP_ENTER},{HK_EXT|0x1D,SDL_SCANCODE_RCTRL},{HK_EXT|0x35,SDL_SCANCODE_KP_DIVIDE},
+        {HK_EXT|0x38,SDL_SCANCODE_RALT},{HK_EXT|0x45,SDL_SCANCODE_NUMLOCKCLEAR},{HK_EXT|0x47,SDL_SCANCODE_HOME},
+        {HK_EXT|0x48,SDL_SCANCODE_UP},{HK_EXT|0x49,SDL_SCANCODE_PAGEUP},{HK_EXT|0x4B,SDL_SCANCODE_LEFT},
+        {HK_EXT|0x4D,SDL_SCANCODE_RIGHT},{HK_EXT|0x4F,SDL_SCANCODE_END},{HK_EXT|0x50,SDL_SCANCODE_DOWN},
+        {HK_EXT|0x51,SDL_SCANCODE_PAGEDOWN},{HK_EXT|0x52,SDL_SCANCODE_INSERT},{HK_EXT|0x53,SDL_SCANCODE_DELETE},
+        {HK_EXT|0x5D,SDL_SCANCODE_APPLICATION},
+    };
+    size_t i;
+    for (i = 0; i < sizeof t / sizeof t[0]; i++)
+        if (t[i].c == code) return t[i].s;
+    return -1;
+}
+
+int host_key_down(unsigned code)
+{
+    if (!SDL_WasInit(SDL_INIT_VIDEO)) return 0;
+    if (code >= HK_MOUSE_LEFT) {
+        const Uint32 b = SDL_GetMouseState(NULL, NULL);
+        switch (code) {
+        case HK_MOUSE_LEFT:   return (b & SDL_BUTTON(SDL_BUTTON_LEFT)) != 0;
+        case HK_MOUSE_RIGHT:  return (b & SDL_BUTTON(SDL_BUTTON_RIGHT)) != 0;
+        case HK_MOUSE_MIDDLE: return (b & SDL_BUTTON(SDL_BUTTON_MIDDLE)) != 0;
+        case HK_MOUSE_X1:     return (b & SDL_BUTTON(SDL_BUTTON_X1)) != 0;
+        case HK_MOUSE_X2:     return (b & SDL_BUTTON(SDL_BUTTON_X2)) != 0;
+#ifdef PS3_WASM
+        case HK_WHEEL_UP:     web_wheel_pump(); return wheel_down(0);
+        case HK_WHEEL_DOWN:   web_wheel_pump(); return wheel_down(1);
+#endif
+        default:              return 0;   /* wheel: needs the event pump (not wired on POSIX) */
+        }
+    }
+    const int s = sdl_scancode(code);
+    const Uint8* k = SDL_GetKeyboardState(NULL);
+    if (s < 0 || !k) return 0;
+    if (k[s]) { s_seen = 1; return 1; }
+    return 0;
+}
+
+#endif
diff --git a/libs/input/host_input.h b/libs/input/host_input.h
new file mode 100644
index 00000000..8f8313b9
--- /dev/null
+++ b/libs/input/host_input.h
@@ -0,0 +1,75 @@
+/*
+ * ps3recomp - host keyboard + mouse of the game window (keyboard play, cellPad.c)
+ *
+ * The keys come from the game window's own messages (host_input_wndmsg, called
+ * by the window procedure), not from the global keyboard state: Windows sends
+ * key messages only to the window that has the keyboard focus, so typing in
+ * another program -- or playing another game -- never reaches the port, and a
+ * key held while the focus leaves is released (WM_KILLFOCUS / WM_ACTIVATEAPP).
+ * A tool can still drive a test window that runs in the background by posting
+ * WM_KEYDOWN / WM_KEYUP to it (the focus stays where it is).
+ *
+ * KEY CODES are physical keys, the same on every keyboard layout:
+ *   the PC/AT set-1 scancode, | 0x100 for E0-extended keys (arrows, Insert..
+ *   PageDown, right Ctrl/Alt, keypad Enter and /), and mouse pseudo keys from
+ *   0x200 (HK_MOUSE_*, HK_WHEEL_*). 0 = no key.
+ * KEY NAMES (host_key_parse / host_key_name) are those keys' places on a US
+ * keyboard: "W" is the key left of E wherever the layout puts the letter W
+ * (Z on AZERTY), so a WASD binding stays a hand position. host_key_label()
+ * gives what the key says on the user's own layout (for prompts and menus).
+ */
+#ifndef PS3RECOMP_HOST_INPUT_H
+#define PS3RECOMP_HOST_INPUT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    HK_EXT          = 0x100,   /* E0-extended scancode flag */
+    HK_MOUSE_LEFT   = 0x200,
+    HK_MOUSE_RIGHT  = 0x201,
+    HK_MOUSE_MIDDLE = 0x202,
+    HK_MOUSE_X1     = 0x203,   /* "back" side button */
+    HK_MOUSE_X2     = 0x204,   /* "forward" side button */
+    HK_WHEEL_UP     = 0x205,   /* one short press per wheel notch */
+    HK_WHEEL_DOWN   = 0x206,
+    HK_CODES        = 0x207
+};
+
+/* 1 while the key is held. Wheel codes: a ~60 ms press (then a release) per notch. */
+int  host_key_down(unsigned code);
+/* Release every key and button (focus loss). */
+void host_keys_release_all(void);
+/* Number of key / mouse-button presses seen so far (wheel notches included). */
+uint32_t host_keys_press_count(void);
+/* 1 once the game window has received any key or mouse message (keyboard play is possible). */
+int  host_keys_seen(void);
+
+/* Name -> codes. Returns the number of codes written to out[0..1] (2 for "Shift" / "Ctrl" /
+ * "Alt" = left and right), 0 for an unknown name. Case-insensitive; n = name length. */
+int  host_key_parse(const char* name, size_t n, unsigned out[2]);
+/* Canonical name (US place) of a code, or NULL. */
+const char* host_key_name(unsigned code);
+/* What the key says on the user's layout, UTF-8 ("W", "Space", "Left Shift", ...): the
+ * canonical name for keys whose name does not depend on the layout, else the layout's
+ * character. Returns the length written (0 = unknown code). */
+size_t host_key_label(unsigned code, char* out, size_t cap);
+
+#ifdef _WIN32
+/* Every message of the game window goes through here (from its window procedure, before
+ * any handling of its own). Returns 1 when the message must not reach DefWindowProc:
+ * Alt and F10 alone would open the window's menu mode and swallow the next key presses
+ * (Alt+F4 still closes the window). */
+int  host_input_wndmsg(void* hwnd, unsigned msg, uintptr_t wp, intptr_t lp);
+#else
+/* POSIX (SDL2 window): the keyboard state is read from SDL; nothing to feed. */
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3RECOMP_HOST_INPUT_H */
diff --git a/libs/input/pad_keyboard.c b/libs/input/pad_keyboard.c
new file mode 100644
index 00000000..1e184824
--- /dev/null
+++ b/libs/input/pad_keyboard.c
@@ -0,0 +1,286 @@
+/*
+ * ps3recomp - keyboard (and mouse buttons) as the pad on port 0
+ *
+ * Every PS3 input -- the 16 buttons and the 8 stick directions -- has a list
+ * of up to PAD_KB_MAX_KEYS keys (host_input.h codes: physical keys, any
+ * layout). A key may sit in several lists: it then presses all of them (one
+ * key for L3+R3, say). The table is built once from, in order:
+ *   1. the built-in default below;
+ *   2. the [keyboard] section of input.ini next to the executable
+ *      (PS3_INPUT_INI=<file> names another file);
+ *   3. the environment: PS3_KEYS="cross=Space,Enter;square=J;l3=LShift,F"
+ *      (read from the process environment block, so a ps3mod plugin may set
+ *      it during ps3mod_init).
+ * A later source replaces the whole key list of every input it names; "none"
+ * unbinds. Key names: host_input.c (US places, e.g. W A S D, Space, LShift,
+ * Up, Num8, MouseLeft, WheelUp, or sc:<hex scancode>).
+ *
+ * The keys come from the game window's messages (host_input.c), so they only
+ * reach the game while its window has the focus. PAD_NO_KEYBOARD=1 (any value
+ * but 0) turns keyboard play off.
+ */
+#include "pad_keyboard.h"
+#include "host_input.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#  ifndef WIN32_LEAN_AND_MEAN
+#    define WIN32_LEAN_AND_MEAN
+#  endif
+#  include <windows.h>
+#endif
+
+const char* const pad_kb_input_names[PAD_KB_INPUTS] = {
+    "cross", "circle", "square", "triangle", "l1", "r1", "l2", "r2", "l3", "r3", "start", "select",
+    "up", "down", "left", "right",
+    "ls_up", "ls_down", "ls_left", "ls_right", "rs_up", "rs_down", "rs_left", "rs_right",
+};
+
+/* CELL_PAD_CTRL_* of the button inputs (sticks: 0) */
+static const uint16_t s_btn_mask[PAD_KB_INPUTS] = {
+    1u << 14, 1u << 13, 1u << 15, 1u << 12, 1u << 10, 1u << 11, 1u << 8, 1u << 9, 1u << 1, 1u << 2,
+    1u << 3, 1u << 0, 1u << 4, 1u << 6, 1u << 7, 1u << 5,
+};
+
+/* The default layout (README of the port / docs/CONTROLS):
+ *   left stick W A S D, d-pad = arrow keys (menus), face buttons on the right hand
+ *   as the PS3 diamond -- I triangle, J square, L circle, K cross -- with Space as
+ *   the thumb's Cross (ollie), Q/E = L1/R1, U/O = L2/R2, LShift = L3, F = L3+R3,
+ *   the right stick on the keypad, Esc = START, Tab = SELECT; Enter / left click
+ *   = Cross and Backspace / right click = Triangle (accept / back in menus), the
+ *   wheel scrolls (d-pad up / down). */
+static const char s_default_spec[] =
+    "cross=Space,Enter,K,MouseLeft;"
+    "circle=L;"
+    "square=J;"
+    "triangle=I,Backspace,MouseRight;"
+    "l1=Q;r1=E;l2=U;r2=O;"
+    "l3=LShift,F;r3=F;"
+    "start=Esc;select=Tab;"
+    "up=Up,WheelUp;down=Down,WheelDown;left=Left;right=Right;"
+    "ls_up=W;ls_down=S;ls_left=A;ls_right=D;"
+    "rs_up=Num8;rs_down=Num5,Num2;rs_left=Num4;rs_right=Num6";
+
+static uint16_t s_map[PAD_KB_INPUTS][PAD_KB_MAX_KEYS];
+static volatile int s_loaded;
+static int s_off;
+
+/* Parse "input=key,key;input=..." (also one "input = key, key" per line in an ini) into map.
+ * Unknown inputs / keys are reported once and skipped. Returns the number of problems. */
+static int parse_spec(uint16_t map[PAD_KB_INPUTS][PAD_KB_MAX_KEYS], const char* spec, const char* where)
+{
+    int bad = 0;
+    const char* p = spec;
+    while (p && *p) {
+        while (*p == ' ' || *p == '\t' || *p == ';' || *p == '\r' || *p == '\n') p++;
+        if (!*p) break;
+        const char* k = p;
+        while (*p && *p != '=' && *p != ';' && *p != '\n') p++;
+        if (*p != '=') { bad++; while (*p && *p != ';' && *p != '\n') p++; continue; }
+        const char* ke = p;
+        while (ke > k && (ke[-1] == ' ' || ke[-1] == '\t')) ke--;
+        p++;
+        int in = -1;
+        for (int i = 0; i < PAD_KB_INPUTS && in < 0; i++) {
+            const char* nm = pad_kb_input_names[i];
+            if (strlen(nm) == (size_t)(ke - k)) {
+                int eq = 1;
+                for (size_t j = 0; j < (size_t)(ke - k) && eq; j++) {
+                    char c = k[j];
+                    if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+                    if (c != nm[j]) eq = 0;
+                }
+                if (eq) in = i;
+            }
+        }
+        uint16_t keys[PAD_KB_MAX_KEYS];
+        int nk = 0, none = 0;
+        while (*p && *p != ';' && *p != '\n') {
+            while (*p == ' ' || *p == '\t' || *p == ',' || *p == '+' || *p == '\r') p++;
+            if (!*p || *p == ';' || *p == '\n') break;
+            const char* v = p;
+            /* a key name never contains ',', ';', whitespace; a lone "," / ";" is spelled Comma / Semicolon */
+            while (*p && *p != ',' && *p != ';' && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n') p++;
+            const size_t vn = (size_t)(p - v);
+            if (vn == 4 && (v[0] | 32) == 'n' && (v[1] | 32) == 'o' && (v[2] | 32) == 'n' && (v[3] | 32) == 'e') {
+                none = 1;
+                continue;
+            }
+            unsigned codes[2];
+            const int nc = host_key_parse(v, vn, codes);
+            if (!nc) {
+                printf("[cellPad] keyboard (%s): unknown key '%.*s' (skipped)\n", where, (int)vn, v);
+                bad++;
+                continue;
+            }
+            for (int c = 0; c < nc; c++) {
+                int dup = 0;
+                for (int j = 0; j < nk; j++) dup |= keys[j] == codes[c];
+                if (dup) continue;
+                if (nk < PAD_KB_MAX_KEYS) keys[nk++] = (uint16_t)codes[c];
+                else { printf("[cellPad] keyboard (%s): '%s' has more than %d keys (rest skipped)\n", where,
+                              in >= 0 ? pad_kb_input_names[in] : "?", PAD_KB_MAX_KEYS); bad++; }
+            }
+        }
+        if (in < 0) {
+            printf("[cellPad] keyboard (%s): unknown input '%.*s' (skipped)\n", where, (int)(ke - k), k);
+            bad++;
+            continue;
+        }
+        (void)none;
+        memset(map[in], 0, sizeof map[in]);
+        for (int j = 0; j < nk; j++) map[in][j] = keys[j];
+    }
+    return bad;
+}
+
+#ifdef _WIN32
+static int env_get(const char* name, char* buf, size_t cap)
+{
+    const DWORD n = GetEnvironmentVariableA(name, buf, (DWORD)cap);
+    if (!n || n >= cap) { if (cap) buf[0] = 0; return 0; }
+    return 1;
+}
+#else
+static int env_get(const char* name, char* buf, size_t cap)
+{
+    const char* v = getenv(name);
+    if (!v || strlen(v) >= cap) { if (cap) buf[0] = 0; return 0; }
+    strcpy(buf, v);
+    return 1;
+}
+#endif
+
+/* [keyboard] of input.ini -> a spec string ("k=v;k=v"). */
+static int read_ini(char* out, size_t cap, char* path, size_t pcap)
+{
+    if (!env_get("PS3_INPUT_INI", path, pcap)) {
+#ifdef _WIN32
+        char exe[MAX_PATH];
+        const DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+        if (!n || n >= MAX_PATH) return 0;
+        char* s = strrchr(exe, '\\');
+        if (!s) return 0;
+        strcpy(s + 1, "input.ini");
+        snprintf(path, pcap, "%s", exe);
+#else
+        snprintf(path, pcap, "input.ini");
+#endif
+    }
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    char line[512];
+    int in_kb = 0;
+    size_t len = 0;
+    out[0] = 0;
+    while (fgets(line, sizeof line, f)) {
+        char* s = line;
+        if ((unsigned char)s[0] == 0xEF && (unsigned char)s[1] == 0xBB && (unsigned char)s[2] == 0xBF) s += 3;
+        while (*s == ' ' || *s == '\t') s++;
+        char* e = s + strlen(s);
+        while (e > s && (e[-1] == '\n' || e[-1] == '\r' || e[-1] == ' ' || e[-1] == '\t')) *--e = 0;
+        if (!*s || *s == '#' || *s == ';') continue;
+        if (*s == '[') {
+            in_kb = strncmp(s, "[keyboard]", 10) == 0;
+            continue;
+        }
+        if (!in_kb) continue;
+        /* inline comment: " ; ..." or " # ..." after the value */
+        for (char* c = s; *c; c++)
+            if ((*c == ';' || *c == '#') && c > s && (c[-1] == ' ' || c[-1] == '\t')) { *c = 0; break; }
+        const size_t n = strlen(s);
+        if (len + n + 2 >= cap) break;
+        memcpy(out + len, s, n);
+        len += n;
+        out[len++] = ';';
+        out[len] = 0;
+    }
+    fclose(f);
+    return 1;
+}
+
+void pad_kb_load(void)
+{
+    if (s_loaded) return;
+    char v[8];
+    s_off = env_get("PAD_NO_KEYBOARD", v, sizeof v) && !(v[0] == '0' && !v[1]);
+    uint16_t map[PAD_KB_INPUTS][PAD_KB_MAX_KEYS];
+    memset(map, 0, sizeof map);
+    parse_spec(map, s_default_spec, "default");
+    static char ini[8192], path[1024], envs[4096];
+    if (read_ini(ini, sizeof ini, path, sizeof path)) {
+        parse_spec(map, ini, "input.ini");
+        printf("[cellPad] keyboard: %s applied\n", path);
+    }
+    if (env_get("PS3_KEYS", envs, sizeof envs) && envs[0]) {
+        parse_spec(map, envs, "PS3_KEYS");
+        printf("[cellPad] keyboard: PS3_KEYS applied\n");
+    }
+    memcpy(s_map, map, sizeof s_map);
+    s_loaded = 1;
+    if (s_off) printf("[cellPad] keyboard play off (PAD_NO_KEYBOARD)\n");
+}
+
+int pad_kb_enabled(void)
+{
+    pad_kb_load();
+    return !s_off;
+}
+
+void pad_kb_bindings(uint16_t out[PAD_KB_INPUTS][PAD_KB_MAX_KEYS])
+{
+    pad_kb_load();
+    memcpy(out, s_map, sizeof s_map);
+}
+
+/* One axis from two opposite inputs: the one pressed last wins while both are held (a
+ * keyboard player rolls from A to D without lifting A). Returns -1, 0, +1. */
+typedef struct { int last; int prev_neg, prev_pos; } axis_t;
+
+static int axis_eval(axis_t* a, int neg, int pos)
+{
+    if (neg && !a->prev_neg) a->last = -1;
+    if (pos && !a->prev_pos) a->last = +1;
+    a->prev_neg = neg; a->prev_pos = pos;
+    if (neg && pos) return a->last;
+    return pos - neg;
+}
+
+static uint8_t stick_val(int d, int diag)
+{
+    /* full deflection (0 / 255); on a diagonal both axes at 1/sqrt(2), like a round stick gate */
+    if (!d) return 0x80;
+    if (diag) return (uint8_t)(d < 0 ? 128 - 90 : 128 + 90);
+    return (uint8_t)(d < 0 ? 0 : 255);
+}
+
+int pad_kb_poll(pad_kb_state* st)
+{
+    static axis_t ax[4];   /* lx ly rx ry */
+    static uint32_t prev_held;
+    memset(st, 0, sizeof *st);
+    st->lx = st->ly = st->rx = st->ry = 0x80;
+    pad_kb_load();
+    if (s_off) return 0;
+    uint32_t held = 0;
+    for (int i = 0; i < PAD_KB_INPUTS; i++)
+        for (int j = 0; j < PAD_KB_MAX_KEYS && s_map[i][j]; j++)
+            if (host_key_down(s_map[i][j])) { held |= 1u << i; break; }
+    for (int i = 0; i < PAD_KB_BUTTONS; i++)
+        if (held & (1u << i)) st->buttons |= s_btn_mask[i];
+    const int lx = axis_eval(&ax[0], !!(held & (1u << PAD_KB_IN_LS_LEFT)), !!(held & (1u << PAD_KB_IN_LS_RIGHT)));
+    const int ly = axis_eval(&ax[1], !!(held & (1u << PAD_KB_IN_LS_UP)), !!(held & (1u << PAD_KB_IN_LS_DOWN)));
+    const int rx = axis_eval(&ax[2], !!(held & (1u << PAD_KB_IN_RS_LEFT)), !!(held & (1u << PAD_KB_IN_RS_RIGHT)));
+    const int ry = axis_eval(&ax[3], !!(held & (1u << PAD_KB_IN_RS_UP)), !!(held & (1u << PAD_KB_IN_RS_DOWN)));
+    st->lx = stick_val(lx, lx && ly); st->ly = stick_val(ly, lx && ly);
+    st->rx = stick_val(rx, rx && ry); st->ry = stick_val(ry, rx && ry);
+    st->lstick = (lx || ly);
+    st->rstick = (rx || ry);
+    st->pressed = (held & ~prev_held) != 0;
+    st->held = held != 0;
+    prev_held = held;
+    return 1;
+}
diff --git a/libs/input/pad_keyboard.h b/libs/input/pad_keyboard.h
new file mode 100644
index 00000000..741f80ea
--- /dev/null
+++ b/libs/input/pad_keyboard.h
@@ -0,0 +1,49 @@
+/*
+ * ps3recomp - keyboard (and mouse buttons) as the pad on port 0. See pad_keyboard.c.
+ */
+#ifndef PS3RECOMP_PAD_KEYBOARD_H
+#define PS3RECOMP_PAD_KEYBOARD_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* PS3 inputs a key can drive; same order as ps3mod.h PS3MOD_IN_*. */
+enum {
+    PAD_KB_IN_CROSS, PAD_KB_IN_CIRCLE, PAD_KB_IN_SQUARE, PAD_KB_IN_TRIANGLE,
+    PAD_KB_IN_L1, PAD_KB_IN_R1, PAD_KB_IN_L2, PAD_KB_IN_R2, PAD_KB_IN_L3, PAD_KB_IN_R3,
+    PAD_KB_IN_START, PAD_KB_IN_SELECT,
+    PAD_KB_IN_UP, PAD_KB_IN_DOWN, PAD_KB_IN_LEFT, PAD_KB_IN_RIGHT,          /* d-pad */
+    PAD_KB_IN_LS_UP, PAD_KB_IN_LS_DOWN, PAD_KB_IN_LS_LEFT, PAD_KB_IN_LS_RIGHT,
+    PAD_KB_IN_RS_UP, PAD_KB_IN_RS_DOWN, PAD_KB_IN_RS_LEFT, PAD_KB_IN_RS_RIGHT,
+    PAD_KB_INPUTS,
+    PAD_KB_BUTTONS = PAD_KB_IN_LS_UP
+};
+#define PAD_KB_MAX_KEYS 4
+
+extern const char* const pad_kb_input_names[PAD_KB_INPUTS];
+
+typedef struct pad_kb_state {
+    uint16_t buttons;          /* CELL_PAD_CTRL_* */
+    uint8_t  lx, ly, rx, ry;   /* 0x80 = centred */
+    uint8_t  lstick, rstick;   /* a stick key is held */
+    uint8_t  held;             /* any bound key is held */
+    uint8_t  pressed;          /* a bound key went down since the previous poll */
+} pad_kb_state;
+
+/* Build the binding table (default, input.ini, PS3_KEYS) once; later calls do nothing. */
+void pad_kb_load(void);
+/* 1 unless PAD_NO_KEYBOARD turned keyboard play off. */
+int  pad_kb_enabled(void);
+/* The effective table: out[input][0..PAD_KB_MAX_KEYS-1], 0 = unused slot. */
+void pad_kb_bindings(uint16_t out[PAD_KB_INPUTS][PAD_KB_MAX_KEYS]);
+/* Current keyboard pad state. Returns 0 (state idle) when keyboard play is off. One caller
+ * (the pad poller): press edges are relative to the previous call. */
+int  pad_kb_poll(pad_kb_state* st);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/input/tests/pad_keyboard_test.c b/libs/input/tests/pad_keyboard_test.c
new file mode 100644
index 00000000..1887a4c5
--- /dev/null
+++ b/libs/input/tests/pad_keyboard_test.c
@@ -0,0 +1,109 @@
+/*
+ * ps3recomp - unit test for keyboard play (host_input.c key names / window messages,
+ * pad_keyboard.c bindings and stick logic) and cellPad's analog conventions (XInput stick ->
+ * PS3 byte, PS3_PAD_INVERT mirror). No window, no controller, no guest. Windows only.
+ *
+ *   clang-cl -nologo -O1 -D_CRT_SECURE_NO_WARNINGS -I. -Iinclude libs/input/tests/pad_keyboard_test.c user32.lib
+ *   pad_keyboard_test.exe        -> "pad_keyboard_test: N checks, 0 failed", exit 0
+ */
+#include <stdint.h>
+#include <stdio.h>
+
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void cellGcm_inputlat_poll(void) {}   /* cellGcmSys.c (PS3_INPUT_LAT), not linked here */
+
+#include "../cellPad.c"
+#include "../pad_keyboard.c"
+#include "../host_input.c"
+
+static int s_checks, s_failed;
+#define CHECK(cond, ...) do { s_checks++; if (!(cond)) { s_failed++; printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+                              printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static unsigned code(const char* n) { unsigned c[2] = { 0, 0 }; host_key_parse(n, strlen(n), c); return c[0]; }
+
+static void key_msg(unsigned c, int down)
+{
+    const LPARAM lp = 1 | (LPARAM)((c & 0xFF) << 16) | ((c & HK_EXT) ? (1 << 24) : 0) | (down ? 0 : (LPARAM)0xC0000000);
+    host_input_wndmsg(NULL, down ? WM_KEYDOWN : WM_KEYUP, 0, lp);
+}
+
+int main(void)
+{
+    /* ---- names */
+    CHECK(code("W") == 0x11, "W");
+    CHECK(code("space") == 0x39, "Space (case-insensitive)");
+    CHECK(code("Up") == (HK_EXT | 0x48) && code("Num8") == 0x48, "arrow vs keypad share a scancode, not a code");
+    CHECK(code("Escape") == 0x01 && code("Return") == 0x1C, "aliases");
+    CHECK(code("MouseLeft") == HK_MOUSE_LEFT && code("WheelDown") == HK_WHEEL_DOWN, "mouse");
+    CHECK(code("sc:1E") == 0x1E && code("sc:E0 48") == (HK_EXT | 0x48), "raw scancodes");
+    { unsigned c[2]; CHECK(host_key_parse("Shift", 5, c) == 2 && c[0] == 0x2A && c[1] == 0x36, "Shift = both"); }
+    CHECK(code("Bogus") == 0, "unknown name");
+    CHECK(strcmp(host_key_name(HK_EXT | 0x4B), "Left") == 0, "canonical name");
+
+    /* ---- default table + overrides */
+    uint16_t map[PAD_KB_INPUTS][PAD_KB_MAX_KEYS];
+    memset(map, 0, sizeof map);
+    parse_spec(map, s_default_spec, "test");
+    CHECK(map[PAD_KB_IN_CROSS][0] == 0x39, "cross main key = Space");
+    CHECK(map[PAD_KB_IN_SQUARE][0] == 0x24 && map[PAD_KB_IN_TRIANGLE][0] == 0x17 && map[PAD_KB_IN_CIRCLE][0] == 0x26,
+          "diamond on J I L");
+    CHECK(map[PAD_KB_IN_L3][1] == 0x21 && map[PAD_KB_IN_R3][0] == 0x21, "F presses L3 and R3");
+    CHECK(map[PAD_KB_IN_LS_UP][0] == 0x11 && map[PAD_KB_IN_UP][0] == (HK_EXT | 0x48), "WASD stick, arrows d-pad");
+    parse_spec(map, "cross = K ; square=none;l1=Q,E", "test");
+    CHECK(map[PAD_KB_IN_CROSS][0] == 0x25 && map[PAD_KB_IN_CROSS][1] == 0, "override replaces the list");
+    CHECK(map[PAD_KB_IN_SQUARE][0] == 0, "none unbinds");
+    CHECK(map[PAD_KB_IN_L1][0] == 0x10 && map[PAD_KB_IN_L1][1] == 0x12, "two keys");
+    CHECK(map[PAD_KB_IN_CIRCLE][0] == 0x26, "inputs not named keep theirs");
+
+    /* ---- window messages -> pad state */
+    s_loaded = 1; s_off = 0;
+    memset(s_map, 0, sizeof s_map);
+    parse_spec(s_map, s_default_spec, "test");
+    pad_kb_state st;
+    pad_kb_poll(&st);
+    CHECK(!st.held && st.lx == 0x80 && st.ly == 0x80, "idle");
+    key_msg(0x11, 1);                         /* W down */
+    pad_kb_poll(&st);
+    CHECK(st.ly == 0 && st.lx == 0x80 && st.pressed, "W = stick up (0), a press edge");
+    key_msg(0x20, 1);                         /* + D: diagonal */
+    pad_kb_poll(&st);
+    CHECK(st.lx == 128 + 90 && st.ly == 128 - 90, "diagonal at 1/sqrt(2): %u %u", st.lx, st.ly);
+    key_msg(0x1E, 1);                         /* + A while D held: last pressed wins */
+    pad_kb_poll(&st);
+    CHECK(st.lx < 0x80, "A after D: left wins (%u)", st.lx);
+    key_msg(0x1E, 0);
+    pad_kb_poll(&st);
+    CHECK(st.lx > 0x80, "A released: back to D (%u)", st.lx);
+    key_msg(0x39, 1);                         /* Space */
+    pad_kb_poll(&st);
+    CHECK((st.buttons & CELL_PAD_CTRL_CROSS) != 0, "Space = Cross");
+    host_input_wndmsg(NULL, WM_KILLFOCUS, 0, 0);
+    pad_kb_poll(&st);
+    CHECK(!st.held && st.buttons == 0 && st.lx == 0x80 && st.ly == 0x80, "focus loss releases everything");
+    key_msg(0x21, 1);                         /* F */
+    pad_kb_poll(&st);
+    CHECK((st.buttons & (CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_R3)) == (CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_R3), "F = L3+R3");
+    key_msg(0x21, 0);
+    host_input_wndmsg(NULL, WM_SYSKEYDOWN, VK_RETURN, 1 | (0x1C << 16) | (1 << 29));   /* Alt+Enter */
+    pad_kb_poll(&st);
+    CHECK(!(st.buttons & CELL_PAD_CTRL_CROSS), "Alt+Enter is a shortcut, not Cross");
+    host_keys_release_all();
+
+    /* ---- analog conventions (PS3: 0 = left / up, 255 = right / down) */
+    CHECK(pad_xinput_stick_to_u8(32767, PAD_STICK_DEADZONE) == 255, "XInput +X -> 255 (right)");
+    CHECK((u8)(256 - pad_xinput_stick_to_u8(32767, PAD_STICK_DEADZONE)) == 1, "XInput +Y (up) -> ~0 after the flip");
+    CHECK(pad_xinput_stick_to_u8(0, PAD_STICK_DEADZONE) == 128 && (u8)(256 - 128) == 128, "centre stays 128");
+    CHECK(pad_mirror(255) == 1 && pad_mirror(1) == 255 && pad_mirror(128) == 128 && pad_mirror(0) == 255, "mirror");
+
+    printf("pad_keyboard_test: %d checks, %d failed\n", s_checks, s_failed);
+    return s_failed ? 1 : 0;
+}
diff --git a/libs/input/tests/pad_map_test.c b/libs/input/tests/pad_map_test.c
new file mode 100644
index 00000000..b49ba572
--- /dev/null
+++ b/libs/input/tests/pad_map_test.c
@@ -0,0 +1,138 @@
+/*
+ * ps3recomp - unit test for cellPad's XInput -> PS3 button table (pad_map_load /
+ * pad_map_buttons) and the PS3_PAD_MAP parser. No controller, no guest: the
+ * mapping is a pure function of the XInput state. Windows (XInput backend) only.
+ *
+ *   clang-cl -nologo -O1 -D_CRT_SECURE_NO_WARNINGS -I. -Iinclude libs/input/tests/pad_map_test.c user32.lib
+ *   pad_map_test.exe        -> "pad_map_test: N checks, 0 failed", exit 0
+ */
+#include <stdint.h>
+#include <stdio.h>
+
+/* the few runtime globals the included cellPad.c references through ppu_memory.h */
+uint8_t* vm_base;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+
+#include "../cellPad.c"
+#include "../pad_keyboard.c"   /* keyboard play: cellPad.c calls it */
+#include "../host_input.c"
+
+static int s_checks, s_failed;
+#define CHECK(cond, ...) do { s_checks++; if (!(cond)) { s_failed++; printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+                              printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* press[] index of a PS3 button, -1 if it has no pressure word */
+static int press_index(u16 ps3)
+{
+    static const u16 order[12] = {
+        CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_UP, CELL_PAD_CTRL_DOWN,
+        CELL_PAD_CTRL_TRIANGLE, CELL_PAD_CTRL_CIRCLE, CELL_PAD_CTRL_CROSS, CELL_PAD_CTRL_SQUARE,
+        CELL_PAD_CTRL_L1, CELL_PAD_CTRL_R1, CELL_PAD_CTRL_L2, CELL_PAD_CTRL_R2 };
+    for (int j = 0; j < 12; j++) if (order[j] == ps3) return j;
+    return -1;
+}
+
+int main(void)
+{
+    u16 map[PADSRC_COUNT];
+    u8 press[12];
+    u16 b;
+
+    /* ---- default table = the PS3 layout (positions on the pad) */
+    static const struct { u16 xin; u16 ps3; const char* what; } def[] = {
+        { XINPUT_GAMEPAD_A, CELL_PAD_CTRL_CROSS, "A -> Cross" },
+        { XINPUT_GAMEPAD_B, CELL_PAD_CTRL_CIRCLE, "B -> Circle" },
+        { XINPUT_GAMEPAD_X, CELL_PAD_CTRL_SQUARE, "X -> Square" },
+        { XINPUT_GAMEPAD_Y, CELL_PAD_CTRL_TRIANGLE, "Y -> Triangle" },
+        { XINPUT_GAMEPAD_LEFT_SHOULDER, CELL_PAD_CTRL_L1, "LB -> L1" },
+        { XINPUT_GAMEPAD_RIGHT_SHOULDER, CELL_PAD_CTRL_R1, "RB -> R1" },
+        { XINPUT_GAMEPAD_LEFT_THUMB, CELL_PAD_CTRL_L3, "LS click -> L3" },
+        { XINPUT_GAMEPAD_RIGHT_THUMB, CELL_PAD_CTRL_R3, "RS click -> R3" },
+        { XINPUT_GAMEPAD_BACK, CELL_PAD_CTRL_SELECT, "View/Back -> Select" },
+        { XINPUT_GAMEPAD_START, CELL_PAD_CTRL_START, "Menu/Start -> Start" },
+        { XINPUT_GAMEPAD_DPAD_UP, CELL_PAD_CTRL_UP, "Up -> Up" },
+        { XINPUT_GAMEPAD_DPAD_DOWN, CELL_PAD_CTRL_DOWN, "Down -> Down" },
+        { XINPUT_GAMEPAD_DPAD_LEFT, CELL_PAD_CTRL_LEFT, "Left -> Left" },
+        { XINPUT_GAMEPAD_DPAD_RIGHT, CELL_PAD_CTRL_RIGHT, "Right -> Right" },
+    };
+    CHECK(pad_map_load(map, NULL) == 0, "default load reports errors");
+    CHECK(pad_map_load(map, "") == 0, "empty spec reports errors");
+    for (unsigned i = 0; i < sizeof def / sizeof def[0]; i++) {
+        b = pad_map_buttons(map, def[i].xin, 0, 0, press);
+        CHECK(b == def[i].ps3, "%s: got 0x%04X want 0x%04X", def[i].what, b, def[i].ps3);
+        const int pi = press_index(def[i].ps3);
+        for (int j = 0; j < 12; j++)
+            CHECK(press[j] == (j == pi ? 255 : 0), "%s: press[%d] = %u", def[i].what, j, press[j]);
+    }
+    b = pad_map_buttons(map, 0, 0, 0, press);
+    CHECK(b == 0, "idle pad presses 0x%04X", b);
+
+    /* triggers: digital past the threshold, analog pressure = the trigger value */
+    b = pad_map_buttons(map, 0, 200, 0, press);
+    CHECK(b == CELL_PAD_CTRL_L2 && press[10] == 200 && press[11] == 0, "LT 200: 0x%04X p=%u", b, press[10]);
+    b = pad_map_buttons(map, 0, 0, 255, press);
+    CHECK(b == CELL_PAD_CTRL_R2 && press[11] == 255, "RT 255: 0x%04X p=%u", b, press[11]);
+    b = pad_map_buttons(map, 0, PAD_TRIGGER_THRESHOLD, PAD_TRIGGER_THRESHOLD, press);
+    CHECK(b == 0 && press[10] == 0 && press[11] == 0, "triggers at the threshold: 0x%04X %u %u", b, press[10],
+          press[11]);
+    b = pad_map_buttons(map, 0, PAD_TRIGGER_THRESHOLD + 1, 0, press);
+    CHECK(b == CELL_PAD_CTRL_L2 && press[10] == PAD_TRIGGER_THRESHOLD + 1, "LT just past the threshold");
+
+    /* everything at once = every PS3 button */
+    b = pad_map_buttons(map, 0xFFFF, 255, 255, press);
+    CHECK(b == 0xFFFF, "all pressed: 0x%04X", b);
+
+    /* the CELL_PAD_CTRL masks split into DIGITAL1 (low byte) / DIGITAL2 (high byte) as cellPadGetData writes them */
+    CHECK((CELL_PAD_CTRL_CROSS >> 8) == 0x40 && (CELL_PAD_CTRL_CIRCLE >> 8) == 0x20 &&
+          (CELL_PAD_CTRL_SQUARE >> 8) == 0x80 && (CELL_PAD_CTRL_TRIANGLE >> 8) == 0x10 &&
+          (CELL_PAD_CTRL_L1 >> 8) == 0x04 && (CELL_PAD_CTRL_R1 >> 8) == 0x08 &&
+          (CELL_PAD_CTRL_L2 >> 8) == 0x01 && (CELL_PAD_CTRL_R2 >> 8) == 0x02 &&
+          CELL_PAD_CTRL_SELECT == 0x01 && CELL_PAD_CTRL_L3 == 0x02 && CELL_PAD_CTRL_R3 == 0x04 &&
+          CELL_PAD_CTRL_START == 0x08 && CELL_PAD_CTRL_UP == 0x10 && CELL_PAD_CTRL_RIGHT == 0x20 &&
+          CELL_PAD_CTRL_DOWN == 0x40 && CELL_PAD_CTRL_LEFT == 0x80, "CELL_PAD_CTRL_* bit layout");
+
+    /* ---- PS3_PAD_MAP */
+    CHECK(pad_map_load(map, "A=circle,B=cross") == 0, "swap parse");
+    b = pad_map_buttons(map, XINPUT_GAMEPAD_A, 0, 0, press);
+    CHECK(b == CELL_PAD_CTRL_CIRCLE && press[5] == 255 && press[6] == 0, "A=circle: 0x%04X", b);
+    b = pad_map_buttons(map, XINPUT_GAMEPAD_B, 0, 0, press);
+    CHECK(b == CELL_PAD_CTRL_CROSS, "B=cross: 0x%04X", b);
+    b = pad_map_buttons(map, XINPUT_GAMEPAD_X, 0, 0, press);
+    CHECK(b == CELL_PAD_CTRL_SQUARE, "X untouched: 0x%04X", b);
+
+    /* triggers <-> bumpers: pressure follows the source */
+    CHECK(pad_map_load(map, " lt = L1 ; LB=l2, RT=r1,rb=R2 ") == 0, "trigger/bumper swap parse");
+    b = pad_map_buttons(map, 0, 128, 0, press);
+    CHECK(b == CELL_PAD_CTRL_L1 && press[8] == 128 && press[10] == 0, "LT=l1 analog: 0x%04X p=%u", b, press[8]);
+    b = pad_map_buttons(map, XINPUT_GAMEPAD_LEFT_SHOULDER, 0, 0, press);
+    CHECK(b == CELL_PAD_CTRL_L2 && press[10] == 255, "LB=l2 digital: 0x%04X p=%u", b, press[10]);
+
+    /* aliases, NONE, several sources on one button (max pressure wins) */
+    CHECK(pad_map_load(map, "view=start,MENU=select,l3=r3,dpad_up=none,Y=cross") == 0, "alias parse");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_BACK, 0, 0, press) == CELL_PAD_CTRL_START, "view=start");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_START, 0, 0, press) == CELL_PAD_CTRL_SELECT, "menu=select");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_LEFT_THUMB, 0, 0, press) == CELL_PAD_CTRL_R3, "l3=r3");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_DPAD_UP, 0, 0, press) == 0, "dpad_up=none");
+    b = pad_map_buttons(map, XINPUT_GAMEPAD_A | XINPUT_GAMEPAD_Y, 0, 0, press);
+    CHECK(b == CELL_PAD_CTRL_CROSS && press[6] == 255, "A+Y both cross: 0x%04X", b);
+
+    /* bad entries are skipped, good ones still apply */
+    CHECK(pad_map_load(map, "foo=cross,A=bar,B,X=triangle,=circle") == 4, "4 bad entries");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_X, 0, 0, press) == CELL_PAD_CTRL_TRIANGLE, "X=triangle kept");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_A, 0, 0, press) == CELL_PAD_CTRL_CROSS, "A default after bad entry");
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_B, 0, 0, press) == CELL_PAD_CTRL_CIRCLE, "B default after bad entry");
+
+    /* reload = back to the defaults */
+    pad_map_load(map, NULL);
+    CHECK(pad_map_buttons(map, XINPUT_GAMEPAD_A, 0, 0, press) == CELL_PAD_CTRL_CROSS, "reload default");
+
+    printf("pad_map_test: %d checks, %d failed\n", s_checks, s_failed);
+    return s_failed ? 1 : 0;
+}
