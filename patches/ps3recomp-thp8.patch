+static void clear_env(void)
+{
+    setenv_u8("PS3_SAVEDATA_ROOT", NULL);
+    setenv_u8("PS3_SAVEDATA_IMPORT", NULL);
+    setenv_u8("PS3_VFS_STRICT", NULL);
+    setenv_u8("PS3_HDD0_ROOT", NULL);
+    setenv_u8("PS3_SAVEDATA_LOCK_MS", NULL);
