+/* Diagnostic readback of a live zeta's depth plane (LD_DRAW_DUMP_ZETA).
+ * Writes "ZF32 <w> <h>\n" + the w*h D32F depth values (little-endian).
+ * The zeta lives in DEPTH_WRITE between draws. Returns 1 on success. */
+static int ld_dump_zeta_raw(const char* path, u32 zslot)
+{
+    if (!zslot || zslot > g.n_zdepths) return 0;
+    zdepth_t* z = &g.zdepths[zslot - 1];
+    if (!z->tex) return 0;
+    D3D12_RESOURCE_DESC zd;
+    z->tex->lpVtbl->GetDesc(z->tex, &zd);
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp;
+    UINT rows = 0; UINT64 row_bytes = 0, total = 0;
+    g.dev->lpVtbl->GetCopyableFootprints(g.dev, &zd, 0, 1, 0, &fp, &rows,
+                                         &row_bytes, &total);
+    if (!total || !rows) return 0;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = total;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return 0;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = z->tex;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    ldl_ResourceBarrier(1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = z->tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.SubresourceIndex = 0;                                   /* depth plane */
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint = fp;
+    ldl_CopyTextureRegion(&dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    ldl_ResourceBarrier(1, &b);
+    ld_flush(LD_FLUSH_READBACK);
+    int ok = 0;
+    u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)total};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        FILE* f = fopen(path, "wb");
+        if (f) {
+            const u32 w = fp.Footprint.Width, h = rows;
+            fprintf(f, "ZF32 %u %u\n", w, h);
+            for (u32 y = 0; y < h; y++)
+                fwrite(px + (SIZE_T)y * fp.Footprint.RowPitch, 4, w, f);
+            fclose(f);
+            ok = 1;
+        }
+        D3D12_RANGE wr = {0, 0};
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+    }
+    rb->lpVtbl->Release(rb);
+    return ok;
+}
