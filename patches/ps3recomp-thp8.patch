+  // tab must never play anything. It also stops whenever the page is hidden.
+  const wantSound = $("sound").checked || new URLSearchParams(location.search).get("audio") === "1";
+  const audioCtx = wantSound && typeof AudioWorkletNode === "function" ? new AudioContext({ sampleRate: 48000, latencyHint: "interactive" }) : null;
+  if (!wantSound) log("sound off (tick Sound before Start, or add ?audio=1)");
+  const base = new URL(".", location.href).href;
+  globalThis.PS3WEB_DATA = new URL("data/", base).href;
+  // ?build=<name>: an alternative build in builds/<name>/ (A/B testing; same data, same page)
+  const alt = new URLSearchParams(location.search).get("build");
+  if (alt && /^[A-Za-z0-9_-]+$/.test(alt)) cfg = { ...cfg, module: `builds/${alt}/${cfg.module}` };
+  // ?mods=<name>: mount the mods_<name>/ pack (index.json + files/, made by web/tools/mkdata.py --folder) at /mods,
+  // read-only and streamed like data/. Only a mod-capable build (e.g. ?build=c3p8p) looks there; a vanilla build
+  // gets the tree but never reads it.
+  const modsName = new URLSearchParams(location.search).get("mods");
+  const modsUrl = modsName && /^[a-z0-9_]+$/.test(modsName) ? new URL(`mods_${modsName}/`, base).href : null;
+  if (modsUrl) log(`mods: ${modsUrl}`);
+  log(`loading ${cfg.module} ...`);
+  // the largest 2D texture the device worker will get (it requests the adapter's limit): texrepl refuses bigger mods
+  // textures and keeps the stock one (rt9+, PS3_WASM_MAX_TEX2D)
+  // the player's keyboard layout for key labels (P8Plus keyboard glyphs): "<HID usage>=<encoded key>,..." from Chrome's
+  // Keyboard Map API (US names where it is missing); ?keylayout=azerty = a fixed AZERTY map (test aid)
+  let keyLayout = "";
+  try {
+    let map = null;
+    const preset = new URLSearchParams(location.search).get("keylayout");
+    if (preset === "azerty") map = new Map(Object.entries({ KeyQ: "a", KeyW: "z", KeyA: "q", KeyZ: "w", Semicolon: "m", KeyM: ",", Comma: ";",
