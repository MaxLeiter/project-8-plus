+static void set_arg(ID3D12GraphicsCommandList* t, int cs, UINT i, u64 v) { wgs_list* l = L_of(t); if (i < 32 && l->arg[cs][i] != v) { l->arg[cs][i] = v; l->dirty[cs] = 1; } }
+static void STDMETHODCALLTYPE cl_gfx_table(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_DESCRIPTOR_HANDLE h) { set_arg(t, 0, i, h.ptr); }
+static void STDMETHODCALLTYPE cl_cs_table(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_DESCRIPTOR_HANDLE h) { set_arg(t, 1, i, h.ptr); }
+static void STDMETHODCALLTYPE cl_gfx_cbv(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_VIRTUAL_ADDRESS v) { set_arg(t, 0, i, v); }
+static void STDMETHODCALLTYPE cl_cs_cbv(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_VIRTUAL_ADDRESS v) { set_arg(t, 1, i, v); }
+static void STDMETHODCALLTYPE cl_gfx_srv(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_VIRTUAL_ADDRESS v) { set_arg(t, 0, i, v); }
+static void STDMETHODCALLTYPE cl_cs_srv(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_VIRTUAL_ADDRESS v) { set_arg(t, 1, i, v); }
+static void STDMETHODCALLTYPE cl_gfx_uav(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_VIRTUAL_ADDRESS v) { set_arg(t, 0, i, v); }
+static void STDMETHODCALLTYPE cl_cs_uav(ID3D12GraphicsCommandList* t, UINT i, D3D12_GPU_VIRTUAL_ADDRESS v) { set_arg(t, 1, i, v); }
+static void consts(ID3D12GraphicsCommandList* t, int cs, UINT i, UINT n, const void* d, UINT off)
+{
+    wgs_list* l = L_of(t);
+    if (i >= 32 || off + n > 64) return;
+    memcpy(&l->cst[cs][i][off], d, n * 4); l->dirty[cs] = 1;
+}
+static void STDMETHODCALLTYPE cl_gfx_consts(ID3D12GraphicsCommandList* t, UINT i, UINT n, const void* d, UINT off) { consts(t, 0, i, n, d, off); }
+static void STDMETHODCALLTYPE cl_cs_consts(ID3D12GraphicsCommandList* t, UINT i, UINT n, const void* d, UINT off) { consts(t, 1, i, n, d, off); }
+static void STDMETHODCALLTYPE cl_gfx_const(ID3D12GraphicsCommandList* t, UINT i, UINT v, UINT off) { consts(t, 0, i, 1, &v, off); }
+static void STDMETHODCALLTYPE cl_cs_const(ID3D12GraphicsCommandList* t, UINT i, UINT v, UINT off) { consts(t, 1, i, 1, &v, off); }
+
+static void STDMETHODCALLTYPE cl_ib(ID3D12GraphicsCommandList* t, const D3D12_INDEX_BUFFER_VIEW* v)
+{
+    wgs_list* l = L_of(t);
+    u32* c = L_cmd(l, WGS_L_IBUF, 4);
+    if (!v || !v->BufferLocation) { c[0] = c[1] = c[2] = c[3] = 0; return; }
+    c[0] = va_id(v->BufferLocation); c[1] = va_off(v->BufferLocation); c[2] = v->SizeInBytes; c[3] = v->Format;
+    L_track_upload(l, c[0], c[1], (u64)c[1] + c[2]);
+}
+static void STDMETHODCALLTYPE cl_vbs(ID3D12GraphicsCommandList* t, UINT start, UINT n, const D3D12_VERTEX_BUFFER_VIEW* v)
+{
+    wgs_list* l = L_of(t);
+    u32* c = L_cmd(l, WGS_L_VBUFS, 2 + 4 * n);
+    c[0] = start; c[1] = n;
+    for (UINT i = 0; i < n; i++) {
+        u32* e = c + 2 + 4 * i;
+        if (!v || !v[i].BufferLocation) { e[0] = e[1] = e[2] = e[3] = 0; continue; }
+        e[0] = va_id(v[i].BufferLocation); e[1] = va_off(v[i].BufferLocation); e[2] = v[i].SizeInBytes; e[3] = v[i].StrideInBytes;
+        L_track_upload(l, e[0], e[1], (u64)e[1] + e[2]);
+    }
+}
+static void put_view(u32* c, const wgs_desc* s) { if (s && s->kind) { c[0] = s->w[0]; c[1] = s->w[2]; c[2] = s->w[3]; c[3] = s->w[1]; } else c[0] = c[1] = c[2] = c[3] = 0; }
+static void STDMETHODCALLTYPE cl_targets(ID3D12GraphicsCommandList* t, UINT n, const D3D12_CPU_DESCRIPTOR_HANDLE* rt, BOOL single,
+                                         const D3D12_CPU_DESCRIPTOR_HANDLE* ds)
+{
+    wgs_list* l = L_of(t);
+    u32* c = L_cmd(l, WGS_L_TARGETS, 1 + 4 * n + 4);
+    c[0] = n;
+    for (UINT i = 0; i < n; i++)
+        put_view(c + 1 + 4 * i, single ? cpu_slot(rt[0].ptr) + i : cpu_slot(rt[i].ptr));
+    put_view(c + 1 + 4 * n, ds ? cpu_slot(ds->ptr) : NULL);
+}
+static void STDMETHODCALLTYPE cl_clear_rt(ID3D12GraphicsCommandList* t, D3D12_CPU_DESCRIPTOR_HANDLE h, const FLOAT col[4], UINT nr, const D3D12_RECT* r)
+{
+    (void)nr; (void)r;   /* rect clears: the worker clears the whole view (the renderer clears whole targets) */
+    u32* c = L_cmd(L_of(t), WGS_L_CLEAR_RT, 8);
+    put_view(c, cpu_slot(h.ptr));
+    for (int i = 0; i < 4; i++) c[4 + i] = f2u(col[i]);
+}
+static void STDMETHODCALLTYPE cl_clear_ds(ID3D12GraphicsCommandList* t, D3D12_CPU_DESCRIPTOR_HANDLE h, D3D12_CLEAR_FLAGS fl, FLOAT dv, UINT8 sv, UINT nr, const D3D12_RECT* r)
+{
+    (void)nr; (void)r;
+    u32* c = L_cmd(L_of(t), WGS_L_CLEAR_DS, 7);
+    put_view(c, cpu_slot(h.ptr));
+    c[4] = fl; c[5] = f2u(dv); c[6] = sv;
+}
+static void STDMETHODCALLTYPE cl_end_query(ID3D12GraphicsCommandList* t, ID3D12QueryHeap* h, D3D12_QUERY_TYPE type, UINT i)
+{ if (type == D3D12_QUERY_TYPE_TIMESTAMP) { u32* c = L_cmd(L_of(t), WGS_L_TIMESTAMP, 2); c[0] = ((wgs_unk*)h)->id; c[1] = i; } }
+static void STDMETHODCALLTYPE cl_resolve_query(ID3D12GraphicsCommandList* t, ID3D12QueryHeap* h, D3D12_QUERY_TYPE type, UINT start, UINT n,
+                                               ID3D12Resource* dst, UINT64 off)
+{ (void)t; (void)h; (void)type; (void)start; (void)n; (void)dst; (void)off; }   /* GPU timer diagnostics: zeros */
+static ID3D12GraphicsCommandListVtbl s_cl_vtbl;
+
+static HRESULT STDMETHODCALLTYPE dev_create_list(ID3D12Device* t, UINT mask, D3D12_COMMAND_LIST_TYPE type, ID3D12CommandAllocator* a,
+                                                 ID3D12PipelineState* pso, REFIID iid, void** out)
+{
+    (void)t; (void)mask; (void)type; (void)iid;
+    ID3D12GraphicsCommandListVtbl* v = &s_cl_vtbl;
+    if (!v->QueryInterface) {
+        v->QueryInterface = cl_qi; v->AddRef = cl_addref; v->Release = cl_release; v->GetType = cl_type;
+        v->Close = cl_close; v->Reset = cl_reset; v->ClearState = cl_clear_state; v->DrawInstanced = cl_draw;
+        v->DrawIndexedInstanced = cl_draw_indexed; v->Dispatch = cl_dispatch; v->CopyBufferRegion = cl_copy_buffer;
+        v->CopyTextureRegion = cl_copy_texture; v->CopyResource = cl_copy_resource; v->IASetPrimitiveTopology = cl_topology;
+        v->RSSetViewports = cl_viewports; v->RSSetScissorRects = cl_scissors; v->OMSetBlendFactor = cl_blend_factor;
+        v->OMSetStencilRef = cl_stencil_ref; v->SetPipelineState = cl_set_pso; v->ResourceBarrier = cl_barrier;
+        v->SetDescriptorHeaps = cl_set_heaps; v->SetComputeRootSignature = cl_cs_rs; v->SetGraphicsRootSignature = cl_gfx_rs;
+        v->SetComputeRootDescriptorTable = cl_cs_table; v->SetGraphicsRootDescriptorTable = cl_gfx_table;
+        v->SetComputeRoot32BitConstant = cl_cs_const; v->SetGraphicsRoot32BitConstant = cl_gfx_const;
+        v->SetComputeRoot32BitConstants = cl_cs_consts; v->SetGraphicsRoot32BitConstants = cl_gfx_consts;
+        v->SetComputeRootConstantBufferView = cl_cs_cbv; v->SetGraphicsRootConstantBufferView = cl_gfx_cbv;
+        v->SetComputeRootShaderResourceView = cl_cs_srv; v->SetGraphicsRootShaderResourceView = cl_gfx_srv;
+        v->SetComputeRootUnorderedAccessView = cl_cs_uav; v->SetGraphicsRootUnorderedAccessView = cl_gfx_uav;
+        v->IASetIndexBuffer = cl_ib; v->IASetVertexBuffers = cl_vbs; v->OMSetRenderTargets = cl_targets;
+        v->ClearDepthStencilView = cl_clear_ds; v->ClearRenderTargetView = cl_clear_rt; v->EndQuery = cl_end_query;
+        v->ResolveQueryData = cl_resolve_query;
+        WGS_CHILD_SLOTS(*v); wgs_fill_vtbl(v, sizeof *v);
+    }
+    wgs_list* l = (wgs_list*)wgs_zalloc(sizeof *l);
+    l->iface.lpVtbl = v; l->refs = 1;
+    cl_reset(&l->iface, a, pso);
+    *out = &l->iface;
+    return S_OK;
+}
+
+/* ------------------------------------------------------------------------------------------------ queue */
+typedef struct wgs_queue { ID3D12CommandQueue iface; volatile LONG refs; } wgs_queue;
+static ID3D12CommandQueueVtbl s_q_vtbl;
+static HRESULT STDMETHODCALLTYPE q_qi(ID3D12CommandQueue* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12CommandQueue)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE q_addref(ID3D12CommandQueue* t) { return (ULONG)__atomic_add_fetch(&((wgs_queue*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE q_release(ID3D12CommandQueue* t)
+{
+    wgs_queue* q = (wgs_queue*)t;
+    const LONG n = __atomic_sub_fetch(&q->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) free(q);
+    return (ULONG)n;
+}
+static void STDMETHODCALLTYPE q_execute(ID3D12CommandQueue* t, UINT n, ID3D12CommandList* const* lists)
+{
+    (void)t;
+    /* hint ranges first: they cover everything the renderer wrote since the last submit */
+    pthread_mutex_lock(&s_hint_lock);
+    wgs_spans h = s_hinted; s_hinted = (wgs_spans){0};
+    pthread_mutex_unlock(&s_hint_lock);
+    for (u32 i = 0; i < h.n; i++) post_upload(h.s[i].id, h.s[i].lo, h.s[i].hi);
+    free(h.s);
+    for (UINT i = 0; i < n; i++) {
+        wgs_list* l = L_of((ID3D12GraphicsCommandList*)lists[i]);
+        for (u32 k = 0; k < l->ups.n; k++) post_upload(l->ups.s[k].id, l->ups.s[k].lo, l->ups.s[k].hi);
+        for (u32 k = 0; k < l->nseg; k++) {
+            wgs_msg* m = &t_msg; msg_begin(m, WGS_EXECUTE); msg_ref(m, l->segs[k].p, l->segs[k].n * 4); ring_post(m);
+        }
+        for (u32 k = 0; k < l->rbs.n; k++) {
+            wgs_resource* r = mappable_of(l->rbs.s[k].id);
+            if (!r) continue;
+            wgs_msg* m = &t_msg; msg_begin(m, WGS_READBACK); msg_u32(m, r->id); msg_u64(m, l->rbs.s[k].lo);
+            msg_u32(m, (u32)(l->rbs.s[k].hi - l->rbs.s[k].lo)); msg_u32(m, (u32)(uintptr_t)(r->shadow + l->rbs.s[k].lo)); ring_post(m);
+        }
+    }
+}
+static HRESULT STDMETHODCALLTYPE q_signal(ID3D12CommandQueue* t, ID3D12Fence* f, UINT64 v)
+{
+    (void)t;
+    wgs_fence* fe = (wgs_fence*)f;
+    wgs_msg* m = &t_msg;
+    msg_begin(m, WGS_SIGNAL); msg_u32(m, fe->id); msg_u64(m, v); msg_u32(m, (u32)(uintptr_t)&fe->completed); ring_post(m);
+#ifdef WGS_RECORD
+    fence_signal(f, v);                  /* no consumer in a recording: the GPU is "done" at once */
+#endif
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE q_ts_freq(ID3D12CommandQueue* t, UINT64* f) { (void)t; if (f) *f = 1000000000ull; return S_OK; }
+static D3D12_COMMAND_QUEUE_DESC* STDMETHODCALLTYPE q_desc(ID3D12CommandQueue* t, D3D12_COMMAND_QUEUE_DESC* ret) { (void)t; memset(ret, 0, sizeof *ret); return ret; }
+static HRESULT STDMETHODCALLTYPE q_set_name(ID3D12CommandQueue* t, const WCHAR* n) { (void)t; (void)n; return S_OK; }
+
+static HRESULT STDMETHODCALLTYPE q_get_device(ID3D12CommandQueue* t, REFIID iid, void** out);
+static HRESULT STDMETHODCALLTYPE dev_create_queue(ID3D12Device* t, const D3D12_COMMAND_QUEUE_DESC* d, REFIID iid, void** out)
+{
+    (void)t; (void)d; (void)iid;
+    if (!s_q_vtbl.QueryInterface) {
+        s_q_vtbl.GetDevice = q_get_device;
+        s_q_vtbl.QueryInterface = q_qi; s_q_vtbl.AddRef = q_addref; s_q_vtbl.Release = q_release; s_q_vtbl.SetName = q_set_name;
+        s_q_vtbl.ExecuteCommandLists = q_execute; s_q_vtbl.Signal = q_signal; s_q_vtbl.GetTimestampFrequency = q_ts_freq; s_q_vtbl.GetDesc = q_desc;
+        WGS_CHILD_SLOTS(s_q_vtbl); wgs_fill_vtbl(&s_q_vtbl, sizeof s_q_vtbl);
+    }
+    wgs_queue* q = (wgs_queue*)wgs_zalloc(sizeof *q);
+    q->iface.lpVtbl = &s_q_vtbl; q->refs = 1;
+    *out = &q->iface;
+    return S_OK;
+}
diff --git a/libs/video/webgpu/tests/wgs_record_test.c b/libs/video/webgpu/tests/wgs_record_test.c
new file mode 100644
index 00000000..68da342c
--- /dev/null
+++ b/libs/video/webgpu/tests/wgs_record_test.c
@@ -0,0 +1,199 @@
+/*
+ * wgs_record_test -- drives the D3D12-over-WebGPU layer like the live-draw renderer does (root signature with a
+ * vertex CBV + pixel SRV/sampler tables, persistent upload rings with write hints, a texture uploaded through
+ * CopyTextureRegion, clears, a readback, presents) and records the WGS stream (WGS_RECORD=1). The browser replays
+ * it (web/host/gpu/replay.html) and shows the frames. Build natively, e.g.
+ *   zig cc -target x86_64-linux-musl -DWGS_RECORD=1 -I<vkd3d include> wgs_record_test.c ../d3d12_webgpu.c -o t
+ */
+#define COM_NO_WINDOWS_H
+#include <vkd3d_windows.h>
+#include <vkd3d_d3d12.h>
+#include <vkd3d_dxgi1_4.h>
+#include <vkd3d_d3dcompiler.h>
+#include <vkd3d_utils.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+HRESULT __stdcall CreateDXGIFactory1(REFIID riid, void** out);
+HANDLE ld_vkd3d_create_event(void);
+unsigned ld_vkd3d_wait_event(HANDLE event, unsigned ms);
+void wgs_hint_written(ID3D12Resource* res, UINT64 off, UINT64 size);
+
+static const char k_hlsl[] =
+"cbuffer VSC : register(b0) { float4 xform; float4 tint; };\n"
+"Texture2D tex : register(t0);\n"
+"SamplerState smp : register(s0);\n"
+"struct VI { float2 pos : POSITION; float2 uv : TEXCOORD0; };\n"
+"struct VO { float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 col : COLOR0; };\n"
+"VO vs_main(VI i) { VO o; o.pos = float4(i.pos * xform.xy + xform.zw, 0.0, 1.0); o.uv = i.uv; o.col = tint; return o; }\n"
+"cbuffer PSC : register(b1) { float4 mul; };\n"
+"float4 ps_main(VO i) : SV_Target { float4 t = tex.Sample(smp, i.uv); return t * i.col * mul; }\n";
+
+#define CHECK(x) do { HRESULT _h = (x); if (FAILED(_h)) { fprintf(stderr, "FAIL %s = 0x%08x (line %d)\n", #x, (unsigned)_h, __LINE__); return 1; } } while (0)
+
+static ID3D12Resource* buffer(ID3D12Device* d, D3D12_HEAP_TYPE heap, UINT64 size)
+{
+    D3D12_HEAP_PROPERTIES hp = { heap };
+    D3D12_RESOURCE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = size; rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* r = NULL;
+    d->lpVtbl->CreateCommittedResource(d, &hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&r);
+    return r;
+}
+
+int main(void)
+{
+    IDXGIFactory4* fac; ID3D12Device* dev; ID3D12CommandQueue* q; ID3D12CommandAllocator* al; ID3D12GraphicsCommandList* cl; ID3D12Fence* fence;
+    CHECK(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&fac));
+    CHECK(D3D12CreateDevice(NULL, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev));
+    D3D12_COMMAND_QUEUE_DESC qd; memset(&qd, 0, sizeof qd);
+    CHECK(dev->lpVtbl->CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&q));
+    CHECK(dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&al));
+    CHECK(dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, NULL, &IID_ID3D12GraphicsCommandList, (void**)&cl));
+    CHECK(dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&fence));
+    HANDLE ev = ld_vkd3d_create_event();
+
+    DXGI_SWAP_CHAIN_DESC1 sd; memset(&sd, 0, sizeof sd);
+    sd.Width = 640; sd.Height = 360; sd.Format = DXGI_FORMAT_R8G8B8A8_UNORM; sd.BufferCount = 2; sd.SampleDesc.Count = 1;
+    IDXGISwapChain1* sc1; IDXGISwapChain3* sc;
+    CHECK(fac->lpVtbl->CreateSwapChainForHwnd(fac, (IUnknown*)q, NULL, &sd, NULL, NULL, &sc1));
+    CHECK(sc1->lpVtbl->QueryInterface(sc1, &IID_IDXGISwapChain3, (void**)&sc));
+
+    /* root signature: like make_root_signature (b0 vertex CBV, t0 pixel table, s0 pixel table, b1 pixel CBV) */
+    D3D12_DESCRIPTOR_RANGE tr = { D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0 };
+    D3D12_DESCRIPTOR_RANGE sr = { D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER, 1, 0, 0, 0 };
+    D3D12_ROOT_PARAMETER rp[4]; memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV; rp[0].Descriptor.ShaderRegister = 0; rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; rp[1].DescriptorTable.NumDescriptorRanges = 1; rp[1].DescriptorTable.pDescriptorRanges = &tr; rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; rp[2].DescriptorTable.NumDescriptorRanges = 1; rp[2].DescriptorTable.pDescriptorRanges = &sr; rp[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV; rp[3].Descriptor.ShaderRegister = 1; rp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rsd = { 4, rp, 0, NULL, D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT };
+    ID3DBlob* rsb; ID3D12RootSignature* rs;
+    CHECK(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &rsb, NULL));
+    CHECK(dev->lpVtbl->CreateRootSignature(dev, 0, rsb->lpVtbl->GetBufferPointer(rsb), rsb->lpVtbl->GetBufferSize(rsb), &IID_ID3D12RootSignature, (void**)&rs));
+
+    ID3DBlob *vs, *ps;
+    CHECK(D3DCompile(k_hlsl, sizeof k_hlsl - 1, "t", NULL, NULL, "vs_main", "vs_5_0", 0, 0, &vs, NULL));
+    CHECK(D3DCompile(k_hlsl, sizeof k_hlsl - 1, "t", NULL, NULL, "ps_main", "ps_5_0", 0, 0, &ps, NULL));
+    D3D12_INPUT_ELEMENT_DESC il[2] = {
+        { "POSITION", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 0, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 8, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 } };
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = rs; pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.BlendState.RenderTarget[0].BlendEnable = TRUE;
+    pd.BlendState.RenderTarget[0].SrcBlend = D3D12_BLEND_SRC_ALPHA; pd.BlendState.RenderTarget[0].DestBlend = D3D12_BLEND_INV_SRC_ALPHA; pd.BlendState.RenderTarget[0].BlendOp = D3D12_BLEND_OP_ADD;
+    pd.BlendState.RenderTarget[0].SrcBlendAlpha = D3D12_BLEND_ONE; pd.BlendState.RenderTarget[0].DestBlendAlpha = D3D12_BLEND_ZERO; pd.BlendState.RenderTarget[0].BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu; pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE; pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.InputLayout.NumElements = 2; pd.InputLayout.pInputElementDescs = il;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE; pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM; pd.SampleDesc.Count = 1;
+    ID3D12PipelineState* pso;
