diff --git a/include/ps3mod.h b/include/ps3mod.h
new file mode 100644
index 00000000..1a2a2bba
--- /dev/null
+++ b/include/ps3mod.h
@@ -0,0 +1,722 @@
+/*
+ * ps3mod.h -- ps3recomp native-port plugin (mod DLL) ABI.
+ *
+ * Public, pure C, stable. A plugin is a DLL in <mods>\plugins\ that exports
+ * ps3mod_init() (and optionally ps3mod_query() / ps3mod_shutdown()). The
+ * runtime's loader (runtime/ppu/ppu_mod_loader.cpp, built only with
+ * -DPPU_MOD_HOOKS) loads it before the guest starts and hands it a
+ * ps3mod_host: a table of function pointers to hook lifted guest functions,
+ * read/write guest memory, patch guest data, call guest code, read the
+ * plugin's config file, and receive host frame/present/vblank events.
+ *
+ *   <mods>     = %PS3_MODS_ROOT% if set, else <exe dir>\mods
+ *   plugins    = <mods>\<pack>\plugins\*.dll for each pack folder, then
+ *                <mods>\plugins\*.dll; packs and DLLs in case-insensitive name
+ *                order (so the root folder loads last and its hooks run first);
+ *                a name starting with '_' or '.' is skipped (disabled)
+ *   config     = <dll basename>.ini (or .toml) next to the DLL, optional
+ *   PS3_MODS_PLUGINS=0 disables plugin loading entirely
+ *
+ * ABI rules
+ *   - C only, x86-64 (Windows x64 / SysV) default calling convention, natural
+ *     alignment. No CRT objects (FILE*, malloc'd memory, C++ types) cross the
+ *     boundary; strings are UTF-8, NUL-terminated.
+ *   - Every struct starts with a `size` field. Structs only ever grow at the end
+ *     (append-only within a major version); fields are never reordered or
+ *     removed. PS3MOD_HAS(ptr, field) tells whether a struct the other side
+ *     filled in is new enough to contain `field`.
+ *   - PS3MOD_ABI_MAJOR changes only on an incompatible change. The loader
+ *     accepts a plugin when plugin.major == host.major and
+ *     plugin.minor <= host.minor, so a plugin may use everything its header
+ *     declares.
+ *
+ * Validation (the loader refuses -- unloads -- a plugin unless all hold; each
+ * refusal is logged as "[mods] plugin <file> refused: <reason>"):
+ *   (a) info.abi_version is compatible (see above) and info.ctx_layout ==
+ *       PS3MOD_CTX_LAYOUT (or 0 = "does not touch ps3mod_ctx");
+ *       info.lift_abi == PS3MOD_LIFT_ABI (or 0 = "does not care");
+ *   (b) info.required_ppu_hash equals the PPU hash of the running ELF
+ *       (RPCS3's "PPU-<sha1>" executable hash, computed by the runtime from the
+ *       loaded ELF; THP8 BLUS30011 = "PPU-de89165d4428c218f9ade10050ea093f7bde9e8d").
+ *       A plugin that really targets any game sets PS3MOD_INFO_ANY_GAME.
+ *   (c) info.required_lift_id, if set, equals host->lift_id; every address in
+ *       info.required_entries is a hookable lifted function entry;
+ *   (d) every hook it registers during init targets a lifted function entry
+ *       (not an import stub), and every data patch it makes during init finds
+ *       the expected original bytes.
+ *   Hooks, patches and event callbacks made during ps3mod_init are STAGED and
+ *   only take effect if the plugin passes all checks after init returns 0; a
+ *   refused plugin leaves no trace (ps3mod_shutdown is called, the DLL is
+ *   unloaded). Direct guest writes (write8..write_block) are NOT staged: do
+ *   them from a hook or event, or use host->patch.
+ *
+ * Load sequence (per plugin, in name order)
+ *   1. ps3mod_query(&info)        optional; if exported, info is validated
+ *                                  (a)-(c) before init runs at all.
+ *   2. ps3mod_init(host, &info)   required; fill/refresh *info, then register
+ *                                  hooks, patches, events. Return 0 = OK,
+ *                                  anything else = "don't load me" (not an error).
+ *   3. validation of info + staged hooks/patches -> commit or refuse.
+ *   ps3mod_shutdown()             optional; at process exit, or after a refusal.
+ *   `info` points to zeroed host storage of at least PS3MOD_INFO_STORAGE bytes;
+ *   info->size is preset to the host's sizeof(ps3mod_info). Strings and arrays
+ *   the plugin puts in it must stay valid while the DLL is loaded (use static
+ *   storage).
+ *
+ * When it runs: after the ELF is loaded and the runtime (HLE, fs, syscalls) is
+ * up, before the first guest instruction and before the game window exists.
+ * Display-dependent setup belongs in a PS3MOD_EV_DISPLAY_READY handler.
+ *
+ * Threads: hooks run on guest threads (host threads executing lifted code).
+ * Events run on the host's vblank/present thread. Keep cross-thread state in
+ * naturally aligned single writes or atomics. host->hook_register works only
+ * inside ps3mod_init (PS3MOD_E_FROZEN afterwards); host->hook_add (ABI 1.2)
+ * works at any time and returns a handle for host->hook_enable. Patches and
+ * event handlers also work later.
+ */
+#ifndef PS3MOD_H
+#define PS3MOD_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* ------------------------------------------------------------------------ */
+/* Versions                                                                  */
+
+#define PS3MOD_ABI_MAJOR    1
+#define PS3MOD_ABI_MINOR    3   /* 1.1: host->set_pacing, ps3mod_display.vblank_hz/display_hz
+                                   1.2: hook_add / hook_enable (hooks at any time), guest_alloc /
+                                        guest_free, service_publish / service_get, mods_rescan,
+                                        screenshot (+ PS3MOD_EV_SCREENSHOT), debug_lines
+                                   1.3: input_info / key_name / key_label (keyboard play, the
+                                        device in use), tex_redirect */
+#define PS3MOD_ABI_VERSION  ((PS3MOD_ABI_MAJOR << 16) | PS3MOD_ABI_MINOR)
+#define PS3MOD_ABI_VERSION_MAJOR(v) ((uint32_t)(v) >> 16)
+#define PS3MOD_ABI_VERSION_MINOR(v) ((uint32_t)(v) & 0xFFFFu)
+
+/* ps3mod_ctx (== the runtime's ppu_context) layout. Bumped on any change. */
+#define PS3MOD_CTX_LAYOUT   1
+#define PS3MOD_CTX_SIZE     0x450
+
+/* Lift semantics a hook relies on, version 1:
+ *   - a lifted `bl X` sets ctx->lr = call site + 4 before entering X, so a
+ *     hook's entry_lr identifies the call site;
+ *   - tail calls / cross-fragment branches leave a pending trampoline that
+ *     call_next drains, so r3/f1 are final when call_next returns;
+ *   - fpr[] holds doubles (single-precision results stored as (double)(float));
+ *   - callee-saved GPRs are restored by each lifted function before return. */
+#define PS3MOD_LIFT_ABI     1
+
+/* Minimum bytes the host provides behind the ps3mod_info* it passes. */
+#define PS3MOD_INFO_STORAGE 1024
+
+/* True if a struct filled in by the other side (size field first) contains
+ * `field`. */
+#define PS3MOD_HAS(ptr, field) \
+    ((ptr) && (size_t)(ptr)->size >= (size_t)((const char*)&(ptr)->field - (const char*)(ptr)) + sizeof((ptr)->field))
+
+/* ------------------------------------------------------------------------ */
+/* Export / linkage                                                          */
+
+#if defined(_WIN32)
+#  define PS3MOD_DLLEXPORT __declspec(dllexport)
+#else
+#  define PS3MOD_DLLEXPORT __attribute__((visibility("default")))
+#endif
+#ifdef __cplusplus
+#  define PS3MOD_EXPORT extern "C" PS3MOD_DLLEXPORT
+#else
+#  define PS3MOD_EXPORT PS3MOD_DLLEXPORT
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------------------ */
+/* Result codes (0 = OK, negative = error)                                   */
+
+enum {
+    PS3MOD_OK              =   0,
+    PS3MOD_E_UNAVAILABLE   =  -1,  /* exe built without PPU_MOD_HOOKS / feature absent */
+    PS3MOD_E_NOT_ENTRY     =  -2,  /* address is not a lifted function entry */
+    PS3MOD_E_IMPORT_STUB   =  -3,  /* address is an import stub (HLE), not hookable */
+    PS3MOD_E_FROZEN        =  -4,  /* registration closed (guest already running) */
+    PS3MOD_E_NOMEM         =  -5,
+    PS3MOD_E_ARG           =  -6,  /* bad argument (NULL fn, n == 0, unknown mode...) */
+    PS3MOD_E_MISMATCH      =  -7,  /* patch: guest bytes != expected original bytes */
+    PS3MOD_E_RANGE         =  -8,  /* address range not in guest memory / in lifted code */
+    PS3MOD_E_NOT_FOUND     =  -9,  /* config key / symbol absent */
+    PS3MOD_E_CONFLICT      = -10   /* e.g. a second REPLACE hook on the same function */
+};
+
+/* Log levels for host->log. */
+enum {
+    PS3MOD_LOG_ERROR = 0,
+    PS3MOD_LOG_WARN  = 1,
+    PS3MOD_LOG_INFO  = 2,
+    PS3MOD_LOG_DEBUG = 3   /* printed only with PS3MOD_DEBUG=1 */
+};
+
+/* ------------------------------------------------------------------------ */
+/* Guest CPU context (layout version PS3MOD_CTX_LAYOUT = 1)                  */
+
+/* A 128-bit VMX register, held as the RAW big-endian guest bytes (lifted lvx /
+ * stvx are plain 16-byte copies): u8[i] is guest byte i (element order), and on
+ * the little-endian host the VALUE of word lane i is PS3MOD_BSWAP32(u32[i])
+ * (same for floats: byte-swap the 32-bit pattern). */
+typedef union ps3mod_v128 {
+    uint64_t u64[2];
+    uint32_t u32[4];
+    uint16_t u16[8];
+    uint8_t  u8[16];
+    int32_t  s32[4];
+    float    f32[4];
+    double   f64[2];
+} ps3mod_v128;
+
+/* Identical to the runtime's ppu_context (runtime/ppu/ppu_context.h); the
+ * loader static_asserts every offset. Hooks may read and write any field. */
+typedef struct ps3mod_ctx {
+    uint64_t    gpr[32];        /* 0x000  r0..r31 (r1 = SP, r2 = TOC, r13 = TLS) */
+    double      fpr[32];        /* 0x100  f0..f31, always double */
+    ps3mod_v128 vr[32];         /* 0x200  v0..v31 */
+    uint32_t    cr;             /* 0x400  CR0 = bits 31..28 ... CR7 = bits 3..0;
+                                          per field LT=8 GT=4 EQ=2 SO=1 */
+    uint32_t    _pad0;
+    uint64_t    lr;             /* 0x408 */
+    uint64_t    ctr;            /* 0x410 */
+    uint32_t    xer;            /* 0x418  SO=bit31 OV=bit30 CA=bit29 */
+    uint32_t    fpscr;          /* 0x41C */
+    uint32_t    vscr;           /* 0x420 */
+    uint32_t    _pad1;
+    uint64_t    cia;            /* 0x428  last synced guest PC (diagnostic) */
+    uint64_t    thread_id;      /* 0x430  guest thread id */
+    uint64_t    reserve_addr;   /* 0x438  lwarx/stwcx reservation */
+    uint64_t    reserve_value;  /* 0x440 */
+    int32_t     reserve_valid;  /* 0x448 */
+    uint32_t    _pad2;          /* 0x44C  (the runtime struct is 16-aligned) */
+} ps3mod_ctx;                   /* 0x450 */
+
+/* CR field n (0..7) as a 4-bit LT/GT/EQ/SO value. */
+#define PS3MOD_CR_FIELD(ctx, n)  (((ctx)->cr >> (28 - 4 * (n))) & 0xFu)
+#define PS3MOD_CR_LT 0x8u
+#define PS3MOD_CR_GT 0x4u
+#define PS3MOD_CR_EQ 0x2u
+#define PS3MOD_CR_SO 0x1u
+/* Store a single-precision result the way lifted fmuls/frsp do. */
+#define PS3MOD_F32(x)            ((double)(float)(x))
+/* Byte swap of a 32-bit value (VMX lanes, raw guest words). */
+#define PS3MOD_BSWAP32(x) \
+    ((((uint32_t)(x) >> 24) & 0xFFu) | (((uint32_t)(x) >> 8) & 0xFF00u) | \
+     (((uint32_t)(x) << 8) & 0xFF0000u) | ((uint32_t)(x) << 24))
+
+#if defined(__cplusplus)
+static_assert(offsetof(ps3mod_ctx, fpr) == 0x100 && offsetof(ps3mod_ctx, vr) == 0x200 &&
+              offsetof(ps3mod_ctx, cr) == 0x400 && offsetof(ps3mod_ctx, lr) == 0x408 &&
+              offsetof(ps3mod_ctx, cia) == 0x428 && offsetof(ps3mod_ctx, reserve_valid) == 0x448 &&
+              sizeof(ps3mod_ctx) == PS3MOD_CTX_SIZE, "ps3mod_ctx layout v1");
+#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+_Static_assert(offsetof(ps3mod_ctx, fpr) == 0x100 && offsetof(ps3mod_ctx, vr) == 0x200 &&
+               offsetof(ps3mod_ctx, cr) == 0x400 && offsetof(ps3mod_ctx, lr) == 0x408 &&
+               offsetof(ps3mod_ctx, cia) == 0x428 && offsetof(ps3mod_ctx, reserve_valid) == 0x448 &&
+               sizeof(ps3mod_ctx) == PS3MOD_CTX_SIZE, "ps3mod_ctx layout v1");
+#endif
+
+/* ------------------------------------------------------------------------ */
+/* Function hooks                                                            */
+
+/* Opaque: the rest of a hook chain (next hook, or the original body). */
+typedef struct ps3mod_link ps3mod_link;
+
+/* A hook on a lifted guest function.
+ *   ctx       the guest thread's registers; arguments in r3..r10 / f1..f13,
+ *             results in r3 / f1 (and memory).
+ *   next      pass to host->call_next to run the rest of the chain / the
+ *             original function. NULL for a REPLACE hook.
+ *   user      the pointer given at registration.
+ *   entry_lr  ctx->lr at function entry. For a direct `bl` at guest address S
+ *             it is S + 4, so "only when called from S" is entry_lr == S + 4.
+ *             (For a tail call it is the original caller's LR; some indirect
+ *             call sites do not set LR.)
+ * WRAP:    edit arguments, call host->call_next(ctx, next) (at most once), then
+ *          edit results. ctx->lr must still equal entry_lr when calling next.
+ *          A wrap hook may also return WITHOUT calling next (a conditional
+ *          replace); it then owns the results like a REPLACE hook.
+ * REPLACE: never runs the original. Produce the results and preserve the
+ *          PPC64 ELF non-volatiles: r1, r2, r13, r14-r31, f14-f31, v20-v31,
+ *          CR2-CR4.
+ * Several hooks on one function form a chain: the hook registered last runs
+ * first (plugins loaded later wrap plugins loaded earlier). */
+typedef void (*ps3mod_hook_fn)(ps3mod_ctx* ctx, const ps3mod_link* next,
+                               void* user, uint32_t entry_lr);
+
+enum {
+    PS3MOD_HOOK_WRAP    = 0,
+    PS3MOD_HOOK_REPLACE = 1
+};
+
+/* ------------------------------------------------------------------------ */
+/* Guest calls                                                               */
+
+/* Extended guest call. Set `opd` (a guest function descriptor {code, toc}) or,
+ * with opd == 0, `code` + `toc` directly. Integer args go to r3.., float args
+ * to f1... The call runs on the calling guest thread's stack when `ctx` is a
+ * hook's ctx (a child frame below ctx->gpr[1]; ctx itself is not modified),
+ * or on the runtime's host-callback scratch stack when ctx == NULL (event
+ * callbacks; the same path HLE callbacks use, not re-entrant per host thread,
+ * integer args only, ret_f1 = 0). Hooks on the callee apply. The callee must
+ * be a lifted function entry. */
+typedef struct ps3mod_call {
+    uint32_t size;          /* caller: sizeof(ps3mod_call) (0 is read as the v1 size) */
+    uint32_t opd;           /* guest OPD address, or 0 */
+    uint32_t code;          /* used when opd == 0 */
+    uint32_t toc;           /* used when opd == 0 */
+    uint32_t n_gpr;         /* 0..8 -> r3..r10 */
+    uint32_t n_fpr;         /* 0..8 -> f1..f8 */
+    uint64_t gpr[8];
+    double   fpr[8];
+    uint64_t ret_r3;        /* out */
+    double   ret_f1;        /* out */
+} ps3mod_call;
+
+/* ------------------------------------------------------------------------ */
+/* Host display + events                                                     */
+
+typedef struct ps3mod_display {
+    uint32_t size;          /* get_display: caller sets sizeof(ps3mod_display) (0 is read as
+                               the v1 size); the host fills at most that many bytes */
+    uint32_t ready;         /* 1 once the game window / backend is up */
+    uint32_t window_w;      /* window client area in pixels (0 = no window yet) */
+    uint32_t window_h;
+    uint32_t backbuffer_w;  /* swap-chain / present surface size */
+    uint32_t backbuffer_h;
+    uint32_t render_w;      /* the guest's render size (RSX_W/RSX_H; 1280x720) */
+    uint32_t render_h;
+    float    aspect;        /* window_w / window_h; render aspect without a window */
+    uint32_t refresh_hz;    /* nominal guest vblank rate, rounded (60 on the legacy clock) */
+    uint64_t frames;        /* guest frames presented so far */
+    uint64_t vblanks;       /* vblank ticks so far */
+    /* ABI 1.1 (PS3MOD_HAS(d, display_hz)) */
+    float    vblank_hz;     /* exact guest vblank rate (62.5 on the legacy 16 ms clock) */
+    float    display_hz;    /* refresh rate of the window's monitor; 0 = not known yet */
+} ps3mod_display;
+
+enum {
+    PS3MOD_EV_PRESENT       = 1,  /* after each guest frame was presented */
+    PS3MOD_EV_VBLANK        = 2,  /* every ~60 Hz vblank tick */
+    PS3MOD_EV_RESIZE        = 3,  /* window client size / aspect changed */
+    PS3MOD_EV_DISPLAY_READY = 4,  /* once, after the window/backend came up */
+    PS3MOD_EV_SHUTDOWN      = 5,  /* once, at process exit (before ps3mod_shutdown) */
+    PS3MOD_EV_SCREENSHOT    = 6   /* ABI 1.2: a host->screenshot request completed
+                                     (event.result, event.path) */
+};
+
+typedef struct ps3mod_event {
+    uint32_t       size;    /* sizeof(ps3mod_event) */
+    uint32_t       ev;      /* PS3MOD_EV_* */
+    uint64_t       count;   /* per-event sequence number (frame / vblank index) */
+    ps3mod_display display; /* current display state */
+    /* ABI 1.2 (PS3MOD_HAS(ev, path)) */
+    int32_t        result;  /* EV_SCREENSHOT: 0 = written, < 0 = PS3MOD_E_* */
+    uint32_t       _pad0;
+    const char*    path;    /* EV_SCREENSHOT: UTF-8 file, valid during the callback */
+} ps3mod_event;
+
+typedef void (*ps3mod_event_fn)(const ps3mod_event* ev, void* user);
+
+/* ------------------------------------------------------------------------ */
+/* Frame pacing (ABI 1.1)                                                    */
+
+/* What host->set_pacing asks for. The host's vblank clock, its flip clock and
+ * the swap chain's present mode (runtime libs/video/host_pacing.h; the same
+ * knobs as the PS3_VBLANK_HZ / PS3_FLIP_HZ / PS3_VSYNC / PS3_FRAME_LATENCY
+ * environment variables, which win over a plugin's request).
+ *   vblank_hz    guest vblank rate in Hz (the rate the title's vblank handler
+ *                and every vblank-counting wait see); PS3MOD_PACE_DISPLAY =
+ *                the monitor's own vblank; PS3MOD_PACE_KEEP = unchanged.
+ *   flip_hz      when a requested flip completes (flip status DONE + flip
+ *                handler): PS3MOD_PACE_VBLANK = on every guest vblank (the
+ *                console's behaviour), a rate in Hz = on its own timer (a frame
+ *                cap independent of the guest vblank), PS3MOD_PACE_DISPLAY = on
+ *                the monitor's vblank, PS3MOD_PACE_PRESENT = as soon as the
+ *                host presented the frame (uncapped); PS3MOD_PACE_KEEP.
+ *   vsync        1 = Present(1, 0); 0 = no vsync, tearing allowed (VRR); -1 keep
+ *   max_latency  1..3 frames the swap chain may queue (waitable object); 0 keep
+ * Only during ps3mod_init (staged; applied when the plugin is accepted, before
+ * the window exists); PS3MOD_E_FROZEN afterwards. A later plugin's request
+ * overrides an earlier one field by field. */
+#define PS3MOD_PACE_KEEP      0.0
+#define PS3MOD_PACE_DISPLAY (-1.0)
+#define PS3MOD_PACE_PRESENT (-2.0)
+#define PS3MOD_PACE_VBLANK  (-3.0)
+
+typedef struct ps3mod_pacing {
+    uint32_t size;          /* caller: sizeof(ps3mod_pacing) */
+    uint32_t flags;         /* 0 (reserved) */
+    double   vblank_hz;
+    double   flip_hz;
+    int32_t  vsync;
+    int32_t  max_latency;
+} ps3mod_pacing;
+
+/* ------------------------------------------------------------------------ */
+/* Mods overlay rescan, screenshots, debug lines (ABI 1.2)                   */
+
+enum {
+    PS3MOD_RESCAN_FILES    = 1u << 0,   /* re-index the vfs_mods overlay */
+    PS3MOD_RESCAN_TEXTURES = 1u << 1    /* texrepl re-scan + reload changed DDS; flags 0 = both */
+};
+
+typedef struct ps3mod_rescan {
+    uint32_t size;          /* caller: sizeof(ps3mod_rescan) */
+    uint32_t files;         /* overlay files indexed after the rescan */
+    uint32_t added, removed, changed;              /* overlay files vs the previous index (key; size/mtime) */
+    uint32_t textures;      /* texrepl replacement files indexed */
+    uint32_t tex_added, tex_removed, tex_changed;  /* texrepl keys vs the previous index */
+    uint32_t _pad;
+    uint64_t fingerprint;   /* overlay set fingerprint (the PS3_MODS_RESET one) */
+    double   ms;            /* wall time of the rescan */
+} ps3mod_rescan;
+
+enum {
+    PS3MOD_SHOT_GUEST = 1u << 0   /* screenshot: 0 = the presented backbuffer (scaled),
+                                     GUEST = the guest's own frame (1280x720) */
+};
+
+enum {
+    PS3MOD_LINES_NDC = 1u << 0,   /* debug_lines: coordinates in NDC (-1..1), else backbuffer pixels */
+    PS3MOD_LINES_TRIS = 1u << 1,  /* debug_lines: the array is triangles, 3 entries each, one vertex per entry
+                                     (x0, y0 = position, rgba = colour); the plugin's triangle set, separate from
+                                     its lines and drawn under them (alpha blended, no depth); n % 3 == 0 */
+    PS3MOD_LINES_QUERY = 1u << 2  /* debug_lines(NULL, 0, QUERY): returns 1 when TRIS is supported by this host
+                                     (hosts before it return PS3MOD_OK = 0) */
+};
+
+typedef struct ps3mod_line {
+    float    x0, y0, x1, y1;
+    uint32_t rgba;          /* 0xRRGGBBAA */
+    float    width;         /* pixels */
+} ps3mod_line;
+
+/* ------------------------------------------------------------------------ */
+/* Input: keyboard play and the device in use (ABI 1.3)                      */
+
+/* The port plays the pad on port 0 from an XInput controller and from the keyboard (+ mouse
+ * buttons) at the same time. input_info tells which of them pressed something last -- for
+ * button prompts that follow the device, as PC games do -- and the keyboard bindings. */
+enum {
+    PS3MOD_DEV_NONE     = 0,   /* nothing pressed yet */
+    PS3MOD_DEV_KEYBOARD = 1,   /* keyboard or a bound mouse button */
+    PS3MOD_DEV_XINPUT   = 2    /* an XInput (Xbox) controller */
+};
+
+/* The PS3 inputs a key can drive (ps3mod_input.keys index). */
+enum {
+    PS3MOD_IN_CROSS, PS3MOD_IN_CIRCLE, PS3MOD_IN_SQUARE, PS3MOD_IN_TRIANGLE,
+    PS3MOD_IN_L1, PS3MOD_IN_R1, PS3MOD_IN_L2, PS3MOD_IN_R2, PS3MOD_IN_L3, PS3MOD_IN_R3,
+    PS3MOD_IN_START, PS3MOD_IN_SELECT,
+    PS3MOD_IN_UP, PS3MOD_IN_DOWN, PS3MOD_IN_LEFT, PS3MOD_IN_RIGHT,                 /* d-pad */
+    PS3MOD_IN_LS_UP, PS3MOD_IN_LS_DOWN, PS3MOD_IN_LS_LEFT, PS3MOD_IN_LS_RIGHT,     /* left stick */
+    PS3MOD_IN_RS_UP, PS3MOD_IN_RS_DOWN, PS3MOD_IN_RS_LEFT, PS3MOD_IN_RS_RIGHT,     /* right stick */
+    PS3MOD_IN_COUNT
+};
+#define PS3MOD_IN_MAX_KEYS 4
+
+/* Key codes: the physical key, the same on every layout -- the PC/AT set-1 scancode, plus
+ * PS3MOD_KEY_EXT for E0-extended keys (arrows, Insert..PageDown, right Ctrl/Alt, keypad
+ * Enter and /); mouse buttons and the wheel from 0x200. 0 = no key.
+ * host->key_name gives the key's place on a US keyboard ("W", "LShift", "Num8", "MouseLeft"),
+ * host->key_label what it says on the user's layout ("Z" for that W on AZERTY). */
+enum {
+    PS3MOD_KEY_EXT          = 0x100,
+    PS3MOD_KEY_MOUSE_LEFT   = 0x200,
+    PS3MOD_KEY_MOUSE_RIGHT  = 0x201,
+    PS3MOD_KEY_MOUSE_MIDDLE = 0x202,
+    PS3MOD_KEY_MOUSE_X1     = 0x203,
+    PS3MOD_KEY_MOUSE_X2     = 0x204,
+    PS3MOD_KEY_WHEEL_UP     = 0x205,
+    PS3MOD_KEY_WHEEL_DOWN   = 0x206
+};
+
+typedef struct ps3mod_input {
+    uint32_t size;            /* caller: sizeof(ps3mod_input) */
+    uint32_t last_device;     /* PS3MOD_DEV_* that pressed a button / key last on port 0 */
+    uint32_t device_serial;   /* bumped every time last_device changes */
+    uint32_t keyboard;        /* 1 = keyboard play is on (PAD_NO_KEYBOARD turns it off) */
+    uint32_t xinput_mask;     /* bit n = XInput slot n has a controller */
+    uint32_t _pad;
+    /* effective keyboard bindings: up to PS3MOD_IN_MAX_KEYS key codes per PS3 input, the
+     * first one is the main key (the one prompts show); 0 = unused slot. Built once, at the
+     * first input_info call or the game's cellPadInit, from the port's default, input.ini
+     * [keyboard] next to the exe, then PS3_KEYS (the process environment: a plugin that sets
+     * PS3_KEYS in ps3mod_init must do so before its first input_info call). */
+    uint16_t keys[PS3MOD_IN_COUNT][PS3MOD_IN_MAX_KEYS];
+} ps3mod_input;
+
+/* ------------------------------------------------------------------------ */
+/* Plugin services (ABI 1.2)                                                 */
+
+/* A service is a C function table one plugin publishes under a name for the
+ * others (e.g. the title's script-VM API that one mod-host plugin owns).
+ * Its layout belongs to the publisher; by convention it starts with a
+ * uint32_t size and grows only at the end, and `version` is bumped when a
+ * member is added. Plugins load in name order: look services up lazily (first
+ * use, a hook, or PS3MOD_EV_DISPLAY_READY), not inside ps3mod_init, unless
+ * the publisher is known to load first. */
+
+/* ------------------------------------------------------------------------ */
+/* Data patches                                                              */
+
+enum {
+    /* Allow a patch inside the lifted code range. Lifted code ignores its
+     * own bytes (instructions were compiled at lift time), so such a patch
+     * only matters for code the game READS as data. Refused by default. */
+    PS3MOD_PATCH_ALLOW_CODE = 1u << 0
+};
+
+/* ------------------------------------------------------------------------ */
+/* The host API                                                              */
+
+typedef struct ps3mod_host ps3mod_host;
+
+struct ps3mod_host {
+    uint32_t    size;             /* sizeof(ps3mod_host) of the host */
+    uint32_t    abi_version;      /* PS3MOD_ABI_VERSION of the host */
+    uint32_t    ctx_layout;       /* PS3MOD_CTX_LAYOUT */
+    uint32_t    ctx_size;         /* sizeof(ppu_context) == PS3MOD_CTX_SIZE */
+    uint32_t    lift_abi;         /* PS3MOD_LIFT_ABI */
+    uint32_t    hooks_available;  /* 1 if function hooks work in this exe */
+    const char* ppu_hash;         /* "PPU-<40 hex>" of the running ELF */
+    const char* lift_id;          /* "LIFT-<count>-<16 hex>": fingerprint of function_table */
+    const char* plugin_name;      /* this plugin's DLL basename (no extension) */
+    const char* plugin_path;      /* full UTF-8 path of the DLL */
+    const char* config_path;      /* UTF-8 path of its .ini/.toml ("" if none) */
+    const char* mods_root;        /* UTF-8 <mods> directory */
+    uint8_t*    vm_base;          /* host address of guest address 0 (4 GiB window) */
+
+    /* -- log ---------------------------------------------------------------
+     * Writes "[mod:<plugin_name>] <message>" to stderr. `self` is the host
+     * pointer this plugin was given (identifies the plugin). */
+    void (*log)(const ps3mod_host* self, int level, const char* fmt, ...);
+
+    /* -- guest memory (big-endian guest, host-order values) ----------------- */
+    uint8_t  (*read8)(uint32_t addr);
+    uint16_t (*read16)(uint32_t addr);
+    uint32_t (*read32)(uint32_t addr);
+    uint64_t (*read64)(uint32_t addr);
+    float    (*read_f32)(uint32_t addr);
+    double   (*read_f64)(uint32_t addr);
+    void     (*write8)(uint32_t addr, uint8_t v);
+    void     (*write16)(uint32_t addr, uint16_t v);
+    void     (*write32)(uint32_t addr, uint32_t v);
+    void     (*write64)(uint32_t addr, uint64_t v);
+    void     (*write_f32)(uint32_t addr, float v);
+    void     (*write_f64)(uint32_t addr, double v);
+    /* Raw byte copies (no byte swapping). 0 = OK, PS3MOD_E_RANGE if
+     * [addr, addr+n) leaves the 4 GiB guest space. */
+    int      (*read_block)(uint32_t addr, void* dst, uint32_t n);
+    int      (*write_block)(uint32_t addr, const void* src, uint32_t n);
+    /* Guest address -> host pointer for [addr, addr+n); NULL if out of range.
+     * host_to_guest is the inverse; 0 if p is not inside guest memory. */
+    void*    (*guest_to_host)(uint32_t addr, uint32_t n);
+    uint32_t (*host_to_guest)(const void* p);
+
+    /* -- function hooks ------------------------------------------------------
+     * Hook the lifted guest function whose ENTRY is guest_addr.
+     *   mode           PS3MOD_HOOK_WRAP or PS3MOD_HOOK_REPLACE
+     *   entry_lrs/n    optional call-site filter: the hook runs only when
+     *                  entry_lr is one of these values (call site + 4); on any
+     *                  other entry the chain continues as if the hook were not
+     *                  there. NULL/0 = every entry. The array is copied.
+     * Returns PS3MOD_OK, PS3MOD_E_NOT_ENTRY (not a lifted function entry),
+     * PS3MOD_E_IMPORT_STUB, PS3MOD_E_UNAVAILABLE (exe without hooks),
+     * PS3MOD_E_FROZEN, PS3MOD_E_CONFLICT (second REPLACE without filter), ... */
+    int  (*hook_register)(const ps3mod_host* self, uint32_t guest_addr, ps3mod_hook_fn fn,
+                          void* user, uint32_t mode, const uint32_t* entry_lrs, uint32_t n_entry_lrs);
+    /* Run the rest of the chain: the next hook, or the original function and
+     * every tail call it left pending. No-op for next == NULL. */
+    void (*call_next)(ps3mod_ctx* ctx, const ps3mod_link* next);
+    /* 1 if guest_addr is a hookable lifted function entry in this exe. */
+    int  (*is_function_entry)(uint32_t guest_addr);
+
+    /* -- guest calls --------------------------------------------------------
+     * guest_call: call the guest function whose OPD is at opd_addr with up to
+     * 8 integer args (r3..r10); returns r3. See ps3mod_call for stacks.
+     * guest_call_ex: full form (float args, f1 result). Returns 0 or
+     * PS3MOD_E_NOT_ENTRY / PS3MOD_E_ARG. */
+    uint64_t (*guest_call)(ps3mod_ctx* ctx, uint32_t opd_addr, uint32_t nargs, const uint64_t* args);
+    int      (*guest_call_ex)(ps3mod_ctx* ctx, ps3mod_call* call);
+
+    /* -- config (<plugin>.ini / .toml next to the DLL) ----------------------
+     * key = "name" (top level, else first match in any section) or
+     * "section.name". Env PS3MOD_<PLUGIN>_<KEY> (upper-case, '.'->'_')
+     * overrides the file. Strings stay valid until the plugin is unloaded.
+     * Booleans: 1/0, true/false, yes/no, on/off. */
+    const char* (*cfg_str)(const ps3mod_host* self, const char* key, const char* def);
+    int64_t     (*cfg_int)(const ps3mod_host* self, const char* key, int64_t def);
+    double      (*cfg_float)(const ps3mod_host* self, const char* key, double def);
+    int         (*cfg_bool)(const ps3mod_host* self, const char* key, int def);
+
+    /* -- host display + frame events ------------------------------------------
+     * get_display: current window / backbuffer / render size and aspect;
+     * callable any time from any thread, cheap (cached values, no OS call).
+     * Before the window exists: ready = 0, window_w/h = 0, aspect = render
+     * aspect. The backbuffer is created at the render size and stretched to
+     * the window, so aspect (window) != render aspect means stretching.
+     * on_event: register fn for PS3MOD_EV_*; runs on the host present/vblank
+     * thread -- keep it short and do guest-state work from hooks. */
+    int  (*get_display)(ps3mod_display* out);
+    int  (*on_event)(const ps3mod_host* self, uint32_t ev, ps3mod_event_fn fn, void* user);
+
+    /* -- data patches ---------------------------------------------------------
+     * Write n bytes at guest addr after verifying the current bytes equal
+     * `expect` (n bytes, required). PS3MOD_E_MISMATCH on any difference (wrong
+     * game version / another mod got there first). During init the patch is
+     * verified immediately and applied when the plugin is accepted; later
+     * calls apply at once. Refused inside the lifted code range unless
+     * PS3MOD_PATCH_ALLOW_CODE. Each applied patch is logged. */
+    int  (*patch)(const ps3mod_host* self, uint32_t addr, const void* expect,
+                  const void* bytes, uint32_t n, uint32_t flags);
+
+    /* -- frame pacing (ABI 1.1; check PS3MOD_HAS(host, set_pacing)) ----------
+     * See ps3mod_pacing. Returns PS3MOD_OK, PS3MOD_E_FROZEN (after init),
+     * PS3MOD_E_ARG (bad size / values). */
+    int  (*set_pacing)(const ps3mod_host* self, const ps3mod_pacing* p);
+
+    /* ======== ABI 1.2 (check PS3MOD_HAS(host, debug_lines) once for all) ==== */
+
+    /* -- hooks at any time ----------------------------------------------------
+     * hook_add: like hook_register (same arguments, checks and chain order),
+     * but it also works after ps3mod_init, while the game runs: the hook is
+     * live when the call returns (a thread already inside the function keeps
+     * the chain it entered). During ps3mod_init it is staged like
+     * hook_register. *handle_out (optional) receives a non-zero handle.
+     * hook_enable: switch a hook added by THIS plugin off (on = 0) or back on.
+     * A disabled hook behaves as if absent (its link just runs the rest of
+     * the chain). Hooks are never removed, so disabling is race-free; re-use
+     * a disabled handle instead of adding the same hook again. An unfiltered
+     * REPLACE still conflicts with another unfiltered REPLACE, enabled or not.
+     * Returns PS3MOD_OK, the hook_register errors, PS3MOD_E_ARG (unknown /
+     * foreign handle). */
+    int  (*hook_add)(const ps3mod_host* self, uint32_t guest_addr, ps3mod_hook_fn fn, void* user,
+                     uint32_t mode, const uint32_t* entry_lrs, uint32_t n_entry_lrs, uint32_t* handle_out);
+    int  (*hook_enable)(const ps3mod_host* self, uint32_t handle, int on);
+
+    /* -- guest heap -----------------------------------------------------------
+     * Memory in the GUEST address space that belongs to the host, never to
+     * the title's allocators: for data the game must read through guest
+     * pointers (strings and structs passed to guest calls, script images).
+     * guest_alloc returns a zero-filled block aligned to `align` (power of
+     * two, min 16), or 0 if the heap is full. guest_free(0) is a no-op; a
+     * block is freed by any plugin (the owner is logged on misuse only).
+     * Thread-safe. The heap is a reserved window below 0x80000000
+     * (default 0x7C000000..0x7F000000, committed on demand; env
+     * PS3MOD_GUEST_HEAP=<hex base> moves it). */
