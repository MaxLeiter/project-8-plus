+/*
+ * ps3recomp - the browser filesystem (PS3_WASM + Emscripten WasmFS builds).
+ *
+ *   /game   read-only game data, streamed on demand: a WasmFS JS-implemented backend. Its reads block the calling
+ *           thread on the IO worker (web/host/io-worker.js) through a slot table that lives HERE, in wasm memory.
+ *   /hdd0   the console's hard disk (saves, data cache): WasmFS's OPFS backend, persistent per site.
+ * Every thread runs its own copy of the JS glue (web/host/lib_ps3web.js), so all per-file state is in this file's
+ * table; the glue finds a file's record with ps3_web_vfs_rec(file).
+ * ps3_web_vfs_mount() runs at the top of main(), on the game's main pthread (it blocks: index fetch, OPFS setup).
+ */
+#if defined(PS3_WASM) && defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+#include <emscripten/wasmfs.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+/* IO worker protocol (web/host/vfs-proto.js) */
+#define VFS_SLOTS 64
+#define VFS_SLOT_I32 16
+#define VFS_NAME_BYTES 1024
+static int32_t s_vfs_ctl[1 + VFS_SLOTS * VFS_SLOT_I32] __attribute__((aligned(16)));
+static uint8_t s_vfs_names[VFS_SLOTS * VFS_NAME_BYTES];
+EMSCRIPTEN_KEEPALIVE int32_t* ps3_web_vfs_ctl(void) { return s_vfs_ctl; }
+EMSCRIPTEN_KEEPALIVE uint8_t* ps3_web_vfs_names(void) { return s_vfs_names; }
+
+/* One record per game file. JS reads it straight from memory: +0 file (WasmFS object), +4 path ptr, +8 path len,
+ * +12 fd (IO worker file index, -1 until first use), +16 size (f64). */
+typedef struct { uint32_t file; const char* path; uint32_t len; volatile int32_t fd; double size; } vfs_rec;
+static vfs_rec* s_recs; static int s_nrec, s_cap; static volatile int s_pending = -1;
+
+EMSCRIPTEN_KEEPALIVE void ps3_web_vfs_bind(uint32_t file)      /* allocFile of the file being created */
+{
+    /* s_pending is the record being created: index s_nrec, counted only after open() succeeds */
+    if (s_pending >= 0 && s_pending < s_cap) s_recs[s_pending].file = file;
+}
+EMSCRIPTEN_KEEPALIVE vfs_rec* ps3_web_vfs_rec(uint32_t file)
+{
+    /* records are created in order and files are allocated in that order: the table is sorted by file pointer
+     * only by accident, so a hash would be wrong to rely on -- a binary search over a sorted index is built once */
+    static uint32_t* keys; static int* idx; static int n;
+    if (s_pending >= 0 && s_pending < s_cap && s_recs && s_recs[s_pending].file == file) return &s_recs[s_pending];
+    if (n != s_nrec) {                       /* (re)build after the mount added records -- WasmFS asks for sizes while
+                                              * files are still being created, so the first call is not the last */
+        free(keys); free(idx);
+        keys = (uint32_t*)malloc(sizeof(uint32_t) * s_nrec); idx = (int*)malloc(sizeof(int) * s_nrec);
+        for (int i = 0; i < s_nrec; i++) { keys[i] = s_recs[i].file; idx[i] = i; }
+        for (int i = 1; i < s_nrec; i++) {                   /* insertion sort: 5k entries, once */
+            uint32_t k = keys[i]; int v = idx[i], j = i - 1;
+            while (j >= 0 && keys[j] > k) { keys[j + 1] = keys[j]; idx[j + 1] = idx[j]; j--; }
+            keys[j + 1] = k; idx[j + 1] = v;
+        }
+        n = s_nrec;
+    }
+    int lo = 0, hi = n - 1;
+    while (lo <= hi) { const int m = (lo + hi) / 2; if (keys[m] == file) return &s_recs[idx[m]]; if (keys[m] < file) lo = m + 1; else hi = m - 1; }
+    return NULL;
+}
+
+/* lib_ps3web.js */
+extern void ps3web_vfs_register(backend_t b);
+extern char* ps3web_vfs_list(void);                 /* "size\tpath\n"... (malloc'd), from data/index.json */
+extern char* ps3web_vfs_list_url(const char* base); /* the same from <base>index.json (the ?mods= pack) */
+extern char* ps3web_vfs_list_url_t(const char* base); /* "size\tmtime_s\tpath\n" from <base>index.json */
+
+static void mkdirs(const char* path)
+{
+    char tmp[1100];
+    snprintf(tmp, sizeof tmp, "%s", path);
+    for (char* p = tmp + 1; *p; p++) if (*p == '/') { *p = 0; mkdir(tmp, 0777); *p = '/'; }
+}
+
+void ps3_web_vfs_mount(void)
+{
+    static int done;
+    if (done) return;
+    done = 1;
+    backend_t game = wasmfs_create_jsimpl_backend();
+    ps3web_vfs_register(game);
+    if (wasmfs_create_directory("/game", 0777, game) != 0) { fprintf(stderr, "[webvfs] cannot create /game\n"); return; }
+    char* list = ps3web_vfs_list();
+    if (!list) { fprintf(stderr, "[webvfs] no data index\n"); return; }
+    int lines = 0;
+    for (char* p = list; *p; p++) if (*p == '\n') lines++;
+    /* ?mods=<name> (the page sets PS3WEB_MODS_URL = the absolute URL of its mods_<name>/ pack): a second
+     * read-only tree at /mods on the same streamed backend; its records are named "@mods/<path>" so the IO worker
+     * fetches them from that pack. Without the variable nothing below changes. */
+    const char* mods_url = getenv("PS3WEB_MODS_URL");
+    char* mlist = (mods_url && *mods_url) ? ps3web_vfs_list_url_t(mods_url) : NULL;
+    int nmt = 0, nmtfail = 0;
+    int mlines = 0;
+    if (mlist) for (char* p = mlist; *p; p++) if (*p == '\n') mlines++;
+    s_recs = (vfs_rec*)calloc((size_t)lines + (size_t)mlines + 1, sizeof *s_recs);
+    s_cap = lines + mlines + 1;
+    char full[1100];
+    for (char* p = list; *p;) {
+        char* nl = strchr(p, '\n'); if (!nl) break; *nl = 0;
+        char* tab = strchr(p, '\t');
+        if (tab) {
+            *tab = 0;
+            vfs_rec* r = &s_recs[s_nrec];
+            r->size = strtod(p, NULL); r->path = tab + 1; r->len = (uint32_t)strlen(tab + 1); r->fd = -1;
+            snprintf(full, sizeof full, "/game/%s", r->path);
+            mkdirs(full);
+            s_pending = s_nrec;
+            const int fd = open(full, O_CREAT | O_WRONLY, 0444);
+            if (fd >= 0) { close(fd); s_nrec++; }
+            s_pending = -1;
+        }
+        p = nl + 1;
+    }
+    /* `list` stays allocated: the records point into it */
+    int nmods = 0;
+    if (mlist) {
+        if (wasmfs_create_directory("/mods", 0777, game) != 0) fprintf(stderr, "[webvfs] cannot create /mods\n");
+        else for (char* p = mlist; *p;) {
+            char* nl = strchr(p, '\n'); if (!nl) break; *nl = 0;
+            char* tab = strchr(p, '\t');
+            /* "size\tmtime\tpath" (ps3web_vfs_list_url_t): the file gets the pack's mtime, so the mods overlay's
+             * fingerprint (runtime/syscalls/vfs_mods.c: size + mtime) does not change from boot to boot and the
+             * title's HDD data cache is not reset on every launch */
+            char* tab2 = tab ? strchr(tab + 1, '\t') : NULL;
+            const long long mt = tab2 ? strtoll(tab + 1, NULL, 10) : -1;
+            if (tab2) tab = tab2;
+            if (tab) {
+                *tab = 0;
+                const size_t n = strlen(tab + 1);
+                char* name = (char*)malloc(n + 7);             /* "@mods/" + path; kept for the record */
+                memcpy(name, "@mods/", 6); memcpy(name + 6, tab + 1, n + 1);
+                vfs_rec* r = &s_recs[s_nrec];
+                r->size = strtod(p, NULL); r->path = name; r->len = (uint32_t)(n + 6); r->fd = -1;
+                snprintf(full, sizeof full, "/mods/%s", tab + 1);
+                mkdirs(full);
+                s_pending = s_nrec;
+                const int fd = open(full, O_CREAT | O_WRONLY, 0444);
+                if (fd >= 0) { close(fd); s_nrec++; nmods++; } else free(name);
+                s_pending = -1;
+                if (fd >= 0 && mt >= 0) {
+                    const struct timespec ts[2] = { { (time_t)mt, 0 }, { (time_t)mt, 0 } };
+                    if (utimensat(AT_FDCWD, full, ts, 0) != 0) nmtfail++;
+                    else nmt++;
+                }
+            }
+            p = nl + 1;
+        }
+        fprintf(stderr, "[webvfs] /mods: %d files streamed from %s (pack mtimes: %d set, %d failed)\n", nmods, mods_url, nmt, nmtfail);
+    } else if (mods_url && *mods_url) fprintf(stderr, "[webvfs] /mods: no index at %s\n", mods_url);
+    (void)ps3_web_vfs_rec(0);                /* final index build here, before other threads look files up */
+    backend_t opfs = wasmfs_create_opfs_backend();
+    const int hdd = wasmfs_create_directory("/hdd0", 0777, opfs);
+    if (hdd != 0) mkdir("/hdd0", 0777);
+    fprintf(stderr, "[webvfs] /game: %d files streamed from the page's data/; /hdd0: %s\n", s_nrec,
+            hdd == 0 ? "OPFS (persistent)" : "memory (no OPFS: saves are lost on reload)");
+}
+#else
+typedef int ps3_web_vfs_unused;
+#endif
