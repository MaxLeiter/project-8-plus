+/* A save runs as one pass (crash-safe saving above): cellSaveData_busy() counts it, the files it
+ * writes are recorded, and a reCreateMode YES cleanup happens only after everything was written. */
 static s32 savedata_execute(const char* dirName, int is_save,
                              CellSaveDataSetBuf* setBuf,
                              CellSaveDataStatCallback funcStat,
                              CellSaveDataFileCallback funcFile,
                              void* userdata)
+{
+    save_root();                                   /* resolves the folder (+ the shared-folder start) before the lock */
+    /* a shared save folder: one pass at a time across every game using it (savedata_pass_lock) */
+    const int locked = savedata_pass_lock(is_save);
+    if (!locked && is_save) return CELL_SAVEDATA_ERROR_BUSY;
+    s32 r;
+    if (!is_save) {
+        r = savedata_execute_pass(dirName, 0, setBuf, funcStat, funcFile, userdata, NULL);
+    } else {
+        savedata_pass* pass = (savedata_pass*)calloc(1, sizeof *pass);
+        if (!pass) { if (locked) savedata_pass_unlock(); return CELL_SAVEDATA_ERROR_INTERNAL; }
+        savedata_busy_add(1);
+        savedata_pass* prev = s_pass;
+        s_pass = pass;
+        r = savedata_execute_pass(dirName, 1, setBuf, funcStat, funcFile, userdata, pass);
+        s_pass = prev;
+        savedata_busy_add(-1);
+        free(pass);
+    }
+    if (locked) savedata_pass_unlock();
+    return r;
+}
