+/* ---------------------------------------------------------------------------
+ * State + outcome
+ * ------------------------------------------------------------------------ */
+enum { O_NEXT, O_STOP, O_HALT, O_TRAP, O_ILLEGAL, O_FELL, O_BADFN, O_TIMEOUT };
+static const char* const o_name[] = { "NEXT", "STOP", "HALT", "TRAP(unimplemented)", "ILLEGAL", "FELL-OFF", "BAD-TRAMPOLINE-FN", "TIMEOUT" };
+typedef struct { int kind; uint32_t pc, code; } outc;
+
+typedef struct {
+    outc o;
+    uint8_t gpr[128][16];
+    uint32_t int_enable;
+    chlog log;
+} result;
+
+static uint8_t g_base_ls[SPU_REF_LS_SIZE];
+static uint8_t g_ref_ls[SPU_REF_LS_SIZE];
+static spu_context g_ci, g_cl;      /* interp, lifted */
+
+static void ctx_load(spu_context* c, const seedstate* st, uint32_t pc)
+{
+    for (int r = 0; r < 128; r++)
+        for (int w = 0; w < 4; w++) c->gpr[r]._u32[w] = get32(st->gpr[r] + 4 * w);
+    c->pc = pc; c->srr0 = st->srr0; c->int_enable = st->int_enable;
+    c->event_status = st->event_status; c->event_mask = st->event_mask;
+    c->status = SPU_STATUS_RUNNING; c->stop_code = 0xDEADBEEFu;
+    c->image_id = 0; c->host_depth = 0; c->policy_mode = 0;
+}
+static void ctx_save(const spu_context* c, result* r)
+{
+    for (int i = 0; i < 128; i++)
+        for (int w = 0; w < 4; w++) put32(r->gpr[i] + 4 * w, c->gpr[i]._u32[w]);
+    r->int_enable = c->int_enable;
+}
+
+static const spck_image* g_img;
+static int fn_at(uint32_t pc, void (*fn)(spu_context*))
+{
+    size_t lo = 0, hi = g_img->nfns;
+    while (lo < hi) {
+        size_t m = (lo + hi) / 2;
+        if (g_img->fns[m].addr < pc) lo = m + 1; else hi = m;
+    }
+    return lo < g_img->nfns && g_img->fns[lo].addr == pc && g_img->fns[lo].fn == fn;
+}
+static void (*seq_find_fn(uint32_t pc))(spu_context*)
+{
+    size_t lo = 0, hi = g_img->nfns;
+    while (lo < hi) {
+        size_t m = (lo + hi) / 2;
+        if (g_img->fns[m].addr < pc) lo = m + 1; else hi = m;
+    }
+    return (lo < g_img->nfns && g_img->fns[lo].addr == pc) ? g_img->fns[lo].fn : 0;
+}
+/* The SPU_DRAIN loop for a sequence program: while the pending transfer is
+ * one of the program's own lifted functions (fall-through chaining or a
+ * cross-function branch, taken through the trampoline while interrupts are
+ * enabled), run it -- as spu_run_with_halt / spu_drain_call_full do. */
+static uint32_t g_seq_lo, g_seq_hi;
+static int seq_drain(spu_context* c)
+{
+    int n = 0;
+    while (g_seq_mode && g_spu_trampoline_fn && g_spu_trampoline_fn != spu_indirect_branch) {
+        uint32_t pc = (uint32_t)c->pc & 0x3FFFFu;
+        if (pc < g_seq_lo || pc >= g_seq_hi || !fn_at(pc, g_spu_trampoline_fn)) break;
+        void (*tf)(spu_context*) = g_spu_trampoline_fn;
+        g_spu_trampoline_fn = 0;
+        tf(c);
+        if (++n > 100000) break;      /* a runaway loop (the reference would time out) */
+    }
+    return n;
+}
+static int pad_addr(uint32_t code, uint32_t* addr)
+{
+    for (const spck_pad* p = g_img->pads; p->code; p++)
+        if (p->code == code) { *addr = p->addr; return 1; }
+    return 0;
+}
+
+static outc lifted_outcome(const spck_case* cs, int ev, int returned)
+{
+    outc o = { O_NEXT, 0, 0 };
+    spu_context* c = &g_cl;
+    if (returned) {
+        void (*tf)(spu_context*) = g_spu_trampoline_fn;
+        if (!tf) {
+            if (c->status == SPU_STATUS_STOPPED_BY_HALT) { o.kind = O_HALT; return o; }
+            o.kind = O_FELL; return o;
+        }
+        if (tf == spu_indirect_branch) { o.pc = c->pc & SPCK_IB_MASK; return o; }
+        if (fn_at(c->pc, tf)) { o.pc = c->pc; return o; }
+        o.kind = O_BADFN; o.pc = c->pc; return o;
+    }
+    switch (ev) {
+    case EV_STOP: {
+        uint32_t a;
+        if (c->stop_code == SENT1 && !cs->seq_hi) { o.pc = cs->addr + 4; return o; }
+        if (c->stop_code == SENT2 && cs->exit2) { o.pc = cs->exit2; return o; }
+        if (pad_addr(c->stop_code, &a)) { o.pc = a; return o; }
+        o.kind = O_STOP; o.code = c->stop_code; return o; }
+    case EV_HALT: o.kind = O_HALT; return o;
+    case EV_IB:   o.pc = g_ev_pc & SPCK_IB_MASK; return o;
+    case EV_DRAIN:
+        if (g_ev_fn == spu_indirect_branch) { o.pc = g_ev_pc & SPCK_IB_MASK; return o; }
+        if (fn_at(g_ev_pc, g_ev_fn)) { o.pc = g_ev_pc; return o; }
+        o.kind = O_BADFN; o.pc = g_ev_pc; return o;
+    }
+    o.kind = O_FELL; return o;
+}
+
+/* ---------------------------------------------------------------------------
+ * Reference I/O
+ * ------------------------------------------------------------------------ */
+static uint32_t ref_rdch(void* u, uint32_t ch) { (void)u; uint32_t v = chval(ch); logch(1, ch, v); return v; }
+static uint32_t ref_rchcnt(void* u, uint32_t ch) { (void)u; uint32_t v = chcnt(ch); logch(2, ch, v); return v; }
+static void ref_wrch(void* u, uint32_t ch, uint32_t v) { (void)u; logch(3, ch, v); }
+static const spu_ref_io g_refio = { 0, ref_rdch, ref_wrch, ref_rchcnt };
+
+/* ---------------------------------------------------------------------------
+ * Sequence programs: the reference and the interpreter step until the point
+ * where the lifted function's run ends -- a stop / halt, control leaving the
+ * program's code [lo, hi) (a landing pad, a stub target), or a taken indirect
+ * branch that is not the return of a call made inside the program (the leaf
+ * `bi $r0`: the lifted brsl is a nested host call that comes back).
+ * ------------------------------------------------------------------------ */
+static long g_decode_mismatch, g_ref_illegal;
+enum { K_PLAIN, K_CALL, K_IND };
+static int seq_kind(uint32_t insn)
+{
+    const char* m = spu_ref_mnemonic(insn);
+    if (!strcmp(m, "brsl") || !strcmp(m, "brasl") || !strcmp(m, "bisl")) return K_CALL;
+    if (!strcmp(m, "bi") || !strcmp(m, "bisled") || !strcmp(m, "iret") ||
+        !strcmp(m, "biz") || !strcmp(m, "binz") || !strcmp(m, "bihz") || !strcmp(m, "bihnz")) return K_IND;
+    return K_PLAIN;
+}
+#define SEQ_MAX_STEPS 4096
+/* one step: returns 0 = continue, 1 = run ended (*o set) */
+static int seq_after(uint32_t pc, int kind, uint32_t next, uint32_t* stk, int* sp, outc* o)
+{
+    if (kind == K_CALL) { if (*sp < 16) stk[(*sp)++] = (pc + 4) & 0x3FFFCu; return 0; }
+    if (kind == K_IND && next != ((pc + 4) & 0x3FFFFu)) {
+        if (*sp > 0 && (next & 0x3FFFCu) == stk[*sp - 1]) { (*sp)--; return 0; }
+        o->kind = O_NEXT; o->pc = next & SPCK_IB_MASK; return 1;
+    }
+    return 0;
+}
+static unsigned g_trace_addr = ~0u; static int g_trace_seed = -1;
+static int g_trace;               /* SPUCHECK_TRACE=<program LS addr>,<seed>: print the reference steps */
+static void trace_regs(const char* tag, const spu_ref_state* rs, uint32_t insn)
+{
+    int regs[4]; const char* f; char b[64];
+    int n = spu_ref_operand_regs(insn, regs, &f);
+    printf("      %s", tag);
+    for (int i = 0; i < n; i++) {
+        snprintf(b, sizeof b, "%08X_%08X_%08X_%08X", get32(rs->gpr[regs[i]]), get32(rs->gpr[regs[i]] + 4),
+                 get32(rs->gpr[regs[i]] + 8), get32(rs->gpr[regs[i]] + 12));
+        printf(" r%d=%s", regs[i], b);
+    }
+    printf("\n");
+}
+static outc seq_ref(spu_ref_state* rs, uint32_t lo, uint32_t hi, long* steps)
+{
+    outc o = { O_NEXT, 0, 0 };
+    uint32_t stk[16]; int sp = 0;
+    for (long n = 0;; n++) {
+        uint32_t pc = rs->pc & 0x3FFFCu;
+        if (pc < lo || pc >= hi) { o.pc = pc; *steps += n; return o; }
+        if (n >= SEQ_MAX_STEPS) { o.kind = O_TIMEOUT; *steps += n; return o; }
+        uint32_t insn = get32(rs->ls + pc);
+        int kind = seq_kind(insn);
+        spu_ref_result res;
+        if (g_trace) { printf("    %05X %08X %-9s", pc, insn, spu_ref_mnemonic(insn)); trace_regs("in ", rs, insn); }
+        spu_ref_step(rs, &g_refio, &res);
+        if (g_trace) { printf("                             "); trace_regs("out", rs, insn); }
+        if (res.kind == SPU_REF_STOP) { o.kind = O_STOP; o.code = res.stop_code; *steps += n + 1; return o; }
+        if (res.kind == SPU_REF_HALT) { o.kind = O_HALT; *steps += n + 1; return o; }
+        if (res.kind != SPU_REF_NEXT) { o.kind = O_ILLEGAL; g_ref_illegal++; *steps += n + 1; return o; }
+        if (seq_after(pc, kind, res.next_pc, stk, &sp, &o)) { *steps += n + 1; return o; }
+    }
+}
+static outc seq_interp(spu_context* c, uint32_t lo, uint32_t hi)
+{
+    outc o = { O_NEXT, 0, 0 };
+    uint32_t stk[16]; int sp = 0;
+    for (long n = 0;; n++) {
+        uint32_t pc = (uint32_t)c->pc & 0x3FFFCu;
+        if (pc < lo || pc >= hi) { o.pc = pc; return o; }
+        if (n >= SEQ_MAX_STEPS) { o.kind = O_TIMEOUT; return o; }
+        uint32_t insn = get32(c->ls + pc);
+        int kind = seq_kind(insn);
+        if (spu_interp_step1(c)) {
+            if (c->status & SPU_STATUS_STOPPED_BY_STOP) { o.kind = O_STOP; o.code = c->stop_code; }
+            else o.kind = (c->stop_code == 0xDEADBEEFu) ? O_TRAP : O_HALT;
+            return o;
+        }
+        if (seq_after(pc, kind, (uint32_t)c->pc, stk, &sp, &o)) return o;
+    }
+}
