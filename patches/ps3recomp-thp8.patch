+        if (k == 2) { float f = (float)((int32_t)lds_below(r, 2000) - 1000) / 16.0f; memcpy(&w, &f, 4); }
+        else w = lds_below(r, 256) - 128;
+        w = __builtin_bswap32(w);              /* vr holds raw big-endian guest bytes */
+        memcpy(&v->b[i * 4], &w, 4);
+    }
+}
+
+uint64_t lds_gen_gpr(LdsRng* r) { uint64_t v = lds_gen_gpr_raw(r); return g_lds.nanfree ? lds_nf64(v) : v; }
+double lds_gen_fpr(LdsRng* r)
+{
+    double d = lds_gen_fpr_raw(r);
+    if (g_lds.nanfree) { uint64_t b; memcpy(&b, &d, 8); b = lds_nf64(b); memcpy(&d, &b, 8); }
+    return d;
+}
+void lds_gen_vr(LdsRng* r, ppu_vr* v)
+{
+    lds_gen_vr_raw(r, v);
+    if (g_lds.nanfree)
+        for (int i = 0; i < 4; i++) {
+            uint32_t w; memcpy(&w, &v->b[i * 4], 4);
+            w = __builtin_bswap32(lds_nf32(__builtin_bswap32(w)));
+            memcpy(&v->b[i * 4], &w, 4);
+        }
+}
+
+/* ======================= trace + clobber ===================================== */
+LdsEvent    g_detail_ev[LDS_DETAIL_EVENTS];
+ppu_context g_detail_regs[LDS_DETAIL_EVENTS];
+
+void lds_trace_reset(void)
+{
+    g_trace.hash = 0x7AACE0007AACE000ull;
+    g_trace.count = 0;
+    g_trace.timebase = 0x0000001234500000ull;
+}
+
+void lds_record_and_clobber(ppu_context* ctx, uint32_t kind, uint32_t target)
+{
+    const uint64_t h = lds_hash_regs(ctx, 0);
+    if (g_lds.detail && g_trace.count < LDS_DETAIL_EVENTS) {
+        g_detail_ev[g_trace.count] = { kind, target, h };
+        memcpy(&g_detail_regs[g_trace.count], ctx, sizeof *ctx);
+    }
+    g_trace.hash = lds_h(lds_h(lds_h(g_trace.hash, kind), target), h);
+    if (++g_trace.count > g_lds.trace_limit)
+        RaiseException(LDS_EXC_TRACELIMIT, 0, 0, nullptr);
+
+    LdsRng r = { h ^ ((uint64_t)kind << 56) ^ ((uint64_t)target << 8) ^ 0xC10BBE55ull };
+
+    /* an out-parameter: the callee writes through r3 when it points at the heap */
+    if (ctx->gpr[3] >= LDS_HEAP_LO && ctx->gpr[3] + 8 <= LDS_HEAP_HI) {
+        uint64_t v = lds_next(&r);
+        if (g_lds.nanfree) v = lds_nf64(v);
+        memcpy(vm_base + (uint32_t)ctx->gpr[3], &v, 8);
+    }
+
+    if (g_lds.clobber == LDS_CLOBBER_ALL) {
+        for (int i = 0; i < 32; i++)
+            if (i != 1 && i != 2 && i != 13) ctx->gpr[i] = lds_gen_gpr(&r);
+        for (int i = 0; i < 32; i++) ctx->fpr[i] = lds_gen_fpr(&r);
+        for (int i = 0; i < 32; i++) lds_gen_vr(&r, &ctx->vr[i]);
+        ctx->cr  = (uint32_t)lds_next(&r);
+        ctx->ctr = lds_below(&r, 64);
+        ctx->xer = ((uint32_t)lds_next(&r) & 0xE0000000u) | lds_below(&r, 128);
+    } else {
+        ctx->gpr[0] = lds_gen_gpr(&r);
+        for (int i = 3; i <= 12; i++) ctx->gpr[i] = lds_gen_gpr(&r);
+        for (int i = 0; i <= 13; i++) ctx->fpr[i] = lds_gen_fpr(&r);
+        for (int i = 0; i <= 19; i++) lds_gen_vr(&r, &ctx->vr[i]);
+        /* volatile CR fields 0,1,5,6,7 (field i = bits (7-i)*4 .. +3) */
+        ctx->cr  = (ctx->cr & ~0xFF000FFFu) | ((uint32_t)lds_next(&r) & 0xFF000FFFu);
+        ctx->ctr = lds_below(&r, 64);
+        ctx->xer = (ctx->xer & ~(1u << 29)) | ((uint32_t)(lds_next(&r) & 1) << 29);
+    }
+}
diff --git a/tools/liftdiff/lds_driver.cpp b/tools/liftdiff/lds_driver.cpp
new file mode 100644
index 00000000..94d39707
--- /dev/null
+++ b/tools/liftdiff/lds_driver.cpp
@@ -0,0 +1,549 @@
+/* lds_driver.cpp -- liftdiff test executable (one per variant).
+ *
+ *   lds_<variant>.exe --elf EBOOT.elf --tests FILE [--pool FILE] [--opt K=V]...
+ *                     [--timeout-ms N] [--detail]
+ *
+ * FILE has one test per line: "<id> <addr hex> <toc hex> <seed>". Tests that
+ * share a seed share the seeded heap/stack image, so the runner sorts by seed.
+ * For each test the exe prints
+ *     BEGIN <id>
+ *     END <id> <status> <regs> <mem> <trace> <ntrace> <nchg> <ndemand>
+ * (hashes in hex). --detail additionally dumps the final registers, the first
+ * LDS_DETAIL_EVENTS trace events with their entry registers, and the changed
+ * memory pages ("D ..." lines) -- the runner uses it to explain a mismatch.
+ *
+ * Guest memory is a 4 GB reservation (MEM_WRITE_WATCH) at vm_base: the ELF's
+ * PT_LOAD segments, a seeded 16 MB heap and 1 MB stack are committed; any other
+ * access commits its 64 KB granule zero-filled from a vectored handler. After a
+ * test the pages that differ from the pristine image are hashed in address
+ * order and everything is put back (write-watch tells which pages to look at).
+ * A test that runs longer than --timeout-ms is cut off by a watchdog thread that
+ * rewinds the test thread to the start-of-test context (status HANG). */
+#include "lds_rt.h"
+#include <stdio.h>
+#include <stdlib.h>
+#define NOMINMAX
+#include <windows.h>
+#include <malloc.h>
+#include <xmmintrin.h>
+#include <vector>
+#include <string>
+#include <algorithm>
+
+extern uint32_t* g_pool;
+extern uint32_t  g_pool_n;
+
+static const char* g_status_names[] = { "OK", "HANG", "AV", "MEMLIMIT", "TRACELIMIT", "STKOVF", "EXC" };
+
+/* ---------------------------------------------------------------- regions */
+struct Region { uint64_t lo, hi; std::vector<uint8_t> pristine; const char* name; };
+static std::vector<Region> g_regions;            /* sorted by lo, page aligned, disjoint */
+struct Range { uint64_t lo, hi; };
+static std::vector<Range> g_bss;                 /* zero-fill tails of writable PT_LOADs */
+
+static bool in_region(uint64_t off)
+{
+    for (const Region& r : g_regions) if (off >= r.lo && off < r.hi) return true;
+    return false;
+}
+
+static void die(const char* fmt, const char* a = "")
+{
+    fprintf(stdout, "FATAL "); fprintf(stdout, fmt, a); fprintf(stdout, "\n"); fflush(stdout);
+    ExitProcess(3);
+}
+
+static void commit(uint64_t lo, uint64_t hi)
+{
+    if (!VirtualAlloc(vm_base + lo, (size_t)(hi - lo), MEM_COMMIT, PAGE_READWRITE))
+        die("commit failed");
+}
+
+static void add_region(uint64_t lo, uint64_t hi, const char* name)
+{
+    lo &= ~(uint64_t)(LDS_PAGE - 1);
+    hi = (hi + LDS_PAGE - 1) & ~(uint64_t)(LDS_PAGE - 1);
+    /* merge with an overlapping/adjacent region (segments can share a page) */
+    for (Region& r : g_regions)
+        if (lo <= r.hi && hi >= r.lo) {
+            uint64_t nlo = std::min(lo, r.lo), nhi = std::max(hi, r.hi);
+            commit(nlo, nhi);
+            r.lo = nlo; r.hi = nhi; return;
+        }
+    commit(lo, hi);
+    g_regions.push_back({ lo, hi, {}, name });
+    std::sort(g_regions.begin(), g_regions.end(), [](const Region& a, const Region& b) { return a.lo < b.lo; });
+}
+
+static void snapshot_region(Region& r)
+{
+    r.pristine.assign(vm_base + r.lo, vm_base + r.hi);
+}
+
+/* ---------------------------------------------------------------- ELF */
+static uint32_t be32(const uint8_t* p) { return __builtin_bswap32(*(const uint32_t*)p); }
+static uint64_t be64(const uint8_t* p) { return __builtin_bswap64(*(const uint64_t*)p); }
+static uint16_t be16(const uint8_t* p) { return __builtin_bswap16(*(const uint16_t*)p); }
+
+static void load_elf(const char* path)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) die("cannot open ELF %s", path);
+    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+    std::vector<uint8_t> d((size_t)n);
+    if (fread(d.data(), 1, (size_t)n, f) != (size_t)n) die("short read %s", path);
+    fclose(f);
+    if (n < 64 || memcmp(d.data(), "\x7f" "ELF", 4) || d[4] != 2 || d[5] != 2) die("not an ELF64 BE file: %s", path);
+    uint64_t phoff = be64(&d[0x20]);
+    uint16_t phentsize = be16(&d[0x36]), phnum = be16(&d[0x38]);
+    struct Seg { uint64_t va, off, fsz, msz; };
+    std::vector<Seg> segs;
+    for (int i = 0; i < phnum; i++) {
+        const uint8_t* p = &d[phoff + (uint64_t)i * phentsize];
+        if (be32(p) != 1) continue;                               /* PT_LOAD */
+        Seg s = { be64(p + 0x10), be64(p + 0x08), be64(p + 0x20), be64(p + 0x28) };
+        if (!s.msz) continue;
+        if ((be32(p + 4) & 2) && s.msz > s.fsz)                   /* PF_W with a .bss tail */
+            g_bss.push_back({ (s.va + s.fsz + 3) & ~3ull, (s.va + s.msz) & ~3ull });
+        if (s.va + s.msz > LDS_WINDOW) die("segment outside 4 GB");
+        add_region(s.va, s.va + s.msz, "elf");
+        segs.push_back(s);
+    }
+    for (const Seg& s : segs) {
+        memset(vm_base + s.va, 0, (size_t)s.msz);
+        memcpy(vm_base + s.va, &d[s.off], (size_t)s.fsz);
+    }
+}
+
+/* ---------------------------------------------------------------- demand commit */
+static volatile LONG g_in_veh = 0;
+static std::vector<uint64_t> g_demand;              /* committed granule offsets (this test) */
+static uint64_t g_demand_bytes = 0;
+static volatile int g_memlimit_hit = 0;
+
+static const uint8_t* demand_pattern(uint64_t g);
+
+static LONG CALLBACK veh(EXCEPTION_POINTERS* ep)
+{
+    if (ep->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION) return EXCEPTION_CONTINUE_SEARCH;
+    uintptr_t a = (uintptr_t)ep->ExceptionRecord->ExceptionInformation[1];
+    uintptr_t b = (uintptr_t)vm_base;
+    if (a < b || a >= b + LDS_WINDOW + LDS_WINDOW_GUARD) return EXCEPTION_CONTINUE_SEARCH;
+    g_in_veh = 1;
+    uint64_t g = (uint64_t)(a - b) & ~(uint64_t)(LDS_GRANULE - 1);
+    LONG ret = EXCEPTION_CONTINUE_SEARCH;
+    bool seen = false;
+    for (uint64_t x : g_demand) if (x == g) { seen = true; break; }
+    if (seen) {
+        /* already committed and still faulting: not ours */
+    } else if (g_demand_bytes + LDS_GRANULE > g_lds.mem_limit) {
+        g_memlimit_hit = 1;
+    } else if (VirtualAlloc(vm_base + g, LDS_GRANULE, MEM_COMMIT, PAGE_READWRITE)) {
+        if (g_lds.demand && g) {
+            const uint8_t* pat = demand_pattern(g);
+            for (uint64_t off = g; off < g + LDS_GRANULE; off += LDS_PAGE)
+                if (!in_region(off)) memcpy(vm_base + off, pat + (off - g), LDS_PAGE);
+        }
+        g_demand.push_back(g);          /* capacity reserved up front: no allocation here */
+        g_demand_bytes += LDS_GRANULE;
+        ret = EXCEPTION_CONTINUE_EXECUTION;
+    }
+    g_in_veh = 0;
+    return ret;
+}
+
+/* ---------------------------------------------------------------- seeded image */
+static void fill_buf(uint8_t* p, uint64_t n, LdsRng* r)
+{
+    for (uint64_t a = 0; a + 4 <= n; a += 4) {
+        uint32_t k = lds_below(r, 100), w;
+        if (k < 22) w = 0;
+        else if (k < 34) w = lds_below(r, 32);
+        else if (k < 38) w = (uint32_t)-(int32_t)(1 + lds_below(r, 8));
+        else if (k < 62) {
+            uint32_t span = (LDS_HEAP_HI - LDS_HEAP_LO) - 0x4000u;
+            w = LDS_HEAP_LO + lds_below(r, span);
+            w &= (lds_below(r, 4) == 0) ? ~15u : ~3u;
+        }
+        else if (k < 70) {
+            float f = (lds_below(r, 3) == 0) ? 1.0f : (float)((int32_t)lds_below(r, 3200) - 1600) / 16.0f;
+            memcpy(&w, &f, 4);
+        }
+        else if (k < 74) { w = lds_pool_pick(r); }
+        else if (k < 80) { w = 0x20202020u + (lds_below(r, 0x5F) | lds_below(r, 0x5F) << 8 |
+                                              lds_below(r, 0x5F) << 16 | lds_below(r, 0x5F) << 24); }
+        else w = (uint32_t)lds_next(r);
+        if (g_lds.nanfree) w = lds_nf32(w);
+        w = __builtin_bswap32(w);
+        memcpy(p + a, &w, 4);
+    }
+}
+static void fill_words(uint64_t lo, uint64_t hi, LdsRng* r) { fill_buf(vm_base + lo, hi - lo, r); }
+
+/* pristine content of demand granule g (DEMAND=pattern): a function of (seed, g) only */
+static uint32_t g_cur_seed = 0;
+static uint8_t g_gran_buf[LDS_GRANULE];
+static const uint8_t* demand_pattern(uint64_t g)
+{
+    if (!g_lds.demand || g == 0) { memset(g_gran_buf, 0, sizeof g_gran_buf); return g_gran_buf; }
+    LdsRng r = { lds_mix(0xD3A4D000ull ^ ((uint64_t)g_cur_seed << 40) ^ g) };
+    fill_buf(g_gran_buf, LDS_GRANULE, &r);
+    return g_gran_buf;
+}
+
+static Region* g_heap = nullptr;
+static Region* g_stack = nullptr;
+
+static void reset_write_watch_all()
+{
+    for (Region& r : g_regions) ResetWriteWatch(vm_base + r.lo, (SIZE_T)(r.hi - r.lo));
+}
+
+static void seed_image(uint32_t seed)
+{
+    g_cur_seed = seed;
+    LdsRng r = { lds_mix(0x4EA90000ull + seed) };
+    fill_words(LDS_HEAP_LO, LDS_HEAP_HI, &r);
+    fill_words(LDS_STACK_LO, LDS_STACK_HI, &r);
+    if (g_lds.bss) {
+        for (const Range& b : g_bss) fill_words(b.lo, b.hi, &r);
+        for (Region& rg : g_regions) snapshot_region(rg);
+    } else {
+        snapshot_region(*g_heap);
+        snapshot_region(*g_stack);
+    }
+    reset_write_watch_all();
+}
+
+/* ---------------------------------------------------------------- initial regs */
+static void init_ctx(ppu_context* c, uint32_t addr, uint32_t toc, uint32_t seed)
+{
+    memset(c, 0, sizeof *c);
+    LdsRng r = { lds_mix((uint64_t)seed * 0x9E3779B97F4A7C15ull) ^ lds_mix(addr + 0x51D0000ull) };
+    for (int i = 0; i < 32; i++) c->gpr[i] = lds_gen_gpr(&r);
+    c->gpr[1] = LDS_R1;
+    c->gpr[2] = toc;
+    c->gpr[13] = LDS_R13;
+    for (int i = 0; i < 32; i++) c->fpr[i] = lds_gen_fpr(&r);
+    for (int i = 0; i < 32; i++) lds_gen_vr(&r, &c->vr[i]);
+    c->cr = (uint32_t)lds_next(&r);
+    c->lr = LDS_LR_SENTINEL;
+    c->ctr = lds_below(&r, 64);
+    c->xer = ((uint32_t)lds_next(&r) & 0xE0000000u) | lds_below(&r, 128);
+    c->fpscr = (uint32_t)lds_next(&r) & 0xFFFFF0F8u;
+    c->vscr = (lds_next(&r) & 1) ? 0x00010000u : 0;
+    c->cia = addr;
+    c->thread_id = 1;
+}
+
+/* ---------------------------------------------------------------- running one test */
+static CONTEXT g_resume;
+static volatile LONG g_running = 0, g_timedout = 0;
+static volatile LONG64 g_seq = 0;
+static volatile ULONGLONG g_t0 = 0, g_cpu0 = 0;
+
+/* CPU time (user + kernel, 100 ns units) of a thread: the timeout is CPU time, so a
+ * loaded machine does not turn slow tests into one-sided HANGs */
+static ULONGLONG thread_cpu(HANDLE h)
+{
+    FILETIME c, e, k, u;
+    if (!GetThreadTimes(h, &c, &e, &k, &u)) return 0;
+    return (((ULONGLONG)k.dwHighDateTime << 32) | k.dwLowDateTime) +
+           (((ULONGLONG)u.dwHighDateTime << 32) | u.dwLowDateTime);
+}
+static int g_exc_status = LDS_OK;
+static DWORD g_exc_code = 0;
+static DWORD g_timeout_ms = 1000;
+static HANDLE g_main_thread;
+static uintptr_t g_img_lo, g_img_hi;
+
+static int exc_filter(EXCEPTION_POINTERS* ep)
+{
+    DWORD c = ep->ExceptionRecord->ExceptionCode;
+    g_exc_code = c;
+    if (c == LDS_EXC_TRACELIMIT) g_exc_status = LDS_TRACELIMIT;
+    else if (c == EXCEPTION_ACCESS_VIOLATION) g_exc_status = g_memlimit_hit ? LDS_MEMLIMIT : LDS_AV;
+    else if (c == EXCEPTION_STACK_OVERFLOW) g_exc_status = LDS_STKOVF;
+    else g_exc_status = LDS_EXC;
+    return EXCEPTION_EXECUTE_HANDLER;
+}
+
+static __declspec(noinline) int run_guarded(void (*fn)(ppu_context*), ppu_context* ctx)
+{
+    __try {
+        fn(ctx);
+        while (g_trampoline_fn) {                  /* exactly the runtime's drain */
+            void (*f)(void*) = g_trampoline_fn;
+            g_trampoline_fn = nullptr;
+            f((void*)ctx);
+        }
+    } __except (exc_filter(GetExceptionInformation())) {
+        if (g_exc_status == LDS_STKOVF && !_resetstkoflw()) {
+            printf("FATAL cannot reset stack guard\n"); fflush(stdout); ExitProcess(4);
+        }
+        return g_exc_status;
+    }
+    return LDS_OK;
+}
+
+static __declspec(noinline) int run_one(void (*fn)(ppu_context*), ppu_context* ctx)
+{
+    g_timedout = 0;
+    RtlCaptureContext(&g_resume);
+    /* the watchdog rewinds a hung test to right here */
+    if (g_timedout) {
+        g_timedout = 0;
+        g_trampoline_fn = nullptr;
+        g_in_veh = 0;
+        return LDS_HANG;
+    }
+    _mm_setcsr(0x1F80);                             /* default MXCSR for every test */
+    g_cpu0 = thread_cpu(GetCurrentThread());
+    g_t0 = GetTickCount64();
+    InterlockedIncrement64(&g_seq);
+    g_running = 1;
+    int st = run_guarded(fn, ctx);
+    g_running = 0;
+    return st;
+}
+
+static DWORD WINAPI watchdog(void*)
+{
+    for (;;) {
+        Sleep(10);
+        if (!g_running) continue;
+        /* CPU budget; wall clock only as a backstop (20x) for a thread that is not running */
+        if (thread_cpu(g_main_thread) - g_cpu0 < (ULONGLONG)g_timeout_ms * 10000ull &&
+            GetTickCount64() - g_t0 < (ULONGLONG)g_timeout_ms * 20ull) continue;
+        LONG64 seq = g_seq;
+        if (SuspendThread(g_main_thread) == (DWORD)-1) continue;
+        CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_CONTROL;
+        bool hijacked = false;
+        if (GetThreadContext(g_main_thread, &c) && g_running && g_seq == seq && !g_in_veh &&
+            c.Rip >= g_img_lo && c.Rip < g_img_hi) {
+            /* only while the thread is in our own image (lifted code / stubs): never
+             * inside ntdll (exception dispatch, loader, heap locks) */
+            CONTEXT r = g_resume;
+            r.ContextFlags = CONTEXT_FULL;
+            g_running = 0;
+            g_timedout = 1;
+            hijacked = SetThreadContext(g_main_thread, &r) != 0;
+            if (!hijacked) { g_timedout = 0; g_running = 1; }
+        }
+        ResumeThread(g_main_thread);
+        if (!hijacked) Sleep(1);
+    }
+}
+
+/* ---------------------------------------------------------------- digests */
+static std::vector<void*> g_ww;                    /* GetWriteWatch buffer */
+
+struct MemResult { uint64_t hash; uint32_t nchg; uint32_t ndemand; };
+
+static void dump_hex_page(uint64_t addr, const uint8_t* p)
+{
+    static const char* hx = "0123456789abcdef";
+    std::string s; s.reserve(LDS_PAGE * 2 + 32);
+    char head[48]; snprintf(head, sizeof head, "D PAGE %09llx ", (unsigned long long)addr);
+    s += head;
+    for (uint32_t i = 0; i < LDS_PAGE; i++) { s += hx[p[i] >> 4]; s += hx[p[i] & 15]; }
+    puts(s.c_str());
+}
+
+static const uint8_t* pristine_of(uint64_t off)
+{
+    for (const Region& r : g_regions)
+        if (off >= r.lo && off < r.hi) return r.pristine.data() + (off - r.lo);
+    return nullptr;
+}
+
+static MemResult mem_digest_and_restore(bool detail)
+{
+    std::vector<uint64_t> changed, dirty;
+    for (Region& r : g_regions) {
+        ULONG_PTR n = g_ww.size(); DWORD gran = 0;
+        if (GetWriteWatch(0, vm_base + r.lo, (SIZE_T)(r.hi - r.lo), g_ww.data(), &n, &gran) != 0)
+            die("GetWriteWatch failed");
+        if (n == g_ww.size()) die("write-watch buffer overflow");
+        for (ULONG_PTR i = 0; i < n; i++) {
+            uint64_t off = (uint64_t)((uint8_t*)g_ww[i] - vm_base) & ~(uint64_t)(LDS_PAGE - 1);
+            dirty.push_back(off);
+            if (memcmp(vm_base + off, r.pristine.data() + (off - r.lo), LDS_PAGE)) changed.push_back(off);
+        }
+    }
+    std::vector<uint64_t> dpages;
+    for (uint64_t g : g_demand) {
+        const uint8_t* pat = demand_pattern(g);
+        for (uint64_t off = g; off < g + LDS_GRANULE; off += LDS_PAGE) {
+            if (in_region(off)) continue;
+            dpages.push_back(off);
+            if (memcmp(vm_base + off, pat + (off - g), LDS_PAGE)) changed.push_back(off);
+        }
+    }
+    std::sort(changed.begin(), changed.end());
+    changed.erase(std::unique(changed.begin(), changed.end()), changed.end());
+    MemResult m = { 0x3E3E3E3Eull, (uint32_t)changed.size(), (uint32_t)g_demand.size() };
+    for (uint64_t off : changed) {
+        m.hash = lds_h(m.hash, off);
+        m.hash = lds_hash_bytes(m.hash, vm_base + off, LDS_PAGE);
+    }
+    if (detail) {
+        int shown = 0;
+        for (uint64_t off : changed) {
+            if (shown++ >= 64) { printf("D PAGES_TRUNCATED %u\n", m.nchg); break; }
+            const uint8_t* p = pristine_of(off);
+            dump_hex_page(off, vm_base + off);
+            (void)p;
+        }
+    }
+    /* restore */
+    for (uint64_t off : dirty) memcpy(vm_base + off, pristine_of(off), LDS_PAGE);
+    for (uint64_t off : dpages) VirtualFree(vm_base + off, LDS_PAGE, MEM_DECOMMIT);
+    g_demand.clear();
+    g_demand_bytes = 0;
+    g_memlimit_hit = 0;
+    reset_write_watch_all();
+    return m;
+}
+
+/* ---------------------------------------------------------------- detail dump */
+static void dump_regs(const char* tag, const ppu_context* c)
+{
+    for (int i = 0; i < 32; i++) printf("%s r%d %016llx\n", tag, i, (unsigned long long)c->gpr[i]);
+    for (int i = 0; i < 32; i++) { uint64_t b; memcpy(&b, &c->fpr[i], 8); printf("%s f%d %016llx\n", tag, i, (unsigned long long)b); }
+    for (int i = 0; i < 32; i++) {
+        printf("%s v%d ", tag, i);
+        for (int j = 0; j < 16; j++) printf("%02x", c->vr[i].b[j]);
+        printf("\n");
+    }
+    printf("%s cr %08x\n%s lr %016llx\n%s ctr %016llx\n%s xer %08x\n%s fpscr %08x\n%s vscr %08x\n",
+           tag, c->cr, tag, (unsigned long long)c->lr, tag, (unsigned long long)c->ctr, tag, c->xer,
+           tag, c->fpscr, tag, c->vscr);
+    printf("%s reserve_addr %016llx\n%s reserve_value %016llx\n%s reserve_valid %d\n",
+           tag, (unsigned long long)c->reserve_addr, tag, (unsigned long long)c->reserve_value,
+           tag, (int)c->reserve_valid);
+}
+
+/* ---------------------------------------------------------------- main */
+struct Test { uint64_t id; uint32_t addr, toc, seed; };
+
+static void (*find_test(uint32_t addr))(ppu_context*)
+{
+    uint32_t lo = 0, hi = lds_test_count;
+    while (lo < hi) { uint32_t m = (lo + hi) / 2; if (lds_test_fns[m].addr < addr) lo = m + 1; else hi = m; }
+    return (lo < lds_test_count && lds_test_fns[lo].addr == addr) ? lds_test_fns[lo].fn : nullptr;
+}
+
+int main(int argc, char** argv)
+{
+    const char* elf = nullptr; const char* tests = nullptr; const char* pool = nullptr;
+    bool detail = false;
+    for (int i = 1; i < argc; i++) {
+        std::string a = argv[i];
+        auto need = [&]() -> const char* { if (i + 1 >= argc) die("missing value for %s", argv[i]); return argv[++i]; };
+        if (a == "--elf") elf = need();
+        else if (a == "--tests") tests = need();
+        else if (a == "--pool") pool = need();
+        else if (a == "--timeout-ms") g_timeout_ms = (DWORD)atoi(need());
+        else if (a == "--detail") detail = true;
+        else if (a == "--opt") {
+            std::string kv = need(); size_t eq = kv.find('=');
+            if (eq == std::string::npos || !lds_configure(kv.substr(0, eq).c_str(), kv.substr(eq + 1).c_str()))
+                die("unknown option %s", kv.c_str());
+        }
+        else die("unknown argument %s", argv[i]);
+    }
+    if (!elf || !tests) die("usage: --elf EBOOT.elf --tests FILE [--pool FILE] [--opt K=V] [--timeout-ms N] [--detail]");
+    g_lds.detail = detail ? 1 : 0;
+    SetPriorityClass(GetCurrentProcess(), BELOW_NORMAL_PRIORITY_CLASS);
+    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+
+    /* a fixed base keeps runs reproducible should host addresses ever leak into guest state */
+    vm_base = (uint8_t*)VirtualAlloc((void*)0x0000100000000000ull, (SIZE_T)(LDS_WINDOW + LDS_WINDOW_GUARD),
+                                     MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    if (!vm_base)
+        vm_base = (uint8_t*)VirtualAlloc(nullptr, (SIZE_T)(LDS_WINDOW + LDS_WINDOW_GUARD),
+                                         MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    if (!vm_base) die("cannot reserve the 4 GB guest window");
+    g_demand.reserve((size_t)(g_lds.mem_limit / LDS_GRANULE) + 16);
+    g_ww.resize(1u << 20);
+    AddVectoredExceptionHandler(1, veh);
+
+    load_elf(elf);
+    add_region(LDS_HEAP_LO, LDS_HEAP_HI, "heap");
+    add_region(LDS_STACK_LO, LDS_STACK_HI, "stack");
+    for (Region& r : g_regions) {
+        if (r.lo == LDS_HEAP_LO) g_heap = &r;
+        if (r.lo == LDS_STACK_LO) g_stack = &r;
+    }
+    for (Region& r : g_regions) if (&r != g_heap && &r != g_stack) snapshot_region(r);
+
+    if (pool) {
+        FILE* f = fopen(pool, "r");
+        if (!f) die("cannot open pool %s", pool);
+        std::vector<uint32_t> v; unsigned x;
+        while (fscanf(f, "%x", &x) == 1) v.push_back(x);
+        fclose(f);
+        g_pool = (uint32_t*)malloc(v.size() * 4 + 4); g_pool_n = (uint32_t)v.size();
+        if (g_pool_n) memcpy(g_pool, v.data(), v.size() * 4);
+    }
+    lds_apply_config();
+
+    std::vector<Test> tv;
+    {
+        FILE* f = fopen(tests, "r");
+        if (!f) die("cannot open tests %s", tests);
+        unsigned long long id; unsigned a, t, s;
+        while (fscanf(f, "%llu %x %x %u", &id, &a, &t, &s) == 4) tv.push_back({ id, a, t, s });
+        fclose(f);
+    }
+
+    { HMODULE m = GetModuleHandleA(nullptr);
+      const uint8_t* b = (const uint8_t*)m;
+      const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(b + ((const IMAGE_DOS_HEADER*)b)->e_lfanew);
+      g_img_lo = (uintptr_t)b; g_img_hi = g_img_lo + nt->OptionalHeader.SizeOfImage; }
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &g_main_thread,
+                    0, FALSE, DUPLICATE_SAME_ACCESS);
+    CreateThread(nullptr, 64 * 1024, watchdog, nullptr, 0, nullptr);
+
+    lds_print_config();
+    fflush(stdout);
+    uint32_t cur_seed = 0xFFFFFFFFu;
+    static ppu_context ctx;                       /* static: 16-byte aligned, off the stack */
+    for (const Test& t : tv) {
+        void (*fn)(ppu_context*) = find_test(t.addr);
+        printf("BEGIN %llu\n", (unsigned long long)t.id);
+        fflush(stdout);
+        if (!fn) { printf("END %llu MISSING 0 0 0 0 0 0\n", (unsigned long long)t.id); fflush(stdout); continue; }
+        if (t.seed != cur_seed) { seed_image(t.seed); cur_seed = t.seed; }
+        init_ctx(&ctx, t.addr, t.toc, t.seed);
+        lds_trace_reset();
+        g_trampoline_fn = nullptr;
+        g_active_ctx = &ctx;
+        int st = run_one(fn, &ctx);
+        g_trampoline_fn = nullptr;
+        uint64_t rh = lds_hash_regs(&ctx, 1);
+        if (detail) {
+            dump_regs("D R", &ctx);
+            uint64_t n = g_trace.count < LDS_DETAIL_EVENTS ? g_trace.count : LDS_DETAIL_EVENTS;
+            for (uint64_t i = 0; i < n; i++) {
+                printf("D EV %llu %u %08x %016llx\n", (unsigned long long)i, g_detail_ev[i].kind,
+                       g_detail_ev[i].target, (unsigned long long)g_detail_ev[i].h);
+                char tag[32]; snprintf(tag, sizeof tag, "D ER %llu", (unsigned long long)i);
+                dump_regs(tag, &g_detail_regs[i]);
+            }
+        }
+        MemResult m = mem_digest_and_restore(detail);
+        char sts[32];
+        if (st == LDS_EXC) snprintf(sts, sizeof sts, "EXC:%08lX", (unsigned long)g_exc_code);
+        else snprintf(sts, sizeof sts, "%s", g_status_names[st]);
+        printf("END %llu %s %016llx %016llx %016llx %llu %u %u\n", (unsigned long long)t.id, sts,
+               (unsigned long long)rh, (unsigned long long)m.hash, (unsigned long long)g_trace.hash,
+               (unsigned long long)g_trace.count, m.nchg, m.ndemand);
+        fflush(stdout);
+    }
+    printf("DONE\n");
+    fflush(stdout);
+    ExitProcess(0);
+}
diff --git a/tools/liftdiff/lds_rt.h b/tools/liftdiff/lds_rt.h
new file mode 100644
index 00000000..b7fdfffb
--- /dev/null
+++ b/tools/liftdiff/lds_rt.h
@@ -0,0 +1,110 @@
+/* lds_rt.h -- liftdiff internal interface between lds_driver.cpp, harness_rt.cpp
+ * and the generated lds_gen.cpp of one variant.
+ *
+ * Every TU of a variant build includes THAT variant's ppu_recomp.h first, so
+ * ppu_context is whatever layout the variant uses (the fields named here must
+ * exist: gpr fpr vr cr lr ctr xer fpscr vscr reserve_addr/value/valid). */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include "ppu_recomp.h"
+
+/* ---------------- guest address map (fixed for every test) ---------------- */
+#define LDS_WINDOW        0x100000000ull       /* 4 GB guest window              */
+#define LDS_WINDOW_GUARD  0x10000ull           /* + 64 KB: lvx/dcbz past 4 GB    */
+#define LDS_HEAP_LO       0x30000000u          /* 16 MB seeded heap              */
+#define LDS_HEAP_HI       0x31000000u
+#define LDS_STACK_LO      0xD0000000u          /* 1 MB seeded stack              */
+#define LDS_STACK_HI      0xD0100000u
+#define LDS_R1            (LDS_STACK_HI - 0x1000u)
+#define LDS_R13           0x30F08000u          /* "TLS" pointer: inside the heap */
+#define LDS_LR_SENTINEL   0x00BEEF00u          /* initial lr (never a real fn)  */
+#define LDS_PAGE          4096u
+#define LDS_GRANULE       0x10000u             /* demand-commit granule          */
+
+/* ---------------- trace event kinds ---------------- */
+enum { LDS_EV_CALL = 1,     /* stubbed func_X / trampoline target / indirect call (target = guest addr) */
+       LDS_EV_HLE = 2,      /* ps3_hle_call(nid)                                   */
+       LDS_EV_SYSCALL = 3   /* lv2_syscall (target = r11)                          */ };
+
+/* ---------------- statuses ---------------- */
+enum { LDS_OK = 0, LDS_HANG, LDS_AV, LDS_MEMLIMIT, LDS_TRACELIMIT, LDS_STKOVF, LDS_EXC };
+
+/* custom exception codes raised by the harness */
+#define LDS_EXC_TRACELIMIT 0xE0D51001u
+#define LDS_EXC_MEMLIMIT   0xE0D51002u
+
+/* clobber modes */
+enum { LDS_CLOBBER_ABI = 0, LDS_CLOBBER_ALL = 1 };
+
+struct LdsConfig {
+    int      clobber;          /* LDS_CLOBBER_*                                    */
+    int      slowmem;          /* ppu_line_flags[] value for every line (SLOWMEM)   */
+    int      icall;            /* ICALL=1: fill ppu_icall_tab from the build's fns */
+    uint64_t trace_limit;      /* events per test before TRACELIMIT                */
+    uint64_t mem_limit;        /* demand-committed bytes per test before MEMLIMIT  */
+    int      detail;           /* record per-event register snapshots              */
+    int      bss;              /* BSS=1 (default): seed .bss like the heap         */
+    int      demand;           /* DEMAND=pattern (1, default) | zero (0)            */
+    int      nanfree;          /* NANFREE=1: no float32/64 NaN or Inf bit pattern in any seed */
+};
+/* NANFREE: a 32-bit word whose float32 exponent is all ones gets exponent bit 0 flipped,
+ * so no seeded word (and no aligned seeded double) reads as NaN/Inf. */
+static inline uint32_t lds_nf32(uint32_t w) { return ((w & 0x7F800000u) == 0x7F800000u) ? (w ^ 0x00800000u) : w; }
+static inline uint64_t lds_nf64(uint64_t q) { return ((uint64_t)lds_nf32((uint32_t)(q >> 32)) << 32) | lds_nf32((uint32_t)q); }
+extern LdsConfig g_lds;
+
+/* one function symbol known to this build (generated by liftdiff.py) */
+struct LdsFn { uint32_t addr; void (*fn)(ppu_context*); };
+extern "C" const LdsFn lds_test_fns[];      /* functions under test (wrappers)      */
+extern "C" const uint32_t lds_test_count;
+extern "C" const LdsFn lds_real_fns[];      /* closure fns linked for real (sorted) */
+extern "C" const uint32_t lds_real_count;
+extern "C" const LdsFn lds_all_fns[];       /* every func_X symbol defined (sorted) */
+extern "C" const uint32_t lds_all_count;
+
+/* ---------------- hashing ---------------- */
+static inline uint64_t lds_mix(uint64_t x) {           /* splitmix64 finalizer */
+    x ^= x >> 30; x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27; x *= 0x94D049BB133111EBull;
+    x ^= x >> 31; return x;
+}
+static inline uint64_t lds_h(uint64_t h, uint64_t v) {   /* order-sensitive combine */
+    return lds_mix(h ^ (v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2)));
+}
+uint64_t lds_hash_bytes(uint64_t h, const void* p, size_t n);
+uint64_t lds_hash_regs(const ppu_context* c, int with_reserve);
+
+struct LdsRng { uint64_t s; };
+static inline uint64_t lds_next(LdsRng* r) {
+    r->s += 0x9E3779B97F4A7C15ull; return lds_mix(r->s);
+}
+static inline uint32_t lds_below(LdsRng* r, uint32_t n) { return (uint32_t)(((lds_next(r) >> 32) * n) >> 32); }
+
+/* value generators (shared by the initial state and the stub clobber) */
+uint64_t lds_gen_gpr(LdsRng* r);
+double   lds_gen_fpr(LdsRng* r);
+void     lds_gen_vr(LdsRng* r, ppu_vr* v);
+uint32_t lds_pool_pick(LdsRng* r);           /* code / OPD address from the pool, 0 if none */
+
+/* ---------------- per-test trace state (harness_rt.cpp) ---------------- */
+struct LdsEvent { uint32_t kind, target; uint64_t h; };
+struct LdsTrace {
+    uint64_t hash, count, timebase;
+};
+extern LdsTrace g_trace;
+void lds_trace_reset(void);
+void lds_record_and_clobber(ppu_context* ctx, uint32_t kind, uint32_t target);
+/* detail mode: the first LDS_DETAIL_EVENTS events with a full register copy */
+#define LDS_DETAIL_EVENTS 64
+extern LdsEvent    g_detail_ev[LDS_DETAIL_EVENTS];
+extern ppu_context g_detail_regs[LDS_DETAIL_EVENTS];
+
+/* options KEY=VALUE -> harness_rt; returns 0 for an unknown key */
+int  lds_configure(const char* key, const char* val);
+void lds_apply_config(void);                 /* after vm is up: fill the B tables */
+void lds_print_config(void);
+
+extern "C" uint8_t* vm_base;
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+extern "C" PPU_THREAD_LOCAL ppu_context* g_active_ctx;
