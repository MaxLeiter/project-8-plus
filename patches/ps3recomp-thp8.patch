+def _sum4(kind):
+    def sem(s, f):
+        a = s.vr[f.ra]
+        b = [s32(x) if kind != "ubs" else x for x in W(s.vr[f.rb])]
+        out, anys = [], False
+        for j in range(4):
+            if kind == "ubs":
+                t = sum(a[4 * j:4 * j + 4]) + b[j]
+                v, st = sat(t, 0, MASK32)
+            elif kind == "sbs":
+                t = sum(sext(x, 8) for x in a[4 * j:4 * j + 4]) + b[j]
+                v, st = sat(t, -(1 << 31), (1 << 31) - 1)
+            else:  # shs
+                hs = H(a)
+                t = sext(hs[2 * j], 16) + sext(hs[2 * j + 1], 16) + b[j]
+                v, st = sat(t, -(1 << 31), (1 << 31) - 1)
+            anys |= st
+            out.append(v)
+        s.set_v(f.rt, fromW(out))
+        _sat_note(s, anys)
+    return sem
+
+
+vx("vsum4ubs", 1544, _sum4("ubs"))
+vx("vsum4sbs", 1800, _sum4("sbs"))
+vx("vsum4shs", 1608, _sum4("shs"))
+
