+/* Texture cache cap + eviction bookkeeping (texture_srv_slot).
+ * PS3_TEX_CACHE_CAP=<n> (alias PS3_TEX_CACHE_MAX) lowers the cap: 64..MAX_TEXTURES, default MAX_TEXTURES.
+ * Entries bound in the last LD_TEX_INFLIGHT_FRAMES frames (the frame being built and the one the GPU may
+ * still run: two frame sets) are not evicted while an older one exists. Every eviction is logged for the
+ * first 32 and then at powers of two ("[texture-cache] evict #n slot .. src .. idle N frames"), with a summary
+ * every 1024; a key that comes back within LD_TEX_RELOAD_WINDOW frames of its eviction counts as a reload
+ * (cache thrash: the cap is too small for the working set). */
+#define LD_TEX_INFLIGHT_FRAMES 2u
+#define LD_TEX_RELOAD_WINDOW   600u
+#define LD_TEX_EVRING          1024u
+static struct {
+    u64 forced, reloads, notes;
+    u32 ring_key[LD_TEX_EVRING];        /* key hash | 1 (0 = empty) */
+    u32 ring_frame[LD_TEX_EVRING];
+} g_ld_tex_evict;
+
+static u32 ld_tex_cache_cap(void)
+{
+    static u32 cap = 0;
+    if (!cap) {
+        const char* e = getenv("PS3_TEX_CACHE_CAP");
+        if (!e) e = getenv("PS3_TEX_CACHE_MAX");
+        cap = e ? (u32)strtoul(e, NULL, 0) : MAX_TEXTURES;
+        if (cap < 64) cap = 64;
+        if (cap > MAX_TEXTURES) cap = MAX_TEXTURES;
+        fprintf(stderr, "[texture-cache] cap %u entries (LRU by last bind; the last %u frames are kept)\n",
+                cap, LD_TEX_INFLIGHT_FRAMES);
+    }
+    return cap;
+}
+
+static u32 ld_tex_key_hash(u32 loc, u32 off, u32 fmt, u32 w, u32 h, u32 pitch, u32 remap, u32 cube)
+{
+    u64 k = ((u64)off << 32) ^ ((u64)loc << 30) ^ ((u64)fmt << 22) ^ ((u64)w << 11) ^ h;
+    k ^= (u64)pitch * 0x9E3779B97F4A7C15ull ^ (u64)remap << 41 ^ (u64)cube << 62;
+    k ^= k >> 33; k *= 0xff51afd7ed558ccdull; k ^= k >> 29;
+    return (u32)k | 1u;
+}
+
+/* slot <index> is about to take a new key: log the entry it loses, remember its key */
+static void ld_tex_evict_note(u32 index, const rsx_dsp_texture* incoming)
+{
+    const texcache_t* e = &g.textures[index];
+    const u64 n = g_ld_texture_cache_evictions;
+    const u32 idle = g_ld_frames - e->last_use_frame;
+    const u32 key = ld_tex_key_hash(e->location, e->offset, e->format, e->width, e->height, e->pitch,
+                                    e->remap, e->cubemap);
+    const u32 r = (key >> 1) & (LD_TEX_EVRING - 1u);
+    g_ld_tex_evict.ring_key[r] = key;
+    g_ld_tex_evict.ring_frame[r] = g_ld_frames;
+    if (n <= 32 || (n & (n - 1)) == 0)
+        fprintf(stderr, "[texture-cache] evict #%llu frame %u slot %u src=%u:0x%08X fmt=0x%02X %ux%u idle %u frames%s%s"
+                        " -> %u:0x%08X %ux%u\n",
+                (unsigned long long)n, g_ld_frames, index, e->location, e->offset, e->format, e->width, e->height,
+                idle, e->repl ? " (had an HD replacement)" : "",
+                idle < LD_TEX_INFLIGHT_FRAMES ? " FORCED (all entries in flight)" : "",
+                incoming->location, incoming->offset, incoming->width, incoming->height);
+    if ((n & 1023u) == 0)
+        fprintf(stderr, "[texture-cache] evictions=%llu forced=%llu reloads=%llu (key back within %u frames) cap=%u\n",
+                (unsigned long long)n, (unsigned long long)g_ld_tex_evict.forced,
+                (unsigned long long)g_ld_tex_evict.reloads, LD_TEX_RELOAD_WINDOW, ld_tex_cache_cap());
+}
+
+/* a new entry was created for this key: was it evicted a moment ago? */
+static void ld_tex_created(const texcache_t* e)
+{
+    if (!g_ld_texture_cache_evictions) return;
+    const u32 key = ld_tex_key_hash(e->location, e->offset, e->format, e->width, e->height, e->pitch,
+                                    e->remap, e->cubemap);
+    const u32 r = (key >> 1) & (LD_TEX_EVRING - 1u);
+    if (g_ld_tex_evict.ring_key[r] != key) return;
+    g_ld_tex_evict.ring_key[r] = 0;
+    if (g_ld_frames - g_ld_tex_evict.ring_frame[r] > LD_TEX_RELOAD_WINDOW) return;
+    g_ld_tex_evict.reloads++;
+    if (g_ld_tex_evict.reloads <= 16 || (g_ld_tex_evict.reloads & (g_ld_tex_evict.reloads - 1)) == 0)
+        fprintf(stderr, "[texture-cache] reload #%llu src=%u:0x%08X %ux%u %u frames after its eviction\n",
+                (unsigned long long)g_ld_tex_evict.reloads, e->location, e->offset, e->width, e->height,
+                g_ld_frames - g_ld_tex_evict.ring_frame[r]);
+}
