     if FAILS:
         print(f"FAILED: {', '.join(FAILS)}")
         return 1
@@ -290,5 +291,32 @@ def test_const_base_needs_constant():
     check("non-constant base is not a constant-base jump", got, None)
 
 
+def test_spilled_base_reloaded_from_stack():
+    """The table base is spilled to the stack and reloaded at the dispatch,
+    and the reloaded register is overwritten by the offset `add` itself.
+
+        lwz  r5, 16(r2)          <- table base from the TOC
+        std  r5, -0xD0(r1)       <- parked in a stack slot (register pressure)
+        cmplwi cr7, r8, 2
+        ld   r7, -0xD0(r1)       <- reloaded
+        slwi r9, r8, 2
+        lwzx r0, r9, r7
+        add  r7, r0, r7          <- base reg redefined AFTER the table load
+        mtctr r7 ; bctr
+
+    THP8 func_00C08EB0 (a 25-case command interpreter): the base scan stopped
+    at the `add` (nearest def of r7 before the bctr, not before the lwzx) and
+    could not follow a stack reload, so the dispatcher was dropped and every
+    case lifted to an unresolved indirect call.
+    """
+    table = 0x11000
+    mem = {TOC + 16: table,
+           table + 0: 0x100, table + 4: 0x200, table + 8: 0xFFFFFFFF}
+    got = discover([w_lwz(5, 2, 16), w_std(5, 1, -0xD0), w_cmplwi(7, 8, 2),
+                    w_ld(7, 1, -0xD0), w_slwi(9, 8, 2), w_lwzx(0, 9, 7),
+                    w_add(7, 0, 7), w_mtctr(7), w_bctr()], mem)
+    check("spilled table base reloaded from the stack", got, [0x11100, 0x11200])
+
+
 if __name__ == "__main__":
     sys.exit(main())
diff --git a/tools/test_ppucheck.py b/tools/test_ppucheck.py
new file mode 100644
index 00000000..fb29e596
--- /dev/null
+++ b/tools/test_ppucheck.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Regression gate: the ppucheck differential harness over every reference
+instruction (fixed seed), expecting zero mismatches.
+
+tools/ppucheck/ppucheck.py lifts random + edge-case encodings of each PPU
+instruction with the real PPULifter, compiles the emissions with the game's
+flags (clang-cl -O2 -msse4.1 -ffp-contract=off) and diffs the full resulting
+architectural state against an independent PowerISA / AltiVec / Cell model
+(tools/ppucheck/ref_*.py). Run it after any change to ppu_lifter.py's
+instruction handlers or C preamble helpers.
+
+Usage:
+    py -3 tools\\test_ppucheck.py               # ~1 min, needs clang-cl + MSVC headers
+    py -3 tools\\test_ppucheck.py --deep        # more encodings / states / a 2nd seed
+    py -3 tools\\test_ppucheck.py -- --tags fp  # extra args go to ppucheck.py
+
+Optional: PPUCHECK_CENSUS=<census.json> (tools/ppucheck/census.py output for
+a title, with --samples) adds the title's own encodings and weights the report
+by how often each instruction occurs. PPUCHECK_ALLOW=<file> lists spec names
+whose mismatches are accepted (one per line, # comments). The work directory
+(scratch/ppucheck) is reused for incremental rebuilds.
+"""
+import os
+import subprocess
+import sys
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+
+
+def main() -> int:
+    argv = sys.argv[1:]
+    extra = []
+    if "--" in argv:
+        i = argv.index("--")
+        argv, extra = argv[:i], argv[i + 1:]
+    deep = "--deep" in argv
+    runs = [("1", 8, 30)] + ([("7", 16, 80)] if deep else [])
+    rc = 0
+    for seed, words, states in runs:
+        work = os.path.join(ROOT, "scratch", "ppucheck" + ("" if seed == "1" else f"_s{seed}"))
+        cmd = [sys.executable, os.path.join(TOOLS, "ppucheck", "ppucheck.py"),
+               "--seed", seed, "--words", str(words), "--states", str(states),
+               "--work", work, "--jobs", os.environ.get("PPUCHECK_JOBS", "4")]
+        if os.environ.get("PPUCHECK_CENSUS"):
+            cmd += ["--census", os.environ["PPUCHECK_CENSUS"]]
+        if os.environ.get("PPUCHECK_ALLOW"):
+            cmd += ["--allow", os.environ["PPUCHECK_ALLOW"]]
+        cmd += extra
+        print("[test_ppucheck]", " ".join(cmd), flush=True)
+        r = subprocess.run(cmd)
+        if r.returncode:
+            print(f"[test_ppucheck] FAILED (seed {seed}, exit {r.returncode})")
+            rc = r.returncode
+    if rc == 0:
+        print("[test_ppucheck] ok: lifter matches the reference model on every case")
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/xprof/README.txt b/tools/xprof/README.txt
new file mode 100644
index 00000000..e62ec5a8
--- /dev/null
+++ b/tools/xprof/README.txt
@@ -0,0 +1,122 @@
+xprof -- external sampling profiler for the THP8 native port (any x64 process)
+==========================================================================
+
+Files
+  xprof.c            sampler (attaches to a running process; writes a text sample file)
+  xprof_report.py    analyser (Python 3.13, stdlib only): symbolises with the exe's /MAP,
+                     categorises, prints tables, --json for diffs
+  xprof_diff.py      compare two --json dumps (category %, threads, top functions)
+  test/spin.c        dummy multi-threaded target used to validate the tool (see its header)
+
+Build (Git bash, from this directory)
+  ../../../../tools/vsbuild.sh clang-cl -O2 -W3 xprof.c -Fe:xprof.exe
+  (psapi/winmm/advapi32 come in via #pragma comment(lib))
+  test target:
+  cd test && ../../../../../tools/vsbuild.sh clang-cl -O2 -Zi -MD spin.c -Fe:spin.exe \
+             -link -MAP:spin.map -DEBUG -INCREMENTAL:NO
+
+Usage
+  xprof.exe (--pid N | --name thp8.exe) --seconds S --out FILE
+            [--interval-ms 1] [--stack-bytes 4096] [--max-ra 12]
+            [--min-us 20] [--wait S] [--delay S]
+    --wait S    wait up to S s for --name to appear      --delay S   attach, then idle S s
+    --min-us    sample a thread only if it used >= this much CPU since its last sample
+  python xprof_report.py FILE --map ..\..\..\..\build\thp8.map [--log GAMELOG] [--top 40]
+                         [--thread TID] [--json OUT] [--exe EXE] [--no-verify] [--busy 8]
+  python xprof_report.py --map thp8.map --symcats [NAME ...]   # categorise the map only
+  python xprof_diff.py before.json after.json [--top 30]
+
+  Example (game already running, profile 60 s):
+    xprof.exe --name thp8.exe --seconds 60 --out run1.xprof
+    python xprof_report.py run1.xprof --map <project>\build\thp8.map ^
+           --log thp8.log --json run1.json > run1.txt
+  The map AND the exe on disk must be the build that was profiled (PE timestamps are
+  checked; on mismatch symbols are wrong / stack verification is switched off). If a
+  rebuild may happen before you analyse, copy thp8.exe + thp8.map next to the samples
+  and pass --exe/--map.
+
+How it samples
+  Rounds of Sleep(interval) at 1 ms timer resolution (sampler thread at HIGHEST priority).
+  Thread list refreshed every 250 ms with NtGetNextThread (toolhelp fallback; a system-
+  wide CreateToolhelp32Snapshot took ~50 ms per call here and stalled sampling). Thread
+  handles stay open, so exited threads still report their final CPU.
+  Per round, per thread: QueryThreadCycleTime; if the thread used < --min-us of CPU since
+  its last sample it is NOT suspended (idle round). Otherwise SuspendThread ->
+  GetThreadContext -> ReadProcessMemory(RSP, stack-bytes, clamped to the TEB StackBase)
+  -> ResumeThread; after resuming, the copied stack is scanned for words pointing into
+  the exe's executable sections (first --max-ra of them, stack order).
+  Why cycles and not GetThreadTimes: thread times only advance in 15.625 ms clock-tick
+  quanta (measured: 60 of 552 1-ms polls of a 100%-busy thread saw a change; the cycle
+  count changed on all 552). The cycle delta is also the sample's weight (= CPU the
+  thread burnt since its previous sample), so percentages are of CPU, not of samples.
+  The --min-us floor exists because suspending a thread charges it a few us (the suspend
+  APC runs on it); without it a thread that just went idle would be re-sampled forever
+  (verified: a thread that works 30 ms then blocks gets ~20 samples and then none).
+
+Overhead (measured on test/spin.exe, 3 busy threads, 1 ms interval)
+  ~1.6 ms per round, target thread suspended ~28 us per sample (avg; rare outliers of a
+  few ms when the sampler is descheduled), QueryThreadCycleTime ~1.8 us per thread per
+  round, sampler busy ~7% of one core. For ~20 busy game threads expect ~2.5 ms rounds,
+  each busy thread stopped ~1% of the time, the sampler using ~30% of a core, and
+  ~70 MB of samples per minute (xprof_report.py: ~11 s for 600k samples).
+  Use --interval-ms 2..5 to perturb less.
+
+Output format (one record per line, hex without 0x)
+  XPROF 1
+  P <pid> <exe-name>
+  OPT interval_ms=.. stack_bytes=.. max_ra=.. min_us=.. seconds=..
+  M <base> <size> <module-name> <path>           (module list; again at the end)
+  E <exe-base> <size> <pe-timestamp> <path>
+  X <section> <rva> <size>                       (executable sections of the exe)
+  TEXT <lo-rva> <hi-rva>
+  START ft=<filetime>
+  T0 <tid> <late> <create-ft> <user100ns> <kernel100ns> <cycles> <start-va> <description>
+       (first sight; late=1: created during the run, so its CPU base is 0)
+  S <tid> <rip-va> <cycles-since-last-sample> <ra-rva> <ra-rva> ...   (ra = exe RVAs)
+  T1 <tid> <alive> <user100ns> <kernel100ns> <cycles> <samples> <idle-rounds> <fails> <start-va> <description>
+  W wall_s=.. rounds=.. tsc_hz=.. samples=.. threads=.. susp_avg_us=.. susp_max_us=..
+    sampler_busy_pct=.. refresh_ms_total=.. query_us_avg=.. proc_exited=..
+  END
+
+Report
+  categories   CPU-weighted shares (cpu%) and raw sample shares (samp%). Rules are the
+               RULES table at the top of xprof_report.py (first match wins; fields:
+               exe symbol / map object / module / module!export):
+               ppu_lifted mem_helper icall trampoline hle_syscall spu_lifted spu_runtime
+               rsx crt gpu_driver os_wait (ntdll/win32u Nt*Wait*, NtDelayExecution, ...
+               syscall stubs) os_other (rest of ntdll/kernelbase/kernel32/user32...)
+               other_exe other_dll unknown
+  threads      CPU in cores from GetThreadTimes deltas (start->end, exited threads incl.);
+               names = GetThreadDescription, else the game log ([THREAD n] ... hosttid=
+               + sys_ppu_thread_create name=, MAIN guest thread tid=, [hosttid] N name);
+               start = Win32 start address symbol
+  top symbols  self CPU; DLL RIPs are named from the DLL's export table/.pdata on disk:
+               module!Export, or module!sub_<rva> for unexported functions (e.g. the AVX
+               memcpy body in VCRUNTIME140 shows as sub_1CB40)
+  lifted       self% and incl~% (func is the RIP or any verified return address)
+  attribution  every non-func_ sample (vm_read32, ps3_indirect_call, lv2/HLE, ntdll
+               waits, memcpy, ...) is charged to the first lifted func_ among its stack
+               return addresses; table = self + charged callees per category, plus what
+               could not be attributed (no lifted caller on the stack)
+  busy threads top symbols of the N busiest threads (--busy)
+  json         same data (top lists up to 200 entries) for xprof_diff.py
+
+Caveats
+  - Statistical: ~1 sample per busy thread per round (1.5-3 ms). Short phases need long
+    runs; a 60 s run gives ~20-40k samples per busy thread.
+  - Weighting by "cycles since last sample" charges the previous interval's CPU to where
+    the thread is NOW. For steady threads that is unbiased; for bursty threads that work
+    and then block, CPU lands on the wait (os_wait) instead of the work (test: a thread
+    doing 250 us of work + Sleep(1) shows ~16% os_wait). Compare samp% with cpu%.
+  - Stack scan is heuristic: any stale stack word that points just after a call
+    instruction in the exe looks like a return address. Only candidates preceded by a
+    call (checked against the exe file; same build required) are used. Guest-caller
+    attribution and incl~% can still be wrong when a stale frame of an earlier call sits
+    higher on the stack, and tail calls (jmp) leave no return address.
+  - Only the first --stack-bytes (4 KB) and --max-ra (12) candidates are kept: deep
+    host frames between a helper and its lifted caller can hide the caller (raise them).
+  - Suspending threads perturbs the target slightly (see Overhead). Never kill xprof
+    with taskkill /F mid-run: a thread could be left suspended (Ctrl+C is handled).
+  - DLL symbols come from exports/.pdata only (no PDBs): internal ntdll/driver functions
+    show as sub_<rva>; leaf code without .pdata gets the nearest export within 0x200.
+  - xprof needs a 64-bit target and the same user (no elevation needed for own processes).
diff --git a/tools/xprof/test/spin.c b/tools/xprof/test/spin.c
new file mode 100644
index 00000000..6503f98f
--- /dev/null
+++ b/tools/xprof/test/spin.c
@@ -0,0 +1,136 @@
+/*
+ * spin.c -- dummy target for xprof (tools/xprof/test).
+ *
+ *   spin.exe [seconds=8]
+ *
+ * Threads (each named with SetThreadDescription):
+ *   hot      ~1 core: func_00010000 (a fake "lifted" function) calling
+ *            vm_read32 (a fake memory helper) ~85%, plus func_00020000 self ALU work
+ *   copier   ~1 core: memcpy of 4 MB buffers (VCRUNTIME140!memcpy with /MD)
+ *   bursty   ~0.25 core: 250 us of burst_work then Sleep(1) -> os_wait samples
+ *   blocked  0 core: WaitForSingleObject on a never-signalled event
+ *   oneshot  30 ms of burst_work at t=1.5 s, then blocked
+ *
+ * Build (bash, from tools/xprof/test):
+ *   ../../../../../tools/vsbuild.sh clang-cl -O2 -Zi -MD spin.c -Fe:spin.exe -link -MAP:spin.map -DEBUG -INCREMENTAL:NO
+ * Self-test (from tools/xprof):
+ *   ./test/spin.exe 8 & ./xprof.exe --name spin.exe --wait 5 --seconds 5 --out spin.xprof; wait
+ *   python xprof_report.py spin.xprof --map test/spin.map
+ * Expect: hot ~1 core (vm_read32 ~96%, charged to func_00010000), copier ~1 core
+ * (VCRUNTIME140 memcpy internals, crt), bursty ~0.15, blocked 0 samples, oneshot ~20 samples.
+ */
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <mmsystem.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#pragma comment(lib, "winmm.lib")
+
+static volatile uint32_t g_mem[1 << 16];
+static volatile LONG g_stop;
+static volatile uint64_t g_sink;
+
+/* fake memory helper: a few dependent loads, never inlined */
+__declspec(noinline) uint32_t vm_read32(uint32_t ea) {
+    uint32_t v = ea;
+    for (int i = 0; i < 24; i++) v = g_mem[(v ^ (uint32_t)i) & 0xFFFF] + v * 2654435761u;
+    return v;
+}
+
+/* fake lifted leaf: pure ALU self time */
+__declspec(noinline) uint32_t func_00020000(uint32_t x) {
+    for (int i = 0; i < 40; i++) x = (x ^ (x >> 7)) * 0x9E3779B1u + (uint32_t)i;
+    return x;
+}
+
+/* fake lifted function: mostly calls the helper, some leaf work */
+__declspec(noinline) uint32_t func_00010000(uint32_t x) {
+    for (int i = 0; i < 8; i++) x += vm_read32(x + (uint32_t)i * 4);
+    x ^= func_00020000(x);
+    return x;
+}
+
+static DWORD WINAPI hot_thread(void *arg) {
+    (void)arg;
+    uint32_t x = 1;
+    while (!g_stop) x = func_00010000(x);
+    g_sink += x;
+    return 0;
+}
+
+__declspec(noinline) void copy_worker(uint8_t *dst, const uint8_t *src, size_t n) {
+    memcpy(dst, src, n);
+    dst[n / 2] ^= 1;
+}
+
+static DWORD WINAPI copier_thread(void *arg) {
+    (void)arg;
+    size_t n = 4u << 20;
+    uint8_t *a = (uint8_t *)malloc(n), *b = (uint8_t *)malloc(n);
+    memset(a, 1, n); memset(b, 2, n);
+    while (!g_stop) { copy_worker(a, b, n); copy_worker(b, a, n); }
+    g_sink += a[7] + b[9];
+    free(a); free(b);
+    return 0;
+}
+
+__declspec(noinline) void burst_work(double us, LARGE_INTEGER f) {
+    LARGE_INTEGER t0, t; QueryPerformanceCounter(&t0);
+    uint32_t x = 7;
+    do {
+        for (int i = 0; i < 64; i++) x = x * 1664525u + 1013904223u;
+        QueryPerformanceCounter(&t);
+    } while ((double)(t.QuadPart - t0.QuadPart) * 1e6 / (double)f.QuadPart < us);
+    g_sink += x;
+}
+
+static DWORD WINAPI bursty_thread(void *arg) {
+    (void)arg;
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f);
+    while (!g_stop) { burst_work(250.0, f); Sleep(1); }
+    return 0;
+}
+
+static DWORD WINAPI blocked_thread(void *arg) {
+    WaitForSingleObject((HANDLE)arg, INFINITE);
+    return 0;
+}
+
+/* idle 1.5 s, 30 ms of work, then blocked for good: after the burst xprof must
+   stop sampling it (the suspend APC's own CPU cost must not re-trigger samples) */
+static DWORD WINAPI oneshot_thread(void *arg) {
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f);
+    WaitForSingleObject((HANDLE)arg, 1500);
+    if (!g_stop) burst_work(30000.0, f);
+    WaitForSingleObject((HANDLE)arg, INFINITE);
+    return 0;
+}
+
+static HANDLE start(LPTHREAD_START_ROUTINE fn, void *arg, const wchar_t *name) {
+    HANDLE h = CreateThread(NULL, 0, fn, arg, 0, NULL);
+    SetThreadDescription(h, name);
+    return h;
+}
+
+int main(int argc, char **argv) {
+    double secs = argc > 1 ? atof(argv[1]) : 8.0;
+    if (secs > 10) secs = 10;   /* shared machine: never burn longer than this */
+    timeBeginPeriod(1);
+    HANDLE ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+    HANDLE h[5];
+    h[0] = start(hot_thread, NULL, L"hot");
+    h[1] = start(copier_thread, NULL, L"copier");
+    h[2] = start(bursty_thread, NULL, L"bursty");
+    h[3] = start(blocked_thread, ev, L"blocked");
+    h[4] = start(oneshot_thread, ev, L"oneshot");
+    printf("spin pid %lu running %.1f s\n", GetCurrentProcessId(), secs);
+    fflush(stdout);
+    Sleep((DWORD)(secs * 1000));
+    InterlockedExchange(&g_stop, 1);
+    SetEvent(ev);
+    WaitForMultipleObjects(5, h, TRUE, 5000);
+    timeEndPeriod(1);
+    return 0;
+}
diff --git a/tools/xprof/xprof.c b/tools/xprof/xprof.c
new file mode 100644
index 00000000..f9a0ef06
--- /dev/null
+++ b/tools/xprof/xprof.c
@@ -0,0 +1,499 @@
+/*
+ * xprof.c -- tiny external sampling profiler for x64 Windows processes
+ *            (written for the THP8 ps3recomp native port; works on anything).
+ *
+ *   xprof.exe (--pid N | --name thp8.exe) --seconds S --out FILE
+ *             [--interval-ms 1] [--stack-bytes 4096] [--max-ra 12]
+ *             [--min-us 20] [--wait S] [--delay S]
+ *
+ * Every round (Sleep(interval) at 1 ms timer resolution) each thread of the
+ * target whose CPU cycle count advanced by >= --min-us since its last sample is
+ * suspended, its RIP/RSP read, up to --stack-bytes of stack copied, and resumed;
+ * then the copied stack is filtered for words pointing into the main exe's
+ * executable sections (candidate return addresses). Idle threads are never
+ * suspended. Output is a line-oriented text file analysed by xprof_report.py
+ * (format: see README.txt).
+ *
+ * Thread list: refreshed every 250 ms with NtGetNextThread (only the target's
+ * threads; a system-wide CreateToolhelp32Snapshot measured ~50 ms per call here,
+ * stalling sampling), toolhelp as fallback. Handles stay open between rounds.
+ * Idle test uses QueryThreadCycleTime, not GetThreadTimes: thread times only
+ * advance in 15.625 ms clock-tick quanta (measured: 60 of 552 1-ms polls of a
+ * 100%-busy thread saw a change), the cycle count changes on every poll.
+ *
+ * Build (bash):  tools/vsbuild.sh clang-cl -O2 -W3 xprof.c -Fe:xprof.exe
+ */
+#define WIN32_LEAN_AND_MEAN
+#define _CRT_SECURE_NO_WARNINGS
+#include <windows.h>
+#include <tlhelp32.h>
+#include <psapi.h>
+#include <mmsystem.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <intrin.h>
+
+#pragma comment(lib, "psapi.lib")
+#pragma comment(lib, "winmm.lib")
+#pragma comment(lib, "advapi32.lib")
+
+typedef LONG (NTAPI *pfnNtQueryInformationThread)(HANDLE, ULONG, PVOID, ULONG, PULONG);
+typedef HRESULT (WINAPI *pfnGetThreadDescription)(HANDLE, PWSTR *);
+typedef LONG (NTAPI *pfnNtGetNextThread)(HANDLE, HANDLE, ACCESS_MASK, ULONG, ULONG, PHANDLE);
+#define THR_ACCESS (THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION | SYNCHRONIZE)
+
+typedef struct {
+    LONG      ExitStatus;
+    PVOID     TebBaseAddress;
+    HANDLE    UniqueProcess, UniqueThread;
+    ULONG_PTR AffinityMask;
+    LONG      Priority, BasePriority;
+} XTHREAD_BASIC_INFORMATION;
+
+typedef struct {
+    DWORD    tid;
+    HANDLE   h;
+    int      in_snap;     /* present in the latest toolhelp snapshot          */
+    int      gone;        /* exited / unsuspendable: never sampled again       */
+    int      late;        /* first seen after the initial snapshot             */
+    uint64_t start_addr;  /* Win32 start address                               */
+    uint64_t stack_base;  /* NT_TIB.StackBase at first sight (clamps the read) */
+    uint64_t cyc_last;    /* QueryThreadCycleTime at the last sample           */
+    uint64_t samples, idle_rounds, fails;
+} thr_t;
+
+/* ---- options ---------------------------------------------------------- */
+static DWORD       o_pid;
+static const char *o_name;
+static double      o_seconds = 10.0, o_wait = 0.0, o_delay = 0.0;
+static int         o_interval = 1, o_stack = 4096, o_max_ra = 12;
+static double      o_min_us = 20.0;
+static const char *o_out;
+
+/* ---- state ------------------------------------------------------------ */
+static HANDLE   g_proc;
+static FILE    *g_out;
+static uint64_t g_exe_base, g_exe_size, g_text_lo, g_text_hi;
+static thr_t   *g_thr;
+static int      g_nthr, g_capthr;
+static uint64_t g_min_cyc;
+static volatile LONG g_stop;
+static pfnNtQueryInformationThread p_NtQIT;
+static pfnGetThreadDescription     p_GetThreadDescription;
+static pfnNtGetNextThread          p_NtGetNextThread;
+static uint8_t *g_stackbuf;
+static LARGE_INTEGER g_qpf;
+static uint64_t g_nsamples, g_susp_ticks, g_susp_max;
+static uint64_t g_nquery, g_query_tsc;   /* QueryThreadCycleTime cost (diagnostics) */
+
+static double qpc_now_s(void) {
+    LARGE_INTEGER q; QueryPerformanceCounter(&q);
+    return (double)q.QuadPart / (double)g_qpf.QuadPart;
+}
+
+static BOOL WINAPI ctrl_handler(DWORD ev) { (void)ev; InterlockedExchange(&g_stop, 1); return TRUE; }
+
+static void usage(void) {
+    fprintf(stderr,
+        "usage: xprof (--pid N | --name EXE) --seconds S --out FILE\n"
+        "             [--interval-ms 1] [--stack-bytes 4096] [--max-ra 12]\n"
+        "             [--min-us 20] [--wait S] [--delay S]\n"
+        "  --min-us   a thread is sampled only if it used >= this much CPU since its\n"
+        "             last sample (cycle-accurate; filters the suspend APC's own cost)\n"
+        "  --wait     wait up to S seconds for --name to appear\n"
+        "  --delay    sleep S seconds after attaching before sampling\n");
+    exit(2);
+}
+
+static void parse_args(int argc, char **argv) {
+    for (int i = 1; i < argc; i++) {
+        const char *a = argv[i];
+        const char *v = (i + 1 < argc) ? argv[i + 1] : NULL;
+#define OPT(s) (!strcmp(a, s) && v && (++i, 1))
+        if      (OPT("--pid"))          o_pid = (DWORD)strtoul(v, NULL, 0);
+        else if (OPT("--name"))         o_name = v;
+        else if (OPT("--seconds"))      o_seconds = atof(v);
+        else if (OPT("--interval-ms"))  o_interval = atoi(v);
+        else if (OPT("--stack-bytes"))  o_stack = atoi(v);
+        else if (OPT("--max-ra"))       o_max_ra = atoi(v);
+        else if (OPT("--min-us"))       o_min_us = atof(v);
+        else if (OPT("--out"))          o_out = v;
+        else if (OPT("--wait"))         o_wait = atof(v);
+        else if (OPT("--delay"))        o_delay = atof(v);
+        else { fprintf(stderr, "xprof: bad argument '%s'\n", a); usage(); }
+#undef OPT
+    }
+    if ((!o_pid && !o_name) || !o_out || o_seconds <= 0) usage();
+    if (o_stack < 64) o_stack = 64;
+    if (o_stack > 1 << 20) o_stack = 1 << 20;
+    o_stack &= ~7;
+    if (o_max_ra < 0) o_max_ra = 0;
+    if (o_max_ra > 64) o_max_ra = 64;
+    if (o_interval < 0) o_interval = 0;
+}
+
+static DWORD find_pid(const char *name) {
+    wchar_t w[MAX_PATH];
+    MultiByteToWideChar(CP_UTF8, 0, name, -1, w, MAX_PATH);
+    if (!wcschr(w, L'.')) wcscat_s(w, MAX_PATH, L".exe");
+    DWORD pid = 0;
+    int n = 0;
+    HANDLE s = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (s == INVALID_HANDLE_VALUE) return 0;
+    PROCESSENTRY32W pe; pe.dwSize = sizeof pe;
+    if (Process32FirstW(s, &pe)) do {
+        if (!_wcsicmp(pe.szExeFile, w)) { if (!pid) pid = pe.th32ProcessID; n++; }
+    } while (Process32NextW(s, &pe));
+    CloseHandle(s);
+    if (n > 1) fprintf(stderr, "xprof: %d processes named %s, using pid %lu\n", n, name, pid);
+    return pid;
+}
+
+static void enable_debug_privilege(void) {
+    HANDLE tok;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &tok)) return;
+    TOKEN_PRIVILEGES tp; tp.PrivilegeCount = 1;
+    if (LookupPrivilegeValueW(NULL, L"SeDebugPrivilege", &tp.Privileges[0].Luid)) {
+        tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+        AdjustTokenPrivileges(tok, FALSE, &tp, 0, NULL, NULL);   /* fails silently unelevated */
+    }
+    CloseHandle(tok);
+}
+
+/* UTF-16 -> UTF-8, whitespace-control chars squashed so it stays one line */
+static void w2u(const wchar_t *w, char *out, int cap) {
+    out[0] = 0;
+    if (!w) return;
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, out, cap, NULL, NULL);
+    if (n <= 0) out[0] = 0;
+    for (char *p = out; *p; p++) if ((unsigned char)*p < 0x20) *p = ' ';
+}
+
+static uint64_t ft64(FILETIME f) { return ((uint64_t)f.dwHighDateTime << 32) | f.dwLowDateTime; }
+
+/* ---- modules / exe image ---------------------------------------------- */
+static void write_modules(const char *tag) {
+    HMODULE mods[2048]; DWORD need = 0;
+    if (!EnumProcessModulesEx(g_proc, mods, sizeof mods, &need, LIST_MODULES_ALL)) return;
+    int n = (int)(need / sizeof(HMODULE));
+    if (n > 2048) n = 2048;
+    for (int i = 0; i < n; i++) {
+        MODULEINFO mi; wchar_t wn[MAX_PATH], wp[MAX_PATH]; char un[MAX_PATH * 3], up[MAX_PATH * 3];
+        if (!GetModuleInformation(g_proc, mods[i], &mi, sizeof mi)) continue;
+        if (!GetModuleBaseNameW(g_proc, mods[i], wn, MAX_PATH)) wcscpy_s(wn, MAX_PATH, L"?");
+        if (!GetModuleFileNameExW(g_proc, mods[i], wp, MAX_PATH)) wp[0] = 0;
+        for (wchar_t *p = wn; *p; p++) if (*p == L' ') *p = L'_';
+        w2u(wn, un, sizeof un); w2u(wp, up, sizeof up);
+        fprintf(g_out, "%s %llx %lx %s %s\n", tag, (unsigned long long)(uintptr_t)mi.lpBaseOfDll,
+                (unsigned long)mi.SizeOfImage, un, up);
+        if (i == 0 && !g_exe_base) { g_exe_base = (uint64_t)(uintptr_t)mi.lpBaseOfDll; g_exe_size = mi.SizeOfImage; }
+    }
+}
+
+static int read_exe_header(void) {
+    uint8_t hdr[4096]; SIZE_T got = 0;
+    if (!ReadProcessMemory(g_proc, (LPCVOID)(uintptr_t)g_exe_base, hdr, sizeof hdr, &got) || got < 512) return 0;
+    IMAGE_DOS_HEADER *dos = (IMAGE_DOS_HEADER *)hdr;
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 ||
+        (size_t)dos->e_lfanew + sizeof(IMAGE_NT_HEADERS64) > sizeof hdr) return 0;
+    IMAGE_NT_HEADERS64 *nt = (IMAGE_NT_HEADERS64 *)(hdr + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return 0;
+    wchar_t wp[MAX_PATH]; char up[MAX_PATH * 3];
+    if (!GetModuleFileNameExW(g_proc, NULL, wp, MAX_PATH)) wp[0] = 0;
+    w2u(wp, up, sizeof up);
+    fprintf(g_out, "E %llx %llx %lx %s\n", (unsigned long long)g_exe_base, (unsigned long long)g_exe_size,
+            (unsigned long)nt->FileHeader.TimeDateStamp, up);
+    IMAGE_SECTION_HEADER *sec = IMAGE_FIRST_SECTION(nt);
+    uint64_t lo = ~0ull, hi = 0;
+    for (int i = 0; i < nt->FileHeader.NumberOfSections; i++) {
+        if ((uint8_t *)(sec + i + 1) > hdr + sizeof hdr) break;
+        if (!(sec[i].Characteristics & IMAGE_SCN_MEM_EXECUTE)) continue;
+        char nm[9]; memcpy(nm, sec[i].Name, 8); nm[8] = 0;
+        for (char *p = nm; *p; p++) if (*p == ' ') *p = '_';
+        uint64_t va = sec[i].VirtualAddress, sz = sec[i].Misc.VirtualSize;
+        fprintf(g_out, "X %s %llx %llx\n", nm[0] ? nm : "?", (unsigned long long)va, (unsigned long long)sz);
+        if (va < lo) lo = va;
+        if (va + sz > hi) hi = va + sz;
+    }
+    if (!hi) return 0;
+    g_text_lo = g_exe_base + lo; g_text_hi = g_exe_base + hi;
+    fprintf(g_out, "TEXT %llx %llx\n", (unsigned long long)lo, (unsigned long long)hi);
+    return 1;
+}
+
+/* ---- threads ---------------------------------------------------------- */
+static void thread_desc(HANDLE h, char *out, int cap) {
+    out[0] = 0;
+    if (!p_GetThreadDescription) return;
+    PWSTR w = NULL;
+    if (SUCCEEDED(p_GetThreadDescription(h, &w)) && w) { w2u(w, out, cap); LocalFree(w); }
+    for (char *p = out; *p; p++) if (*p == '\n' || *p == '\r') *p = ' ';
+}
+
+/* takes ownership of h on success; on NULL (thread already exited) the caller still owns it */
+static thr_t *add_thread_h(HANDLE h, DWORD tid, int late) {
+    if (WaitForSingleObject(h, 0) == WAIT_OBJECT_0) return NULL;   /* already exited */
+    if (g_nthr == g_capthr) {
+        g_capthr = g_capthr ? g_capthr * 2 : 128;
+        g_thr = (thr_t *)realloc(g_thr, (size_t)g_capthr * sizeof(thr_t));
+    }
+    thr_t *t = &g_thr[g_nthr++];
+    memset(t, 0, sizeof *t);
+    t->tid = tid; t->h = h; t->late = late; t->in_snap = 1;
+    if (p_NtQIT) {
+        PVOID sa = NULL;
+        if (p_NtQIT(h, 9 /*ThreadQuerySetWin32StartAddress*/, &sa, sizeof sa, NULL) == 0) t->start_addr = (uint64_t)(uintptr_t)sa;
+        XTHREAD_BASIC_INFORMATION tbi;
+        if (p_NtQIT(h, 0 /*ThreadBasicInformation*/, &tbi, sizeof tbi, NULL) == 0 && tbi.TebBaseAddress) {
+            uint64_t sb = 0; SIZE_T got = 0;
+            if (ReadProcessMemory(g_proc, (uint8_t *)tbi.TebBaseAddress + 8, &sb, 8, &got) && got == 8) t->stack_base = sb;
+        }
+    }
+    ULONG64 cyc = 0; QueryThreadCycleTime(h, &cyc); t->cyc_last = cyc;
+    FILETIME c = {0}, e, k = {0}, u = {0}; GetThreadTimes(h, &c, &e, &k, &u);
+    char name[512]; thread_desc(h, name, sizeof name);
+    fprintf(g_out, "T0 %lu %d %llx %llu %llu %llu %llx %s\n", (unsigned long)tid, late,
+            (unsigned long long)ft64(c), (unsigned long long)ft64(u), (unsigned long long)ft64(k),
+            (unsigned long long)cyc, (unsigned long long)t->start_addr, name);
+    return t;
+}
+
+static thr_t *find_live(DWORD tid) {
+    for (int i = 0; i < g_nthr; i++) if (g_thr[i].tid == tid && !g_thr[i].gone) return &g_thr[i];
+    return NULL;
+}
+
+/* thread list via NtGetNextThread: walks only the target's threads (a system-wide
+   toolhelp thread snapshot costs ~50 ms on a busy desktop, stalling the sampler) */
+static int refresh_ngnt(int initial) {
+    HANDLE cur = NULL;
+    int cur_kept = 0, complete = 0, n = 0;
+    for (;;) {
+        HANDLE nx = NULL;
+        LONG st = p_NtGetNextThread(g_proc, cur, THR_ACCESS, 0, 0, &nx);
+        if (cur && !cur_kept) CloseHandle(cur);
+        if (st < 0 || !nx) { complete = (st == (LONG)0x8000001A /*STATUS_NO_MORE_ENTRIES*/); break; }
+        cur = nx; cur_kept = 0; n++;
+        DWORD tid = GetThreadId(cur);
+        thr_t *t = find_live(tid);
+        if (t && WaitForSingleObject(t->h, 0) == WAIT_OBJECT_0) { t->gone = 1; t = NULL; }   /* tid reused */
+        if (!t) { t = add_thread_h(cur, tid, !initial); cur_kept = t != NULL; }
+        if (t) t->in_snap = 1;
+    }
+    return complete && n > 0;
+}
+
+static void refresh_toolhelp(int initial) {
+    HANDLE s = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (s == INVALID_HANDLE_VALUE) return;
+    THREADENTRY32 te; te.dwSize = sizeof te;
+    if (Thread32First(s, &te)) do {
+        if (te.dwSize < FIELD_OFFSET(THREADENTRY32, th32OwnerProcessID) + sizeof te.th32OwnerProcessID) goto next;
+        if (te.th32OwnerProcessID != o_pid) goto next;
+        thr_t *t = find_live(te.th32ThreadID);
+        if (t && WaitForSingleObject(t->h, 0) == WAIT_OBJECT_0) { t->gone = 1; t = NULL; }  /* tid reused */
+        if (!t) {
+            HANDLE h = OpenThread(THR_ACCESS, FALSE, te.th32ThreadID);
+            if (h && !(t = add_thread_h(h, te.th32ThreadID, !initial))) CloseHandle(h);
+        }
+        if (t) t->in_snap = 1;
+    next:
+        te.dwSize = sizeof te;
+    } while (Thread32Next(s, &te));
+    CloseHandle(s);
+}
+
+static void refresh_threads(int initial) {
+    for (int i = 0; i < g_nthr; i++) g_thr[i].in_snap = 0;
+    if (p_NtGetNextThread && !refresh_ngnt(initial)) {
+        if (initial) p_NtGetNextThread = NULL;      /* unusable (access?): toolhelp from now on */
+        else return;                                /* transient failure: keep the old list */
+    }
+    if (!p_NtGetNextThread) refresh_toolhelp(initial);
+    for (int i = 0; i < g_nthr; i++) if (!g_thr[i].in_snap) g_thr[i].gone = 1;   /* exited */
+}
+
+static char *put_hex(char *p, uint64_t v) {
+    char t[16]; int n = 0;
+    do { t[n++] = "0123456789abcdef"[v & 15]; v >>= 4; } while (v);
+    while (n) *p++ = t[--n];
+    return p;
+}
+static char *put_dec(char *p, uint64_t v) {
+    char t[24]; int n = 0;
+    do { t[n++] = (char)('0' + v % 10); v /= 10; } while (v);
+    while (n) *p++ = t[--n];
+    return p;
+}
+
+static __declspec(align(16)) CONTEXT g_ctx;
+
+static void sample_thread(thr_t *t) {
+    ULONG64 cyc = 0;
+    uint64_t k0 = __rdtsc();
+    BOOL okq = QueryThreadCycleTime(t->h, &cyc);
+    g_query_tsc += __rdtsc() - k0; g_nquery++;
+    if (!okq) { t->gone = 1; return; }
+    if (cyc - t->cyc_last < g_min_cyc) { t->idle_rounds++; return; }
+
+    /* ---- suspended window: keep it minimal; ResumeThread on every path ---- */
+    LARGE_INTEGER q0, q1;
+    QueryPerformanceCounter(&q0);
+    if (SuspendThread(t->h) == (DWORD)-1) { t->gone = 1; return; }
+    g_ctx.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+    BOOL okc = GetThreadContext(t->h, &g_ctx);
+    SIZE_T got = 0;
+    uint64_t rip = 0, rsp = 0;
+    if (okc) {
+        rip = g_ctx.Rip; rsp = g_ctx.Rsp;
+        SIZE_T want = (SIZE_T)o_stack;
+        if (t->stack_base > rsp && t->stack_base - rsp < want) want = (SIZE_T)(t->stack_base - rsp);
+        if (!ReadProcessMemory(g_proc, (LPCVOID)(uintptr_t)rsp, g_stackbuf, want, &got)) {
+            SIZE_T pg = 0x1000 - (SIZE_T)(rsp & 0xFFF);          /* RSP's own page is always mapped */
+            if (pg > want) pg = want;
+            if (!ReadProcessMemory(g_proc, (LPCVOID)(uintptr_t)rsp, g_stackbuf, pg, &got)) got = 0;
+        }
+    }
+    ResumeThread(t->h);
+    QueryPerformanceCounter(&q1);
+    /* ---------------------------------------------------------------------- */
+
+    uint64_t d = (uint64_t)(q1.QuadPart - q0.QuadPart);
+    g_susp_ticks += d;
+    if (d > g_susp_max) g_susp_max = d;
+    if (!okc) { t->fails++; return; }
+
+    uint64_t dcyc = cyc - t->cyc_last;
+    t->cyc_last = cyc;
+    t->samples++;
+    g_nsamples++;
+
+    char line[64 + 24 * 64], *p = line;
+    *p++ = 'S'; *p++ = ' ';
+    p = put_dec(p, t->tid); *p++ = ' ';
+    p = put_hex(p, rip);    *p++ = ' ';
+    p = put_dec(p, dcyc);
+    const uint64_t *w = (const uint64_t *)g_stackbuf;
+    size_t nw = got / 8;
+    int nra = 0;
+    for (size_t i = 0; i < nw && nra < o_max_ra; i++) {
+        uint64_t v = w[i];
+        if (v >= g_text_lo && v < g_text_hi) { *p++ = ' '; p = put_hex(p, v - g_exe_base); nra++; }
+    }
+    *p++ = '\n';
+    fwrite(line, 1, (size_t)(p - line), g_out);
+}
+
+int main(int argc, char **argv) {
+    parse_args(argc, argv);
+    QueryPerformanceFrequency(&g_qpf);
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    p_NtQIT = (pfnNtQueryInformationThread)(void *)GetProcAddress(ntdll, "NtQueryInformationThread");
+    p_NtGetNextThread = (pfnNtGetNextThread)(void *)GetProcAddress(ntdll, "NtGetNextThread");
+    p_GetThreadDescription = (pfnGetThreadDescription)(void *)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription");
+    if (!p_GetThreadDescription)
+        p_GetThreadDescription = (pfnGetThreadDescription)(void *)GetProcAddress(GetModuleHandleW(L"kernelbase.dll"), "GetThreadDescription");
+    enable_debug_privilege();
+
+    if (!o_pid) {
+        double t_end = qpc_now_s() + o_wait;
+        for (;;) {
+            o_pid = find_pid(o_name);
+            if (o_pid || qpc_now_s() >= t_end) break;
+            Sleep(100);
+        }
+        if (!o_pid) { fprintf(stderr, "xprof: no process named %s\n", o_name); return 1; }
+    }
+    g_proc = OpenProcess(PROCESS_QUERY_INFORMATION | PROCESS_VM_READ | SYNCHRONIZE, FALSE, o_pid);
+    if (!g_proc) { fprintf(stderr, "xprof: OpenProcess(%lu) failed: %lu\n", o_pid, GetLastError()); return 1; }
+
+    g_out = fopen(o_out, "wb");
+    if (!g_out) { fprintf(stderr, "xprof: cannot write %s\n", o_out); return 1; }
+    setvbuf(g_out, NULL, _IOFBF, 4 << 20);
+    g_stackbuf = (uint8_t *)malloc((size_t)o_stack);
+    SetConsoleCtrlHandler(ctrl_handler, TRUE);
+    timeBeginPeriod(1);
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+
+    if (o_delay > 0) {
+        double t_end = qpc_now_s() + o_delay;
+        while (!g_stop && qpc_now_s() < t_end && WaitForSingleObject(g_proc, 100) == WAIT_TIMEOUT) {}
+    }
+
+    /* quick TSC calibration (refined over the whole run at the end) */
+    LARGE_INTEGER c0, c1; uint64_t k0 = __rdtsc(); QueryPerformanceCounter(&c0);
+    Sleep(25);
+    uint64_t k1 = __rdtsc(); QueryPerformanceCounter(&c1);
+    double tsc_hz = (double)(k1 - k0) * (double)g_qpf.QuadPart / (double)(c1.QuadPart - c0.QuadPart);
+    g_min_cyc = (uint64_t)(o_min_us * 1e-6 * tsc_hz);
+
+    wchar_t wexe[MAX_PATH]; char uexe[MAX_PATH * 3];
+    if (!GetModuleBaseNameW(g_proc, NULL, wexe, MAX_PATH)) wcscpy_s(wexe, MAX_PATH, L"?");
+    w2u(wexe, uexe, sizeof uexe);
+    FILETIME ft0; GetSystemTimeAsFileTime(&ft0);
+    fprintf(g_out, "XPROF 1\nP %lu %s\n", (unsigned long)o_pid, uexe);
+    fprintf(g_out, "OPT interval_ms=%d stack_bytes=%d max_ra=%d min_us=%g seconds=%g\n",
+            o_interval, o_stack, o_max_ra, o_min_us, o_seconds);
+    write_modules("M");
+    if (!g_exe_base || !read_exe_header()) {
+        fprintf(stderr, "xprof: cannot read the target's exe image header (64-bit target required)\n");
+        fclose(g_out); return 1;
+    }
+
+    uint64_t tsc_start = __rdtsc();
+    double t_start = qpc_now_s(), t_end = t_start + o_seconds, next_refresh = t_start + 0.25;
+    fprintf(g_out, "START ft=%llx\n", (unsigned long long)ft64(ft0));
+    refresh_threads(1);
+    uint64_t rounds = 0;
+    int proc_exited = 0;
+    double busy = 0, refresh_s = 0;   /* sampler time spent outside Sleep / in thread-list refreshes */
+    while (!g_stop) {
+        double now = qpc_now_s();
+        if (now >= t_end) break;
+        if (now >= next_refresh) {
+            refresh_threads(0);
+            next_refresh = qpc_now_s() + 0.25;
+            refresh_s += next_refresh - 0.25 - now;
+            if (WaitForSingleObject(g_proc, 0) == WAIT_OBJECT_0) { proc_exited = 1; break; }
+        }
+        for (int i = 0; i < g_nthr && !g_stop; i++)
+            if (!g_thr[i].gone) sample_thread(&g_thr[i]);
+        rounds++;
+        busy += qpc_now_s() - now;
+        Sleep((DWORD)o_interval);
+    }
+    double t_stop = qpc_now_s();
+    uint64_t tsc_stop = __rdtsc();
+    timeEndPeriod(1);
+    double wall = t_stop - t_start;
+    tsc_hz = (double)(tsc_stop - tsc_start) / wall;
+
+    for (int i = 0; i < g_nthr; i++) {
+        thr_t *t = &g_thr[i];
+        FILETIME c = {0}, e, k = {0}, u = {0}; GetThreadTimes(t->h, &c, &e, &k, &u);
+        ULONG64 cyc = 0; QueryThreadCycleTime(t->h, &cyc);
+        int alive = WaitForSingleObject(t->h, 0) == WAIT_TIMEOUT;
+        char name[512]; thread_desc(t->h, name, sizeof name);
+        fprintf(g_out, "T1 %lu %d %llu %llu %llu %llu %llu %llu %llx %s\n", (unsigned long)t->tid, alive,
+                (unsigned long long)ft64(u), (unsigned long long)ft64(k), (unsigned long long)cyc,
+                (unsigned long long)t->samples, (unsigned long long)t->idle_rounds, (unsigned long long)t->fails,
+                (unsigned long long)t->start_addr, name);
+        CloseHandle(t->h);
+    }
+    if (!proc_exited) write_modules("M");
+    double susp_avg = g_nsamples ? (double)g_susp_ticks / (double)g_nsamples * 1e6 / (double)g_qpf.QuadPart : 0;
+    double susp_max = (double)g_susp_max * 1e6 / (double)g_qpf.QuadPart;
+    double busy_pct = wall > 0 ? 100.0 * busy / wall : 0;
+    fprintf(g_out, "W wall_s=%.4f rounds=%llu tsc_hz=%.0f samples=%llu threads=%d susp_avg_us=%.1f susp_max_us=%.1f "
+            "sampler_busy_pct=%.1f refresh_ms_total=%.1f query_us_avg=%.2f proc_exited=%d\nEND\n",
+            wall, (unsigned long long)rounds, tsc_hz, (unsigned long long)g_nsamples, g_nthr, susp_avg, susp_max,
+            busy_pct, refresh_s * 1e3, g_nquery ? (double)g_query_tsc / (double)g_nquery / tsc_hz * 1e6 : 0.0, proc_exited);
+    fclose(g_out);
+    fprintf(stderr, "xprof: pid %lu, %.2f s, %llu rounds (%.2f ms/round), %llu samples, %d threads, suspend avg %.1f us "
+            "max %.1f us, sampler busy %.1f%% of wall -> %s\n",
+            (unsigned long)o_pid, wall, (unsigned long long)rounds, rounds ? wall * 1e3 / (double)rounds : 0.0,
+            (unsigned long long)g_nsamples, g_nthr, susp_avg, susp_max, busy_pct, o_out);
+    return 0;
+}
diff --git a/tools/xprof/xprof_diff.py b/tools/xprof/xprof_diff.py
new file mode 100644
index 00000000..b6316173
--- /dev/null
+++ b/tools/xprof/xprof_diff.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""xprof_diff.py A.json B.json [--top 30] -- compare two xprof_report.py --json dumps.
+
+Prints process CPU, category share (% of sampled CPU and cores), named-thread CPU,
+and the lifted functions / symbols whose self share moved the most (B - A).
+"""
+import argparse, json
+
+
+def load(p):
+    with open(p) as f:
+        return json.load(f)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('a')
+    ap.add_argument('b')
+    ap.add_argument('--top', type=int, default=30)
+    a = ap.parse_args()
+    A, B = load(a.a), load(a.b)
+    print('A: %s  (%.1f s, %d samples)' % (A['meta']['file'], A['meta']['wall_s'], A['meta']['samples']))
+    print('B: %s  (%.1f s, %d samples)' % (B['meta']['file'], B['meta']['wall_s'], B['meta']['samples']))
+    pa, pb = A['process'], B['process']
+    print('process CPU cores: %.2f -> %.2f (%+.2f)   sampled %.2f -> %.2f'
+          % (pa['cores'], pb['cores'], pb['cores'] - pa['cores'], pa['cores_sampled'], pb['cores_sampled']))
+
+    print('\n== categories ==')
+    print('  %-12s %7s %7s %7s   %6s %6s %7s' % ('category', 'A cpu%', 'B cpu%', 'delta', 'A core', 'B core', 'delta'))
+    ca, cb = A['categories'], B['categories']
+    for c in sorted(set(ca) | set(cb), key=lambda c: -max(ca.get(c, {}).get('pct', 0), cb.get(c, {}).get('pct', 0))):
+        x, y = ca.get(c, {}), cb.get(c, {})
+        print('  %-12s %6.1f%% %6.1f%% %+6.1f   %6.2f %6.2f %+7.2f' % (
+            c, x.get('pct', 0), y.get('pct', 0), y.get('pct', 0) - x.get('pct', 0),
+            x.get('cores', 0), y.get('cores', 0), y.get('cores', 0) - x.get('cores', 0)))
+
+    def by_name(J):
+        d = {}
+        for t in J['threads']:
+            if t['name']:
+                d[t['name']] = d.get(t['name'], 0) + t['cores']
+        return d
+    ta, tb = by_name(A), by_name(B)
+    names = sorted(set(ta) | set(tb), key=lambda n: -max(ta.get(n, 0), tb.get(n, 0)))
+    names = [n for n in names if max(ta.get(n, 0), tb.get(n, 0)) >= 0.02][:a.top]
+    if names:
+        print('\n== named threads (cores) ==')
+        for n in names:
+            print('  %6.2f -> %6.2f  %+6.2f  %s' % (ta.get(n, 0), tb.get(n, 0), tb.get(n, 0) - ta.get(n, 0), n))
+
+    def table(title, la, lb, key):
+        da = {r[key]: r['pct'] for r in la}
+        db = {r[key]: r['pct'] for r in lb}
+        ks = sorted(set(da) | set(db), key=lambda k: -abs(db.get(k, 0) - da.get(k, 0)))[:a.top]
+        print('\n== %s (%% of sampled CPU; sorted by |delta|) ==' % title)
+        print('  %7s %7s %7s  %s' % ('A', 'B', 'delta', key))
+        for k in ks:
+            x, y = da.get(k), db.get(k)
+            fx = '%6.2f%%' % x if x is not None else '     --'
+            fy = '%6.2f%%' % y if y is not None else '     --'
+            print('  %s %s %+7.2f  %s' % (fx, fy, (y or 0) - (x or 0), k))
+        print('  (-- = not in that run\'s exported top list)')
+
+    table('lifted functions, self', A['lifted_self'], B['lifted_self'], 'func')
+    table('lifted functions incl. charged callees', A['lifted_attr'], B['lifted_attr'], 'func')
+    table('all symbols, self', A['top_symbols'], B['top_symbols'], 'sym')
+
+
+if __name__ == '__main__':
+    main()
