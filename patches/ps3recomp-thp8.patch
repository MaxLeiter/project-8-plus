+/* ------------------------------------------------------------------------------------------------ command lists */
+typedef struct { const u32* p; u32 n; } wgs_seg;
+typedef struct wgs_list {
+    ID3D12GraphicsCommandList iface;
+    volatile LONG refs;
+    wgs_alloc* a;
+    wgs_seg* segs; u32 nseg, capseg;
+    u32* seg_start; u32* w; u32 left;            /* the open segment: [seg_start, w), `left` words free */
+    wgs_spans ups;                               /* reference-tracked upload ranges */
+    wgs_spans rbs;                               /* readback destinations */
+    wgs_rootsig* rs[2];                          /* 0 graphics, 1 compute */
+    u64 arg[2][32];                              /* table GPU handle or root view VA */
+    u32 cst[2][32][64];
+    int dirty[2];
+} wgs_list;
+static wgs_list* L_of(ID3D12GraphicsCommandList* t) { return (wgs_list*)t; }
+
+static void list_close_seg(wgs_list* l)
+{
+    if (l->seg_start && l->w > l->seg_start) {
+        if (l->nseg == l->capseg) { l->capseg = l->capseg * 2 + 8; l->segs = (wgs_seg*)realloc(l->segs, l->capseg * sizeof *l->segs); }
+        l->segs[l->nseg++] = (wgs_seg){ l->seg_start, (u32)(l->w - l->seg_start) };
+    }
+    l->seg_start = l->w;
+}
+/* Room for one command of `words` payload words (commands never straddle chunks). */
+static u32* L_cmd(wgs_list* l, u32 op, u32 words)
+{
+    if (words + 1 > l->left) {
+        list_close_seg(l);
+        wgs_alloc* a = l->a;
+        if (a->used) { a->cur++; a->used = 0; }
+        if (a->cur >= a->nchunks) {
+            if (a->nchunks == a->cap) { a->cap = a->cap * 2 + 4; a->chunks = (u32**)realloc(a->chunks, a->cap * sizeof *a->chunks); }
+            a->chunks[a->nchunks++] = (u32*)wgs_zalloc(WGS_CHUNK_WORDS * 4);
+        }
+        if (words + 1 > WGS_CHUNK_WORDS) { WGS_LOG("command too large (%u words)\n", words); abort(); }
+        l->w = l->seg_start = a->chunks[a->cur]; l->left = WGS_CHUNK_WORDS;
+    }
+    u32* p = l->w;
+    *p = op << 16 | words;
+    l->w += words + 1; l->left -= words + 1;
+    l->a->used = (u32)(l->w - l->a->chunks[l->a->cur]);
+    return p + 1;
+}
+
+static void L_track_upload(wgs_list* l, u32 id, u64 lo, u64 hi)
+{
+    wgs_resource* r = mappable_of(id);
+    if (!r || r->heap != D3D12_HEAP_TYPE_UPLOAD || s_hint_mode[id]) return;
+    spans_add(&l->ups, id, lo, hi > r->size ? r->size : hi);
+}
+static void L_track_readback(wgs_list* l, u32 id, u64 lo, u64 hi)
+{
+    wgs_resource* r = mappable_of(id);
+    if (r && r->heap == D3D12_HEAP_TYPE_READBACK) spans_add(&l->rbs, id, lo, hi > r->size ? r->size : hi);
+}
