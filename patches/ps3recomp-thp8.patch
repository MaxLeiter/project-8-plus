+/*
+ * ps3recomp - plugin (mod DLL) loader and host API for include/ps3mod.h.
+ *
+ * Mod-capable builds only: the whole file is inside #ifdef PPU_MOD_HOOKS and in
+ * no default source list. A port that wants plugins compiles it together with
+ * ppu_mod_hooks.cpp into its game target with -DPPU_MOD_HOOKS. Without plugins
+ * on disk nothing here runs beyond a directory probe, and the host_* event
+ * entry points return after one flag test.
+ *
+ * ps3mod_load_plugins(elf_path), called by boot_main after lv2_init_syscalls()
+ * and before the vblank ticker / ppu_run:
+ *   1. <mods> = %PS3_MODS_ROOT% ("" / "0" / "off" = no mods), else <exe dir>\mods.
+ *      Same convention as the data overlay (runtime/syscalls/vfs_mods.c on the
+ *      thp8-p8plus branch); this file does not depend on it.
+ *      PS3_MODS_PLUGINS=0 (or off/no/false/"") turns plugins off on their own.
+ *   2. Candidates: <mods>\<pack>\plugins\*.dll for every pack folder, then
+ *      <mods>\plugins\*.dll; folders and DLLs in case-insensitive name order;
+ *      a '_' or '.' name prefix = disabled. The root folder loads last, so its
+ *      hooks run first (a later hook wraps an earlier one).
+ *      Off Windows: <mods>/<pack>/plugins/*.so and <mods>/plugins/*.so, <mods> default
+ *      <exe dir>/mods; same order, prefixes and config rules (a .dll there is ignored).
+ *   3. Per DLL: LoadLibraryExW(full path, LOAD_WITH_ALTERED_SEARCH_PATH);
+ *      (POSIX: dlopen(path, RTLD_NOW | RTLD_LOCAL) + dlsym);
+ *      ps3mod_query (optional) -> validate the info; ps3mod_init(host, info)
+ *      with every hook / patch / event handler STAGED; validate again; then
+ *      commit, or refuse: ps3mod_shutdown (if init ran), FreeLibrary, and the
+ *      game runs without it.
+ *
+ * Validation (each failure is logged "[mods] plugin <file> refused: <reason>"):
+ *   (a) info.abi_version: same major, minor <= ours; info.ctx_layout and
+ *       info.lift_abi 0 ("don't care") or equal to ours;
+ *   (b) info.required_ppu_hash == the PPU hash of the running ELF (below),
+ *       unless the plugin sets PS3MOD_INFO_ANY_GAME;
+ *   (c) info.required_lift_id (if set) == our lift id; every
+ *       info.required_entries address is a hookable lifted function entry;
+ *       every hook_register call made during init targeted a lifted function
+ *       entry in function_table[] that is not an HLE import stub (the call
+ *       itself fails at once with a log line saying why);
+ *   (d) every patch made during init found its expected original bytes.
+ *
+ * PPU hash = RPCS3's executable hash, "PPU-" + lower-case hex SHA-1 over, for
+ * each program header in file order: p_type and p_flags (4 + 4 bytes exactly
+ * as stored, i.e. big-endian), and for a PT_LOAD with p_memsz != 0 also
+ * p_vaddr and p_memsz (8 + 8 bytes as stored) followed by the segment's
+ * p_filesz bytes from the file. It is computed from the ELF FILE, because by
+ * the time plugins load the HLE/PRX setup has already written into guest
+ * memory. Same algorithm as thp8-mod\tools\ps3elf.py ppu_hash(). Cross-check:
+ *     python thp8-mod\tools\ps3elf.py hash game\EBOOT.elf
+ *     -> PPU-de89165d4428c218f9ade10050ea093f7bde9e8d   (THP8 BLUS30011, 01.02)
+ * must equal the hash in the loader's "[mods] running ELF ..." line.
+ *
+ * Lift id = "LIFT-<function_table_count>-<FNV-1a 64 over every entry address,
+ * 4 bytes big-endian, in table order>". Two exes built from the same lift
+ * agree; a relift that adds, drops or reorders a function changes it.
+ */
+#ifdef PPU_MOD_HOOKS
+
