+static int sd_same_path(const char* a, const char* b)
+{
+    char x[SD_PATH_MAX], y[SD_PATH_MAX];
+    snprintf(x, sizeof x, "%s", a);
+    snprintf(y, sizeof y, "%s", b);
+    for (char* c = x; *c; c++) if (*c == '\\') *c = '/';
+    for (char* c = y; *c; c++) if (*c == '\\') *c = '/';
+    size_t n = strlen(x), m = strlen(y);
+    while (n > 1 && x[n - 1] == '/') x[--n] = 0;
+    while (m > 1 && y[m - 1] == '/') y[--m] = 0;
+#ifdef _WIN32
+    return n == m && sd_strnicmp(x, y, n) == 0;    /* NTFS: case-insensitive (ASCII folding is enough here) */
+#else
+    return strcmp(x, y) == 0;
+#endif
+}
