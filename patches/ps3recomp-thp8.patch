+static void gcm_fifo_dump_around(u32 getoff)
+{
+    static int d = 0;
+    if (!getenv("GCM_RECDBG") || d++ >= 3) return;
+    for (u32 t = 0; t < GCM_TRACE_N; t++) {
+        u32 k = (s_tr_i + t) % GCM_TRACE_N;
+        if (!s_tr_w[k]) continue;
