+/* ===========================================================================
+ * 3. MFC: GET/PUT, list DMA, stall-and-notify, fences, tag status
+ * ===========================================================================*/
+#define EA_BUF   0x00200000u     /* 64 KB of DMA source/destination */
+#define EA_LIST  0x00300000u
+
+static void test_mfc_getput(void)
+{
+    TEST("mfc.get-put-sizes");
+    spu_context* c = new_ctx(3);
+    static const uint32_t small[] = { 1, 2, 4, 8 };
+    int ok_get = 1, ok_put = 1, ok_guard = 1;
+    /* 1/2/4/8 bytes, naturally aligned, at every legal offset in a quadword
+     * (the LSA and EA share the low four bits). */
+    for (int s = 0; s < 4; s++) {
+        uint32_t n = small[s];
+        for (uint32_t off = 0; off < 16; off += n) {
+            fill(vm_base + EA_BUF, 64, (uint8_t)(0x11 * (s + 1) + off));
+            memset(c->ls + 0x1000, 0xEE, 64);
+            mfc(c, MFC_GET_CMD, 0x1010 + off, EA_BUF + 0x10 + off, n, 1);
+            if (memcmp(c->ls + 0x1010 + off, vm_base + EA_BUF + 0x10 + off, n)) ok_get = 0;
+            for (uint32_t k = 0; k < 64; k++)       /* nothing outside the n bytes */
+                if ((k < 0x10 + off || k >= 0x10 + off + n) && c->ls[0x1000 + k] != 0xEE) ok_guard = 0;
+            fill(c->ls + 0x2000, 64, (uint8_t)(0x5A + off));
+            memset(vm_base + EA_BUF + 0x100, 0x33, 64);
+            mfc(c, MFC_PUT_CMD, 0x2010 + off, EA_BUF + 0x110 + off, n, 2);
+            if (memcmp(vm_base + EA_BUF + 0x110 + off, c->ls + 0x2010 + off, n)) ok_put = 0;
+            for (uint32_t k = 0; k < 64; k++)
+                if ((k < 0x10 + off || k >= 0x10 + off + n) && vm_base[EA_BUF + 0x100 + k] != 0x33) ok_guard = 0;
+        }
+    }
+    CHECK(ok_get); CHECK(ok_put); CHECK(ok_guard);
+    /* Multiples of 16 up to 16 KB. */
+    ok_get = ok_put = 1;
+    for (uint32_t n = 16; n <= 0x4000; n += (n < 256 ? 16 : n < 4096 ? 0x110 : 0x400)) {
+        n &= ~15u;
+        fill(vm_base + EA_BUF, n, (uint8_t)n);
+        memset(c->ls + 0x4000, 0, 0x4000 + 16);
+        mfc(c, MFC_GET_CMD, 0x4000, EA_BUF, n, 3);
+        if (memcmp(c->ls + 0x4000, vm_base + EA_BUF, n) || c->ls[0x4000 + n] != 0) ok_get = 0;
+        fill(c->ls + 0x10000, n, (uint8_t)(n * 3));
+        memset(vm_base + EA_BUF + 0x8000, 0, 0x4000 + 16);
+        mfc(c, MFC_PUT_CMD, 0x10000, EA_BUF + 0x8000, n, 3);
+        if (memcmp(vm_base + EA_BUF + 0x8000, c->ls + 0x10000, n) || vm_base[EA_BUF + 0x8000 + n]) ok_put = 0;
+    }
+    CHECK(ok_get); CHECK(ok_put);
+    CHECK_EQ(tag_wait(c, 0xE, MFC_TAG_UPDATE_ALL), 0xE);
+
+    /* The top of local store is reachable, and a 16 KB transfer that ends
+     * exactly at 256 KB is legal. */
+    TEST("mfc.top-of-ls");
+    fill(vm_base + EA_BUF, 0x4000, 0x77);
+    mfc(c, MFC_GET_CMD, SPU_LS_SIZE - 0x4000, EA_BUF, 0x4000, 4);
+    CHECK(memcmp(c->ls + SPU_LS_SIZE - 0x4000, vm_base + EA_BUF, 0x4000) == 0);
+
+    /* Malformed transfers move nothing. */
+    TEST("mfc.malformed");
+    memset(c->ls + 0x3000, 0xEE, 0x40);
+    fill(vm_base + EA_BUF, 0x40, 1);
+    mfc(c, MFC_GET_CMD, 0x3004, EA_BUF + 0x8, 16, 5);        /* LSA/EA low bits differ */
+    mfc(c, MFC_GET_CMD, 0x3000, EA_BUF, 0x4010, 5);          /* > 16 KB */
+    mfc(c, MFC_GET_CMD, 0x3000, EA_BUF, 0x18, 5);            /* >= 16, not a multiple */
+    { int untouched = 1; for (int k = 0; k < 0x40; k++) if (c->ls[0x3000 + k] != 0xEE) untouched = 0;
+      CHECK(untouched); }
+    /* Sizes that are not 1/2/4/8 below 16, and quadword transfers off a
+     * 16-byte boundary, are alignment errors on hardware (the MFC raises a DMA
+     * alignment interrupt and moves nothing). The runtime performs them. */
+    mfc(c, MFC_GET_CMD, 0x3001, EA_BUF + 0x1, 3, 5);
+    NOTE(c->ls[0x3001] == 0xEE, "size 3 is performed (hardware: DMA alignment error)");
+    mfc(c, MFC_GET_CMD, 0x3014, EA_BUF + 0x14, 32, 5);
+    NOTE(c->ls[0x3014] == 0xEE, "32-byte transfer at LSA/EA +4 is performed (hardware: alignment error)");
+    mfc(c, MFC_GET_CMD, 0x3022, EA_BUF + 0x22, 4, 5);
+    NOTE(c->ls[0x3022] == 0xEE, "4-byte transfer at +2 is performed (hardware: alignment error)");
+    /* Size 0 is a legal no-op that still completes its tag. */
+    mfc(c, MFC_PUT_CMD, 0x3000, EA_BUF, 0, 6);
+    CHECK_EQ(tag_wait(c, 1u << 6, MFC_TAG_UPDATE_ALL), 1u << 6);
+
+    /* EAH comes from the command; SPU thread EAs are 32-bit, so a zero EAH
+     * addresses the same memory. */
+    TEST("mfc.eah");
+    fill(vm_base + EA_BUF + 0x200, 32, 0x42);
+    wr(c, MFC_LSA, 0x5000); wr(c, MFC_EAH, 0); wr(c, MFC_EAL, EA_BUF + 0x200);
+    wr(c, MFC_Size, 32); wr(c, MFC_TagID, 7); wr(c, MFC_Cmd, MFC_GET_CMD);
+    CHECK(memcmp(c->ls + 0x5000, vm_base + EA_BUF + 0x200, 32) == 0);
+    free_ctx(c);
+}
+
+static void test_mfc_fence_barrier_tags(void)
+{
+    TEST("mfc.fence-barrier");
+    spu_context* c = new_ctx(4);
+    static const uint32_t cmds[] = { MFC_GETB_CMD, MFC_GETF_CMD, MFC_PUTB_CMD, MFC_PUTF_CMD };
+    for (int i = 0; i < 4; i++) {
+        uint32_t tag = 8 + (uint32_t)i;
+        fill(vm_base + EA_BUF + 0x400, 64, (uint8_t)(i * 9));
+        fill(c->ls + 0x6000, 64, (uint8_t)(i * 13 + 1));
+        mfc(c, cmds[i], 0x6000, EA_BUF + 0x400, 64, tag);
+        CHECK(memcmp(c->ls + 0x6000, vm_base + EA_BUF + 0x400, 64) == 0);
+        CHECK_EQ(tag_wait(c, 1u << tag, MFC_TAG_UPDATE_ALL), 1u << tag);
+    }
+    /* barrier / mfceieio / mfcsync complete the tag they name. */
+    mfc(c, MFC_BARRIER_CMD, 0, 0, 0, 12);
+    mfc(c, MFC_EIEIO_CMD, 0, 0, 0, 13);
+    mfc(c, MFC_SYNC_CMD, 0, 0, 0, 14);
+    CHECK_EQ(tag_wait(c, 7u << 12, MFC_TAG_UPDATE_ALL), 7u << 12);
+
+    TEST("mfc.tag-status");
+    /* Every tag is idle at start; immediate, any and all report mask & done. */
+    CHECK_EQ(tag_wait(c, 0xFFFFFFFFu, MFC_TAG_UPDATE_IMMEDIATE), 0xFFFFFFFFu);
+    CHECK_EQ(tag_wait(c, 0x00010001u, MFC_TAG_UPDATE_ANY), 0x00010001u);
+    CHECK_EQ(tag_wait(c, 0x80000000u, MFC_TAG_UPDATE_ALL), 0x80000000u);
+    CHECK_EQ(rd(c, MFC_RdTagMask), 0x80000000u);
+    CHECK_EQ(tag_wait(c, 0, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    CHECK_EQ(cnt(c, MFC_Cmd), 16);                       /* queue space: all 16 */
+    /* rchcnt(MFC_RdTagStat) is 1 only between a satisfied update request and
+     * the read that consumes it; DMA here is synchronous and the status is
+     * kept readable. */
+    wr(c, MFC_WrTagMask, 1); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL);
+    CHECK_EQ(cnt(c, MFC_RdTagStat), 1);
+    (void)rd(c, MFC_RdTagStat);
+    NOTE(cnt(c, MFC_RdTagStat) == 0, "rchcnt(MFC_RdTagStat) stays 1 after the status is read (hardware: 0 until the next WrTagUpdate)");
+
+    /* Tag-group status update event (Tg, 0x1): raised when an any/all update
+     * request is satisfied, with the event enabled. */
+    TEST("mfc.tag-event");
+    wr(c, SPU_WrEventMask, 0x1);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    mfc(c, MFC_GET_CMD, 0x6000, EA_BUF, 16, 3);
+    wr(c, MFC_WrTagMask, 1u << 3); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 1);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x1);
+    CHECK_EQ(rd(c, MFC_RdTagStat), 1u << 3);
+    wr(c, SPU_WrEventAck, 0x1);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    wr(c, SPU_WrEventMask, 0);
+    free_ctx(c);
+}
