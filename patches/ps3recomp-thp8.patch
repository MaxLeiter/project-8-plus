+  const tick = () => mc.port2.postMessage(0);
+  mc.port1.onmessage = () => setTimeout(tick, 1);
+  setTimeout(tick, 1);
+  console.log(`[page] hirestimer: a 1 ms timer stays pending on the main thread (${hiresQ === "1" ? "?hirestimer=1" : (navigator.hardwareConcurrency || 0) + " logical cores"})`);
