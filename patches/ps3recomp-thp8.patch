+def _vshift(left, octet):
+    def sem(s, f):
+        a = int.from_bytes(s.vr[f.ra], "big")
+        vb = s.vr[f.rb]
+        if octet:
+            sh = ((vb[15] >> 3) & 15) * 8
+        else:
+            sh = vb[15] & 7
+            if any((x & 7) != sh for x in vb):
+                # the ISA requires every byte's shift count to agree
+                s.dontcare(("vr", f.rt), (1 << 128) - 1)
+        r = (a << sh) if left else (a >> sh)
+        s.set_v(f.rt, (r & ((1 << 128) - 1)).to_bytes(16, "big"))
+    return sem
+
+
+def _uniform_shift(s, f, rng, ea):
+    """vsl/vsr require every byte of vB to hold the same 3-bit count; make it
+    so most of the time (the inconsistent case is undefined)."""
+    if rng.random() < 0.85:
+        n = rng.randrange(8)
+        s.vr[f.rb] = bytes((x & ~7) | n for x in s.vr[f.rb])
+
+
+add_spec("vsl", "VX", 4, 452, _vshift(True, False), setup=_uniform_shift, tags=VMX)
+add_spec("vsr", "VX", 4, 708, _vshift(False, False), setup=_uniform_shift, tags=VMX)
+vx("vslo", 1036, _vshift(True, True))
+vx("vsro", 1100, _vshift(False, True))
+
