+    OP_ILLEGAL = 0,
+#define X(n, v, m, f) OP_##n,
+    SPU_REF_OPS(X)
+#undef X
+    OP_COUNT
+};
+static const char* const op_name[OP_COUNT] = {
+    "",
+#define X(n, v, m, f) #n,
+    SPU_REF_OPS(X)
+#undef X
+};
+static const unsigned char op_fmt[OP_COUNT] = {
+    F_RR,
+#define X(n, v, m, f) f,
+    SPU_REF_OPS(X)
+#undef X
+};
+static uint16_t op_table[2048];
+static int op_table_ready;
+
+static void build_table(void)
+{
+    static const struct { uint16_t op, val; uint8_t magn; } ent[] = {
+#define X(n, v, m, f) { OP_##n, v, m },
+        SPU_REF_OPS(X)
+#undef X
+    };
+    memset(op_table, 0, sizeof op_table);
+    for (unsigned k = 0; k < sizeof ent / sizeof ent[0]; k++)
+        for (unsigned i = 0; i < (1u << ent[k].magn); i++)
+            op_table[(ent[k].val << ent[k].magn) | i] = ent[k].op;
+    op_table_ready = 1;
+}
+static int decode(uint32_t insn)
+{
+    if (!op_table_ready) build_table();
+    return op_table[insn >> 21];
+}
+
+const char* spu_ref_mnemonic(uint32_t insn)
+{
+    int op = decode(insn);
+    if (op == OP_sync && (insn & 0x00100000u)) return "syncc";
+    return op_name[op];
+}
+
+/* ---------------------------------------------------------------------------
+ * Big-endian quadword helpers
+ * ------------------------------------------------------------------------ */
+typedef struct { uint8_t b[16]; } qw;
+
+static inline uint32_t gw(const qw* q, int i) {
+    const uint8_t* p = q->b + 4 * i;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static inline void sw(qw* q, int i, uint32_t v) {
+    uint8_t* p = q->b + 4 * i;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static inline uint16_t gh(const qw* q, int i) { return (uint16_t)((q->b[2 * i] << 8) | q->b[2 * i + 1]); }
+static inline void sh(qw* q, int i, uint16_t v) { q->b[2 * i] = (uint8_t)(v >> 8); q->b[2 * i + 1] = (uint8_t)v; }
+static inline uint64_t gd(const qw* q, int i) { return ((uint64_t)gw(q, 2 * i) << 32) | gw(q, 2 * i + 1); }
+static inline void sd(qw* q, int i, uint64_t v) { sw(q, 2 * i, (uint32_t)(v >> 32)); sw(q, 2 * i + 1, (uint32_t)v); }
+static inline qw zero_qw(void) { qw r; memset(&r, 0, sizeof r); return r; }
+static inline qw pref_qw(uint32_t v) { qw r = zero_qw(); sw(&r, 0, v); return r; }
+
+static inline int32_t sext(uint32_t v, int bits) {
+    uint32_t m = 1u << (bits - 1);
+    v &= (bits == 32) ? 0xFFFFFFFFu : ((1u << bits) - 1);
+    return (int32_t)((v ^ m) - m);
+}
+static inline uint32_t mask_lsa(uint32_t a) { return a & 0x3FFF0u; }
+static inline uint32_t mask_br(uint32_t a) { return a & 0x3FFFCu; }
+
+static int clz32(uint32_t x) { int n = 0; if (!x) return 32; while (!(x & 0x80000000u)) { x <<= 1; n++; } return n; }
+static int blen64(uint64_t x) { int n = 0; while (x) { n++; x >>= 1; } return n; }
+static int blen128(u128x x) {
+    uint64_t hi = (uint64_t)(x >> 64);
+    return hi ? 64 + blen64(hi) : blen64((uint64_t)x);
+}
+
+/* ---------------------------------------------------------------------------
+ * Exact two-term sum. A term is (-1)^s * m * 2^e. The result mantissa is
+ * normalised so the larger term's MSB sits at bit 124; a non-zero part of the
+ * smaller term that fell below bit 0 is folded in as described below, which
+ * keeps both truncation and round-to-nearest exact (the folded remainder is
+ * strictly less than one unit and the rounding point is >= 72 bits higher).
+ * ------------------------------------------------------------------------ */
+typedef struct { int s; u128x m; int e; } xterm;
+
+static void xsum(xterm a, xterm b, int* rs, u128x* rm, int* re)
+{
+    if (a.m == 0) { *rs = b.s; *rm = b.m; *re = b.e; return; }
+    if (b.m == 0) { *rs = a.s; *rm = a.m; *re = a.e; return; }
+    int la = blen128(a.m), lb = blen128(b.m);
+    if (b.e + lb > a.e + la) { xterm t = a; a = b; b = t; int tl = la; la = lb; lb = tl; }
+    int shl = 125 - la;                     /* a's MSB -> bit 124 */
+    u128x A = a.m << shl;
+    int E = a.e - shl;
+    int d = b.e - E;
+    u128x B; int sticky = 0;
+    if (d >= 0) {
+        B = b.m << d;                       /* b's MSB <= bit 124: fits */
+    } else if (-d >= 128) {
+        B = 0; sticky = 1;
+    } else {
+        B = b.m >> (-d);
+        sticky = ((B << (-d)) != b.m);
+    }
+    if (a.s == b.s) {
+        /* Dropped bits cannot carry into the kept ones, but they still make
+         * the value strictly larger: the exact sum lies in (A+B, A+B+1), so
+         * fold a non-zero remainder in as a half unit -- truncation does not
+         * see it, round-to-nearest does (a kept part that is exactly a tie
+         * must round up). Dropping it rounded dfma/dfnms ties to even. */
+        if (sticky) { *rs = a.s; *rm = ((A + B) << 1) | 1; *re = E - 1; return; }
+        *rs = a.s; *rm = A + B; *re = E; return;
+    }
+    u128x S; int s;
+    if (B > A) { S = B - A; s = b.s; }      /* only possible when sticky == 0 */
+    else       { S = A - B; s = a.s; }
+    if (sticky) { S = (S << 1) - 1; E -= 1; }   /* exact value lies in (S-1, S) */
+    *rs = s; *rm = S; *re = E;
+}
+
+/* ---------------------------------------------------------------------------
+ * SPU single precision (extended range, truncating, no denormals)
+ * ------------------------------------------------------------------------ */
+static xterm sp_term(uint32_t x)
+{
+    xterm t; t.s = (int)(x >> 31);
+    uint32_t e = (x >> 23) & 0xFF;
+    if (e == 0) { t.m = 0; t.e = 0; }
+    else { t.m = (x & 0x7FFFFFu) | 0x800000u; t.e = (int)e - 150; }
+    return t;
+}
+static xterm sp_mul(xterm a, xterm b)
+{
+    xterm t; t.s = a.s ^ b.s; t.m = a.m * b.m; t.e = a.e + b.e;
+    return t;
+}
+static uint32_t sp_pack_rz(int s, u128x M, int E)
+{
+    if (M == 0) return 0;                          /* exact zero -> +0 */
+    int p = blen128(M) - 1;
+    int be = E + p + 127;
+    if (be < 1) return 0;                          /* |x| < 2^-126 -> +0 */
+    if (be > 255) return ((uint32_t)s << 31) | 0x7FFFFFFFu;   /* |x| >= 2^129 */
+    uint32_t m = (p >= 23) ? (uint32_t)(M >> (p - 23)) : (uint32_t)(M << (23 - p));
+    return ((uint32_t)s << 31) | ((uint32_t)be << 23) | (m & 0x7FFFFFu);
+}
+static uint32_t sp_add_terms(xterm a, xterm b)
+{
+    int s, E; u128x M;
+    xsum(a, b, &s, &M, &E);
+    return sp_pack_rz(s, M, E);
+}
+static uint32_t sp_fa(uint32_t a, uint32_t b) { return sp_add_terms(sp_term(a), sp_term(b)); }
+static uint32_t sp_fs(uint32_t a, uint32_t b) { return sp_add_terms(sp_term(a), sp_term(b ^ 0x80000000u)); }
+static uint32_t sp_fm(uint32_t a, uint32_t b) { xterm z = {0, 0, 0}; return sp_add_terms(sp_mul(sp_term(a), sp_term(b)), z); }
+static uint32_t sp_fma(uint32_t a, uint32_t b, uint32_t c) { return sp_add_terms(sp_mul(sp_term(a), sp_term(b)), sp_term(c)); }
+static uint32_t sp_fms(uint32_t a, uint32_t b, uint32_t c) { return sp_add_terms(sp_mul(sp_term(a), sp_term(b)), sp_term(c ^ 0x80000000u)); }
+static uint32_t sp_fnms(uint32_t a, uint32_t b, uint32_t c) { return sp_add_terms(sp_mul(sp_term(a ^ 0x80000000u), sp_term(b)), sp_term(c)); }
+
+static int64_t sp_key(uint32_t x)       /* total order of SPU single values */
+{
+    if (((x >> 23) & 0xFF) == 0) return 0;
+    int64_t m = (int64_t)(x & 0x7FFFFFFFu);
+    return (x >> 31) ? -m : m;
+}
+static uint32_t sp_mag(uint32_t x) { return (((x >> 23) & 0xFF) == 0) ? 0 : (x & 0x7FFFFFFFu); }
+
+static uint32_t sp_cflt(uint32_t x, uint32_t i8, int is_unsigned)
+{
+    uint32_t e = (x >> 23) & 0xFF;
+    int s = (int)(x >> 31);
+    uint64_t mag;
+    if (e == 0) mag = 0;
+    else {
+        uint64_t m = (x & 0x7FFFFFu) | 0x800000u;
+        int k = (int)e + 23 - (int)i8;      /* x * 2^(173-i8) = m * 2^k */
+        if (k >= 0) mag = (k > 40) ? (1ull << 63) : (m << k);
+        else        mag = (-k >= 64) ? 0 : (m >> (-k));
+    }
+    if (is_unsigned) {
+        if (s) return 0;                    /* negative -> 0 */
+        return mag > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)mag;
+    }
+    if (!s) return mag > 0x7FFFFFFFull ? 0x7FFFFFFFu : (uint32_t)mag;
+    if (mag >= 0x80000000ull) return 0x80000000u;
+    return (uint32_t)(0u - (uint32_t)mag);
+}
+static uint32_t sp_cvt_int(uint32_t n, uint32_t i8, int is_signed)
+{
+    xterm t; t.s = 0;
+    uint64_t mag = n;
+    if (is_signed && (n & 0x80000000u)) { t.s = 1; mag = (uint64_t)(0u - n); if (n == 0x80000000u) mag = 0x80000000ull; }
+    t.m = mag; t.e = (int)i8 - 155;
+    xterm z = {0, 0, 0};
+    return sp_add_terms(t, z);
+}
+
+/* Reciprocal / reciprocal-sqrt estimate fraction tables (hardware lookup
+ * tables, indexed by fraction bits 18..22 / exponent-LSB + fraction bits
+ * 18..22). The low bits of each entry carry the interpolation step that fi
+ * consumes. Same hardware data as the runtime's tables, kept here so the
+ * reference does not depend on runtime headers. */
+static const uint32_t frest_frac[32] = {
+    0x7FFBE0, 0x7F87A6, 0x70EF72, 0x708B40, 0x638B12, 0x633AEA, 0x5792C4, 0x574AA0,
+    0x4CCA7E, 0x4C9262, 0x430A44, 0x42D62A, 0x3A2E12, 0x39FDFA, 0x3215E4, 0x31F1D2,
+    0x2AA9BE, 0x2A85AC, 0x23D59A, 0x23BD8E, 0x1D8576, 0x1D8576, 0x17AD5A, 0x17AD5A,
+    0x124543, 0x124543, 0x0D392D, 0x0D392D, 0x08851A, 0x08851A, 0x041D07, 0x041D07
+};
+static const uint32_t frsqest_frac[64] = {
+    0x350160, 0x34E954, 0x2F993D, 0x2F993D, 0x2AA523, 0x2AA523, 0x26190D, 0x26190D,
+    0x21E4F9, 0x21E4F9, 0x1E00E9, 0x1E00E9, 0x1A5CD9, 0x1A5CD9, 0x16F8CB, 0x16F8CB,
+    0x13CCC0, 0x13CCC0, 0x10CCB3, 0x10CCB3, 0x0E00AA, 0x0E00AA, 0x0B58A1, 0x0B58A1,
+    0x08D498, 0x08D498, 0x067491, 0x067491, 0x043089, 0x043089, 0x020C83, 0x020C83,
+    0x7FFDF4, 0x7FD1DE, 0x7859C8, 0x783DBA, 0x71559C, 0x71559C, 0x6AE57C, 0x6AE57C,
+    0x64F561, 0x64F561, 0x5F7149, 0x5F7149, 0x5A4D33, 0x5A4D33, 0x55811F, 0x55811F,
+    0x51050F, 0x51050F, 0x4CC8FE, 0x4CC8FE, 0x48D0F0, 0x48D0F0, 0x4510E4, 0x4510E4,
+    0x4180D7, 0x4180D7, 0x3E24CC, 0x3E24CC, 0x3AF4C3, 0x3AF4C3, 0x37E8BA, 0x37E8BA
+};
+static uint32_t sp_frest(uint32_t x)
+{
+    /* 1/x: biased exponent 253-e (2^(127-1) scaled), clamped to 0 once the
+     * reciprocal leaves the range; a zero operand gives the largest exponent. */
+    uint32_t e = (x >> 23) & 0xFF;
+    uint32_t re = (e == 0) ? 255u : (e >= 253 ? 0u : 253u - e);
+    return (x & 0x80000000u) | (re << 23) | frest_frac[(x >> 18) & 0x1F];
+}
+static uint32_t sp_frsqest(uint32_t x)
+{
+    /* 1/sqrt(|x|): biased exponent 190 - ceil(e/2); result is positive. */
+    uint32_t e = (x >> 23) & 0xFF;
+    uint32_t re = (e == 0) ? 255u : 190u - (e + 1) / 2;
+    return (re << 23) | frsqest_frac[(x >> 18) & 0x3F];
+}
+uint32_t spu_ref_frest(uint32_t x) { return sp_frest(x); }
+uint32_t spu_ref_frsqest(uint32_t x) { return sp_frsqest(x); }
+
+static uint32_t sp_fi(uint32_t ra, uint32_t rb)
+{
+    /* base = 1.(rb bits 9..22); step = rb[0..9] * 2^-13; y = ra[0..18] * 2^-19.
+     * result = rb sign/exponent | fraction of RZ(base - RZ(step*y)).
+     * Work in units of 2^-32. */
+    uint64_t base = (uint64_t)(0x800000u | (rb & 0x7FFC00u)) << 9;     /* * 2^-32 */
+    uint64_t p = (uint64_t)(rb & 0x3FFu) * (uint64_t)(ra & 0x7FFFFu);  /* * 2^-32 */
+    int lp = blen64(p);
+    if (lp > 24) p &= ~((1ull << (lp - 24)) - 1);                       /* RZ to 24 bits */
+    uint64_t d = base - p;                                               /* in (0.875, 2) */
+    int ld = blen64(d);                                                  /* 32 or 33 */
+    uint32_t frac = (uint32_t)(d >> (ld - 24)) & 0x7FFFFFu;              /* RZ to 24 bits */
+    return (rb & 0xFF800000u) | frac;
+}
+
+/* ---------------------------------------------------------------------------
+ * IEEE double, round-to-nearest-even, denormals flushed (DAZ + FTZ)
+ * ------------------------------------------------------------------------ */
+#define DP_QNAN 0x7FF8000000000000ull
+enum { DZERO, DNORM, DINF, DNAN };
+typedef struct { int cls; int s; uint64_t m; int e; } dpv;
+
+static dpv dp_unpack(uint64_t x)
+{
+    dpv v; v.s = (int)(x >> 63);
+    uint32_t ex = (uint32_t)(x >> 52) & 0x7FF;
+    uint64_t f = x & 0xFFFFFFFFFFFFFull;
+    v.m = 0; v.e = 0;
+    if (ex == 0x7FF) v.cls = f ? DNAN : DINF;
+    else if (ex == 0) v.cls = DZERO;               /* denormal operand -> signed zero */
+    else { v.cls = DNORM; v.m = f | (1ull << 52); v.e = (int)ex - 1075; }
+    return v;
+}
+static uint64_t dp_zero(int s) { return (uint64_t)s << 63; }
+static uint64_t dp_inf(int s) { return ((uint64_t)s << 63) | 0x7FF0000000000000ull; }
+static uint64_t dp_pack_rn(int s, u128x M, int E)
+{
+    if (M == 0) return 0;
+    int p = blen128(M) - 1;
+    int ex = E + p;
+    u128x q;
+    if (p > 52) {
+        int k = p - 52;
+        q = M >> k;
+        u128x rem = M - (q << k), half = (u128x)1 << (k - 1);
+        if (rem > half || (rem == half && (q & 1))) {
+            q++;
+            if (q >> 53) { q >>= 1; ex++; }
+        }
+    } else q = M << (52 - p);
+    if (ex > 1023) return dp_inf(s);
+    if (ex < -1022) return dp_zero(s);             /* tiny after rounding -> flushed */
+    return ((uint64_t)s << 63) | ((uint64_t)(ex + 1023) << 52) | ((uint64_t)q & 0xFFFFFFFFFFFFFull);
+}
+static uint64_t dp_repack(dpv v)  /* a normal value, exactly */
+{
+    return ((uint64_t)v.s << 63) | ((uint64_t)(v.e + 1075) << 52) | (v.m & 0xFFFFFFFFFFFFFull);
+}
+static uint64_t dp_add(uint64_t xa, uint64_t xb)
+{
+    dpv a = dp_unpack(xa), b = dp_unpack(xb);
+    if (a.cls == DNAN || b.cls == DNAN) return DP_QNAN;
+    if (a.cls == DINF && b.cls == DINF) return (a.s == b.s) ? dp_inf(a.s) : DP_QNAN;
+    if (a.cls == DINF) return dp_inf(a.s);
+    if (b.cls == DINF) return dp_inf(b.s);
+    if (a.cls == DZERO && b.cls == DZERO) return dp_zero(a.s & b.s);
+    if (a.cls == DZERO) return dp_repack(b);
+    if (b.cls == DZERO) return dp_repack(a);
+    xterm ta = { a.s, a.m, a.e }, tb = { b.s, b.m, b.e };
+    int s, E; u128x M;
+    xsum(ta, tb, &s, &M, &E);
+    if (M == 0) return 0;                          /* exact cancellation -> +0 */
+    return dp_pack_rn(s, M, E);
+}
+static uint64_t dp_mul(uint64_t xa, uint64_t xb)
+{
+    dpv a = dp_unpack(xa), b = dp_unpack(xb);
+    int s = a.s ^ b.s;
+    if (a.cls == DNAN || b.cls == DNAN) return DP_QNAN;
+    if ((a.cls == DINF && b.cls == DZERO) || (a.cls == DZERO && b.cls == DINF)) return DP_QNAN;
+    if (a.cls == DINF || b.cls == DINF) return dp_inf(s);
+    if (a.cls == DZERO || b.cls == DZERO) return dp_zero(s);
+    return dp_pack_rn(s, (u128x)a.m * b.m, a.e + b.e);
+}
+/* (negprod ? -(a*b) : a*b) + (negc ? -c : c), one rounding */
+static uint64_t dp_fma(uint64_t xa, uint64_t xb, uint64_t xc, int negprod, int negc)
+{
+    dpv a = dp_unpack(xa), b = dp_unpack(xb), c = dp_unpack(xc);
+    int sp = a.s ^ b.s ^ negprod, sc = c.s ^ negc;
+    if (a.cls == DNAN || b.cls == DNAN || c.cls == DNAN) return DP_QNAN;
+    if (a.cls == DINF || b.cls == DINF) {
+        if (a.cls == DZERO || b.cls == DZERO) return DP_QNAN;
+        if (c.cls == DINF && sc != sp) return DP_QNAN;
+        return dp_inf(sp);
+    }
+    if (c.cls == DINF) return dp_inf(sc);
+    int pzero = (a.cls == DZERO || b.cls == DZERO);
+    if (pzero && c.cls == DZERO) return dp_zero(sp & sc);
+    if (pzero) { c.s = sc; return dp_repack(c); }
+    xterm tp = { sp, (u128x)a.m * b.m, a.e + b.e };
+    if (c.cls == DZERO) return dp_pack_rn(sp, tp.m, tp.e);
+    xterm tc = { sc, c.m, c.e };
+    int s, E; u128x M;
+    xsum(tp, tc, &s, &M, &E);
+    if (M == 0) return 0;
+    return dp_pack_rn(s, M, E);
+}
+uint32_t spu_ref_fm(uint32_t a, uint32_t b) { return sp_fm(a, b); }
+uint64_t spu_ref_dfm(uint64_t a, uint64_t b) { return dp_mul(a, b); }
+
+static uint64_t dp_neg(uint64_t r) { return (r == DP_QNAN) ? r : (r ^ 0x8000000000000000ull); }
+static int dp_isnan(uint64_t x) { return dp_unpack(x).cls == DNAN; }
+static int64_t dp_key(uint64_t x)
+{
+    dpv v = dp_unpack(x);
+    if (v.cls == DZERO) return 0;
+    int64_t m = (int64_t)(x & 0x7FFFFFFFFFFFFFFFull);
+    return v.s ? -m : m;
+}
+static uint64_t dp_mag(uint64_t x) { return dp_unpack(x).cls == DZERO ? 0 : (x & 0x7FFFFFFFFFFFFFFFull); }
+
+static uint64_t sp_to_dp(uint32_t x)        /* fesd: IEEE single in, IEEE double out */
+{
+    uint32_t e = (x >> 23) & 0xFF, f = x & 0x7FFFFFu;
+    uint64_t s = (uint64_t)(x >> 31) << 63;
+    if (e == 255) return f ? DP_QNAN : (s | 0x7FF0000000000000ull);
+    if (e == 0) return s;                          /* denormal / zero -> signed zero */
+    return s | ((uint64_t)(e - 127 + 1023) << 52) | ((uint64_t)f << 29);
+}
+static uint32_t dp_to_sp(uint64_t x)        /* frds: round to nearest, IEEE single */
+{
+    dpv v = dp_unpack(x);
+    uint32_t s = (uint32_t)v.s << 31;
+    if (v.cls == DNAN) return 0x7FC00000u;
+    if (v.cls == DINF) return s | 0x7F800000u;
+    if (v.cls == DZERO) return s;
+    uint64_t q = v.m >> 29, rem = v.m & ((1ull << 29) - 1), half = 1ull << 28;
+    int ex = v.e + 52;                             /* unbiased exponent */
+    if (rem > half || (rem == half && (q & 1))) { q++; if (q >> 24) { q >>= 1; ex++; } }
+    if (ex > 127) return s | 0x7F800000u;
+    if (ex < -126) return s;                       /* tiny -> flushed to signed zero */
+    return s | ((uint32_t)(ex + 127) << 23) | ((uint32_t)q & 0x7FFFFFu);
+}
+static int dp_tsv(uint64_t x, uint32_t i7)
+{
+    uint32_t ex = (uint32_t)(x >> 52) & 0x7FF;
+    uint64_t f = x & 0xFFFFFFFFFFFFFull;
+    int neg = (int)(x >> 63);
+    int hit = 0;
+    if (ex == 0x7FF && f)               hit |= (i7 & 0x40) != 0;
+    if (ex == 0x7FF && !f && !neg)      hit |= (i7 & 0x20) != 0;
+    if (ex == 0x7FF && !f && neg)       hit |= (i7 & 0x10) != 0;
+    if (ex == 0 && !f && !neg)          hit |= (i7 & 0x08) != 0;
+    if (ex == 0 && !f && neg)           hit |= (i7 & 0x04) != 0;
+    if (ex == 0 && f && !neg)           hit |= (i7 & 0x02) != 0;
+    if (ex == 0 && f && neg)            hit |= (i7 & 0x01) != 0;
+    return hit;
+}
+
+/* ---------------------------------------------------------------------------
+ * Local store
+ * ------------------------------------------------------------------------ */
+static qw ls_read(const spu_ref_state* s, uint32_t lsa)
+{
+    qw r; memcpy(r.b, s->ls + mask_lsa(lsa), 16); return r;
+}
+static void ls_write(spu_ref_state* s, uint32_t lsa, const qw* v)
+{
+    lsa = mask_lsa(lsa);
+    memcpy(s->ls + lsa, v->b, 16);
+    if (s->nwrites < 4) s->writes[s->nwrites++] = lsa;
+}
+
+int spu_ref_mem_line(const spu_ref_state* s, uint32_t insn, uint32_t* lsa, int* is_store)
+{
+    int op = decode(insn);
+    uint32_t ra = (insn >> 7) & 0x7F, rb = (insn >> 14) & 0x7F;
+    qw A, B; memcpy(A.b, s->gpr[ra], 16); memcpy(B.b, s->gpr[rb], 16);
+    int32_t i10 = sext(insn >> 14, 10), i16 = sext(insn >> 7, 16);
+    switch (op) {
+    case OP_lqd: case OP_stqd: *lsa = mask_lsa(gw(&A, 0) + ((uint32_t)i10 << 4)); break;
+    case OP_lqx: case OP_stqx: *lsa = mask_lsa(gw(&A, 0) + gw(&B, 0)); break;
+    case OP_lqa: case OP_stqa: *lsa = mask_lsa((uint32_t)i16 << 2); break;
+    case OP_lqr: case OP_stqr: *lsa = mask_lsa(s->pc + ((uint32_t)i16 << 2)); break;
+    default: return 0;
+    }
+    *is_store = (op == OP_stqd || op == OP_stqx || op == OP_stqa || op == OP_stqr);
+    return 1;
+}
+
+int spu_ref_operand_regs(uint32_t insn, int regs[4], const char** fmt)
+{
+    int op = decode(insn);
+    int rt = insn & 0x7F, ra = (insn >> 7) & 0x7F, rb = (insn >> 14) & 0x7F;
+    switch (op_fmt[op]) {
+    case F_RRR: regs[0] = (insn >> 21) & 0x7F; regs[1] = ra; regs[2] = rb; regs[3] = rt;
+                if (fmt) *fmt = "RRR rt,ra,rb,rc"; return 4;
+    case F_RR:  regs[0] = rt; regs[1] = ra; regs[2] = rb; if (fmt) *fmt = "RR rt,ra,rb"; return 3;
+    case F_RI7: case F_RI8: case F_RI10:
+                regs[0] = rt; regs[1] = ra; if (fmt) *fmt = "RI rt,ra"; return 2;
+    default:    regs[0] = rt; if (fmt) *fmt = "RI rt"; return 1;
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Execute
+ * ------------------------------------------------------------------------ */
+static void set_int(spu_ref_state* s, uint32_t insn)
+{
+    if (insn & 0x00040000u) s->int_enable = 1;          /* E */
+    else if (insn & 0x00080000u) s->int_enable = 0;     /* D */
+}
+
+int spu_ref_step(spu_ref_state* s, const spu_ref_io* io, spu_ref_result* r)
+{
+    const uint32_t pc = s->pc & 0x3FFFCu;
+    const uint8_t* ip = s->ls + pc;
+    const uint32_t insn = ((uint32_t)ip[0] << 24) | ((uint32_t)ip[1] << 16) | ((uint32_t)ip[2] << 8) | ip[3];
+    const int op = decode(insn);
+    const int rt = insn & 0x7F, ra = (insn >> 7) & 0x7F, rb = (insn >> 14) & 0x7F;
+    const int rt4 = (insn >> 21) & 0x7F, rc = insn & 0x7F;
+    const uint32_t i7 = (insn >> 14) & 0x7F, i8 = (insn >> 14) & 0xFF;
+    const int32_t i10 = sext(insn >> 14, 10), i16 = sext(insn >> 7, 16);
+    const uint32_t i18 = (insn >> 7) & 0x3FFFF;
+    const uint32_t ui10 = (uint32_t)i10, ui16 = (uint32_t)i16 & 0xFFFF;
+
+    qw A, B, T, C, R;
+    memcpy(A.b, s->gpr[ra], 16); memcpy(B.b, s->gpr[rb], 16);
+    memcpy(T.b, s->gpr[rt], 16); memcpy(C.b, s->gpr[rc], 16);
+    R = zero_qw();
+    int dest = -1;                  /* register written with R, if any */
+    uint32_t next = (pc + 4) & 0x3FFFFu;
+    s->nwrites = 0;
+    r->kind = SPU_REF_NEXT; r->stop_code = 0;
+
+    const uint32_t a0 = gw(&A, 0), b0 = gw(&B, 0), t0 = gw(&T, 0);
+    int i;
+
+    switch (op) {
+    /* ---- control ---- */
+    case OP_stop:  r->kind = SPU_REF_STOP; r->stop_code = insn & 0x3FFF; break;
+    case OP_stopd: r->kind = SPU_REF_STOP; r->stop_code = 0x3FFF; break;
+    case OP_lnop: case OP_nop: case OP_sync: case OP_dsync:
+    case OP_hbr: case OP_hbra: case OP_hbrr: case OP_mtspr: case OP_fscrwr:
+        break;
+    case OP_mfspr: case OP_fscrrd: dest = rt; break;        /* reads as zero */
+    case OP_rdch:   R = pref_qw(io->rdch(io->user, (uint32_t)ra)); dest = rt; break;
+    case OP_rchcnt: R = pref_qw(io->rchcnt(io->user, (uint32_t)ra)); dest = rt; break;
+    case OP_wrch:   io->wrch(io->user, (uint32_t)ra, t0); break;
+
+    /* ---- immediates ---- */
+    case OP_il:   for (i = 0; i < 4; i++) sw(&R, i, (uint32_t)i16); dest = rt; break;
+    case OP_ilh:  for (i = 0; i < 8; i++) sh(&R, i, (uint16_t)ui16); dest = rt; break;
+    case OP_ilhu: for (i = 0; i < 4; i++) sw(&R, i, ui16 << 16); dest = rt; break;
+    case OP_iohl: for (i = 0; i < 4; i++) sw(&R, i, gw(&T, i) | ui16); dest = rt; break;
+    case OP_ila:  for (i = 0; i < 4; i++) sw(&R, i, i18); dest = rt; break;
+    case OP_fsmbi: for (i = 0; i < 16; i++) R.b[i] = ((ui16 >> (15 - i)) & 1) ? 0xFF : 0; dest = rt; break;
+
+    /* ---- load / store ---- */
+    case OP_lqd: R = ls_read(s, a0 + (ui10 << 4)); dest = rt; break;
+    case OP_lqx: R = ls_read(s, a0 + b0); dest = rt; break;
+    case OP_lqa: R = ls_read(s, (uint32_t)i16 << 2); dest = rt; break;
+    case OP_lqr: R = ls_read(s, pc + ((uint32_t)i16 << 2)); dest = rt; break;
+    case OP_stqd: ls_write(s, a0 + (ui10 << 4), &T); break;
+    case OP_stqx: ls_write(s, a0 + b0, &T); break;
+    case OP_stqa: ls_write(s, (uint32_t)i16 << 2, &T); break;
+    case OP_stqr: ls_write(s, pc + ((uint32_t)i16 << 2), &T); break;
+
+    /* ---- word / halfword arithmetic ---- */
+    case OP_a:   for (i = 0; i < 4; i++) sw(&R, i, gw(&A, i) + gw(&B, i)); dest = rt; break;
+    case OP_ah:  for (i = 0; i < 8; i++) sh(&R, i, (uint16_t)(gh(&A, i) + gh(&B, i))); dest = rt; break;
+    case OP_ai:  for (i = 0; i < 4; i++) sw(&R, i, gw(&A, i) + ui10); dest = rt; break;
