+    "    if (mode == 0u) return sv;\n"
+    "    uint occ = sv;\n"
+    "    if (mode == 2u) { uint t = sv / 3u; uint j = sv - t * 3u;\n"
+    "        occ = t + ((j == 0u) ? (t & 1u) : ((j == 1u) ? (1u - (t & 1u)) : 2u)); }\n"
+    "    else if (mode == 3u) { uint t = sv / 3u; uint j = sv - t * 3u; occ = (j == 0u) ? 0u : (t + j); }\n"
+    "    else if (mode == 4u) { uint q = sv / 6u; uint j = sv - q * 6u;\n"
+    "        occ = q * 4u + ((j < 3u) ? j : ((j == 3u) ? 2u : ((j == 4u) ? 3u : 0u))); }\n"
+    "    return vf_draw.y + occ;\n"
+    "}\n"
+    "float4 vf_fetch(uint k, uint vid) {\n"
+    /* No early returns: fxc fails with "internal error: argument pulled into
+     * unrelated predicate" on them once vf_fetch runs inside the attribute loop. */
+    "    uint4 at = vf_attr[k];\n"
+    "    uint e;\n"
+    "    if (at.w <= 1u) e = (vid + vf_draw.z) & 0xFFFFFu;\n"
+    "    else if ((at.z & 0x100u) != 0u) e = vid % at.w;\n"
+    "    else e = vid / at.w;\n"
