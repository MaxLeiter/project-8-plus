+/* Submit sequence pieces (ld_flush, ld_kick, the frame-set present). Deferred
+ * failures are reported through ld_dcl_take_failure() after the fence wait. */
+static HRESULT ldl_Close(void)
+{
+    if (!g_dcl.on) return g.list->lpVtbl->Close(g.list);
+    (void)ld_dcl_alloc(DCL_CLOSE, 0);
+    return S_OK;
+}
+static void ldl_ExecuteList(void)
+{
+    if (!g_dcl.on) {
+        ID3D12CommandList* lists[] = {(ID3D12CommandList*)g.list};
+        g.queue->lpVtbl->ExecuteCommandLists(g.queue, 1, lists);
+        return;
+    }
+    (void)ld_dcl_alloc(DCL_EXECUTE, 0);
+}
+static HRESULT ldl_Signal(UINT64 v)
+{
+    if (!g_dcl.on) return g.queue->lpVtbl->Signal(g.queue, g.fence, v);
+    DCL_PUT(dcl_signal, DCL_SIGNAL); o_->fence = g.fence; o_->value = v;
+    ld_dcl_publish();
+    return S_OK;
+}
+/* allocator Reset (reset_alloc) + list Reset onto alloc */
+static void ldl_ResetList(ID3D12CommandAllocator* alloc, int reset_alloc)
+{
+    if (!g_dcl.on) {
+        if (reset_alloc) alloc->lpVtbl->Reset(alloc);
+        g.list->lpVtbl->Reset(g.list, alloc, NULL);
+        return;
+    }
+    DCL_PUT(dcl_reset, DCL_RESET); o_->alloc = alloc; o_->reset_alloc = (UINT)reset_alloc;
+    ld_dcl_publish();
+}
+static HRESULT ld_dcl_take_failure(void)
+{
+    return (HRESULT)InterlockedExchange(&g_dcl.fail_hr, 0);
+}
+
+static void ld_dcl_fail(HRESULT hr)
+{
+    InterlockedCompareExchange(&g_dcl.fail_hr, (LONG)hr, 0);
+}
+
+static void ld_dcl_replay(const dcl_hdr* hd, int* close_failed)
+{
+    ID3D12GraphicsCommandList* L = g.list;
+    const void* p = hd + 1;
+    switch (hd->kind) {
+    case DCL_WRAP: break;
+    case DCL_BARRIER: { const dcl_barrier* o = p; L->lpVtbl->ResourceBarrier(L, o->n, o->b); } break;
+    case DCL_COPY_TEX: { const dcl_copy_tex* o = p;
+        L->lpVtbl->CopyTextureRegion(L, &o->dst, o->x, o->y, o->z, &o->src, o->has_box ? &o->box : NULL); } break;
+    case DCL_COPY_BUF: { const dcl_copy_buf* o = p;
+        L->lpVtbl->CopyBufferRegion(L, o->dst, o->doff, o->src, o->soff, o->n); } break;
+    case DCL_COPY_RES: { const dcl_copy_buf* o = p; L->lpVtbl->CopyResource(L, o->dst, o->src); } break;
+    case DCL_CLEAR_DSV: { const dcl_clear_dsv* o = p;
+        L->lpVtbl->ClearDepthStencilView(L, o->h, o->flags, o->depth, o->stencil, o->nrects,
+                                         o->nrects ? o->r : NULL); } break;
+    case DCL_CLEAR_RTV: { const dcl_clear_rtv* o = p;
+        L->lpVtbl->ClearRenderTargetView(L, o->h, o->c, o->nrects, o->nrects ? o->r : NULL); } break;
+    case DCL_PSO: { const dcl_ptr* o = p; L->lpVtbl->SetPipelineState(L, (ID3D12PipelineState*)o->p); } break;
+    case DCL_GFX_RS: { const dcl_ptr* o = p; L->lpVtbl->SetGraphicsRootSignature(L, (ID3D12RootSignature*)o->p); } break;
+    case DCL_CMP_RS: { const dcl_ptr* o = p; L->lpVtbl->SetComputeRootSignature(L, (ID3D12RootSignature*)o->p); } break;
+    case DCL_HEAPS: { const dcl_heaps* o = p; L->lpVtbl->SetDescriptorHeaps(L, o->n, o->h); } break;
+    case DCL_GFX_CBV: { const dcl_root* o = p; L->lpVtbl->SetGraphicsRootConstantBufferView(L, o->i, o->v); } break;
+    case DCL_GFX_SRV: { const dcl_root* o = p; L->lpVtbl->SetGraphicsRootShaderResourceView(L, o->i, o->v); } break;
+    case DCL_GFX_TABLE: { const dcl_root* o = p; D3D12_GPU_DESCRIPTOR_HANDLE h; h.ptr = o->v;
+        L->lpVtbl->SetGraphicsRootDescriptorTable(L, o->i, h); } break;
+    case DCL_CMP_TABLE: { const dcl_root* o = p; D3D12_GPU_DESCRIPTOR_HANDLE h; h.ptr = o->v;
+        L->lpVtbl->SetComputeRootDescriptorTable(L, o->i, h); } break;
+    case DCL_CMP_CONST: { const dcl_const* o = p;
+        L->lpVtbl->SetComputeRoot32BitConstants(L, o->i, o->n, o->data, o->off); } break;
+    case DCL_DISPATCH: { const dcl_u32s* o = p; L->lpVtbl->Dispatch(L, o->a, o->b, o->c); } break;
+    case DCL_VIEWPORTS: { const dcl_viewports* o = p; L->lpVtbl->RSSetViewports(L, o->n, o->v); } break;
+    case DCL_SCISSORS: { const dcl_rects* o = p; L->lpVtbl->RSSetScissorRects(L, o->n, o->r); } break;
+    case DCL_STENCIL_REF: { const dcl_u32s* o = p; L->lpVtbl->OMSetStencilRef(L, o->a); } break;
+    case DCL_OM_RT: { const dcl_om_rt* o = p;
+        L->lpVtbl->OMSetRenderTargets(L, o->n, o->has_rtv ? o->rtv : NULL, o->single, o->has_dsv ? &o->dsv : NULL); } break;
+    case DCL_IA_VB: { const dcl_ia_vb* o = p; L->lpVtbl->IASetVertexBuffers(L, o->start, o->n, o->v); } break;
+    case DCL_IA_TOPO: { const dcl_u32s* o = p; L->lpVtbl->IASetPrimitiveTopology(L, (D3D12_PRIMITIVE_TOPOLOGY)o->a); } break;
+    case DCL_IA_IB: { const dcl_ia_ib* o = p; L->lpVtbl->IASetIndexBuffer(L, o->has ? &o->v : NULL); } break;
+    case DCL_DRAW: { const dcl_u32s* o = p; L->lpVtbl->DrawInstanced(L, o->a, o->b, o->c, o->d); } break;
+    case DCL_DRAW_IDX: { const dcl_u32s* o = p;
+        L->lpVtbl->DrawIndexedInstanced(L, o->a, o->b, o->c, (INT)o->d, o->e); } break;
+    case DCL_CLOSE: {
+        const HRESULT hr = L->lpVtbl->Close(L);
+        if (FAILED(hr)) { *close_failed = 1; ld_dcl_fail(hr); }
+    } break;
+    case DCL_EXECUTE:
+        if (!*close_failed) {
+            ID3D12CommandList* lists[] = {(ID3D12CommandList*)L};
+            g.queue->lpVtbl->ExecuteCommandLists(g.queue, 1, lists);
+        }
+        break;
+    case DCL_SIGNAL: { const dcl_signal* o = p;
+        const HRESULT hr = g.queue->lpVtbl->Signal(g.queue, o->fence, o->value);
+        if (FAILED(hr)) ld_dcl_fail(hr); } break;
+    case DCL_RESET: { const dcl_reset* o = p;
+        if (o->reset_alloc) o->alloc->lpVtbl->Reset(o->alloc);
+        L->lpVtbl->Reset(L, o->alloc, NULL);
+        *close_failed = 0; } break;
+    default: break;
+    }
+}
+
+static DWORD LD_THREAD_CC ld_dcl_thread(LPVOID arg)
+{
+    (void)arg;
+    u64 t = (u64)g_dcl.tail;
+    int close_failed = 0;
+    /* PS3_DCL_SPIN: polls of the head before sleeping (default 256, a few us):
+     * batches arrive every ~0.2 ms, so spinning longer only burns a core. */
+    u32 spin = 256;
+    { const char* e = getenv("PS3_DCL_SPIN"); if (e) spin = (u32)strtoul(e, NULL, 0); }
+    for (;;) {
+        u64 h = (u64)g_dcl.head;
+        if (h == t) {
+            for (u32 i = 0; i < spin && (h = (u64)g_dcl.head) == t; i++) YieldProcessor();
+            if (h == t) {
+                AcquireSRWLockExclusive(&g_dcl.lock);
+                InterlockedExchange(&g_dcl.rec_sleep, 1);
+                while ((h = (u64)InterlockedCompareExchange64(&g_dcl.head, 0, 0)) == t)
+                    SleepConditionVariableSRW(&g_dcl.cv_rec, &g_dcl.lock, 50, 0);
+                InterlockedExchange(&g_dcl.rec_sleep, 0);
+                ReleaseSRWLockExclusive(&g_dcl.lock);
+            }
+        }
+        MemoryBarrier();   /* acquire: the records below head are complete */
+        u32 n = 0;
+        while (t < h) {
+            const dcl_hdr* hd = (const dcl_hdr*)(g_dcl.ring + (t & (DCL_RING_BYTES - 1u)));
+            if (hd->kind == DCL_EXIT) {
+                t += hd->bytes;
+                InterlockedExchange64(&g_dcl.tail, (LONG64)t);
+                AcquireSRWLockExclusive(&g_dcl.lock);
+                WakeAllConditionVariable(&g_dcl.cv_prod);
+                ReleaseSRWLockExclusive(&g_dcl.lock);
+                return 0;
+            }
+            ld_dcl_replay(hd, &close_failed);
+            t += hd->bytes;
+            if (++n == 64u) {   /* hand space back to the producer while a long batch runs */
+                n = 0;
+                InterlockedExchange64(&g_dcl.tail, (LONG64)t);
+            }
+        }
+        InterlockedExchange64(&g_dcl.tail, (LONG64)t);
+        if (InterlockedCompareExchange(&g_dcl.prod_wait, 0, 0)) {
+            AcquireSRWLockExclusive(&g_dcl.lock);
+            WakeAllConditionVariable(&g_dcl.cv_prod);
+            ReleaseSRWLockExclusive(&g_dcl.lock);
+        }
+    }
+}
+
+static int ld_dcl_allowed(void);   /* after g_ld_movie_mode / the overlay flag (below) */
+
+/* PS3_DRAW_VERIFY: direct g.list use while records are pending would be a
+ * second thread recording the list. Checked where this file records directly. */
+static void ld_dcl_check_idle(const char* where)
+{
+    if (g_ld_verify <= 0 || !g_dcl.ready) return;
+    const int idle = (u64)g_dcl.tail == g_dcl.w;
+    g_ld_vfy.checks++;
+    if (!idle) {
+        g_ld_vfy.bad++;
+        if (g_ld_vfy.said++ < 32)
+            fprintf(stderr, "[perf-draw] VERIFY MISMATCH frame %u: direct list use with %llu record bytes pending (%s)\n",
+                    g_ld_frames, (unsigned long long)(g_dcl.w - (u64)g_dcl.tail), where);
+    }
+}
+
+/* Frame boundary (rsx_live_draw_present, after the frame's submit): drain, then
+ * take the switch (PS3_DCL / _OFF_FILE) and the environment into account. */
+static void ld_dcl_frame(void)
+{
+    ld_dcl_sync();
+    if (!g_dcl.ready && !g_dcl.movie_api && ld_switch_on(&g_ld_sw_dcl) && ld_dcl_allowed()) {
+        g_dcl.ring = (u8*)malloc(DCL_RING_BYTES);
+        if (g_dcl.ring) {
+            InitializeSRWLock(&g_dcl.lock);
+            InitializeConditionVariable(&g_dcl.cv_rec);
+            InitializeConditionVariable(&g_dcl.cv_prod);
+            g_dcl.w = g_dcl.pub = 0; g_dcl.limit = DCL_RING_BYTES;
+            g_dcl.head = g_dcl.tail = 0;
+            g_dcl.thread = CreateThread(NULL, 0, ld_dcl_thread, NULL, 0, NULL);
+            g_dcl.ready = g_dcl.thread != NULL;
+            fprintf(stderr, "[dcl] deferred command list: %s\n",
+                    g_dcl.ready ? "recorder thread up" : "thread creation failed (off)");
+        }
+        if (!g_dcl.ready) g_dcl.movie_api = 1;   /* do not retry */
+    }
+    /* The recorder runs at the producer's priority (PS3_TICKER_PRIO puts the
+     * ticker at ABOVE_NORMAL): at NORMAL it queued behind the busy game threads
+     * and the frame-end drain waited for its time slice (2-7 ms per frame on a
+     * loaded machine). Followed every frame (the ticker's priority can change). */
+    if (g_dcl.ready && g_dcl.thread) {
+        static int last_prio = 0x7FFF;
+        const int prio = GetThreadPriority(GetCurrentThread());
+        if (prio != last_prio && prio != THREAD_PRIORITY_ERROR_RETURN) {
+            SetThreadPriority(g_dcl.thread, prio);
+            last_prio = prio;
+        }
+    }
+    const int want = g_dcl.ready && !g_dcl.movie_api && !g_dcl.host_req &&
+                     ld_switch_on(&g_ld_sw_dcl) && ld_dcl_allowed();
+    /* the producer is whichever thread presents (and records): re-latched every
+     * frame, so a hand-over of the recording to another thread (perf-fifo's
+     * PS3_DRAW_PAR translation thread) is followed at its first present */
+    if (want) g_dcl.producer_tid = GetCurrentThreadId();
+    g_dcl.on = want;
+    if (g_dcl.ready && g_ld_frames >= g_dcl.stat_frame + 600u) {
+        const u32 frames = g_ld_frames - g_dcl.stat_frame;
+        LARGE_INTEGER f; QueryPerformanceFrequency(&f);
+        if (frames)
+            fprintf(stderr, "[dcl] frame %u: %s; per frame %.0f records, %.1f drains (%.3f ms waiting), "
+                    "%llu ring-full waits\n", g_ld_frames, g_dcl.on ? "on" : "off",
+                    (double)g_dcl.ops / frames, (double)g_dcl.syncs / frames,
+                    (double)g_dcl.sync_qpc * 1000.0 / (double)f.QuadPart / frames,
+                    (unsigned long long)g_dcl.space_waits);
+        g_dcl.ops = g_dcl.syncs = g_dcl.sync_qpc = 0;
+        g_dcl.stat_frame = g_ld_frames;
+    }
+}
+
+/* Host-thread entry points (movie mode, host movie frames): leave DCL mode for
+ * good. The producer acknowledges at its next frame boundary. */
+static void ld_dcl_host_enter(void)
+{
+    g_dcl.movie_api = 1;
+    if (!g_dcl.on) return;
+    if (GetCurrentThreadId() == g_dcl.producer_tid) { ld_dcl_sync(); g_dcl.on = 0; return; }
+    InterlockedExchange(&g_dcl.host_req, 1);
+    for (u32 i = 0; i < 200u && *(volatile int*)&g_dcl.on; i++) Sleep(1);
+    if (*(volatile int*)&g_dcl.on)
+        fprintf(stderr, "[dcl] warning: host-thread live-draw call while the recorder is active\n");
+}
+
+static void ld_dcl_shutdown(void)
+{
+    if (!g_dcl.ready) return;
+    ld_dcl_sync();
+    g_dcl.on = 1;   /* the EXIT record goes through the ring */
+    (void)ld_dcl_alloc(DCL_EXIT, 0);
+    ld_dcl_publish();
+    if (g_dcl.thread) {
+        WaitForSingleObject(g_dcl.thread, 2000);
+        CloseHandle(g_dcl.thread);
+        g_dcl.thread = NULL;
+    }
+    g_dcl.on = 0;
+    g_dcl.ready = 0;
+}
+
+/* PS3_DRAW_SHADOW: shadow of the graphics state sink_end_impl records into
+ * g.list, so a draw skips the calls that would set what is already bound
+ * (render targets, heaps, PSO, root signature, root CBV/SRV/tables, viewport,
+ * scissor, stencil ref, vertex/index buffer, topology). Cleared at every list
+ * Reset (ld_flush, ld_kick) and after anything else records state into the
+ * list (compute resolves, the gfx/present passes, the overlay); render-target
+ * entries also fall when an RTV/DSV descriptor is rewritten (g_ld_rtv_gen:
+ * OMSetRenderTargets reads the descriptors when it is recorded). A zero
+ * address / handle never matches. */
+static struct {
+    ID3D12PipelineState* pso;
+    int heaps, rootsig, topo, vp_ok, sc_ok, sref_ok, vbv_ok, ibv_ok;
+    UINT n_rt, has_dsv;
+    SIZE_T rtv[4], dsv;
+    u32 rt_gen;
+    D3D12_GPU_VIRTUAL_ADDRESS root_va[8];      /* CBV/SRV root params 0, 4, 5, 6, 7 */
+    UINT64 table[4];                           /* descriptor-table root params 1, 2, 3 */
+    D3D12_VIEWPORT vp;
+    D3D12_RECT sc;
+    UINT sref;
+    D3D12_VERTEX_BUFFER_VIEW vbv;
+    D3D12_INDEX_BUFFER_VIEW ibv;
+} g_ld_cl;
+static u32 g_ld_rtv_gen = 1;
+static u64 g_ld_flush_n[LD_FLUSH_REASON_COUNT];   /* per reason, for the [perf-draw] stats */
+static u64 g_ld_cl_skipped, g_ld_cl_recorded;
+static void ld_cl_invalidate(void) { memset(&g_ld_cl, 0, sizeof(g_ld_cl)); }
+
+static void ld_fif_after_full_wait(void);   /* PS3_FIF (frames in flight), before the present */
+static void ld_fif_init(void);
+#if defined(PS3_WASM)
+static void ld_fif_wasm_config(void);   /* PS3_WASM_FIF_DEPTH: ring sizes, before set 0 */
+#endif
+static void ld_fif_present_flush(void);
+#if defined(PS3_WASM)
+static u32 ld_smp_ring_fill(u32* tables);   /* below, after g_ld_smpv */
+#endif
