+/* A lane of `tag` found work: wake its parked peers so they help drain it.
+ * Unlocked: racing a slot's (re)registration costs at most one spurious wake. */
+void spu_coh_watch_kick(int tag)
+{
+    for (int i = 0; i < SPU_COH_MAX_CTX; i++) {      /* armed watches (below) */
+        spu_context* c = s_coh_ctxs[i];
+        if (c && c->coh_arm_on && c->coh_arm_tag == tag && !c->coh_arm_hit) {
+            c->coh_arm_hit = 1;
+            spu_park_wake((void*)&c->coh_arm_hit);
+        }
+    }
+    if (!s_watch_n) return;
+    for (int i = 0; i < SPU_COH_MAX_WATCH; i++) {
+        if (s_watch[i].ctx && s_watch[i].tag == tag && !s_watch[i].hit) {
+            s_watch[i].hit = 1;
+            spu_park_wake(&s_watch[i].hit);
+        }
+    }
