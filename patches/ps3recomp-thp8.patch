+/* ---------------------------------------------------------------------------
+ * rsx_live_gfx.h present pass (only with PS3_GFX_SCALE != 1 or PS3_GFX_AA)
+ * -----------------------------------------------------------------------*/
+#if defined(PS3_WASM)
+/* The swap chain's current size, for the plugin API's get_display (runtime/ppu/ppu_mod_loader.cpp): it follows the
+ * canvas while the present pass is on. 0 = no swap chain yet. */
+int rsx_live_draw_backbuffer(uint32_t* w, uint32_t* h)
+{
+    if (!g.bb_w || !g.bb_h) return 0;
+    *w = g.bb_w; *h = g.bb_h;
+    return 1;
+}
+#endif
+/* Swap-chain buffers follow the window's client size, so the present pass
+ * resamples once, to the real output size (no extra DWM stretch). */
+#if !defined(RSX_LIVE_VKD3D) || defined(_WIN32)
+typedef struct { HWND self; RECT mon; int n; } ld_topmost_ctx;
+static BOOL CALLBACK ld_topmost_each(HWND w, LPARAM lp)
+{
+    ld_topmost_ctx* z = (ld_topmost_ctx*)lp;
+    if (w == z->self || !IsWindowVisible(w)) return TRUE;
+    if (!(GetWindowLongA(w, GWL_EXSTYLE) & WS_EX_TOPMOST)) return TRUE;
+    RECT r, x;
+    if (!GetWindowRect(w, &r) || !IntersectRect(&x, &r, &z->mon)) return TRUE;
+    char cls[96] = {0}; GetClassNameA(w, cls, (int)sizeof cls);
+    DWORD pid = 0; GetWindowThreadProcessId(w, &pid);
+    if (z->n < 8)
+        fprintf(stderr, "[present-env] topmost window over the monitor: class '%s' pid %lu rect %ld,%ld-%ld,%ld\n",
+                cls, (unsigned long)pid, r.left, r.top, r.right, r.bottom);
+    z->n++;
+    return TRUE;
+}
+/* rsx_live_draw_log_present_env (perf-draw capjit, read-only diagnostics): why DWM composes our frames instead of an
+ * independent flip -- window vs monitor rect, styles, foreground, swap-chain format / scaling / alpha, the output's
+ * colour space (HDR / AutoHDR), and visible uncloaked topmost windows overlapping our monitor. Logged when the swap
+ * chain follows a new window size and by host_pacing when a stats window was mostly composed (rate-limited there). */
+void rsx_live_draw_log_present_env(const char* why)
+{
+    HWND h = (HWND)g.hwnd;
+    if (!h || !g.swap) return;
+    RECT wr = {0}, cr = {0};
+    GetWindowRect(h, &wr); GetClientRect(h, &cr);
+    MONITORINFO mi; memset(&mi, 0, sizeof mi); mi.cbSize = sizeof mi;
+    HMONITOR mon = MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST);
+    GetMonitorInfoA(mon, &mi);
+    const LONG st = GetWindowLongA(h, GWL_STYLE), ex = GetWindowLongA(h, GWL_EXSTYLE);
+    const int covers = wr.left == mi.rcMonitor.left && wr.top == mi.rcMonitor.top &&
+                       wr.right == mi.rcMonitor.right && wr.bottom == mi.rcMonitor.bottom;
+    DXGI_SWAP_CHAIN_DESC1 d; memset(&d, 0, sizeof d);
+    g.swap->lpVtbl->GetDesc1(g.swap, &d);
+    fprintf(stderr, "[present-env] %s: window %ld,%ld-%ld,%ld client %ldx%ld monitor %ld,%ld-%ld,%ld (%s) style 0x%08lX "
+            "ex 0x%08lX foreground %s; swap chain %ux%u fmt %u scaling %u alpha %u effect %u flags 0x%X\n",
+            why ? why : "", wr.left, wr.top, wr.right, wr.bottom, cr.right - cr.left, cr.bottom - cr.top,
+            mi.rcMonitor.left, mi.rcMonitor.top, mi.rcMonitor.right, mi.rcMonitor.bottom,
+            covers ? "covers it exactly" : "does NOT cover it exactly", (unsigned long)st, (unsigned long)ex,
+            GetForegroundWindow() == h ? "yes" : "NO", d.Width, d.Height, (unsigned)d.Format, (unsigned)d.Scaling,
+            (unsigned)d.AlphaMode, (unsigned)d.SwapEffect, (unsigned)d.Flags);
+    IDXGIOutput* o = NULL;
+    if (SUCCEEDED(g.swap->lpVtbl->GetContainingOutput(g.swap, &o)) && o) {
+        IDXGIOutput6* o6 = NULL;
+        if (SUCCEEDED(o->lpVtbl->QueryInterface(o, &IID_IDXGIOutput6, (void**)&o6)) && o6) {
+            DXGI_OUTPUT_DESC1 od; memset(&od, 0, sizeof od);
+            if (SUCCEEDED(o6->lpVtbl->GetDesc1(o6, &od)))
+                fprintf(stderr, "[present-env] output: colour space %u (%s), %u bits per colour, max luminance %.0f nits\n",
+                        (unsigned)od.ColorSpace,
+                        od.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020 ? "HDR10 -- Windows HDR on" :
+                        od.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709 ? "SDR sRGB" : "other",
+                        (unsigned)od.BitsPerColor, (double)od.MaxLuminance);
+            o6->lpVtbl->Release(o6);
+        }
+        o->lpVtbl->Release(o);
+    }
+    ld_topmost_ctx z; z.self = h; z.mon = mi.rcMonitor; z.n = 0;
+    EnumWindows(ld_topmost_each, (LPARAM)&z);
+    if (!z.n) fprintf(stderr, "[present-env] no other visible topmost window overlaps the monitor\n");
+    fflush(stderr);
+}
+#else
+/* vkd3d (POSIX): no Win32 window/monitor API -- the read-only [present-env] check is a no-op there. */
+void rsx_live_draw_log_present_env(const char* why) { (void)why; }
+#endif
+
+static void ld_gfx_follow_window(void)
+{
+    RECT rc;
+#if defined(PS3_WASM)
+    if (!GetClientRect((HWND)g.hwnd, &rc)) return;     /* the canvas: no HWND in the browser build */
+#else
+    if (!g.hwnd || !GetClientRect((HWND)g.hwnd, &rc)) return;
+#endif
+    u32 w = (u32)(rc.right - rc.left), h = (u32)(rc.bottom - rc.top);
+    if (w < 16 || h < 16) return;                       /* minimised / hidden */
+    if (w > 16384) w = 16384;
+    if (h > 16384) h = 16384;
+#if defined(PS3_WASM)
+    if (w > 8192) w = 8192;                             /* WebGPU: 8192 per texture side */
+    if (h > 8192) h = 8192;
+#endif
+    if (w == g.bb_w && h == g.bb_h) return;
+    ld_flush(LD_FLUSH_PRESENT);                         /* GPU idle: buffers unused */
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; i++)
+        if (g.backbuf[i]) { g.backbuf[i]->lpVtbl->Release(g.backbuf[i]); g.backbuf[i] = NULL; }
+    const HRESULT hr = g.swap->lpVtbl->ResizeBuffers(
+        g.swap, LD_SWAP_BUFFERS, w, h, DXGI_FORMAT_R8G8B8A8_UNORM, g.swap_flags);   /* same flags as at creation (tearing / waitable) */
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; i++) {
+        g.swap->lpVtbl->GetBuffer(g.swap, i, &IID_ID3D12Resource, (void**)&g.backbuf[i]);
+        if (g.backbuf[i])
+            ld_dcl_sync(), g_ld_rtv_gen++, g.dev->lpVtbl->CreateRenderTargetView(g.dev, g.backbuf[i], NULL, rtv_handle(i));
+    }
+    if (SUCCEEDED(hr)) {
+        fprintf(stderr, "[gfx] swap chain %ux%u -> %ux%u (window)\n", g.bb_w, g.bb_h, w, h);
+        g.bb_w = w; g.bb_h = h;
+        rsx_live_draw_log_present_env("swap chain resized");
+    } else {
+        static u32 said = 0;
+        if (said < 4 && ++said)
+            fprintf(stderr, "[gfx] swap chain resize to %ux%u failed hr=0x%08lX\n",
+                    w, h, (unsigned long)hr);
+    }
+}
+
+/* Read back swap-chain buffer `bb` (PRESENT state) after the present pass and
+ * write it as a binary PPM: the frame exactly as shown (resampled, FXAA). */
+static void ld_gfx_dump_backbuffer(const char* path, ID3D12Resource* bb)
+{
+    const u32 width = g.bb_w, height = g.bb_h;
+    const u32 pitch = (width * 4 + 255) & ~255u;
+    const UINT64 rb_size = (UINT64)pitch * height;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = rb_size;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = bb;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    ldl_ResourceBarrier(1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = bb; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    dst.PlacedFootprint.Footprint.Width = width;
+    dst.PlacedFootprint.Footprint.Height = height;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    ldl_CopyTextureRegion(&dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    ldl_ResourceBarrier(1, &b);
+    ld_flush(LD_FLUSH_READBACK);
+    u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)rb_size};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        FILE* f = fopen(path, "wb");
+        if (f) {
+            fprintf(f, "P6\n%u %u\n255\n", width, height);
+            for (u32 y = 0; y < height; y++) {
+                const u8* row = px + (SIZE_T)y * pitch;
+                for (u32 x = 0; x < width; x++) fwrite(row + x * 4, 1, 3, f);
+            }
+            fclose(f);
+            fprintf(stderr, "[gfx] wrote %s %ux%u (presented output)\n", path, width, height);
+        }
+        D3D12_RANGE wr = {0, 0};
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+    }
+    rb->lpVtbl->Release(rb);
+}
+
+/* PS3_FIF (perf round): frames in flight. The frame-end flush used to wait for
+ * the GPU to go idle at every present (ld_flush: Close, Execute, Signal, WAIT,
+ * reset the allocator and every upload ring), so the vblank ticker sat idle for
+ * the tail of each frame's GPU work (~0.8-1.1 ms per frame in free skate with
+ * the high preset's command-list kicks) and the GPU sat idle while the next
+ * frame was walked. With frames in flight there are two sets of everything the
+ * CPU rewrites per frame -- command allocator, upload arena, vertex / index /
+ * constant / PS-constant / vertex-fetch rings, shader-visible SRV and sampler
+ * heaps, retired-texture list -- and the present submits its list without
+ * waiting, then switches to the other set after waiting only for THAT set's
+ * previous frame (normally long finished). Everything else is unchanged: ld_flush
+ * (ring full, readback, retire queue full, guest reference sync, window resize,
+ * shutdown) still waits for ALL work, which covers both sets. The set swap
+ * rebinds the g.* pointers, so every ring user and capacity check works on the
+ * current set exactly as before; the per-frame epochs (cb gen, SRV/PS-constant
+ * table reuse) are bumped at the swap. Off (one set, the old synchronous present):
+ * PS3_FIF=0, or live with PS3_FIF_OFF_FILE=<path> (stays on the current set). The
+ * live overlay (rsx_live_overlay.c) and the movie compositor keep the old path. */
+typedef struct {
+    ID3D12CommandAllocator* alloc;
+    ID3D12Resource *upload, *vb, *ib, *cb, *vf_cb, *ps_cb;
+    u8 *upload_mapped, *vb_mapped, *cb_mapped, *vf_cb_mapped, *ps_cb_mapped;
+    u32* ib_mapped;
+    ID3D12DescriptorHeap *srv_heap, *smp_heap;
+    u64 fence;                                  /* last frame submitted with this set */
+    u32 n_retired;
+    ID3D12Resource* retired[MAX_RETIRED_TEXTURES];
+} ld_fif_set;
+static struct {
+    int ready;                                   /* both sets created */
+    u32 cur;
+#if defined(PS3_WASM)
+    ld_fif_set set[3];                           /* PS3_WASM_FIF_DEPTH=2: three sets (two frames in flight) */
+    u32 n;                                       /* sets in use: 2, or 3 at depth 2 */
+#else
+    ld_fif_set set[2];
+#endif
+    u64 switches, waits, wait_qpc;
+    u32 stat_frame;
+} g_fif;
+static ld_switch g_ld_sw_fif = { .name = "FIF" };
+
+static void ld_fif_save(ld_fif_set* s)
+{
+    s->alloc = g.alloc;
+    s->upload = g.upload; s->upload_mapped = g.upload_mapped;
+    s->vb = g.vb; s->vb_mapped = g.vb_mapped;
+    s->ib = g.ib; s->ib_mapped = g.ib_mapped;
+    s->cb = g.cb; s->cb_mapped = g.cb_mapped;
+    s->vf_cb = g.vf_cb; s->vf_cb_mapped = g.vf_cb_mapped;
+    s->ps_cb = g.ps_cb; s->ps_cb_mapped = g.ps_cb_mapped;
+    s->srv_heap = g.srv_heap; s->smp_heap = g.smp_heap;
+}
+static void ld_fif_load(const ld_fif_set* s)
+{
+    g.alloc = s->alloc;
+    g.upload = s->upload; g.upload_mapped = s->upload_mapped;
+    g.vb = s->vb; g.vb_mapped = s->vb_mapped;
+    g.ib = s->ib; g.ib_mapped = s->ib_mapped;
+    g.cb = s->cb; g.cb_mapped = s->cb_mapped;
+    g.vf_cb = s->vf_cb; g.vf_cb_mapped = s->vf_cb_mapped;
+    g.ps_cb = s->ps_cb; g.ps_cb_mapped = s->ps_cb_mapped;
+    g.srv_heap = s->srv_heap; g.smp_heap = s->smp_heap;
+}
+static void ld_fif_release_retired(ld_fif_set* s)
+{
+    for (u32 i = 0; i < s->n_retired; i++) ld_tex_final_release(s->retired[i]);   /* PS3_TEXPOOL */
+    s->n_retired = 0;
+}
+/* ld_flush waited for every submitted list: the other set's frame is done too. */
+static void ld_fif_after_full_wait(void)
+{
+#if defined(PS3_WASM)
+    if (g_fif.ready)
+        for (u32 i = 0; i < g_fif.n; i++)
+            if (i != g_fif.cur) ld_fif_release_retired(&g_fif.set[i]);
+#else
+    if (g_fif.ready) ld_fif_release_retired(&g_fif.set[g_fif.cur ^ 1u]);
+#endif
+}
+
+#if defined(PS3_WASM)
+/* PS3_WASM_FIF_DEPTH (browser build): how many frames the GPU side may still be working on while the next one is
+ * recorded. 1 (default) = the two sets above: the present waits for frame N-1. 2 = three sets used round-robin: the
+ * present waits only for frame N-2, so frame N-1 and N are in flight while N+1 is recorded. Every set owns all its
+ * CPU-written memory (command allocator, upload arena, vertex / index / constant / vertex-fetch / pixel-constant
+ * rings, shader-visible SRV and sampler heaps, retired textures), and a set is reused only after the fence of the
+ * frame that last used it (ld_fif_present_flush); the device worker copies UPLOAD data while processing a frame's
+ * operations, which precede that frame's fence. Depth 2 halves the vertex / index / constant rings per set (from the
+ * 32:9 high-water: vtx 8.6/64 MB, idx 1.5/16, vconst 3.8/33, pconst 0.5/33) so three sets need less host heap than
+ * two did. Called once at init, before set 0 exists. */
+static int g_ld_fif_depth = 1;
+static void ld_fif_wasm_config(void)
+{
+    const char* e = getenv("PS3_WASM_FIF_DEPTH");
+    g_ld_fif_depth = (e && e[0] == '2' && !e[1] && ld_switch_on(&g_ld_sw_fif)) ? 2 : 1;
+    if (g_ld_fif_depth == 2) {
+        g_ld_rs_vb = 32u * 1024u * 1024u;
+        g_ld_rs_ib = 8u * 1024u * 1024u;
+        g_ld_rs_cb = CB_BLOCK_ALIGNED * (SRV_RING_TABLES / 2u);
+    }
+}
+#endif
+
+static ID3D12Resource* ld_fif_upload_buffer(UINT64 bytes, u8** mapped)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = bytes;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* r = NULL;
+    D3D12_RANGE rr = {0, 0};
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&r)) || !r)
+        return NULL;
+    if (FAILED(r->lpVtbl->Map(r, 0, &rr, (void**)mapped))) { r->lpVtbl->Release(r); return NULL; }
+    return r;
+}
+
+/* Called once at init, after set 0 (the ordinary g.* resources) exists. */
+#if defined(PS3_WASM)
+static int ld_fif_create_set(ld_fif_set* s);
+static void ld_fif_init(void)
+{
+    if (!ld_switch_on(&g_ld_sw_fif)) return;
+    if (!ld_fif_create_set(&g_fif.set[1])) {
+        fprintf(stderr, "[fif] second frame set could not be created: synchronous presents (old path)\n");
+        return;   /* the partial set is never used */
+    }
+    g_fif.n = 2;
+    if (g_ld_fif_depth == 2) {
+        if (ld_fif_create_set(&g_fif.set[2])) g_fif.n = 3;
+        else fprintf(stderr, "[fif] third frame set could not be created: depth 1 (two sets)\n");
+    }
+    ld_fif_save(&g_fif.set[0]);
+    g_fif.cur = 0;
+    g_fif.ready = 1;
+    fprintf(stderr, "[fif] frames in flight: %u sets, depth %u (upload %u MB, vertex %u MB, index %u MB, "
+            "constants 2x %.1f MB per set)%s\n", g_fif.n, g_fif.n - 1u,
+            UPLOAD_SIZE >> 20, VERT_BUFFER_SIZE >> 20, INDEX_BUFFER_SIZE >> 20, (double)CB_RING_BYTES / 1048576.0,
+            g_ld_sw_fif.off_file ? "; live off file" : "");
+}
+static int ld_fif_create_set(ld_fif_set* s)
+{
+    memset(s, 0, sizeof *s);
+#else
+static void ld_fif_init(void)
+{
+    if (!ld_switch_on(&g_ld_sw_fif)) return;
+    ld_fif_set* s = &g_fif.set[1];
+    memset(s, 0, sizeof *s);
+#endif
+    int ok = SUCCEEDED(g.dev->lpVtbl->CreateCommandAllocator(g.dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                       &IID_ID3D12CommandAllocator, (void**)&s->alloc)) && s->alloc;
+    u8* m = NULL;
+    if (ok) { s->upload = ld_fif_upload_buffer(UPLOAD_SIZE, &m); s->upload_mapped = m; ok = s->upload != NULL; }
+    if (ok) { s->vb = ld_fif_upload_buffer(VERT_BUFFER_SIZE, &m); s->vb_mapped = m; ok = s->vb != NULL; }
+    if (ok) { s->ib = ld_fif_upload_buffer(INDEX_BUFFER_SIZE, &m); s->ib_mapped = (u32*)m; ok = s->ib != NULL; }
+    if (ok) { s->cb = ld_fif_upload_buffer(CB_RING_BYTES, &m); s->cb_mapped = m; ok = s->cb != NULL; }
+    if (ok && g.vf_cb) {
+        s->vf_cb = ld_fif_upload_buffer((UINT64)VF_CB_BLOCK * VF_CB_BLOCKS, &m);
+        s->vf_cb_mapped = m; ok = s->vf_cb != NULL;
+    }
+    if (ok && g.ps_cb) {
+        s->ps_cb = ld_fif_upload_buffer(PS_CB_RING_BYTES, &m);
+        s->ps_cb_mapped = m; ok = s->ps_cb != NULL;
+    }
+    if (ok) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = SRV_RING_TABLES * SRV_TABLE_SIZE;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        ok = SUCCEEDED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                           (void**)&s->srv_heap)) && s->srv_heap;
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+        hd.NumDescriptors = SMP_RING_TABLES * SMP_TABLE_SIZE;
+        ok = ok && SUCCEEDED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                                 (void**)&s->smp_heap)) && s->smp_heap;
+    }
+#if defined(PS3_WASM)
+    if (!ok) {   /* give a partial set back (host heap): a third set may not fit */
+        ID3D12Resource* rs[6] = { s->upload, s->vb, s->ib, s->cb, s->vf_cb, s->ps_cb };
+        for (u32 i = 0; i < 6; i++) if (rs[i]) rs[i]->lpVtbl->Release(rs[i]);
+        if (s->srv_heap) s->srv_heap->lpVtbl->Release(s->srv_heap);
+        if (s->smp_heap) s->smp_heap->lpVtbl->Release(s->smp_heap);
+        if (s->alloc) s->alloc->lpVtbl->Release(s->alloc);
+        memset(s, 0, sizeof *s);
+    }
+    return ok;
+}
+#else
+    if (!ok) {
+        fprintf(stderr, "[fif] second frame set could not be created: synchronous presents (old path)\n");
+        return;   /* the partial set is never used */
+    }
+    ld_fif_save(&g_fif.set[0]);
+    g_fif.cur = 0;
