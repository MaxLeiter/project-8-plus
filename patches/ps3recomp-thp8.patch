+/* copy one file, keeping its times (the game dates a save slot from them); 0 = ok */
+static int sd_copy_file(const char* src, const char* dst)
+{
+#ifdef _WIN32
+    wchar_t a[SD_PATH_MAX + 8], b[SD_PATH_MAX + 8];
+    if (!sd_wide(src, a, SD_PATH_MAX + 8) || !sd_wide(dst, b, SD_PATH_MAX + 8)) return -1;
+    if (!CopyFileW(a, b, FALSE)) return -1;               /* keeps the write time and the attributes */
+    HANDLE hs = CreateFileW(a, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    HANDLE hd = CreateFileW(b, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);
+    if (hs != INVALID_HANDLE_VALUE && hd != INVALID_HANDLE_VALUE) {
+        FILETIME c, ac, wr;
+        if (GetFileTime(hs, &c, &ac, &wr)) SetFileTime(hd, &c, &ac, &wr);
+        FlushFileBuffers(hd);
+    }
+    if (hs != INVALID_HANDLE_VALUE) CloseHandle(hs);
+    if (hd != INVALID_HANDLE_VALUE) CloseHandle(hd);
+    return 0;
+#else
+    FILE* in = fopen(src, "rb");
+    if (!in) return -1;
+    FILE* out = fopen(dst, "wb");
+    if (!out) { fclose(in); return -1; }
+    char buf[65536];
+    size_t k;
+    int bad = 0;
+    while ((k = fread(buf, 1, sizeof buf, in)) > 0)
+        if (fwrite(buf, 1, k, out) != k) { bad = 1; break; }
+    if (ferror(in)) bad = 1;
+    fclose(in);
+    if (fflush(out) != 0) bad = 1;
+    if (!bad) fsync(fileno(out));
+    if (fclose(out) != 0) bad = 1;
+    struct stat st;
+    if (!bad && stat(src, &st) == 0) {
+#  if defined(__APPLE__)
+        struct timespec t[2] = { st.st_atimespec, st.st_mtimespec };
+#  else
+        struct timespec t[2] = { st.st_atim, st.st_mtim };
+#  endif
+        utimensat(AT_FDCWD, dst, t, 0);
+    }
+    return bad ? -1 : 0;
+#endif
+}
