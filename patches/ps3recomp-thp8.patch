+/*
+ * ps3recomp - tests/savedata_shared/test_savedata_shared.c
+ *
+ * The shared save folder of libs/system/cellSaveData.c (Project 8 Plus 0.9.2: one save folder for every install and
+ * version, PS3_SAVEDATA_ROOT): the host side, without a game. The test includes cellSaveData.c and runs each case in a
+ * CHILD run of this exe (save_root() resolves once per process, and the locks are per process).
+ *   1. odd paths: a root with spaces, [ ] ( ) & % ! and characters outside every ANSI code page (Ü, ø, 日本) -- a save
+ *      written through the title's file ops (whole-file writes: tmp + rename) reads back byte for byte, the save
+ *      folder is listed, PARAM.SFO round-trips
+ *   2. {Documents} expands to the known Documents folder (string only: nothing is created there)
+ *   3. import: an install's own save is COPIED into an empty shared folder (files, sizes, write times), the source
+ *      is unchanged and gets the marker; a second start does not import again (the player emptied the folder)
+ *   4. no overwrite: a shared folder that has a save keeps it byte for byte; nothing is imported, no marker
+ *   5. an interrupted import (<dir>.p3import) is not listed as a save and is finished by the next start
+ *   6. locks: while one game holds a save pass, a second game on the folder sees the session note, its save times
+ *      out (CELL_SAVEDATA_ERROR_BUSY path: savedata_pass_lock -> 0) and gets the lock once the first one ends
+ *   6b. the session lock is taken at process start (a game that never touched its saves already holds it)
+ *   7. the old layout (no PS3_SAVEDATA_ROOT, PS3_VFS_STRICT + PS3_HDD0_ROOT) is unchanged: no lock file, no import
+ *   8. a shared folder that cannot be made: that start uses the install's own savedata (PS3_SAVEDATA_IMPORT)
+ * Everything happens under SAVEDATA_TEST_DIR (default .\savedata_shared_test); nothing is deleted except inside it
+ * by the cases themselves (each case uses its own fresh sub folder).
+ *
+ * Build (zig):  zig cc -target x86_64-windows-gnu -Iinclude tests/savedata_shared/test_savedata_shared.c -lole32
+ *                  -o test_savedata_shared.exe          (Linux: -target x86_64-linux-gnu, no -lole32)
+ * Run:          test_savedata_shared.exe               exit 0 = pass
+ */
+#include "../../libs/system/cellSaveData.c"
+
+/* --- the runtime symbols cellSaveData.c links against (the host side under test needs none of them) --- */
+uint8_t* vm_base;
+ps3_guest_caller_fn g_ps3_guest_caller;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi, ppu_vm_size;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*)) { (void)nid; (void)name; (void)fn; }
+
+#ifndef _WIN32
+#  include <sys/wait.h>
+#endif
+
+static const char* g_self;
+static int g_fail;
+#define CHECK(c, ...) do { if (!(c)) { printf("  FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); g_fail = 1; } } while (0)
+
+/* ---------------------------------------------------------------- helpers (UTF-8 paths, the file layer under test) */
+static void setenv_u8(const char* k, const char* v)
+{
+#ifdef _WIN32
+    wchar_t wk[128], wv[SD_PATH_MAX];
+    MultiByteToWideChar(CP_UTF8, 0, k, -1, wk, 128);
+    MultiByteToWideChar(CP_UTF8, 0, v ? v : "", -1, wv, SD_PATH_MAX);
+    _wputenv_s(wk, wv);
+#else
+    if (v && *v) setenv(k, v, 1); else unsetenv(k);
+#endif
+}
+
+static int write_file(const char* path, const void* data, size_t n)
+{
+    FILE* f = sd_fopen(path, "wb");
+    if (!f) return -1;
+    size_t w = fwrite(data, 1, n, f);
+    return (fclose(f) == 0 && w == n) ? 0 : -1;
+}
+
+static long read_file(const char* path, char* buf, size_t cap)
+{
+    FILE* f = sd_fopen(path, "rb");
+    if (!f) return -1;
+    size_t n = fread(buf, 1, cap, f);
+    fclose(f);
+    return (long)n;
+}
+
+static int exists(const char* p) { HOST_STAT_T st; return sd_stat(p, &st) == 0; }
+
+static s64 mtime_of(const char* p)
+{
+    HOST_STAT_T st;
+    if (sd_stat(p, &st) != 0) return -1;
+#ifdef _WIN32
+    return (s64)st.st_mtime;
+#elif defined(__APPLE__)
+    return (s64)st.st_mtimespec.tv_sec;
+#else
+    return (s64)st.st_mtim.tv_sec;     /* cellSaveData.c undefines the st_mtime macro */
+#endif
+}
+
+/* a fake THP8 save: PARAM.SFO, PARAM.PFD, ICON0.PNG, the payload; payload bytes depend on `seed` */
+static void make_save(const char* dir, int seed)
+{
+    char p[SD_PATH_MAX];
+    ensure_dirs(dir);
+    snprintf(p, sizeof p, "%s/PARAM.SFO", dir);
+    write_file(p, "TITLE=THP8\nSUB_TITLE=Career\n", 28);
+    snprintf(p, sizeof p, "%s/PARAM.PFD", dir);
+    write_file(p, "5B8AB877.PRG\n", 13);
+    snprintf(p, sizeof p, "%s/ICON0.PNG", dir);
+    write_file(p, "\x89PNG-icon", 9);
+    static char payload[113152];
+    for (size_t i = 0; i < sizeof payload; i++) payload[i] = (char)(i * 31 + seed);
+    snprintf(p, sizeof p, "%s/5B8AB877.PRG", dir);
+    write_file(p, payload, sizeof payload);
+}
+
+/* 1 when every file of a is in b with the same bytes */
+static int same_files(const char* a, const char* b)
+{
+    static char x[200000], y[200000];
+    sd_dir d;
+    sd_dirent e;
+    int n = 0;
+    if (!sd_dir_open(&d, a, NULL)) return 0;
+    while (sd_dir_next(&d, &e)) {
+        if (e.is_dir) continue;
+        char pa[SD_PATH_MAX], pb[SD_PATH_MAX];
+        snprintf(pa, sizeof pa, "%s/%s", a, e.name);
+        snprintf(pb, sizeof pb, "%s/%s", b, e.name);
+        long la = read_file(pa, x, sizeof x), lb = read_file(pb, y, sizeof y);
+        if (la < 0 || la != lb || memcmp(x, y, (size_t)la)) { sd_dir_close(&d); printf("  differs: %s\n", e.name); return 0; }
+        n++;
+    }
+    sd_dir_close(&d);
+    return n > 0;
+}
+
+/* run this exe as a child: <self> child <mode> <arg>; returns its exit code */
+static int run_child(const char* mode, const char* arg)
+{
+    fflush(stdout);
+#ifdef _WIN32
+    wchar_t ws[SD_PATH_MAX], wm[64], wa[SD_PATH_MAX];
+    MultiByteToWideChar(CP_UTF8, 0, g_self, -1, ws, SD_PATH_MAX);
+    MultiByteToWideChar(CP_UTF8, 0, mode, -1, wm, 64);
+    MultiByteToWideChar(CP_UTF8, 0, arg ? arg : "-", -1, wa, SD_PATH_MAX);
+    wchar_t qs[SD_PATH_MAX + 2], qa[SD_PATH_MAX + 2];
+    swprintf(qs, SD_PATH_MAX + 2, L"\"%ls\"", ws);
+    swprintf(qa, SD_PATH_MAX + 2, L"\"%ls\"", wa);
+    return (int)_wspawnl(_P_WAIT, ws, qs, L"child", wm, qa, NULL);
+#else
+    pid_t p = fork();
+    if (p == 0) { execl(g_self, g_self, "child", mode, arg ? arg : "-", (char*)NULL); _exit(127); }
+    int st = 0;
+    waitpid(p, &st, 0);
+    return WIFEXITED(st) ? WEXITSTATUS(st) : 128;
+#endif
+}
+
+/* start a child without waiting (the lock holder) */
+static void start_child_async(const char* mode, const char* arg)
+{
+    fflush(stdout);
+#ifdef _WIN32
+    wchar_t ws[SD_PATH_MAX], wm[64], wa[SD_PATH_MAX], qs[SD_PATH_MAX + 2], qa[SD_PATH_MAX + 2];
+    MultiByteToWideChar(CP_UTF8, 0, g_self, -1, ws, SD_PATH_MAX);
+    MultiByteToWideChar(CP_UTF8, 0, mode, -1, wm, 64);
+    MultiByteToWideChar(CP_UTF8, 0, arg, -1, wa, SD_PATH_MAX);
+    swprintf(qs, SD_PATH_MAX + 2, L"\"%ls\"", ws);
+    swprintf(qa, SD_PATH_MAX + 2, L"\"%ls\"", wa);
+    _wspawnl(_P_NOWAIT, ws, qs, L"child", wm, qa, NULL);
+#else
+    if (fork() == 0) { execl(g_self, g_self, "child", mode, arg, (char*)NULL); _exit(127); }
+#endif
+}
+
+/* ---------------------------------------------------------------- children */
+static int child_oddpath(void)
+{
+    const char* root = save_root();
+    char want[SD_PATH_MAX];
+    sd_getenv("TEST_WANT_ROOT", want, sizeof want);
+    CHECK(sd_same_path(root, want), "root '%s' != '%s'", root, want);
+    CHECK(dir_exists(root), "root not created");
+    char lockp[SD_PATH_MAX];
+    snprintf(lockp, sizeof lockp, "%s/%s", root, SD_LOCK_NAME);
+    CHECK(exists(lockp), "no lock file");
+    /* a save through the title's file ops */
+    char sp[SD_PATH_MAX];
+    build_save_path(sp, sizeof sp, "BLUS30011_SAVE0");
+    static char payload[113152], back[113152];
+    for (size_t i = 0; i < sizeof payload; i++) payload[i] = (char)(i * 7 + 3);
+    CellSaveDataFileSet fs;
+    memset(&fs, 0, sizeof fs);
+    fs.fileOperation = CELL_SAVEDATA_FILEOP_WRITE;
+    fs.fileType = CELL_SAVEDATA_FILETYPE_NORMALFILE;
+    fs.fileName = "5B8AB877.PRG";
+    fs.fileSize = sizeof payload;
+    fs.fileBufSize = sizeof payload;
+    fs.fileBuf = payload;
+    CHECK(process_file_op(sp, &fs) == (s32)sizeof payload, "write failed");
+    CellSaveDataSystemFileParam prm;
+    memset(&prm, 0, sizeof prm);
+    snprintf(prm.title, sizeof prm.title, "Tony Hawk's Project 8");
+    snprintf(prm.subTitle, sizeof prm.subTitle, "Career [x] (y) & z");
+    write_param_sfo(sp, &prm);
+    CHECK(dir_has_save(sp), "no PARAM.SFO after the save");
+    CellSaveDataSystemFileParam got;
+    read_param_sfo(sp, &got);
+    CHECK(!strcmp(got.subTitle, prm.subTitle), "PARAM.SFO subtitle '%s'", got.subTitle);
+    CellSaveDataDirList dl[4];
+    CHECK(enumerate_save_dirs("BLUS30011", dl, 4) == 1 && !strcmp(dl[0].dirName, "BLUS30011_SAVE0"), "dir list");
+    CellSaveDataFileStat fl[8];
+    u32 nf = enumerate_save_files(sp, fl, 8);
+    CHECK(nf == 1 && !strcmp(fl[0].fileName, "5B8AB877.PRG") && fl[0].st_size == sizeof payload && fl[0].st_mtime > 1600000000,
+          "file list n=%u", nf);
+    memset(&fs, 0, sizeof fs);
+    fs.fileOperation = CELL_SAVEDATA_FILEOP_READ;
+    fs.fileType = CELL_SAVEDATA_FILETYPE_NORMALFILE;
+    fs.fileName = "5B8AB877.PRG";
+    fs.fileSize = sizeof back;
+    fs.fileBufSize = sizeof back;
+    fs.fileBuf = back;
+    CHECK(process_file_op(sp, &fs) == (s32)sizeof back && !memcmp(back, payload, sizeof back), "read back differs");
+    /* overwrite: crash-safe path, no .p3tmp left */
+    payload[0] ^= 0x55;
+    memset(&fs, 0, sizeof fs);
+    fs.fileOperation = CELL_SAVEDATA_FILEOP_WRITE;
+    fs.fileType = CELL_SAVEDATA_FILETYPE_NORMALFILE;
+    fs.fileName = "5B8AB877.PRG";
+    fs.fileSize = fs.fileBufSize = sizeof payload;
+    fs.fileBuf = payload;
+    CHECK(process_file_op(sp, &fs) == (s32)sizeof payload, "overwrite failed");
+    char tmpp[SD_PATH_MAX];
+    snprintf(tmpp, sizeof tmpp, "%s/5B8AB877.PRG%s", sp, SAVEDATA_TMP_SUFFIX);
+    CHECK(!exists(tmpp), ".p3tmp left");
+    return g_fail;
+}
+
+static int child_import(const char* expect)          /* expect: "yes" / "no" (count printed by the parent) */
+{
+    save_root();
+    (void)expect;
+    return g_fail;
+}
+
+static int child_hold(const char* ms)                 /* a game in the middle of a save pass */
+{
+    save_root();
+    char ready[SD_PATH_MAX];
+    sd_getenv("TEST_READY", ready, sizeof ready);
+    if (!savedata_pass_lock(1)) { printf("  holder: no lock\n"); return 2; }
+    write_file(ready, "1", 1);
+    sd_sleep_ms((unsigned)atoi(ms));
+    savedata_pass_unlock();
+    return 0;
+}
+
+static int child_idle(const char* ms)                 /* a game that has not touched its saves yet (THP8 at its title) */
+{
+    char ready[SD_PATH_MAX];
+    sd_getenv("TEST_READY", ready, sizeof ready);
+    write_file(ready, "1", 1);
+    sd_sleep_ms((unsigned)atoi(ms));
+    return 0;
+}
+
+/* 1 when another process holds the SESSION byte of <root>/.ps3recomp-savedata.lock (what the launcher checks) */
+static int session_held_by_other(const char* root)
+{
+    char p[SD_PATH_MAX];
+    snprintf(p, sizeof p, "%s/%s", root, SD_LOCK_NAME);
+#ifdef _WIN32
+    wchar_t w[SD_PATH_MAX + 8];
+    sd_wide(p, w, SD_PATH_MAX + 8);
+    HANDLE h = CreateFileW(w, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                           OPEN_EXISTING, 0, NULL);
+    if (h == INVALID_HANDLE_VALUE) return 0;
+    OVERLAPPED ov;
+    memset(&ov, 0, sizeof ov);
+    ov.Offset = SD_LOCK_SESSION;
+    int held = !LockFileEx(h, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, 0, 1, 0, &ov);
+    if (!held) UnlockFileEx(h, 0, 1, 0, &ov);
+    CloseHandle(h);
+    return held;
+#else
+    int fd = open(p, O_RDWR);
+    if (fd < 0) return 0;
+    struct flock fl;
+    memset(&fl, 0, sizeof fl);
+    fl.l_type = F_WRLCK; fl.l_whence = SEEK_SET; fl.l_start = (off_t)SD_LOCK_SESSION; fl.l_len = 1;
+    int held = fcntl(fd, F_GETLK, &fl) == 0 && fl.l_type != F_UNLCK;
+    close(fd);
+    return held;
+#endif
+}
+
+static int child_second(const char* want)             /* a second game on the folder: "busy" or "free" */
+{
+    save_root();
+    int ok = savedata_pass_lock(1);
+    printf("  second game: pass lock %s\n", ok ? "taken" : "not taken (busy)");
+    if (ok) savedata_pass_unlock();
+    return (ok == !strcmp(want, "free")) ? 0 : 1;
+}
+
+#ifndef _WIN32
+/* WSL1 (and some network file systems) do not enforce fcntl record locks between processes: case 6 is skipped there */
+static int child_probe(const char* path)
+{
+    int fd = open(path, O_RDWR);
+    struct flock fl;
+    memset(&fl, 0, sizeof fl);
+    fl.l_type = F_WRLCK; fl.l_whence = SEEK_SET; fl.l_start = (off_t)SD_LOCK_PASS; fl.l_len = 1;
+    return (fd >= 0 && fcntl(fd, F_SETLK, &fl) != 0) ? 0 : 1;     /* 0 = the parent's lock is enforced */
+}
+
+static int record_locks_enforced(const char* path)
+{
+    int fd = open(path, O_RDWR | O_CREAT, 0644);
+    struct flock fl;
+    memset(&fl, 0, sizeof fl);
+    fl.l_type = F_WRLCK; fl.l_whence = SEEK_SET; fl.l_start = (off_t)SD_LOCK_PASS; fl.l_len = 1;
+    if (fd < 0 || fcntl(fd, F_SETLK, &fl) != 0) return 0;
+    int r = run_child("probe", path);
+    close(fd);
+    return r == 0;
+}
+#endif
+
+static int child_oldlayout(void)
+{
+    const char* root = save_root();
+    char want[SD_PATH_MAX];
+    sd_getenv("TEST_WANT_ROOT", want, sizeof want);
+    CHECK(sd_same_path(root, want), "root '%s' != '%s'", root, want);
+    CHECK(!s_shared, "old layout flagged shared");
+    char lockp[SD_PATH_MAX];
+    snprintf(lockp, sizeof lockp, "%s/%s", root, SD_LOCK_NAME);
+    CHECK(!exists(lockp), "lock file in an install's own savedata");
+    CHECK(savedata_pass_lock(1) == 1, "pass lock without shared folder");
+    return g_fail;
+}
