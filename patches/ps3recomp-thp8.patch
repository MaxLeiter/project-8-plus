new file mode 100644
index 00000000..97ab3b3d
--- /dev/null
+++ b/tools/ppucheck/gen.py
@@ -0,0 +1,245 @@
+"""gen.py - random architectural states with edge-case bias, and effective-
+address steering so loads/stores land inside the harness memory window."""
+from __future__ import annotations
+
+import struct
+
+from ppcref import (MASK32, MASK64, MEMBASE, MEMSIZE, VSCR_NJ, State, F,
+                    sext)
+
+# ---------------------------------------------------------------------------
+# scalar values
+# ---------------------------------------------------------------------------
+
+E64 = (0, 1, 2, 3, MASK64, MASK64 - 1, 0x7FFFFFFFFFFFFFFF, 0x8000000000000000,
+       0xFFFFFFFF, 0xFFFFFFFE, 0x80000000, 0x7FFFFFFF, 0x100000000, 0xFFFFFFFF80000000,
+       0xFFFFFFFF7FFFFFFF, 0x00000000FFFF8000, 0x8000, 0x7FFF, 0xFFFF, 0x10000,
+       31, 32, 33, 63, 64, 65, 0x3F, 0x7F, 0x80, 0xFF, 0x20, 0x1F, 0x40,
+       0x5555555555555555, 0xAAAAAAAAAAAAAAAA, 0x0123456789ABCDEF)
+
+
+def rand_u64(rng):
+    r = rng.random()
+    if r < 0.22:
+        return rng.choice(E64)
+    if r < 0.42:
+        return sext(rng.getrandbits(32), 32) & MASK64
+    if r < 0.55:
+        return rng.getrandbits(32)
+    if r < 0.67:
+        return rng.randrange(-80, 160) & MASK64
+    if r < 0.72:                       # single bit
+        return 1 << rng.randrange(64)
+    return rng.getrandbits(64)
+
+
+def f64_bits(x):
+    return struct.unpack("<Q", struct.pack("<d", x))[0]
+
+
+def f32_bits(x):
+    return struct.unpack("<I", struct.pack("<f", x))[0]
+
+
+def f32_to_f64_bits(b32):
+    """exact widening of a binary32 bit pattern (keeps SNaN payloads)."""
+    s = b32 >> 31
+    e = (b32 >> 23) & 0xFF
+    m = b32 & 0x7FFFFF
+    if e == 0xFF:
+        return (s << 63) | (0x7FF << 52) | (m << 29)
+    if e == 0:
+        if m == 0:
+            return s << 63
+        # denormal single -> normal double
+        sh = 0
+        while not (m & 0x800000):
+            m <<= 1
+            sh += 1
+        m &= 0x7FFFFF
+        e = 1 - sh
+    return (s << 63) | ((e - 127 + 1023) << 52) | (m << 29)
+
+
+F64_SPECIAL = (
+    0x0000000000000000, 0x8000000000000000,            # +-0
+    0x7FF0000000000000, 0xFFF0000000000000,            # +-inf
+    0x7FF8000000000000, 0xFFF8000000000000,            # default-ish QNaN
+    0x7FF8000000000123, 0x7FF4000000000000,            # QNaN payload, SNaN
+    0xFFF0000000000001, 0x7FF0000000000001,            # SNaN min payload
+    0x0000000000000001, 0x800FFFFFFFFFFFFF,            # denormals
+    0x0010000000000000, 0x7FEFFFFFFFFFFFFF,            # min normal, max
+    0x3FF0000000000000, 0xBFF0000000000000,            # +-1
+    0x3FE0000000000000, 0x4330000000000000,            # 0.5, 2^52
+    0x41DFFFFFFFC00000, 0x41E0000000000000,            # 2^31-1, 2^31
+    0xC1E0000000000000, 0xC1E0000000200000,            # -2^31, -2^31-1
+    0x43DFFFFFFFFFFFFF, 0x43E0000000000000,            # < 2^63, 2^63
+    0xC3E0000000000000, 0x4000000000000000,            # -2^63, 2
+    0x36A0000000000000, 0x3810000000000000,            # single denormal range, FLT_MIN
+    0x47EFFFFFE0000000, 0x47EFFFFFF0000000,            # FLT_MAX, FLT_MAX+half ulp
+    0x3FF0000010000000, 0x3FF0000030000000,            # 1+half-ulp(single), 1+1.5ulp
+)
+
+F32_SPECIAL = (0x00000000, 0x80000000, 0x7F800000, 0xFF800000, 0x7FC00000, 0xFFC00000,
+               0x7FA00000, 0x7F800001, 0xFFBFFFFF, 0x00000001, 0x807FFFFF, 0x00800000,
+               0x7F7FFFFF, 0x3F800000, 0xBF800000, 0x3F000000, 0x4F000000, 0xCF000000,
+               0x4EFFFFFF, 0x4F800000, 0x5F000000, 0x00400000, 0x3F7FFFFF, 0x34000000)
+
+
+def rand_f64(rng):
+    r = rng.random()
+    if r < 0.18:
+        return rng.choice(F64_SPECIAL)
+    if r < 0.45:                       # a single-precision value (most game data)
+        return f32_to_f64_bits(rand_f32(rng))
+    if r < 0.55:                       # small integers / halves
+        return f64_bits(rng.randrange(-70000, 70000) / rng.choice((1, 1, 2, 4, 3)))
+    if r < 0.62:                       # big integers near the int32/int64 limits
+        return f64_bits(float(rng.choice((1, -1)) * rng.choice((2 ** 31, 2 ** 32, 2 ** 63, 2 ** 52)))
+                        + rng.choice((-1.5, -1, -0.5, 0, 0.5, 1, 1.5)))
+    if r < 0.70:                       # denormal / tiny
+        return rng.getrandbits(1) << 63 | rng.getrandbits(52) if rng.random() < 0.5 else \
+            rng.getrandbits(1) << 63 | rng.randrange(1, 60) << 52 | rng.getrandbits(52)
+    if r < 0.85:                       # moderate exponents
+        return rng.getrandbits(1) << 63 | rng.randrange(1023 - 40, 1023 + 40) << 52 | rng.getrandbits(52)
+    return rng.getrandbits(64)
+
+
+def rand_f32(rng):
+    r = rng.random()
+    if r < 0.2:
+        return rng.choice(F32_SPECIAL)
+    if r < 0.35:
+        return f32_bits(float(rng.randrange(-300, 300)) / rng.choice((1, 2, 4, 8, 3, 10)))
+    if r < 0.45:                       # denormal
+        return rng.getrandbits(1) << 31 | rng.getrandbits(23)
+    if r < 0.8:
+        return rng.getrandbits(1) << 31 | rng.randrange(127 - 30, 127 + 30) << 23 | rng.getrandbits(23)
+    return rng.getrandbits(32)
+
+
+def rand_vr(rng):
+    r = rng.random()
+    if r < 0.35:                       # 4 float lanes
+        return b"".join(rand_f32(rng).to_bytes(4, "big") for _ in range(4))
+    if r < 0.55:                       # word lanes with integer edges
+        return b"".join((rng.choice((0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x8000, 0x7FFF,
+                                     0xFFFF8000, rng.getrandbits(32), rng.randrange(-40, 40) & MASK32)))
+                        .to_bytes(4, "big") for _ in range(4))
+    if r < 0.70:                       # halfword lanes
+        return b"".join((rng.choice((0, 1, 0x7FFF, 0x8000, 0xFFFF, 0x00FF, 0xFF00, rng.getrandbits(16))))
+                        .to_bytes(2, "big") for _ in range(8))
+    if r < 0.80:                       # byte lanes
+        return bytes(rng.choice((0, 1, 0x7F, 0x80, 0xFF, rng.getrandbits(8))) for _ in range(16))
+    if r < 0.85:                       # permute-control-like bytes
+        return bytes(rng.randrange(32) for _ in range(16))
+    return rng.getrandbits(128).to_bytes(16, "big")
+
+
+# ---------------------------------------------------------------------------
+# whole states
+# ---------------------------------------------------------------------------
+
+def make_state(rng, profile="default", tags=()):
+    """tags: the spec's tags -- FPRs get the edge-biased float generator only
+    for FP tests and VRs the lane-aware one only for VMX tests (elsewhere they
+    are plain random bits: they only have to be distinct enough to catch a
+    stray write)."""
+    s = State()
+    s.gpr = [rand_u64(rng) for _ in range(32)]
+    if "fp" in tags:
+        s.fpr = [rand_f64(rng) for _ in range(32)]
+        if "single" in tags:
+            # single-precision arithmetic requires single-representable inputs
+            # (otherwise undefined): make most of them so
+            s.fpr = [f32_to_f64_bits(rand_f32(rng)) if rng.random() < 0.9 else v for v in s.fpr]
+    else:
+        raw = rng.randbytes(256)
+        s.fpr = list(struct.unpack("<32Q", raw))
+    if "vmx" in tags:
+        s.vr = [rand_vr(rng) for _ in range(32)]
+    else:
+        raw = rng.randbytes(512)
+        s.vr = [raw[i:i + 16] for i in range(0, 512, 16)]
+    s.cr = rng.getrandbits(32)
+    s.lr = rng.choice((rng.getrandbits(32) & ~3, rng.getrandbits(64), 0x00012340))
+    if profile == "full":
+        s.xer = rng.getrandbits(3) << 29 | rng.getrandbits(7)
+        s.ctr = rand_u64(rng)
+        s.fpscr = rng.getrandbits(2)            # random rounding mode only
+        s.vscr = rng.choice((0, VSCR_NJ)) | rng.getrandbits(1)
+    else:
+        # The title never sets XER[SO]/[OV] (no OE-form or mtxer in the
+        # census) and keeps FPSCR at round-to-nearest with no enables, VSCR
+        # NJ=1 (Cell power-on default), CTR < 2^32 (see KNOWN_DEVIATIONS).
+        s.xer = rng.getrandbits(1) << 29 | rng.getrandbits(7)
+        s.ctr = rng.choice((0, 1, 2, rng.getrandbits(32), rng.randrange(1, 8)))
+        s.fpscr = 0
+        s.vscr = VSCR_NJ | rng.getrandbits(1)
+    s.mem = bytearray(rng.randbytes(MEMSIZE))
+    s.resv_addr = 0
+    s.resv_val = 0
+    return s
+
+
+def _span(sp, f, s):
+    kind, size = sp.ea[0], sp.ea[1]
+    if sp.name in ("lmw", "stmw"):
+        return 4 * (32 - f.rt)
+    if sp.name in ("lswi", "stswi"):
+        return f.rb or 32
+    if sp.name in ("lswx", "stswx"):
+        return max(1, s.xer & 0x7F)
+    return size
+
+
+def place_ea(s, sp, f, rng):
+    """Steer the address registers of an ea-spec so EA hits the window.
+    Returns the EA, or None when this encoding cannot reach the window."""
+    kind, size = sp.ea[0], sp.ea[1]
+    aligned = len(sp.ea) > 2 and sp.ea[2]
+    span = _span(sp, f, s)
+    if size >= 16 or sp.name == "dcbz":
+        span = max(span, 16)
+    hi = MEMSIZE - span
+    if hi < 0:
+        return None
+    k = rng.randrange(hi + 1)
+    nat = min(size, 16)
+    if aligned or rng.random() < 0.65:
+        k -= k % nat
+    target = MEMBASE + k
+    if kind in ("D", "DS"):
+        d = f.d if kind == "D" else f.ds
+        if f.ra == 0:                   # EA = EXTS(d): only reachable if d is in the window
+            ok = MEMBASE <= d <= MEMBASE + hi and (not aligned or d % nat == 0)
+            return d if ok else None
+        s.gpr[f.ra] = (target - d) & MASK64
+        return target
+    if kind == "Xd":                    # lswi/stswi: EA = (RA|0)
+        if f.ra == 0:
+            return None
+        s.gpr[f.ra] = target
+        return target
+    # X: (RA|0) + RB
+    if f.ra == 0:
+        s.gpr[f.rb] = target
+    elif f.ra == f.rb:
+        if target & 1:
+            target -= 1
+            if target < MEMBASE:
+                target += 2
+        s.gpr[f.ra] = (target >> 1) + (rng.getrandbits(1) << 63)
+    else:
+        r = rng.random()
+        if r < 0.5:      # base pointer + small index
+            off = rng.choice((0, 0, 4, 8, 16, 32, -16, rng.randrange(0, min(64, hi + 1))))
+            s.gpr[f.ra] = (target - off) & MASK64
+            s.gpr[f.rb] = off & MASK64
+        elif r < 0.75:   # index in RA, base in RB
+            off = rng.randrange(0, 64)
+            s.gpr[f.rb] = (target - off) & MASK64
+            s.gpr[f.ra] = off
+        else:            # arbitrary RA, RB = target - RA (wraps mod 2^64)
+            s.gpr[f.rb] = (target - s.gpr[f.ra]) & MASK64
+    return target
diff --git a/tools/ppucheck/ppcref.py b/tools/ppucheck/ppcref.py
new file mode 100644
index 00000000..1e5bc7a0
--- /dev/null
+++ b/tools/ppucheck/ppcref.py
@@ -0,0 +1,531 @@
+"""ppcref.py - core of the independent Cell PPU reference model used by the
+differential lifter harness (ppucheck.py).
+
+Written from the PowerISA v2.02 Book I (the Cell BE PPU implements 2.02 plus
+the VMX/AltiVec facility, with the Cell-specific lvlx/lvrx/stvlx/stvrx) -- NOT
+from the lifter. Nothing here imports ppu_lifter or ppu_disasm: every field is
+decoded straight from the instruction word, so decoder bugs (wrong operand
+order, wrong field) show up as mismatches too.
+
+Conventions
+  * IBM bit numbering in comments (bit 0 = MSB); code uses shifts from the LSB.
+  * GPR/LR/CTR are u64. CR is the packed 32-bit register (CR0 = bits 31:28 in
+    LSB terms). XER bits: SO=1<<31, OV=1<<30, CA=1<<29, byte count = low 7.
+  * FPRs are held as raw u64 bit patterns (never as Python floats).
+  * VRs are held as 16 raw bytes in GUEST (big-endian) order, exactly how the
+    lifted code keeps ctx->vr (element 0 = bytes 0..3 for words).
+  * Memory is a small window [MEMBASE, MEMBASE+MEMSIZE) of guest memory.
+    Effective addresses are truncated to 32 bits (the runtime and RPCS3 both
+    map EA -> (u32)EA). Accesses outside the window raise MemFault.
+
+A reference instruction is a Spec (see `spec()` below) registered into SPECS.
+Its semantic function gets (state, fields) and mutates the state. To mark
+architecturally UNDEFINED output bits use s.dontcare(key, mask); to accept an
+estimate within a tolerance use s.approx[...] (see compare()).
+"""
+from __future__ import annotations
+
+import struct
+
+MASK64 = (1 << 64) - 1
+MASK32 = (1 << 32) - 1
+MEMBASE = 0x4000
+MEMSIZE = 512
+# every test word is lifted as part of a function spanning [addr - FUNC_SPAN,
+# addr + FUNC_SPAN): bc targets (+-32 KiB) are always in-function labels, an
+# I-form b beyond it is a cross-function tail jump (trampoline)
+FUNC_SPAN = 0x10000
+
+XER_SO = 1 << 31
+XER_OV = 1 << 30
+XER_CA = 1 << 29
+
+VSCR_NJ = 1 << 16
+VSCR_SAT = 1
+
+# Outcome codes (shared with the C driver).
+OUT_FALL = 0       # executed, fell through to the next instruction
+OUT_TAKEN = 1      # took the in-function branch (goto label)
+OUT_RETURN = 2     # left the function (blr-style return / tail jump)
+OUT_ICALL = 4      # flag: performed an indirect call (bcctrl / bclrl / bctr)
+OUT_SYSCALL = 8    # flag: sc
+OUT_FAULT = 16     # flag: memory access outside the test window
+
+
+class MemFault(Exception):
+    pass
+
+
+class Undefined(Exception):
+    """The encoding is an invalid/reserved form -- the case is skipped."""
+
+
+# ---------------------------------------------------------------------------
+# small helpers
+# ---------------------------------------------------------------------------
+
+def s64(v):
+    v &= MASK64
+    return v - (1 << 64) if v >> 63 else v
+
+
+def s32(v):
+    v &= MASK32
+    return v - (1 << 32) if v >> 31 else v
+
+
+def sext(v, bits):
+    v &= (1 << bits) - 1
+    return v - (1 << bits) if v >> (bits - 1) else v
+
+
+def exts32(v):            # sign-extend the low word to 64 bits (as u64)
+    return s32(v) & MASK64
+
+
+def rotl32(v, n):
+    v &= MASK32
+    n &= 31
+    return ((v << n) | (v >> (32 - n))) & MASK32 if n else v
+
+
+def rotl64(v, n):
+    v &= MASK64
+    n &= 63
+    return ((v << n) | (v >> (64 - n))) & MASK64 if n else v
+
+
+def mask64(mb, me):
+    """PowerISA MASK(mb, me) over 64 bits (IBM numbering, wraps when mb>me)."""
+    def ones_from(b):           # bits b..63 set
+        return MASK64 >> b
+    if mb <= me:
+        return ones_from(mb) & ~(ones_from(me + 1) if me < 63 else 0) & MASK64
+    # wrap: bits mb..63 and 0..me
+    return (ones_from(mb) | (MASK64 & ~(ones_from(me + 1) if me < 63 else 0))) & MASK64
+
+
+def dup32(v):              # ROTL32 operand: the low word replicated
+    v &= MASK32
+    return (v << 32) | v
+
+
+# ---------------------------------------------------------------------------
+# architectural state
+# ---------------------------------------------------------------------------
+
+REC_IN = struct.Struct("<II32Q32Q512sIIIIQQQQ%ds" % MEMSIZE)
+REC_OUT = struct.Struct("<32Q32Q512sIIIIQQQQ%dsIIQQ" % MEMSIZE)
+
+
+class State:
+    __slots__ = ("gpr", "fpr", "vr", "cr", "xer", "fpscr", "vscr", "lr", "ctr",
+                 "resv_addr", "resv_val", "mem", "outcome", "icall", "icall_lr",
+                 "dc", "approx", "notes")
+
+    def __init__(self):
+        self.gpr = [0] * 32
+        self.fpr = [0] * 32
+        self.vr = [bytes(16)] * 32
+        self.cr = 0
+        self.xer = 0
+        self.fpscr = 0
+        self.vscr = VSCR_NJ
+        self.lr = 0
+        self.ctr = 0
+        self.resv_addr = 0
+        self.resv_val = 0
+        self.mem = bytearray(MEMSIZE)
+        self.outcome = OUT_FALL
+        self.icall = 0
+        self.icall_lr = 0
+        self.dc = {}        # key -> mask of bits that are don't-care
+        self.approx = {}    # key -> checker(lifted_value) -> None | str
+        self.notes = []
+
+    def copy(self):
+        n = State()
+        n.gpr = list(self.gpr)
+        n.fpr = list(self.fpr)
+        n.vr = list(self.vr)
+        n.cr, n.xer, n.fpscr, n.vscr = self.cr, self.xer, self.fpscr, self.vscr
+        n.lr, n.ctr = self.lr, self.ctr
+        n.resv_addr, n.resv_val = self.resv_addr, self.resv_val
+        n.mem = bytearray(self.mem)
+        return n
+
+    # ---- serialization (C driver record) ----
+    def pack_in(self, fn_index):
+        return REC_IN.pack(fn_index, 0, *self.gpr, *self.fpr, b"".join(self.vr),
+                           self.cr, self.xer, self.fpscr, self.vscr,
+                           self.lr, self.ctr, self.resv_addr, self.resv_val,
+                           bytes(self.mem))
+
+    @classmethod
+    def unpack_out(cls, buf, off=0):
+        v = REC_OUT.unpack_from(buf, off)
+        s = cls()
+        s.gpr = list(v[0:32])
+        s.fpr = list(v[32:64])
+        vb = v[64]
+        s.vr = [vb[i * 16:(i + 1) * 16] for i in range(32)]
+        (s.cr, s.xer, s.fpscr, s.vscr, s.lr, s.ctr, s.resv_addr, s.resv_val) = v[65:73]
+        s.mem = bytearray(v[73])
+        s.outcome, _pad, s.icall, s.icall_lr = v[74], v[75], v[76], v[77]
+        return s
+
+    # ---- register helpers ----
+    def ca(self):
+        return (self.xer >> 29) & 1
+
+    def set_ca(self, c):
+        self.xer = (self.xer & ~XER_CA & MASK32) | (XER_CA if c else 0)
+
+    def set_ov(self, ov):
+        if ov:
+            self.xer |= XER_OV | XER_SO
+        else:
+            self.xer &= ~XER_OV & MASK32
+
+    def crf(self, bf):
+        return (self.cr >> (28 - 4 * bf)) & 0xF
+
+    def set_crf(self, bf, nib):
+        sh = 28 - 4 * bf
+        self.cr = (self.cr & ~(0xF << sh) & MASK32) | ((nib & 0xF) << sh)
+
+    def crbit(self, bi):            # IBM bit index 0..31
+        return (self.cr >> (31 - bi)) & 1
+
+    def set_crbit(self, bi, v):
+        m = 1 << (31 - bi)
+        self.cr = (self.cr & ~m & MASK32) | (m if v else 0)
+
+    def cr0_from(self, result64):
+        """Record form: CR0 = LT/GT/EQ of the signed 64-bit result, SO."""
+        r = s64(result64)
+        nib = 8 if r < 0 else 4 if r > 0 else 2
+        nib |= (self.xer >> 31) & 1
+        self.set_crf(0, nib)
+
+    # ---- vector helpers (raw BE bytes) ----
+    def vbytes(self, i):
+        return self.vr[i]
+
+    def set_v(self, i, b):
+        assert len(b) == 16
+        self.vr[i] = bytes(b)
+
+    # ---- memory (EA truncated to 32 bits) ----
+    def _off(self, ea, n):
+        a = ea & MASK32
+        if a < MEMBASE or a + n > MEMBASE + MEMSIZE:
+            raise MemFault(f"EA {a:#x}+{n}")
+        return a - MEMBASE
+
+    def load(self, ea, n):
+        o = self._off(ea, n)
+        return bytes(self.mem[o:o + n])
+
+    def store(self, ea, data):
+        o = self._off(ea, len(data))
+        self.mem[o:o + len(data)] = data
+
+    def ld_u(self, ea, n):
+        return int.from_bytes(self.load(ea, n), "big")
+
+    def st_u(self, ea, n, v):
+        self.store(ea, (v & ((1 << (8 * n)) - 1)).to_bytes(n, "big"))
+
+    # ---- don't-care / approx ----
+    def dontcare(self, key, mask):
+        self.dc[key] = self.dc.get(key, 0) | mask
+
+
+# ---------------------------------------------------------------------------
+# instruction forms: field decode + random field generation
+# ---------------------------------------------------------------------------
+
+class F:
+    """Decoded fields of one instruction word (attribute bag)."""
+    def __init__(self, w, addr):
+        self.w = w
+        self.addr = addr
+        self.op = w >> 26
+        self.rt = (w >> 21) & 31        # also RS, FRT, VD, BO, BF<<2|L, TO
+        self.ra = (w >> 16) & 31        # also BI, FRA, VA
+        self.rb = (w >> 11) & 31        # also FRB, VB, SH(5)
+        self.rc = w & 1
+        self.d = sext(w & 0xFFFF, 16)
+        self.ui = w & 0xFFFF
+        self.ds = sext(w & 0xFFFC, 16)
+        self.xo10 = (w >> 1) & 0x3FF
+        self.xo9 = (w >> 1) & 0x1FF
+        self.oe = (w >> 10) & 1
+        self.frc = (w >> 6) & 31        # A-form FRC / M-form MB
+        self.mb5 = (w >> 6) & 31
+        self.me5 = (w >> 1) & 31
+        self.xo5 = (w >> 1) & 31
+        # MD/MDS: sh = sh5 || sh0 ; mb/me = mb[5] || mb[0:4] encoded as
+        # bits 21..26 = mb[0:4] mb[5]  ->  value = ((w>>6)&31) | ((w>>5)&1)<<5
+        self.sh6 = ((w >> 11) & 31) | (((w >> 1) & 1) << 5)
+        self.mb6 = ((w >> 6) & 31) | (((w >> 5) & 1) << 5)
+        self.vc = (w >> 6) & 31
+        self.xo6 = w & 63
+        self.xo11 = w & 0x7FF
+        self.vrc = (w >> 10) & 1        # VXR-form Rc
+        self.lk = w & 1
+        self.aa = (w >> 1) & 1
+        self.bd = sext(w & 0xFFFC, 16)
+        self.li = sext(w & 0x3FFFFFC, 26)
+        self.crm = (w >> 12) & 0xFF
+        self.flm = (w >> 17) & 0xFF
+        self.spr = ((w >> 16) & 31) | (((w >> 11) & 31) << 5)
+        self.simm5 = sext((w >> 16) & 31, 5)     # vspltis*
+        self.uimm5 = (w >> 16) & 31
+        self.shb = (w >> 6) & 15                  # vsldoi
+
+
+class Spec:
+    """One reference instruction.
+
+    name   canonical mnemonic (Rc/OE variants are separate Specs: 'add.', 'addo')
+    form   decode/generate form name (see FORMS)
+    op     primary opcode
+    xo     extended opcode in the form's XO field (None for D/B/I forms)
+    sem    semantic function sem(state, F)
+    ea     None, or (kind, size): kind in 'D','DS','X' -- the generator steers
+           the address registers so the effective address lands in the window
+    valid  optional predicate valid(F) -> bool (invalid forms are not tested)
+    fixed  dict of field-name -> value forced in generated words (e.g. rc=1)
+    tags   set of tags: 'int','branch','cr','ldst','fp','vmx','atomic', ...
+    gen    optional custom word generator gen(rng) -> word
+    setup  optional state fixup setup(state, F, rng) run after the random fill
+    """
+    __slots__ = ("name", "form", "op", "xo", "sem", "ea", "valid", "fixed",
+                 "tags", "gen", "setup", "note")
+
+    def __init__(self, name, form, op, xo, sem, ea=None, valid=None, fixed=None,
+                 tags=(), gen=None, setup=None, note=""):
+        self.name, self.form, self.op, self.xo, self.sem = name, form, op, xo, sem
+        self.ea, self.valid, self.fixed = ea, valid, dict(fixed or {})
+        self.tags, self.gen, self.setup, self.note = set(tags), gen, setup, note
+
+    def __repr__(self):
+        return f"<Spec {self.name} {self.form} op={self.op} xo={self.xo}>"
+
+
+SPECS: list[Spec] = []
+
+
+def spec(name, form, op, xo=None, **kw):
+    """Decorator: register sem as the reference for `name`."""
+    def deco(fn):
+        SPECS.append(Spec(name, form, op, xo, fn, **kw))
+        return fn
+    return deco
+
+
+def add_spec(name, form, op, xo, sem, **kw):
+    s = Spec(name, form, op, xo, sem, **kw)
+    SPECS.append(s)
+    return s
+
+
+# Encoders per form. Each takes (spec, rng) and returns a word with the
+# opcode/XO/fixed bits set and the operand fields random. `fixed` overrides.
+def _put(w, val, shift, bits):
+    return (w & ~(((1 << bits) - 1) << shift)) | ((val & ((1 << bits) - 1)) << shift)
+
+
+def _reg(rng):
+    # bias to a handful of registers so aliasing (rt==ra, ...) happens often
+    return rng.choice((0, 1, 2, 3, 4, 5, 9, 31)) if rng.random() < 0.3 else rng.randrange(32)
+
+
+def _imm16(rng):
+    r = rng.random()
+    if r < 0.25:
+        return rng.choice((0, 1, 2, 0x7FFF, 0x8000, 0xFFFF, 0xFFFE, 0x10, 0x20, 0x1F, 0x3F, 0x40))
+    if r < 0.5:
+        return rng.randrange(-64, 64) & 0xFFFF
+    return rng.getrandbits(16)
+
+
+def encode(sp: Spec, rng) -> int:
+    if sp.gen:
+        return sp.gen(rng)
+    f = sp.form
+    w = sp.op << 26
+    fx = sp.fixed
+    if f in ("D", "DS"):
+        w |= _reg(rng) << 21 | _reg(rng) << 16
+        if f == "D":
+            w |= _imm16(rng)
+        else:
+            w |= (_imm16(rng) & 0xFFFC) | (sp.xo & 3)
+    elif f in ("X", "XO", "XS", "VXR", "XL", "XFX"):
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | _reg(rng) << 11
+        if f == "X" or f == "XL" or f == "XFX":
+            w |= sp.xo << 1
+        elif f == "XO":
+            w |= sp.xo << 1
+        elif f == "XS":
+            w |= sp.xo << 2 | rng.getrandbits(1) << 1
+        elif f == "VXR":
+            w |= sp.xo
+    elif f == "A":
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | _reg(rng) << 11 | _reg(rng) << 6 | sp.xo << 1
+    elif f == "M":
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | rng.randrange(32) << 11
+        w |= rng.randrange(32) << 6 | rng.randrange(32) << 1
+    elif f == "MD":
+        sh = rng.choice((0, 1, 31, 32, 63, rng.randrange(64)))
+        mb = rng.choice((0, 1, 31, 32, 63, rng.randrange(64)))
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | (sh & 31) << 11 | (sh >> 5) << 1
+        w |= (mb & 31) << 6 | (mb >> 5) << 5 | sp.xo << 2
+    elif f == "MDS":
+        mb = rng.randrange(64)
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | _reg(rng) << 11
+        w |= (mb & 31) << 6 | (mb >> 5) << 5 | sp.xo << 1
+    elif f == "VA":
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | _reg(rng) << 11 | _reg(rng) << 6 | sp.xo
+    elif f == "VX":
+        w |= _reg(rng) << 21 | _reg(rng) << 16 | _reg(rng) << 11 | sp.xo
+    elif f == "B":
+        w |= rng.getrandbits(5) << 21 | rng.getrandbits(5) << 16 | (rng.randrange(-0x40, 0x40) * 4 & 0xFFFC)
+    else:
+        raise ValueError(f"no encoder for form {f}")
+    for name, val in fx.items():
+        w = _FIELD_SETTERS[name](w, val)
+    return w & MASK32
+
+
+_FIELD_SETTERS = {
+    "rc": lambda w, v: _put(w, v, 0, 1),
+    "oe": lambda w, v: _put(w, v, 10, 1),
+    "lk": lambda w, v: _put(w, v, 0, 1),
+    "aa": lambda w, v: _put(w, v, 1, 1),
+    "vrc": lambda w, v: _put(w, v, 10, 1),
+    "rt": lambda w, v: _put(w, v, 21, 5),
+    "ra": lambda w, v: _put(w, v, 16, 5),
+    "rb": lambda w, v: _put(w, v, 11, 5),
+    "frc": lambda w, v: _put(w, v, 6, 5),
+    "b21": lambda w, v: _put(w, v, 21, 1),     # L bit of cmp (bit 10 IBM)
+    "b22": lambda w, v: _put(w, v, 22, 1),
+    "low2": lambda w, v: _put(w, v, 0, 2),
+}
+
+
+def match(sp: Spec, w: int) -> bool:
+    """Does word w encode spec sp (opcode, XO and fixed fields)?"""
+    if w >> 26 != sp.op:
+        return False
+    f = sp.form
+    if f == "DS" and (w & 3) != sp.xo:
+        return False
+    if f in ("X", "XL", "XFX") and ((w >> 1) & 0x3FF) != sp.xo:
+        return False
+    if f == "XO" and ((w >> 1) & 0x1FF) != sp.xo:
+        return False
+    if f == "XS" and ((w >> 2) & 0x1FF) != sp.xo:
+        return False
+    if f == "A" and ((w >> 1) & 31) != sp.xo:
+        return False
+    if f == "MD" and ((w >> 2) & 7) != sp.xo:
+        return False
+    if f == "MDS" and ((w >> 1) & 15) != sp.xo:
+        return False
+    if f == "VA" and (w & 63) != sp.xo:
+        return False
+    if f == "VX" and (w & 0x7FF) != sp.xo:
+        return False
+    if f == "VXR" and (w & 0x3FF) != sp.xo:
+        return False
+    for name, val in sp.fixed.items():
+        if _FIELD_SETTERS[name](w, val) != w:
+            return False
+    return True
+
+
+_BY_OP = {}
+_BY_OP_N = [0]
+
+
+def find_spec(w: int):
+    if _BY_OP_N[0] != len(SPECS):            # (re)index after registrations
+        _BY_OP.clear()
+        for sp in SPECS:
+            _BY_OP.setdefault(sp.op, []).append(sp)
+        _BY_OP_N[0] = len(SPECS)
+    for sp in _BY_OP.get(w >> 26, ()):
+        if match(sp, w):
+            return sp
+    return None
+
+
+def execute(sp: Spec, st: State, w: int, addr: int) -> State:
+    """Run the reference for word w on a COPY of st; returns the new state."""
+    s = st.copy()
+    f = F(w, addr)
+    try:
+        sp.sem(s, f)
+    except MemFault:
+        s.outcome |= OUT_FAULT
+    return s
+
+
+# ---------------------------------------------------------------------------
+# comparison
+# ---------------------------------------------------------------------------
+
+def _diff_int(key, a, b, dc, out, width=64):
+    m = ((1 << width) - 1) & ~dc.get(key, 0)
+    if (a ^ b) & m:
+        out.append((key, a, b))
+
+
+def compare(ref: State, got: State):
+    """Return a list of (key, expected, got) for every mismatching location."""
+    out = []
+    dc = ref.dc
+    for i in range(32):
+        k = ("gpr", i)
+        if k in ref.approx:
+            msg = ref.approx[k](got.gpr[i])
+            if msg:
+                out.append((k, ref.gpr[i], got.gpr[i]))
+        else:
+            _diff_int(k, ref.gpr[i], got.gpr[i], dc, out)
+    for i in range(32):
+        k = ("fpr", i)
+        if k in ref.approx:
+            if ref.approx[k](got.fpr[i]):
+                out.append((k, ref.fpr[i], got.fpr[i]))
+        else:
+            _diff_int(k, ref.fpr[i], got.fpr[i], dc, out)
+    for i in range(32):
+        k = ("vr", i)
+        a = int.from_bytes(ref.vr[i], "big")
+        b = int.from_bytes(got.vr[i], "big")
+        if k in ref.approx:
+            if ref.approx[k](got.vr[i]):
+                out.append((k, a, b))
+        else:
+            _diff_int(k, a, b, dc, out, 128)
+    for k in ("cr", "xer", "fpscr", "vscr"):
+        _diff_int(k, getattr(ref, k), getattr(got, k), dc, out, 32)
+    for k in ("lr", "ctr", "resv_addr", "resv_val"):
+        _diff_int(k, getattr(ref, k), getattr(got, k), dc, out)
+    if ref.mem != got.mem:
+        mdc = dc.get("mem", 0)
+        for i in range(MEMSIZE):
+            if ref.mem[i] != got.mem[i] and not (mdc >> i) & 1:
+                out.append((("mem", MEMBASE + i), ref.mem[i], got.mem[i]))
+                break
+    if ref.outcome != got.outcome and "outcome" not in dc:
+        out.append(("outcome", ref.outcome, got.outcome))
+    if ref.outcome & OUT_ICALL and got.outcome & OUT_ICALL:
+        _diff_int("icall", ref.icall, got.icall, dc, out)
+        _diff_int("icall_lr", ref.icall_lr, got.icall_lr, dc, out)
+    return out
