+/* The exact normalisation tables (rsx_vertex_decode_element's expressions). */
+static int ld_vf_make_lut(void)
+{
+    static float lut[RSX_VF_LUT_COUNT];
+    for (u32 i = 0; i < 256; i++) {
+        const u8 b = (u8)i;
+        lut[RSX_VF_LUT_U8 + i] = b / 255.0f;
+    }
+    for (u32 i = 0; i < 65536; i++) {
+        const s16 value = (s16)(u16)i;
+        lut[RSX_VF_LUT_S16 + i] = value / 32767.0f;
+    }
+    for (u32 i = 0; i < 2048; i++) {
+        s32 x = (s32)i; if (x & 0x400) x -= 0x800;
+        lut[RSX_VF_LUT_CMP11 + i] = (float)x / 1023.0f;
+    }
+    for (u32 i = 0; i < 1024; i++) {
+        s32 z = (s32)i; if (z & 0x200) z -= 0x400;
+        lut[RSX_VF_LUT_CMP10 + i] = (float)z / 511.0f;
+    }
+    D3D12_HEAP_PROPERTIES hp = {0};
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = sizeof(lut);
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&g_vf.lut_upload)))
+        return 0;
+    void* m = NULL; D3D12_RANGE rr = {0, 0};
+    if (FAILED(g_vf.lut_upload->lpVtbl->Map(g_vf.lut_upload, 0, &rr, &m))) return 0;
+    memcpy(m, lut, sizeof(lut));
+    g_vf.lut_upload->lpVtbl->Unmap(g_vf.lut_upload, 0, NULL);
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_vf.lut)))
+        return 0;
+    ldl_CopyBufferRegion(g_vf.lut, 0, g_vf.lut_upload, 0, sizeof(lut));
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = g_vf.lut;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    ldl_ResourceBarrier(1, &b);
+    return 1;
+}
