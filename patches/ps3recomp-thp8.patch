diff --git a/libs/input/web_xinput.h b/libs/input/web_xinput.h
new file mode 100644
index 00000000..27646d68
--- /dev/null
+++ b/libs/input/web_xinput.h
@@ -0,0 +1,74 @@
+/*
+ * ps3recomp - XInput over the browser Gamepad API (PS3_WASM builds only).
+ *
+ * cellPad.c's XInput backend (button table, PS3_PAD_MAP, deadzones, device detection for the Xbox-style prompts)
+ * runs unchanged on the web: this header supplies the few XInput names it uses, and XInputGetState reads the pad
+ * state the page writes into ps3_web_input (web_input.h; JS converts the "standard" Gamepad mapping to XInput).
+ */
+#ifndef PS3RECOMP_WEB_XINPUT_H
+#define PS3RECOMP_WEB_XINPUT_H
+
+#include <stdint.h>
+#include <string.h>
+#include "web_input.h"
+
+#ifndef ERROR_SUCCESS
+#define ERROR_SUCCESS 0u
+#endif
+#ifndef ERROR_DEVICE_NOT_CONNECTED
+#define ERROR_DEVICE_NOT_CONNECTED 1167u
+#endif
+
+#define XINPUT_GAMEPAD_DPAD_UP        0x0001
+#define XINPUT_GAMEPAD_DPAD_DOWN      0x0002
+#define XINPUT_GAMEPAD_DPAD_LEFT      0x0004
+#define XINPUT_GAMEPAD_DPAD_RIGHT     0x0008
+#define XINPUT_GAMEPAD_START          0x0010
+#define XINPUT_GAMEPAD_BACK           0x0020
+#define XINPUT_GAMEPAD_LEFT_THUMB     0x0040
+#define XINPUT_GAMEPAD_RIGHT_THUMB    0x0080
+#define XINPUT_GAMEPAD_LEFT_SHOULDER  0x0100
+#define XINPUT_GAMEPAD_RIGHT_SHOULDER 0x0200
+#define XINPUT_GAMEPAD_A              0x1000
+#define XINPUT_GAMEPAD_B              0x2000
+#define XINPUT_GAMEPAD_X              0x4000
+#define XINPUT_GAMEPAD_Y              0x8000
+
+typedef struct {
+    uint16_t wButtons;
+    uint8_t  bLeftTrigger, bRightTrigger;
+    int16_t  sThumbLX, sThumbLY, sThumbRX, sThumbRY;
+} XINPUT_GAMEPAD;
+
+typedef struct {
+    uint32_t       dwPacketNumber;
+    XINPUT_GAMEPAD Gamepad;
+} XINPUT_STATE;
+
+static inline uint32_t XInputGetState(uint32_t index, XINPUT_STATE* st)
+{
+    ps3_web_input* in = ps3_web_input_state();
+    if (index >= PS3_WEB_PADS) return ERROR_DEVICE_NOT_CONNECTED;
+    const volatile ps3_web_pad* p = &in->pads[index];
+    if (!p->connected) return ERROR_DEVICE_NOT_CONNECTED;
+    memset(st, 0, sizeof *st);
+    st->dwPacketNumber = p->seq;
+    st->Gamepad.wButtons = p->buttons;
+    st->Gamepad.bLeftTrigger = p->left_trigger;
+    st->Gamepad.bRightTrigger = p->right_trigger;
+    st->Gamepad.sThumbLX = p->lx; st->Gamepad.sThumbLY = p->ly;
+    st->Gamepad.sThumbRX = p->rx; st->Gamepad.sThumbRY = p->ry;
+    return ERROR_SUCCESS;
+}
+
+typedef struct { uint16_t wLeftMotorSpeed, wRightMotorSpeed; } XINPUT_VIBRATION;
+static inline uint32_t XInputSetState(uint32_t index, XINPUT_VIBRATION* v)
+{
+    if (index >= PS3_WEB_PADS || !v) return ERROR_DEVICE_NOT_CONNECTED;
+    ps3_web_input* in = ps3_web_input_state();
+    in->rumble[index][0] = v->wLeftMotorSpeed;
+    in->rumble[index][1] = v->wRightMotorSpeed;
+    return ERROR_SUCCESS;
+}
+
+#endif
