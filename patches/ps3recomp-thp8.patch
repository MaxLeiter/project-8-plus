+static uint32_t  s_var_pg_n[SPU_LS_SIZE >> 10], s_var_pg_cap[SPU_LS_SIZE >> 10];
+static int spu_var_pg_add(uint32_t p, uint32_t id)
+{
+    if (s_var_pg_n[p] == s_var_pg_cap[p]) {
+        uint32_t cap = s_var_pg_cap[p] ? 2 * s_var_pg_cap[p] : 8;
+        uint32_t* q = (uint32_t*)realloc(s_var_pg[p], cap * sizeof *q);
+        if (!q) return 0;
+        s_var_pg[p] = q; s_var_pg_cap[p] = cap;
+    }
+    s_var_pg[p][s_var_pg_n[p]++] = id;
+    return 1;
+}
+static int spu_var_append(uint32_t entry, uint32_t lo, uint32_t len, uint64_t hash, spu_fn fn, int legacy)
+{
+    entry &= SPU_LS_MASK & ~3u;
+    if (!fn || !len || lo > entry || entry - lo >= len || (uint64_t)lo + len > SPU_LS_SIZE)
+        return 0;
+    uint32_t b = spu_var_bucket(entry);
+    for (uint32_t n = s_var_head[b]; n; n = s_var[n - 1].next) {
+        const spu_var* v = &s_var[n - 1];
+        if (v->entry == entry && v->lo == lo && v->len == len && v->hash == hash && v->legacy == legacy)
+            return 0;                                     /* same code, lifted twice */
+    }
+    if (s_var_n >= SPU_VARIANT_MAX) {
+        static int w;
+        if (!w && ++w) fprintf(stderr, "[spu-var] registry full (%u) -- later variants dropped\n",
+                          (unsigned)SPU_VARIANT_MAX);
+        return 0;
+    }
+    spu_var* v = &s_var[s_var_n];
+    memset(v, 0, sizeof *v);
+    v->entry = entry; v->lo = lo; v->len = len; v->hash = hash; v->fn = fn;
+    v->legacy = (uint8_t)legacy;
+    v->pg_lo = (uint16_t)(lo >> 10); v->pg_hi = (uint16_t)((lo + len - 1) >> 10);
+    for (uint32_t p = v->pg_lo; p <= v->pg_hi; p++)
+        if (!spu_var_pg_add(p, s_var_n)) {               /* out of memory: not registered */
+            for (uint32_t q = v->pg_lo; q < p; q++) s_var_pg_n[q]--;
+            return 0;
+        }
+    uint32_t id1 = s_var_n + 1;
+    if (!s_var_head[b]) s_var_head[b] = id1; else s_var[s_var_tail[b] - 1].next = id1;
+    s_var_tail[b] = id1;
+    s_var_n = id1;
+    return 1;
+}
+int spu_variant_add(const spu_variant_desc* d, uint32_t n)
+{
+    int added = 0;
+    for (uint32_t i = 0; d && i < n; i++)
+        added += spu_var_append(d[i].entry, d[i].lo, d[i].len, d[i].hash, d[i].fn, 0);
+    return added;
+}
+/* Legacy registration (32-byte FNV key at the entry). */
+void spu_variant_register(uint32_t lsa, uint64_t key, spu_fn fn)
+{
+    lsa &= SPU_LS_MASK & ~3u;
+    spu_var_append(lsa, lsa, 32, key, fn, 1);
+}
+void spu_variant_get_stats(spu_variant_stats* out)
+{
+    *out = s_var_st;
+    out->registered = s_var_n;
+}
