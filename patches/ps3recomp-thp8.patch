+# ---------------------------------------------------------------------------
+# permutes, merges, splats, packs
+# ---------------------------------------------------------------------------
+
+def _vperm(s, f):
+    ab = s.vr[f.ra] + s.vr[f.rb]
+    s.set_v(f.rt, bytes(ab[c & 31] for c in s.vr[f.vc]))
+
+
+def _vsel(s, f):
+    a = int.from_bytes(s.vr[f.ra], "big")
+    b = int.from_bytes(s.vr[f.rb], "big")
+    c = int.from_bytes(s.vr[f.vc], "big")
+    s.set_v(f.rt, ((a & ~c) | (b & c)).to_bytes(16, "big"))
+
+
+def _vsldoi(s, f):
+    ab = s.vr[f.ra] + s.vr[f.rb]
+    s.set_v(f.rt, ab[f.shb:f.shb + 16])
+
+
+va("vperm", 43, _vperm)
+va("vsel", 42, _vsel)
+va("vsldoi", 44, _vsldoi, valid=lambda f: not (f.w >> 10) & 1)
+
+
+def _merge(sz, high):
+    get, put, bits = _SZ[sz]
+
+    def sem(s, f):
+        a, b = get(s.vr[f.ra]), get(s.vr[f.rb])
+        n = len(a) // 2
+        o = 0 if high else n
+        out = []
+        for i in range(n):
+            out += [a[o + i], b[o + i]]
+        s.set_v(f.rt, put(out))
+    return sem
+
+
+for _sz, _o in (("b", 0), ("h", 64), ("w", 128)):
+    vx(f"vmrgh{_sz}", 12 + _o, _merge(_sz, True))
+    vx(f"vmrgl{_sz}", 268 + _o, _merge(_sz, False))
+
+
+def _splat(sz):
+    get, put, bits = _SZ[sz]
+    n = 128 // bits
+
+    def sem(s, f):
+        v = get(s.vr[f.rb])[f.uimm5 & (n - 1)]
+        s.set_v(f.rt, put([v] * n))
+    return sem
+
+
+vx("vspltb", 524, _splat("b"), valid=lambda f: f.uimm5 < 16)
+vx("vsplth", 588, _splat("h"), valid=lambda f: f.uimm5 < 8)
+vx("vspltw", 652, _splat("w"), valid=lambda f: f.uimm5 < 4)
+
+
+def _splti(sz):
+    get, put, bits = _SZ[sz]
+    n = 128 // bits
+
+    def sem(s, f):
+        s.set_v(f.rt, put([f.simm5 & ((1 << bits) - 1)] * n))
+    return sem
+
+
+vx("vspltisb", 780, _splti("b"), fixed={"rb": 0})
+vx("vspltish", 844, _splti("h"), fixed={"rb": 0})
+vx("vspltisw", 908, _splti("w"), fixed={"rb": 0})
