+def _pack(src, mode):
+    """src 'h' or 'w'; mode um (modulo), us (unsigned in, unsigned sat),
+    ss (signed in, signed sat), su (signed in, unsigned sat)."""
+    get, _, bits = _SZ[src]
+    obits = bits // 2
+    put = fromB if src == "h" else fromH
+
+    def sem(s, f):
+        vals = get(s.vr[f.ra]) + get(s.vr[f.rb])
+        out, anys = [], False
+        for v in vals:
+            if mode == "um":
+                out.append(v & ((1 << obits) - 1))
+                continue
+            if mode in ("ss", "su"):
+                v = sext(v, bits)
+            if mode == "ss":
+                r, st = sat(v, -(1 << (obits - 1)), (1 << (obits - 1)) - 1)
+            else:
+                r, st = sat(v, 0, (1 << obits) - 1)
+            anys |= st
+            out.append(r)
+        s.set_v(f.rt, put(out))
+        if mode != "um":
+            _sat_note(s, anys)
+    return sem
+
+
+vx("vpkuhum", 14, _pack("h", "um"))
+vx("vpkuwum", 78, _pack("w", "um"))
+vx("vpkuhus", 142, _pack("h", "us"))
+vx("vpkuwus", 206, _pack("w", "us"))
+vx("vpkshus", 270, _pack("h", "su"))
+vx("vpkswus", 334, _pack("w", "su"))
+vx("vpkshss", 398, _pack("h", "ss"))
+vx("vpkswss", 462, _pack("w", "ss"))
+
