+        while (n > 3 && (s_save_root[n - 1] == '/' || s_save_root[n - 1] == '\\')) s_save_root[--n] = 0;
+#ifdef _WIN32
+        for (char* c = s_save_root; *c; c++) if (*c == '/') *c = '\\';    /* one separator in the log and the lock note */
+#endif
+        printf("[cellSaveData] savedata root: %s%s\n", s_save_root, shared ? " (shared save folder)" : "");
+        const int have_imp = shared && sd_getenv("PS3_SAVEDATA_IMPORT", imp, sizeof imp);
