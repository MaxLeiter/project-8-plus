diff --git a/runtime/spu/tests/test_spu_lv2_events.c b/runtime/spu/tests/test_spu_lv2_events.c
new file mode 100644
index 00000000..5a2e2513
--- /dev/null
+++ b/runtime/spu/tests/test_spu_lv2_events.c
@@ -0,0 +1,452 @@
+/*
+ * lv2 SPU thread events and signals, end to end: what an SPU thread-group
+ * program and the PPU say to each other through sys_spu_thread_send_event /
+ * throw_event, sys_spu_thread_connect_event, the group's user-event ports,
+ * sys_spu_thread_write_snr + set_spu_cfg and sys_spu_thread_write_spu_mb.
+ *
+ * Unit under test: runtime/syscalls/lv2_register.c (the handlers and
+ * spu_deliver_user_event), runtime/spu/spu_lifted_thread.c (a group thread on
+ * its own host thread, blocking channel reads on), runtime/spu/spu_channels.c.
+ *
+ * Part 1 drives the SPU side directly through spu_wrch / spu_rdch on a context
+ * carrying a real thread's id. Part 2 starts a real thread group whose threads
+ * run hand-written "lifted" programs on their own host threads:
+ *
+ *   thread 0 is the shape of THP8's FMOD mixer (fmodmix LS 0x1803C / 0x19BA8):
+ *     loop { blk = rdch SNR1 (blocking); GET/PUT the block with a tag wait;
+ *            sys_spu_thread_send_event(9, blk, ~blk) = rchcnt RdInMbox == 0,
+ *            wrch OutMbox data1, wrch OutIntrMbox (9<<24)|data0, rdch RdInMbox }
+ *     and the PPU writes the block number with sys_spu_thread_write_snr and
+ *     waits on the event queue it bound with sys_spu_thread_connect_event;
+ *   thread 1 checks SNR OR-mode / overwrite-mode delivery and the S1/S2 events
+ *     after the PPU has written both registers several times.
+ *
+ * Build (Windows, clang-cl, from the ps3recomp root; one compile at a time):
+ *   clang-cl -nologo -MD -O2 -msse4.1 -fno-strict-aliasing /clang:-ffp-contract=off
+ *       -D_CRT_SECURE_NO_WARNINGS -I include -I runtime/spu -I runtime/platform -I runtime
+ *       -I runtime/syscalls runtime/spu/tests/test_spu_lv2_events.c
+ *       runtime/spu/spu_channels.c runtime/spu/spu_drain.c runtime/spu/spu_lockstep.c
+ *       runtime/spu/spu_coherency.c runtime/spu/spu_workload.c runtime/spu/spurs_policy.c
+ *       runtime/spu/spurs_job.c runtime/spu/spu_tsp_weak.c runtime/spu/spu_vm_pagemap.c
+ *       runtime/spu/spurs_policy_blob_weak.c runtime/spu/spu_interp.c
+ *       runtime/spu/spu_capture.c runtime/spu/spu_lifted_thread.c
+ *       runtime/syscalls/spu_fallback.c runtime/syscalls/sdk_version_weak.c
+ *       -Fe:test_spu_lv2_events.exe /link user32.lib advapi32.lib
+ *
+ * Exit code: 0 if all passed, 1 if any failed. The last line is a summary.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define GUEST_SIZE   0x01000000u
+uint8_t*  vm_base;
+uint32_t  ppu_vm_size = GUEST_SIZE;
+
+/* The lv2 SPU layer, handlers and all (they are static). */
+#include "../../syscalls/lv2_register.c"
+#include "../spu_helpers.h"
+
+typedef void (*test_spu_fn)(spu_context*);
+void spu_begin_image(int image_id);
+void spu_register_function(uint32_t addr, test_spu_fn fn);
+void spu_stop(spu_context* ctx);
+u128     spu_rdch(spu_context* ctx, uint32_t channel);
+uint32_t spu_rchcnt(spu_context* ctx, uint32_t channel);
+void     spu_wrch(spu_context* ctx, uint32_t channel, u128 value);
+
+/* ---------------------------------------------------------------------------
+ * Harness
+ * -----------------------------------------------------------------------*/
+static int g_pass, g_fail;
+static const char* g_test = "(none)";
+#define TEST(name) (g_test = (name))
+#define CHECK(cond) do {                                                     \
+    if (cond) g_pass++;                                                      \
+    else { g_fail++;                                                         \
+           printf("  FAIL [%s] %s:%d: %s\n", g_test, __FILE__, __LINE__, #cond); \
+           fflush(stdout); }                                                 \
+} while (0)
+#define CHECK_EQ(a, b) do {                                                  \
+    uint64_t _a = (uint64_t)(a), _b = (uint64_t)(b);                         \
+    if (_a == _b) g_pass++;                                                  \
+    else { g_fail++;                                                         \
+           printf("  FAIL [%s] %s:%d: %s == %s (0x%llX != 0x%llX)\n", g_test,  \
+                  __FILE__, __LINE__, #a, #b, (unsigned long long)_a,          \
+                  (unsigned long long)_b); fflush(stdout); }                  \
+} while (0)
+
+static uint64_t qpc_ns(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+}
+
+static ppu_context g_ppu;
+static int64_t call(int64_t (*handler)(ppu_context*), uint64_t a3, uint64_t a4,
+                    uint64_t a5, uint64_t a6, uint64_t a7, uint64_t a8)
+{
+    memset(&g_ppu, 0, sizeof g_ppu);
+    g_ppu.gpr[3] = a3; g_ppu.gpr[4] = a4; g_ppu.gpr[5] = a5;
+    g_ppu.gpr[6] = a6; g_ppu.gpr[7] = a7; g_ppu.gpr[8] = a8;
+    return handler(&g_ppu);
+}
+static uint32_t gbe32(uint32_t ea)
+{
+    const uint8_t* p = vm_base + ea;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static void pbe32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+static void     wr(spu_context* c, uint32_t ch, uint32_t v) { spu_wrch(c, ch, spu_make_preferred_u32(v)); }
+static uint32_t rd(spu_context* c, uint32_t ch)             { return spu_rdch(c, ch)._u32[0]; }
+static uint32_t cnt(spu_context* c, uint32_t ch)            { return spu_rchcnt(c, ch); }
+
+/* ---------------------------------------------------------------------------
+ * The PPU event queues: sys_event_queue_push_by_id records every event and
+ * signals the waiter. push_result is what the queue answers (0 = queued).
+ * -----------------------------------------------------------------------*/
+typedef struct { uint32_t q; uint64_t d[4]; } ev_rec;
+#define EVQ 4096
+static ev_rec   g_ev[EVQ];
+static volatile LONG g_ev_n;
+static SRWLOCK  g_ev_lock = SRWLOCK_INIT;
+static HANDLE   g_ev_signal;
+static int      push_result;
+
+int sys_event_queue_push_by_id(uint32_t q, uint64_t d0, uint64_t d1, uint64_t d2, uint64_t d3)
+{
+    if (push_result) return push_result;
+    AcquireSRWLockExclusive(&g_ev_lock);
+    if (g_ev_n < EVQ) { ev_rec* e = &g_ev[g_ev_n]; e->q = q; e->d[0] = d0; e->d[1] = d1; e->d[2] = d2; e->d[3] = d3;
+                        InterlockedIncrement(&g_ev_n); }
+    ReleaseSRWLockExclusive(&g_ev_lock);
+    SetEvent(g_ev_signal);
+    return 0;
+}
+/* Wait until at least n events have been recorded. */
+static int await_events(LONG n, DWORD ms)
+{
+    uint64_t end = qpc_ns() + (uint64_t)ms * 1000000u;
+    while (g_ev_n < n) {
+        if (qpc_ns() > end) return 0;
+        WaitForSingleObject(g_ev_signal, 5);
+    }
+    return 1;
+}
+
+static uint32_t g_flag_id; static uint64_t g_flag_bits;
+int64_t sys_event_flag_set(ppu_context* ctx)
+{
+    g_flag_id = (uint32_t)ctx->gpr[3]; g_flag_bits = ctx->gpr[4];
+    return g_flag_id == 44 ? CELL_OK : (int64_t)(int32_t)CELL_ESRCH;
+}
+
+/* ---------------------------------------------------------------------------
+ * Guest layout
+ * -----------------------------------------------------------------------*/
+#define IMG0_EA     0x00011000u   /* sys_spu_image for thread 0 (mixer) */
+#define IMG1_EA     0x00011100u   /* sys_spu_image for thread 1 (signals) */
+#define SEGS_EA     0x00011800u   /* an empty segment table */
+#define OUT_EA      0x00012000u
+#define SRC_EA      0x00100000u   /* mixer input blocks, 64 bytes each */
+#define DST_EA      0x00200000u   /* mixer output blocks */
+#define ENTRY0      0x00800u
+#define ENTRY1      0x00900u
+#define IMAGE_ID    11
+#define MIX_PORT    9
+#define MIX_QUEUE   55
+#define GRP_QUEUE   77
+
+/* ---------------------------------------------------------------------------
+ * Part 1: send_event / throw_event routing, from the SPU side
+ * -----------------------------------------------------------------------*/
+static void test_routing(uint32_t gid, uint32_t tid0, uint32_t tid1)
+{
+    TEST("lv2.connect");
+    /* Thread 0 binds port 9 to its own queue (FMOD binds its mixer per thread);
+     * the group binds port 9 for every thread to another queue. */
+    CHECK_EQ(call(sys_spu_thread_connect_event_handler, tid0, MIX_QUEUE, 1 /* USER */, MIX_PORT, 0, 0), 0);
+    CHECK_EQ(call(sys_spu_thread_group_connect_event_all_threads_handler, gid, GRP_QUEUE,
+                  1ull << MIX_PORT, OUT_EA, 0, 0), 0);
+    CHECK_EQ(vm_base[OUT_EA], MIX_PORT);
+
+    spu_context* s0 = (spu_context*)_aligned_malloc(sizeof(spu_context), 128);
+    spu_context* s1 = (spu_context*)_aligned_malloc(sizeof(spu_context), 128);
+    spu_context_init(s0, tid0); s0->spu_group_id = gid;
+    spu_context_init(s1, tid1); s1->spu_group_id = gid;
+
+    TEST("lv2.send_event");
+    LONG n0 = g_ev_n;
+    CHECK_EQ(cnt(s0, SPU_RdInMbox), 0);
+    wr(s0, SPU_WrOutMbox, 0xDA7A0001u);                       /* data1 */
+    CHECK_EQ(g_ev_n, n0);                                     /* plain mailbox data: no event */
+    wr(s0, SPU_WrOutIntrMbox, ((uint32_t)MIX_PORT << 24) | 0xABCDEFu);
+    CHECK_EQ(g_ev_n, n0 + 1);
+    ev_rec* e = &g_ev[n0];
+    CHECK_EQ(e->q, MIX_QUEUE);                                 /* per-thread binding wins */
+    CHECK_EQ(e->d[0], 0xFFFFFFFF53505501ull);                  /* SYS_SPU_THREAD_EVENT_USER_KEY */
+    CHECK_EQ(e->d[1], tid0);
+    CHECK_EQ(e->d[2], ((uint64_t)MIX_PORT << 32) | 0xABCDEFu);
+    CHECK_EQ(e->d[3], 0xDA7A0001u);
+    CHECK_EQ(s0->ch_out_mbox.count, 0);                       /* data1 consumed */
+    CHECK_EQ(cnt(s0, SPU_RdInMbox), 1);                       /* the reply */
+    CHECK_EQ(rd(s0, SPU_RdInMbox), CELL_OK);
+    CHECK_EQ(cnt(s0, SPU_WrOutMbox), 1);
+    CHECK_EQ(cnt(s0, SPU_WrOutIntrMbox), 1);
+
+    TEST("lv2.send_event-group-port");
+    wr(s1, SPU_WrOutMbox, 2);
+    wr(s1, SPU_WrOutIntrMbox, ((uint32_t)MIX_PORT << 24) | 5u);
+    CHECK_EQ(g_ev[g_ev_n - 1].q, GRP_QUEUE);                   /* no per-thread binding: group port */
+    CHECK_EQ(g_ev[g_ev_n - 1].d[1], tid1);
+    CHECK_EQ(rd(s1, SPU_RdInMbox), CELL_OK);
+
+    TEST("lv2.send_event-unbound");
+    n0 = g_ev_n;
+    wr(s0, SPU_WrOutMbox, 3);
+    wr(s0, SPU_WrOutIntrMbox, (12u << 24) | 1u);
+    CHECK_EQ(g_ev_n, n0);
+    CHECK_EQ(rd(s0, SPU_RdInMbox), CELL_ENOTCONN);
+
+    TEST("lv2.send_event-queue-full");
+    push_result = (int)CELL_EBUSY;
+    wr(s0, SPU_WrOutMbox, 4);
+    wr(s0, SPU_WrOutIntrMbox, ((uint32_t)MIX_PORT << 24) | 2u);
+    CHECK_EQ(rd(s0, SPU_RdInMbox), CELL_EBUSY);
+    push_result = 0;
+
+    TEST("lv2.throw_event");
+    n0 = g_ev_n;
+    wr(s0, SPU_WrOutMbox, 0x7777u);
+    wr(s0, SPU_WrOutIntrMbox, ((64u + MIX_PORT) << 24) | 0x123u);
+    CHECK_EQ(g_ev_n, n0 + 1);
+    CHECK_EQ(g_ev[n0].q, MIX_QUEUE);
+    CHECK_EQ(g_ev[n0].d[2], ((uint64_t)MIX_PORT << 32) | 0x123u);
+    CHECK_EQ(g_ev[n0].d[3], 0x7777u);
+    CHECK_EQ(cnt(s0, SPU_RdInMbox), 0);                       /* no reply */
+    CHECK_EQ(s0->ch_out_mbox.count, 0);
+
+    TEST("lv2.event_flag_set_bit");
+    wr(s0, SPU_WrOutMbox, 44);
+    wr(s0, SPU_WrOutIntrMbox, 0x80000005u);
+    CHECK_EQ(g_flag_bits, 1ull << 5);
+    CHECK_EQ(rd(s0, SPU_RdInMbox), CELL_OK);
+    wr(s0, SPU_WrOutMbox, 44);
+    wr(s0, SPU_WrOutIntrMbox, 0xC0000006u);                   /* impatient: no reply */
+    CHECK_EQ(g_flag_bits, 1ull << 6);
+    CHECK_EQ(cnt(s0, SPU_RdInMbox), 0);
+
+    _aligned_free(s0); _aligned_free(s1);
+}
+
+/* ---------------------------------------------------------------------------
+ * Part 2: the thread programs
+ * -----------------------------------------------------------------------*/
+static void spu_exit(spu_context* ctx, uint32_t status)
+{
+    spu_channel_write(&ctx->ch_out_mbox, status);
+    ctx->stop_code = 0x102u;
+    ctx->status    = SPU_STATUS_STOPPED_BY_STOP;
+    spu_stop(ctx);
+}
+
+static volatile LONG g_mix_bad_inmbox;
+static void mixer_entry(spu_context* ctx)
+{
+    uint32_t good = 0;
+    for (;;) {
+        uint32_t blk = rd(ctx, SPU_RdSigNotify1);            /* parks until the PPU signals */
+        if (blk == 0xFFFFFFFFu) break;
+        /* GET the input block, transform it, PUT it back, wait on the tag. */
+        wr(ctx, MFC_LSA, 0x4000); wr(ctx, MFC_EAH, 0); wr(ctx, MFC_EAL, SRC_EA + blk * 64u);
+        wr(ctx, MFC_Size, 64); wr(ctx, MFC_TagID, 3); wr(ctx, MFC_Cmd, MFC_GET_CMD);
+        wr(ctx, MFC_WrTagMask, 1u << 3); wr(ctx, MFC_WrTagUpdate, 2);
+        (void)rd(ctx, MFC_RdTagStat);
+        for (int i = 0; i < 64; i++) ctx->ls[0x4000 + i] ^= 0xFF;
+        wr(ctx, MFC_LSA, 0x4000); wr(ctx, MFC_EAH, 0); wr(ctx, MFC_EAL, DST_EA + blk * 64u);
+        wr(ctx, MFC_Size, 64); wr(ctx, MFC_TagID, 3); wr(ctx, MFC_Cmd, MFC_PUT_CMD);
+        wr(ctx, MFC_WrTagMask, 1u << 3); wr(ctx, MFC_WrTagUpdate, 2);
+        (void)rd(ctx, MFC_RdTagStat);
+        /* sys_spu_thread_send_event(9, blk, ~blk), as libsputhread does it. */
+        if (cnt(ctx, SPU_RdInMbox) != 0) { InterlockedIncrement(&g_mix_bad_inmbox); continue; }
+        wr(ctx, SPU_WrOutMbox, ~blk);
+        wr(ctx, SPU_WrOutIntrMbox, ((uint32_t)MIX_PORT << 24) | (blk & 0xFFFFFFu));
+        if (rd(ctx, SPU_RdInMbox) == CELL_OK) good++;
+    }
+    spu_exit(ctx, good);
+}
+
+static void signals_entry(spu_context* ctx)
+{
+    uint32_t bits = 0;
+    wr(ctx, SPU_WrEventMask, 0x300);                       /* S1 | S2 */
+    if (rd(ctx, SPU_RdInMbox) == 0x60u) bits |= 0x01;      /* parks until the PPU says go */
+    if (cnt(ctx, SPU_RdSigNotify1) == 1) bits |= 0x02;
+    if (cnt(ctx, SPU_RdSigNotify2) == 1) bits |= 0x04;
+    if (cnt(ctx, SPU_RdEventStat) == 1 && rd(ctx, SPU_RdEventStat) == 0x300u) bits |= 0x08;
+    wr(ctx, SPU_WrEventAck, 0x300);
+    if (cnt(ctx, SPU_RdEventStat) == 0) bits |= 0x10;
+    if (rd(ctx, SPU_RdSigNotify1) == 0x105u) bits |= 0x20;  /* OR mode merged three writes */
+    if (rd(ctx, SPU_RdSigNotify2) == 9u)     bits |= 0x40;  /* overwrite kept the last */
+    if (cnt(ctx, SPU_RdSigNotify1) == 0 && cnt(ctx, SPU_RdSigNotify2) == 0) bits |= 0x80;
+    wr(ctx, SPU_WrEventMask, 0);
+    spu_exit(ctx, bits);
+}
+
+static void test_group(uint32_t gid, uint32_t tid0, uint32_t tid1)
+{
+    TEST("lv2.group-signals");
+    /* SNR1 of thread 1 in OR mode, SNR2 overwrite. */
+    CHECK_EQ(call(sys_spu_thread_set_spu_cfg_handler, tid1, 1, 0, 0, 0, 0), 0);
+    CHECK_EQ(call(sys_spu_thread_get_spu_cfg_handler, tid1, 0, 0, 0, 0, 0), 0);
+    CHECK_EQ(g_ppu.gpr[4], 1);
+
+    for (uint32_t b = 0; b < 256; b++)
+        for (uint32_t i = 0; i < 64; i++) vm_base[SRC_EA + b * 64u + i] = (uint8_t)(b * 3u + i);
+
+    LONG n0 = g_ev_n;
+    CHECK_EQ(call(sys_spu_thread_group_start_handler, gid, 0, 0, 0, 0, 0), 0);
+    spu_thread_t* t1 = spu_find_thread(tid1);
+    CHECK(t1 && t1->sctx);
+    /* Several writes to each register before thread 1 reads either. */
+    call(sys_spu_thread_write_snr_handler, tid1, 0, 0x001, 0, 0, 0);
+    call(sys_spu_thread_write_snr_handler, tid1, 0, 0x004, 0, 0, 0);
+    call(sys_spu_thread_write_snr_handler, tid1, 0, 0x100, 0, 0, 0);
+    call(sys_spu_thread_write_snr_handler, tid1, 1, 7, 0, 0, 0);
+    call(sys_spu_thread_write_snr_handler, tid1, 1, 9, 0, 0, 0);
+    CHECK_EQ(call(sys_spu_thread_write_snr_handler, tid1, 2, 1, 0, 0, 0),
+             (int64_t)(int32_t)0x80010002);   /* no SNR3: CELL_EINVAL (hlefix 3ace8d9 returns the code) */
+    CHECK_EQ(call(sys_spu_thread_write_spu_mb_handler, tid1, 0x60, 0, 0, 0, 0), 0);
+
+    TEST("lv2.group-mixer");
+    /* The mixer: one SNR1 write per block, one send_event back per block. */
+    enum { NBLK = 200 };
+    uint64_t worst = 0, sum = 0; int ev_ok = 1, data_ok = 1, timeouts = 0;
+    for (uint32_t blk = 1; blk <= NBLK; blk++) {
+        LONG want = g_ev_n + 1;
+        uint64_t t0 = qpc_ns();
+        call(sys_spu_thread_write_snr_handler, tid0, 0, blk, 0, 0, 0);
+        if (!await_events(want, 5000)) { timeouts++; break; }
+        uint64_t dt = qpc_ns() - t0; sum += dt; if (dt > worst) worst = dt;
+        ev_rec* e = &g_ev[want - 1];
+        if (e->q != MIX_QUEUE || e->d[0] != 0xFFFFFFFF53505501ull || e->d[1] != tid0 ||
+            e->d[2] != (((uint64_t)MIX_PORT << 32) | blk) || e->d[3] != (uint32_t)~blk) ev_ok = 0;
+        for (uint32_t i = 0; i < 64; i++)
+            if (vm_base[DST_EA + blk * 64u + i] != (uint8_t)~vm_base[SRC_EA + blk * 64u + i]) data_ok = 0;
+    }
+    CHECK_EQ(timeouts, 0);
+    CHECK(ev_ok); CHECK(data_ok);
+    CHECK_EQ(g_mix_bad_inmbox, 0);
+    printf("  [lv2.group-mixer] %d blocks: write_snr -> event mean %.1f us, worst %.2f ms\n",
+           NBLK, (double)sum / NBLK / 1000.0, (double)worst / 1e6);
+    call(sys_spu_thread_write_snr_handler, tid0, 0, 0xFFFFFFFFu, 0, 0, 0);
+
+    TEST("lv2.group-join");
+    CHECK_EQ(call(sys_spu_thread_group_join_handler, gid, OUT_EA, OUT_EA + 4, 0, 0, 0), 0);
+    spu_thread_t* t0 = spu_find_thread(tid0);
+    CHECK_EQ(t0->exit_status, NBLK);                 /* every send_event replied CELL_OK */
+    uint32_t bits = (uint32_t)t1->exit_status;
+    printf("  [lv2.group-signals] thread 1 result bits 0x%02X (want 0xFF)\n", bits);
+    CHECK_EQ(bits & 0x01, 0x01);                     /* write_spu_mb delivered */
+    CHECK_EQ(bits & 0x06, 0x06);                     /* both SNRs pending, count 1 */
+    CHECK_EQ(bits & 0x08, 0x08);                     /* S1|S2 events pending & enabled */
+    CHECK_EQ(bits & 0x10, 0x10);                     /* ack cleared them */
+    CHECK_EQ(bits & 0x20, 0x20);                     /* OR mode merged 1|4|0x100 */
+    CHECK_EQ(bits & 0x40, 0x40);                     /* overwrite mode kept 9 */
+    CHECK_EQ(bits & 0x80, 0x80);                     /* reads cleared both */
+    (void)n0;
+}
+
+/* ---------------------------------------------------------------------------
+ * The runtime beyond the SPU and lv2 layers, stubbed (as in
+ * test_spu_lifted_start.c). None of it is on a path driven here.
+ * -----------------------------------------------------------------------*/
+void sys_ppu_thread_init(lv2_syscall_table* t) { (void)t; }
+void sys_mutex_init(lv2_syscall_table* t)      { (void)t; }
