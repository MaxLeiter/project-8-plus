+                break;
+            case 2:                       /* overflow */
+                a = mkd(s1, (mul || fma) ? 1600 + (int)(rnd() % 447) : 2040 + (int)(rnd() % 7), rdfrac());
+                b = mkd(s2, (mul || fma) ? 1600 + (int)(rnd() % 447) : 2040 + (int)(rnd() % 7), rdfrac());
+                c = mkd(rnd() & 1, 2040 + (int)(rnd() % 7), rdfrac());
