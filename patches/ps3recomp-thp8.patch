+    "    float4 r = float4(0.0, 0.0, 0.0, 1.0);\n"
+    "    [loop] for (uint c = 0; c < sz; c++) {\n"
+    "        uint w = vf_ld(a + c * cs);\n"
+    "        uint h = vf_be16(w);\n"
