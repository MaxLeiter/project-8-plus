+    u32 total = 0;
+    for (u32 b = 0; b < dc.n_idx; b++) {
+        const u64 start = (u64)ia.offset + (u64)dc.idx[b].first * esz, bytes = (u64)dc.idx[b].count * esz;
+        src[b] = NULL; len[b] = (u32)bytes;
