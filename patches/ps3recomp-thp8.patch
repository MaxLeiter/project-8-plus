+    case OP_fcgt: for (i = 0; i < 4; i++) sw(&R, i, sp_key(gw(&A, i)) >  sp_key(gw(&B, i)) ? ~0u : 0); dest = rt; break;
+    case OP_fcmeq:for (i = 0; i < 4; i++) sw(&R, i, sp_mag(gw(&A, i)) == sp_mag(gw(&B, i)) ? ~0u : 0); dest = rt; break;
+    case OP_fcmgt:for (i = 0; i < 4; i++) sw(&R, i, sp_mag(gw(&A, i)) >  sp_mag(gw(&B, i)) ? ~0u : 0); dest = rt; break;
+    case OP_cflts:for (i = 0; i < 4; i++) sw(&R, i, sp_cflt(gw(&A, i), i8, 0)); dest = rt; break;
+    case OP_cfltu:for (i = 0; i < 4; i++) sw(&R, i, sp_cflt(gw(&A, i), i8, 1)); dest = rt; break;
+    case OP_csflt:for (i = 0; i < 4; i++) sw(&R, i, sp_cvt_int(gw(&A, i), i8, 1)); dest = rt; break;
+    case OP_cuflt:for (i = 0; i < 4; i++) sw(&R, i, sp_cvt_int(gw(&A, i), i8, 0)); dest = rt; break;
+    case OP_frest:  for (i = 0; i < 4; i++) sw(&R, i, sp_frest(gw(&A, i))); dest = rt; break;
+    case OP_frsqest:for (i = 0; i < 4; i++) sw(&R, i, sp_frsqest(gw(&A, i))); dest = rt; break;
+    case OP_fi:   for (i = 0; i < 4; i++) sw(&R, i, sp_fi(gw(&A, i), gw(&B, i))); dest = rt; break;
+
+    /* ---- double precision float ---- */
+    case OP_dfa: for (i = 0; i < 2; i++) sd(&R, i, dp_add(gd(&A, i), gd(&B, i))); dest = rt; break;
+    case OP_dfs: for (i = 0; i < 2; i++) sd(&R, i, dp_add(gd(&A, i), gd(&B, i) ^ 0x8000000000000000ull)); dest = rt; break;
+    case OP_dfm: for (i = 0; i < 2; i++) sd(&R, i, dp_mul(gd(&A, i), gd(&B, i))); dest = rt; break;
+    case OP_dfma: for (i = 0; i < 2; i++) sd(&R, i, dp_fma(gd(&A, i), gd(&B, i), gd(&T, i), 0, 0)); dest = rt; break;
+    case OP_dfms: for (i = 0; i < 2; i++) sd(&R, i, dp_fma(gd(&A, i), gd(&B, i), gd(&T, i), 0, 1)); dest = rt; break;
+    case OP_dfnms:for (i = 0; i < 2; i++) sd(&R, i, dp_fma(gd(&A, i), gd(&B, i), gd(&T, i), 1, 0)); dest = rt; break;
+    case OP_dfnma:for (i = 0; i < 2; i++) sd(&R, i, dp_neg(dp_fma(gd(&A, i), gd(&B, i), gd(&T, i), 0, 0))); dest = rt; break;
+    case OP_dfceq: case OP_dfcgt: case OP_dfcmeq: case OP_dfcmgt:
+        for (i = 0; i < 2; i++) {
+            uint64_t x = gd(&A, i), y = gd(&B, i);
+            int res = 0;
+            if (!dp_isnan(x) && !dp_isnan(y)) {
+                if (op == OP_dfceq) res = dp_key(x) == dp_key(y);
+                else if (op == OP_dfcgt) res = dp_key(x) > dp_key(y);
+                else if (op == OP_dfcmeq) res = dp_mag(x) == dp_mag(y);
+                else res = dp_mag(x) > dp_mag(y);
+            }
+            sd(&R, i, res ? ~0ull : 0);
+        }
+        dest = rt; break;
+    case OP_dftsv: for (i = 0; i < 2; i++) sd(&R, i, dp_tsv(gd(&A, i), i7) ? ~0ull : 0); dest = rt; break;
+    case OP_fesd: sd(&R, 0, sp_to_dp(gw(&A, 0))); sd(&R, 1, sp_to_dp(gw(&A, 2))); dest = rt; break;
+    case OP_frds: sw(&R, 0, dp_to_sp(gd(&A, 0))); sw(&R, 2, dp_to_sp(gd(&A, 1))); dest = rt; break;
+
+    default:
+        r->kind = SPU_REF_ILLEGAL; break;
+    }
+#undef LO16S
+#undef HI16S
+#undef LO16U
+#undef HI16U
+
+    if (r->kind == SPU_REF_ILLEGAL) { r->next_pc = pc; return r->kind; }
+    if (r->kind == SPU_REF_HALT) { r->next_pc = pc; return r->kind; }
+    if (dest >= 0) memcpy(s->gpr[dest], R.b, 16);
+    r->next_pc = next;
+    if (r->kind == SPU_REF_NEXT) s->pc = next;
+    return r->kind;
+}
diff --git a/runtime/spu/tests/spucheck/spu_ref.h b/runtime/spu/tests/spucheck/spu_ref.h
new file mode 100644
index 00000000..1e62e626
--- /dev/null
+++ b/runtime/spu/tests/spucheck/spu_ref.h
@@ -0,0 +1,90 @@
+/* spu_ref.h -- independent reference SPU executor for differential testing.
+ *
+ * Written from the Cell BE SPU ISA v1.2 instruction descriptions, NOT from the
+ * runtime: no spu_context.h, no spu_helpers.h, no host-endian register tricks.
+ * State is architectural: 128 registers of 16 big-endian bytes (byte 0 = most
+ * significant byte of word 0 = the preferred slot), a 256 KB big-endian local
+ * store, pc, SRR0 and the interrupt-enable / event state the branch family
+ * reads. Channel instructions go through caller-supplied callbacks.
+ *
+ * Floating point models the hardware, not IEEE:
+ *  - single precision: e==0 operands are zero (no denormals), exponent 255 is
+ *    an ordinary "extended range" number (no Inf/NaN), fa/fs/fm/fma/fms/fnms
+ *    are exact-then-one-rounding toward zero, |r| < 2^-126 -> +0, |r| >= 2^129
+ *    saturates to sign|0x7FFFFFFF. Implemented in integer arithmetic only.
+ *  - double precision: IEEE round-to-nearest-even, denormal operands read as
+ *    signed zero, denormal results flushed to signed zero, any NaN result is
+ *    0x7FF8000000000000; dfma family fused. Integer arithmetic only.
+ * See spu_ref.c for the per-instruction notes.
+ */
+#ifndef SPU_REF_H
+#define SPU_REF_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SPU_REF_LS_SIZE 0x40000u
+
+typedef struct spu_ref_io {
+    void* user;
+    uint32_t (*rdch)(void* user, uint32_t ch);              /* value for rdch    */
+    void     (*wrch)(void* user, uint32_t ch, uint32_t v);  /* preferred word    */
+    uint32_t (*rchcnt)(void* user, uint32_t ch);            /* channel count     */
+} spu_ref_io;
+
+typedef struct spu_ref_state {
+    uint8_t  gpr[128][16];   /* big-endian bytes per register */
+    uint8_t* ls;             /* SPU_REF_LS_SIZE bytes, big-endian */
+    uint32_t pc;
+    uint32_t srr0;
+    uint32_t int_enable;     /* toggled by the E/D bits of the bi family */
+    uint32_t event_status;   /* bisled branches iff (event_status & event_mask) */
+    uint32_t event_mask;
+    /* LS lines (16-byte aligned addresses) written by the last step */
+    int      nwrites;
+    uint32_t writes[4];
+} spu_ref_state;
+
+enum {
+    SPU_REF_NEXT    = 0,   /* executed; next_pc is the following pc */
+    SPU_REF_STOP    = 1,   /* stop / stopd: stop_code valid */
+    SPU_REF_HALT    = 2,   /* a halt-conditional instruction fired */
+    SPU_REF_ILLEGAL = 3    /* not a valid SPU instruction (or undefined form) */
+};
+
+typedef struct spu_ref_result {
+    int      kind;
+    uint32_t next_pc;
+    uint32_t stop_code;
+} spu_ref_result;
+
+/* Execute the instruction at s->pc. Updates the state (incl. s->pc for
+ * NEXT) and fills *r. Returns r->kind. */
+int spu_ref_step(spu_ref_state* s, const spu_ref_io* io, spu_ref_result* r);
+
+/* ISA mnemonic of an instruction word ("" if illegal). */
+const char* spu_ref_mnemonic(uint32_t insn);
+
+/* If the instruction at pc is a quadword load/store, return 1 and the LS line
+ * it accesses (for seeding the line with random data); else 0. */
+int spu_ref_mem_line(const spu_ref_state* s, uint32_t insn, uint32_t* lsa, int* is_store);
+
+/* The estimate instructions' per-word results (frest / frsqest), for building
+ * genuine fi operand pairs (rb = estimate(ra)). */
+uint32_t spu_ref_frest(uint32_t x);
+uint32_t spu_ref_frsqest(uint32_t x);
+/* fm / dfm per element, for building cancellation operands of the fused forms. */
+uint32_t spu_ref_fm(uint32_t a, uint32_t b);
+uint64_t spu_ref_dfm(uint64_t a, uint64_t b);
+
+/* Operand fields as the ISA format defines them (for reproducer printouts):
+ * returns the number of register operands written to regs[] (dest first). */
+int spu_ref_operand_regs(uint32_t insn, int regs[4], const char** fmt);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SPU_REF_H */
diff --git a/runtime/spu/tests/spucheck/spucheck_main.c b/runtime/spu/tests/spucheck/spucheck_main.c
new file mode 100644
index 00000000..c4d20276
--- /dev/null
+++ b/runtime/spu/tests/spucheck/spucheck_main.c
@@ -0,0 +1,1384 @@
+/* spucheck_main.c -- SPU per-instruction differential harness (driver).
+ *
+ * README
+ * ------
+ * What: every instruction the SPU decoder (tools/spu_disasm.py) knows, in many
+ * encodings (gen_spucheck.py), is executed by three independent executors on
+ * the same randomized architectural state, and the results are compared:
+ *   ref     spu_ref.c        ISA-derived reference (hardware float model)
+ *   interp  spu_interp.c     the runtime's SPU interpreter, one step
+ *                            (spu_interp_step1), using spu_helpers.h
+ *   lifted  tools/spu_lifter.py output for the case's function, compiled with
+ *                            the game's flags, using spu_helpers.h
+ * Compared: all 128 GPRs, local store (lines written; whole LS on the first
+ * seed of every case), the control outcome (next pc / branch target / stop
+ * code / halt), interrupt-enable state, and the channel call log.
+ *
+ * Operands: random architectural state (int / float / double / halfword
+ * edges, related operand pairs) plus per-class SHAPING on most seeds (see
+ * shape()): shufb control-byte classes, quadword/word/halfword shift counts
+ * incl. negative and high-garbage counts, SP specials / overflow / underflow /
+ * cancellation against the fused product, conversion scale edges, DP ties,
+ * cancellation, denormals, NaN/Inf cross products, carries, compare
+ * neighbours; fi gets genuine rb = frest(ra) / frsqest(ra) pairs.
+ *
+ * SEQUENCE mode (cases "seq.*", gen_spucheck.py SeqGen): random programs of
+ * 8-32+ instructions over a small register pool -- int / SP / DP / shuffle /
+ * load-store to a 4 KB window / channel / misc, forward skips, br over dead
+ * code, counted loops, brsl / bisl calls into leaf functions (r0 and non-r0
+ * links, a bisl whose leaf does not return), conditional and computed exits.
+ * Each program is lifted as one function (+ leaves) and run whole; the
+ * reference and the interpreter step until the lifted run would end (stop,
+ * halt, control leaving the program, a taken indirect branch that is not a
+ * call's return). Compares the final state incl. the data window. The
+ * listing of every program is gen/spsq_listing.txt.
+ *
+ * Run: runtime/spu/tests/spucheck/run_spucheck.sh   (regenerates, builds, runs;
+ *      exit != 0 on any unexpected mismatch). By hand:
+ *      spucheck.exe <gen dir> [seeds]
+ * Env: SPUCHECK_SEEDS=N    seeds per case (default 64)
+ *      SPUCHECK_ONLY=a,b   only these mnemonics ("seq" = all sequence programs)
+ *      SPUCHECK_XFAIL=...  mnemonics whose mismatches are EXPECTED (reported,
+ *                          not fatal). Default: none -- everything is strict.
+ *      SPUCHECK_EXAMPLES=N reproducers printed per mismatch group (default 3)
+ *      SPUCHECK_TRACE=<LS addr hex>,<seed>  print the reference's steps for
+ *                          the sequence program at that address and seed
+ *
+ * Lifted-code model: the run ends at the first control event, where the real
+ * runtime would take over: spu_halt (longjmp, as in the runtime), spu_stop
+ * (the SPU stops here; the runtime's spu_stop instead returns into the
+ * caller by design -- SPURS stop-and-signal -- which is runtime policy, not
+ * instruction semantics), a direct call of spu_indirect_branch (bisl), a spu_drain_call with
+ * a pending transfer (brsl callee that branched away), or a return with
+ * g_spu_trampoline_fn set. An indirect target is what the runtime's
+ * spu_indirect_branch dispatches: ctx->pc & SPCK_IB_MASK (0x3FFFC: the
+ * resolver drops the low two bits like the hardware does; build with
+ * -DSPCK_IB_MASK=0x3FFFF to model a runtime that only masks to 256 KB).
+ *
+ * Float environment: spu_run_with_halt runs SPU code under spu_fp_enter()
+ * (spu_float.h: MXCSR 0xFFC0 = round toward zero, DAZ, FTZ, exceptions
+ * masked). The interpreter and the lifted code run under exactly that call
+ * (SPUCHECK_MXCSR=0x.... overrides the value for experiments); the reference
+ * uses integer arithmetic only and does not care.
+ */
+#include "spu_context.h"
+#include "spu_helpers.h"      /* spu_fp_enter / spu_fp_leave (spu_float.h) */
+#include "spu_interp.h"
+#include "spu_ref.h"
+#include <setjmp.h>
+#include <xmmintrin.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---------------------------------------------------------------------------
+ * Generated case tables
+ * ------------------------------------------------------------------------ */
+typedef struct { uint32_t addr; void (*fn)(spu_context*); } spck_fn;
+typedef struct { uint32_t code, addr; } spck_pad;
+typedef struct { uint32_t addr, is_code; } spck_range;
+typedef struct {
+    const char* blob; const spck_fn* fns; size_t nfns;
+    const spck_pad* pads; const spck_range* code; size_t ncode;
+} spck_image;
+typedef struct {
+    int img; uint32_t addr, insn, exit2;
+    int ovr_reg; uint32_t ovr_val; int ovr_mode;      /* 1 = all seeds, 2 = even seeds */
+    const char* mn; const char* ops;
+    void (*fn)(spu_context*);
+    uint32_t seq_hi;          /* sequence program: code is [addr, seq_hi); 0 = one instruction */
+} spck_case;
+#include "spck_cases.inc"
+#define NCASES (sizeof spck_cases / sizeof spck_cases[0])
+#define NIMAGES (sizeof spck_images / sizeof spck_images[0])
+
+#ifndef SPCK_IB_MASK
+#define SPCK_IB_MASK 0x3FFFCu
+#endif
+#define SENT1 0x3FF1u
+#define SENT2 0x3FF2u
+
+/* ---------------------------------------------------------------------------
+ * Runtime stubs (the pieces of ps3recomp_runtime the interpreter and the
+ * lifted code reach). Channel stubs log (op, channel, value).
+ * ------------------------------------------------------------------------ */
+typedef struct { int n; struct { uint32_t op, ch, v; } e[8]; } chlog;
+static chlog* g_curlog;
+static uint64_t g_chsalt;
+static uint32_t g_curw[8]; static int g_ncurw;          /* LS lines written (hook) */
+
+static uint32_t mix32(uint64_t x)
+{
+    x ^= x >> 33; x *= 0xFF51AFD7ED558CCDull; x ^= x >> 33; x *= 0xC4CEB9FE1A85EC53ull; x ^= x >> 33;
+    return (uint32_t)x;
+}
+static uint32_t chval(uint32_t ch) { return mix32(g_chsalt ^ (0x9E3779B97F4A7C15ull * (ch + 1))); }
+static uint32_t chcnt(uint32_t ch) { uint32_t v = mix32(g_chsalt + 77 * ch); return (v & 8) ? (v >> 8) : (v & 3); }
+static void logch(uint32_t op, uint32_t ch, uint32_t v)
+{
+    if (g_curlog && g_curlog->n < 8) { g_curlog->e[g_curlog->n].op = op; g_curlog->e[g_curlog->n].ch = ch; g_curlog->e[g_curlog->n].v = v; }
+    if (g_curlog) g_curlog->n++;
+}
+u128 spu_rdch(spu_context* c, uint32_t ch) { (void)c; uint32_t v = chval(ch); logch(1, ch, v); return spu_make_preferred_u32(v); }
+uint32_t spu_rchcnt(spu_context* c, uint32_t ch) { (void)c; uint32_t v = chcnt(ch); logch(2, ch, v); return v; }
+void spu_wrch(spu_context* c, uint32_t ch, u128 v) { (void)c; logch(3, ch, v._u32[0]); }
+
+/* Sequence programs (gen_spucheck.py SEQ_*): stores stay in this window. */
+#define SEQ_WIN    0x3E000u
+#define SEQ_WINSZ  0x1000u
+static int g_seq_mode;                /* the case running is a sequence program */
+static long g_wild;                   /* LS writes outside the window (sequence mode) */
+
+int g_spu_ls_watch_n = 1;     /* routes every spu_ls_{read,write}128 through the hook */
+void spu_ls_watch_slow(uint32_t lsa, int is_write, const uint8_t* p, uint32_t pc, uint32_t lr)
+{
+    (void)p; (void)pc; (void)lr;
+    if (is_write && g_ncurw < 8) g_curw[g_ncurw++] = lsa & 0x3FFF0u;
+    if (is_write && g_seq_mode && ((lsa & 0x3FFF0u) - SEQ_WIN) >= SEQ_WINSZ) g_wild++;
+}
+unsigned* spu_ls_watch_list(int* n) { *n = 0; return 0; }
+spu_lifted_fn spu_lifted_lookup(const spu_context* c, uint32_t a) { (void)c; (void)a; return 0; }
+void spu_spurs_taskset_syscall(spu_context* c) { (void)c; }
+
+SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*);
+SPU_THREAD_LOCAL uint32_t g_spu_pch[8];
+SPU_THREAD_LOCAL unsigned g_spu_pch_n;
+
+enum { EV_NONE, EV_STOP, EV_HALT, EV_IB, EV_DRAIN };
+static jmp_buf g_jb;
+static volatile int g_ev;
+static volatile uint32_t g_ev_pc;
+static void (*volatile g_ev_fn)(spu_context*);
+
+void spu_stop(spu_context* c) { (void)c; g_ev = EV_STOP; longjmp(g_jb, 1); }
+void spu_halt(spu_context* c) { (void)c; g_ev = EV_HALT; longjmp(g_jb, 1); }
+/* Lifted code calls spu_indirect_branch directly only from a bisl/bisled
+ * call bracket (a branch or tail jump hands it over as the trampoline). In a
+ * sequence program that call is dispatched like the runtime's resolver does
+ * -- run the lifted function at pc, come back -- when pc is one; anything
+ * else ends the run there. */
+static void (*seq_find_fn(uint32_t pc))(spu_context*);
+void spu_indirect_branch(spu_context* c)
+{
+    if (g_seq_mode) {
+        void (*fn)(spu_context*) = seq_find_fn((uint32_t)c->pc & 0x3FFFCu);
+        if (fn) { fn(c); return; }
+    }
+    g_ev = EV_IB; g_ev_pc = c->pc; longjmp(g_jb, 1);
+}
+void spu_indirect_branch_mt(spu_context* c) { spu_indirect_branch(c); }
+/* spu_drain_call (spu_context.h, inline) returns on its own when the callee
+ * came back to the return address with nothing pending; anything else lands
+ * here: a pending transfer (callee branched away) ends the run like the
+ * runtime's drain would continue it; no transfer but a different pc is a
+ * restart-dispatch at that pc. */
+static int seq_drain(spu_context* c);
+void spu_drain_call_full(spu_context* c, uint32_t ret)
+{
+    seq_drain(c);                     /* sequence programs: keep running their own functions */
+    if (g_spu_trampoline_fn == spu_indirect_branch && !(((uint32_t)c->pc ^ ret) & SPU_LS_MASK)) {
+        g_spu_trampoline_fn = 0;      /* the runtime's drain returns here (call came back) */
+        return;
+    }
+    if (g_spu_trampoline_fn) { g_ev = EV_DRAIN; g_ev_pc = c->pc; g_ev_fn = g_spu_trampoline_fn; longjmp(g_jb, 1); }
+    if (((uint32_t)c->pc ^ ret) & SPU_LS_MASK) { g_ev = EV_IB; g_ev_pc = c->pc; longjmp(g_jb, 1); }
+}
+/* Per-transfer hooks off (the default runtime configuration): SPU_XFER is a
+ * direct musttail jump while interrupts are disabled, the trampoline hop
+ * while they are enabled -- both paths run, int_enable is randomized. */
+int g_spu_hop_slow = 0;
+void spu_hop_slow_init(void) { g_spu_hop_slow = 0; }
+SPU_THREAD_LOCAL uint32_t g_spu_recent[32];
+SPU_THREAD_LOCAL uint32_t g_spu_recent_n;
+void spu_register_function(uint32_t a, void (*f)(spu_context*)) { (void)a; (void)f; }
+void spu_trace_init(const char* p) { (void)p; }
+void spu_trace_pc(spu_context* c, uint32_t pc) { (void)c; (void)pc; }
+void spu_trace_rt(spu_context* c, uint32_t rt) { (void)c; (void)rt; }
+void spu_depth_guard(spu_context* c) { (void)c; }
+void yz_lockstep_tick(spu_context* c) { (void)c; }
+void spu_task_launch_check(spu_context* c, void* f) { (void)c; (void)f; }
+int spu_tailret_enabled(void) { return 0; }
+void (*spu_take_interrupt(spu_context* c, void (*tf)(spu_context*)))(spu_context*) { (void)c; return tf; }
+
+int spu_interp_step1(spu_context* ctx);   /* spu_interp.c */
+
+/* The SPU host FP environment exactly as spu_run_with_halt sets it
+ * (spu_fp_enter, spu_float.h); SPUCHECK_MXCSR=0x.... overrides it for
+ * experiments. The reference is integer-only and does not care. */
+static int g_mx_override = -1;
+static spu_fp_env fp_in(void)
+{
+    spu_fp_env o = spu_fp_enter();
+    if (g_mx_override >= 0) _mm_setcsr((unsigned)g_mx_override);
+    return o;
+}
+static void fp_out(spu_fp_env o) { spu_fp_leave(o); }
+
+/* ---------------------------------------------------------------------------
+ * Random state
+ * ------------------------------------------------------------------------ */
+static uint64_t g_rs;
+static uint64_t rnd(void) { g_rs ^= g_rs >> 12; g_rs ^= g_rs << 25; g_rs ^= g_rs >> 27; return g_rs * 0x2545F4914F6CDD1Dull; }
+static uint32_t rnd32(void) { return (uint32_t)(rnd() >> 32); }
+#define PICK(arr) (arr[rnd() % (sizeof arr / sizeof arr[0])])
+
+static const uint32_t int_edges[] = {
+    0, 1, 2, 3, 0xFFFFFFFF, 0xFFFFFFFE, 0x7FFFFFFF, 0x80000000, 0x80000001, 0x0000FFFF, 0xFFFF0000,
+    0x00008000, 0x00007FFF, 0x80008000, 0x7FFF7FFF, 0x7F7F7F7F, 0x80808080, 0x00FF00FF, 0xFF00FF00,
+    0x01010101, 0x7F, 0x80, 0xFF, 0x100, 0x1F, 0x20, 0x3F, 0x40, 0x0003FFF0, 0x0003FFFF, 0x00040000,
