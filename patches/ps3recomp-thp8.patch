new file mode 100644
index 00000000..2c8b5268
--- /dev/null
+++ b/runtime/spu/spu_job_native.h
@@ -0,0 +1,43 @@
+/*
+ * ps3recomp - native SPU job replacement hook.
+ *
+ * A SPURS job-manager policy module branches into each job binary it loaded
+ * (an indirect call out of the module's LS range, spu_indirect_branch). A title
+ * can register a native host implementation for a job binary, keyed by its entry
+ * address and the FNV-1a of the 64 LS bytes there (the same key [game-stats] job
+ * batches / SPU_CAPTURE job= use). At the job's entry branch the runtime calls
+ * the handler instead of the lifted code:
+ *
+ *   return 1  the handler did the job's work on ctx (its LS output, and whatever
+ *             it must leave in registers per the SPU ABI); the runtime then
+ *             returns to the caller exactly like the job's own `bi $0` (SPU_RET).
+ *   return 0  not handled (a layout the handler has not proven): the lifted job
+ *             runs unchanged.
+ *
+ * Only for jobs with no channel traffic of their own (the policy module does all
+ * DMA around them), so nothing the outside world sees can tell the difference
+ * except time. PS3_SPU_JOB_NATIVE=0 disables every handler (runtime kill switch);
+ * titles add their own per-job switches.
+ */
+#ifndef SPU_JOB_NATIVE_H
+#define SPU_JOB_NATIVE_H
+#include "spu_context.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef int (*spu_job_native_fn)(spu_context* ctx, uint32_t key);
+/* key 0 = any job entering at entry_pc (diagnostics: corpus dumps). Up to 8. */
+int  spu_job_native_register(uint32_t entry_pc, uint32_t key, spu_job_native_fn fn);
+/* FNV-1a of the 64 LS bytes at pc (the job key). */
+uint32_t spu_job_key(const spu_context* ctx, uint32_t pc);
+/* Called by spu_indirect_branch for a policy module's branch into job code;
+ * 1 = handled (caller returns like SPU_RET). */
+int  spu_job_native_try(spu_context* ctx);
+/* Run the lifted job at ctx->pc to its return (nested, like a lifted call site);
+ * 0 if no lifted code is registered there. */
+int  spu_job_run_lifted(spu_context* ctx);
+extern volatile int g_spu_job_native_n;
+#ifdef __cplusplus
+}
+#endif
+#endif
