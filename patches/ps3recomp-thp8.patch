diff --git a/libs/audio/cellAudio_web.inc.h b/libs/audio/cellAudio_web.inc.h
new file mode 100644
index 00000000..70b7ee85
--- /dev/null
+++ b/libs/audio/cellAudio_web.inc.h
@@ -0,0 +1,85 @@
+/*
+ * ps3recomp - cellAudio's browser backend (PS3_WASM builds; included by cellAudio.c).
+ *
+ * The mixing thread writes interleaved float stereo at 48 kHz into a single-producer / single-consumer ring in
+ * wasm linear memory; the page's AudioWorklet (web/host/audio-worklet.js) reads it straight out of the shared
+ * WebAssembly.Memory. Indices are free-running frame counters: write_pos is stored by the mixer (release), read_pos
+ * by the worklet (Atomics.store); queued = write_pos - read_pos. The worklet plays silence on an underrun and counts
+ * it. Layout is a JS contract (web/host/audio.js).
+ */
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+
+#define WEB_AUDIO_RING_FRAMES 16384u          /* power of two; ~341 ms at 48 kHz */
+
+typedef struct web_audio_ring {
+    uint32_t version;                         /* +0  = 1 */
+    uint32_t capacity;                        /* +4  frames */
+    uint32_t sample_rate;                     /* +8  */
+    uint32_t channels;                        /* +12 = 2 */
+    volatile uint32_t write_pos;              /* +16 mixer */
+    volatile uint32_t read_pos;               /* +20 worklet */
+    volatile uint32_t underruns;              /* +24 worklet */
+    volatile uint32_t running;                /* +28 1 while the device is open */
+    float data[WEB_AUDIO_RING_FRAMES * 2];    /* +32 */
+} web_audio_ring;
+
+static web_audio_ring s_web_ring = { 1, WEB_AUDIO_RING_FRAMES, CELL_AUDIO_SAMPLE_RATE, 2 };
+static u32 s_web_ahead_blocks = 6;            /* PS3_WEB_AUDIO_BLOCKS: how far the mixer runs ahead */
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+EMSCRIPTEN_KEEPALIVE
+#else
+__attribute__((export_name("ps3_web_audio_ring")))
+#endif
+web_audio_ring* ps3_web_audio_ring(void) { return &s_web_ring; }
+
+static int audio_backend_init(void)
+{
+    const char* e = getenv("PS3_WEB_AUDIO_BLOCKS");
+    if (e && atoi(e) >= 2 && atoi(e) <= 32) s_web_ahead_blocks = (u32)atoi(e);
+    __atomic_store_n(&s_web_ring.running, 1u, __ATOMIC_RELEASE);
+    printf("[cellAudio] web backend: AudioWorklet ring %u frames, %u blocks ahead\n",
+           WEB_AUDIO_RING_FRAMES, s_web_ahead_blocks);
+    return 0;
+}
+
+static void audio_backend_shutdown(void)
+{
+    __atomic_store_n(&s_web_ring.running, 0u, __ATOMIC_RELEASE);
+}
+
+static u32 audio_backend_queued_samples(void)
+{
+    const u32 w = s_web_ring.write_pos;
+    const u32 r = __atomic_load_n(&s_web_ring.read_pos, __ATOMIC_ACQUIRE);
+    return w - r;
+}
+
+static void audio_backend_submit(const float* stereo_samples, u32 num_samples)
+{
+    u32 w = s_web_ring.write_pos;
+    const u32 room = WEB_AUDIO_RING_FRAMES - audio_backend_queued_samples();
+    if (num_samples > room) num_samples = room;           /* worklet stalled (tab hidden): drop, never block */
+    for (u32 i = 0; i < num_samples; i++, w++) {
+        const u32 k = (w & (WEB_AUDIO_RING_FRAMES - 1u)) * 2u;
+        s_web_ring.data[k] = stereo_samples[2 * i];
+        s_web_ring.data[k + 1] = stereo_samples[2 * i + 1];
+    }
+    __atomic_store_n(&s_web_ring.write_pos, w, __ATOMIC_RELEASE);
+}
+
+static int audio_backend_room(void)
+{
+    return audio_backend_queued_samples() < CELL_AUDIO_BLOCK_SAMPLES * s_web_ahead_blocks ? CELL_AUDIO_BLOCK_SAMPLES : 0;
+}
+
+static void audio_backend_wait(void)
+{
+    struct timespec ts = { 0, 1000000 };                  /* 1 ms */
+    nanosleep(&ts, NULL);
+}
+
+static void av_clock_sample(void) {}
