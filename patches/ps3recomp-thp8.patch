index 00000000..f72fa31b
--- /dev/null
+++ b/libs/spurs/web_ucontext.h
@@ -0,0 +1,24 @@
+/*
+ * ps3recomp - ucontext stand-in for WebAssembly (PS3_WASM builds; included by cellFiber.c).
+ *
+ * wasm has no stack switching yet (the stack-switching proposal is not shipped), so cellFiber cannot run fibers
+ * there: every context call fails and logs once. Titles that import cellFiber need JSPI/stack switching first.
+ */
+#ifndef PS3RECOMP_WEB_UCONTEXT_H
+#define PS3RECOMP_WEB_UCONTEXT_H
+#include <stdio.h>
+#include <stddef.h>
+typedef struct { void* ss_sp; size_t ss_size; int ss_flags; } ps3_web_stack_t;
+typedef struct ps3_web_ucontext { struct ps3_web_ucontext* uc_link; ps3_web_stack_t uc_stack; int unused_; } ps3_web_ucontext_t;
+#define ucontext_t  ps3_web_ucontext_t
+#define getcontext  ps3_web_getcontext
+#define makecontext ps3_web_makecontext
+#define swapcontext ps3_web_swapcontext
+#define setcontext  ps3_web_setcontext
+static inline void ps3_web_ucontext_warn(void)
+{ static int once; if (!once) { once = 1; fprintf(stderr, "[cellFiber] fibers are not available on WebAssembly\n"); } }
+static inline int  ps3_web_getcontext(ucontext_t* u) { (void)u; ps3_web_ucontext_warn(); return -1; }
+static inline void ps3_web_makecontext(ucontext_t* u, void (*f)(void), int argc, ...) { (void)u; (void)f; (void)argc; ps3_web_ucontext_warn(); }
+static inline int  ps3_web_swapcontext(ucontext_t* a, const ucontext_t* b) { (void)a; (void)b; ps3_web_ucontext_warn(); return -1; }
+static inline int  ps3_web_setcontext(const ucontext_t* u) { (void)u; ps3_web_ucontext_warn(); return -1; }
+#endif
