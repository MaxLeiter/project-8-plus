+/*
+ * Test for texture replacement in the browser build (libs/video/rsx_texrepl.c under PS3_WASM): the real file with
+ * its WasmFS/POSIX shims (rsx_texrepl_wasm.h) and loader threads, against a recording fake D3D12 device / list, in
+ * node on MEMFS. One scenario per process (texrepl initialises once), chosen by argv[1]:
+ *   main   index (pack order, '_' packs off, loose wins, nested dirs, non-key files ignored), key/find, load on a
+ *          loader thread, finalize (every mip's upload rows == the DDS bytes, one barrier), view (format, LOD
+ *          shift), redirect (tex_redirect path, UTF-8), PS3_TEXREPL_EXTRA_PACKS ('_' pack named), live rescan,
+ *          LRU eviction (retire called), the stats line
+ *   off    PS3_TEXREPL=0: init returns 0, no thread, g_texrepl_on stays 0
+ *   empty  no textures folder anywhere: init returns 0 (zero cost)
+ * Build (from the tree root):
+ *   emcc -O2 -pthread -msimd128 -sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=8 -sEXIT_RUNTIME -DPS3_WASM=1 \
+ *        -DRSX_LIVE_VKD3D=1 -I<vkd3d>/include -I libs/video -I runtime/platform -I runtime/syscalls \
+ *        libs/video/tests/test_wasm_texrepl.c runtime/platform/win32_compat.c -o texrepl.js
+ *   node texrepl.js main && node texrepl.js off && node texrepl.js empty
+ *
+ * Native Linux (rsx_texrepl.c with RSX_LIVE_VKD3D, the POSIX file layer on the host file system): the same
+ * scenarios under a fresh directory named at build time (TR_TEST_DIR, created by the caller, empty), one per
+ * scenario, plus
+ *   ci     packs made on Windows: Textures\ / Sub\ / *.DDS, an EXTRA_PACKS name and a redirect path in the wrong
+ *          case -- all resolved case-insensitively (tr_ci_fix), the file loads
+ * Build (from the tree root; zig cc or gcc):
+ *   cc -O1 -pthread -D_GNU_SOURCE -DRSX_LIVE_VKD3D=1 -DTR_TEST_DIR='"/tmp/trt_main"' -I<vkd3d>/include -I libs/video \
+ *      -I runtime/platform -I runtime/syscalls -I include libs/video/tests/test_wasm_texrepl.c \
+ *      runtime/platform/win32_compat.c -lm -o trt && ./trt main
+ */
+#if !defined(__EMSCRIPTEN__) && !(defined(__linux__) && defined(RSX_LIVE_VKD3D))
+int main(void) { return 0; }
+#else
+#include "../rsx_texrepl.c"
+#if defined(__EMSCRIPTEN__)
+#include <emscripten/emscripten.h>
+#else
+#include <time.h>
+static double emscripten_get_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e3 + t.tv_nsec / 1e6; }
+#endif
+#include <sys/stat.h>
+
+/* the fixture's root: "" in the browser (MEMFS /mods, /hdd0); a fresh host directory on Linux */
+#ifndef TR_TEST_DIR
+#define TR_TEST_DIR ""
+#endif
+#define MR TR_TEST_DIR "/mods"
+#define HR TR_TEST_DIR "/hdd0"
+
+/* ---- runtime stubs ---------------------------------------------------------------------------------------- */
+int g_ft_on = 0;
+void frame_trace_add(int id, long long v) { (void)id; (void)v; }
+long long frame_trace_now_us(void) { return (long long)(emscripten_get_now() * 1000.0); }
+const char* ps3_mods_root(void) { return MR; }
+/* IID storage is owned by the WebGPU layer in the real build (d3d12_webgpu.c, INITGUID) */
+const IID IID_ID3D12Resource = { 0x696442be, 0xa72e, 0x4059, { 0xbc, 0x79, 0x5b, 0x5c, 0x98, 0x04, 0x0f, 0xad } };
+
+static int g_fail;
+#define CHECK(c, ...) do { if (!(c)) { g_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- fake D3D12 ---------------------------------------------------------------------------------------------- */
+typedef struct fres { ID3D12Resource iface; int refs; int is_buf; D3D12_RESOURCE_DESC d; uint8_t* mem; uint64_t size; } fres;
+static ID3D12ResourceVtbl s_rv;
+static volatile int g_live_tex, g_live_buf, g_retired;
+static ULONG STDMETHODCALLTYPE fr_addref(ID3D12Resource* t) { return (ULONG)__atomic_add_fetch(&((fres*)t)->refs, 1, __ATOMIC_SEQ_CST); }
+static ULONG STDMETHODCALLTYPE fr_release(ID3D12Resource* t)
+{
+    fres* r = (fres*)t;
+    const int n = __atomic_sub_fetch(&r->refs, 1, __ATOMIC_SEQ_CST);
+    if (!n) { if (r->is_buf) __atomic_sub_fetch(&g_live_buf, 1, __ATOMIC_SEQ_CST); else __atomic_sub_fetch(&g_live_tex, 1, __ATOMIC_SEQ_CST);
+              free(r->mem); free(r); }
+    return (ULONG)n;
+}
+static HRESULT STDMETHODCALLTYPE fr_map(ID3D12Resource* t, UINT s, const D3D12_RANGE* rr, void** p) { (void)s; (void)rr; *p = ((fres*)t)->mem; return S_OK; }
+static void STDMETHODCALLTYPE fr_unmap(ID3D12Resource* t, UINT s, const D3D12_RANGE* rr) { (void)t; (void)s; (void)rr; }
+
+static ID3D12DeviceVtbl s_dv;
+static ID3D12Device s_fake_dev = { &s_dv };
+static uint32_t fmt_block(DXGI_FORMAT f) { return f == DXGI_FORMAT_BC1_UNORM ? 8 : (f == DXGI_FORMAT_BC2_UNORM || f == DXGI_FORMAT_BC3_UNORM || f == DXGI_FORMAT_BC7_UNORM) ? 16 : 0; }
+static void STDMETHODCALLTYPE fd_footprints(ID3D12Device* t, const D3D12_RESOURCE_DESC* d, UINT first, UINT n, UINT64 base,
+                                            D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp, UINT* rows, UINT64* rb, UINT64* total)
+{
+    (void)t; uint64_t off = base;
+    const uint32_t blk = fmt_block(d->Format);
+    for (UINT i = 0; i < first + n; i++) {
+        const uint32_t w = (uint32_t)(d->Width >> i) ? (uint32_t)(d->Width >> i) : 1, h = (d->Height >> i) ? (d->Height >> i) : 1;
+        const uint32_t bw = blk ? (w + 3) / 4 : w, bh = blk ? (h + 3) / 4 : h, row = blk ? bw * blk : bw * 4;
+        const uint32_t pitch = (row + 255u) & ~255u;
+        off = (off + 511u) & ~511ull;
+        if (i >= first) { const UINT k = i - first; fp[k].Offset = off; fp[k].Footprint.Format = d->Format; fp[k].Footprint.Width = w;
+                          fp[k].Footprint.Height = h; fp[k].Footprint.Depth = 1; fp[k].Footprint.RowPitch = pitch; rows[k] = bh; rb[k] = row; }
+        off += (uint64_t)pitch * bh;
+    }
+    *total = off - base;
+}
+static HRESULT STDMETHODCALLTYPE fd_create(ID3D12Device* t, const D3D12_HEAP_PROPERTIES* hp, D3D12_HEAP_FLAGS hf, const D3D12_RESOURCE_DESC* d,
+                                           D3D12_RESOURCE_STATES st, const D3D12_CLEAR_VALUE* cv, REFIID iid, void** out)
+{
+    (void)t; (void)hf; (void)st; (void)cv; (void)iid;
+    fres* r = (fres*)calloc(1, sizeof *r);
+    r->iface.lpVtbl = &s_rv; r->refs = 1; r->d = *d;
+    r->is_buf = d->Dimension == D3D12_RESOURCE_DIMENSION_BUFFER;
+    if (r->is_buf) { r->size = d->Width; if (hp->Type == D3D12_HEAP_TYPE_UPLOAD) r->mem = (uint8_t*)calloc(1, (size_t)r->size); __atomic_add_fetch(&g_live_buf, 1, __ATOMIC_SEQ_CST); }
+    else __atomic_add_fetch(&g_live_tex, 1, __ATOMIC_SEQ_CST);
+    *out = r;
+    return S_OK;
+}
+static D3D12_RESOURCE_ALLOCATION_INFO* STDMETHODCALLTYPE fd_alloc_info(ID3D12Device* t, D3D12_RESOURCE_ALLOCATION_INFO* ret, UINT mask, UINT n, const D3D12_RESOURCE_DESC* d)
+{
+    (void)mask; (void)n; UINT rows[16]; UINT64 rb[16], total = 0; D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp[16];
+    fd_footprints(t, d, 0, d->MipLevels, 0, fp, rows, rb, &total);
+    (void)total; ret->SizeInBytes = 1u << 20; ret->Alignment = 65536; return ret;   /* 1 MB each: the 1 MB budget evicts */
+}
+
+/* list: records the copies (and checks each against the DDS on disk later) */
+typedef struct { fres* dst; UINT sub; fres* src; D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp; } fcopy;
+static fcopy g_copies[64]; static int g_ncopies, g_nbarriers;
+static ID3D12GraphicsCommandListVtbl s_lv;
+static ID3D12GraphicsCommandList s_fake_list = { &s_lv };
+static void STDMETHODCALLTYPE fl_copy(ID3D12GraphicsCommandList* t, const D3D12_TEXTURE_COPY_LOCATION* dst, UINT x, UINT y, UINT z,
+                                      const D3D12_TEXTURE_COPY_LOCATION* src, const D3D12_BOX* box)
+{
+    (void)t; (void)x; (void)y; (void)z; (void)box;
+    if (g_ncopies < 64) { fcopy* c = &g_copies[g_ncopies++]; c->dst = (fres*)dst->pResource; c->sub = dst->SubresourceIndex;
+                          c->src = (fres*)src->pResource; c->fp = src->PlacedFootprint; fr_addref(src->pResource); }
+}
+static void STDMETHODCALLTYPE fl_barrier(ID3D12GraphicsCommandList* t, UINT n, const D3D12_RESOURCE_BARRIER* b) { (void)t; (void)b; g_nbarriers += (int)n; }
+static void fake_retire(ID3D12Resource* r) { g_retired++; r->lpVtbl->Release(r); }
+
+static void fake_init(void)
+{
+    s_rv.AddRef = fr_addref; s_rv.Release = fr_release; s_rv.Map = fr_map; s_rv.Unmap = fr_unmap;
+    s_dv.CreateCommittedResource = fd_create; s_dv.GetCopyableFootprints = fd_footprints; s_dv.GetResourceAllocationInfo = fd_alloc_info;
+    s_lv.CopyTextureRegion = fl_copy; s_lv.ResourceBarrier = fl_barrier;
+}
+
+/* ---- files ---------------------------------------------------------------------------------------------------- */
+static void mkdirs(const char* p)
+{
+    char b[512]; snprintf(b, sizeof b, "%s", p);
+    for (char* s = b + 1; *s; s++) if (*s == '/') { *s = 0; mkdir(b, 0777); *s = '/'; }
+    mkdir(b, 0777);
+}
+/* a BC1 DDS of w x h with `mips` levels; texel bytes = seed-derived pattern (checked against the uploads) */
+static uint32_t dds_bc1(const char* path, uint32_t w, uint32_t h, uint32_t mips, uint8_t seed)
+{
+    FILE* f = fopen(path, "wb");
+    uint8_t hd[128] = {0}; uint32_t v;
+#define P32(o, x) (v = (x), memcpy(hd + (o), &v, 4))
+    P32(0, FOURCC('D', 'D', 'S', ' ')); P32(4, 124); P32(8, 0x1007u | 0x20000u); P32(12, h); P32(16, w);
+    P32(28, mips); P32(76, 32); P32(80, 0x4u); P32(84, FOURCC('D', 'X', 'T', '1'));
+#undef P32
+    fwrite(hd, 1, 128, f);
+    uint32_t total = 0;
+    for (uint32_t i = 0; i < mips; i++) {
+        const uint32_t lw = (w >> i) ? (w >> i) : 1, lh = (h >> i) ? (h >> i) : 1;
+        const uint32_t n = ((lw + 3) / 4) * ((lh + 3) / 4) * 8;
+        for (uint32_t k = 0; k < n; k++) { const uint8_t b = (uint8_t)(seed + i * 31 + k * 7); fputc(b, f); }
+        total += n;
+    }
+    fclose(f);
+    return total;
+}
+static void touch(const char* path, const char* text) { FILE* f = fopen(path, "wb"); fputs(text, f); fclose(f); }
+
+/* the guest side: DXT1 8x8, 1 mip, chain = 32 bytes */
+static uint8_t g_chain[2][32];
+static texrepl_guest g_gt = { 0x86, 1, 8, 8, 0, 0x1000, 0xAAE4 };
+static uint64_t key_of(int i) { return tr_key(&g_gt, g_chain[i], 32); }
+
+static int wait_loaded(int rec, int ms)
+{
+    const double t0 = emscripten_get_now();
+    while (emscripten_get_now() - t0 < ms) { if (texrepl_wants_list(rec)) return 1; Sleep(1); }
+    return 0;
+}
+
+/* every copy recorded for `tex`: upload rows == the DDS level bytes (pattern of dds_bc1 with `seed`) */
+static void check_copies(fres* tex, uint32_t w, uint32_t h, uint32_t mips, uint8_t seed)
+{
+    int seen = 0;
+    for (int c = 0; c < g_ncopies; c++) {
+        if (g_copies[c].dst != tex) continue;
+        seen++;
+        const uint32_t i = g_copies[c].sub;
+        const uint32_t lw = (w >> i) ? (w >> i) : 1, lh = (h >> i) ? (h >> i) : 1;
+        const uint32_t bw = (lw + 3) / 4, bh = (lh + 3) / 4, rb = bw * 8;
+        const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp = &g_copies[c].fp;
+        int bad = 0;
+        for (uint32_t y = 0; y < bh; y++)
+            for (uint32_t x = 0; x < rb; x++) {
+                const uint8_t want = (uint8_t)(seed + i * 31 + (y * rb + x) * 7);
+                if (g_copies[c].src->mem[fp->Offset + (size_t)y * fp->Footprint.RowPitch + x] != want) bad++;
+            }
+        CHECK(!bad, "mip %u: %d upload bytes differ from the DDS", i, bad);
+    }
+    CHECK(seen == (int)mips, "%d copies recorded for the texture, want %u", seen, mips);
+}
+
+static int scenario_main(void)
+{
+    for (int i = 0; i < 2; i++) for (int k = 0; k < 32; k++) g_chain[i][k] = (uint8_t)(i * 97 + k * 13 + 1);
+    char p[512];
+    const uint64_t k0 = key_of(0), k1 = key_of(1);
+    /* packs: "Beta" (later in name order) beats "alpha"; loose beats both; "_off" and ".hidden" are not scanned */
+    mkdirs(MR "/alpha/textures/sub/deeper"); mkdirs(MR "/Beta/textures"); mkdirs(MR "/textures");
+    mkdirs(MR "/_off/textures"); mkdirs(MR "/.hidden/textures"); mkdirs(MR "/_xbox/textures"); mkdirs(HR "/p8plus");
+    snprintf(p, sizeof p, MR "/alpha/textures/sub/deeper/%016llx.dds", (unsigned long long)k0); dds_bc1(p, 16, 16, 5, 11);
+    snprintf(p, sizeof p, MR "/Beta/textures/%016llX.dds", (unsigned long long)k0); dds_bc1(p, 16, 16, 5, 22);   /* upper-case hex */
+    snprintf(p, sizeof p, MR "/textures/%016llx.dds", (unsigned long long)k0); dds_bc1(p, 32, 32, 6, 33);       /* loose: wins, k = 4 */
+    snprintf(p, sizeof p, MR "/alpha/textures/%016llx.dds", (unsigned long long)k1); dds_bc1(p, 8, 8, 4, 44);      /* k = 1 */
+    snprintf(p, sizeof p, MR "/_off/textures/%016llx.dds", 0x1111111111111111ull); dds_bc1(p, 8, 8, 1, 1);
+    snprintf(p, sizeof p, MR "/.hidden/textures/%016llx.dds", 0x2222222222222222ull); dds_bc1(p, 8, 8, 1, 1);
+    snprintf(p, sizeof p, MR "/_xbox/textures/%016llx.dds", 0x3333333333333333ull); dds_bc1(p, 8, 8, 1, 1);
+    touch(MR "/alpha/textures/index.json", "{}"); touch(MR "/alpha/textures/notakey.dds", "x");
+    touch(MR "/alpha/textures/0123456789abcdeg.dds", "x");
+    setenv("PS3_TEXREPL_BUDGET_MB", "1", 1);
+
+    /* a plugin's redirect before the device exists (ps3mod_init) is queued and applied at init */
+    dds_bc1(HR "/p8plus/eye_\xc3\xa9.dds", 16, 16, 1, 55);   /* UTF-8 path */
+    CHECK(texrepl_redirect_utf8(k1, HR "/p8plus/eye_\xc3\xa9.dds") == 0, "redirect before init");
+
+    CHECK(texrepl_init(&s_fake_dev, fake_retire) == 1, "init: not active");
+    CHECK(g_texrepl_on == 1, "g_texrepl_on");
+    CHECK(s_nthreads == 2, "loader threads %d, want 2", s_nthreads);
+    CHECK(s_budget == (1ull << 20), "budget %llu", (unsigned long long)s_budget);
+    int idx = 0;
+    for (uint32_t i = 0; i < s_nrec; i++) idx += !s_rec[i].is_alt;
+    CHECK(idx == 2, "%d keyed records, want 2 (k0, k1; '_' / '.' packs and non-key files ignored)", idx);
+    CHECK(tr_ht_find(0x1111111111111111ull) < 0 && tr_ht_find(0x3333333333333333ull) < 0, "disabled pack indexed");
+    CHECK(s_dups == 2, "dups %u, want 2", s_dups);
+
+    /* find + load + finalize, k0 = the loose 32x32 */
+    const int r0 = texrepl_find(&g_gt, g_chain[0], 32, NULL);
+    CHECK(r0 >= 0, "find k0");
+    CHECK(texrepl_find(&g_gt, "nothing like the chain........!!", 32, NULL) < 0, "find miss");
+    texrepl_view v;
+    texrepl_frame(1, 0);
+    CHECK(texrepl_acquire(r0, &s_fake_list, &v) == 0, "first acquire must queue");
+    CHECK(wait_loaded(r0, 5000), "k0 not loaded within 5 s");
+    CHECK(texrepl_acquire(r0, NULL, &v) == 0, "acquire without a list finalizes nothing");
+    CHECK(texrepl_acquire(r0, &s_fake_list, &v) == 1, "acquire after load");
+    CHECK(v.fmt == DXGI_FORMAT_BC1_UNORM && v.shift_fx == 512 && v.gen != 0, "view fmt %d shift %u gen %u", (int)v.fmt, v.shift_fx, v.gen);
+    check_copies((fres*)v.tex, 32, 32, 6, 33);
+    CHECK(g_nbarriers == 1, "barriers %d", g_nbarriers);
+
+    /* k1 is redirected to the /hdd0 file (k = 2) */
+    const int r1 = texrepl_find(&g_gt, g_chain[1], 32, NULL);
+    CHECK(r1 >= 0, "find k1");
+    texrepl_frame(2, 0);
+    texrepl_acquire(r1, &s_fake_list, &v);
+    int got = 0;
+    for (int i = 0; i < 2000 && !got; i++) { got = texrepl_acquire(r1, &s_fake_list, &v); if (!got) Sleep(2); }
+    CHECK(got && v.shift_fx == 256, "redirect target served (got %d shift %u)", got, v.shift_fx);
+
+    /* PS3_TEXREPL_EXTRA_PACKS names a '_' pack: a live rescan picks it up */
+    setenv("PS3_TEXREPL_EXTRA_PACKS", "_xbox", 1);
+    snprintf(p, sizeof p, MR "/Beta/textures/%016llx.dds", 0x4444444444444444ull); dds_bc1(p, 8, 8, 1, 1);
+    const uint32_t ep = g_texrepl_epoch;
+    uint32_t out[4];
+    volatile int rc = -9;
+    /* texrepl_rescan waits for the render thread (texrepl_frame): run the frame here meanwhile */
+    s_rescan_req++;
+    texrepl_frame(3, 0);
+    rc = s_rescan_done == s_rescan_req ? 0 : -2;
+    memcpy(out, s_rescan_out, sizeof out);
+    CHECK(rc == 0 && out[1] == 2, "rescan rc %d added %u (want the _xbox key + the new Beta key)", rc, out[1]);
+    CHECK(tr_ht_find(0x3333333333333333ull) >= 0 && tr_ht_find(0x4444444444444444ull) >= 0, "rescan keys");
+    CHECK(g_texrepl_epoch != ep, "epoch not bumped");
+
+    /* LRU: budget 1 MB, both residents idle for > 120 frames -> evicted, retire called on their textures */
+    const int ret0 = g_retired;
+    texrepl_frame(400, 0);
+    CHECK(s_evictions >= 1 && g_retired > ret0, "eviction (evictions %llu retired %d)", (unsigned long long)s_evictions, g_retired - ret0);
+    CHECK(texrepl_acquire(r0, &s_fake_list, &v) == 0, "evicted record must reload");
+    texrepl_frame(401, 2);   /* the stats line, hash time included */
+    texrepl_shutdown();
+    return g_fail;
+}
+
+int main(int argc, char** argv)
+{
+    fake_init();
+    const char* sc = argc > 1 ? argv[1] : "main";
+    int rc = 0;
+    if (!strcmp(sc, "main")) rc = scenario_main();
+    else if (!strcmp(sc, "off")) {
+        setenv("PS3_TEXREPL", "0", 1);
+        mkdirs(MR "/p/textures"); char p[128]; snprintf(p, sizeof p, MR "/p/textures/%016llx.dds", 0x5555555555555555ull); dds_bc1(p, 8, 8, 1, 1);
+        CHECK(texrepl_init(&s_fake_dev, fake_retire) == 0 && !g_texrepl_on && !s_nthreads && !s_nrec, "PS3_TEXREPL=0 must stay off");
+        rc = g_fail;
+#if !defined(__EMSCRIPTEN__)
+    } else if (!strcmp(sc, "ci")) {
+        /* a pack made on Windows: Gamma\Textures\Sub\<KEY>.DDS; an extra pack named "_XBOX" that is "_xbox" on disk */
+        for (int k = 0; k < 32; k++) g_chain[0][k] = (uint8_t)(k * 13 + 1);
+        const uint64_t k0 = key_of(0);
+        char p[512];
+        mkdirs(MR "/Gamma/Textures/Sub"); mkdirs(MR "/_xbox/textures"); mkdirs(HR "/P8Plus");
+        snprintf(p, sizeof p, MR "/Gamma/Textures/Sub/%016llX.DDS", (unsigned long long)k0); dds_bc1(p, 16, 16, 5, 77);
