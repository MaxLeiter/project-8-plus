+static u64 av_now_us(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (u64)(c.QuadPart / f.QuadPart) * 1000000ull +
+           (u64)(c.QuadPart % f.QuadPart) * 1000000ull / (u64)f.QuadPart;
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (u64)ts.tv_sec * 1000000ull + (u64)ts.tv_nsec / 1000ull;
+#endif
+}
+
+static int av_enabled(void)
+{
+    if (s_av_on >= 0) return s_av_on;
+    const char* p = getenv("PS3_AVSYNC_LOG");
+    s_av_on = 0;
+    if (p && *p) {
+        char fn[600];
+        snprintf(fn, sizeof fn, "%s.audio.bin", p);  s_av_audio  = fopen(fn, "wb");
+        snprintf(fn, sizeof fn, "%s.clock.csv", p);  s_av_clock  = fopen(fn, "wb");
+        snprintf(fn, sizeof fn, "%s.events.csv", p); s_av_events = fopen(fn, "wb");
+        if (s_av_clock)  fprintf(s_av_clock, "qpc_us,pos_frames,qpcpos_us,padding\n");
+        if (s_av_events) fprintf(s_av_events, "qpc_us,event,port,read_index\n");
+        s_av_on = s_av_audio && s_av_clock && s_av_events;
+        printf("[cellAudio] PS3_AVSYNC_LOG: %s (%s.*)\n", s_av_on ? "on" : "FAILED to open", p);
+    }
+    return s_av_on;
+}
+
+static void av_event(const char* ev, int port, u64 ridx)
+{
