+static void test_atomics_more(void)
+{
+    spu_context* a = new_ctx(0x57);
+    spu_context* b = new_ctx(0x58);
+
+    /* PUTLLUC to the line this SPU has reserved consumes the reservation like a
+     * successful PUTLLC, without raising Lr on the issuer (RPCS3 do_putlluc). */
+    TEST("atomic.putlluc-own-line");
+    wr(a, SPU_WrEventAck, 0xFFFFFFFFu);
+    fill(vm_base + EA_LINE, 128, 0x60);
+    getllar(a, 0x7000, EA_LINE);
+    a->ls[0x7004] ^= 1;
+    putlluc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 2);
+    CHECK(memcmp(vm_base + EA_LINE, a->ls + 0x7000, 128) == 0);
+    CHECK_EQ(a->event_status & 0x400, 0);
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);                 /* the reservation is gone */
+
+    /* PUTLLUC to another line leaves this SPU's reservation alone. */
+    TEST("atomic.putlluc-other-line");
+    getllar(a, 0x7000, EA_LINE);
+    fill(a->ls + 0x7100, 128, 0x3C);
+    putlluc(a, 0x7100, EA_LINE2);
+    CHECK(memcmp(vm_base + EA_LINE2, a->ls + 0x7100, 128) == 0);
+    a->ls[0x7008] ^= 1;
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 0);
+    CHECK_EQ(a->event_status & 0x400, 0);
+
+    /* PUTQLLUC: the queued form. Stores unconditionally, takes every peer's
+     * reservation, completes its tag group, and reports nothing through
+     * MFC_RdAtomicStat (RPCS3: only GETLLAR, PUTLLC and PUTLLUC set it). */
+    TEST("atomic.putqlluc");
+    getllar(b, 0x7000, EA_LINE);
+    getllar(a, 0x7000, EA_LINE);                          /* RdAtomicStat = 4, unread */
+    fill(a->ls + 0x7100, 128, 0x5D);
+    mfc(a, MFC_PUTQLLUC_CMD, 0x7100, EA_LINE, 128, 7);
+    CHECK(memcmp(vm_base + EA_LINE, a->ls + 0x7100, 128) == 0);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 4);
+    CHECK_EQ(tag_wait(a, 1u << 7, MFC_TAG_UPDATE_ALL), 1u << 7);
+    putllc(b, 0x7000, EA_LINE);
+    CHECK_EQ(rd(b, MFC_RdAtomicStat), 1);
+    CHECK(b->event_status & 0x400);
+    wr(b, SPU_WrEventAck, 0xFFFFFFFFu);
+
+    /* A PUTLLC that finds its reserved line changed -- by a store that
+     * bypassed the coherence hooks, so no one told it -- fails AND raises Lr:
+     * the reservation was lost (RPCS3 do_putllc). */
+    TEST("atomic.putllc-fail-raises-lr");
+    wr(a, SPU_WrEventAck, 0xFFFFFFFFu);
+    getllar(a, 0x7000, EA_LINE);
+    vm_base[EA_LINE + 0x10] ^= 0x77;
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    CHECK(a->event_status & 0x400);
+    /* ...but a PUTLLC with no reservation at all raises nothing. */
+    wr(a, SPU_WrEventAck, 0xFFFFFFFFu);
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    CHECK_EQ(a->event_status & 0x400, 0);
+
+    /* One reservation per SPU: a GETLLAR of another line replaces it. And a
+     * PUTLLC consumes the reservation whether or not it succeeds -- also when
+     * it names a different line (RPCS3 do_putllc: raddr = 0 on failure). */
+    TEST("atomic.getllar-replaces");
+    getllar(a, 0x7000, EA_LINE);
+    getllar(a, 0x7100, EA_LINE2);
+    a->ls[0x7101] ^= 2;
+    putllc(a, 0x7100, EA_LINE2);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 0);
+    getllar(a, 0x7000, EA_LINE);
+    getllar(a, 0x7100, EA_LINE2);
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    putllc(a, 0x7100, EA_LINE2);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+
+    /* Lr is recorded while it is masked and becomes readable once enabled. */
+    TEST("atomic.lr-pending-while-masked");
+    wr(a, SPU_WrEventAck, 0xFFFFFFFFu); wr(a, SPU_WrEventMask, 0);
+    getllar(a, 0x7000, EA_LINE);
+    ppu_store32(EA_LINE + 0x20, 0xABCDu);
+    CHECK_EQ(cnt(a, SPU_RdEventStat), 0);
+    wr(a, SPU_WrEventMask, 0x400);
+    CHECK_EQ(cnt(a, SPU_RdEventStat), 1);
+    CHECK_EQ(rd(a, SPU_RdEventStat), 0x400);
+    wr(a, SPU_WrEventAck, 0x400); wr(a, SPU_WrEventMask, 0);
+
+    free_ctx(a); free_ctx(b);
+}
+
+/* event_status has producers on several host threads at once: this SPU's own
+ * (Tg on WrTagUpdate, Sn on a list stall, the WrEventAck clear) and others
+ * (S1/S2 from write_snr, Lr from a peer's or the PPU's store). A read-modify-
+ * write that is not atomic against the rest loses a bit or revives one. Here
+ * the SPU thread raises and acknowledges Tg flat out while the PPU thread
+ * delivers SNR1 (raising S1) and acknowledges S1; neither ever touches the
+ * other's bit, so S1 must be set exactly from each delivery to its ack. */
+typedef struct { spu_context* c; volatile LONG stop; long iters; } tg_arg;
+static DWORD WINAPI tg_thread(LPVOID p)
+{
+    tg_arg* a = (tg_arg*)p;
+    while (!a->stop) {
+        wr(a->c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ANY);     /* raises Tg (enabled) */
+        wr(a->c, SPU_WrEventAck, 0x1);
+        a->iters++;
+    }
+    return 0;
+}
+static void test_event_status_atomic(void)
+{
+    TEST("event.status-atomic");
+    spu_context* c = new_ctx(0x59);
+    wr(c, MFC_WrTagMask, 1); wr(c, SPU_WrEventMask, 0x201);
+    tg_arg a = { c, 0, 0 };
+    HANDLE h = CreateThread(NULL, 0, tg_thread, &a, 0, NULL);
+    int lost = 0, revived = 0;
+    const uint64_t end = qpc_ns() + 1500000000ull;       /* 1.5 s */
+    long rounds = 0;
+    while (qpc_ns() < end) {
+        if (c->event_status & 0x200) revived++;             /* acked last round */
+        ppu_snr(c, 0, (uint32_t)rounds, 0);                 /* empty -> pending: raises S1 */
+        for (int k = 0; k < 20; k++) YieldProcessor();
+        if (!(c->event_status & 0x200)) lost++;
+        (void)spu_channel_read(&c->ch_sig_notify[0]);       /* empty the register again */
+        wr(c, SPU_WrEventAck, 0x200);
+        rounds++;
+    }
+    InterlockedExchange(&a.stop, 1);
+    WaitForSingleObject(h, 5000); CloseHandle(h);
+    printf("  [event.status-atomic] %ld S1 deliveries against %ld Tg raise/ack pairs: %d lost, %d revived\n",
+           rounds, a.iters, lost, revived);
+    CHECK_EQ(lost, 0);
+    CHECK_EQ(revived, 0);
+    wr(c, SPU_WrEventMask, 0);
+    free_ctx(c);
+}
+
+static void test_signals_events_more(void)
+{
+    spu_context* c = new_ctx(0x5A);
+
+    /* S1/S2 are raised on the empty -> pending edge of the register only, are
+     * recorded whether or not they are enabled, and are cleared by the ack. */
+    TEST("event.snr-edges");
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu);
+    ppu_snr(c, 0, 5, 0);
+    CHECK_EQ(c->event_status & 0x300, 0x200);
+    wr(c, SPU_WrEventMask, 0x100);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);                  /* S2 enabled, only S1 pending */
+    wr(c, SPU_WrEventMask, 0x300);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x200);
+    wr(c, SPU_WrEventAck, 0x200);
+    ppu_snr(c, 0, 6, 0);                                    /* still pending: no new edge */
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    CHECK_EQ(rd(c, SPU_RdSigNotify1), 6);
+    ppu_snr(c, 0, 7, 0);                                    /* empty again: an edge */
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x200);
+    ppu_snr(c, 1, 1, 1); ppu_snr(c, 1, 2, 1);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x300);
+    CHECK_EQ(rd(c, SPU_RdSigNotify2), 3);
+    CHECK_EQ(rd(c, SPU_RdSigNotify1), 7);
+    wr(c, SPU_WrEventAck, 0x300);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    wr(c, SPU_WrEventMask, 0);
+
+    /* A thread parked in rdch SPU_RdEventStat (evmask S1) wakes on the SNR
+     * write that raises S1. */
+    TEST("event.snr-blocking-eventstat");
+    { spu_context* s = new_ctx(0x5B);
+      s->ch_block = 1;
+      ev_arg e; memset(&e, 0, sizeof e); e.ctx = s;
+      HANDLE h = CreateThread(NULL, 0, ev_thread, &e, 0, NULL);
+      enum { N = 400 };
+      int lost = 0, ok = 1; double worst = 0;
+      srand(4242);
+      wr(s, SPU_WrEventMask, 0x200);
+      for (int i = 1; i <= N; i++) {
+          InterlockedExchange(&e.go, i);
+          if (i == 1) { CHECK(await_parked(s, GetThreadId(h))); Sleep(20); CHECK_EQ(e.done, 0); }
+          else spin_us((unsigned)(rand() % 60));
+          uint64_t t_wr = qpc_ns();
+          ppu_snr(s, 0, (uint32_t)i, 0);
+          int r = await_or_lost(&e.done, i, GetThreadId(h));
+          if (r == 1) lost++;
+          if (r == 2) { CHECK_EQ(e.done, i); break; }
+          if (e.got != 0x200) ok = 0;
+          double ms = e.t_ret > t_wr ? (double)(e.t_ret - t_wr) / 1e6 : 0;
+          if (ms > worst) worst = ms;
+          (void)spu_channel_read(&s->ch_sig_notify[0]);
+          wr(s, SPU_WrEventAck, 0x200);
+      }
+      CHECK(ok);
+      InterlockedExchange(&e.go, -1);
+      WaitForSingleObject(h, 5000); CloseHandle(h);
+      printf("  [event.snr-blocking-eventstat] %d handoffs: worst %.2f ms, lost wakes: %d\n", N, worst, lost);
+      CHECK_EQ(lost, 0);
+      wr(s, SPU_WrEventMask, 0);
+      free_ctx(s); }
+
+    /* Events the runtime does not raise. */
+    TEST("event.unmodelled");
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu);
+    wr(c, SPU_WrDec, 100); wr(c, SPU_WrEventMask, 0x20);
+    Sleep(2);
+    NOTE(cnt(c, SPU_RdEventStat) == 1, "Tm (0x20): the decrementer passing zero raises no event");
+    wr(c, SPU_WrEventMask, 0x80);
+    NOTE(cnt(c, SPU_RdEventStat) == 1, "Le (0x80, outbound mailbox available), Me (0x40), Mb (0x10), Qv (0x8), A, MS are never raised");
+    wr(c, SPU_WrEventMask, 0x1);
+    wr(c, MFC_WrTagMask, 1); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL);
+    (void)rd(c, SPU_RdEventStat);
+    NOTE(cnt(c, SPU_RdEventStat) == 0,
+         "rchcnt(SPU_RdEventStat) stays 1 after the read while the event is unacknowledged (RPCS3: the read consumes the count)");
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu); wr(c, SPU_WrEventMask, 0);
+    free_ctx(c);
+}
+
+/* ---------------------------------------------------------------------------
+ * Symbols the runtime pulls in from the rest of the port (PPU loader, SPURS
+ * HLE, title hooks). None is on a path these tests drive.
+ * -----------------------------------------------------------------------*/
+uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid, g_ydkj_real_spurs_ea;
+uint32_t g_barrier_sync_watch;
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int      g_resv_store_active;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; }
+unsigned long long ps3_ms_now(void) { return GetTickCount64(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+uint64_t spurs_pm_build_context(uint8_t* ls, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{ (void)ls; (void)a; (void)b; (void)c; (void)d; return 0; }
+void ydkj_wake_all_event_flags(void) {}
+
+int main(void)
+{
+    vm_base = (uint8_t*)VirtualAlloc(NULL, GUEST_SIZE, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!vm_base) { printf("cannot allocate guest memory\n"); return 2; }
+    ppu_vm_size = GUEST_SIZE;
+    setvbuf(stdout, NULL, _IONBF, 0);
+
+    test_mailboxes();
+    test_snr();
+    test_mfc_getput();
+    test_mfc_fence_barrier_tags();
+    test_mfc_list();
+    test_atomics();
+    test_atomic_contention();
+    test_llar_park();
+    test_lr_blocking();
+    test_events();
+    test_mfc_variants();
+    test_mfc_list_more();
+    test_atomics_more();
+    test_event_status_atomic();
+    test_signals_events_more();
+
+    printf("SPU channels/MFC/atomics/events: %d passed, %d failed, %d notes\n", g_pass, g_fail, g_notes);
+    return g_fail ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_float.c b/runtime/spu/tests/test_spu_float.c
new file mode 100644
index 00000000..9c70c40a
--- /dev/null
+++ b/runtime/spu/tests/test_spu_float.c
@@ -0,0 +1,242 @@
+/*
+ * SPU floating point: the SSE fast paths of spu_float.h must equal the exact
+ * integer model (spu__sp_*) for every input, under the SPU host environment
+ * (round toward zero, DAZ, FTZ) that spu_run_with_halt sets; plus spot checks
+ * of the architectural rules (extended range, saturation, +0, fused fma,
+ * truncating conversions, integer-ordered compares) and of the DP helpers.
+ *
+ *   clang-cl -O2 -msse4.1 -fno-strict-aliasing /clang:-ffp-contract=off -I runtime/spu -I include
+ *            runtime/spu/tests/test_spu_float.c -Fe:test_spu_float.exe && test_spu_float.exe [iterations]
+ */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static int g_fail, g_pass;
+#define CHECK(c, ...) do { if (c) g_pass++; else { if (g_fail++ < 40) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)(s_rng >> 16); }
+
+/* Biased float bit patterns: zeros, denormals, exponent-255, near-overflow,
+ * near-underflow, ones, random. */
+static uint32_t rnd_f(void)
+{
+    uint32_t s = rnd() & 0x80000000u, m = rnd() & 0x7FFFFFu;
+    switch (rnd() % 12) {
+    case 0: return s;
+    case 1: return s | m;                                   /* denormal */
+    case 2: return s | 0x7F800000u | m;                     /* exponent 255 */
+    case 3: return s | ((250u + rnd() % 6) << 23) | m;      /* near overflow */
+    case 4: return s | ((1u + rnd() % 6) << 23) | m;        /* near underflow */
+    case 5: return s | 0x3F800000u;                         /* +-1 */
+    case 6: return s | 0x7F7FFFFFu;                         /* FLT_MAX */
+    case 7: return s | (((rnd() % 40) + 107u) << 23) | (m & 0x7FFF00u);  /* few bits */
+    default: return s | ((1u + rnd() % 254) << 23) | m;
+    }
+}
+static u128 rnd_v(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = rnd_f(); return r; }
+
+static int veq(u128 a, u128 b) { return memcmp(&a, &b, 16) == 0; }
+
+/* spu_float.h's special-lane fix-up switch (the runtime's is env + off-file driven): the test runs every check
+ * with the fast double model, and the block below also forces it onto ALL lanes against the integer model. */
+static int g_fastfix = 1;
+int spu_fp_fastfix_on(void) { return g_fastfix; }
+volatile int g_spu_fp_fastfix = 2;   /* always ask spu_fp_fastfix_on() */
+
+int main(int argc, char** argv)
+{
+    long iters = argc > 1 ? atol(argv[1]) : 2000000;
+    spu_fp_env env = spu_fp_enter();
+
+    /* --dump N: print "op a b c result" per lane of N random vectors for the
+     * exact-rational oracle (spu_float_oracle.py). */
+    if (argc > 2 && !strcmp(argv[1], "--dump")) {
+        long n = atol(argv[2]);
+        for (long it = 0; it < n; it++) {
+            u128 a = rnd_v(), b = rnd_v(), c = rnd_v(), r[6];
+            r[0] = spu_fa(a, b); r[1] = spu_fs(a, b); r[2] = spu_fm(a, b);
+            r[3] = spu_fma(a, b, c); r[4] = spu_fms(a, b, c); r[5] = spu_fnms(a, b, c);
+            static const char* nm[6] = { "fa", "fs", "fm", "fma", "fms", "fnms" };
+            for (int k = 0; k < 6; k++)
+                for (int i = 0; i < 4; i++)
+                    printf("%s %08X %08X %08X %08X\n", nm[k], a._u32[i], b._u32[i], c._u32[i], r[k]._u32[i]);
+            int i8 = (int)(rnd() & 0xFF);
+            u128 iv; for (int i = 0; i < 4; i++) iv._u32[i] = (rnd() & 1) ? rnd() : (rnd() % 100000u) - 50000u;
+            u128 rc = spu_csflt(iv, i8);
+            for (int i = 0; i < 4; i++) printf("csflt%d %08X 00000000 00000000 %08X\n", i8, iv._u32[i], rc._u32[i]);
+        }
+        spu_fp_leave(env);
+        return 0;
+    }
+
+    /* --- fma near-cancellation: c ~ -(a*b), where one vs two roundings would differ first --- */
+    for (long it = 0; it < iters; it++) {
+        u128 a = rnd_v(), b = rnd_v(), c, e, r;
+        for (int i = 0; i < 4; i++) {
+            float p = a._f32[i] * b._f32[i];
+            uint32_t pb; memcpy(&pb, &p, 4);
+            c._u32[i] = (pb ^ 0x80000000u) + (rnd() % 7u) - 3u;   /* -(a*b) rounded, +-3 ulp */
+        }
+        r = spu_fma(a, b, c); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 0, 0);
+        CHECK(veq(r, e), "fma-cancel %08X*%08X+%08X: %08X want %08X", a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fms(a, b, c); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 0, 1);
+        CHECK(veq(r, e), "fms-cancel %08X*%08X-%08X: %08X want %08X", a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fnms(a, b, c); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 1, 0);
+        CHECK(veq(r, e), "fnms-cancel %08X-%08X*%08X: %08X want %08X", c._u32[0], a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+    }
+    /* --- fast exact fix-up model (double) == integer model on every lane (bad mask forced to 0xF) --- */
+    for (long it = 0; it < iters; it++) {
+        u128 a = rnd_v(), b = rnd_v(), c = rnd_v(), z = spu_splat_u32(0x12345678u), e, r;
+        for (uint32_t nb = 0; nb < 2; nb++) {
+            r = spu__fa_fix(z, 0xF, a, b, nb); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fa1(a._u32[i], b._u32[i], nb);
+            CHECK(veq(r, e), "fastfix fa%u %08X,%08X: %08X want %08X", nb, a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+        }
+        r = spu__fm_fix(z, 0xF, a, b); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fm1(a._u32[i], b._u32[i]);
+        CHECK(veq(r, e), "fastfix fm %08X*%08X: %08X want %08X", a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+        for (uint32_t k = 0; k < 4; k++) {
+            const uint32_t np = k & 1, nc = k >> 1;
+            r = spu__fma_fix(z, 0xF, a, b, c, np, nc);
+            for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], np, nc);
+            CHECK(veq(r, e), "fastfix fma%u%u %08X*%08X+%08X: %08X want %08X", np, nc, a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+        }
+        /* near-cancellation for the fused path: c ~ -(a*b) */
+        for (int i = 0; i < 4; i++) { float pf = a._f32[i] * b._f32[i]; uint32_t pb; memcpy(&pb, &pf, 4);
+            c._u32[i] = (pb ^ 0x80000000u) + (rnd() % 7u) - 3u; }
+        r = spu__fma_fix(z, 0xF, a, b, c, 0, 0);
+        for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 0, 0);
+        CHECK(veq(r, e), "fastfix fma-cancel %08X*%08X+%08X: %08X want %08X", a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+    }
+    /* the same under round-to-nearest (a helper called outside the SPU environment): the model sets RTZ itself */
+    { spu_fp_env rn = _mm_getcsr(); _mm_setcsr(rn & ~0x6000u);
+      for (long it = 0; it < iters / 4; it++) {
+        u128 a = rnd_v(), b = rnd_v(), c = rnd_v(), z = spu_splat_u32(0), e, r;
+        r = spu__fma_fix(z, 0xF, a, b, c, 0, 0);
+        for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 0, 0);
+        CHECK(veq(r, e), "fastfix(RN env) fma %08X*%08X+%08X: %08X want %08X", a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+        r = spu__fa_fix(z, 0xF, a, b, 1);
+        for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fa1(a._u32[i], b._u32[i], 1);
+        CHECK(veq(r, e), "fastfix(RN env) fs %08X-%08X: %08X want %08X", a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+      }
+      _mm_setcsr(rn); }
+    /* --- fast path == exact model --- */
+    for (long it = 0; it < iters; it++) {
+        u128 a = rnd_v(), b = rnd_v(), c = rnd_v(), e;
+        u128 r;
+        r = spu_fa(a, b); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fa1(a._u32[i], b._u32[i], 0);
+        CHECK(veq(r, e), "fa %08X+%08X: %08X want %08X", a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fs(a, b); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fa1(a._u32[i], b._u32[i], 1);
+        CHECK(veq(r, e), "fs %08X-%08X: %08X want %08X", a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fm(a, b); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fm1(a._u32[i], b._u32[i]);
+        CHECK(veq(r, e), "fm %08X*%08X: %08X want %08X", a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fma(a, b, c); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 0, 0);
+        CHECK(veq(r, e), "fma %08X*%08X+%08X: %08X want %08X", a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fms(a, b, c); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 0, 1);
+        CHECK(veq(r, e), "fms %08X*%08X-%08X: %08X want %08X", a._u32[0], b._u32[0], c._u32[0], r._u32[0], e._u32[0]);
+        r = spu_fnms(a, b, c); for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], 1, 0);
+        CHECK(veq(r, e), "fnms %08X-%08X*%08X: %08X want %08X", c._u32[0], a._u32[0], b._u32[0], r._u32[0], e._u32[0]);
+        int i8 = (int)(rnd() & 0xFF);
+        u128 iv; for (int i = 0; i < 4; i++) iv._u32[i] = (rnd() & 1) ? rnd() : (rnd() % 100000u) - 50000u;
+        r = spu_csflt(iv, i8);
+        for (int i = 0; i < 4; i++) { int32_t v = iv._s32[i];
+            e._u32[i] = spu__sp_from_int(v < 0, v < 0 ? (uint64_t)(0 - (int64_t)v) : (uint64_t)v, i8 - 155); }
+        CHECK(veq(r, e), "csflt %08X,%d: %08X want %08X", iv._u32[0], i8, r._u32[0], e._u32[0]);
+        /* vector conversions == the scalar exact models */
+        r = spu_cuflt(iv, i8);
+        for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_from_int(0, iv._u32[i], i8 - 155);
+        CHECK(veq(r, e), "cuflt %08X,%d: %08X want %08X", iv._u32[0], i8, r._u32[0], e._u32[0]);
+        { u128 fv = rnd_v();
+          r = spu_cflts(fv, i8);
+          for (int i = 0; i < 4; i++) e._s32[i] = spu__cflts1(fv._u32[i], 173 - i8);
+          CHECK(veq(r, e), "cflts %08X,%d: %08X want %08X", fv._u32[0], i8, r._u32[0], e._u32[0]);
+          r = spu_cfltu(fv, i8);
+          for (int i = 0; i < 4; i++) e._u32[i] = spu__cfltu1(fv._u32[i], 173 - i8);
+          CHECK(veq(r, e), "cfltu %08X,%d: %08X want %08X", fv._u32[0], i8, r._u32[0], e._u32[0]); }
+    }
+    /* conversions: every i8 x every exponent field x sign, with edge fractions */
+    for (int i8 = 0; i8 < 256; i8++)
+        for (uint32_t ex = 0; ex < 256; ex++) {
+            static const uint32_t fr[4] = { 0, 1, 0x400000u, 0x7FFFFFu };
+            u128 fv, r, e;
+            for (int i = 0; i < 4; i++) fv._u32[i] = ((uint32_t)(i & 1) << 31) | (ex << 23) | fr[(i + ex) & 3];
+            r = spu_cflts(fv, i8);
+            for (int i = 0; i < 4; i++) e._s32[i] = spu__cflts1(fv._u32[i], 173 - i8);
+            CHECK(veq(r, e), "cflts sweep ex=%u i8=%d: %08X want %08X", ex, i8, r._u32[0], e._u32[0]);
+            r = spu_cfltu(fv, i8);
+            for (int i = 0; i < 4; i++) e._u32[i] = spu__cfltu1(fv._u32[i], 173 - i8);
+            CHECK(veq(r, e), "cfltu sweep ex=%u i8=%d: %08X want %08X", ex, i8, r._u32[0], e._u32[0]);
+            u128 iv;
+            for (int i = 0; i < 4; i++) iv._u32[i] = (ex << 24) | (ex << 8) | fr[i];
+            iv._u32[3] = 0xFFFFFFFFu - ex;
+            r = spu_cuflt(iv, i8);
+            for (int i = 0; i < 4; i++) e._u32[i] = spu__sp_from_int(0, iv._u32[i], i8 - 155);
+            CHECK(veq(r, e), "cuflt sweep %08X i8=%d: %08X want %08X", iv._u32[0], i8, r._u32[0], e._u32[0]);
+        }
+
+    /* --- architectural spot checks --- */
+    { u128 a = spu_splat_u32(0x7F7FFFFFu), b = spu_splat_u32(0x40000000u);   /* FLT_MAX * 2 */
+      CHECK(spu_fm(a, b)._u32[0] == 0x7FFFFFFFu, "FLT_MAX*2 -> extended max, got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x7F800000u), b = spu_splat_u32(0x3F800000u);   /* 2^128 * 1 */
+      CHECK(spu_fm(a, b)._u32[0] == 0x7F800000u, "2^128*1 = 2^128 (exp 255 is a number), got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x7F800000u), b = spu_splat_u32(0x40000000u);   /* 2^128 * 2 = 2^129 */
+      CHECK(spu_fm(a, b)._u32[0] == 0x7FFFFFFFu, "2^129 saturates, got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0xBF800000u), b = spu_splat_u32(0x00000000u);   /* -1 * 0 = +0 */
+      CHECK(spu_fm(a, b)._u32[0] == 0, "-1*0 = +0, got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x00400000u), b = spu_splat_u32(0x7F000000u);   /* denormal * 2^127 = 0 */
+      CHECK(spu_fm(a, b)._u32[0] == 0, "denormal operand is zero, got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x00800000u), b = spu_splat_u32(0x3F000000u);   /* 2^-126 * 0.5 underflows */
+      CHECK(spu_fm(a, b)._u32[0] == 0, "underflow -> +0, got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x3F800001u), b = spu_splat_u32(0x3F800001u);   /* (1+u)^2 truncates */
+      CHECK(spu_fm(a, b)._u32[0] == 0x3F800002u, "RZ: (1+u)^2 -> 1+2u, got %08X", spu_fm(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x3F800000u), b = spu_splat_u32(0xB3000000u);   /* 1 - 2^-25: RZ 0x3F7FFFFF (RN: 1.0) */
+      CHECK(spu_fa(a, b)._u32[0] == 0x3F7FFFFFu, "RZ: 1-2^-25 -> 0x3F7FFFFF, got %08X", spu_fa(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x3F800000u), b = spu_splat_u32(0x80000001u);   /* 1 + (-denormal) = 1 */
+      CHECK(spu_fa(a, b)._u32[0] == 0x3F800000u, "1 + -denormal = 1, got %08X", spu_fa(a, b)._u32[0]); }
+    { u128 a = spu_splat_u32(0x3F800001u), b = spu_splat_u32(0x3F800001u), c = spu_splat_u32(0xBF800002u);
+      /* fused: (1+u)^2 - (1+2u) = u^2 = 2^-46 exactly; unfused would give 0 */
+      CHECK(spu_fma(a, b, c)._u32[0] == 0x28800000u, "fma is fused, got %08X", spu_fma(a, b, c)._u32[0]); }
+    { u128 a = spu_splat_u32(0xFFFFFFFFu);
+      CHECK(spu_cuflt(a, 155)._u32[0] == 0x4F7FFFFFu, "cuflt 0xFFFFFFFF truncates to 0x4F7FFFFF, got %08X", spu_cuflt(a, 155)._u32[0]);
+      u128 b = spu_splat_u32(0x7FFFFFFFu);
+      CHECK(spu_csflt(b, 155)._u32[0] == 0x4EFFFFFFu, "csflt 0x7FFFFFFF truncates, got %08X", spu_csflt(b, 155)._u32[0]); }
+    { u128 a = spu_splat_u32(0x7FC00000u);   /* exponent-255 positive -> saturates */
+      CHECK(spu_cflts(a, 173)._u32[0] == 0x7FFFFFFFu, "cflts(exp255) saturates, got %08X", spu_cflts(a, 173)._u32[0]);
+      CHECK(spu_cfltu(a, 173)._u32[0] == 0xFFFFFFFFu, "cfltu(exp255) saturates, got %08X", spu_cfltu(a, 173)._u32[0]);
+      u128 n = spu_splat_u32(0xCF000000u);   /* -2^31 */
+      CHECK(spu_cflts(n, 173)._u32[0] == 0x80000000u, "cflts(-2^31), got %08X", spu_cflts(n, 173)._u32[0]);
+      u128 h = spu_splat_u32(0xBFC00000u);   /* -1.5 -> -1 */
+      CHECK(spu_cflts(h, 173)._s32[0] == -1, "cflts(-1.5) = -1, got %d", spu_cflts(h, 173)._s32[0]);
+      CHECK(spu_cflts(h, 172)._s32[0] == -3, "cflts(-1.5, scale 2) = -3, got %d", spu_cflts(h, 172)._s32[0]); }
+    { u128 a = spu_splat_u32(0x7F800000u), b = spu_splat_u32(0x7F7FFFFFu);  /* exp255 > FLT_MAX */
+      CHECK(spu_fcgt(a, b)._u32[0] == 0xFFFFFFFFu, "fcgt exp255 > FLT_MAX");
+      u128 z = spu_splat_u32(0x80000000u), d = spu_splat_u32(0x00000001u);
+      CHECK(spu_fceq(z, d)._u32[0] == 0xFFFFFFFFu, "-0 == denormal (both zero)");
+      CHECK(spu_fcgt(d, z)._u32[0] == 0, "denormal not > -0");
+      u128 m1 = spu_splat_u32(0xBF800000u), m2 = spu_splat_u32(0xC0000000u);
+      CHECK(spu_fcgt(m1, m2)._u32[0] == 0xFFFFFFFFu, "-1 > -2");
+      CHECK(spu_fcmgt(m2, m1)._u32[0] == 0xFFFFFFFFu, "|-2| > |-1|"); }
+    /* DP: round to nearest, default NaN, fused */
+    { u128 a, b, t, r; memset(&a, 0, 16); memset(&b, 0, 16); memset(&t, 0, 16);
+      spu__dset(&a, 0, 1.0); spu__dset(&b, 0, ldexp(1.0, -53)); spu__dset(&a, 1, 0.0); spu__dset(&b, 1, 0.0);
+      r = spu_dfa(a, b);  /* 1 + 2^-53 ties to even -> 1.0 under RN (RZ also 1.0) */
+      CHECK(spu__dget(r, 0) == 1.0, "dfa tie");
+      spu__dset(&b, 0, ldexp(3.0, -54));          /* 1 + 1.5*2^-53 -> RN rounds up */
+      r = spu_dfa(a, b);
+      CHECK(spu__dget(r, 0) == 1.0 + ldexp(1.0, -52), "dfa rounds to nearest (not toward zero): %a", spu__dget(r, 0));
+      spu__dset(&a, 0, INFINITY); spu__dset(&b, 0, -INFINITY);
+      r = spu_dfa(a, b);
+      CHECK(r._u32[0] == 0x7FF80000u && r._u32[1] == 0, "inf-inf = default NaN, got %08X%08X", r._u32[0], r._u32[1]);
+      spu__dset(&a, 0, 1.0 + ldexp(1.0, -30)); spu__dset(&b, 0, 1.0 - ldexp(1.0, -30)); spu__dset(&t, 0, -1.0);
+      r = spu_dfma(a, b, t);   /* (1+e)(1-e) - 1 = -e^2 exactly, fused */
+      CHECK(spu__dget(r, 0) == -ldexp(1.0, -60), "dfma fused: %a", spu__dget(r, 0));
+      spu__dset(&a, 0, NAN); spu__dset(&a, 1, -0.0);
+      r = spu_dftsv(a, 0x40);
+      CHECK(r._u32[0] == 0xFFFFFFFFu && r._u32[2] == 0, "dftsv NaN");
+      r = spu_dftsv(a, 0x04);
+      CHECK(r._u32[0] == 0 && r._u32[2] == 0xFFFFFFFFu, "dftsv -0"); }
+
+    spu_fp_leave(env);
+    printf("SPU float: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_idle_poll.c b/runtime/spu/tests/test_spu_idle_poll.c
new file mode 100644
index 00000000..06c72a82
--- /dev/null
+++ b/runtime/spu/tests/test_spu_idle_poll.c
@@ -0,0 +1,502 @@
+/*
+ * Idle-poll detector (spu_channels.c spu_poll_note / spu_poll_maybe_park).
+ *
+ * The SPU side runs the shape of THP8's Havok constraint thread (img 31) when
+ * its job queue is empty: cellSyncMutexLock (GETLLAR / PUTLLC ticket, wait for
+ * the release counter), GET of the queue header, cellSyncMutexUnlock
+ * (GETLLAR / PUTLLC release) -- forever, ~150k iterations a second when
+ * nobody parks it. The PPU side posts jobs the way THP8's Havok PPU thread
+ * does: HLE cellSyncMutexLock / store the header / cellSyncMutexUnlock, with
+ * the HLE's coherent compare-and-swap (sync_cas: under the lock-line lock,
+ * notify a reserved line).
+ *
+ * Asserted:
+ *   idle      the poller parks: iterations per second drop by orders of
+ *             magnitude (bounded by the 1 ms park timeout)
+ *   latency   a posted job is picked up promptly -- the PPU's ticket write
+ *             wakes the watch, it does not wait out the timeout
+ *   busy      a stream of jobs (new header content every iteration) never
+ *             parks the SPU
+ *   compute   an SPU that GETs changing data and PUTs results never parks,
+ *             even though it also takes a lock every iteration
+ *   atomics   an SPU doing back-to-back GETLLAR / PUTLLC updates alone (it
+ *             reads back its own writes) never parks
+ *   off       SPU_POLL_PARK=0 parks nothing
+ *   nolock    a context that never issues a GETLLAR pays nothing (poll_on 0)
+ *
+ * Build (Windows, clang-cl, from the ps3recomp root; one compile at a time):
+ *   clang-cl -nologo -MD -O2 -msse4.1 -fno-strict-aliasing /clang:-ffp-contract=off
+ *       -D_CRT_SECURE_NO_WARNINGS -I include -I runtime/spu -I runtime/platform -I runtime
+ *       runtime/spu/tests/test_spu_idle_poll.c runtime/spu/spu_drain.c
+ *       runtime/spu/spu_lockstep.c runtime/spu/spu_coherency.c runtime/spu/spu_workload.c
+ *       runtime/spu/spurs_policy.c runtime/spu/spurs_job.c runtime/spu/spu_tsp_weak.c
+ *       runtime/spu/spu_vm_pagemap.c runtime/spu/spurs_policy_blob_weak.c
+ *       runtime/spu/spu_interp.c runtime/spu/spu_capture.c
+ *       -Fe:test_spu_idle_poll.exe /link user32.lib advapi32.lib
+ *
+ * Exit code: 0 if all passed, 1 if any failed. The last line is a summary.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <malloc.h>
+
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+#define GUEST_SIZE  0x01000000u        /* 16 MB */
+
+#include "spu_channels.c"
+#include <mmsystem.h>
+#pragma comment(lib, "winmm.lib")
+
+static int g_pass, g_fail, g_soft;
+/* Timing checks (latencies, park lengths) only mean something when this
+ * process gets a CPU when it asks for one. On a starved host (this test runs
+ * below normal priority next to builds and a game) they are reported as
+ * "soft" notes instead of failures; the functional checks stay hard.
+ * g_starved is measured at start-up (Sleep(1) overshoot). */
+static int g_starved;
+static const char* g_test = "(none)";
+#define TEST(name) (g_test = (name))
+#define CHECK(cond) do {                                                     \
+    if (cond) g_pass++;                                                      \
+    else { g_fail++;                                                         \
+           printf("  FAIL [%s] %s:%d: %s\n", g_test, __FILE__, __LINE__, #cond); \
+           fflush(stdout); }                                                 \
+} while (0)
+#define CHECK_T(cond) do {                                                   \
+    if (cond) g_pass++;                                                      \
+    else if (g_starved) { g_soft++;                                          \
+           printf("  soft [%s] %s:%d: %s (host starved: timing only)\n",     \
+                  g_test, __FILE__, __LINE__, #cond); fflush(stdout); }      \
+    else { g_fail++;                                                         \
+           printf("  FAIL [%s] %s:%d: %s\n", g_test, __FILE__, __LINE__, #cond); \
+           fflush(stdout); }                                                 \
+} while (0)
+
+static uint64_t qpc_ns(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)((double)c.QuadPart * 1e9 / (double)f.QuadPart);
+}
+static double thread_cpu_ms(HANDLE h)
+{
+    FILETIME c, x, k, u;
+    if (!GetThreadTimes(h, &c, &x, &k, &u)) return 0;
+    return ((((uint64_t)k.dwHighDateTime << 32) | k.dwLowDateTime) +
+            (((uint64_t)u.dwHighDateTime << 32) | u.dwLowDateTime)) / 1e4;
+}
+
+static void     wr(spu_context* c, uint32_t ch, uint32_t v) { spu_wrch(c, ch, spu_make_preferred_u32(v)); }
+static uint32_t rd(spu_context* c, uint32_t ch)             { return spu_rdch(c, ch)._u32[0]; }
+static void mfc(spu_context* c, uint32_t cmd, uint32_t lsa, uint32_t ea, uint32_t size, uint32_t tag)
+{
+    wr(c, MFC_LSA, lsa); wr(c, MFC_EAH, 0); wr(c, MFC_EAL, ea);
+    wr(c, MFC_Size, size); wr(c, MFC_TagID, tag); wr(c, MFC_Cmd, cmd);
+}
+static void tag_wait_all(spu_context* c, uint32_t mask)
+{
+    wr(c, MFC_WrTagMask, mask); wr(c, MFC_WrTagUpdate, MFC_TAG_UPDATE_ALL); (void)rd(c, MFC_RdTagStat);
+}
+static spu_context* new_ctx(uint32_t id)
+{
+    spu_context* c = (spu_context*)_aligned_malloc(sizeof(spu_context), 128);
+    spu_context_init(c, id);
+    c->status = SPU_STATUS_RUNNING;
+    c->image_id = 31;
+    return c;
+}
+static void free_ctx(spu_context* c)
+{
+    extern void spu_coh_unregister(spu_context*);
+    spu_coh_unregister(c);
+    spu_mfc_release(c);
+    _aligned_free(c);
+}
+static uint32_t be32(const uint8_t* p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+static void put_be32(uint8_t* p, uint32_t v)
+{
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+#define EA_MUTEX  0x00400000u     /* cellSyncMutex: be16 rel (m_freed), be16 acq (m_order) */
+#define EA_HDR    0x00410000u     /* queue header: be32 count, be32 seq */
+#define EA_DATA   0x00420000u     /* compute case input */
+#define EA_OUT    0x00430000u     /* compute case output */
+#define LSA_LINE  0x7000u
+#define LSA_HDR   0x7100u
+#define LSA_BUF   0x8000u
+
+/* ---- SPU side: libsync's cellSyncMutexLock / Unlock on the SPU ------------ */
+static void spu_mutex_lock(spu_context* c)
+{
+    uint16_t ticket;
+    for (;;) {                                   /* take a ticket: acq++ */
+        mfc(c, MFC_GETLLAR_CMD, LSA_LINE, EA_MUTEX, 128, 0); (void)rd(c, MFC_RdAtomicStat);
+        uint32_t w = be32(c->ls + LSA_LINE);
+        ticket = (uint16_t)w;
+        put_be32(c->ls + LSA_LINE, (w & 0xFFFF0000u) | (uint16_t)(ticket + 1));
+        mfc(c, MFC_PUTLLC_CMD, LSA_LINE, EA_MUTEX, 128, 0);
+        if (rd(c, MFC_RdAtomicStat) == 0) break;
+    }
+    for (;;) {                                   /* wait until served */
+        mfc(c, MFC_GETLLAR_CMD, LSA_LINE, EA_MUTEX, 128, 0); (void)rd(c, MFC_RdAtomicStat);
+        if ((uint16_t)(be32(c->ls + LSA_LINE) >> 16) == ticket) return;
+    }
+}
+static void spu_mutex_unlock(spu_context* c)
+{
+    for (;;) {                                   /* rel++ */
+        mfc(c, MFC_GETLLAR_CMD, LSA_LINE, EA_MUTEX, 128, 0); (void)rd(c, MFC_RdAtomicStat);
+        uint32_t w = be32(c->ls + LSA_LINE);
+        put_be32(c->ls + LSA_LINE, ((uint32_t)(uint16_t)((w >> 16) + 1) << 16) | (uint16_t)w);
+        mfc(c, MFC_PUTLLC_CMD, LSA_LINE, EA_MUTEX, 128, 0);
+        if (rd(c, MFC_RdAtomicStat) == 0) return;
+    }
+}
+
+/* ---- PPU side: the HLE cellSyncMutex (libs/sync/cellSync.c sync_cas) ------- */
+static int ppu_cas(uint32_t ea, uint32_t expect, uint32_t desired)
+{
+    spu_lockline_lock();
+    int ok = be32(vm_base + ea) == expect;
+    if (ok) {
+        put_be32(vm_base + ea, desired);
+        if (spu_coh_is_reserved(ea)) spu_coh_notify_write(ea);
+    }
+    spu_lockline_unlock();
+    return ok;
+}
+static void ppu_mutex_lock(void)
+{
+    uint32_t w; uint16_t ticket;
+    do { w = be32(vm_base + EA_MUTEX); ticket = (uint16_t)w; }
+    while (!ppu_cas(EA_MUTEX, w, (w & 0xFFFF0000u) | (uint16_t)(ticket + 1)));
+    while ((uint16_t)(be32(vm_base + EA_MUTEX) >> 16) != ticket) YieldProcessor();
+}
+static void ppu_mutex_unlock(void)
+{
+    uint32_t w;
+    do w = be32(vm_base + EA_MUTEX);
+    while (!ppu_cas(EA_MUTEX, w, ((uint32_t)(uint16_t)((w >> 16) + 1) << 16) | (uint16_t)w));
+}
+
+/* ---- The Havok-shaped worker -------------------------------------------- */
+typedef struct {
+    spu_context* ctx;
+    volatile LONG stop;
+    volatile LONG64 iters, jobs;
+    volatile LONG64 t_job_ns;          /* qpc when the last job was seen */
+    int compute;                       /* compute case: GET changing data, PUT a result */
+} worker_arg;
+
+static DWORD WINAPI havok_worker(LPVOID p)
+{
+    worker_arg* a = (worker_arg*)p;
+    spu_context* c = a->ctx;
+    while (!a->stop) {
+        spu_mutex_lock(c);
+        mfc(c, MFC_GET_CMD, LSA_HDR, EA_HDR, 16, 1); tag_wait_all(c, 1u << 1);
+        uint32_t count = be32(c->ls + LSA_HDR);
+        if (count) {                                 /* take the job */
+            put_be32(c->ls + LSA_HDR, count - 1);
+            mfc(c, MFC_PUT_CMD, LSA_HDR, EA_HDR, 16, 1); tag_wait_all(c, 1u << 1);
+            a->t_job_ns = (LONG64)qpc_ns();
+            InterlockedIncrement64(&a->jobs);
+        }
+        if (a->compute) {                            /* real work under the lock: */
+            /* stream through 64 KB of job data, 1 KB per iteration */
+            uint32_t src = EA_DATA + (uint32_t)((a->iters & 63) * 1024);
+            mfc(c, MFC_GET_CMD, LSA_BUF, src, 1024, 2); tag_wait_all(c, 1u << 2);
+            uint32_t s = 0;
+            for (int i = 0; i < 1024; i += 4) s += be32(c->ls + LSA_BUF + i);
+            put_be32(c->ls + LSA_BUF + 0x800, s);
+            mfc(c, MFC_PUT_CMD, LSA_BUF + 0x800, EA_OUT, 16, 2); tag_wait_all(c, 1u << 2);
+        }
+        spu_mutex_unlock(c);
+        InterlockedIncrement64(&a->iters);
+    }
+    return 0;
+}
+
+static void reset_guest(void)
+{
+    memset(vm_base + EA_MUTEX, 0, 128);
+    memset(vm_base + EA_HDR, 0, 128);
+}
+
+/* Run the worker for `ms` with nothing posted; return iterations/s and CPU%. */
+static void measure_idle(worker_arg* a, HANDLE h, unsigned ms, double* ips, double* cpu)
+{
+    LONG64 i0 = a->iters; double c0 = thread_cpu_ms(h); uint64_t t0 = qpc_ns();
+    Sleep(ms);
+    LONG64 i1 = a->iters; double c1 = thread_cpu_ms(h); uint64_t t1 = qpc_ns();
+    double s = (t1 - t0) / 1e9;
+    *ips = (double)(i1 - i0) / s;
+    *cpu = 100.0 * (c1 - c0) / ((t1 - t0) / 1e6);
+}
+
+static void test_idle_and_latency(void)
+{
+    TEST("idle-poll.havok-shape");
+    reset_guest();
+    worker_arg a; memset(&a, 0, sizeof a);
+    a.ctx = new_ctx(0x2002);
+    HANDLE h = CreateThread(NULL, 0, havok_worker, &a, 0, NULL);
+    Sleep(100);                                       /* warm up past the threshold */
+    double ips, cpu;
+    measure_idle(&a, h, 500, &ips, &cpu);
+    printf("  [%s] idle: %.0f iterations/s, worker CPU %.1f%%, parks=%llu woken=%llu\n",
+           g_test, ips, cpu, (unsigned long long)a.ctx->poll_parks, (unsigned long long)a.ctx->poll_wakes);
+    CHECK(a.ctx->poll_parks > 0);
+    CHECK_T(ips < 5000.0);                              /* unparked: >100k/s */
+    CHECK_T(cpu < 25.0);
+
+    /* Post jobs like the Havok PPU thread: lock, header count++, unlock. */
+    TEST("idle-poll.job-latency");
+    enum { N = 200 };
+    double lat[N]; int got = 0;
+    srand(4242);
+    for (int i = 0; i < N; i++) {
+        Sleep(1 + (rand() % 3));                      /* let it go back to sleep */
+        LONG64 j0 = a.jobs;
+        ppu_mutex_lock();
+        uint32_t cnt = be32(vm_base + EA_HDR);
+        put_be32(vm_base + EA_HDR, cnt + 1);
+        put_be32(vm_base + EA_HDR + 4, (uint32_t)i);
+        uint64_t t_post = qpc_ns();
+        ppu_mutex_unlock();
+        uint64_t deadline = t_post + 200000000ull;    /* 200 ms */
+        while (a.jobs == j0 && qpc_ns() < deadline) YieldProcessor();
+        if (a.jobs != j0) lat[got++] = (double)((uint64_t)a.t_job_ns - t_post) / 1e3;
+    }
+    CHECK(got == N);
+    /* sort for percentiles */
+    for (int i = 1; i < got; i++) { double v = lat[i]; int k = i - 1; while (k >= 0 && lat[k] > v) { lat[k+1] = lat[k]; k--; } lat[k+1] = v; }
+    double p50 = got ? lat[got / 2] : 1e9, p90 = got ? lat[got * 9 / 10] : 1e9, mx = got ? lat[got - 1] : 1e9;
+    printf("  [%s] %d jobs: pickup latency p50 %.1f us, p90 %.1f us, max %.1f us\n", g_test, got, p50, p90, mx);
+    /* Woken by the lock write, not the 1 ms timeout. Only the median is
+     * asserted: under host load (this runs below normal priority next to other
+     * work) a woken thread can wait for a CPU far longer than any timeout. */
+    CHECK_T(p50 < 300.0);
+
+    /* A stream of jobs: header content changes every iteration -> no parks. */
+    TEST("idle-poll.busy-stream");
+    uint64_t parks0 = a.ctx->poll_parks;
+    LONG64 j0 = a.jobs;
+    uint64_t t0 = qpc_ns();
+    int posted = 0;
+    while (qpc_ns() - t0 < 300000000ull) {            /* 300 ms of back-to-back jobs */
+        if (be32(vm_base + EA_HDR) == 0) {
+            ppu_mutex_lock();
+            put_be32(vm_base + EA_HDR, 1);
+            put_be32(vm_base + EA_HDR + 4, (uint32_t)(1000 + posted++));
+            ppu_mutex_unlock();
+        } else YieldProcessor();
+    }
+    uint64_t busy_parks = a.ctx->poll_parks - parks0;
+    printf("  [%s] %d jobs posted, %lld taken, parks during the stream: %llu\n",
+           g_test, posted, (long long)(a.jobs - j0), (unsigned long long)busy_parks);
+    CHECK(a.jobs - j0 >= posted - 1);
+    /* Parks can only happen in the gaps where the queue was empty for 48+
+     * inputs; with the PPU reposting immediately there must be few. */
+    CHECK(busy_parks * 20 < (uint64_t)posted + 20);
+
+    a.stop = 1;
+    { uint32_t c = be32(vm_base + EA_HDR); (void)c; }
+    WaitForSingleObject(h, 5000);
+    CloseHandle(h);
+    free_ctx(a.ctx);
+}
+
+static void test_compute(void)
+{
+    TEST("idle-poll.compute-never-parks");
+    reset_guest();
+    for (uint32_t i = 0; i < 65536; i += 4) put_be32(vm_base + EA_DATA + i, i * 2654435761u);
+    worker_arg a; memset(&a, 0, sizeof a);
+    a.ctx = new_ctx(0x2003);
+    a.compute = 1;
+    /* Same lock / header poll as the idle case, but every iteration also
+     * streams a different KB of job data and PUTs a result: new input each
+     * time, so the detector must never park it. */
+    HANDLE h = CreateThread(NULL, 0, havok_worker, &a, 0, NULL);
+    Sleep(300);
+    a.stop = 1;
+    WaitForSingleObject(h, 5000); CloseHandle(h);
+    printf("  [%s] %lld iterations, parks=%llu\n", g_test, (long long)a.iters,
+           (unsigned long long)a.ctx->poll_parks);
+    CHECK(a.iters > 1000);
+    CHECK(a.ctx->poll_parks == 0);
+    free_ctx(a.ctx);
+}
+
+static void test_nolock(void)
+{
+    TEST("idle-poll.no-getllar-no-cost");
+    spu_context* c = new_ctx(0x2004);
+    memset(vm_base + EA_HDR, 0, 128);
+    for (int i = 0; i < 1000; i++) {
+        mfc(c, MFC_GET_CMD, LSA_HDR, EA_HDR, 16, 1); tag_wait_all(c, 2);
+    }
+    CHECK(c->poll_on == 0);
+    CHECK(c->poll_rep == 0);
+    CHECK(c->poll_parks == 0);
+    free_ctx(c);
+}
+
+static void test_atomic_run(void)
+{
+    /* An SPU doing back-to-back atomic updates alone (an allocator, a work
+     * counter) reads back its own PUTLLC every time -- known content, but
+     * real work: it must never park. */
+    TEST("idle-poll.atomic-run-never-parks");
+    spu_context* c = new_ctx(0x2006);
+    memset(vm_base + EA_MUTEX, 0, 128);
+    uint64_t t0 = qpc_ns();
+    for (int i = 0; i < 20000; i++) {
+        for (;;) {
+            mfc(c, MFC_GETLLAR_CMD, LSA_LINE, EA_MUTEX, 128, 0); (void)rd(c, MFC_RdAtomicStat);
+            put_be32(c->ls + LSA_LINE + 8, be32(c->ls + LSA_LINE + 8) + 1);
+            mfc(c, MFC_PUTLLC_CMD, LSA_LINE, EA_MUTEX, 128, 0);
+            if (rd(c, MFC_RdAtomicStat) == 0) break;
+        }
+        if ((i & 63) == 0) {                         /* plus a static config read now and then */
+            mfc(c, MFC_GET_CMD, LSA_HDR, EA_HDR, 16, 1); tag_wait_all(c, 2);
+        }
+    }
+    double ms = (qpc_ns() - t0) / 1e6;
+    printf("  [%s] 20000 increments in %.1f ms, parks=%llu\n", g_test, ms,
+           (unsigned long long)c->poll_parks);
+    CHECK(be32(vm_base + EA_MUTEX + 8) == 20000);
+    CHECK(c->poll_parks == 0);
+    free_ctx(c);
+}
+
+/* The SPURS policy-module lanes' armed watch (spu_coh_arm / spu_coh_arm_park):
+ * re-armed at each of a lane's lock-line atomics; a write by a peer lane (same
+ * tag) must not trip it, a PPU write must -- also one that lands BEFORE the
+ * park call (the window between the lane's unlock and its park). */
+typedef struct { spu_context* ctx; unsigned ms; volatile LONG done; int r; uint64_t t_ret; } armpark_arg;
+static DWORD WINAPI armpark_thread(LPVOID p)
+{
+    armpark_arg* a = (armpark_arg*)p;
+    extern int spu_coh_arm_park(spu_context*, uint32_t, unsigned);
+    a->r = spu_coh_arm_park(a->ctx, EA_MUTEX, a->ms);
+    a->t_ret = qpc_ns();
+    InterlockedExchange(&a->done, 1);
+    return 0;
+}
+static void lane_lock_unlock(spu_context* c) { spu_mutex_lock(c); spu_mutex_unlock(c); }
+static void test_pm_armed_watch(void)
+{
+    extern int spu_coh_arm_park(spu_context*, uint32_t, unsigned);
+    TEST("pm-park.armed-watch");
+    reset_guest();
+    spu_context* a = new_ctx(0x100); spu_context* b = new_ctx(0x101);
+    a->image_id = b->image_id = 35; a->policy_mode = b->policy_mode = 1;
+    lane_lock_unlock(a);                               /* arms a on the queue mutex */
+    CHECK(a->coh_arm_on == 1);
+    CHECK(a->coh_arm_hit == 0);
+    lane_lock_unlock(b);                               /* a peer lane: same tag */
+    CHECK(a->coh_arm_hit == 0);
+    uint64_t t0 = qpc_ns();
+    int r = spu_coh_arm_park(a, EA_MUTEX, 5);          /* nobody else wrote: times out */
+    double ms = (qpc_ns() - t0) / 1e6;
+    printf("  [%s] no foreign write: park returned %d after %.2f ms\n", g_test, r, ms);
+    CHECK(r == 0);
+    CHECK_T(ms >= 3.0);
+    ppu_mutex_lock(); ppu_mutex_unlock();              /* PPU writes after a's last atomic... */
+    t0 = qpc_ns();
+    r = spu_coh_arm_park(a, EA_MUTEX, 200);            /* ...before the park: no sleep */
+    ms = (qpc_ns() - t0) / 1e6;
+    printf("  [%s] write before the park: returned %d after %.3f ms\n", g_test, r, ms);
+    CHECK(r == 1);
+    CHECK_T(ms < 2.0);
+    lane_lock_unlock(a);                               /* re-arm */
+    CHECK(a->coh_arm_hit == 0);
+    armpark_arg pa; memset(&pa, 0, sizeof pa); pa.ctx = a; pa.ms = 500;
+    HANDLE h = CreateThread(NULL, 0, armpark_thread, &pa, 0, NULL);
+    Sleep(30);
+    lane_lock_unlock(b);                               /* peer traffic: stays parked */
+    Sleep(10);
+    CHECK(pa.done == 0);
+    uint64_t t_wr = qpc_ns();
+    ppu_mutex_lock(); ppu_mutex_unlock();              /* PPU submit: wakes it */
+    WaitForSingleObject(h, 5000); CloseHandle(h);
+    double lat = (pa.t_ret - t_wr) / 1e3;
+    printf("  [%s] parked lane woken by the PPU write after %.1f us (r=%d)\n", g_test, lat, pa.r);
+    CHECK(pa.r == 1);
+    CHECK_T(lat < 50000.0);
+    /* a non-policy context is never armed */
+    CHECK(new_ctx(0x102)->coh_arm_on == 0);
+    free_ctx(a); free_ctx(b);
+}
+
+static void test_off(void)
+{
+    TEST("idle-poll.disabled");
+    s_poll_park = 0;                                  /* as SPU_POLL_PARK=0 */
+    reset_guest();
+    worker_arg a; memset(&a, 0, sizeof a);
+    a.ctx = new_ctx(0x2005);
+    HANDLE h = CreateThread(NULL, 0, havok_worker, &a, 0, NULL);
+    Sleep(150);
+    a.stop = 1;
+    WaitForSingleObject(h, 5000); CloseHandle(h);
+    printf("  [%s] %lld iterations in 150 ms, parks=%llu\n", g_test, (long long)a.iters,
+           (unsigned long long)a.ctx->poll_parks);
+    CHECK(a.ctx->poll_parks == 0);
+    free_ctx(a.ctx);
+    s_poll_park = 1;
+}
+
+/* Symbols the runtime pulls in from the rest of the port (PPU loader, SPURS
+ * HLE, title hooks); none is on a path this test drives. */
+uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid, g_ydkj_real_spurs_ea;
+uint32_t g_barrier_sync_watch;
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int      g_resv_store_active;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; }
+unsigned long long ps3_ms_now(void) { return GetTickCount64(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+uint64_t spurs_pm_build_context(uint8_t* ls, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{ (void)ls; (void)a; (void)b; (void)c; (void)d; return 0; }
+void ydkj_wake_all_event_flags(void) {}
+
+int main(void)
+{
+    vm_base = (uint8_t*)VirtualAlloc(NULL, GUEST_SIZE, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!vm_base) { printf("cannot allocate guest memory\n"); return 2; }
+    ppu_vm_size = GUEST_SIZE;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    timeBeginPeriod(1);              /* as the game's main(): 1 ms park timeouts */
+    spu_poll_park_cfg();
+    {   /* host starvation probe: median of 15 Sleep(1) */
+        double d[15];
+        for (int i = 0; i < 15; i++) { uint64_t t = qpc_ns(); Sleep(1); d[i] = (qpc_ns() - t) / 1e6; }
+        for (int i = 1; i < 15; i++) { double v = d[i]; int k = i - 1; while (k >= 0 && d[k] > v) { d[k+1] = d[k]; k--; } d[k+1] = v; }
+        g_starved = d[7] > 4.0;
+        printf("  [setup] Sleep(1) median %.2f ms%s\n", d[7], g_starved ? " -- host starved, timing checks are soft" : "");
+    }
+
+    test_nolock();
+    test_idle_and_latency();
+    test_compute();
+    test_atomic_run();
+    test_pm_armed_watch();
+    test_off();
+
+    printf("SPU idle-poll detector: %d passed, %d failed, %d soft (timing under host starvation)\n",
+           g_pass, g_fail, g_soft);
+    return g_fail ? 1 : 0;
+}
