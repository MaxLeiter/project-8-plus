+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+            WCHAR name[20];
+            ld_fill_pso_desc(&pd, il, vs, ps, &rs, (x->flags & 1u) ? &plan : NULL, (x->flags & 2u) != 0, (x->flags & 4u) != 0);
