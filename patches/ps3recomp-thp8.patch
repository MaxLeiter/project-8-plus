+}
+
+const HDR = [0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00];
+const TYPE_V_V = [0x01, 0x04, 0x01, 0x60, 0x00, 0x00];
+const FUNC_1 = [0x03, 0x02, 0x01, 0x00];
+const code = (body) => [0x0a, body.length + 2, 0x01, body.length, ...body];
+const valid = (bytes) => { try { return WebAssembly.validate(new Uint8Array(bytes)); } catch { return false; } };
+const FEATURES = {
