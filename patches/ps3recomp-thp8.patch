+static void spu_miss_dump(const spu_context* ctx)
+{
+    static int s_on = -1; static char s_dir[400];
+    s_var_st.misses++;              /* every interpreter fallback of the dispatcher */
+    if (s_on < 0) { const char* e = getenv("SPU_MISS_DIR"); s_on = e && *e;
+                    if (s_on) snprintf(s_dir, sizeof s_dir, "%s", e); }
+    if (!s_on) return;
+    uint32_t pc = (uint32_t)ctx->pc & SPU_LS_MASK & ~3u;
+    /* Identity of the code there: up to 4 KB from pc (a variant's own extent
+     * is only known once it is lifted). */
+    uint32_t span = SPU_LS_SIZE - pc < 0x1000u ? SPU_LS_SIZE - pc : 0x1000u;
+    uint64_t key = spu_code_hash(ctx->ls + pc, span);
+    static struct { int img; uint32_t pc; uint64_t key; } seen[256]; static volatile long n;
+    for (long i = 0; i < n && i < 256; i++)
+        if (seen[i].img == ctx->image_id && seen[i].pc == pc && seen[i].key == key) return;
+    long k = __atomic_fetch_add(&n, 1, __ATOMIC_ACQ_REL);
+    if (k >= 256) return;
+    seen[k].img = ctx->image_id; seen[k].pc = pc; seen[k].key = key;
+    char path[520];
+    snprintf(path, sizeof path, "%s/spumiss_img%d_%05X_%016llX.bin", s_dir, ctx->image_id, pc,
+             (unsigned long long)key);
+    FILE* f = fopen(path, "wb");
+    if (!f) return;
+    /* v2: key = spu_code_hash of LS [pc, pc + min(4 KB, LS end)) (v1: 32-byte FNV). */
+    uint32_t hdr[6] = { 0x53494D53u /* "SMIS" */, 2u, (uint32_t)ctx->image_id, pc,
+                        ctx->gpr[0]._u32[0] & SPU_LS_MASK, (uint32_t)ctx->policy_mode };
+    fwrite(hdr, sizeof hdr, 1, f);
+    fwrite(&key, 8, 1, f);
+    fwrite(ctx->ls, 1, SPU_LS_SIZE, f);
+    fclose(f);
+    fprintf(stderr, "[spu-miss] img=%d pc=0x%05X key=%016llX -> %s\n", ctx->image_id, pc,
+            (unsigned long long)key, path);
+}
