+ * channel. A persistent worker that parks between commands (FMOD's mixer and
+ * MPEG decoder wait on SNR1) reports exactly what its work costs the host. */
+static void spu_cpustat_sample(spu_context* ctx)
+{
+    static int s_win = -1;
+    if (s_win < 0) { const char* e = getenv("SPU_CPUSTAT"); s_win = e ? (atoi(e) > 0 ? atoi(e) : 5) : 0; }
+    if (!s_win) return;
+    static SPU_TLS unsigned long long t_wall0, t_cpu0, t_parks;
+    FILETIME c, x, k, u;
+    unsigned long long now = GetTickCount64(), cpu = 0;
+    if (GetThreadTimes(GetCurrentThread(), &c, &x, &k, &u))
+        cpu = (((unsigned long long)k.dwHighDateTime << 32) | k.dwLowDateTime)
+            + (((unsigned long long)u.dwHighDateTime << 32) | u.dwLowDateTime);  /* 100 ns */
+    t_parks++;
+    if (!t_wall0) { t_wall0 = now; t_cpu0 = cpu; t_parks = 0; return; }
+    if (now - t_wall0 >= (unsigned long long)s_win * 1000ull) {
+        double ms = (double)(cpu - t_cpu0) / 10000.0;
+        fprintf(stderr, "[spu-cpu] spu=%X img=%d cpu=%.1f%% of one core (%.0f ms in %.1f s, %llu parks, %.1f us/park)\n",
+                ctx->spu_id, ctx->image_id, 100.0 * ms / (double)(now - t_wall0), ms,
+                (now - t_wall0) / 1000.0, t_parks, t_parks ? 1000.0 * ms / (double)t_parks : 0.0);
+        fflush(stderr);
+        t_wall0 = now; t_cpu0 = cpu; t_parks = 0;
+    }
