+/*
+ * ps3recomp web launcher: a tiny static file server for a wasm port folder.
+ *
+ *   serve [--dir DIR] [--port N] [--host ADDR] [--open] [--mount /URL/PREFIX=PATH ...] [--mount-cache /URL/PREFIX=PATH ...]
+ *
+ * Defaults: DIR = the "www" folder next to this executable (or the current folder if there is none),
+ * port 8080, host 127.0.0.1 (this machine only). It sends the headers a threaded wasm build needs:
+ *   Cross-Origin-Opener-Policy: same-origin
+ *   Cross-Origin-Embedder-Policy: require-corp      (=> crossOriginIsolated => SharedArrayBuffer)
+ *   Cross-Origin-Resource-Policy: same-origin
+ * plus HTTP/1.1 keep-alive, HEAD, single byte ranges (the game data is range-fetched), precompressed
+ * .br / .gz siblings for whole-file requests, and application/wasm. No dependencies: Winsock or BSD sockets.
+ *
+ * --mount /URL/PREFIX=PATH (repeatable) serves PATH (a folder or one file) at /URL/PREFIX, read-only, straight from
+ * where it lives -- e.g. the user's own mods folder, without copying it under DIR. Mounted files are sent with
+ * "Cache-Control: no-store" so the browser keeps no copy of them in its HTTP cache. Any path component ending in
+ * ".cap_stage" is refused everywhere (such folders hold links into the user's own packs).
+ * --mount-cache /URL/PREFIX=PATH: the same, but served like files under DIR (html/js/wasm/json "no-cache", the rest
+ * immutable) with ETag / Last-Modified validators, so revalidations answer 304 and the browser keeps its copy --
+ * and with it V8's compiled-code cache of a .wasm. Files under DIR get the same validators.
+ *
+ * Binding to anything other than 127.0.0.1 / ::1 exposes the folder to the network. Note that browsers only
+ * grant SharedArrayBuffer to secure contexts: http://localhost works, http://<LAN IP> does not (see README).
+ *
+ * Build (any host, with zig):  zig cc -O2 -target x86_64-windows-gnu serve.c -lws2_32 -o serve.exe
+ *                              zig cc -O2 -target x86_64-linux-musl  serve.c -o serve-linux
+ *                              zig cc -O2 -target aarch64-macos      serve.c -o serve-macos
+ */
+#define _FILE_OFFSET_BITS 64
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <ctype.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <time.h>
+
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  include <winsock2.h>
+#  include <ws2tcpip.h>
+#  include <windows.h>
+#  include <shellapi.h>
+   typedef SOCKET sock_t;
+#  define CLOSESOCK closesocket
+#  define stat64_t struct _stat64
+#  define STAT64 _stat64
+#else
+#  include <sys/socket.h>
+#  include <netinet/in.h>
+#  include <netinet/tcp.h>
+#  include <arpa/inet.h>
+#  include <netdb.h>
+#  include <unistd.h>
+#  include <pthread.h>
+#  include <signal.h>
+#  include <limits.h>
+   typedef int sock_t;
+#  define INVALID_SOCKET (-1)
+#  define CLOSESOCK close
+#  define stat64_t struct stat
+#  define STAT64 stat
+#endif
+
+static char g_root[4096];
+#define MAX_MOUNTS 64
+/* cacheable: --mount-cache (served like files under DIR: no-cache + validators) instead of no-store */
+static struct { char prefix[512]; size_t plen; char dir[4096]; int cacheable; } g_mounts[MAX_MOUNTS];
+static int g_nmounts;
+
+static int strcasecmp_portable(const char* a, const char* b)
+{
+    for (;; a++, b++) {
+        int ca = tolower((unsigned char)*a), cb = tolower((unsigned char)*b);
+        if (ca != cb || !ca) return ca - cb;
+    }
+}
+
+static int strncasecmp_portable(const char* a, const char* b, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        int ca = tolower((unsigned char)a[i]), cb = tolower((unsigned char)b[i]);
+        if (ca != cb || !ca) return ca - cb;
+    }
+    return 0;
+}
+
+
+static const struct { const char* ext; const char* type; } k_mime[] = {
+    {".html", "text/html; charset=utf-8"}, {".htm", "text/html; charset=utf-8"},
+    {".js", "text/javascript; charset=utf-8"}, {".mjs", "text/javascript; charset=utf-8"},
+    {".css", "text/css; charset=utf-8"}, {".json", "application/json"}, {".wasm", "application/wasm"},
+    {".png", "image/png"}, {".jpg", "image/jpeg"}, {".svg", "image/svg+xml"}, {".ico", "image/x-icon"},
+    {".txt", "text/plain; charset=utf-8"}, {".webmanifest", "application/manifest+json"},
+    {".wgsl", "text/plain; charset=utf-8"}, {NULL, NULL}};
+
+static const char* mime_of(const char* path)
+{
+    const char* dot = strrchr(path, '.');
+    if (dot)
+        for (int i = 0; k_mime[i].ext; i++)
+            if (!strcasecmp_portable(dot, k_mime[i].ext)) return k_mime[i].type;
+    return "application/octet-stream";
+}
+
+static int send_all(sock_t s, const char* p, size_t n)
+{
+    while (n) {
+        int k = send(s, p, n > (1u << 20) ? (1 << 20) : (int)n, 0);
+        if (k <= 0) return -1;
+        p += k; n -= (size_t)k;
+    }
+    return 0;
+}
+
+static void url_decode(char* s)
+{
+    char* o = s;
+    for (; *s; s++) {
+        if (*s == '%' && isxdigit((unsigned char)s[1]) && isxdigit((unsigned char)s[2])) {
+            char h[3] = {s[1], s[2], 0};
+            *o++ = (char)strtol(h, NULL, 16); s += 2;
+        } else *o++ = *s;
+    }
+    *o = 0;
+}
+
+/* A --mount URL prefix: no "..", backslashes or drive letters. */
+static int safe_path_prefix(const char* p, size_t n)
+{
+    for (size_t i = 0; i < n; i++)
+        if (p[i] == '\\' || p[i] == ':' || (p[i] == '.' && i + 1 < n && p[i + 1] == '.')) return 0;
+    return 1;
+}
+
+/* Reject anything that could leave the root: "..", backslashes, drive letters, NULs. */
+static int safe_path(const char* p)
+{
+    if (strstr(p, "..") || strchr(p, '\\') || strchr(p, ':')) return 0;
+    return 1;
+}
+
+/* 1 if any '/'-separated component of p ends in ".cap_stage" (case-insensitive) */
+static int cap_stage_path(const char* p)
+{
+    static const char suf[] = ".cap_stage";
+    const size_t sl = sizeof suf - 1;
+    for (const char* c = p; *c; ) {
+        const char* e = strchr(c, '/');
+        size_t n = e ? (size_t)(e - c) : strlen(c);
+        if (n >= sl && !strncasecmp_portable(c + n - sl, suf, sl)) return 1;
+        if (!e) break;
+        c = e + 1;
+    }
+    return 0;
+}
+
+static const char* hdr(const char* req, const char* name, char* out, size_t cap)
+{
+    size_t nl = strlen(name);
+    for (const char* l = strstr(req, "\r\n"); l && l[2]; l = strstr(l + 2, "\r\n")) {
+        const char* h = l + 2;
+        if (!strncasecmp_portable(h, name, nl) && h[nl] == ':') {
+            h += nl + 1;
+            while (*h == ' ') h++;
+            size_t i = 0;
+            while (h[i] && h[i] != '\r' && i + 1 < cap) { out[i] = h[i]; i++; }
+            out[i] = 0;
+            return out;
+        }
+    }
+    return NULL;
+}
+
+static void simple(sock_t s, int code, const char* msg, int keep)
+{
+    char b[512];
+    int n = snprintf(b, sizeof b,
+                     "HTTP/1.1 %d %s\r\nContent-Type: text/plain\r\nContent-Length: %zu\r\n"
+                     "Cross-Origin-Resource-Policy: same-origin\r\nConnection: %s\r\n\r\n%s",
+                     code, msg, strlen(msg), keep ? "keep-alive" : "close", msg);
+    send_all(s, b, (size_t)n);
+}
+
+static int file_size_mtime(const char* p, int64_t* sz, int* isdir, int64_t* mtime)
+{
+    stat64_t st;
+    if (STAT64(p, &st) != 0) return -1;
+    *sz = (int64_t)st.st_size;
+    *isdir = (st.st_mode & S_IFMT) == S_IFDIR;
+    if (mtime) *mtime = (int64_t)st.st_mtime;
+    return 0;
+}
+static int file_size(const char* p, int64_t* sz, int* isdir) { return file_size_mtime(p, sz, isdir, NULL); }
+
+/* One request. Returns 1 to keep the connection, 0 to close it. */
+static int handle(sock_t s, char* req)
+{
+    char method[8] = {0}, target[2048] = {0}, ver[16] = {0}, tmp[256];
+    if (sscanf(req, "%7s %2047s %15s", method, target, ver) != 3) return 0;
+    int keep = strcmp(ver, "HTTP/1.0") != 0;
+    if (hdr(req, "Connection", tmp, sizeof tmp)) {
+        if (!strncasecmp_portable(tmp, "close", 5)) keep = 0;
+        else if (!strncasecmp_portable(tmp, "keep-alive", 10)) keep = 1;
+    }
+    int head = !strcmp(method, "HEAD");
+    if (!head && strcmp(method, "GET")) { simple(s, 405, "method not allowed", keep); return keep; }
+
+    char* q = strpbrk(target, "?#"); if (q) *q = 0;
+    url_decode(target);
+    if (target[0] != '/' || !safe_path(target)) { simple(s, 400, "bad path", keep); return keep; }
+
+    if (cap_stage_path(target)) { simple(s, 404, "not found", keep); return keep; }
+    /* a folder URL means its index.html, also when that file is a --mount (e.g. "/" -> a mounted /index.html) */
+    { size_t tl = strlen(target); if (tl && target[tl - 1] == '/' && tl + 10 < sizeof target) memcpy(target + tl, "index.html", 11); }
+
+    /* the longest --mount prefix that matches whole path components, else the root folder */
+    char path[8192]; int mounted = -1;
+    for (int m = 0; m < g_nmounts; m++)
+        if (!strncmp(target, g_mounts[m].prefix, g_mounts[m].plen) &&
+            (target[g_mounts[m].plen] == '/' || target[g_mounts[m].plen] == 0) &&
+            (mounted < 0 || g_mounts[m].plen > g_mounts[mounted].plen)) mounted = m;
+    if (mounted >= 0) snprintf(path, sizeof path, "%s%s", g_mounts[mounted].dir, target + g_mounts[mounted].plen);
+    else snprintf(path, sizeof path, "%s%s", g_root, target);
+    int64_t size, mtime = 0; int isdir;
+    if (file_size_mtime(path, &size, &isdir, &mtime) != 0) { simple(s, 404, "not found", keep); return keep; }
+    if (isdir) {
+        size_t L = strlen(path);
+        snprintf(path + L, sizeof path - L, "%sindex.html", (L && path[L - 1] == '/') ? "" : "/");
+        if (file_size_mtime(path, &size, &isdir, &mtime) != 0 || isdir) { simple(s, 404, "no index.html", keep); return keep; }
+    }
+    const char* type = mime_of(path);
+
+    /* Range: bytes=a-b | bytes=a- | bytes=-n (single range only). */
+    int64_t a = 0, b = size - 1; int ranged = 0;
+    if (hdr(req, "Range", tmp, sizeof tmp) && !strncmp(tmp, "bytes=", 6) && !strchr(tmp, ',')) {
+        const char* r = tmp + 6;
+        if (*r == '-') { int64_t n = strtoll(r + 1, NULL, 10); a = n >= size ? 0 : size - n; }
+        else {
+            char* e; a = strtoll(r, &e, 10);
+            if (*e == '-' && isdigit((unsigned char)e[1])) b = strtoll(e + 1, NULL, 10);
+        }
+        if (b >= size) b = size - 1;
+        if (a < 0 || a > b) {
+            char m[256];
+            int n = snprintf(m, sizeof m, "HTTP/1.1 416 Range Not Satisfiable\r\nContent-Range: bytes */%lld\r\n"
+                             "Content-Length: 0\r\nCross-Origin-Resource-Policy: same-origin\r\n\r\n", (long long)size);
+            send_all(s, m, (size_t)n);
+            return keep;
+        }
+        ranged = 1;
+    }
+
+    /* Precompressed sibling for whole-file requests (wasm, js, json index). */
+    const char* enc = NULL; char cpath[8300];
+    if (!ranged && hdr(req, "Accept-Encoding", tmp, sizeof tmp)) {
+        int64_t cs; int cd;
+        if (strstr(tmp, "br")) { snprintf(cpath, sizeof cpath, "%s.br", path);
+            if (!file_size(cpath, &cs, &cd) && !cd) { enc = "br"; size = cs; b = cs - 1; } }
+        if (!enc && strstr(tmp, "gzip")) { snprintf(cpath, sizeof cpath, "%s.gz", path);
+            if (!file_size(cpath, &cs, &cd) && !cd) { enc = "gzip"; size = cs; b = cs - 1; } }
+    }
+
+    FILE* f = fopen(enc ? cpath : path, "rb");
+    if (!f) { simple(s, 403, "cannot open", keep); return keep; }
+
+    /* html / js / wasm revalidate (a rebuild must show up); data files are content-addressed or immutable. */
+    const int store = mounted < 0 || g_mounts[mounted].cacheable;
+    const char* cache = !store ? "no-store" :
+                        (strstr(type, "html") || strstr(type, "javascript") || strstr(type, "wasm") ||
+                         strstr(type, "json")) ? "no-cache" : "public, max-age=31536000, immutable";
+    /* Validators for everything the browser may keep (not for no-store mounts): ETag (size + mtime of the bytes
+     * sent, per encoding) and Last-Modified, so a no-cache revalidation can answer 304 -- the browser then keeps
+     * its HTTP-cache copy, and with it V8's compiled-code cache of thp8.wasm (TurboFan code from the last session)
+     * instead of a fresh 200 that throws both away on every launch. */
+    char etag[96] = "", vh[256] = "";
+    if (store) {
+        int64_t vs = size, vm = mtime; int vd;
+        if (enc) file_size_mtime(cpath, &vs, &vd, &vm);
+        snprintf(etag, sizeof etag, "\"%llx-%llx%s%s\"", (unsigned long long)vs, (unsigned long long)vm, enc ? "-" : "", enc ? enc : "");
+        char lm[64] = ""; time_t t = (time_t)vm; struct tm g;
+#if defined(_WIN32)
+        gmtime_s(&g, &t);
+#else
+        gmtime_r(&t, &g);
+#endif
+        strftime(lm, sizeof lm, "%a, %d %b %Y %H:%M:%S GMT", &g);
+        snprintf(vh, sizeof vh, "ETag: %s\r\nLast-Modified: %s\r\n", etag, lm);
+        if (!ranged && hdr(req, "If-None-Match", tmp, sizeof tmp) && strstr(tmp, etag)) {
+            fclose(f);
+            char m[1024];
+            int n304 = snprintf(m, sizeof m,
+                "HTTP/1.1 304 Not Modified\r\n%sCache-Control: %s\r\n"
+                "Cross-Origin-Opener-Policy: same-origin\r\nCross-Origin-Embedder-Policy: require-corp\r\n"
+                "Cross-Origin-Resource-Policy: same-origin\r\n%sConnection: %s\r\n\r\n",
+                vh, cache, enc ? "Vary: Accept-Encoding\r\n" : "", keep ? "keep-alive" : "close");
+            send_all(s, m, (size_t)n304);
+            return keep;
+        }
+    }
+    char h[1400], cr[160] = "", ce[96] = "";
+    if (ranged)
+        snprintf(cr, sizeof cr, "Content-Range: bytes %lld-%lld/%lld\r\n", (long long)a, (long long)b, (long long)size);
+    if (enc)
+        snprintf(ce, sizeof ce, "Content-Encoding: %s\r\nVary: Accept-Encoding\r\n", enc);
+    int n = snprintf(h, sizeof h,
+        "HTTP/1.1 %s\r\nContent-Type: %s\r\nContent-Length: %lld\r\nAccept-Ranges: bytes\r\n"
+        "Cross-Origin-Opener-Policy: same-origin\r\nCross-Origin-Embedder-Policy: require-corp\r\n"
+        "Cross-Origin-Resource-Policy: same-origin\r\nCache-Control: %s\r\nX-Content-Type-Options: nosniff\r\n"
+        "%s%s%sConnection: %s\r\n\r\n",
+        ranged ? "206 Partial Content" : "200 OK", type, (long long)(b - a + 1), cache, vh, cr, ce,
+        keep ? "keep-alive" : "close");
+    int ok = send_all(s, h, (size_t)n) == 0;
+    if (ok && !head) {
+        static const size_t CH = 1 << 20;
+        char* buf = (char*)malloc(CH);
+        fseeko(f, a, SEEK_SET);
+        int64_t left = b - a + 1;
+        while (ok && left > 0) {
+            size_t want = left > (int64_t)CH ? CH : (size_t)left;
+            size_t got = fread(buf, 1, want, f);
+            if (!got) { ok = 0; break; }
+            ok = send_all(s, buf, got) == 0;
+            left -= (int64_t)got;
+        }
+        free(buf);
+    }
+    fclose(f);
+    return ok && keep;
+}
+
+#ifdef _WIN32
+static DWORD WINAPI conn_main(LPVOID p)
+#else
+static void* conn_main(void* p)
+#endif
+{
+    sock_t s = (sock_t)(intptr_t)p;
+    int one = 1;
+    setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char*)&one, sizeof one);
+    char req[16384]; size_t have = 0;
+    for (;;) {
+        char* end;
+        while (!(end = (have ? strstr(req, "\r\n\r\n") : NULL))) {
+            if (have + 1 >= sizeof req) goto done;
+            int k = recv(s, req + have, (int)(sizeof req - 1 - have), 0);
+            if (k <= 0) goto done;
+            have += (size_t)k; req[have] = 0;
+        }
+        size_t used = (size_t)(end + 4 - req);
+        char save = req[used]; req[used] = 0;
+        int keep = handle(s, req);
+        req[used] = save;
+        memmove(req, req + used, have - used); have -= used; req[have] = 0;
+        if (!keep) break;
+    }
+done:
+    CLOSESOCK(s);
+    return 0;
+}
+
+static void exe_dir(char* out, size_t cap, const char* argv0)
+{
+#ifdef _WIN32
+    GetModuleFileNameA(NULL, out, (DWORD)cap);
+#else
+    char tmp[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", tmp, sizeof tmp - 1);
+    if (n > 0) { tmp[n] = 0; snprintf(out, cap, "%s", tmp); }
+    else if (!realpath(argv0, out)) snprintf(out, cap, "%s", argv0);
+#endif
+    char* sl = strrchr(out, '/');
+#ifdef _WIN32
+    char* bs = strrchr(out, '\\'); if (bs > sl) sl = bs;
+#endif
+    if (sl) *sl = 0; else snprintf(out, cap, ".");
+}
+
+int main(int argc, char** argv)
+{
+    const char* host = "127.0.0.1"; int port = 8080, open_browser = 0; const char* dir = NULL;
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--dir") && i + 1 < argc) dir = argv[++i];
+        else if (!strcmp(argv[i], "--port") && i + 1 < argc) port = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "--host") && i + 1 < argc) host = argv[++i];
+        else if (!strcmp(argv[i], "--open")) open_browser = 1;
+        else if ((!strcmp(argv[i], "--mount") || !strcmp(argv[i], "--mount-cache")) && i + 1 < argc) {
+            if (g_nmounts >= MAX_MOUNTS) { fprintf(stderr, "too many --mount (max %d)\n", MAX_MOUNTS); return 2; }
+            g_mounts[g_nmounts].cacheable = !strcmp(argv[i], "--mount-cache");
+            const char* a = argv[++i];
+            const char* eq = strchr(a, '=');
+            if (!eq || a[0] != '/' || eq == a + 1 || (size_t)(eq - a) >= sizeof g_mounts[0].prefix || !eq[1] ||
+                !safe_path_prefix(a, (size_t)(eq - a))) {
+                fprintf(stderr, "bad --mount %s (want /url/prefix=PATH)\n", a);
+                return 2;
+            }
+            size_t pl = (size_t)(eq - a);
+            while (pl > 1 && a[pl - 1] == '/') pl--;
+            memcpy(g_mounts[g_nmounts].prefix, a, pl);
+            g_mounts[g_nmounts].prefix[pl] = 0;
+            g_mounts[g_nmounts].plen = pl;
+            char* d = g_mounts[g_nmounts].dir;
+            snprintf(d, sizeof g_mounts[0].dir, "%s", eq + 1);
+            size_t dl = strlen(d);
+            while (dl > 1 && (d[dl - 1] == '/' || d[dl - 1] == '\\')) d[--dl] = 0;
+            int64_t sz; int isd;
+            if (file_size(d, &sz, &isd)) { fprintf(stderr, "--mount: %s not found\n", d); return 2; }
+            g_nmounts++;
+        }
+        else { fprintf(stderr, "usage: %s [--dir DIR] [--port N] [--host ADDR] [--open] [--mount /URL/PREFIX=PATH ...] [--mount-cache /URL/PREFIX=PATH ...]\n", argv[0]); return 2; }
+    }
+    if (dir) snprintf(g_root, sizeof g_root, "%s", dir);
+    else {
+        char ed[4096]; int64_t sz; int isd;
+        exe_dir(ed, sizeof ed, argv[0]);
+        snprintf(g_root, sizeof g_root, "%s/www", ed);
+        if (file_size(g_root, &sz, &isd) || !isd) snprintf(g_root, sizeof g_root, "%s", ed);
+    }
+    size_t L = strlen(g_root);
+    while (L > 1 && (g_root[L - 1] == '/' || g_root[L - 1] == '\\')) g_root[--L] = 0;
+
+#ifdef _WIN32
+    WSADATA wd; WSAStartup(MAKEWORD(2, 2), &wd);
+#else
+    signal(SIGPIPE, SIG_IGN);
+#endif
+    struct addrinfo hints = {0}, *ai = NULL;
+    hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM; hints.ai_flags = AI_PASSIVE | AI_NUMERICHOST;
+    char ps[16]; snprintf(ps, sizeof ps, "%d", port);
+    if (getaddrinfo(host, ps, &hints, &ai) || !ai) { fprintf(stderr, "bad --host %s\n", host); return 1; }
+    sock_t ls = socket(ai->ai_family, SOCK_STREAM, 0);
+    int one = 1;
+#ifdef _WIN32
+    /* Windows' SO_REUSEADDR lets a second server bind the same port silently; refuse instead */
+    setsockopt(ls, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, (const char*)&one, sizeof one);
+#else
+    setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, (const char*)&one, sizeof one);
+#endif
+    if (ls == INVALID_SOCKET || bind(ls, ai->ai_addr, (int)ai->ai_addrlen) || listen(ls, 64)) {
+        fprintf(stderr, "cannot listen on %s:%d (in use?)\n", host, port); return 1;
+    }
+    freeaddrinfo(ai);
+    int local = !strcmp(host, "127.0.0.1") || !strcmp(host, "::1") || !strcmp(host, "localhost");
+    printf("serving %s\n  open http://%s:%d/ in Chrome or Edge\n", g_root,
+           local ? "localhost" : host, port);
+    for (int m = 0; m < g_nmounts; m++) printf("  mount %s -> %s (read-only, %s)\n", g_mounts[m].prefix, g_mounts[m].dir,
+                                               g_mounts[m].cacheable ? "cacheable: no-cache + ETag" : "no-store");
+    if (!local)
+        printf("  WARNING: bound to %s -- other machines on that network can load this folder.\n"
+               "  Browsers only enable SharedArrayBuffer on https:// or localhost; see README.\n", host);
+    fflush(stdout);
+    if (open_browser && local) {
+        char url[64]; snprintf(url, sizeof url, "http://localhost:%d/", port);
+#ifdef _WIN32
+        ShellExecuteA(NULL, "open", url, NULL, NULL, SW_SHOWNORMAL);
+#elif defined(__APPLE__)
+        char c[128]; snprintf(c, sizeof c, "open '%s' &", url); if (system(c)) {}
+#else
+        char c[128]; snprintf(c, sizeof c, "xdg-open '%s' >/dev/null 2>&1 &", url); if (system(c)) {}
+#endif
+    }
+    for (;;) {
+        sock_t c = accept(ls, NULL, NULL);
+        if (c == INVALID_SOCKET) continue;
+#ifdef _WIN32
+        HANDLE t = CreateThread(NULL, 256 << 10, conn_main, (LPVOID)(intptr_t)c, 0, NULL);
+        if (t) CloseHandle(t); else CLOSESOCK(c);
+#else
+        pthread_t t; pthread_attr_t at; pthread_attr_init(&at);
+        pthread_attr_setstacksize(&at, 256 << 10);
+        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+        if (pthread_create(&t, &at, conn_main, (void*)(intptr_t)c)) CLOSESOCK(c);
+        pthread_attr_destroy(&at);
+#endif
+    }
+}
diff --git a/web/tools/mkdata.py b/web/tools/mkdata.py
new file mode 100644
index 00000000..ea0afbed
--- /dev/null
+++ b/web/tools/mkdata.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""mkdata.py -- pack a title's data from the user's OWN game folder into a portable web folder.
+
+  python mkdata.py --game <disc root containing PS3_GAME> --out <www folder> [--mode copy|hardlink|index]
+                   [--skip-movies]
+  python mkdata.py --folder <dir> --name <pack> --out <www folder> [--mode ...] [--include GLOB ...] [--exclude GLOB ...]
+
+Writes <out>/data/index.json  {"version": 1, "build": <id>, "files": {"PS3_GAME/USRDIR/...": [size, mtime_ns], ...}}
+and the files themselves under <out>/data/files/<same relative path>. The browser VFS fetches byte ranges of those
+files on demand and caches them in OPFS, so nothing has to be downloaded up front.
+
+--folder packs any folder the same way into <out>/<pack>/ instead of <out>/data/ -- e.g. a mods folder as
+mods_<name>, which the page mounts at /mods with ?mods=<name>. --include / --exclude are fnmatch globs on the
+'/'-separated relative path (an --include list keeps only matching files; --exclude wins).
+
+The source folder is only READ (copy and hardlink never write to it; a hardlink shares the file, so never edit files
+under the output). --mode index writes just the index: with a server --mount of the source folder at
+/<pack>/files (web/serve) the pack is served straight from where it lives, nothing copied. All paths in the output
+are relative. Folders named *.cap_stage and directory links / junctions are never entered (they point into other
+places, e.g. the user's own packs)."""
+import argparse, fnmatch, hashlib, json, os, shutil, sys, time
+
+ap = argparse.ArgumentParser()
+src_grp = ap.add_mutually_exclusive_group(required=True)
+src_grp.add_argument("--game")
+src_grp.add_argument("--folder")
+ap.add_argument("--name", help="output subfolder for --folder (e.g. mods_p8plus)")
+ap.add_argument("--out", required=True)
+ap.add_argument("--mode", choices=["copy", "hardlink", "index"], default="copy")
+ap.add_argument("--skip-movies", action="store_true", help="leave out PS3_GAME/USRDIR/DATA/MOVIES (Bink, 3.8 GB on THP8)")
+ap.add_argument("--include", action="append", default=[])
+ap.add_argument("--exclude", action="append", default=[])
+a = ap.parse_args()
+
+if a.game:
+    game = os.path.abspath(a.game)
+    if not os.path.isdir(os.path.join(game, "PS3_GAME")):
+        sys.exit(f"{game} has no PS3_GAME folder")
+    data = os.path.join(os.path.abspath(a.out), "data")
+else:
+    game = os.path.abspath(a.folder)
+    if not os.path.isdir(game):
+        sys.exit(f"{game} is not a folder")
+    if not a.name or not all(c.isalnum() or c == "_" for c in a.name):
+        sys.exit("--folder needs --name <letters, digits, _>")
+    data = os.path.join(os.path.abspath(a.out), a.name)
+files_root = os.path.join(data, "files")
+os.makedirs(data if a.mode == "index" else files_root, exist_ok=True)
+
+
+def wanted(rel):
+    if a.include and not any(fnmatch.fnmatchcase(rel, g) for g in a.include):
+        return False
+    return not any(fnmatch.fnmatchcase(rel, g) for g in a.exclude)
+
+
+index, total, n, t0 = {}, 0, 0, time.time()
+def enter(dp, d):
+    if d.lower().endswith(".cap_stage"):
+        return False
+    full = os.path.join(dp, d)
+    isj = getattr(os.path, "isjunction", None)
+    return not (os.path.islink(full) or (isj and isj(full)))
+
+
+for dp, dn, fn in os.walk(game):
+    dn[:] = sorted(d for d in dn if enter(dp, d))
+    for f in sorted(fn):
+        src = os.path.join(dp, f)
+        rel = os.path.relpath(src, game).replace(os.sep, "/")
+        if a.skip_movies and rel.upper().startswith("PS3_GAME/USRDIR/DATA/MOVIES/"):
+            continue
+        if not wanted(rel):
+            continue
+        st = os.stat(src)
+        index[rel] = [st.st_size, st.st_mtime_ns]
+        total += st.st_size; n += 1
+        if a.mode == "index":
+            continue
+        dst = os.path.join(files_root, rel)
+        os.makedirs(os.path.dirname(dst), exist_ok=True)
+        if os.path.exists(dst) and os.path.getsize(dst) == st.st_size:
+            continue
+        if a.mode == "hardlink":
+            try:
+                os.link(src, dst); continue
+            except OSError:
+                pass                                   # other volume: fall back to a copy
+        shutil.copyfile(src, dst + ".part"); os.replace(dst + ".part", dst)
+
+build = hashlib.sha256(json.dumps(index, sort_keys=True).encode()).hexdigest()[:16]
+json.dump({"version": 1, "build": build, "files": index}, open(os.path.join(data, "index.json"), "w"),
+          separators=(",", ":"))
+print(f"{n} files, {total / 2**30:.2f} GiB, build {build}, {time.time() - t0:.0f} s, mode {a.mode} -> {data}")
diff --git a/web/tools/wasmstat.py b/web/tools/wasmstat.py
new file mode 100644
index 00000000..9ec385cb
--- /dev/null
+++ b/web/tools/wasmstat.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""wasmstat.py FILE.wasm|FILE.o ... -- section sizes, function count, largest function bodies and local counts,
+checked against V8's engine limits (kV8MaxWasmFunctionSize 7,654,321 bytes, kV8MaxWasmFunctionLocals 50,000,
+kV8MaxWasmFunctions 1,000,000). Works on linked modules and on relocatable objects."""
+import struct, sys
+
+V8_MAX_BODY, V8_MAX_LOCALS, V8_MAX_FUNCS = 7_654_321, 50_000, 1_000_000
+SEC = {0: "custom", 1: "type", 2: "import", 3: "function", 4: "table", 5: "memory", 6: "global", 7: "export",
+       8: "start", 9: "element", 10: "code", 11: "data", 12: "datacount", 13: "tag"}
+
+
+def uleb(b, i):
+    r = s = 0
+    while True:
+        x = b[i]; i += 1
+        r |= (x & 0x7F) << s; s += 7
+        if x < 0x80:
+            return r, i
+
+
+def stat(path, top=8):
+    b = open(path, "rb").read()
+    assert b[:4] == b"\0asm", path
+    i, secs, bodies = 8, {}, []
+    while i < len(b):
+        sid = b[i]; i += 1
+        n, i = uleb(b, i)
+        end = i + n
+        name = SEC.get(sid, str(sid))
+        if sid == 0:
+            ln, j = uleb(b, i)
+            name = "custom:" + b[j:j + ln].decode("utf-8", "replace")
+        secs[name] = secs.get(name, 0) + n
+        if sid == 10:
+            cnt, j = uleb(b, i)
+            for k in range(cnt):
+                sz, j = uleb(b, j)
+                body_end = j + sz
+                nl, jj = uleb(b, j)
+                locs = 0
+                for _ in range(nl):
+                    c, jj = uleb(b, jj); jj += 1
+                    locs += c
+                bodies.append((sz, locs, k))
+                j = body_end
+        i = end
+    print(f"== {path}: {len(b):,} bytes")
+    for k, v in sorted(secs.items(), key=lambda kv: -kv[1])[:10]:
+        print(f"   {k:28s} {v:>14,}")
+    if bodies:
+        bodies.sort(reverse=True)
+        print(f"   functions {len(bodies):,}; code {sum(x[0] for x in bodies):,} bytes; "
+              f"largest {bodies[0][0]:,} B; max locals {max(x[1] for x in bodies):,}")
+        print("   top bodies (bytes, locals, index):", ", ".join(f"{s:,}/{l}/#{k}" for s, l, k in bodies[:top]))
+        over = [x for x in bodies if x[0] > V8_MAX_BODY]
+        lover = [x for x in bodies if x[1] > V8_MAX_LOCALS]
+        print(f"   V8 limits: bodies>{V8_MAX_BODY:,}: {len(over)}; locals>{V8_MAX_LOCALS:,}: {len(lover)}; "
+              f"functions {'OK' if len(bodies) < V8_MAX_FUNCS else 'OVER'}")
+    return bodies
+
+
+if __name__ == "__main__":
+    allb = []
+    for p in sys.argv[1:]:
+        allb += stat(p)
+    if len(sys.argv) > 2 and allb:
+        allb.sort(reverse=True)
+        print(f"== TOTAL {len(allb):,} functions, {sum(x[0] for x in allb):,} code bytes, largest {allb[0][0]:,}, "
+              f"max locals {max(x[1] for x in allb):,}")
