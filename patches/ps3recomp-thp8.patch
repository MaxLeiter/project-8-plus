+/* ======================================================================== */
+/* Host API implementation                                                   */
+
+void api_log(const ps3mod_host* self, int level, const char* fmt, ...)
+{
+    if (level >= PS3MOD_LOG_DEBUG && !s_debug) return;
+    char buf[2048];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof buf, fmt ? fmt : "", ap);
+    va_end(ap);
+    size_t n = strlen(buf);
+    while (n && (buf[n - 1] == '\n' || buf[n - 1] == '\r')) buf[--n] = 0;
+    static const char* const kLv[] = { "error: ", "warning: ", "", "debug: " };
+    const char* lv = (level >= 0 && level <= 3) ? kLv[level] : "";
+    fprintf(stderr, "[mod:%s] %s%s\n", pname(find_plugin(self)), lv, buf);
+}
+
+/* -- guest memory ------------------------------------------------------- */
+uint8_t  api_read8 (uint32_t a) { return vm_read8(a); }
+uint16_t api_read16(uint32_t a) { return vm_read16(a); }
+uint32_t api_read32(uint32_t a) { return vm_read32(a); }
+uint64_t api_read64(uint32_t a) { return vm_read64(a); }
+float    api_read_f32(uint32_t a) { uint32_t u = vm_read32(a); float f; memcpy(&f, &u, 4); return f; }
+double   api_read_f64(uint32_t a) { uint64_t u = vm_read64(a); double f; memcpy(&f, &u, 8); return f; }
+void     api_write8 (uint32_t a, uint8_t v)  { vm_write8(a, v); }
+void     api_write16(uint32_t a, uint16_t v) { vm_write16(a, v); }
+void     api_write32(uint32_t a, uint32_t v) { vm_write32(a, v); }
+void     api_write64(uint32_t a, uint64_t v) { vm_write64(a, v); }
+void     api_write_f32(uint32_t a, float v)  { uint32_t u; memcpy(&u, &v, 4); vm_write32(a, u); }
+void     api_write_f64(uint32_t a, double v) { uint64_t u; memcpy(&u, &v, 8); vm_write64(a, u); }
+
+bool in_guest(uint32_t a, uint32_t n) { return VM_MAPPED && (uint64_t)a + n <= 0x100000000ull; }
+
+int api_read_block(uint32_t a, void* dst, uint32_t n)
+{
+    if (!n) return PS3MOD_OK;
+    if (!dst) return PS3MOD_E_ARG;
+    if (!in_guest(a, n)) return PS3MOD_E_RANGE;
+    memcpy(dst, vm_base + a, n);
+    return PS3MOD_OK;
+}
+
+int api_write_block(uint32_t a, const void* src, uint32_t n)
+{
+    if (!n) return PS3MOD_OK;
+    if (!src) return PS3MOD_E_ARG;
+    if (!in_guest(a, n)) return PS3MOD_E_RANGE;
+    memcpy(vm_base + a, src, n);
+    return PS3MOD_OK;
+}
+
+void* api_guest_to_host(uint32_t a, uint32_t n)
+{
+    return in_guest(a, n) ? (void*)(vm_base + a) : nullptr;
+}
+
+uint32_t api_host_to_guest(const void* p)
+{
+    if (!VM_MAPPED || !p) return 0;
+    const uintptr_t b = (uintptr_t)vm_base, q = (uintptr_t)p;
+    if (q < b || q - b >= 0x100000000ull) return 0;
+    return (uint32_t)(q - b);
+}
+
+/* -- hooks -------------------------------------------------------------- */
+void install_hook(plugin* p, hook_rec* r);
+
+/* hook_register (any_time = false) and hook_add (ABI 1.2, any_time = true). */
+int hook_common(const ps3mod_host* self, uint32_t addr, ps3mod_hook_fn fn, void* user, uint32_t mode,
+                const uint32_t* lrs, uint32_t n_lrs, uint32_t* handle_out, bool any_time)
+{
+    if (handle_out) *handle_out = 0;
+    plugin* p = find_plugin(self);
+    if (!p) return PS3MOD_E_ARG;
+    const bool loading = p->state == PLG_LOADING;
+    const bool live    = any_time && p->state == PLG_ACTIVE;
+    int r = PS3MOD_OK;
+    std::string why;
+    if (!loading && !live) {
+        r = PS3MOD_E_FROZEN;
+        why = any_time ? "plugin is not loaded" : "hook_register works only inside ps3mod_init (use hook_add)";
+    } else if (!fn || mode > PS3MOD_HOOK_REPLACE || (n_lrs && !lrs) || n_lrs > 4096) {
+        r = PS3MOD_E_ARG;
+        why = strf("bad argument (fn=%p mode=%u entry_lrs=%p n=%u)", (void*)fn, mode, (const void*)lrs, n_lrs);
+    } else if ((r = hookable(addr)) != PS3MOD_OK) {
+        why = r == PS3MOD_E_IMPORT_STUB
+            ? "an HLE import stub, not a lifted function (import stubs cannot be wrapped or replaced)"
+            : "not a lifted function entry in this exe's function_table";
+    } else if (mode == PS3MOD_HOOK_REPLACE && !n_lrs) {
+        spin_guard g(s_handle_lock);
+        for (const replace_owner& o : s_replaced)
+            if (o.addr == addr) {
+                r = PS3MOD_E_CONFLICT;
+                why = strf("plugin %s already replaces this function", pname(o.p));
+            }
+        for (const staged_hook& h : p->hooks)
+            if (h.addr == addr && h.mode == PS3MOD_HOOK_REPLACE && h.lrs.empty()) {
+                r = PS3MOD_E_CONFLICT;
+                why = "this plugin already replaces this function";
+            }
+    }
+    if (r != PS3MOD_OK) {
+        fprintf(stderr, "[mods] %s: %s hook on 0x%08X refused: %s\n", p->file.c_str(),
+                mode == PS3MOD_HOOK_REPLACE ? "replace" : "wrap", addr, why.c_str());
+        if (loading) p->init_errors++;
+        return r;
+    }
+    hook_rec* rec = new_hook_rec(p, addr, fn, user, mode, lrs, n_lrs);
+    if (handle_out) *handle_out = rec->handle;
+    if (live) {                                   /* ABI 1.2: live at once */
+        install_hook(p, rec);
+        return PS3MOD_OK;
+    }
+    staged_hook h;
+    h.addr = addr; h.rec = rec; h.mode = mode;
+    if (n_lrs) h.lrs.assign(lrs, lrs + n_lrs);
+    p->hooks.push_back(std::move(h));
+    return PS3MOD_OK;
+}
+
+int api_hook_register(const ps3mod_host* self, uint32_t addr, ps3mod_hook_fn fn,
+                      void* user, uint32_t mode, const uint32_t* lrs, uint32_t n_lrs)
+{
+    return hook_common(self, addr, fn, user, mode, lrs, n_lrs, nullptr, false);
+}
+
+int api_hook_add(const ps3mod_host* self, uint32_t addr, ps3mod_hook_fn fn, void* user,
+                 uint32_t mode, const uint32_t* lrs, uint32_t n_lrs, uint32_t* handle_out)
+{
+    return hook_common(self, addr, fn, user, mode, lrs, n_lrs, handle_out, true);
+}
+
+int api_hook_enable(const ps3mod_host* self, uint32_t handle, int on)
+{
+    const plugin* p = find_plugin(self);
+    hook_rec* r = nullptr;
+    {
+        spin_guard g(s_handle_lock);
+        if (handle && handle <= s_handles.size()) r = s_handles[handle - 1];
+    }
+    if (!p || !r || r->owner != p) return PS3MOD_E_ARG;
+    const int was = r->enabled.exchange(on ? 1 : 0, std::memory_order_relaxed);
+    if (s_debug && was != (on ? 1 : 0))
+        fprintf(stderr, "[mods] %s: hook #%u on 0x%08X %s\n", pname(p), handle, r->addr, on ? "enabled" : "disabled");
+    return PS3MOD_OK;
+}
+
+void api_call_next(ps3mod_ctx* ctx, const ps3mod_link* next)
+{
+    if (ctx && next) ppu_hook_call_next((struct ppu_context*)ctx, (const ppu_hook_link*)next);
+}
+
+int api_is_function_entry(uint32_t addr) { return hookable(addr) == PS3MOD_OK; }
+
+/* -- guest calls -------------------------------------------------------- */
+int api_guest_call_ex(ps3mod_ctx* pctx, ps3mod_call* call)
+{
+    if (!call) return PS3MOD_E_ARG;
+    const uint32_t sz = call->size ? call->size : kCallV1;
+    if (sz < kCallV1 || call->n_gpr > 8 || call->n_fpr > 8) return PS3MOD_E_ARG;
+    uint32_t code = call->code, toc = call->toc;
+    if (call->opd && !ppu_opd_resolve(call->opd, &code, &toc)) {
+        fprintf(stderr, "[mods] guest_call: OPD 0x%08X has no code address\n", call->opd);
+        return PS3MOD_E_NOT_ENTRY;
+    }
+    if (fn_find(code) < 0) {
+        fprintf(stderr, "[mods] guest_call: 0x%08X (OPD 0x%08X) is not a lifted function\n", code, call->opd);
+        return PS3MOD_E_NOT_ENTRY;
+    }
+    uint64_t a[8] = { 0 };
+    for (uint32_t i = 0; i < call->n_gpr; i++) a[i] = call->gpr[i];
+
+    if (!pctx) {
+        /* Host thread: the runtime's own host->guest callback path (scratch
+         * stack, thread identity, trampoline drain, g_active_ctx restore). */
+        if (call->n_fpr) {
+            fprintf(stderr, "[mods] guest_call: float arguments need a hook's ctx\n");
+            return PS3MOD_E_ARG;
+        }
+        call->ret_r3 = ppu_guest_call_ct(code, toc, a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]);
+        call->ret_f1 = 0.0;
+        return PS3MOD_OK;
+    }
+
+    /* Guest thread: a child frame below the caller's stack pointer. Nothing
+     * of the hooked function's own frame lives below r1 at a hook boundary
+     * (before call_next it has not been built, after it has been popped);
+     * 0x400 bytes clear the 288-byte ABI-protected zone and leave room for the
+     * callee's LR/CR/TOC save words and parameter save area. */
+    ppu_context* parent = (ppu_context*)pctx;
+    ppu_context child;
+    memcpy(&child, parent, sizeof child);
+    const uint32_t sp = ((uint32_t)parent->gpr[1] - 0x400u) & ~0xFu;
+    vm_write64(sp, (uint32_t)parent->gpr[1]);     /* back chain */
+    child.gpr[1] = sp;
+    child.gpr[2] = toc;
+    for (int i = 0; i < 8; i++) child.gpr[3 + i] = a[i];
+    for (uint32_t i = 0; i < call->n_fpr; i++) child.fpr[1 + i] = call->fpr[i];
+    child.lr  = 0;
+    child.ctr = code;
+    child.cia = code;
+    child.reserve_valid = 0;
+    void (*pending)(void*) = g_trampoline_fn;     /* a caller's tail call, if any */
+    g_trampoline_fn = nullptr;
+    ppu_context* saved_active = g_active_ctx;
+    ps3_indirect_call(&child);                    /* registry dispatch: hooks apply */
+    while (g_trampoline_fn) {
+        void (*tf)(void*) = g_trampoline_fn;
+        g_trampoline_fn = nullptr;
+        tf((void*)&child);
+    }
+    g_active_ctx    = saved_active;
+    g_trampoline_fn = pending;
+    call->ret_r3 = child.gpr[3];
+    call->ret_f1 = child.fpr[1];
+    return PS3MOD_OK;
+}
+
+uint64_t api_guest_call(ps3mod_ctx* ctx, uint32_t opd, uint32_t nargs, const uint64_t* args)
+{
+    if (nargs > 8 || (nargs && !args)) {
+        fprintf(stderr, "[mods] guest_call: bad arguments (nargs=%u)\n", nargs);
+        return 0;
+    }
+    ps3mod_call c;
+    memset(&c, 0, sizeof c);
+    c.size  = (uint32_t)sizeof c;
+    c.opd   = opd;
+    c.n_gpr = nargs;
+    for (uint32_t i = 0; i < nargs; i++) c.gpr[i] = args[i];
+    return api_guest_call_ex(ctx, &c) == PS3MOD_OK ? c.ret_r3 : 0;
+}
+
+/* -- config ------------------------------------------------------------- */
+const char* cfg_lookup(const plugin* p, const char* key)
+{
+    if (!p || !key || !*key) return nullptr;
+    const std::string ek = env_norm(key);
+    for (const auto& e : p->env)
+        if (e.first == ek) return e.second.c_str();
+    for (const cfg_entry& c : p->cfg)                      /* top level, verbatim */
+        if (c.section.empty() && ieq(c.key, key)) return c.value.c_str();
+    const char* dot = strrchr(key, '.');
+    if (dot) {                                             /* "section.name" */
+        const std::string sec(key, (size_t)(dot - key));
+        for (const cfg_entry& c : p->cfg)
+            if (ieq(c.section, sec.c_str()) && ieq(c.key, dot + 1)) return c.value.c_str();
+    } else {                                               /* first match in any section */
+        for (const cfg_entry& c : p->cfg)
+            if (ieq(c.key, key)) return c.value.c_str();
+    }
+    return nullptr;
+}
+
+const char* api_cfg_str(const ps3mod_host* self, const char* key, const char* def)
+{
+    const char* v = cfg_lookup(find_plugin(self), key);
+    return v ? v : def;
+}
+
+int64_t api_cfg_int(const ps3mod_host* self, const char* key, int64_t def)
+{
+    const char* v = cfg_lookup(find_plugin(self), key);
+    if (!v || !*v) return def;
+    if (!_stricmp(v, "true") || !_stricmp(v, "yes") || !_stricmp(v, "on")) return 1;
+    if (!_stricmp(v, "false") || !_stricmp(v, "no") || !_stricmp(v, "off")) return 0;
+    char* end = nullptr;
+    long long r = strtoll(v, &end, 0);
+    if (end == v) return def;
+    return (int64_t)r;
+}
+
+double api_cfg_float(const ps3mod_host* self, const char* key, double def)
+{
+    const char* v = cfg_lookup(find_plugin(self), key);
+    if (!v || !*v) return def;
+    char* end = nullptr;
+    double r = strtod(v, &end);
+    return end == v ? def : r;
+}
+
+int api_cfg_bool(const ps3mod_host* self, const char* key, int def)
+{
+    const char* v = cfg_lookup(find_plugin(self), key);
+    if (!v) return def;
+    if (!strcmp(v, "1") || !_stricmp(v, "true") || !_stricmp(v, "yes") || !_stricmp(v, "on")) return 1;
+    if (!strcmp(v, "0") || !_stricmp(v, "false") || !_stricmp(v, "no") || !_stricmp(v, "off")) return 0;
+    return def;
+}
+
+/* -- display + events ----------------------------------------------------- */
+int api_get_display(ps3mod_display* out)
+{
+    if (!out) return PS3MOD_E_ARG;
+    uint32_t cap = out->size ? out->size : kDisplayV1;
+    if (cap > (uint32_t)sizeof(ps3mod_display)) cap = (uint32_t)sizeof(ps3mod_display);
+    if (cap < (uint32_t)sizeof(uint32_t)) return PS3MOD_E_ARG;
+    ps3mod_display d;
+    fill_display(&d);
+    d.size = cap;
+    memcpy(out, &d, cap);
+    return PS3MOD_OK;
+}
+
+int api_on_event(const ps3mod_host* self, uint32_t ev, ps3mod_event_fn fn, void* user)
+{
+    plugin* p = find_plugin(self);
+    if (!p) return PS3MOD_E_ARG;
+    if (!fn || ev < PS3MOD_EV_PRESENT || ev > PS3MOD_EV_SCREENSHOT) {
+        fprintf(stderr, "[mods] %s: on_event(%u) refused: bad argument\n", p->file.c_str(), ev);
+        if (p->state == PLG_LOADING) p->init_errors++;
+        return PS3MOD_E_ARG;
+    }
+    if (p->state == PLG_LOADING) { p->events.push_back({ ev, fn, user }); return PS3MOD_OK; }
+    if (p->state != PLG_ACTIVE) return PS3MOD_E_FROZEN;
+    return add_event(ev, fn, user);
+}
+
+/* -- frame pacing (ABI 1.1) ------------------------------------------------ */
+bool pace_rate_ok(double hz)
+{
+    return hz == PS3MOD_PACE_KEEP || hz == PS3MOD_PACE_DISPLAY || hz == PS3MOD_PACE_PRESENT ||
+           hz == PS3MOD_PACE_VBLANK || (hz >= 1.0 && hz <= 1000.0);
+}
+
+int api_set_pacing(const ps3mod_host* self, const ps3mod_pacing* in)
+{
+    plugin* p = find_plugin(self);
+    if (!p || !in) return PS3MOD_E_ARG;
+    if (p->state != PLG_LOADING) {
+        fprintf(stderr, "[mods] %s: set_pacing refused: only inside ps3mod_init\n", p->file.c_str());
+        return PS3MOD_E_FROZEN;
+    }
+    ps3mod_pacing v{};
+    const uint32_t n = in->size ? in->size : kPacingV1;
+    if (n < kPacingV1) { p->init_errors++; return PS3MOD_E_ARG; }
+    memcpy(&v, in, n < (uint32_t)sizeof v ? n : (uint32_t)sizeof v);
+    if (!pace_rate_ok(v.vblank_hz) || v.vblank_hz == PS3MOD_PACE_PRESENT || v.vblank_hz == PS3MOD_PACE_VBLANK ||
+        !pace_rate_ok(v.flip_hz) || v.vsync < -1 || v.vsync > 1 || v.max_latency < 0 || v.max_latency > 16) {
+        fprintf(stderr, "[mods] %s: set_pacing refused: bad values (vblank %.3f flip %.3f vsync %d latency %d)\n",
+                p->file.c_str(), v.vblank_hz, v.flip_hz, (int)v.vsync, (int)v.max_latency);
+        p->init_errors++;
+        return PS3MOD_E_ARG;
+    }
+    p->pacing = v;
+    p->has_pacing = true;
+    return PS3MOD_OK;
+}
+
+/* -- data patches --------------------------------------------------------- */
+void log_bytes(char* out, size_t cap, const uint8_t* b, uint32_t n)
+{
+    size_t o = 0;
+    out[0] = 0;
+    for (uint32_t i = 0; i < n && i < 8 && o + 4 < cap; i++)
+        o += (size_t)snprintf(out + o, cap - o, "%02X", b[i]);
+    if (n > 8 && o + 4 < cap) snprintf(out + o, cap - o, "..");
+}
+
+int api_patch(const ps3mod_host* self, uint32_t addr, const void* expect,
+              const void* bytes, uint32_t n, uint32_t flags)
+{
+    plugin* p = find_plugin(self);
+    if (!p) return PS3MOD_E_ARG;
+    const bool loading = p->state == PLG_LOADING;
+    int r = PS3MOD_OK;
+    std::string why;
+    if (p->state != PLG_LOADING && p->state != PLG_ACTIVE) {
+        r = PS3MOD_E_FROZEN; why = "plugin is not loaded";
+    } else if (!expect || !bytes || !n || n > (16u << 20) || (flags & ~(uint32_t)PS3MOD_PATCH_ALLOW_CODE)) {
+        r = PS3MOD_E_ARG; why = "bad argument (expect/bytes required, 1..16 MiB, known flags)";
+    } else if (!in_guest(addr, n)) {
+        r = PS3MOD_E_RANGE; why = "outside the 4 GiB guest space";
+    } else {
+        build_index();
+        if (!(flags & PS3MOD_PATCH_ALLOW_CODE) && addr < s_code_hi && (uint64_t)addr + n > s_code_lo) {
+            r = PS3MOD_E_RANGE;
+            why = strf("inside the lifted code range [0x%08X, 0x%08X): lifted code never reads its "
+                       "own instructions, so a code patch has no effect -- hook the function instead "
+                       "(PS3MOD_PATCH_ALLOW_CODE is only for data the game reads from there)",
+                       s_code_lo, s_code_hi);
+        } else if (memcmp(vm_base + addr, expect, n) != 0) {
+            uint32_t k = 0;
+            while (k < n && vm_base[addr + k] == ((const uint8_t*)expect)[k]) k++;
+            const uint32_t left = n - k;
+            char want[32], have[32];
+            log_bytes(want, sizeof want, (const uint8_t*)expect + k, left);
+            log_bytes(have, sizeof have, vm_base + addr + k, left);
+            r = PS3MOD_E_MISMATCH;
+            why = strf("original bytes differ at 0x%08X: expected %s, found %s "
+                       "(different game version, or another mod patched it)", addr + k, want, have);
+        }
+    }
+    if (r != PS3MOD_OK) {
+        fprintf(stderr, "[mods] %s: patch of %u bytes at 0x%08X refused: %s\n",
+                p->file.c_str(), n, addr, why.c_str());
+        if (loading) p->init_errors++;
+        return r;
+    }
+    if (loading) {
+        staged_patch sp;
+        sp.addr = addr; sp.flags = flags;
+        sp.expect.assign((const uint8_t*)expect, (const uint8_t*)expect + n);
+        sp.bytes.assign((const uint8_t*)bytes, (const uint8_t*)bytes + n);
+        p->patches.push_back(std::move(sp));
+        return PS3MOD_OK;
+    }
+    memcpy(vm_base + addr, bytes, n);
+    fprintf(stderr, "[mods] %s: patched %u bytes at 0x%08X\n", p->file.c_str(), n, addr);
+    return PS3MOD_OK;
+}
+
+/* -- guest heap (ABI 1.2) ------------------------------------------------------
+ * First fit over an address-ordered free list inside a reserved guest window
+ * that no runtime allocator and no title allocator hands out (vm.h map:
+ * 0x70000000..0x7F000000 is unowned; the HLE inject window starts at
+ * 0x7F000000). Pages are committed as the high-water mark grows. Block
+ * headers live on the host side (s_gh_used), so a guest overrun cannot
+ * corrupt the allocator. */
+const uint32_t kGuestHeapDefault = 0x7C000000u;
+const uint32_t kGuestHeapSize    = 0x03000000u;   /* 48 MiB */
+std::atomic<int> s_gh_lock{0};
+uint32_t s_gh_base = 0, s_gh_end = 0, s_gh_top = 0, s_gh_committed = 0;
+bool     s_gh_init = false;
+std::vector<std::pair<uint32_t, uint32_t>> s_gh_free;   /* (addr, size), sorted by addr */
+std::vector<std::pair<uint32_t, uint32_t>> s_gh_used;   /* (addr, size), sorted by addr */
+
+void gh_init_locked(void)
+{
+    if (s_gh_init) return;
+    s_gh_init = true;
+    uint32_t base = kGuestHeapDefault;
+    if (const char* e = getenv("PS3MOD_GUEST_HEAP")) {
+        const unsigned long long v = strtoull(e, nullptr, 16);
+        if (v >= 0x10000ull && v + kGuestHeapSize <= 0x80000000ull) base = (uint32_t)v & ~0xFFFFu;
+    }
+    s_gh_base = s_gh_top = s_gh_committed = base;
+    s_gh_end = base + kGuestHeapSize;
+}
+
+bool gh_commit_to(uint32_t end)
+{
+    if (end <= s_gh_committed) return true;
+    const uint32_t to = (end + 0xFFFFu) & ~0xFFFFu;
+#ifdef _WIN32
+    if (!VM_MAPPED || !VirtualAlloc(vm_base + s_gh_committed, to - s_gh_committed, MEM_COMMIT, PAGE_READWRITE))
+        return false;
+#elif defined(PS3_WASM)
+    /* WebAssembly: the guest space is the fixed 4 GiB linear memory (vm_base 0), all of it backed and zeroed;
+     * 0x7C000000..0x7F000000 is unowned there too (vm.h map; host data and heap start at 0x80000000) */
+#else
+    /* POSIX: the flat VM is one lazily backed RW mapping (boot_main); make sure, as vm_commit does */
+    if (!vm_base || mprotect(vm_base + s_gh_committed, (size_t)(to - s_gh_committed), PROT_READ | PROT_WRITE) != 0)
+        return false;
+#endif
+    s_gh_committed = to;
+    return true;
+}
+
+uint32_t api_guest_alloc(const ps3mod_host* self, uint32_t size, uint32_t align)
+{
+    if (!size || size > kGuestHeapSize) return 0;
+    if (align < 16) align = 16;
+    if (align & (align - 1)) return 0;
+    size = (size + 15u) & ~15u;
+    spin_guard g(s_gh_lock);
+    gh_init_locked();
+    uint32_t a = 0;
+    for (size_t i = 0; i < s_gh_free.size(); i++) {               /* first fit */
+        const uint32_t fa = s_gh_free[i].first, fs = s_gh_free[i].second;
+        const uint32_t aa = (fa + align - 1) & ~(align - 1);
+        if (aa - fa + (uint64_t)size > fs) continue;
+        a = aa;
+        const uint32_t head = aa - fa, tail = fs - head - size;
+        s_gh_free.erase(s_gh_free.begin() + (ptrdiff_t)i);
+        if (tail) s_gh_free.insert(s_gh_free.begin() + (ptrdiff_t)i, { aa + size, tail });
+        if (head) s_gh_free.insert(s_gh_free.begin() + (ptrdiff_t)i, { fa, head });
+        break;
+    }
+    if (!a) {                                                    /* bump */
+        const uint32_t aa = (s_gh_top + align - 1) & ~(align - 1);
+        if ((uint64_t)aa + size > s_gh_end || !gh_commit_to(aa + size)) {
+            fprintf(stderr, "[mods] %s: guest_alloc(%u) failed: guest heap full\n", pname(find_plugin(self)), size);
+            return 0;
+        }
+        if (aa > s_gh_top) {                                     /* alignment gap -> free list */
+            auto it = std::lower_bound(s_gh_free.begin(), s_gh_free.end(), std::make_pair(s_gh_top, 0u));
+            s_gh_free.insert(it, { s_gh_top, aa - s_gh_top });
+        }
+        a = aa;
+        s_gh_top = aa + size;
+    }
+    auto it = std::lower_bound(s_gh_used.begin(), s_gh_used.end(), std::make_pair(a, 0u));
+    s_gh_used.insert(it, { a, size });
+    memset(vm_base + a, 0, size);
+    return a;
+}
+
+void api_guest_free(const ps3mod_host* self, uint32_t addr)
+{
+    if (!addr) return;
+    spin_guard g(s_gh_lock);
+    auto it = std::lower_bound(s_gh_used.begin(), s_gh_used.end(), std::make_pair(addr, 0u));
+    if (it == s_gh_used.end() || it->first != addr) {
+        fprintf(stderr, "[mods] %s: guest_free(0x%08X): not a guest_alloc block\n", pname(find_plugin(self)), addr);
+        return;
+    }
+    uint32_t a = it->first, n = it->second;
+    s_gh_used.erase(it);
+    auto f = std::lower_bound(s_gh_free.begin(), s_gh_free.end(), std::make_pair(a, 0u));
+    if (f != s_gh_free.begin()) {                                /* merge with the previous block */
+        auto prev = f - 1;
+        if (prev->first + prev->second == a) { a = prev->first; n += prev->second; f = s_gh_free.erase(prev); }
+    }
+    if (f != s_gh_free.end() && a + n == f->first) { n += f->second; f = s_gh_free.erase(f); }
+    if (a + n == s_gh_top) { s_gh_top = a; return; }             /* give the tail back to the bump */
+    s_gh_free.insert(f, { a, n });
+}
+
+/* -- plugin services (ABI 1.2) ---------------------------------------------- */
+struct service { std::string name; uint32_t version; const void* table; const plugin* owner; };
+std::vector<service> s_services;
+std::atomic<int>     s_svc_lock{0};
+
+int api_service_publish(const ps3mod_host* self, const char* name, uint32_t version, const void* table)
+{
+    const plugin* p = find_plugin(self);
+    if (!p || !name || !*name || !table) return PS3MOD_E_ARG;
+    spin_guard g(s_svc_lock);
+    for (service& s : s_services)
+        if (s.name == name) {
+            if (s.owner != p) {
+                fprintf(stderr, "[mods] %s: service '%s' refused: already published by %s\n",
+                        pname(p), name, pname(s.owner));
+                return PS3MOD_E_CONFLICT;
+            }
+            s.version = version; s.table = table;
+            return PS3MOD_OK;
+        }
+    s_services.push_back({ name, version, table, p });
+    fprintf(stderr, "[mods] %s: service '%s' v%u published\n", pname(p), name, version);
+    return PS3MOD_OK;
+}
+
+const void* api_service_get(const ps3mod_host* self, const char* name, uint32_t min_version)
+{
+    (void)self;
+    if (!name) return nullptr;
+    spin_guard g(s_svc_lock);
+    for (const service& s : s_services)
+        if (s.name == name) return s.version >= min_version ? s.table : nullptr;
+    return nullptr;
+}
+
+void drop_services(const plugin* p)
+{
+    spin_guard g(s_svc_lock);
+    s_services.erase(std::remove_if(s_services.begin(), s_services.end(),
+                                    [p](const service& s) { return s.owner == p; }), s_services.end());
+}
+
+/* -- overlay rescan / screenshot / debug lines (ABI 1.2, live link) ----------
+ * Declared in the shared 1.2 header; the live-link runtime work fills them in. */
+int api_mods_rescan(const ps3mod_host* self, uint32_t flags, ps3mod_rescan* out)
+{
+    if (!find_plugin(self)) return PS3MOD_E_ARG;
+    if (!flags) flags = PS3MOD_RESCAN_FILES | PS3MOD_RESCAN_TEXTURES;
+    const auto t0 = std::chrono::steady_clock::now();
+    ps3mod_rescan r;
+    memset(&r, 0, sizeof r);
+    r.size = (uint32_t)sizeof r;
+    int rc = PS3MOD_OK;
+    if (flags & PS3MOD_RESCAN_FILES) {
+        ps3_mods_rescan_info fi;
+        if (ps3_mods_rescan(&fi) != 0) rc = PS3MOD_E_UNAVAILABLE;
+        r.files = (uint32_t)fi.files; r.added = (uint32_t)fi.added;
+        r.removed = (uint32_t)fi.removed; r.changed = (uint32_t)fi.changed;
+        r.fingerprint = fi.fingerprint;
+    }
+    if (flags & PS3MOD_RESCAN_TEXTURES) {
+#if defined(_WIN32) || defined(PS3_WASM)
+        uint32_t t[4] = { 0, 0, 0, 0 };
+        if (texrepl_rescan(t) == 0) {
+            r.textures = t[0]; r.tex_added = t[1]; r.tex_removed = t[2]; r.tex_changed = t[3];
+        } else if (!(flags & PS3MOD_RESCAN_FILES)) {
+            rc = PS3MOD_E_UNAVAILABLE;
+        }
+#else
+        uint32_t t[4] = { 0, 0, 0, 0 };
+        if (texrepl_rescan && texrepl_rescan(t) == 0) {
+            r.textures = t[0]; r.tex_added = t[1]; r.tex_removed = t[2]; r.tex_changed = t[3];
+        } else if (!(flags & PS3MOD_RESCAN_FILES)) {
+            rc = PS3MOD_E_UNAVAILABLE;
+        }
+#endif
+    }
+    r.ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    if (out) {
+        const uint32_t n = out->size ? out->size : (uint32_t)sizeof r;
+        r.size = n < (uint32_t)sizeof r ? n : (uint32_t)sizeof r;
+        memcpy(out, &r, r.size);
+    }
+    return rc;
+}
+
+#if defined(_WIN32) || !defined(PS3_WASM)   /* + Linux: rsx_live_overlay.c (stubs = unavailable without vkd3d) */
+std::atomic<uint64_t> s_shot_seq{0};
+
+/* rsx_live_overlay.c writer thread: one PS3MOD_EV_SCREENSHOT to every handler. */
+void shot_done(const char* path, int result, uint32_t w, uint32_t h, void* user)
+{
+    (void)w; (void)h;
+    const int n = s_nev.load(std::memory_order_acquire);
+    ps3mod_event e;
+    memset(&e, 0, sizeof e);
+    e.size   = (uint32_t)sizeof e;
+    e.ev     = PS3MOD_EV_SCREENSHOT;
+    e.count  = (uint64_t)(uintptr_t)user;
+    fill_display(&e.display);
+    e.result = result == 0 ? PS3MOD_OK : PS3MOD_E_UNAVAILABLE;
+    e.path   = path;
+    for (int i = 0; i < n; i++)
+        if (s_ev[i].ev == PS3MOD_EV_SCREENSHOT) s_ev[i].fn(&e, s_ev[i].user);
+}
+#endif
+
+int api_screenshot(const ps3mod_host* self, const char* path, uint32_t flags)
+{
+    if (!find_plugin(self) || !path || !*path) return PS3MOD_E_ARG;
+#if defined(_WIN32) || !defined(PS3_WASM)
+    const uint64_t id = s_shot_seq.fetch_add(1, std::memory_order_relaxed) + 1;
+    const int r = rsx_live_screenshot(path, (flags & PS3MOD_SHOT_GUEST) ? RSX_LIVE_SHOT_GUEST : 0u,
+                                      shot_done, (void*)(uintptr_t)id);
+    return r == 0 ? PS3MOD_OK : r == -1 ? PS3MOD_E_UNAVAILABLE : r == -2 ? PS3MOD_E_CONFLICT : PS3MOD_E_ARG;
+#else
+    (void)flags;
+    return PS3MOD_E_UNAVAILABLE;
+#endif
+}
+
+int api_debug_lines(const ps3mod_host* self, const ps3mod_line* v, uint32_t n, uint32_t flags)
+{
+    plugin* p = find_plugin(self);
+    if (!p || (n && !v)) return PS3MOD_E_ARG;
+#if defined(_WIN32) || !defined(PS3_WASM)
+    static_assert(sizeof(ps3mod_line) == sizeof(rsx_live_line), "ps3mod_line == rsx_live_line");
+    uint32_t owner = 0;
+    while (owner < s_plugins.size() && s_plugins[owner] != p) owner++;
+    const uint32_t rf = ((flags & PS3MOD_LINES_NDC) ? RSX_LIVE_LINES_NDC : 0u) |
+                        ((flags & PS3MOD_LINES_TRIS) ? RSX_LIVE_LINES_TRIS : 0u) |
+                        ((flags & PS3MOD_LINES_QUERY) ? RSX_LIVE_LINES_QUERY : 0u);
+    const int r = rsx_live_debug_lines(owner, reinterpret_cast<const rsx_live_line*>(v), n, rf);
+    if (r == 1 && (flags & PS3MOD_LINES_QUERY)) return 1;          /* triangle sets supported */
+    return r == 0 ? PS3MOD_OK : r == -1 ? PS3MOD_E_UNAVAILABLE : PS3MOD_E_ARG;
+#else
+    (void)flags;
+    return PS3MOD_E_UNAVAILABLE;
+#endif
+}
