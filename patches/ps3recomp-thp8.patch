diff --git a/tools/spucheck/build_replay.sh b/tools/spucheck/build_replay.sh
new file mode 100644
index 00000000..1f998ac8
--- /dev/null
+++ b/tools/spucheck/build_replay.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# build_replay.sh -- build spu_replay.exe (whole-program SPU replay / dispatch bench).
+#
+#   tools/spucheck/build_replay.sh <runtime.lib> <lifted-spu-dir> <out-dir> [jobs]
+#
+#   runtime.lib     prebuilt ps3recomp_runtime.lib (clang-cl, /MD, same tree as this script)
+#   lifted-spu-dir  the title's lifted SPU sources (every *.c below it is compiled;
+#                   THP8: <thp8-native>/src/spu_gen, self-registering via a constructor)
+#   out-dir         object files + spu_replay.exe
+# Needs clang-cl/link on PATH (THP8: run under tools/vsbuild.sh). Object files are
+# reused when newer than their source and the runtime headers.
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+root="$(cd "$here/../.." && pwd)"
+lib="$1"; gen="$2"; out="$3"; jobs="${4:-2}"
+mkdir -p "$out/obj"
+CFLAGS=(-nologo -c -MD -O2 -Z7 -msse4.1 -fno-strict-aliasing /clang:-ffp-contract=off
+        -DWIN32 -D_WINDOWS -DNDEBUG -w
+        -I "$root/runtime/spu" -I "$root/runtime" -I "$root/include" -I "$root/runtime/platform")
+hdr_time=$(stat -c %Y "$root"/runtime/spu/*.h | sort -n | tail -1)
+srcs=("$here/spu_replay.c")
+while IFS= read -r f; do srcs+=("$f"); done < <(find "$gen" -name '*.c' | sort)
+objs=()
+pids=()
+for s in "${srcs[@]}"; do
+    rel="${s#$gen/}"; rel="${rel//\//_}"
+    o="$out/obj/${rel%.c}.obj"
+    objs+=("$o")
+    if [ -f "$o" ] && [ "$o" -nt "$s" ] && [ "$(stat -c %Y "$o")" -ge "$hdr_time" ]; then continue; fi
+    clang-cl "${CFLAGS[@]}" "$(cygpath -w "$s")" -Fo"$(cygpath -w "$o")" &
+    pids+=($!)
+    if [ ${#pids[@]} -ge "$jobs" ]; then wait "${pids[0]}"; pids=("${pids[@]:1}"); fi
+done
+for p in "${pids[@]}"; do wait "$p"; done
+wobjs=(); for o in "${objs[@]}"; do wobjs+=("$(cygpath -w "$o")"); done
+link -nologo -DEBUG -STACK:268435456 -OUT:"$(cygpath -w "$out/spu_replay.exe")" "${wobjs[@]}" \
+    "$(cygpath -w "$lib")" ws2_32.lib bcrypt.lib user32.lib gdi32.lib ole32.lib shell32.lib advapi32.lib \
+    winmm.lib d3d12.lib dxgi.lib dxguid.lib d3dcompiler.lib xinput.lib dbghelp.lib uuid.lib
+echo "[build_replay] $out/spu_replay.exe"
