+static void STDMETHODCALLTYPE dev_footprints(ID3D12Device* t, const D3D12_RESOURCE_DESC* d, UINT first, UINT n, UINT64 base,
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp, UINT* rows, UINT64* row_bytes, UINT64* total)
+{
+    (void)t;
+    const wgs_fmt_info fi = fmt_info(d->Format);
+    const UINT mips = d->MipLevels ? d->MipLevels : 1;
+    u64 off = base;
+    for (UINT i = 0; i < first + n; i++) {
+        const UINT mip = i % mips;
+        const u32 w = (u32)(d->Width >> mip) ? (u32)(d->Width >> mip) : 1u, h = (d->Height >> mip) ? (d->Height >> mip) : 1u;
+        const u32 bw = (w + fi.block_w - 1) / fi.block_w, bh = (h + fi.block_w - 1) / fi.block_w;
+        const u32 rb = bw * fi.block_bytes, pitch = (rb + 255u) & ~255u;
+        off = (off + 511u) & ~511ull;
+        if (i >= first) {
+            const UINT k = i - first;
+            if (fp) { fp[k].Offset = off; fp[k].Footprint.Format = d->Format; fp[k].Footprint.Width = w; fp[k].Footprint.Height = h;
+                      fp[k].Footprint.Depth = d->Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D ? d->DepthOrArraySize : 1; fp[k].Footprint.RowPitch = pitch; }
+            if (rows) rows[k] = bh;
+            if (row_bytes) row_bytes[k] = rb;
+        }
+        off += (u64)pitch * bh;
+    }
+    if (total) *total = off - base;
+}
