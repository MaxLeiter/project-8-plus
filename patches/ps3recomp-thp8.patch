@@ -181,6 +181,15 @@ uint32_t sys_net_errno_loc(void);
  * the scratch the guest must read (errno, hostent, inet_ntoa's string). */
 void ps3_net_host_register(unsigned int (*guest_alloc)(unsigned int size, unsigned int align));
 
+/* Offline-model gap fillers (listen/accept/connect/send/shutdown/inet_addr/
+ * inet_aton) for the libnet exports ppu_sysprx.cpp's offline table lacks.
+ * Called from lv2_init_syscalls(), after ppu_sysprx_register(), so the online
