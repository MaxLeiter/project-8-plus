+/* Texture units a program actually samples (TEX/TXP/TXD/TXB/TXL). Same walk
+ * as rsx_fp_program_size: branch words carry no unit, CONST slots are skipped.
+ * *out_tex_txp_mask: the subset sampled by TEX/TXP, the forms that compare. */
+u32 rsx_fp_texture_unit_masks(const u8* ucode, u32 max_bytes,
+                              u32* out_tex_txp_mask)
+{
+    u32 mask = 0, tex_txp = 0, off = 0;
+    if (out_tex_txp_mask) *out_tex_txp_mask = 0;
+    if (!ucode) return 0;
+    while (off + 16 <= max_bytes) {
+        const u32 w0 = rsx_fp_read_word(ucode + off + 0);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        const u32 op = (w0 & FP_OPCODE_MASK) >> FP_OPCODE_SHIFT;
+        if (!(w2 & FP_BRANCH) &&
+            (op == OP_TEX || op == OP_TXP || op == OP_TXD ||
+             op == OP_TXB || op == OP_TXL)) {
+            const u32 bit =
+                1u << ((w0 & FP_TEX_UNIT_MASK) >> FP_TEX_UNIT_SHIFT);
+            mask |= bit;
+            if (op == OP_TEX || op == OP_TXP) tex_txp |= bit;
+        }
+        off += 16;
+        if (fp_instruction_has_constant(w1, w2, w3)) off += 16;
+        if (w0 & FP_END) break;
+    }
+    if (out_tex_txp_mask) *out_tex_txp_mask = tex_txp;
+    return mask;
+}
+
+u32 rsx_fp_texture_unit_mask(const u8* ucode, u32 max_bytes)
+{
+    return rsx_fp_texture_unit_masks(ucode, max_bytes, NULL);
+}
