+        strncat(docs, "\\Documents", sizeof docs - strlen(docs) - 1);
+#else
+    if (sd_getenv("HOME", docs, sizeof docs))
+        strncat(docs, "/Documents", sizeof docs - strlen(docs) - 1);
+#endif
+    if (!docs[0]) snprintf(docs, sizeof docs, ".");
