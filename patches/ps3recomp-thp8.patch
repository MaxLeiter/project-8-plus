+# ---------------------------------------------------------------------------
+# integer element ops
+# ---------------------------------------------------------------------------
+
+_SZ = {"b": (B, fromB, 8), "h": (H, fromH, 16), "w": (W, fromW, 32)}
+
+
+def elem(name, xo, sz, fn, signed=False, satr=None):
+    """fn(x, y) -> value; satr=(lo, hi) saturates and sets SAT."""
+    get, put, bits = _SZ[sz]
+
+    def sem(s, f):
+        a, b = get(s.vr[f.ra]), get(s.vr[f.rb])
+        if signed:
+            a = [sext(x, bits) for x in a]
+            b = [sext(x, bits) for x in b]
+        out, anys = [], False
+        for x, y in zip(a, b):
+            v = fn(x, y)
+            if satr:
+                v, st = sat(v, *satr)
+                anys |= st
+            out.append(v)
+        s.set_v(f.rt, put(out))
+        if satr:
+            _sat_note(s, anys)
+    vx(name, xo, sem)
+
+
+for _sz, _base in (("b", 0), ("h", 64), ("w", 128)):
+    _bits = _SZ[_sz][2]
+    _umax = (1 << _bits) - 1
+    _smin, _smax = -(1 << (_bits - 1)), (1 << (_bits - 1)) - 1
+    elem(f"vaddu{_sz}m", _base, _sz, lambda x, y: x + y)
+    elem(f"vsubu{_sz}m", 1024 + _base, _sz, lambda x, y: x - y)
+    elem(f"vaddu{_sz}s", 512 + _base, _sz, lambda x, y: x + y, satr=(0, _umax))
+    elem(f"vsubu{_sz}s", 1536 + _base, _sz, lambda x, y: x - y, satr=(0, _umax))
+    elem(f"vadds{_sz}s", 768 + _base, _sz, lambda x, y: x + y, signed=True, satr=(_smin, _smax))
+    elem(f"vsubs{_sz}s", 1792 + _base, _sz, lambda x, y: x - y, signed=True, satr=(_smin, _smax))
+    elem(f"vmaxu{_sz}", 2 + _base, _sz, max)
+    elem(f"vmaxs{_sz}", 258 + _base, _sz, max, signed=True)
+    elem(f"vminu{_sz}", 514 + _base, _sz, min)
+    elem(f"vmins{_sz}", 770 + _base, _sz, min, signed=True)
+    elem(f"vavgu{_sz}", 1026 + _base, _sz, lambda x, y: (x + y + 1) >> 1)
+    elem(f"vavgs{_sz}", 1282 + _base, _sz, lambda x, y: (x + y + 1) >> 1, signed=True)
+    elem(f"vrl{_sz}", 4 + _base, _sz, lambda x, y, b=_bits: ((x << (y % b)) | (x >> (b - y % b))) & ((1 << b) - 1))
+    elem(f"vsl{_sz}", 260 + _base, _sz, lambda x, y, b=_bits: x << (y % b))
+    elem(f"vsr{_sz}", 516 + _base, _sz, lambda x, y, b=_bits: x >> (y % b))
+    elem(f"vsra{_sz}", 772 + _base, _sz,
+         lambda x, y, b=_bits: sext(x, b) >> (y % b))
+
+elem("vaddcuw", 384, "w", lambda x, y: (x + y) >> 32)
+elem("vsubcuw", 1408, "w", lambda x, y: 1 if x >= y else 0)
+
