+static void shape(int cls, const char* mn, uint32_t insn, const int regs[4], int nops, int seed, seedstate* st)
+{
+    uint8_t* RT = st->gpr[regs[0]];
+    uint8_t* RA = st->gpr[regs[1 % nops]];
+    uint8_t* RB = st->gpr[regs[nops > 2 ? 2 : 1 % nops]];
+    uint8_t* RC = st->gpr[regs[nops > 3 ? 3 : 0]];
