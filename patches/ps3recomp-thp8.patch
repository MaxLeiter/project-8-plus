diff --git a/libs/video/webgpu/wgs_proto.h b/libs/video/webgpu/wgs_proto.h
new file mode 100644
index 00000000..a899d9ca
--- /dev/null
+++ b/libs/video/webgpu/wgs_proto.h
@@ -0,0 +1,89 @@
+/*
+ * ps3recomp - WGS: the command stream between the D3D12-over-WebGPU layer (d3d12_webgpu.c, any thread of the
+ * port) and the WebGPU device worker (web/host/gpu/device-worker.js, the one thread that owns the GPUDevice).
+ *
+ * Everything is little-endian 32-bit words. A command is one header word (opcode << 16 | payload words) followed
+ * by its payload. Variable-length data (HLSL text, inline bytes) is a byte count word followed by the bytes,
+ * zero-padded to a word. 64-bit values are two words, low first. Floats are their IEEE bits.
+ *
+ * Two kinds of stream:
+ *   QUEUE stream: the ring in wasm memory (wgs_ring) the device worker drains in order. Object creation,
+ *                 EXECUTE (a reference to a command list's recorded words), UPLOAD (a reference to upload-heap
+ *                 bytes), SIGNAL, PRESENT.
+ *   LIST stream:  what a command list records into its allocator's memory (state, draws, copies).
+ * A REF is (pointer, byte length) into wasm memory in live mode; in record mode (native tests, WGS_RECORD) the
+ * bytes are inlined instead, so a recorded file replays without the producer's memory. The stream header word
+ * says which.
+ *
+ * Resource ids are allocated by the producer (never reused within a session); id 0 = none.
+ * GPU virtual addresses handed to the title are (id << 32) | offset.
+ * This header is the contract with web/host/gpu/wgs.js: change both together. Game-agnostic.
+ */
+#ifndef PS3RECOMP_WGS_PROTO_H
+#define PS3RECOMP_WGS_PROTO_H
+
+#define WGS_MAGIC        0x31534757u   /* "WGS1" */
+#define WGS_FLAG_INLINE  1u            /* stream header flag: REFs carry inline bytes (record mode) */
+
+enum wgs_op {
+    /* ---- queue stream ---- */
+    WGS_BEGIN            = 1,   /* magic, flags */
+    WGS_CREATE_BUFFER    = 2,   /* id, size_lo, size_hi, heap (WGS_HEAP_*), flags (WGS_RES_*) */
+    WGS_CREATE_TEXTURE   = 3,   /* id, dim (1/2/3), w, h, depth_or_layers, mips, dxgi_format, samples, flags */
+    WGS_DESTROY          = 4,   /* id */
+    WGS_CREATE_GFX_PSO   = 5,   /* id, root_sig_id, VS, PS (shader blobs: stage, entry, hlsl), state block */
+    WGS_CREATE_CS_PSO    = 6,   /* id, root_sig_id, CS */
+    WGS_CREATE_ROOT_SIG  = 7,   /* id, serialized root signature (bytes) */
+    WGS_EXECUTE          = 8,   /* REF to list words */
+    WGS_UPLOAD           = 9,   /* buffer id, offset, REF to bytes (upload heap -> GPU copy) */
+    WGS_SIGNAL           = 10,  /* fence id, value_lo, value_hi, completed_addr (where the worker stores the value) */
+    WGS_PRESENT          = 11,  /* texture id, sync_interval, present_fence_addr, present_count */
+    WGS_READBACK         = 12,  /* buffer id, offset, size, dst_addr: after the preceding EXECUTEs, copy the GPU
+                                   buffer range into producer memory (readback heap shadow) before later SIGNALs */
+    WGS_SET_NAME         = 13,  /* id, name bytes (debug labels) */
+
+    /* ---- list stream ---- */
+    WGS_L_PSO            = 40,  /* pso id */
+    WGS_L_TARGETS        = 41,  /* n, n x (tex id, mip, slice, dxgi_format), dsv (tex id, mip, slice, dxgi_format | 0) */
+    WGS_L_CLEAR_RT       = 42,  /* tex id, mip, slice, dxgi_format, r, g, b, a (float bits) */
+    WGS_L_CLEAR_DS       = 43,  /* tex id, mip, slice, dxgi_format, flags (1 depth, 2 stencil), depth (float), stencil */
+    WGS_L_VIEWPORT       = 44,  /* x, y, w, h, min_z, max_z (float bits) */
+    WGS_L_SCISSOR        = 45,  /* left, top, right, bottom */
+    WGS_L_VBUFS          = 46,  /* start slot, n, n x (buffer id, offset, size, stride) */
+    WGS_L_IBUF           = 47,  /* buffer id, offset, size, dxgi_format */
+    WGS_L_TOPOLOGY       = 48,  /* D3D_PRIMITIVE_TOPOLOGY */
+    WGS_L_BIND           = 49,  /* n, n x entry (see WGS_B_*), resolved for the current root signature */
+    WGS_L_DRAW           = 50,  /* vertex_count, instance_count, start_vertex, start_instance */
+    WGS_L_DRAW_INDEXED   = 51,  /* index_count, instance_count, start_index, base_vertex, start_instance */
+    WGS_L_DISPATCH       = 52,  /* x, y, z */
+    WGS_L_COPY_BUF       = 53,  /* dst id, dst_off_lo, dst_off_hi, src id, src_off_lo, src_off_hi, size_lo, size_hi */
+    WGS_L_COPY_BUF_TEX   = 54,  /* buf id, off_lo, off_hi, row_pitch, rows, tex id, mip, slice, x, y, z, w, h, d */
+    WGS_L_COPY_TEX_BUF   = 55,  /* tex id, mip, slice, x, y, z, w, h, d, buf id, off_lo, off_hi, row_pitch, rows */
+    WGS_L_COPY_TEX_TEX   = 56,  /* dst id, mip, slice, x, y, z, src id, mip, slice, x, y, z, w, h, d */
+    WGS_L_STENCIL_REF    = 57,  /* value */
+    WGS_L_BLEND_CONST    = 58,  /* r, g, b, a */
+    WGS_L_TIMESTAMP      = 59,  /* query heap id, index */
+    WGS_L_COMPUTE_BIND   = 60,  /* like WGS_L_BIND, for the compute root signature */
+    WGS_L_COPY_RESOURCE  = 61,  /* dst id, src id (whole resource) */
+};
+
+enum wgs_heap { WGS_HEAP_DEFAULT = 0, WGS_HEAP_UPLOAD = 1, WGS_HEAP_READBACK = 2 };
+enum wgs_res_flags { WGS_RES_RT = 1, WGS_RES_DS = 2, WGS_RES_UAV = 4, WGS_RES_NO_SRV = 8, WGS_RES_CUBE = 16 };
+
+/* WGS_L_BIND entries: kind word, then kind-specific words */
+enum wgs_bind_kind {
+    WGS_B_TEXTURE   = 1,  /* binding, tex id, view dxgi_format, view dim (D3D12_SRV_DIMENSION), mip0, mips, slice0, slices, swizzle (Shader4ComponentMapping) */
+    WGS_B_SAMPLER   = 2,  /* binding, filter, addr_u, addr_v, addr_w, lod_bias, max_aniso, compare, border r g b a, min_lod, max_lod (floats as bits) */
+    WGS_B_UNIFORM   = 3,  /* binding, buf id, offset, size */
+    WGS_B_STORAGE   = 4,  /* binding, buf id, offset, size  (raw / structured buffer SRV, read-only) */
+    WGS_B_STORAGE_RW= 5,  /* binding, buf id, offset, size  (UAV buffer) */
+    WGS_B_STORAGE_TEX=6,  /* binding, tex id, view dxgi_format, mip */
+    WGS_B_NULL      = 7,  /* binding, expected kind: a null descriptor; the worker binds a dummy */
+};
+/* Bindings, matching web/host/gpu/hlsl2wgsl.js: t<N> -> N, s<N> -> 32 + N, b<N> -> 48 + N, u<N> -> 64 + N. */
+#define WGS_BIND_T(n) (n)
+#define WGS_BIND_S(n) (32u + (n))
+#define WGS_BIND_B(n) (48u + (n))
+#define WGS_BIND_U(n) (64u + (n))
+
+#endif
