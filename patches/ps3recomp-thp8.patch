+        float c1[8] = { 0.35f, 0.35f, 0.45f + 0.1f * frame, 0.2f,   0.4f, 0.8f, 1.0f, 0.7f };
+        float pc[4] = { 1, 1, 1, 1 };
+        memcpy(cbm + 0, c0, sizeof c0); memcpy(cbm + 256, c1, sizeof c1); memcpy(cbm + 512, pc, sizeof pc);
+        wgs_hint_written(cb, 0, 768);
+        D3D12_CPU_DESCRIPTOR_HANDLE rtv = { rtv0.ptr + bi * rtv_inc };
