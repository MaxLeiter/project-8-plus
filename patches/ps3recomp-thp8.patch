+    ID3D12Resource* up = buffer(dev, D3D12_HEAP_TYPE_UPLOAD, 256 * 64);
+    unsigned char* upm; CHECK(up->lpVtbl->Map(up, 0, NULL, (void**)&upm));
+    for (int y = 0; y < 64; y++) for (int x = 0; x < 64; x++) {
+        unsigned char* p = upm + y * 256 + x * 4; const int c = ((x >> 3) ^ (y >> 3)) & 1;
+        p[0] = c ? 255 : 30; p[1] = c ? 200 : 30; p[2] = c ? 40 : 90; p[3] = 255;
+    }
