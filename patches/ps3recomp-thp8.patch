+ * stat list (The Simpsons Arcade Game) called its own fresh save corrupt. */
+static void pfd_path(const char* save_path, char* out, size_t n)
+{
+    snprintf(out, n, "%s/PARAM.PFD", save_path);
+#ifdef _WIN32
+    for (char* p = out; *p; p++) if (*p == '/') *p = '\\';
