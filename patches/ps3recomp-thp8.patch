+  let wheelAcc = 0;
+  on(target, "wheel", (e) => {
+    const px = e.deltaMode === 1 ? e.deltaY * 33 : e.deltaMode === 2 ? e.deltaY * 600 : e.deltaY;   // lines / pages -> px
+    wheelAcc += -px / 100;                                   // one notch = 100 px (Chrome's step); up = positive
+    const n = wheelAcc > 0 ? Math.floor(wheelAcc) : Math.ceil(wheelAcc);
+    if (n && dv.getUint32(0, true) >= 2) { Atomics.add(new Int32Array(memory, ptr + 628, 1), 0, n); wheelAcc -= n; }
+    e.preventDefault();
+  }, { passive: false });
+  // fullscreen: ask for the keyboard so Esc (START) and other system keys reach the game (Keyboard Lock API)
+  on(document, "fullscreenchange", () => {
+    if (!navigator.keyboard || !navigator.keyboard.lock) return;
+    if (document.fullscreenElement) navigator.keyboard.lock().catch(() => {}); else navigator.keyboard.unlock();
+  });
+
+  let raf = 0, touchPad = null;
+  const rumbleState = {};
+  const poll = () => {
+    const pads = navigator.getGamepads ? navigator.getGamepads() : [];
+    let slot = 0;
+    for (const g of pads) {
+      if (!g || !g.connected || slot >= 4) continue;
+      writePad(slot++, g);
+    }
+    if (touchPad && slot < 4) writeRaw(slot++, touchPad);
+    for (; slot < 4; slot++) dv.setUint8(532 + slot * 20 + 16, 0);
+    // rumble from the runtime
+    pads && Array.from(pads).filter((g) => g && g.connected).slice(0, 4).forEach((g, s) => {
+      const lo = dv.getUint16(612 + s * 4, true), hi = dv.getUint16(614 + s * 4, true), key = lo << 16 | hi;
+      if (g.vibrationActuator && rumbleState[g.index] !== key) {        // Gamepad objects are per-poll snapshots
+        rumbleState[g.index] = key;
+        if (lo || hi) g.vibrationActuator.playEffect("dual-rumble", { duration: 5000, strongMagnitude: lo / 65535, weakMagnitude: hi / 65535 }).catch(() => {});
+        else g.vibrationActuator.reset && g.vibrationActuator.reset().catch(() => {});
+      }
+    });
+    raf = requestAnimationFrame(poll);
+  };
+  const axis = (v) => Math.max(-32768, Math.min(32767, Math.round(v * 32767)));
+  function writePad(s, g) {
+    let b = 0;
+    if (g.mapping === "standard") { g.buttons.forEach((x, i) => { if (x.pressed && XB[i]) b |= XB[i]; }); }
+    else { g.buttons.slice(0, 4).forEach((x, i) => { if (x.pressed) b |= XB[i]; }); }   // unknown mapping: best effort
+    const lt = g.buttons[6] ? Math.round(g.buttons[6].value * 255) : 0, rt = g.buttons[7] ? Math.round(g.buttons[7].value * 255) : 0;
+    writeRaw(s, { b, lt, rt, lx: axis(g.axes[0] || 0), ly: axis(-(g.axes[1] || 0)), rx: axis(g.axes[2] || 0), ry: axis(-(g.axes[3] || 0)) });
+  }
+  function writeRaw(s, p) {
+    const o = 532 + s * 20;
+    dv.setUint16(o + 4, p.b, true); dv.setUint8(o + 6, p.lt); dv.setUint8(o + 7, p.rt);
+    dv.setInt16(o + 8, p.lx, true); dv.setInt16(o + 10, p.ly, true); dv.setInt16(o + 12, p.rx, true); dv.setInt16(o + 14, p.ry, true);
+    dv.setUint8(o + 16, 1);
+    dv.setUint32(o, (dv.getUint32(o, true) + 1) >>> 0, true);
+  }
+  raf = requestAnimationFrame(poll);
+  return {
+    setTouchPad(state) { touchPad = state; },          // the on-screen touch controls feed a virtual pad
+    detach() { cancelAnimationFrame(raf); offs.forEach((f) => f()); },
+  };
+}
diff --git a/web/host/io-worker.js b/web/host/io-worker.js
new file mode 100644
index 00000000..d7502bc7
--- /dev/null
+++ b/web/host/io-worker.js
@@ -0,0 +1,315 @@
+// io-worker.js -- the "disk controller" of the web port: serves synchronous file reads from game threads out of a
+// local OPFS cache, fetching missing byte ranges from the server (data/files/...) on demand.
+//
+// Protocol (shared memory, see vfs-client.js):
+//   ctl  : Int32Array over a SharedArrayBuffer: [0] doorbell counter, then SLOTS slots of SLOT_I32 int32 each
+//          slot: [0] state (0 free, 1 claimed, 2 request, 3 done)  [1] op  [2] file  [3] off_lo  [4] off_hi
+//                [5] len  [6] dst (byte offset into the data buffer)  [7] result  [8] size_lo  [9] size_hi
+//   names: Uint8Array SharedArrayBuffer, NAME_BYTES per slot (UTF-8 path for OPEN)
+//   data : the destination buffer (the wasm Memory's SharedArrayBuffer in the port; any SAB in tests)
+// Ops: 1 OPEN(path) -> result = file index (or -ENOENT), size;  2 READ(file, off, len, dst) -> result = bytes or -EIO
+//      3 PREFETCH(file, off, len) -> 0 (no wait needed);  4 STATS -> fills slot words 8.. with counters
+// Files are immutable per data build (data/index.json "build"), so cache entries never need revalidation; a new
+// build gets a fresh cache directory and the old one is deleted.
+// Game-agnostic; no title content.
+
+import { SLOTS, SLOT_I32, NAME_BYTES, OP } from "./vfs-proto.js";
+const CHUNK = 256 * 1024;
+const MAX_RUN = 32;                       // chunks per Range request (8 MiB)
+const READAHEAD = 8;                      // chunks prefetched after a sequential miss (2 MiB)
+const ENOENT = 2, EIO = 5;
+
+let ctl, names, data, base = "data/", index = null, files = [], byPath = new Map(), build = "", root = null;
+const stats = { reads: 0, bytes: 0, hits: 0, misses: 0, fetches: 0, fetchedBytes: 0, errors: 0 };
+const state = new Map();                  // file idx -> { map: Uint8Array (1 = cached), mapDirty, handle, lastChunk, pending: Map(chunk -> Promise) }
+
+const log = (...a) => postMessage({ log: a.join(" ") });
+
+onmessage = async (e) => {
+  const m = e.data;
+  if (m.init) {
+    if (m.memory) {                        // the port: slot table and names live in wasm memory (web_vfs.c)
+      ctl = new Int32Array(m.memory, m.ctlPtr, 1 + SLOTS * SLOT_I32); names = new Uint8Array(m.memory, m.namesPtr, SLOTS * NAME_BYTES);
+      data = new Uint8Array(m.memory);
+    } else { ctl = new Int32Array(m.ctl); names = new Uint8Array(m.names); data = new Uint8Array(m.data); }
+    base = m.base || base;               // pass an absolute URL: a relative one resolves against this script
+    try { await loadIndex(); } catch (err) { postMessage({ error: "index: " + err }); return; }
+    if (m.mods) {                          // ?mods=<name>: the mods_<name>/ pack, files named "@mods/<path>" (web_vfs.c)
+      try { await loadModsIndex(m.mods); } catch (err) { postMessage({ error: "mods index: " + err }); }
+    }
+    postMessage({ ready: true, files: files.length, build, opfs: !!root });
+    serve();
+  } else if (m.data) {
+    data = new Uint8Array(m.data);         // memory grew / replaced
+  } else if (m.dump) {                     // stall diagnosis (boot.js watchdog): what this worker is doing right now
+    const now = performance.now(), busy = [];
+    for (let s = 0; ctl && s < SLOTS; s++) {
+      const b = 1 + s * SLOT_I32, v = Atomics.load(ctl, b);
+      if (v) { const f = files[ctl[b + 2]]; busy.push(`slot ${s} state ${v} op ${ctl[b + 1]}${v === 4 && f ? ` file ${f.path} @${ctl[b + 3] >>> 0}+${ctl[b + 5] >>> 0}` : ""}${inService.has(s) ? ` ${((now - inService.get(s)) / 1000).toFixed(1)} s` : ""}`); }
+    }
+    const fl = [...inflight.values()].map((x) => `${x.path} ${x.range} ${((now - x.t0) / 1000).toFixed(1)} s`);
+    log(`[io-dump] doorbell ${ctl ? Atomics.load(ctl, 0) : "-"}; slots busy ${busy.length}: ${busy.join(" | ") || "-"}`);
+    log(`[io-dump] fetches in flight ${fl.length}: ${fl.slice(0, 12).join(" | ") || "-"}; open files ${state.size}; stats ${JSON.stringify(stats)}`);
+  }
+};
+const inService = new Map();               // slot -> time it went into service (cleared at finish), for [io-dump]
+const inflight = new Map();                // fetch id -> { path, range, t0 }, for [io-dump]
+let fetchId = 0;
+
+async function loadIndex() {
+  const r = await fetch(base + "index.json", { cache: "no-cache" });
+  if (!r.ok) throw new Error("HTTP " + r.status);
+  index = await r.json();
+  build = index.build;
+  for (const [p, v] of Object.entries(index.files)) { byPath.set(p.toUpperCase(), files.length); files.push({ path: p, size: v[0] }); }
+  try {
+    const top = await navigator.storage.getDirectory();
+    const cacheDir = await top.getDirectoryHandle("vfs-cache", { create: true });
+    // other game builds go; mods packs ("mods-<build>") have their own cleanup below, so ?mods= on / off keeps both
+    for await (const [name] of cacheDir.entries()) if (name !== build && !name.startsWith("mods-")) await cacheDir.removeEntry(name, { recursive: true });
+    root = await cacheDir.getDirectoryHandle(build, { create: true });
+  } catch (err) { root = null; log("OPFS unavailable, memory-only:", err); }
+}
+
+// ?mods=<name>: a second pack (same layout as data/: index.json + files/) at another base URL, appended after the
+// game files (game file indices and their cache stay as they are). Mods files are NEVER stored in the browser
+// (no OPFS copy; the server sends them no-store): a mods pack is the user's own folder served from this machine,
+// it may be large (HD textures) or private (their own music), and it can change at any time. They are fetched
+// on demand and kept only in a small in-memory LRU (NOCACHE_BUDGET), so a re-read after eviction fetches again.
+const NOCACHE_BUDGET = 96 * 1024 * 1024;
+const nocacheLRU = new Map();             // "fi:chunk" -> byte length, oldest first
+let nocacheBytes = 0;
+async function loadModsIndex(mbase) {
+  const r = await fetch(mbase + "index.json", { cache: "no-store" });
+  if (!r.ok) throw new Error("HTTP " + r.status);
+  const mi = await r.json();
+  let k = 0;
+  for (const [p, v] of Object.entries(mi.files)) {
+    byPath.set(("@mods/" + p).toUpperCase(), files.length);
+    files.push({ path: p, size: v[0], base: mbase, root: null, ci: k++, nocache: true });
+  }
+  log(`mods: ${k} files from ${mbase}, build ${mi.build}, not stored (memory LRU ${NOCACHE_BUDGET >> 20} MiB)`);
+}
+function nocacheTouch(fi, c, len) {
+  const key = fi + ":" + c;
+  if (nocacheLRU.has(key)) { nocacheBytes -= nocacheLRU.get(key); nocacheLRU.delete(key); }
+  nocacheLRU.set(key, len); nocacheBytes += len;
+  if (nocacheBytes <= NOCACHE_BUDGET) return;
+  // oldest first; chunks of a file with a read in progress stay (that read may still copy them out), so one
+  // read larger than the budget overshoots it for a moment instead of evicting its own chunks
+  for (const [old, n] of nocacheLRU) {
+    if (nocacheBytes <= NOCACHE_BUDGET) break;
+    const [f2, c2] = old.split(":").map(Number), st2 = state.get(f2);
+    if (st2 && (st2.busy > 0 || st2.pending.has(c2))) continue;
+    nocacheLRU.delete(old); nocacheBytes -= n;
+    if (st2) { st2.mem.delete(c2); st2.map[c2] = 0; }
+  }
+}
+
+// ---------------------------------------------------------------- request loop
+async function serve() {
+  let seen = Atomics.load(ctl, 0);
+  for (;;) {
+    for (let s = 0; s < SLOTS; s++) {
+      const b = 1 + s * SLOT_I32;
+      if (Atomics.load(ctl, b) === 2) { Atomics.store(ctl, b, 4); inService.set(s, performance.now()); handle(s, b); }   // 4 = in service
+    }
+    // wait for the doorbell to change
+    if (Atomics.waitAsync) {
+      const w = Atomics.waitAsync(ctl, 0, seen, 1000);
+      if (w.async) await w.value;
+    } else {
+      await new Promise((r) => setTimeout(r, 1));
+    }
+    seen = Atomics.load(ctl, 0);
+  }
+}
+
+function finish(b, result) {
+  inService.delete((b - 1) / SLOT_I32);
+  Atomics.store(ctl, b + 7, result);
+  Atomics.store(ctl, b, 3);
+  Atomics.notify(ctl, b);
+}
+
+async function handle(s, b) {
+  const op = ctl[b + 1];
+  try {
+    if (op === OP.OPEN) {
+      const len = ctl[b + 5];
+      const path = new TextDecoder().decode(names.slice(s * NAME_BYTES, s * NAME_BYTES + len)).replace(/^\/+/, "");
+      const i = byPath.get(path.toUpperCase());
+      if (i === undefined) { ctl[b + 8] = 0; ctl[b + 9] = 0; return finish(b, -ENOENT); }
+      const sz = files[i].size;
+      ctl[b + 8] = sz % 0x100000000 | 0; ctl[b + 9] = Math.floor(sz / 0x100000000);
+      return finish(b, i);
+    }
+    if (op === OP.READ || op === OP.PREFETCH) {
+      const fi = ctl[b + 2], off = (ctl[b + 3] >>> 0) + (ctl[b + 4] >>> 0) * 0x100000000, len = ctl[b + 5] >>> 0, dst = ctl[b + 6] >>> 0;
+      const f = files[fi];
+      if (!f) return finish(b, -EIO);
+      const end = Math.min(off + len, f.size);
+      if (end <= off) return finish(b, 0);
+      if (op === OP.PREFETCH) { finish(b, 0); await ensure(fi, off, end); return; }
+      const bytes = await readInto(fi, off, end, dst);
+      stats.reads++; stats.bytes += bytes;
+      return finish(b, bytes);
+    }
+    if (op === OP.STATS) {
+      const v = [stats.reads, stats.hits, stats.misses, stats.fetches, Math.round(stats.fetchedBytes / 1024), stats.errors];
+      v.forEach((x, k) => (ctl[b + 8 + k] = x | 0));
+      return finish(b, 0);
+    }
+    finish(b, -EIO);
+  } catch (err) {
+    stats.errors++; log("io error", err && err.stack || err);
+    finish(b, -EIO);
+  }
+}
+
+// ---------------------------------------------------------------- cache
+const MAX_OPEN = 48, openOrder = [];
+function closeFile(fi) {
+  const st = state.get(fi);
+  if (!st) return;
+  if (st.busy > 0) { openOrder.push(fi); return; }   // in use: try again at the next eviction
+  try { st.handle && st.handle.flush(); st.handle && st.handle.close(); st.mapHandle && st.mapHandle.close(); } catch {}
+  state.delete(fi);
+}
+async function fileState(fi) {
+  let st = state.get(fi);
+  if (st) { if (st.ready) await st.ready; return st; }
+  const n = Math.ceil(files[fi].size / CHUNK);
+  st = { map: new Uint8Array(n), handle: null, mapHandle: null, pending: new Map(), lastChunk: -2, mem: new Map() };
+  state.set(fi, st);
+  const f0 = files[fi], froot = f0.base ? f0.root : root, fname = f0.base ? `f${f0.ci}` : `f${fi}`;   // ?mods= files: their pack's cache
+  if (froot) {
+    // Sync access handles: positioned (sparse) writes without swap files, synchronous reads. This worker is the
+    // only user of the cache, so holding one exclusive handle per open file is fine (closed LRU beyond MAX_OPEN).
+    st.ready = (async () => {
+      try {
+        st.handle = await (await froot.getFileHandle(fname, { create: true })).createSyncAccessHandle();
+        st.mapHandle = await (await froot.getFileHandle(fname + ".map", { create: true })).createSyncAccessHandle();
+        if (st.mapHandle.getSize() === n) st.mapHandle.read(st.map, { at: 0 });
+        // trust the map only as far as the data file really reaches
+        const have = st.handle.getSize(), size = files[fi].size;
+        for (let k = 0; k < n; k++) if (st.map[k] && Math.min((k + 1) * CHUNK, size) > have) st.map[k] = 0;
+        openOrder.push(fi);
+        while (openOrder.length > MAX_OPEN) closeFile(openOrder.shift());
+      } catch (err) { log("opfs open", err); st.handle = null; st.mapHandle = null; }
+    })();
+    await st.ready;
+  }
+  return st;
+}
+
+async function ensure(fi, off, end) {
+  // make every chunk of [off, end) present; returns when done. Missing runs are fetched with one Range each.
+  const st = await fileState(fi);
+  const c0 = Math.floor(off / CHUNK), c1 = Math.floor((end - 1) / CHUNK);
+  const waits = [];
+  let c = c0;
+  while (c <= c1) {
+    if (st.map[c]) { c++; continue; }
+    if (st.pending.has(c)) { waits.push(st.pending.get(c)); c++; continue; }
+    let e = c;
+    while (e + 1 <= c1 && !st.map[e + 1] && !st.pending.has(e + 1) && e - c + 1 < MAX_RUN) e++;
+    waits.push(fetchRun(fi, st, c, e));
+    c = e + 1;
+  }
+  await Promise.all(waits);
+}
+
+function fetchRun(fi, st, c, e) {
+  const p = (async () => {
+    const f = files[fi];
+    const a = c * CHUNK, z = Math.min((e + 1) * CHUNK, f.size) - 1;
+    stats.fetches++; stats.misses += e - c + 1;
+    const id = ++fetchId; inflight.set(id, { path: f.path, range: `${c}-${e}`, t0: performance.now() });
+    try {
+    const r = await fetch((f.base || base) + "files/" + encodeURI(f.path),
+                          f.nocache ? { headers: { Range: `bytes=${a}-${z}` }, cache: "no-store" } : { headers: { Range: `bytes=${a}-${z}` } });
+    if (r.status !== 206 && !(r.status === 200 && a === 0 && z === f.size - 1)) throw new Error(`HTTP ${r.status} for ${f.path} ${a}-${z}`);
+    const buf = new Uint8Array(await r.arrayBuffer());
+    if (buf.length !== z - a + 1) throw new Error(`short range ${buf.length} != ${z - a + 1}`);
+    stats.fetchedBytes += buf.length;
+    for (let k = c; k <= e; k++) st.mem.set(k, buf.subarray((k - c) * CHUNK, Math.min((k - c + 1) * CHUNK, buf.length)));
+    if (st.handle) {
+      // data first and durable, then the map: a crash or a closed tab can lose a chunk, never claim one
+      st.handle.write(buf, { at: a });
+      st.handle.flush();
+      for (let k = c; k <= e; k++) st.map[k] = 1;
+      st.mapHandle.write(st.map.subarray(c, e + 1), { at: c });
+      st.mapHandle.flush();
+    } else {
+      for (let k = c; k <= e; k++) st.map[k] = 1;
+      if (f.nocache) for (let k = c; k <= e; k++) nocacheTouch(fi, k, st.mem.get(k).length);
+    }
+    trimMem(st);
+    } finally { inflight.delete(id); }
+  })();
+  for (let k = c; k <= e; k++) st.pending.set(k, p);
+  p.finally(() => { for (let k = c; k <= e; k++) st.pending.delete(k); }).catch(() => {});
+  return p;
+}
+
+let sabReads = true;   // SyncAccessHandle.read into a SharedArrayBuffer view (newer engines); else via a bounce buffer
+function readAt(st, view, at) {
+  if (sabReads) {
+    try { const n = st.handle.read(view, { at }); if (n === view.length) return; throw new Error("short read " + n); }
+    catch (err) { if (!(err instanceof TypeError)) throw err; sabReads = false; }
+  }
+  const tmp = new Uint8Array(view.length);
+  const n = st.handle.read(tmp, { at });
+  if (n !== view.length) throw new Error("short read " + n);
+  view.set(tmp);
+}
+
+function trimMem(st) {
+  // keep at most 64 recently fetched chunks per file in memory (16 MiB) -- the OPFS copy is authoritative.
+  // Without OPFS memory is the only copy: keep everything (a private window plays from RAM).
+  if (!st.handle) return;
+  while (st.mem.size > 64) st.mem.delete(st.mem.keys().next().value);
+}
+
+async function readInto(fi, off, end, dst) {
+  const st = await fileState(fi);
+  st.busy = (st.busy || 0) + 1;
+  try { return await readIntoLocked(fi, st, off, end, dst); } finally { st.busy--; }
+}
+async function readIntoLocked(fi, st, off, end, dst) {
+  const c0 = Math.floor(off / CHUNK), c1 = Math.floor((end - 1) / CHUNK);
+  let allCached = true;
+  for (let c = c0; c <= c1; c++) if (!st.map[c] && !st.mem.has(c)) { allCached = false; break; }
+  if (allCached) stats.hits++;
+  await ensure(fi, off, end);
+  // readahead on sequential access
+  if (c0 === st.lastChunk + 1 || c0 === st.lastChunk) {
+    const ra0 = c1 + 1, ra1 = Math.min(c1 + READAHEAD, Math.ceil(files[fi].size / CHUNK) - 1);
+    if (ra0 <= ra1) ensure(fi, ra0 * CHUNK, Math.min((ra1 + 1) * CHUNK, files[fi].size)).catch(() => {});
+  }
+  st.lastChunk = c1;
+  // copy out: memory chunks first, else one slice of the OPFS file
+  let pos = off, out = dst;
+  while (pos < end) {
+    const c = Math.floor(pos / CHUNK), inChunk = pos - c * CHUNK, n = Math.min(CHUNK - inChunk, end - pos);
+    const m = st.mem.get(c);
+    if (m) { data.set(m.subarray(inChunk, inChunk + n), out); if (files[fi].nocache) nocacheTouch(fi, c, m.length); }
+    else if (!st.handle) { await ensure(fi, pos, pos + n); continue; }   // memory-only chunk evicted meanwhile: fetch again
+    else {
+      // the rest of the request that is not in memory: one synchronous read straight into the destination
+      let e2 = pos + n;
+      while (e2 < end && !st.mem.has(Math.floor(e2 / CHUNK))) e2 = Math.min(end, (Math.floor(e2 / CHUNK) + 1) * CHUNK);
+      try { readAt(st, data.subarray(out, out + (e2 - pos)), pos); }
+      catch (err) {                                    // cache damaged: forget these chunks, fetch them again
+        log("cache read failed, refetching:", err.message);
+        for (let k = Math.floor(pos / CHUNK); k <= Math.floor((e2 - 1) / CHUNK); k++) st.map[k] = 0;
+        await ensure(fi, pos, e2);
+        continue;                                      // retry this position (now in memory)
+      }
+      out += e2 - pos; pos = e2; continue;
+    }
+    pos += n; out += n;
+  }
+  return end - off;
+}
diff --git a/web/host/lib_ps3web.js b/web/host/lib_ps3web.js
new file mode 100644
index 00000000..070a0dba
--- /dev/null
+++ b/web/host/lib_ps3web.js
@@ -0,0 +1,118 @@
+// lib_ps3web.js -- Emscripten JS library for the ps3recomp web build (--js-library).
+// The /game filesystem (libs/filesystem/web_vfs.c): WasmFS's JS-implemented backend calls the _wasmfs_jsimpl_*
+// functions below in whichever thread does the I/O. Every Web Worker has its own copy of this code, so nothing
+// per-file is kept here: records live in wasm memory (web_vfs.c) and the IO worker is reached through the slot
+// table there (protocol: vfs-proto.js / io-worker.js). This build has exactly one JSImpl backend, so these
+// replace Emscripten's dispatch-by-backend versions.
+
+addToLibrary({
+  $ps3vfs: {
+    enc: null,
+    ctl() { return new Int32Array(HEAP32.buffer, _ps3_web_vfs_ctl() >>> 0, 1 + 64 * 16); },   // pointers above 2 GB: unsigned
+    names() { return new Uint8Array(HEAPU8.buffer, _ps3_web_vfs_names() >>> 0, 64 * 1024); },
+    call(op, set) {
+      const c = ps3vfs.ctl();
+      let s, b;
+      for (;;) {
+        for (s = 0; s < 64; s++) { b = 1 + s * 16; if (Atomics.compareExchange(c, b, 0, 1) === 0) break; }
+        if (s < 64) break;
+        Atomics.wait(c, 0, Atomics.load(c, 0), 1);
+      }
+      c[b + 1] = op; set(c, b, s);
+      Atomics.store(c, b, 2); Atomics.add(c, 0, 1); Atomics.notify(c, 0);
+      while (Atomics.load(c, b) !== 3) Atomics.wait(c, b, Atomics.load(c, b), 1000);
+      const r = c[b + 7], sz = (c[b + 8] >>> 0) + (c[b + 9] >>> 0) * 4294967296;
+      Atomics.store(c, b, 0);
+      return [r, sz];
+    },
+    rec(file) {                            // vfs_rec: +0 file, +4 path, +8 len, +12 fd, +16 size (f64)
+      const p = _ps3_web_vfs_rec(file) >>> 0;
+      if (!p) return null;
+      return { p, path: UTF8ToString(HEAPU32[(p + 4) >>> 2], HEAPU32[(p + 8) >>> 2]), size: HEAPF64[(p + 16) >>> 3] };
+    },
+    fd(r) {
+      const fdp = (r.p + 12) >>> 2;
+      let fd = Atomics.load(HEAP32, fdp);
+      if (fd >= 0) return fd;
+      const bytes = new TextEncoder().encode(r.path);
+      const [res] = ps3vfs.call(1, (c, b, s) => { ps3vfs.names().set(bytes, s * 1024); c[b + 5] = bytes.length; });
+      if (res >= 0) Atomics.store(HEAP32, fdp, res);
+      return res;
+    },
+  },
+
+  _wasmfs_jsimpl_alloc_file: (backend, file) => { _ps3_web_vfs_bind(file); },
+  _wasmfs_jsimpl_free_file: (backend, file) => {},
+  _wasmfs_jsimpl_write__i53abi: true,
+  _wasmfs_jsimpl_write: (backend, file, buffer, length, offset) => -{{{ cDefs.EROFS }}},
+  _wasmfs_jsimpl_read__i53abi: true,
+  _wasmfs_jsimpl_read__deps: ['$ps3vfs'],
+  _wasmfs_jsimpl_read: (backend, file, buffer, length, offset) => {
+    const r = ps3vfs.rec(file);
+    if (!r) return -{{{ cDefs.EIO }}};
+    if (offset >= r.size || length <= 0) return 0;
+    const fd = ps3vfs.fd(r);
+    if (fd < 0) return -{{{ cDefs.EIO }}};
+    const [n] = ps3vfs.call(2, (c, b) => {
+      c[b + 2] = fd; c[b + 3] = offset % 4294967296 | 0; c[b + 4] = Math.floor(offset / 4294967296);
+      c[b + 5] = length; c[b + 6] = buffer | 0;   // the IO worker reads it unsigned
+    });
+    return n;
+  },
+  _wasmfs_jsimpl_get_size__deps: ['$ps3vfs'],
+  _wasmfs_jsimpl_get_size: (backend, file) => {
+    const r = ps3vfs.rec(file);
+    return r ? r.size : 0;
+  },
+  _wasmfs_jsimpl_set_size__i53abi: true,
+  _wasmfs_jsimpl_set_size: (backend, file, size) => 0,      // creation truncates to 0: ignore (read-only data)
+
+  ps3web_vfs_register: (backend) => {},
+  // "size\tpath\n" for every file of data/index.json (synchronous: this runs on the game's main pthread)
+  ps3web_vfs_list__deps: ['$stringToNewUTF8'],
+  ps3web_vfs_list: () => {
+    try {
+      const x = new XMLHttpRequest();
+      x.open("GET", (globalThis.PS3WEB_DATA || "data/") + "index.json", false);
+      x.send();
+      if (x.status !== 200) { err(`[webvfs] data/index.json: HTTP ${x.status}`); return 0; }
+      const idx = JSON.parse(x.responseText);
+      let s = "";
+      for (const [p, v] of Object.entries(idx.files)) s += `${v[0]}\t${p}\n`;
+      return stringToNewUTF8(s);
+    } catch (e) { err("[webvfs] index: " + e); return 0; }
+  },
+  // the same for another pack (?mods=<name>: web_vfs.c passes the absolute URL of mods_<name>/)
+  ps3web_vfs_list_url__deps: ['$stringToNewUTF8', '$UTF8ToString'],
+  ps3web_vfs_list_url: (basePtr) => {
+    const base = UTF8ToString(basePtr);
+    try {
+      const x = new XMLHttpRequest();
+      x.open("GET", base + "index.json", false);
+      x.send();
+      if (x.status !== 200) { err(`[webvfs] ${base}index.json: HTTP ${x.status}`); return 0; }
+      const idx = JSON.parse(x.responseText);
+      let s = "";
+      for (const [p, v] of Object.entries(idx.files)) s += `${v[0]}\t${p}\n`;
+      return stringToNewUTF8(s);
+    } catch (e) { err("[webvfs] mods index: " + e); return 0; }
+  },
+  // the same with the file's modification time: "size\tmtime_s\tpath\n" (index.json [size, mtime_ns]; 0 if absent).
+  // web_vfs.c gives the /mods files these times, so the mods overlay's fingerprint (size + mtime) is the same on
+  // every boot of an unchanged pack -- otherwise every boot looks like a changed mod set and resets the title's HDD
+  // data cache (a cold first-boot wait on every launch). ps3web_vfs_list_url above is kept for older objects.
+  ps3web_vfs_list_url_t__deps: ['$stringToNewUTF8', '$UTF8ToString'],
+  ps3web_vfs_list_url_t: (basePtr) => {
+    const base = UTF8ToString(basePtr);
+    try {
+      const x = new XMLHttpRequest();
+      x.open("GET", base + "index.json", false);
+      x.send();
+      if (x.status !== 200) { err(`[webvfs] ${base}index.json: HTTP ${x.status}`); return 0; }
+      const idx = JSON.parse(x.responseText);
+      let s = "";
+      for (const [p, v] of Object.entries(idx.files)) s += `${v[0]}\t${Math.floor((+v[1] || 0) / 1e9)}\t${p}\n`;
+      return stringToNewUTF8(s);
+    } catch (e) { err("[webvfs] mods index: " + e); return 0; }
+  },
+});
diff --git a/web/host/saves.js b/web/host/saves.js
new file mode 100644
index 00000000..7418413c
--- /dev/null
+++ b/web/host/saves.js
@@ -0,0 +1,141 @@
+// saves.js -- import / export of the game's save data (the native savedata folder format) for the browser build.
+//
+// The game's /dev_hdd0 is this site's OPFS (WasmFS backend, libs/filesystem/web_vfs.c), so a save lives at
+//   OPFS:/home/00000001/savedata/<SAVE DIR>/   (PARAM.SFO, ICON0.PNG, PARAM.PFD, the game's own files ...)
+// exactly the folder a native install (or a PS3) has. Export = a .zip of such folders (stored, no compression, so the
+// files come out byte-identical); import = a .zip or the folder itself, picked by the player. Nothing here touches any
+// path on the PC: the page only sees files the player picks, and exports go through a normal browser download.
+// Only while the game is NOT running (the game holds the save files open through its own OPFS handles).
+
+const SAVE_PATH = ["home", "00000001", "savedata"];
+
+async function saveRoot(create) {
+  let d = await navigator.storage.getDirectory();
+  for (const p of SAVE_PATH) d = await d.getDirectoryHandle(p, { create });
+  return d;
+}
+
+async function readTree(dir, prefix, out) {
+  for await (const [name, h] of dir.entries()) {
+    if (h.kind === "directory") await readTree(h, prefix + name + "/", out);
+    else out.push({ path: prefix + name, data: new Uint8Array(await (await h.getFile()).arrayBuffer()) });
+  }
+  return out;
+}
+
+// [{ name, files: [{ path, data }] }] of every save folder (one with a PARAM.SFO)
+export async function listSaves() {
+  let root;
+  try { root = await saveRoot(false); } catch { return []; }
+  const saves = [];
+  for await (const [name, h] of root.entries()) {
+    if (h.kind !== "directory") continue;
+    const files = await readTree(h, "", []);
+    if (files.some((f) => f.path.toUpperCase() === "PARAM.SFO")) saves.push({ name, files: files.sort((a, b) => (a.path < b.path ? -1 : 1)) });
+  }
+  return saves.sort((a, b) => (a.name < b.name ? -1 : 1));
+}
+
+// ---------------------------------------------------------------- zip (store only out; store / deflate in)
+const CRC = new Uint32Array(256).map((_, n) => { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; return c >>> 0; });
+function crc32(u8) { let c = 0xffffffff; for (let i = 0; i < u8.length; i++) c = CRC[(c ^ u8[i]) & 255] ^ (c >>> 8); return (c ^ 0xffffffff) >>> 0; }
+
+export function zip(entries) {   // entries: [{ path, data }] -> Uint8Array
+  const enc = new TextEncoder(), parts = [], central = [];
+  let off = 0;
+  for (const e of entries) {
+    const name = enc.encode(e.path), crc = crc32(e.data), n = e.data.length;
+    const h = new DataView(new ArrayBuffer(30));
+    h.setUint32(0, 0x04034b50, true); h.setUint16(4, 20, true); h.setUint16(6, 0x0800, true); h.setUint16(8, 0, true);
+    h.setUint32(14, crc, true); h.setUint32(18, n, true); h.setUint32(22, n, true); h.setUint16(26, name.length, true);
+    parts.push(new Uint8Array(h.buffer), name, e.data);
+    const c = new DataView(new ArrayBuffer(46));
+    c.setUint32(0, 0x02014b50, true); c.setUint16(4, 20, true); c.setUint16(6, 20, true); c.setUint16(8, 0x0800, true);
+    c.setUint32(16, crc, true); c.setUint32(20, n, true); c.setUint32(24, n, true); c.setUint16(28, name.length, true); c.setUint32(42, off, true);
+    central.push(new Uint8Array(c.buffer), name);
+    off += 30 + name.length + n;
+  }
+  const cd = central.reduce((s, p) => s + p.length, 0);
+  const end = new DataView(new ArrayBuffer(22));
+  end.setUint32(0, 0x06054b50, true); end.setUint16(8, entries.length, true); end.setUint16(10, entries.length, true);
+  end.setUint32(12, cd, true); end.setUint32(16, off, true);
+  const all = [...parts, ...central, new Uint8Array(end.buffer)], out = new Uint8Array(all.reduce((s, p) => s + p.length, 0));
+  let o = 0; for (const p of all) { out.set(p, o); o += p.length; }
+  return out;
+}
+
+export async function unzip(u8) {   // -> [{ path, data }] (files only)
+  const dv = new DataView(u8.buffer, u8.byteOffset, u8.byteLength);
+  let e = u8.length - 22;
+  while (e >= 0 && dv.getUint32(e, true) !== 0x06054b50) e--;
+  if (e < 0) throw new Error("not a zip file");
+  const count = dv.getUint16(e + 10, true); let p = dv.getUint32(e + 16, true);
+  const dec = new TextDecoder(), out = [];
+  for (let i = 0; i < count; i++) {
+    if (dv.getUint32(p, true) !== 0x02014b50) throw new Error("bad zip directory");
+    const method = dv.getUint16(p + 10, true), crc = dv.getUint32(p + 16, true), csize = dv.getUint32(p + 20, true);
+    const nlen = dv.getUint16(p + 28, true), xlen = dv.getUint16(p + 30, true), clen = dv.getUint16(p + 32, true), lho = dv.getUint32(p + 42, true);
+    const path = dec.decode(u8.subarray(p + 46, p + 46 + nlen)).replace(/\\/g, "/");
+    p += 46 + nlen + xlen + clen;
+    if (path.endsWith("/")) continue;
+    const start = lho + 30 + dv.getUint16(lho + 26, true) + dv.getUint16(lho + 28, true), raw = u8.subarray(start, start + csize);
+    let data;
+    if (method === 0) data = raw.slice();
+    else if (method === 8) data = new Uint8Array(await new Response(new Blob([raw]).stream().pipeThrough(new DecompressionStream("deflate-raw"))).arrayBuffer());
+    else throw new Error(`${path}: unsupported zip method ${method}`);
+    if (crc32(data) !== crc) throw new Error(`${path}: checksum mismatch`);
+    out.push({ path, data });
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------- import
+// files: [{ path: "<SAVE DIR>/<file>" (or deeper), data }] -> [{ name, files: [{ path (inside the folder), data }] }],
+// one per folder that holds a PARAM.SFO; anything else is ignored. Nothing is written here (see writeSave).
+export function planImport(files) {
+  // a save folder = the parent of a PARAM.SFO; its files are everything under that parent
+  const roots = new Set();
+  for (const f of files) {
+    const parts = f.path.split("/").filter(Boolean);
+    if (parts.length >= 2 && parts[parts.length - 1].toUpperCase() === "PARAM.SFO") roots.add(parts.slice(0, -1).join("/"));
+  }
+  const saves = [];
+  for (const r of roots) {
+    const name = r.split("/").pop(), pre = r + "/";
+    saves.push({ name, files: files.filter((f) => f.path.startsWith(pre)).map((f) => ({ path: f.path.slice(pre.length), data: f.data })) });
+  }
+  return saves;
+}
+
+export async function existingNames() { return new Set((await listSaves()).map((s) => s.name)); }
+
+// writes one save folder (replacing an existing one of that name completely)
+export async function writeSave(save) {
+  if (!/^[A-Za-z0-9_-]{1,32}$/.test(save.name)) throw new Error(`"${save.name}" is not a save folder name`);
+  const root = await saveRoot(true);
+  try { await root.removeEntry(save.name, { recursive: true }); } catch {}
+  const dir = await root.getDirectoryHandle(save.name, { create: true });
+  for (const f of save.files) {
+    const parts = f.path.split("/"); let d = dir;
+    for (const p of parts.slice(0, -1)) d = await d.getDirectoryHandle(p, { create: true });
+    const w = await (await d.getFileHandle(parts[parts.length - 1], { create: true })).createWritable();
+    await w.write(f.data); await w.close();
+  }
+}
+
+// FileList from <input type=file> (a .zip, or a folder with webkitdirectory) or a drop -> [{ path, data }]
+export async function readPicked(fileList) {
+  const out = [];
+  for (const f of fileList) {
+    const data = new Uint8Array(await f.arrayBuffer());
+    if (/\.zip$/i.test(f.name)) out.push(...await unzip(data));
+    else out.push({ path: (f.webkitRelativePath || f.name).replace(/\\/g, "/"), data });
+  }
+  return out;
+}
+
+export function download(name, u8) {
+  const url = URL.createObjectURL(new Blob([u8], { type: "application/zip" }));
+  const a = document.createElement("a"); a.href = url; a.download = name; document.body.appendChild(a); a.click();
+  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 1000);
+}
