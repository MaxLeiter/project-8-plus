+        for (; i + 1024 < end; i += 512) { memcpy(&w, p + i, 8); h = (h ^ w) * 0x100000001B3ull; }
+        for (i = end - 1024; i < end; i += 8) { memcpy(&w, p + i, 8); h = (h ^ w) * 0x100000001B3ull; }
+    }
+    for (i = end; i < n; i++) h = (h ^ p[i]) * 0x100000001B3ull;
+    return h;
