diff --git a/tools/ppucheck/ref_int.py b/tools/ppucheck/ref_int.py
new file mode 100644
index 00000000..627e56ef
--- /dev/null
+++ b/tools/ppucheck/ref_int.py
@@ -0,0 +1,1061 @@
+"""ref_int.py - reference semantics for the fixed-point, branch, CR, SPR and
+integer load/store instructions (PowerISA v2.02 Book I chapters 2-3, as
+implemented by the Cell BE PPU in 64-bit mode).
+
+Every function here is written from the ISA pseudocode; see ppcref.py for the
+conventions. Undefined result bits are declared with s.dontcare(); places
+where the lifter deliberately keeps a narrower model than the architecture
+(and the reason that is safe) are declared with s.dontcare() as well and
+listed in KNOWN_DEVIATIONS so the report can say so.
+"""
+from __future__ import annotations
+
+from ppcref import (MASK32, MASK64, MEMBASE, MEMSIZE, OUT_FALL, OUT_TAKEN,
+                    OUT_RETURN, OUT_ICALL, OUT_SYSCALL, XER_CA, Undefined,
+                    s32, s64, sext, exts32, rotl32, rotl64, mask64, dup32,
+                    spec, add_spec)
+
+KNOWN_DEVIATIONS = {
+    "ctr-32bit": "the lifter keeps CTR 32-bit (mtctr/mtspr CTR zero-extend the "
+                 "low word; bdnz/bdz decrement in 32 bits). Equivalent for every "
+                 "CTR value a 32-bit-pointer PS3 title loads.",
+    "blrl-ctr": "a TAKEN bclrl dispatches through ps3_indirect_call, which reads the "
+                "target from CTR, so CTR holds the target on return. CTR is volatile "
+                "across calls in the PPC64 ELF ABI (the callee may leave anything "
+                "there), so no caller can observe the difference.",
+}
+
+INT = ("int",)
+
+
+# ---------------------------------------------------------------------------
+# D-form arithmetic / logical
+# ---------------------------------------------------------------------------
+
+def _ra0(s, f):
+    return 0 if f.ra == 0 else s.gpr[f.ra]
+
+
+@spec("addi", "D", 14, tags=INT)
+def _addi(s, f):
+    s.gpr[f.rt] = (_ra0(s, f) + f.d) & MASK64
+
+
+@spec("addis", "D", 15, tags=INT)
+def _addis(s, f):
+    s.gpr[f.rt] = (_ra0(s, f) + (f.d << 16)) & MASK64
+
+
+def _addic(rc):
+    def sem(s, f):
+        a = s.gpr[f.ra]
+        r = a + (f.d & MASK64)
+        s.gpr[f.rt] = r & MASK64
+        s.set_ca(r >> 64)
+        if rc:
+            s.cr0_from(s.gpr[f.rt])
+    return sem
+
+
+add_spec("addic", "D", 12, None, _addic(0), tags=INT)
+add_spec("addic.", "D", 13, None, _addic(1), tags=INT)
+
+
+@spec("subfic", "D", 8, tags=INT)
+def _subfic(s, f):
+    r = ((~s.gpr[f.ra]) & MASK64) + (f.d & MASK64) + 1
+    s.gpr[f.rt] = r & MASK64
+    s.set_ca(r >> 64)
+
+
+@spec("mulli", "D", 7, tags=INT)
+def _mulli(s, f):
+    s.gpr[f.rt] = (s64(s.gpr[f.ra]) * f.d) & MASK64
+
+
+def _logi(fn, rc=0):
+    def sem(s, f):
+        # D-form logical: RS is the rt slot, RA the destination
+        s.gpr[f.ra] = fn(s.gpr[f.rt], f.ui) & MASK64
+        if rc:
+            s.cr0_from(s.gpr[f.ra])
+    return sem
+
+
+add_spec("ori", "D", 24, None, _logi(lambda a, u: a | u), tags=INT)
+add_spec("oris", "D", 25, None, _logi(lambda a, u: a | (u << 16)), tags=INT)
+add_spec("xori", "D", 26, None, _logi(lambda a, u: a ^ u), tags=INT)
+add_spec("xoris", "D", 27, None, _logi(lambda a, u: a ^ (u << 16)), tags=INT)
+add_spec("andi.", "D", 28, None, _logi(lambda a, u: a & u, 1), tags=INT)
+add_spec("andis.", "D", 29, None, _logi(lambda a, u: a & (u << 16), 1), tags=INT)
+
+
+# ---------------------------------------------------------------------------
+# compares
+# ---------------------------------------------------------------------------
+
+def _cmp_nib(a, b, xer):
+    nib = 8 if a < b else 4 if a > b else 2
+    return nib | ((xer >> 31) & 1)
+
+
+def _cmp_fields(w):
+    return (w >> 23) & 7, (w >> 21) & 1     # BF, L
+
+
+def _valid_cmp(f):
+    return ((f.w >> 22) & 1) == 0           # bit 9 (IBM) reserved
+
+
+def _cmpi(s, f):
+    bf, l = _cmp_fields(f.w)
+    a = s64(s.gpr[f.ra]) if l else s32(s.gpr[f.ra])
+    s.set_crf(bf, _cmp_nib(a, f.d, s.xer))
+
+
+def _cmpli(s, f):
+    bf, l = _cmp_fields(f.w)
+    a = s.gpr[f.ra] if l else s.gpr[f.ra] & MASK32
+    s.set_crf(bf, _cmp_nib(a, f.ui, s.xer))
+
+
+def _cmp(s, f):
+    bf, l = _cmp_fields(f.w)
+    if l:
+        a, b = s64(s.gpr[f.ra]), s64(s.gpr[f.rb])
+    else:
+        a, b = s32(s.gpr[f.ra]), s32(s.gpr[f.rb])
+    s.set_crf(bf, _cmp_nib(a, b, s.xer))
+
+
+def _cmpl(s, f):
+    bf, l = _cmp_fields(f.w)
+    m = MASK64 if l else MASK32
+    s.set_crf(bf, _cmp_nib(s.gpr[f.ra] & m, s.gpr[f.rb] & m, s.xer))
+
+
+def _gen_cmp(op, xo):
+    def gen(rng):
+        w = op << 26 | rng.randrange(8) << 23 | rng.getrandbits(1) << 21
+        w |= rng.randrange(32) << 16
+        if xo is None:
+            w |= rng.choice((0, 1, 0xFFFF, 0x8000, 0x7FFF, rng.getrandbits(16)))
+        else:
+            w |= rng.randrange(32) << 11 | xo << 1
+        return w
+    return gen
+
+
+def _cmp_setup(s, f, rng, ea):
+    """Make EQUAL operands common -- and the case that separates a 32-bit
+    from a 64-bit compare: equal low words, different high words."""
+    r = rng.random()
+    if r >= 0.45:
+        return
+    junk = rng.getrandbits(32) << 32
+    if f.op in (10, 11):                       # cmpi / cmpli: vs the immediate
+        imm = f.d if f.op == 11 else f.ui
+        lo = imm & MASK32
+        s.gpr[f.ra] = (imm & MASK64) if r < 0.2 else (lo | junk)
+    elif f.ra != f.rb:                         # cmp / cmpl: vs RB
+        s.gpr[f.rb] = s.gpr[f.ra] if r < 0.2 else ((s.gpr[f.ra] & MASK32) | junk)
+
+
+add_spec("cmpi", "D", 11, None, _cmpi, valid=_valid_cmp, gen=_gen_cmp(11, None), setup=_cmp_setup,
+         tags=INT + ("cmp",))
+add_spec("cmpli", "D", 10, None, _cmpli, valid=_valid_cmp, gen=_gen_cmp(10, None), setup=_cmp_setup,
+         tags=INT + ("cmp",))
+add_spec("cmp", "X", 31, 0, _cmp, valid=_valid_cmp, gen=_gen_cmp(31, 0), setup=_cmp_setup,
+         tags=INT + ("cmp",))
+add_spec("cmpl", "X", 31, 32, _cmpl, valid=_valid_cmp, gen=_gen_cmp(31, 32), setup=_cmp_setup,
+         tags=INT + ("cmp",))
+
+
+# ---------------------------------------------------------------------------
+# XO-form arithmetic (+ Rc / OE variants)
+# ---------------------------------------------------------------------------
+
+def _ov_add(a, b, r):
+    """signed 64-bit overflow of a+b(+c) = r"""
+    sa, sb, sr = a >> 63, b >> 63, (r >> 63) & 1
+    return sa == sb and sr != sa
+
+
+def _xo(name, xo, body, has_oe=True, rb_used=True):
+    """body(s, f) -> (result u64, carry or None, ov or None)."""
+    for oe in ((0, 1) if has_oe else (0,)):
+        for rc in (0, 1):
+            nm = name + ("o" if oe else "") + ("." if rc else "")
+
+            def sem(s, f, oe=oe, rc=rc):
+                r, ca, ov = body(s, f)
+                if r is None:          # undefined result (divide by 0 etc.)
+                    s.gpr[f.rt] = 0
+                    s.dontcare(("gpr", f.rt), MASK64)
+                    if rc:             # LT/GT/EQ undefined; SO (set below) is defined
+                        s.dontcare("cr", 0xE << 28)
+                else:
+                    s.gpr[f.rt] = r
+                if ca is not None:
+                    s.set_ca(ca)
+                if oe:
+                    s.set_ov(bool(ov))
+                if rc and r is None:
+                    s.set_crf(0, (s.crf(0) & 0xE) | ((s.xer >> 31) & 1))
+                if rc and r is not None:
+                    s.cr0_from(r)
+                    if name in ("mulhw", "mulhwu", "divw", "divwu"):
+                        # 64-bit mode: RT[0:31] undefined, so CR0 LT/GT/EQ are too
+                        s.dontcare("cr", 0xE << 28)
+            fixed = {"oe": oe, "rc": rc}
+            if not rb_used:
+                fixed["rb"] = 0
+            add_spec(nm, "XO", 31, xo, sem, fixed=fixed, tags=INT + ("xo",))
+
+
+def b_add(s, f):
+    a, b = s.gpr[f.ra], s.gpr[f.rb]
+    r = (a + b) & MASK64
+    return r, None, _ov_add(a, b, r)
+
+
+def b_addc(s, f):
+    a, b = s.gpr[f.ra], s.gpr[f.rb]
+    t = a + b
+    r = t & MASK64
+    return r, t >> 64, _ov_add(a, b, r)
+
+
+def b_adde(s, f):
+    a, b = s.gpr[f.ra], s.gpr[f.rb]
+    t = a + b + s.ca()
+    r = t & MASK64
+    return r, t >> 64, _ov_add(a, b, r)
+
+
+def b_addme(s, f):
+    a = s.gpr[f.ra]
+    t = a + MASK64 + s.ca()
+    r = t & MASK64
+    return r, t >> 64, _ov_add(a, MASK64, r)
+
+
+def b_addze(s, f):
+    a = s.gpr[f.ra]
+    t = a + s.ca()
+    r = t & MASK64
+    return r, t >> 64, _ov_add(a, 0, r)
+
+
+def _ov_sub(b, a):        # signed overflow of b - a
+    r = s64(b) - s64(a)
+    return r > (1 << 63) - 1 or r < -(1 << 63)
+
+
+def b_subf2(s, f):
+    a, b = s.gpr[f.ra], s.gpr[f.rb]
+    return (b - a) & MASK64, None, _ov_sub(b, a)
+
+
+def b_subfc(s, f):
+    a, b = s.gpr[f.ra], s.gpr[f.rb]
+    t = ((~a) & MASK64) + b + 1
+    return t & MASK64, t >> 64, _ov_sub(b, a)
+
+
+def b_subfe(s, f):
+    a, b = s.gpr[f.ra], s.gpr[f.rb]
+    na = (~a) & MASK64
+    t = na + b + s.ca()
+    r = t & MASK64
+    return r, t >> 64, _ov_add(na, b, r)
+
+
+def b_subfme(s, f):
+    na = (~s.gpr[f.ra]) & MASK64
+    t = na + MASK64 + s.ca()
+    r = t & MASK64
+    return r, t >> 64, _ov_add(na, MASK64, r)
+
+
+def b_subfze(s, f):
+    na = (~s.gpr[f.ra]) & MASK64
+    t = na + s.ca()
+    r = t & MASK64
+    return r, t >> 64, _ov_add(na, 0, r)
+
+
+def b_neg(s, f):
+    a = s.gpr[f.ra]
+    return (-a) & MASK64, None, a == 1 << 63
+
+
+def b_mullw(s, f):
+    p = s32(s.gpr[f.ra]) * s32(s.gpr[f.rb])
+    return p & MASK64, None, not (-(1 << 31) <= p < (1 << 31))
+
+
+def b_mulld(s, f):
+    p = s64(s.gpr[f.ra]) * s64(s.gpr[f.rb])
+    return p & MASK64, None, not (-(1 << 63) <= p < (1 << 63))
+
+
+def _mulh(signed, word):
+    def body(s, f):
+        a, b = s.gpr[f.ra], s.gpr[f.rb]
+        if word:
+            a, b = (s32(a), s32(b)) if signed else (a & MASK32, b & MASK32)
+            r = ((a * b) >> 32) & MASK32
+            # RT[0:31] undefined for mulhw/mulhwu
+            s.dontcare(("gpr", f.rt), MASK64 ^ MASK32)
+            return r, None, None
+        a, b = (s64(a), s64(b)) if signed else (a, b)
+        return ((a * b) >> 64) & MASK64, None, None
+    return body
+
+
+def _tdiv(n, d):          # truncating division
+    q = abs(n) // abs(d)
+    return q if (n < 0) == (d < 0) else -q
+
+
+def b_divw(s, f):
+    n, d = s32(s.gpr[f.ra]), s32(s.gpr[f.rb])
+    s.dontcare(("gpr", f.rt), MASK64 ^ MASK32)       # RT[0:31] undefined
+    if d == 0 or (n == -(1 << 31) and d == -1):
+        return None, None, True
+    return _tdiv(n, d) & MASK32, None, False
+
+
+def b_divwu(s, f):
+    n, d = s.gpr[f.ra] & MASK32, s.gpr[f.rb] & MASK32
+    s.dontcare(("gpr", f.rt), MASK64 ^ MASK32)
+    if d == 0:
+        return None, None, True
+    return n // d, None, False
+
+
+def b_divd(s, f):
+    n, d = s64(s.gpr[f.ra]), s64(s.gpr[f.rb])
+    if d == 0 or (n == -(1 << 63) and d == -1):
+        return None, None, True
+    return _tdiv(n, d) & MASK64, None, False
+
+
+def b_divdu(s, f):
+    n, d = s.gpr[f.ra], s.gpr[f.rb]
+    if d == 0:
+        return None, None, True
+    return n // d, None, False
+
+
+_xo("add", 266, b_add)
+_xo("addc", 10, b_addc)
+_xo("adde", 138, b_adde)
+_xo("addme", 234, b_addme, rb_used=False)
+_xo("addze", 202, b_addze, rb_used=False)
+_xo("subf", 40, b_subf2)
+_xo("subfc", 8, b_subfc)
+_xo("subfe", 136, b_subfe)
+_xo("subfme", 232, b_subfme, rb_used=False)
+_xo("subfze", 200, b_subfze, rb_used=False)
+_xo("neg", 104, b_neg, rb_used=False)
+_xo("mullw", 235, b_mullw)
+_xo("mulld", 233, b_mulld)
+_xo("mulhw", 75, _mulh(True, True), has_oe=False)
+_xo("mulhwu", 11, _mulh(False, True), has_oe=False)
+_xo("mulhd", 73, _mulh(True, False), has_oe=False)
+_xo("mulhdu", 9, _mulh(False, False), has_oe=False)
+_xo("divw", 491, b_divw)
+_xo("divwu", 459, b_divwu)
+_xo("divd", 489, b_divd)
+_xo("divdu", 457, b_divdu)
+
+
+# ---------------------------------------------------------------------------
+# X-form logical / extend / count / shift (RS in rt slot, RA destination)
+# ---------------------------------------------------------------------------
+
+def _xl(name, xo, fn, rb_used=True, ca=False):
+    for rc in (0, 1):
+        def sem(s, f, rc=rc):
+            r = fn(s, f)
+            s.gpr[f.ra] = r & MASK64
+            if rc:
+                s.cr0_from(s.gpr[f.ra])
+        fixed = {"rc": rc}
+        if not rb_used:
+            fixed["rb"] = 0
+        add_spec(name + ("." if rc else ""), "X", 31, xo, sem, fixed=fixed, tags=INT)
+
+
+_xl("and", 28, lambda s, f: s.gpr[f.rt] & s.gpr[f.rb])
+_xl("andc", 60, lambda s, f: s.gpr[f.rt] & ~s.gpr[f.rb])
+_xl("or", 444, lambda s, f: s.gpr[f.rt] | s.gpr[f.rb])
+_xl("orc", 412, lambda s, f: s.gpr[f.rt] | (~s.gpr[f.rb] & MASK64))
+_xl("xor", 316, lambda s, f: s.gpr[f.rt] ^ s.gpr[f.rb])
+_xl("nand", 476, lambda s, f: ~(s.gpr[f.rt] & s.gpr[f.rb]))
+_xl("nor", 124, lambda s, f: ~(s.gpr[f.rt] | s.gpr[f.rb]))
+_xl("eqv", 284, lambda s, f: ~(s.gpr[f.rt] ^ s.gpr[f.rb]))
+_xl("extsb", 954, lambda s, f: sext(s.gpr[f.rt], 8), rb_used=False)
+_xl("extsh", 922, lambda s, f: sext(s.gpr[f.rt], 16), rb_used=False)
+_xl("extsw", 986, lambda s, f: sext(s.gpr[f.rt], 32), rb_used=False)
+
+
+def _cntlzw(s, f):
+    v = s.gpr[f.rt] & MASK32
+    return 32 - v.bit_length()
+
+
+def _cntlzd(s, f):
+    return 64 - s.gpr[f.rt].bit_length()
+
+
+_xl("cntlzw", 26, _cntlzw, rb_used=False)
+_xl("cntlzd", 58, _cntlzd, rb_used=False)
+
+
+def _slw(s, f):
+    n = s.gpr[f.rb] & 0x3F
+    # r = ROTL32(RS, n); m = n<32 ? MASK(32, 63-n) : 0
+    if n & 0x20:
+        return 0
+    return ((s.gpr[f.rt] & MASK32) << n) & MASK32
+
+
+def _srw(s, f):
+    n = s.gpr[f.rb] & 0x3F
+    if n & 0x20:
+        return 0
+    return (s.gpr[f.rt] & MASK32) >> n
+
+
+def _sld(s, f):
+    n = s.gpr[f.rb] & 0x7F
+    return 0 if n & 0x40 else (s.gpr[f.rt] << n) & MASK64
+
+
+def _srd(s, f):
+    n = s.gpr[f.rb] & 0x7F
+    return 0 if n & 0x40 else s.gpr[f.rt] >> n
+
+
+_xl("slw", 24, _slw)
+_xl("srw", 536, _srw)
+_xl("sld", 27, _sld)
+_xl("srd", 539, _srd)
+
+
+def _sraw_core(s, rs, n):
+    """sraw/srawi: n in 0..63. Result is the 32-bit arithmetic shift,
+    sign-extended; CA = RS<0 && any 1 bits shifted out of the low word."""
+    v = s32(rs)
+    if n >= 32:
+        r = -1 if v < 0 else 0
+        ca = v < 0
+    else:
+        r = v >> n
+        ca = v < 0 and ((rs & MASK32) & ((1 << n) - 1)) != 0
+    s.set_ca(ca)
+    return r & MASK64
+
+
+def _srad_core(s, rs, n):
+    v = s64(rs)
+    if n >= 64:
+        r = -1 if v < 0 else 0
+        ca = v < 0
+    else:
+        r = v >> n
+        ca = v < 0 and (rs & ((1 << n) - 1)) != 0
+    s.set_ca(ca)
+    return r & MASK64
+
+
+_xl("sraw", 792, lambda s, f: _sraw_core(s, s.gpr[f.rt], s.gpr[f.rb] & 0x3F))
+_xl("srawi", 824, lambda s, f: _sraw_core(s, s.gpr[f.rt], f.rb))
+_xl("srad", 794, lambda s, f: _srad_core(s, s.gpr[f.rt], s.gpr[f.rb] & 0x7F))
+
+for _rc in (0, 1):
+    def _sradi(s, f, rc=_rc):
+        s.gpr[f.ra] = _srad_core(s, s.gpr[f.rt], f.sh6)
+        if rc:
+            s.cr0_from(s.gpr[f.ra])
+    add_spec("sradi" + ("." if _rc else ""), "XS", 31, 413, _sradi, fixed={"rc": _rc}, tags=INT)
+
+
+# ---------------------------------------------------------------------------
+# rotates
+# ---------------------------------------------------------------------------
+
+def _m_rot(name, op, kind):
+    for rc in (0, 1):
+        def sem(s, f, rc=rc):
+            sh = f.rb if kind != "rlwnm" else s.gpr[f.rb] & 31
+            r = rotl64(dup32(s.gpr[f.rt]), sh)     # ROTL32: rotate the doubled word
+            m = mask64(f.mb5 + 32, f.me5 + 32)
+            if kind == "rlwimi":
+                v = (r & m) | (s.gpr[f.ra] & ~m & MASK64)
+            else:
+                v = r & m
+            s.gpr[f.ra] = v
+            if rc:
+                s.cr0_from(v)
+        add_spec(name + ("." if rc else ""), "M", op, None, sem, fixed={"rc": rc}, tags=INT + ("rot",))
+
+
+_m_rot("rlwinm", 21, "rlwinm")
+_m_rot("rlwimi", 20, "rlwimi")
+_m_rot("rlwnm", 23, "rlwnm")
+
+
+def _md_rot(name, xo, kind):
+    for rc in (0, 1):
+        def sem(s, f, rc=rc):
+            rs = s.gpr[f.rt]
+            if kind in ("rldcl", "rldcr"):
+                n = s.gpr[f.rb] & 63
+            else:
+                n = f.sh6
+            r = rotl64(rs, n)
+            b = f.mb6
+            if kind in ("rldicl", "rldcl"):
+                m = mask64(b, 63)
+            elif kind in ("rldicr", "rldcr"):
+                m = mask64(0, b)              # the field is ME here
+            elif kind == "rldic":
+                m = mask64(b, 63 - n)
+            else:  # rldimi
+                m = mask64(b, 63 - n)
+            if kind == "rldimi":
+                v = (r & m) | (s.gpr[f.ra] & ~m & MASK64)
+            else:
+                v = r & m
+            s.gpr[f.ra] = v
+            if rc:
+                s.cr0_from(v)
+        form = "MDS" if kind in ("rldcl", "rldcr") else "MD"
+        add_spec(name + ("." if rc else ""), form, 30, xo, sem, fixed={"rc": rc}, tags=INT + ("rot",))
+
+
+_md_rot("rldicl", 0, "rldicl")
+_md_rot("rldicr", 1, "rldicr")
+_md_rot("rldic", 2, "rldic")
+_md_rot("rldimi", 3, "rldimi")
+_md_rot("rldcl", 8, "rldcl")
+_md_rot("rldcr", 9, "rldcr")
+
+
+# ---------------------------------------------------------------------------
+# CR logical, mcrf, mfcr/mtcrf, SPRs
+# ---------------------------------------------------------------------------
+
+def _crlog(name, xo, fn):
+    def sem(s, f):
+        a, b = s.crbit(f.ra), s.crbit(f.rb)
+        s.set_crbit(f.rt, fn(a, b) & 1)
+    add_spec(name, "XL", 19, xo, sem, fixed={"lk": 0}, tags=("cr",))
+
+
+_crlog("crand", 257, lambda a, b: a & b)
+_crlog("crandc", 129, lambda a, b: a & ~b)
+_crlog("creqv", 289, lambda a, b: ~(a ^ b))
+_crlog("crnand", 225, lambda a, b: ~(a & b))
+_crlog("crnor", 33, lambda a, b: ~(a | b))
+_crlog("cror", 449, lambda a, b: a | b)
+_crlog("crorc", 417, lambda a, b: a | ~b)
+_crlog("crxor", 193, lambda a, b: a ^ b)
+
+
+def _gen_mcrf(rng):
+    return 19 << 26 | rng.randrange(8) << 23 | rng.randrange(8) << 18
+
+
+@spec("mcrf", "XL", 19, 0, gen=_gen_mcrf, tags=("cr",))
+def _mcrf(s, f):
+    bf, bfa = (f.w >> 23) & 7, (f.w >> 18) & 7
+    s.set_crf(bf, s.crf(bfa))
+
+
+def _gen_mfcr(rng):
+    return 31 << 26 | rng.randrange(32) << 21 | 19 << 1
+
+
+@spec("mfcr", "XFX", 31, 19, gen=_gen_mfcr, valid=lambda f: not (f.w >> 20) & 1, tags=("cr",))
+def _mfcr(s, f):
+    s.gpr[f.rt] = s.cr          # zero-extended (RT[0:31] = 0)
+
+
+def _gen_mtcrf(rng):
+    crm = rng.choice((0xFF, 0x80, 0x01, 0x38, rng.getrandbits(8)))
+    return 31 << 26 | rng.randrange(32) << 21 | crm << 12 | 144 << 1
+
+
+@spec("mtcrf", "XFX", 31, 144, gen=_gen_mtcrf, valid=lambda f: not (f.w >> 20) & 1, tags=("cr",))
+def _mtcrf(s, f):
+    m = 0
+    for i in range(8):
+        if f.crm & (0x80 >> i):
+            m |= 0xF << (28 - 4 * i)
+    s.cr = (s.gpr[f.rt] & m) | (s.cr & ~m & MASK32)
+
+
+def _gen_spr(xo, sprs):
+    def gen(rng):
+        n = rng.choice(sprs)
+        raw = ((n & 31) << 5) | (n >> 5)
+        return 31 << 26 | rng.randrange(32) << 21 | raw << 11 | xo << 1
+    return gen
+
+
+@spec("mfspr", "XFX", 31, 339, gen=_gen_spr(339, (1, 8, 9)), tags=("spr",))
+def _mfspr(s, f):
+    n = f.spr
+    if n == 1:
+        s.gpr[f.rt] = s.xer          # XER is 64-bit; bits 0:31 read as 0 here
+    elif n == 8:
+        s.gpr[f.rt] = s.lr
+    elif n == 9:
+        s.gpr[f.rt] = s.ctr
+    else:
+        raise Undefined
+
+
+@spec("mtspr", "XFX", 31, 467, gen=_gen_spr(467, (1, 8, 9)), tags=("spr",))
+def _mtspr(s, f):
+    n = f.spr
+    v = s.gpr[f.rt]
+    if n == 1:
+        # architected XER bits only: SO OV CA and the byte count (bits 57:63)
+        s.xer = v & 0xE000007F
+        s.dontcare("xer", 0x1FFFFF80)      # reserved bits: implementation-defined
+    elif n == 8:
+        s.lr = v
+    elif n == 9:
+        s.ctr = v
+        s.dontcare("ctr", MASK64 ^ MASK32)  # KNOWN_DEVIATIONS['ctr-32bit']
+        s.notes.append("ctr-32bit")
+    else:
+        raise Undefined
+
+
+# ---------------------------------------------------------------------------
+# branches (bc / bclr / bcctr); the harness places the target inside the
+# test function so an in-range taken bc is a `goto` (OUT_TAKEN).
+# ---------------------------------------------------------------------------
+
+_BOS = (0b00100, 0b01100, 0b10100, 0b10000, 0b10010, 0b00000, 0b00010,
+        0b01000, 0b01010, 0b00101, 0b01101, 0b10001, 0b11001,
+        # "at" branch-prediction hints (the form most of the title's beq/bne/
+        # blt.. carry) and the 'a' hint of bdnz/bdz
+        0b00110, 0b00111, 0b01110, 0b01111, 0b11000, 0b11010)
+
+
+def _bo_eval(s, bo, bi, decr_ok=True):
+    if not (bo & 0b00100):
+        if not decr_ok:
+            raise Undefined
+        s.ctr = (s.ctr - 1) & MASK64
+        ctr_ok = (s.ctr != 0) != bool(bo & 0b00010)
+        # KNOWN_DEVIATIONS['ctr-32bit']: CTR is kept 32-bit (only the high
+        # word of a wrapped 0 - 1 differs; the branch decision does not)
+        s.dontcare("ctr", MASK64 ^ MASK32)
+    else:
+        ctr_ok = True
+    cond_ok = bool(bo & 0b10000) or (s.crbit(bi) == ((bo >> 3) & 1))
+    return ctr_ok and cond_ok
+
+
+def _gen_bc(rng):
+    bo = rng.choice(_BOS)
+    if bo != 0b10100 and rng.random() < 0.2:
+        bo |= 1                       # static prediction hint bit
+    bd = rng.randrange(-0x40, 0x40) * 4
+    return 16 << 26 | bo << 21 | rng.randrange(32) << 16 | (bd & 0xFFFC)
+
+
+def _ctr_note(s):
+    s.notes.append("ctr-32bit")
+
+
+@spec("bc", "B", 16, gen=_gen_bc, fixed={"aa": 0, "lk": 0}, tags=("branch",))
+def _bc(s, f):
+    bo, bi = f.rt, f.ra
+    if _bo_eval(s, bo, bi):
+        s.outcome = OUT_TAKEN
+
+
+def _gen_bclr(xo, lk, decr):
+    def gen(rng):
+        bos = [b for b in _BOS if decr or (b & 0b00100)]
+        bo = rng.choice(bos)
+        return 19 << 26 | bo << 21 | rng.randrange(32) << 16 | xo << 1 | lk
+    return gen
+
+
+@spec("bclr", "XL", 19, 16, gen=_gen_bclr(16, 0, True), fixed={"lk": 0}, tags=("branch",))
+def _bclr(s, f):
+    if _bo_eval(s, f.rt, f.ra):
+        s.outcome = OUT_RETURN
+
+
+@spec("bclrl", "XL", 19, 16, gen=_gen_bclr(16, 1, True), fixed={"lk": 1}, tags=("branch",))
+def _bclrl(s, f):
+    target = s.lr & ~3 & MASK64
+    taken = _bo_eval(s, f.rt, f.ra)
+    s.lr = (f.addr + 4) & MASK64
+    if taken:
+        s.outcome = OUT_ICALL | OUT_FALL
+        s.icall = target
+        s.icall_lr = s.lr
+        s.dontcare("icall", (MASK64 ^ MASK32) | 3)
+        s.dontcare("ctr", MASK64)               # KNOWN_DEVIATIONS['blrl-ctr']
+        s.notes.append("blrl-ctr")
+
+
+@spec("bcctr", "XL", 19, 528, gen=_gen_bclr(528, 0, False), fixed={"lk": 0}, tags=("branch",))
+def _bcctr(s, f):
+    if _bo_eval(s, f.rt, f.ra, decr_ok=False):
+        s.outcome = OUT_ICALL | OUT_RETURN
+        s.icall = s.ctr & ~3 & MASK64
+        s.icall_lr = s.lr
+        # the target is CTR[0:61]||0b00; the dispatcher looks up (u32)CTR and
+        # a code pointer never has the low bits set
+        s.dontcare("icall", (MASK64 ^ MASK32) | 3)
+
+
+@spec("bcctrl", "XL", 19, 528, gen=_gen_bclr(528, 1, False), fixed={"lk": 1}, tags=("branch",))
+def _bcctrl(s, f):
+    taken = _bo_eval(s, f.rt, f.ra, decr_ok=False)
+    s.lr = (f.addr + 4) & MASK64
+    if taken:
+        s.outcome = OUT_ICALL | OUT_FALL
+        s.icall = s.ctr & ~3 & MASK64
+        s.icall_lr = s.lr
+        # the target is CTR[0:61]||0b00; the dispatcher looks up (u32)CTR and
+        # a code pointer never has the low bits set
+        s.dontcare("icall", (MASK64 ^ MASK32) | 3)
+
+
+@spec("sc", "SC", 17, gen=lambda rng: 0x44000002, tags=("sys",))
+def _sc(s, f):
+    s.outcome = OUT_SYSCALL
+
+
+# unconditional I-form branches (relative; the test function spans +-0x10000)
+def _gen_i(lk):
+    def gen(rng):
+        li = rng.randrange(-0x3000, 0x3000) * 4
+        return 18 << 26 | (li & 0x3FFFFFC) | lk
+    return gen
+
+
+@spec("b", "I", 18, gen=_gen_i(0), fixed={"aa": 0, "lk": 0}, tags=("branch",))
+def _b(s, f):
+    from ppcref import FUNC_SPAN
+    tgt = (f.addr + f.li) & MASK32
+    if f.addr - FUNC_SPAN < tgt < f.addr + FUNC_SPAN:
+        s.outcome = OUT_TAKEN               # in-function: a goto
+    else:                                   # another function: a tail jump
+        s.outcome = OUT_ICALL | OUT_RETURN
+        s.icall = tgt
+        s.icall_lr = s.lr
+
+
+@spec("bl", "I", 18, gen=_gen_i(1), fixed={"aa": 0, "lk": 1}, tags=("branch",))
+def _bl(s, f):
+    # a call: LR <- CIA+4, then the callee (the driver's stub records target + LR)
+    s.lr = (f.addr + 4) & MASK64
+    s.outcome = OUT_ICALL | OUT_FALL
+    s.icall = (f.addr + f.li) & MASK32
+    s.icall_lr = s.lr
+
+
+# mftb / mftbu (TBR 268 / 269); driver_main.cpp's ppu_timebase_now() is fixed
+_TB = 0x0123456789ABCDEF
+
+
+def _gen_mftb(rng):
+    tbr = rng.choice((268, 269))
+    return 31 << 26 | rng.randrange(32) << 21 | (tbr & 31) << 16 | (tbr >> 5) << 11 | 371 << 1
+
+
+@spec("mftb", "XFX", 31, 371, gen=_gen_mftb, tags=("spr",))
+def _mftb(s, f):
+    if f.spr == 268:
+        s.gpr[f.rt] = _TB
+    elif f.spr == 269:
+        s.gpr[f.rt] = _TB >> 32
+    else:
+        raise Undefined
+
+
+# storage-control / barrier instructions: no architectural register or
+# memory effect for a single thread (ordering is tested elsewhere)
+def _nop(s, f):
+    pass
+
+
+def _gen_x(op, xo, rt=None):
+    def gen(rng):
+        t = rng.randrange(32) if rt is None else rt
+        return op << 26 | t << 21 | rng.randrange(32) << 16 | rng.randrange(32) << 11 | xo << 1
+    return gen
+
+
+add_spec("sync", "X", 31, 598, _nop, gen=lambda rng: 0x7C0004AC, tags=("sys",))
+add_spec("lwsync", "X", 31, 598, _nop, gen=lambda rng: 0x7C2004AC, tags=("sys",))
+add_spec("eieio", "X", 31, 854, _nop, gen=lambda rng: 0x7C0006AC, tags=("sys",))
+add_spec("isync", "XL", 19, 150, _nop, gen=lambda rng: 0x4C00012C, tags=("sys",))
+for _nm, _xo in (("dcbf", 86), ("dcbst", 54), ("dcbt", 278), ("dcbtst", 246)):
+    add_spec(_nm, "X", 31, _xo, _nop, gen=_gen_x(31, _xo, 0), tags=("sys",))
+
+
+# ---------------------------------------------------------------------------
+# integer loads / stores
+# ---------------------------------------------------------------------------
+
+def _ea_d(s, f, upd):
+    base = s.gpr[f.ra] if (f.ra or upd) else 0
+    return (base + f.d) & MASK64
+
+
+def _ea_ds(s, f, upd):
+    base = s.gpr[f.ra] if (f.ra or upd) else 0
+    return (base + f.ds) & MASK64
+
+
+def _ea_x(s, f, upd):
+    base = s.gpr[f.ra] if (f.ra or upd) else 0
+    return (base + s.gpr[f.rb]) & MASK64
+
+
+_EA = {"D": _ea_d, "DS": _ea_ds, "X": _ea_x}
+
+
+def _valid_load_upd(f):
+    return f.ra != 0 and f.ra != f.rt
+
+
+def _valid_store_upd(f):
+    return f.ra != 0
+
+
+def _load(name, form, op, xo, size, signed=False, upd=False, rev=False):
+    eaf = _EA[form]
+
+    def sem(s, f):
+        ea = eaf(s, f, upd)
+        v = s.ld_u(ea, size)
+        if rev:
+            v = int.from_bytes(v.to_bytes(size, "big"), "little")
+        if signed:
+            v = sext(v, size * 8) & MASK64
+        s.gpr[f.rt] = v
+        if upd:
+            s.gpr[f.ra] = ea
+    add_spec(name, form, op, xo, sem, ea=(form, size),
+             valid=_valid_load_upd if upd else None, tags=("ldst", "load"))
+
+
+def _store(name, form, op, xo, size, upd=False, rev=False):
+    eaf = _EA[form]
+
+    def sem(s, f):
+        ea = eaf(s, f, upd)
+        v = s.gpr[f.rt] & ((1 << (8 * size)) - 1)
+        if rev:
+            v = int.from_bytes(v.to_bytes(size, "big"), "little")
+        s.st_u(ea, size, v)
+        if upd:
+            s.gpr[f.ra] = ea
+    add_spec(name, form, op, xo, sem, ea=(form, size),
+             valid=_valid_store_upd if upd else None, tags=("ldst", "store"))
+
+
+for _n, _op, _sz, _sg in (("lbz", 34, 1, 0), ("lhz", 40, 2, 0), ("lha", 42, 2, 1), ("lwz", 32, 4, 0)):
+    _load(_n, "D", _op, None, _sz, _sg)
+    _load(_n + "u", "D", _op + 1, None, _sz, _sg, upd=True)
+_load("ld", "DS", 58, 0, 8)
+_load("ldu", "DS", 58, 1, 8, upd=True)
+_load("lwa", "DS", 58, 2, 4, signed=True)
+for _n, _xo_, _sz, _sg in (("lbzx", 87, 1, 0), ("lhzx", 279, 2, 0), ("lhax", 343, 2, 1),
+                           ("lwzx", 23, 4, 0), ("lwax", 341, 4, 1), ("ldx", 21, 8, 0)):
+    _load(_n, "X", 31, _xo_, _sz, _sg)
+for _n, _xo_, _sz, _sg in (("lbzux", 119, 1, 0), ("lhzux", 311, 2, 0), ("lhaux", 375, 2, 1),
+                           ("lwzux", 55, 4, 0), ("lwaux", 373, 4, 1), ("ldux", 53, 8, 0)):
+    _load(_n, "X", 31, _xo_, _sz, _sg, upd=True)
+_load("lhbrx", "X", 31, 790, 2, rev=True)
+_load("lwbrx", "X", 31, 534, 4, rev=True)
+
+for _n, _op, _sz in (("stb", 38, 1), ("sth", 44, 2), ("stw", 36, 4)):
+    _store(_n, "D", _op, None, _sz)
+    _store(_n + "u", "D", _op + 1, None, _sz, upd=True)
+_store("std", "DS", 62, 0, 8)
+_store("stdu", "DS", 62, 1, 8, upd=True)
+for _n, _xo_, _sz in (("stbx", 215, 1), ("sthx", 407, 2), ("stwx", 151, 4), ("stdx", 149, 8)):
+    _store(_n, "X", 31, _xo_, _sz)
+for _n, _xo_, _sz in (("stbux", 247, 1), ("sthux", 439, 2), ("stwux", 183, 4), ("stdux", 181, 8)):
+    _store(_n, "X", 31, _xo_, _sz, upd=True)
+_store("sthbrx", "X", 31, 918, 2, rev=True)
+_store("stwbrx", "X", 31, 662, 4, rev=True)
+
+
+def _gen_lmw(op):
+    def gen(rng):
+        rt = rng.choice((14, 20, 24, 28, 30, 31, rng.randrange(32)))
+        return op << 26 | rt << 21 | rng.randrange(32) << 16 | (rng.randrange(-16, 16) * 4 & 0xFFFF)
+    return gen
+
+
+def _lmw(s, f):
+    ea = _ea_d(s, f, False)
+    for i, r in enumerate(range(f.rt, 32)):
+        s.gpr[r] = s.ld_u(ea + 4 * i, 4)
+
+
+def _stmw(s, f):
+    ea = _ea_d(s, f, False)
+    for i, r in enumerate(range(f.rt, 32)):
+        s.st_u(ea + 4 * i, 4, s.gpr[r])
+
+
+add_spec("lmw", "D", 46, None, _lmw, ea=("D", 4), gen=_gen_lmw(46),
+         valid=lambda f: not (f.ra != 0 and f.ra >= f.rt), tags=("ldst", "load"))
+add_spec("stmw", "D", 47, None, _stmw, ea=("D", 4), gen=_gen_lmw(47), tags=("ldst", "store"))
+
+
+# string ops: lswi/stswi (NB in rb field, 0 => 32), lswx/stswx (XER byte count)
+def _lsw(s, f, ea, n):
+    r = f.rt - 1
+    i = 32
+    for k in range(n):
+        if i == 32:
+            r = (r + 1) % 32
+            s.gpr[r] = 0
+            i = 0
+        byte = s.ld_u(ea + k, 1)
+        # bytes fill RT[32:63] left to right (the high word is cleared)
+        s.gpr[r] |= byte << (24 - i)
+        i += 8
+
+
+def _stsw(s, f, ea, n):
+    r = f.rt - 1
+    i = 32
+    for k in range(n):
+        if i == 32:
+            r = (r + 1) % 32
+            i = 0
+        s.st_u(ea + k, 1, (s.gpr[r] >> (24 - i)) & 0xFF)
+        i += 8
+
+
+def _nregs(n):
+    return (n + 3) // 4
+
+
+def _valid_lswi(f):
+    n = f.rb or 32
+    regs = [(f.rt + i) % 32 for i in range(_nregs(n))]
+    return f.ra not in regs or f.ra == 0
+
+
+@spec("lswi", "X", 31, 597, ea=("Xd", 1), valid=_valid_lswi, tags=("ldst", "load", "string"))
+def _lswi(s, f):
+    ea = s.gpr[f.ra] if f.ra else 0
+    _lsw(s, f, ea, f.rb or 32)
+
+
+@spec("stswi", "X", 31, 725, ea=("Xd", 1), tags=("ldst", "store", "string"))
+def _stswi(s, f):
+    ea = s.gpr[f.ra] if f.ra else 0
+    _stsw(s, f, ea, f.rb or 32)
+
+
+def _valid_lswx(f):
+    return f.rt not in (f.ra, f.rb)
+
+
+@spec("lswx", "X", 31, 533, ea=("X", 1), valid=_valid_lswx, tags=("ldst", "load", "string"))
+def _lswx(s, f):
+    n = s.xer & 0x7F
+    regs = {(f.rt + i) % 32 for i in range(_nregs(n))}
+    if (f.ra and f.ra in regs) or f.rb in regs:
+        raise Undefined              # RA/RB in the target range: invalid form
+    if n:
+        _lsw(s, f, _ea_x(s, f, False), n)
+
+
+@spec("stswx", "X", 31, 661, ea=("X", 1), tags=("ldst", "store", "string"))
+def _stswx(s, f):
+    n = s.xer & 0x7F
+    if n:
+        _stsw(s, f, _ea_x(s, f, False), n)
+
