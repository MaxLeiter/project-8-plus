+        uint32_t v = (cls == SH_QBYBI) ? (((uint32_t)c << 3) | (rnd32() & 7)) : (uint32_t)c;
+        if (seed & 1) v ^= rnd32() & (cls == SH_QBYTE ? 0xFFFFFFE0u : cls == SH_QBYBI ? 0xFFFFFF00u : 0xFFFFFFF8u);
+        put32(RB, v);
+        return; }
+    case SH_WSHIFT:
+        if (mode == 7) return;
+        for (i = 0; i < 4; i++) {
+            uint32_t v = (uint32_t)wcounts[(seed * 4 + i) % NEL(wcounts)];
+            if (seed & 1) v ^= rnd32() & 0xFFFFFFC0u;
+            put32(RB + 4 * i, v);
+        }
+        return;
+    case SH_HSHIFT:
+        if (mode == 7) return;
