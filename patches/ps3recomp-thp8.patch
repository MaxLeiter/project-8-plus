+/* who holds the session (the text at the start of the lock file) */
+static void sd_lock_holder(char* out, size_t cap)
+{
+    out[0] = 0;
+    char p[SD_PATH_MAX + 64];
+    snprintf(p, sizeof p, "%s/%s", s_save_root, SD_LOCK_NAME);
+    FILE* f = sd_fopen(p, "rb");
+    if (!f) return;
+    size_t n = fread(out, 1, cap - 1, f);
+    fclose(f);
+    out[n] = 0;
+    out[strcspn(out, "\r\n")] = 0;
+}
