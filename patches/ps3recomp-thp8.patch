+    else if (k < 80) return (lds_next(r) & 1) ? 1.0 : -1.0;
+    else b = lds_next(r);                                                     /* random bits */
+    memcpy(&d, &b, 8);
+    return d;
+}
+
+static void lds_gen_vr_raw(LdsRng* r, ppu_vr* v)
+{
+    uint32_t k = lds_below(r, 4);
+    if (k < 2) { v->d[0] = lds_next(r); v->d[1] = lds_next(r); return; }
