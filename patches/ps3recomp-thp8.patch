+static spu_pfn_wake_by_address s_wake_by_address_all;
+static volatile long s_park_api = 0;       /* 0 unresolved, 1 present, -1 absent */
+static int spu_park_api(void)
+{
+    long st = __atomic_load_n(&s_park_api, __ATOMIC_ACQUIRE);
+    if (st) return st > 0;
+    /* Benign race: concurrent first callers resolve the same two pointers;
