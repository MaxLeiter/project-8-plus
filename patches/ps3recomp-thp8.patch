+    InterlockedExchange(&g_pre.ready, 1);           /* publish: the render thread reads the table from now on */
+    fprintf(stderr, "[pso-preload] %lld of %u library pipelines loaded (%lld failed / not reproducible) in %.1f s; "
+                    "build_pso uses them from now on (PS3_PSO_PRELOAD=0 off)\n",
+            (long long)g_pre.loaded, g_pre.n, (long long)g_pre.failed, (double)(ld_psolib_now_us() - t0) / 1e6);
+    return 0;
+}
+static void ld_pso_preload_start(const ld_psolib_ix* ix, u32 n)
+{
+    if (!ix || !n || g_psolib.state != 1 || !ld_pre_mode()) return;
+    g_pre.list = (ld_psolib_ix*)malloc((size_t)n * sizeof(ld_psolib_ix));
+    u32 cap = 1024u; while (cap < n * 2u) cap *= 2u;
+    g_pre.t = (ld_pre_ent*)calloc(cap, sizeof(ld_pre_ent));
+    if (!g_pre.list || !g_pre.t) { free(g_pre.list); free(g_pre.t); g_pre.list = NULL; g_pre.t = NULL; return; }
+    memcpy(g_pre.list, ix, (size_t)n * sizeof(ld_psolib_ix));
+    g_pre.n = n; g_pre.cap = cap;
+    HANDLE th = CreateThread(NULL, 0, ld_pso_preload_worker, NULL, 0, NULL);
+    if (th) CloseHandle(th);
