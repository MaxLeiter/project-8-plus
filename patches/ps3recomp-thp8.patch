+static inline uint32_t spu__cfltu1(uint32_t x, int scale)
+{
+    uint32_t ex = (x >> 23) & 0xFFu;
+    if (!ex || (x >> 31)) return 0;
+    int sh = (int)ex - 150 + scale;
+    uint64_t sig = (x & 0x7FFFFFu) | 0x800000u;
+    if (sh >= 9) return 0xFFFFFFFFu;                       /* >= 2^32 */
+    uint64_t v = sh >= 0 ? (sig << sh) : (sh > -32 ? (sig >> -sh) : 0);
+    return v > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)v;
