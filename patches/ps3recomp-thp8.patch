+/* Streaming entry points, answered for the all-data-on-memory model this HLE
+ * implements (GetRemainFrame always reports CELL_ATRAC_ALLDATA_IS_ON_MEMORY):
+ * there is never room to add data, the read position is the end of what the
+ * title handed over, and adding bytes is refused with ALLDATA_IS_ONMEMORY.
+ *
+ * THP8 reaches these only from FMOD's AT3 codec (sub_0096C0xx), which itself
+ * skips the stream refill when GetRemainFrame returns -1/-2; its FSBs carry no
+ * ATRAC data (fsb_scan: MPEG + IMA-ADPCM only). Previously unregistered: the
+ * faked CELL_OK left the out-params as stack garbage. */
+s32 cellAtracGetStreamDataInfo(u32 pHandle, u32 ppucWritePointer, u32 puiWritableByte,
+                               u32 puiReadPosition)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    if (ppucWritePointer) vm_write32(ppucWritePointer, s->buf_ea + s->read_bytes);
+    if (puiWritableByte)  vm_write32(puiWritableByte, 0);
+    if (puiReadPosition)  vm_write32(puiReadPosition, s->read_bytes);
+    return CELL_OK;
+}
+
+s32 cellAtracAddStreamData(u32 pHandle, u32 uiAddByte)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    if (uiAddByte) {
+        static int n = 0;
+        if (n++ < 4)
+            fprintf(stderr, "[cellAtrac] AddStreamData(%u bytes): all data is on memory -- "
+                            "streaming is not implemented\n", uiAddByte);
+        return (s32)CELL_ATRAC_ERROR_ALLDATA_IS_ONMEMORY;
+    }
+    return CELL_OK;
+}
+
+/* CellAtracBufferInfo { u8* pucWriteAddr; u32 uiWritableByte; u32 uiMinWriteByte;
+ * u32 uiReadPosition; } -- nothing has to be re-read to seek when the whole file
+ * is on memory, so: no writable space, nothing required. */
+s32 cellAtracGetBufferInfoForResetting(u32 pHandle, u32 uiSample, u32 pBufferInfo)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    if (s->t.first + (s32)uiSample >= s->t.end) return (s32)CELL_ATRAC_ERROR_ILLEGAL_SAMPLE;
+    if (pBufferInfo) {
+        vm_write32(pBufferInfo + 0x0, s->buf_ea);
+        vm_write32(pBufferInfo + 0x4, 0);
+        vm_write32(pBufferInfo + 0x8, 0);
+        vm_write32(pBufferInfo + 0xC, s->read_bytes);
+    }
+    return CELL_OK;
+}
+
 s32 cellAtracResetPlayPosition(u32 pHandle, u32 uiSample, u32 uiWriteByte)
 {
     (void)uiWriteByte;
