diff --git a/libs/input/web_input.h b/libs/input/web_input.h
new file mode 100644
index 00000000..2eac607a
--- /dev/null
+++ b/libs/input/web_input.h
@@ -0,0 +1,57 @@
+/*
+ * ps3recomp - browser input state (PS3_WASM builds only).
+ *
+ * One struct in wasm linear memory that the page's main thread writes (KeyboardEvent, pointer, Gamepad API)
+ * and the runtime reads: the JS host learns its address from ps3_web_input_state() once at start-up and writes
+ * it directly through the shared WebAssembly.Memory. Every field is written whole by one writer (the main
+ * thread) and read by the pad / keyboard poll, so plain loads are enough; `seq` lets a reader tell a fresh
+ * report from a stale one.
+ *
+ * Layout is part of the JS contract (web/host/input.js); change both together.
+ */
+#ifndef PS3RECOMP_WEB_INPUT_H
+#define PS3RECOMP_WEB_INPUT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PS3_WEB_PADS 4
+
+typedef struct ps3_web_pad {        /* XInput-shaped: the Gamepad API "standard" mapping, converted in JS */
+    uint32_t seq;                   /* +0  bumped by JS on every write */
+    uint16_t buttons;               /* +4  XINPUT_GAMEPAD_* bits */
+    uint8_t  left_trigger;          /* +6  0..255 */
+    uint8_t  right_trigger;         /* +7 */
+    int16_t  lx, ly, rx, ry;        /* +8  -32768..32767, +y = up (XInput convention) */
+    uint8_t  connected;             /* +16 */
+    uint8_t  pad_[3];
+} ps3_web_pad;                      /* 20 bytes */
+
+typedef struct ps3_web_input {
+    uint32_t    version;            /* +0   = 2 (2 added wheel_y; JS writes it only when version >= 2) */
+    uint32_t    focused;            /* +4   page has focus (keys are cleared on blur) */
+    uint8_t     keys[512];          /* +8   indexed by USB HID usage (= SDL scancode) */
+    uint32_t    mouse_buttons;      /* +520 bit0 left, bit1 middle, bit2 right, bit3 x1, bit4 x2 (SDL order) */
+    int32_t     mouse_x, mouse_y;   /* +524 canvas pixels */
+    ps3_web_pad pads[PS3_WEB_PADS]; /* +532 */
+    uint16_t    rumble[PS3_WEB_PADS][2]; /* +612 written by the runtime: low / high frequency motor 0..65535 */
+    int32_t     wheel_y;            /* +628 cumulative wheel notches, + = up (JS Atomics.add); the runtime consumes deltas */
+} ps3_web_input;
+
+#ifndef __cplusplus
+_Static_assert(sizeof(ps3_web_pad) == 20, "ps3_web_pad layout (JS contract)");
+_Static_assert(__builtin_offsetof(ps3_web_input, pads) == 532, "ps3_web_input layout (JS contract)");
+_Static_assert(__builtin_offsetof(ps3_web_input, rumble) == 612, "ps3_web_input layout (JS contract)");
+_Static_assert(__builtin_offsetof(ps3_web_input, wheel_y) == 628, "ps3_web_input layout (JS contract)");
+_Static_assert(sizeof(ps3_web_input) == 632, "ps3_web_input layout (JS contract)");
+#endif
+
+ps3_web_input* ps3_web_input_state(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
