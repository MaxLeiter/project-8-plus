+           (unsigned long long)g_lds.trace_limit, (unsigned long long)(g_lds.mem_limit >> 20),
+           lds_test_count, lds_real_count, lds_all_count);
+}
+
+/* ======================= hashing / generators ================================ */
+uint64_t lds_hash_bytes(uint64_t h, const void* p, size_t n)
+{
+    const uint8_t* b = (const uint8_t*)p;
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        uint64_t w; memcpy(&w, b + i, 8);
+        h = (h ^ w) * 0x9E3779B97F4A7C15ull;
+        h = (h << 31) | (h >> 33);
+    }
+    for (; i < n; i++) { h = (h ^ b[i]) * 0x100000001B3ull; }
+    return lds_mix(h ^ n);
+}
+
+uint64_t lds_hash_regs(const ppu_context* c, int with_reserve)
+{
+    uint64_t h = 0x5EED0F5EED0F5EEDull;
+    h = lds_hash_bytes(h, c->gpr, sizeof c->gpr);
+    h = lds_hash_bytes(h, c->fpr, sizeof c->fpr);       /* bit patterns, NaN payloads included */
+    h = lds_hash_bytes(h, c->vr, sizeof c->vr);
+    h = lds_h(h, c->cr); h = lds_h(h, c->lr); h = lds_h(h, c->ctr); h = lds_h(h, c->xer);
+    h = lds_h(h, c->fpscr); h = lds_h(h, c->vscr);
+    if (with_reserve) {
+        h = lds_h(h, c->reserve_addr); h = lds_h(h, c->reserve_value);
+        h = lds_h(h, (uint64_t)(int64_t)c->reserve_valid);
+    }
+    return h;
+}
+
+uint32_t* g_pool = nullptr;      /* filled by the driver from --pool */
+uint32_t  g_pool_n = 0;
+uint32_t lds_pool_pick(LdsRng* r) { return g_pool_n ? g_pool[lds_below(r, g_pool_n)] : 0; }
+
+static uint64_t heap_ptr(LdsRng* r)
+{
+    uint32_t span = (LDS_HEAP_HI - LDS_HEAP_LO) - 0x4000u;
+    uint32_t p = LDS_HEAP_LO + lds_below(r, span);
+    return (lds_below(r, 4) == 0) ? (p & ~15u) : (p & ~3u);
+}
+
+static uint64_t lds_gen_gpr_raw(LdsRng* r)
+{
+    uint32_t k = lds_below(r, 100);
+    if (k < 30) return heap_ptr(r);
+    if (k < 44) return lds_below(r, 16);
+    if (k < 52) return 0;
+    if (k < 56) return 1;
+    if (k < 62) return (uint64_t)-(int64_t)(1 + lds_below(r, 16));
+    if (k < 74) return (uint32_t)lds_next(r);
+    if (k < 80) return (uint64_t)(int64_t)(int32_t)lds_next(r);
+    if (k < 90) return lds_next(r);
+    if (k < 96) { uint32_t a = lds_pool_pick(r); return a ? a : heap_ptr(r); }
