+/* ---- fi: floating interpolate, the second half of the frest/frsqest estimate.
+ * rb is an estimate word: sign | exponent | 13-bit base fraction (bits 22..10)
+ * | 10-bit step (bits 9..0); ra is the original operand, whose fraction bits
+ * 18..0 are the interpolation point y. The result keeps rb's sign and
+ * exponent and takes its fraction from (1.base - step * 2^-13 * y * 2^-19),
+ * each of the product and the difference truncated to 24 significant bits;
+ * a difference below 1 is renormalised (RPCS3's SPUInterpreter FI and the
+ * reference executor in tests/spucheck agree on this). For an estimate fed back
+ * with its own operand the difference never leaves [1, 2) and this is the
+ * plain linear interpolation.
+ *
+ * The old helper rebuilt rb as a float (sign|exponent|base) and subtracted a
+ * step scaled by rb's exponent: right in the common case, but an estimate with
+ * exponent 255 (frest/frsqest of a zero) became a host NaN and one with
+ * exponent 0 (frest of |x| >= 2^126) a flushed denormal, and a difference
+ * below 1 moved the exponent instead of the fraction. Here the arithmetic runs
+ * on the normalised 1.base value only, so rb's exponent never enters it.
+ * Exact under the SPU environment (round toward zero): both conversions and
+ * both power-of-two scalings are exact, the product and the difference round
+ * once each. ---- */
+#if defined(SPU_FP_SSE2)
+static inline u128 spu_fi(u128 a, u128 b)
+{
+    const __m128i se = _mm_set1_epi32((int)0xFF800000u);
+    __m128i A = spu__pi(a), B = spu__pi(b);
+    __m128 base = _mm_castsi128_ps(_mm_or_si128(_mm_and_si128(B, _mm_set1_epi32(0x007FFC00)),
+                                                _mm_set1_epi32(0x3F800000)));
+    __m128 step = _mm_mul_ps(_mm_cvtepi32_ps(_mm_and_si128(B, _mm_set1_epi32(0x3FF))),
