+        for (size_t i = 0; i < n; i++) tab[i] = ps3_indirect_call;
+        for (uint32_t i = 0; i < lds_all_count; i++) tab[(lds_all_fns[i].addr - lo) / 4] = lds_all_fns[i].fn;
