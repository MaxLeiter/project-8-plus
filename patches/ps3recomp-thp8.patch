+        L_track_upload(l, sr->id, off, off + (u64)f->Footprint.RowPitch * ((h + fi.block_w - 1) / fi.block_w) * d);
+    } else if (src->Type == D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX && dst->Type == D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT) {
+        const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* f = &dst->PlacedFootprint;
+        const wgs_fmt_info fi = fmt_info(f->Footprint.Format);
+        u32 x0 = 0, y0 = 0, z0 = 0, w = f->Footprint.Width, h = f->Footprint.Height, d = f->Footprint.Depth;
+        if (box) { x0 = box->left; y0 = box->top; z0 = box->front; w = box->right - box->left; h = box->bottom - box->top; d = box->back - box->front; }
+        u32 mip, slice; sub_of(sr, src->SubresourceIndex, &mip, &slice);
+        const u32 rows = (f->Footprint.Height + fi.block_w - 1) / fi.block_w;
