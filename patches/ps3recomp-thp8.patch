+void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*)) { (void)nid; (void)name; (void)fn; }
+void ppu_resv_break_store(uint64_t ea)         { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+unsigned long long ps3_ms_now(void)            { return GetTickCount64(); }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi = 0;
+int      g_resv_store_active = 0;
+uint32_t g_barrier_sync_watch = 0;
+void (*g_spurs_kernel_hook)(uint32_t) = 0;
+uint32_t g_ydkj_spurs_ctx_ea, g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; }
+void ydkj_wake_all_event_flags(void) {}
+uint64_t spurs_pm_build_context(uint8_t* ls, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{ (void)ls; (void)a; (void)b; (void)c; (void)d; return 0; }
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+uint32_t ps3_spu_image_source_ea(uint32_t ea)  { return ea; }
+uint32_t spurs_port_queue(uint32_t port)       { (void)port; return 0; }
+void spu_raw_note_image(uint32_t ea, uint32_t src) { (void)ea; (void)src; }
+int32_t spu_registry_fallback(uint32_t tid, uint32_t args, uint32_t size, void* user)
+{ (void)tid; (void)args; (void)size; (void)user; return -1; }
+void ps3_net_offline_register(void)              {}
+void ps3_sysprx_console_register(void)           {}
+/* The PPU function table (generated ppu_recomp.h). lv2_register.c declares it
+ * at block scope with its own struct tag, so it is supplied under another name
+ * and aliased at link time. */
+const uint64_t test_function_table[3] = { 0, 0, 0 };
+const uint64_t test_function_table_count = 0;
+#pragma comment(linker, "/alternatename:function_table=test_function_table")
+#pragma comment(linker, "/alternatename:function_table_count=test_function_table_count")
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    vm_base = (uint8_t*)VirtualAlloc(NULL, GUEST_SIZE, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!vm_base) { printf("cannot allocate guest memory\n"); return 2; }
+    g_ev_signal = CreateEventA(NULL, FALSE, FALSE, NULL);
+    { extern int (*g_spu_user_event_hook)(spu_context*, uint32_t);
+      g_spu_user_event_hook = spu_deliver_user_event; }
+
+    /* Two images with no segments, each naming its entry point. */
+    pbe32(IMG0_EA + 0, 0); pbe32(IMG0_EA + 4, ENTRY0); pbe32(IMG0_EA + 8, SEGS_EA); pbe32(IMG0_EA + 12, 0);
+    pbe32(IMG1_EA + 0, 0); pbe32(IMG1_EA + 4, ENTRY1); pbe32(IMG1_EA + 8, SEGS_EA); pbe32(IMG1_EA + 12, 0);
+    spu_begin_image(IMAGE_ID);
+    spu_register_function(ENTRY0, mixer_entry);
+    spu_register_function(ENTRY1, signals_entry);
+    spu_begin_image(0);
+
+    CHECK_EQ(call(sys_spu_thread_group_create_handler, OUT_EA, 2, 250, 0, 0, 0), 0);
+    uint32_t gid = gbe32(OUT_EA);
+    CHECK_EQ(call(sys_spu_thread_initialize_handler, OUT_EA, gid, 0, IMG0_EA, 0, 0), 0);
+    uint32_t tid0 = gbe32(OUT_EA);
+    CHECK_EQ(call(sys_spu_thread_initialize_handler, OUT_EA, gid, 1, IMG1_EA, 0, 0), 0);
+    uint32_t tid1 = gbe32(OUT_EA);
+    CHECK(tid0 != tid1);
+
+    test_routing(gid, tid0, tid1);
+    test_group(gid, tid0, tid1);
+
+    printf("lv2 SPU events/signals: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/runtime/spu/tests/test_spu_shufb_swapfree.c b/runtime/spu/tests/test_spu_shufb_swapfree.c
new file mode 100644
index 00000000..0b00095d
--- /dev/null
+++ b/runtime/spu/tests/test_spu_shufb_swapfree.c
@@ -0,0 +1,41 @@
+/* test_spu_shufb_swapfree.c -- spu_shufb (SSE4.1 path) vs spu_shufb_ref: every control byte value (0..255) at
+ * every one of the 16 positions with random sources, then fully random vectors; plus a timing comparison.
+ * Build: clang -O2 -msse4.1 test_spu_shufb_swapfree.c */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)s_rng; }
+static u128 rvec(void) { u128 v; for (int i = 0; i < 4; i++) v._u32[i] = rnd(); return v; }
+
+int main(void)
+{
+#if !defined(__SSE4_1__)
+    printf("SKIP: needs -msse4.1\n"); return 0;
+#else
+    long long n = 0, bad = 0;
+    for (int pos = 0; pos < 16; pos++)
+        for (int sel = 0; sel < 256; sel++)
+            for (int k = 0; k < 64; k++) {
+                u128 a = rvec(), b = rvec(), c = rvec();
+                c._u8[pos] = (uint8_t)sel;
+                u128 x = spu_shufb(a, b, c), y = spu_shufb_ref(a, b, c);
+                n++; if (memcmp(&x, &y, 16)) { if (bad++ < 5) printf("MISMATCH pos %d sel 0x%02X\n", pos, sel); }
+            }
+    for (long long i = 0; i < 20000000; i++) {
+        u128 a = rvec(), b = rvec(), c = rvec();
+        u128 x = spu_shufb(a, b, c), y = spu_shufb_ref(a, b, c);
+        n++; if (memcmp(&x, &y, 16)) { if (bad++ < 5) printf("MISMATCH random #%lld\n", i); }
+    }
+    printf("%s: %lld checks, %lld mismatches\n", bad ? "FAIL" : "OK", n, bad);
+    /* timing: a dependent chain through a and c */
+    u128 a = rvec(), b = rvec(), c = rvec();
+    clock_t t0 = clock();
+    for (long i = 0; i < 100000000; i++) { a = spu_shufb(a, b, c); c._u32[0] ^= a._u32[1] & 0x1F1F1F1F; }
+    double dt = (double)(clock() - t0) / CLOCKS_PER_SEC;
+    printf("timing: %.2f ns/shufb (sink %08X)\n", dt * 10.0, a._u32[0]);
+    return bad ? 1 : 0;
+#endif
+}
diff --git a/runtime/spu/tests/test_wasm_llwake.c b/runtime/spu/tests/test_wasm_llwake.c
new file mode 100644
index 00000000..f14d1939
--- /dev/null
+++ b/runtime/spu/tests/test_wasm_llwake.c
@@ -0,0 +1,237 @@
+/*
+ * Stress test for the WebAssembly lock-line event wakes (runtime/platform/ps3_wasm_llwake.c, PS3_WASM_LLWAKE):
+ * the futex lock-line mutex, cellSyncMutexLock's line-event ticket wait, and the SPU park fallback -- through the
+ * REAL units (spu_coherency.c, cellSync.c, ps3_wasm_llwake.c compiled straight in).
+ *
+ * A lost wake shows up as a wait that runs into its safety timeout: the test sets PS3_WASM_LLWAKE_MS / the
+ * fallback timeout to 20 s, so every wait in a passing run must end by an event (timeouts == 0), and the counters
+ * protected by the locks must come out exact.
+ *
+ * Build + run (emsdk 4.0.23; node = the emsdk's node):
+ *   emcc -O2 -pthread -sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=16 -sEXIT_RUNTIME -sINITIAL_MEMORY=256MB \
+ *        -DPS3_WASM -fno-delete-null-pointer-checks -I include -I runtime/spu \
+ *        runtime/spu/tests/test_wasm_llwake.c libs/sync/cellSync.c -o test_wasm_llwake.js
+ *   node test_wasm_llwake.js [iters-scale] [off]
+ * "off" runs the same load with PS3_WASM_LLWAKE=0 (spin + sched_yield) for a timing comparison only.
+ */
+#if !defined(__EMSCRIPTEN__)
+/* wasm-only: elsewhere (posix_gate, native compiles) an empty program */
+int main(void) { return 0; }
+#else
+#include "../spu_coherency.c"
+#include "../../../libs/sync/cellSync.h"   /* cellSync.c is a second TU (its prototypes differ in constness) */
+#include "../../platform/ps3_wasm_llwake.c"
+#include "../../platform/ps3_wasm_sched.c"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- runtime pieces a real build supplies ---------------------------------------------------------------- */
+static uint8_t g_guest_mem[1u << 20] __attribute__((aligned(128)));
+uint8_t* vm_base = g_guest_mem;
+void spu_ch_wake(spu_context* ctx) { (void)ctx; }
+int g_ft_on;                                             /* frame_trace.c (PS3_SPIKE_MS): off */
+void frame_trace_add(int id, long long v) { (void)id; (void)v; }
+long long frame_trace_now_us(void) { return 0; }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi = 0;           /* ppu_memory.h (via cellSync.c) */
+int      g_resv_store_active = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+
+/* ---- harness ------------------------------------------------------------------------------------------------ */
+static int g_fail;
+#define CHECK(c, ...) do { if (!(c)) { g_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+static double now_ms(void) { return emscripten_get_now(); }
+static long long stat_take(int k) { return __atomic_exchange_n(&g_llw_stat[k], 0, __ATOMIC_RELAXED); }
+static unsigned g_scale = 1;
+static volatile int g_go;
+static void busy_ns(unsigned ns) { const double t = now_ms() + ns / 1e6; while (now_ms() < t) {} }
+static uint32_t rng(uint32_t* s) { *s ^= *s << 13; *s ^= *s >> 17; *s ^= *s << 5; return *s; }
+
+/* ---- 1. lock-line mutex: exact counter under heavy contention, sleep path forced (spin 0 / 16) -------------- */
+static long long g_c1;                 /* plain, protected by the lock-line lock */
+static unsigned g_t1_iters;
+static void* t1(void* a)
+{
+    uint32_t s = 0x9E3779B9u ^ (uint32_t)(uintptr_t)a;
+    while (!g_go) {}
+    for (unsigned i = 0; i < g_t1_iters; i++) {
+        spu_lockline_lock();
+        long long v = g_c1;
+        if ((rng(&s) & 63) == 0) busy_ns(2000);      /* occasionally hold it long enough for others to sleep */
+        g_c1 = v + 1;
+        spu_lockline_unlock();
+    }
+    return NULL;
+}
+static void test_lockline(int nthr, unsigned iters)
+{
+    pthread_t th[16]; g_c1 = 0; g_t1_iters = iters; g_go = 0;
+    for (int i = 0; i < nthr; i++) pthread_create(&th[i], NULL, t1, (void*)(uintptr_t)(i + 1));
+    const double t0 = now_ms(); g_go = 1;
+    for (int i = 0; i < nthr; i++) pthread_join(th[i], NULL);
+    const double ms = now_ms() - t0;
+    const long long slow = stat_take(LLW_LL_SLOW), sl = stat_take(LLW_LL_SLEEP), slus = stat_take(LLW_LL_SLEEP_US);
+    printf("  lockline %d thr x %u: %.0f ms, slow %lld, sleeps %lld (avg %.0f us)\n", nthr, iters, ms, slow, sl,
+           sl ? (double)slus / sl : 0.0);
+    CHECK(g_c1 == (long long)nthr * iters, "lockline counter %lld != %lld", g_c1, (long long)nthr * iters);
+    if (ps3_llwake_on() && s_spin == 0) CHECK(sl > 0, "sleep path never exercised");
+    CHECK(slus / (sl ? sl : 1) < 1000000, "a lock-line sleeper waited ~its 100 ms timeout: lost wake?");
+}
+
+/* ---- 2. cellSyncMutex shared by "PPU" HLE threads and "SPU" GETLLAR/PUTLLC threads ---------------------------
+ * PPU threads: cellSyncMutexLock / Unlock (line-event ticket wait). SPU threads: the guest's ticket lock done the
+ * way the MFC paths do it -- line read + CAS-like commit under the lock-line lock, then spu_coh_notify_write; the
+ * ticket wait = GETLLAR snapshot, then the park fallback (spu_coh_llw_fallback) against that snapshot. Noise
+ * threads write OTHER words of the same line and of a colliding line (spurious wakes). */
+#define MUTEX_EA   0x1000u
+#define NOISE_EA   0x1040u               /* same 128-byte line, other word */
+static long long g_c2;
+static unsigned g_t2_iters;
+static volatile int g_noise_stop;
+static uint32_t be32(uint32_t v) { return __builtin_bswap32(v); }
+static void spu_like_lock(void)
+{
+    uint8_t* line = vm_base + (MUTEX_EA & ~127u);
+    volatile uint32_t* w = (volatile uint32_t*)(vm_base + MUTEX_EA);
+    uint16_t ticket;
+    spu_lockline_lock();                                   /* GETLLAR + PUTLLC, collapsed (always succeeds) */
+    { uint32_t g = be32(*w); ticket = (uint16_t)g; *w = be32((g & 0xFFFF0000u) | (uint16_t)(ticket + 1));
+      spu_coh_notify_write(MUTEX_EA); }
+    spu_lockline_unlock();
+    uint8_t snap[128];
+    for (;;) {
+        spu_lockline_lock(); memcpy(snap, line, 128); spu_lockline_unlock();     /* GETLLAR */
+        if ((uint16_t)(be32(*(uint32_t*)(snap + (MUTEX_EA & 127u))) >> 16) == ticket) return;
+        spu_coh_llw_fallback(MUTEX_EA, snap, 20000);
+    }
+}
+static void spu_like_unlock(void)
+{
+    volatile uint32_t* w = (volatile uint32_t*)(vm_base + MUTEX_EA);
+    spu_lockline_lock();
+    { uint32_t g = be32(*w); *w = be32((uint32_t)(uint16_t)((g >> 16) + 1) << 16 | (uint16_t)g);
+      spu_coh_notify_write(MUTEX_EA); }
+    spu_lockline_unlock();
+}
+static void* t2(void* a)
+{
+    const int spu = ((uintptr_t)a & 1) != 0;
+    uint32_t s = 0x1234567u ^ (uint32_t)(uintptr_t)a;
+    while (!g_go) {}
+    for (unsigned i = 0; i < g_t2_iters; i++) {
+        if (spu) spu_like_lock(); else cellSyncMutexLock((CellSyncMutex*)(uintptr_t)MUTEX_EA);
+        long long v = g_c2;
+        if ((rng(&s) & 15) == 0) busy_ns(20000);         /* > the 1000-probe spin: waiters reach the sleep */
+        g_c2 = v + 1;
+        if (spu) spu_like_unlock(); else cellSyncMutexUnlock((CellSyncMutex*)(uintptr_t)MUTEX_EA);
+    }
+    return NULL;
+}
+static void* noise(void* a)
+{
+    (void)a;
+    uint32_t n = 0;
+    while (!g_noise_stop) {
+        spu_lockline_lock();
+        *(volatile uint32_t*)(vm_base + NOISE_EA) = ++n;
+        spu_coh_notify_write(NOISE_EA);
+        spu_lockline_unlock();
+        busy_ns(50000);
+    }
+    return NULL;
+}
+static void test_sync(int nthr, unsigned iters)
+{
+    pthread_t th[16], nz; g_c2 = 0; g_t2_iters = iters; g_go = 0; g_noise_stop = 0;
+    *(uint32_t*)(vm_base + MUTEX_EA) = 0;
+    spu_coh_reserve(NULL, MUTEX_EA);                       /* an SPU has GETLLAR'd the line */
+    pthread_create(&nz, NULL, noise, NULL);
+    for (int i = 0; i < nthr; i++) pthread_create(&th[i], NULL, t2, (void*)(uintptr_t)i);
+    const double t0 = now_ms(); g_go = 1;
+    for (int i = 0; i < nthr; i++) pthread_join(th[i], NULL);
+    const double ms = now_ms() - t0;
+    g_noise_stop = 1; pthread_join(nz, NULL);
+    const long long sw = stat_take(LLW_SYNC_WAIT), swk = stat_take(LLW_SYNC_WOKEN), stm = stat_take(LLW_SYNC_TMO),
+                    sl = stat_take(LLW_SYNC_LATE), sus = stat_take(LLW_SYNC_US);
+    const long long fw = stat_take(LLW_FB_WAIT), fwk = stat_take(LLW_FB_WOKEN), fl = stat_take(LLW_FB_LATE),
+                    fus = stat_take(LLW_FB_US);
+    const long long ev = stat_take(LLW_EV), evw = stat_take(LLW_EV_WAKE), y = stat_take(LLW_YIELD);
+    const long long wt = stat_take(LLW_W_TMO), wsp = stat_take(LLW_W_SPUR);
+    printf("  (futex returns with the counter unchanged: timeout %lld, woken-spurious %lld)\n", wt, wsp);
+    stat_take(LLW_LL_SLOW); stat_take(LLW_LL_SLEEP); stat_take(LLW_LL_SLEEP_US); stat_take(LLW_YIELD_US);
+    printf("  sync %d thr (PPU+SPU) x %u: %.0f ms | ppu waits %lld woken %lld tmo %lld late %lld avg %.0f us"
+           " | spu fallback %lld woken %lld late %lld avg %.0f us | events %lld wakes %lld | yields %lld\n",
+           nthr, iters, ms, sw, swk, stm, sl, sw ? (double)sus / sw : 0.0, fw, fwk, fl, fw ? (double)fus / fw : 0.0,
+           ev, evw, y);
+    const uint32_t g = be32(*(uint32_t*)(vm_base + MUTEX_EA));
+    CHECK(g_c2 == (long long)nthr * iters, "mutex counter %lld != %lld (mutual exclusion broken)", g_c2,
+          (long long)nthr * iters);
+    CHECK((uint16_t)(g >> 16) == (uint16_t)g, "mutex not free at the end: %08X", g);
+    if (ps3_llwake_on()) {
+        CHECK(stm == 0, "%lld PPU ticket waits ran into the 20 s safety timeout (lost wake)", stm);
+        CHECK(fw == fwk, "%lld SPU fallback waits ended without an event (lost wake)", fw - fwk);
+        if (nthr >= 6) CHECK(sw > 0 && fw > 0, "a wait path was never exercised (ppu %lld spu %lld)", sw, fw);
+    }
+}
+
+/* ---- 3. ping-pong: strict alternation through one word, every handoff a wake --------------------------------- */
+#define PP_EA 0x2000u
+static unsigned g_pp_n;
+static void* pp(void* a)
+{
+    const uint32_t me = (uint32_t)(uintptr_t)a;              /* 0 or 1: moves when word % 2 == me */
+    volatile uint32_t* w = (volatile uint32_t*)(vm_base + PP_EA);
+    uint8_t snap[128];
+    while (!g_go) {}
+    for (unsigned i = 0; i < g_pp_n; i++) {
+        for (;;) {
+            spu_lockline_lock(); memcpy(snap, vm_base + PP_EA, 128); spu_lockline_unlock();
+            if ((*(uint32_t*)snap & 1) == me) break;
+            spu_coh_llw_fallback(PP_EA, snap, 20000);          /* sleep at once: no spin */
+        }
+        spu_lockline_lock(); *w = *w + 1; spu_coh_notify_write(PP_EA); spu_lockline_unlock();
+    }
+    return NULL;
+}
+static void test_pingpong(unsigned n)
+{
+    pthread_t a, b; g_pp_n = n; g_go = 0; *(uint32_t*)(vm_base + PP_EA) = 0;
+    spu_coh_reserve(NULL, PP_EA);
+    pthread_create(&a, NULL, pp, (void*)0); pthread_create(&b, NULL, pp, (void*)1);
+    const double t0 = now_ms(); g_go = 1;
+    pthread_join(a, NULL); pthread_join(b, NULL);
+    const double ms = now_ms() - t0;
+    const long long fw = stat_take(LLW_FB_WAIT), fwk = stat_take(LLW_FB_WOKEN);
+    for (int k = 0; k < LLW_NSTAT; k++) stat_take(k);
+    printf("  ping-pong %u round trips: %.0f ms (%.1f us per handoff), waits %lld woken %lld\n", n, ms,
+           ms * 1000.0 / (2.0 * n), fw, fwk);
+    CHECK(*(uint32_t*)(vm_base + PP_EA) == 2 * n, "ping-pong word %u != %u", *(uint32_t*)(vm_base + PP_EA), 2 * n);
+    if (ps3_llwake_on()) CHECK(fw == fwk, "%lld ping-pong waits ended without an event (lost wake)", fw - fwk);
+}
+
+int main(int argc, char** argv)
+{
+    g_scale = argc > 1 ? (unsigned)atoi(argv[1]) : 1; if (!g_scale) g_scale = 1;
+    const int off = argc > 2 && !strcmp(argv[2], "off");
+    setenv("PS3_WASM_LLWAKE", off ? "0" : "1", 1);
+    setenv("PS3_WASM_LLWAKE_MS", "20000", 1);            /* a lost wake = a 20 s stall + a timeout count */
+    setenv("PS3_GAME_STATS", "1", 1);
+    game_stats_sec();
+    printf("test_wasm_llwake: llwake %s, scale %u\n", ps3_llwake_on() ? "ON" : "OFF", g_scale);
+    for (int spin = 0; spin <= 1; spin++) {
+        /* PS3_WASM_LLWAKE_SPIN is read once; switch the parsed value directly between rounds */
+        s_spin = spin ? 256 : 0;
+        printf(" round spin=%u\n", s_spin);
+        test_lockline(8, 20000 * g_scale);
+        test_lockline(3, 50000 * g_scale);
+        test_sync(6, 3000 * g_scale);
+        test_sync(2, 5000 * g_scale);
+        test_pingpong(20000 * g_scale);
+    }
+    printf("%s (%d failures)\n", g_fail ? "FAILED" : "ALL PASS", g_fail);
+    return g_fail ? 1 : 0;
+}
+#endif /* __EMSCRIPTEN__ */
