+    for (u32 i = 0; i < g_pre.n; i++) {
+        /* A cold driver cache (fresh exe path, driver update) turns every library load into a compile, and the
+         * render thread's own library loads then wait behind ours (pool boots: 0.05-2.9 s render-thread loads
+         * while a 46 s preload ran). After 16 loads averaging > 4 ms: stop and keep what is loaded. */
+        if (timed == 16 && load_us > 16 * 4000) {
+            fprintf(stderr, "[pso-preload] driver cache cold (%.1f ms per load): stopped after %u pipelines so the render "
+                            "thread's loads do not queue behind it\n", (double)load_us / 16000.0, i);
+            break;
+        }
+        const ld_psolib_ix* x = &g_pre.list[i];
+        ID3DBlob* vs = shader_disk_cache_load_ref('V', x->vs_hash, x->vs_len);
+        ID3DBlob* ps = vs ? shader_disk_cache_load_ref('P', x->ps_hash, x->ps_len) : NULL;
