+/* the adapter of D3D12CreateDevice(NULL): DXGI adapter 0 */
+static void ld_psolib_identity(ld_psolib_header* id)
+{
+    memset(id, 0, sizeof(*id));
+    id->magic = LD_PSOLIB_MAGIC;
+    id->version = LD_PSOLIB_VERSION;
+    id->header_bytes = (u32)sizeof(*id);
+    id->exe = ld_psolib_exe_id();
+    id->rootsig = g_ld_rootsig_hash;
+    IDXGIFactory1* f = NULL;
+    IDXGIAdapter1* a = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory1, (void**)&f)) || !f) return;
+    if (SUCCEEDED(f->lpVtbl->EnumAdapters1(f, 0, &a)) && a) {
+        DXGI_ADAPTER_DESC1 d;
+        if (SUCCEEDED(a->lpVtbl->GetDesc1(a, &d))) {
+            id->vendor = d.VendorId; id->device = d.DeviceId;
+            id->subsys = d.SubSysId; id->revision = d.Revision;
+        }
+        LARGE_INTEGER umd;
+        umd.QuadPart = 0;
+        if (SUCCEEDED(a->lpVtbl->CheckInterfaceSupport(a, &IID_IDXGIDevice, &umd)))
+            id->driver = (u64)umd.QuadPart;
+        a->lpVtbl->Release(a);
+    }
+    f->lpVtbl->Release(f);
+}
