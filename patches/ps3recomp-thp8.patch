+int main(int argc, char** argv)
+{
+#ifdef _WIN32
+    /* argv in UTF-8 (the child mode arg can be a path) */
+    static char self[SD_PATH_MAX];
+    wchar_t w[SD_PATH_MAX];
+    GetModuleFileNameW(NULL, w, SD_PATH_MAX);
+    sd_utf8(w, self, sizeof self);
+    g_self = self;
+#else
+    g_self = argv[0];
+#endif
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc >= 4 && !strcmp(argv[1], "child")) {
+        const char* m = argv[2];
+        if (!strcmp(m, "oddpath")) return child_oddpath();
+        if (!strcmp(m, "import")) return child_import(argv[3]);
+        if (!strcmp(m, "hold")) return child_hold(argv[3]);
+        if (!strcmp(m, "second")) return child_second(argv[3]);
+        if (!strcmp(m, "idle")) return child_idle(argv[3]);
+        if (!strcmp(m, "oldlayout")) return child_oldlayout();
+#ifndef _WIN32
+        if (!strcmp(m, "probe")) return child_probe(argv[3]);
+#endif
+        return 99;
+    }
+    if (!sd_getenv("SAVEDATA_TEST_DIR", g_base, sizeof g_base)) snprintf(g_base, sizeof g_base, "savedata_shared_test");
+    {   /* every run in a new sub folder: nothing of an earlier run is reused (or deleted) */
+        char stamp[64];
+        snprintf(stamp, sizeof stamp, "/run_%lld", (long long)time(NULL));
+        strncat(g_base, stamp, sizeof g_base - strlen(g_base) - 1);
+    }
+    ensure_dirs(g_base);
+    printf("test dir: %s\n", g_base);
+    char root[SD_PATH_MAX], src[SD_PATH_MAX], p[SD_PATH_MAX], q[SD_PATH_MAX];
+    int rc;
+
+    /* 1. odd paths */
+    printf("1. a shared folder with spaces, [ ] ( ) & %% ! and non-ASCII characters\n");
+    clear_env();
+    case_dir(root, sizeof root, "1 Docs \xC3\x9Cn\xC3\xAF c\xC3\xB8" "d\xC3\xA9 \xE6\x97\xA5\xE6\x9C\xAC [x] (y) & z %TEMP% !bang!/My Games/Project 8 Plus/Saves");
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("TEST_WANT_ROOT", root);
+    rc = run_child("oddpath", "-");
+    CHECK(rc == 0, "child oddpath exit %d", rc);
+
+    /* 2. {Documents}: string only */
+    printf("2. {Documents} expands to the Documents folder (nothing created)\n");
+    {
+        char out[SD_PATH_MAX];
+        savedata_expand_root("{Documents}/My Games/Project 8 Plus/Saves", out, sizeof out);
+        printf("   -> %s\n", out);
+        CHECK(strstr(out, "/My Games/Project 8 Plus/Saves") && strncmp(out, "{", 1) != 0, "expanded '%s'", out);
+        savedata_expand_root("{documents}\\X", out, sizeof out);
+        CHECK(out[0] != '{' && strstr(out, "\\X"), "case-insensitive token: '%s'", out);
+        savedata_expand_root("D:\\Saves", out, sizeof out);
+        CHECK(!strcmp(out, "D:\\Saves"), "plain path changed: '%s'", out);
+    }
+
+    /* 3. import into an empty shared folder, then never again */
+    printf("3. import: an install's own save is copied into the empty shared folder\n");
+    clear_env();
+    case_dir(src, sizeof src, "3 old install (0.9.1) [a]/hdd0/home/00000001/savedata");
+    case_dir(root, sizeof root, "3 shared \xC3\x9C/Saves");
+    snprintf(p, sizeof p, "%s/BLUS30011_SAVE0", src);
+    make_save(p, 1);
+    s64 mt_src = mtime_of(p);
+    (void)mt_src;
+    char prg[SD_PATH_MAX];
+    snprintf(prg, sizeof prg, "%s/5B8AB877.PRG", p);
+    s64 mt_prg = mtime_of(prg);
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("PS3_SAVEDATA_IMPORT", src);
+    rc = run_child("import", "yes");
+    snprintf(q, sizeof q, "%s/BLUS30011_SAVE0", root);
+    CHECK(rc == 0 && dir_has_save(q), "no save in the shared folder after the import");
+    CHECK(same_files(p, q), "imported files differ from the source");
+    char qprg[SD_PATH_MAX];
+    snprintf(qprg, sizeof qprg, "%s/5B8AB877.PRG", q);
+    CHECK(mtime_of(qprg) == mt_prg, "write time not kept (%lld vs %lld)", (long long)mtime_of(qprg), (long long)mt_prg);
+    {
+        char mark[SD_PATH_MAX], txt[4096];
+        snprintf(mark, sizeof mark, "%s/%s", src, SD_IMPORT_MARK);
+        long n = read_file(mark, txt, sizeof txt - 1);
+        CHECK(n > 0, "no marker in the source");
+        if (n > 0) { txt[n] = 0; CHECK(strstr(txt, "COPIED") != NULL, "marker text"); }
+    }
+    CHECK(dir_has_save(p), "the source save is gone");
+    snprintf(p, sizeof p, "%s/BLUS30011_SAVE0.p3import", root);
+    CHECK(!dir_exists(p), "import tmp left");
+    /* the player empties the shared folder: no second import (marker) */
+    case_dir(root, sizeof root, "3 shared second/Saves");
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    rc = run_child("import", "no");
+    snprintf(q, sizeof q, "%s/BLUS30011_SAVE0", root);
+    CHECK(rc == 0 && !dir_exists(q), "imported a second time despite the marker");
+
+    /* 4. never overwrite */
+    printf("4. no overwrite: a shared folder that has a save keeps it\n");
+    clear_env();
+    case_dir(src, sizeof src, "4 install/hdd0/home/00000001/savedata");
+    case_dir(root, sizeof root, "4 shared/Saves");
+    snprintf(p, sizeof p, "%s/BLUS30011_SAVE0", src);
+    make_save(p, 1);
+    snprintf(q, sizeof q, "%s/BLUS30011_SAVE0", root);
+    make_save(q, 2);
+    char keep[SD_PATH_MAX];
+    case_dir(keep, sizeof keep, "4 reference");
+    make_save(keep, 2);
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("PS3_SAVEDATA_IMPORT", src);
+    rc = run_child("import", "no");
+    CHECK(rc == 0 && same_files(keep, q), "the shared save changed");
+    {
+        char mark[SD_PATH_MAX];
+        snprintf(mark, sizeof mark, "%s/%s", src, SD_IMPORT_MARK);
+        CHECK(!exists(mark), "marker written although nothing was imported");
+    }
+
+    /* 5. interrupted import */
+    printf("5. an interrupted import is no save and is finished by the next start\n");
+    clear_env();
+    case_dir(src, sizeof src, "5 install/hdd0/home/00000001/savedata");
+    case_dir(root, sizeof root, "5 shared/Saves");
+    snprintf(p, sizeof p, "%s/BLUS30011_SAVE0", src);
+    make_save(p, 3);
+    snprintf(q, sizeof q, "%s/BLUS30011_SAVE0.p3import", root);
+    ensure_dirs(q);
+    char half[SD_PATH_MAX];
+    snprintf(half, sizeof half, "%s/5B8AB877.PRG", q);
+    write_file(half, "half", 4);
+    {
+        setenv_u8("PS3_SAVEDATA_ROOT", root);   /* this process: list the folder as the game would (no import here) */
+        CellSaveDataDirList dl[4];
+        CHECK(enumerate_save_dirs("", dl, 4) == 0, "a .p3import folder listed as a save");
+        CHECK(sd_count_saves(root) == 0, "a .p3import folder counted as a save");
+    }
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("PS3_SAVEDATA_IMPORT", src);
+    rc = run_child("import", "yes");
+    snprintf(q, sizeof q, "%s/BLUS30011_SAVE0", root);
+    CHECK(rc == 0 && same_files(p, q), "the interrupted import was not finished");
+
+    /* 6. two games on one folder */
+    printf("6. locks: a second game waits for the first one's save pass\n");
+    clear_env();
+    case_dir(root, sizeof root, "6 shared/Saves");
+#ifndef _WIN32
+    case_dir(p, sizeof p, "6 probe.lock");
+    if (!record_locks_enforced(p)) {
+        printf("   SKIP: this system does not enforce record locks between processes (WSL1?)\n");
+        goto case7;
+    }
+#endif
+    case_dir(p, sizeof p, "6 ready.txt");
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("TEST_READY", p);
+    start_child_async("hold", "2500");
+    for (int i = 0; i < 100 && !exists(p); i++) sd_sleep_ms(50);
+    CHECK(exists(p), "the holder did not start");
+    setenv_u8("PS3_SAVEDATA_LOCK_MS", "300");
+    rc = run_child("second", "busy");
+    CHECK(rc == 0, "the second game got the pass lock while the first one held it");
+    setenv_u8("PS3_SAVEDATA_LOCK_MS", "10000");
+    rc = run_child("second", "free");
+    CHECK(rc == 0, "the second game never got the lock after the first one ended");
+
+    /* 6b. the session is taken at process start (before any save-data call): the launcher sees a game at its title */
+    printf("6b. a game that has not touched its saves yet already holds the session\n");
+    case_dir(root, sizeof root, "6b shared/Saves");
+    case_dir(p, sizeof p, "6b ready.txt");
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("TEST_READY", p);
+    start_child_async("idle", "2000");
+    for (int i = 0; i < 100 && !exists(p); i++) sd_sleep_ms(50);
+    CHECK(exists(p) && session_held_by_other(root), "the idle game holds no session lock");
+    sd_sleep_ms(2600);
+    CHECK(!session_held_by_other(root), "the session lock outlived the game");
+
+#ifndef _WIN32
+case7:
+#endif
+    /* 7. the old per-install layout */
+    printf("7. without PS3_SAVEDATA_ROOT: the install's own hdd0, as before\n");
+    clear_env();
+    case_dir(p, sizeof p, "7 install/hdd0");
+    ensure_dirs(p);
+    setenv_u8("PS3_VFS_STRICT", "1");
+    setenv_u8("PS3_HDD0_ROOT", p);
+    snprintf(q, sizeof q, "%s/home/00000001/savedata", p);
+    setenv_u8("TEST_WANT_ROOT", q);
+    rc = run_child("oldlayout", "-");
+    CHECK(rc == 0, "old layout child exit %d", rc);
+
+    /* 8. a shared folder that cannot be made (below a FILE): the install's own savedata this time */
+    printf("8. a shared folder that cannot be made: the install's own savedata\n");
+    clear_env();
+    case_dir(src, sizeof src, "8 install/hdd0/home/00000001/savedata");
+    ensure_dirs(src);
+    case_dir(p, sizeof p, "8 a file");
+    write_file(p, "x", 1);
+    snprintf(root, sizeof root, "%s/Saves", p);              /* below a file: never a folder */
+    setenv_u8("PS3_SAVEDATA_ROOT", root);
+    setenv_u8("PS3_SAVEDATA_IMPORT", src);
+    setenv_u8("TEST_WANT_ROOT", src);
+    rc = run_child("oldlayout", "-");
+    CHECK(rc == 0, "fallback child exit %d", rc);
+
+    printf(g_fail ? "FAIL\n" : "PASS\n");
+    return g_fail;
+}
