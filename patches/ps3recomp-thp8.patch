+    if (!fn) return 0;
+    int32_t si = (int32_t)ctx->image_id;
+    ctx->pc = pc;
+    ctx->host_depth++; fn(ctx); spu_drain_call(ctx, link); ctx->host_depth--;
+    spu_img_restore(ctx, si);
+    return 1;
+}
+int spu_job_native_try(spu_context* ctx)
