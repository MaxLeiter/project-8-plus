+    case SH_SHUFB: {                       /* control = rc (low 7 bits of the RRR word) */
+        if (mode == 7) return;
+        static const uint8_t bnd[4][4] = { { 0x80, 0xBF, 0x9F, 0xA0 }, { 0xC0, 0xDF, 0xCF, 0xD0 },
+                                           { 0xE0, 0xFF, 0xEF, 0xF0 }, { 0x00, 0x1F, 0x20, 0x7F } };
+        for (i = 0; i < 16; i++) {
+            int c = (mode < 4) ? mode : (int)(rnd() % 4);
+            uint8_t v;
+            if (rnd() % 4 == 0) v = bnd[c][rnd() % 4];
+            else v = (uint8_t)(c == 0 ? 0x80 | (rnd() & 0x3F) : c == 1 ? 0xC0 | (rnd() & 0x1F)
