+            case 4:                       /* denormal operands */
+                a = (rnd() & 1) ? mkd(s1, 0, rnd() | 1) : rand_double();
+                b = (rnd() & 1) ? mkd(s2, 0, rnd() | 1) : rand_double();
+                c = (rnd() & 1) ? mkd(rnd() & 1, 0, rnd() | 1) : rand_double();
+                break;
+            case 5:                       /* NaN / Inf / zero cross products */
+                a = dp_specials[(seed * 2 + i) % 16]; b = dp_specials[rnd() % 16]; c = dp_specials[rnd() % 16];
+                break;
+            default: continue;
+            }
+            put64(RA + 8 * i, a); put64(RB + 8 * i, b);
+            if (fma) put64(RT + 8 * i, c);
+        }
+        return; }
+    case SH_DPCMP:
+        for (i = 0; i < 2; i++) {
+            int k = seed * 2 + i;
+            uint64_t a = dp_specials[k % 16], b = dp_specials[(k / 16 + 5 * i) % 16];
+            if (seed >= 48) { a = rand_double(); b = (rnd() & 1) ? near64(a) : a ^ 0x8000000000000000ull; }
+            put64(RA + 8 * i, a); put64(RB + 8 * i, b);
+        }
+        return;
+    case SH_DFTSV:
+        if (mode == 7) return;
+        for (i = 0; i < 2; i++) put64(RA + 8 * i, (rnd() & 1) ? dp_specials[rnd() % 16] : mkd(rnd() & 1, (rnd() & 1) ? 0 : 2047, rnd()));
+        return;
+    case SH_FRDS:
+        if (mode == 7) return;
+        for (i = 0; i < 2; i++) {
+            uint64_t s = rnd() & 1, f = rnd() & 0xFFFFFFFFFFFFFull;
+            int e;
+            switch (rnd() % 5) {
+            case 0: e = 1023 + (int)(rnd() % 200) - 100; f = (f & ~0x1FFFFFFFull) | 0x10000000ull; break;   /* tie */
+            case 1: e = 1023 + 127 + (int)(rnd() % 3); if (rnd() & 1) f |= 0xFFFFFE0000000ull; break;       /* overflow */
+            case 2: e = 1023 - 126 - (int)(rnd() % 26); break;                                               /* underflow */
+            case 3: put64(RA + 8 * i, dp_specials[rnd() % 16]); continue;
+            default: e = (int)(rnd() % 2048); break;
+            }
+            put64(RA + 8 * i, mkd(s, e, f));
+        }
+        return;
+    case SH_FESD:
+        if (mode == 7) return;
+        for (i = 0; i < 4; i += 2) put32(RA + 4 * i, (rnd() & 1) ? sp_specials[rnd() % 16] : mkf(rnd32() & 1, (rnd() & 1) ? 0 : 255, rnd32()));
+        return;
+    case SH_CARRY:
+        if (mode == 7) return;
+        for (i = 0; i < 4; i++) {
+            uint32_t a = get32(RA + 4 * i), b;
+            switch (rnd() % 6) {
+            case 0: b = 0u - a; break;
+            case 1: b = ~a; break;
+            case 2: b = a; break;
+            case 3: b = a + 1; break;
+            case 4: b = a - 1; break;
+            default: b = get32(RB + 4 * i); break;
+            }
+            put32(RB + 4 * i, b);
+            if (!strcmp(mn, "addx") || !strcmp(mn, "sfx") || !strcmp(mn, "cgx") || !strcmp(mn, "bgx"))
+                put32(RT + 4 * i, (rnd32() & ~1u) | (uint32_t)(rnd() & 1));
+        }
+        return;
+    case SH_ICMP: {
+        if (mode == 7) return;
+        size_t n = strlen(mn);
+        int w = (mn[0] == 'h') ? 4 : (mn[n - 1] == 'b') ? 1 : (mn[n - 1] == 'h') ? 2 : 4;
+        for (i = 0; i < 16; i += w) {
+            uint32_t a = (w == 4) ? get32(RA + i) : (w == 2) ? get16(RA + i) : RA[i], b;
+            uint32_t sb = (w == 4) ? 0x80000000u : (w == 2) ? 0x8000u : 0x80u;
+            switch (rnd() % 5) {
+            case 0: b = a; break;
+            case 1: b = a + 1; break;
+            case 2: b = a - 1; break;
+            case 3: a = sb - (uint32_t)(rnd() & 1); b = sb - 1 + (uint32_t)(rnd() & 1); break;   /* signed/unsigned boundary */
+            default: continue;
+            }
+            if (w == 4) { put32(RA + i, a); put32(RB + i, b); }
+            else if (w == 2) { put16(RA + i, (uint16_t)a); put16(RB + i, (uint16_t)b); }
+            else { RA[i] = (uint8_t)a; RB[i] = (uint8_t)b; }
+        }
+        return; }
+    case SH_ICMPI: {
+        if (mode == 7) return;
+        size_t n = strlen(mn);
+        int w = (mn[0] == 'h') ? 4 : (mn[n - 2] == 'b') ? 1 : (mn[n - 2] == 'h') ? 2 : 4;
+        int32_t imm = (int32_t)((insn >> 14) & 0x3FF); imm = (imm ^ 0x200) - 0x200;
+        for (i = 0; i < 16; i += w) {
+            static const int d[] = { 0, 0, 1, -1, 2, -2 };
+            uint32_t v = (uint32_t)imm + (uint32_t)PICK(d);
+            if (rnd() % 4 == 0) continue;
+            if (w == 4) put32(RA + i, v); else if (w == 2) put16(RA + i, (uint16_t)v); else RA[i] = (uint8_t)v;
+            if (mn[0] == 'h') break;       /* halts compare the preferred word only */
+        }
+        return; }
+    default:
+        return;
+    }
+}
