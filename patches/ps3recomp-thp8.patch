+        uint64_t base = (uint64_t)(0x800000u | (rb & 0x7FFC00u)) << 9;
+        uint64_t p = (uint64_t)(rb & 0x3FFu) * (uint64_t)(ra & 0x7FFFFu);
+        int lp = 0; for (uint64_t t = p; t; t >>= 1) lp++;
+        if (lp > 24) p &= ~((1ull << (lp - 24)) - 1);
+        uint64_t d = base - p;
+        int ld = (d >> 32) ? 33 : 32;
+        r._u32[i] = (rb & 0xFF800000u) | ((uint32_t)(d >> (ld - 24)) & 0x7FFFFFu);
+    }
