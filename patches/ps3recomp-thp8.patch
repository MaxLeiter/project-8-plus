+/* Loading                                                                   */
+
+void make_host(plugin* p)
+{
+    ps3mod_host& h = p->host;
+    memset(&h, 0, sizeof h);
+    h.size            = (uint32_t)sizeof h;
+    h.abi_version     = PS3MOD_ABI_VERSION;
+    h.ctx_layout      = PS3MOD_CTX_LAYOUT;
+    h.ctx_size        = (uint32_t)sizeof(ppu_context);
+    h.lift_abi        = PS3MOD_LIFT_ABI;
+    h.hooks_available = (uint32_t)ppu_hook_available();
+    h.ppu_hash        = s_ppu_hash;
+    h.lift_id         = s_lift_id;
+    h.plugin_name     = p->name.c_str();
+    h.plugin_path     = p->path.c_str();
+    h.config_path     = p->config_path.c_str();
+    h.mods_root       = s_mods_root.c_str();
+    h.vm_base         = vm_base;
+    h.log             = api_log;
+    h.read8 = api_read8;   h.read16 = api_read16; h.read32 = api_read32; h.read64 = api_read64;
+    h.read_f32 = api_read_f32; h.read_f64 = api_read_f64;
+    h.write8 = api_write8; h.write16 = api_write16; h.write32 = api_write32; h.write64 = api_write64;
+    h.write_f32 = api_write_f32; h.write_f64 = api_write_f64;
+    h.read_block = api_read_block; h.write_block = api_write_block;
+    h.guest_to_host = api_guest_to_host; h.host_to_guest = api_host_to_guest;
+    h.hook_register = api_hook_register;
+    h.call_next = api_call_next;
+    h.is_function_entry = api_is_function_entry;
+    h.guest_call = api_guest_call;
+    h.guest_call_ex = api_guest_call_ex;
+    h.cfg_str = api_cfg_str; h.cfg_int = api_cfg_int; h.cfg_float = api_cfg_float; h.cfg_bool = api_cfg_bool;
+    h.get_display = api_get_display;
+    h.on_event = api_on_event;
+    h.patch = api_patch;
+    h.set_pacing = api_set_pacing;
+    /* ABI 1.2 */
+    h.hook_add = api_hook_add;
+    h.hook_enable = api_hook_enable;
+    h.guest_alloc = api_guest_alloc;
+    h.guest_free = api_guest_free;
+    h.service_publish = api_service_publish;
+    h.service_get = api_service_get;
+    h.mods_rescan = api_mods_rescan;
+    h.screenshot = api_screenshot;
+    h.debug_lines = api_debug_lines;
+    /* ABI 1.3 */
+    h.input_info = api_input_info;
+    h.key_name = api_key_name;
+    h.key_label = api_key_label;
+    h.tex_redirect = api_tex_redirect;
+}
+
+/* INI / simple TOML: [section], key = value, '#' / ';' comments, "quoted"
+ * (with \" \\ \n \t escapes) or 'literal' strings. */
+void cfg_parse(plugin* p, const std::string& text)
+{
+    std::string section;
+    size_t pos = 0;
+    if (text.size() >= 3 && (unsigned char)text[0] == 0xEF && (unsigned char)text[1] == 0xBB &&
+        (unsigned char)text[2] == 0xBF) pos = 3;
+    while (pos < text.size()) {
+        size_t eol = text.find('\n', pos);
+        if (eol == std::string::npos) eol = text.size();
+        std::string line = trim(text.substr(pos, eol - pos));
+        pos = eol + 1;
+        if (line.empty() || line[0] == '#' || line[0] == ';') continue;
+        if (line[0] == '[') {
+            size_t b = 0;
+            while (b < line.size() && line[b] == '[') b++;
+            size_t e = line.find(']', b);
+            section = trim(line.substr(b, e == std::string::npos ? std::string::npos : e - b));
+            continue;
+        }
+        size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        std::string key = trim(line.substr(0, eq));
+        if (key.size() >= 2 && (key[0] == '"' || key[0] == '\'') && key.back() == key[0])
+            key = key.substr(1, key.size() - 2);
+        std::string raw = trim(line.substr(eq + 1)), val;
+        if (!raw.empty() && raw[0] == '"') {
+            for (size_t i = 1; i < raw.size() && raw[i] != '"'; i++) {
+                char c = raw[i];
+                if (c == '\\' && i + 1 < raw.size()) {
+                    c = raw[++i];
+                    if (c == 'n') c = '\n'; else if (c == 't') c = '\t';
+                }
+                val += c;
+            }
+        } else if (!raw.empty() && raw[0] == '\'') {
+            size_t e = raw.find('\'', 1);
+            val = raw.substr(1, e == std::string::npos ? std::string::npos : e - 1);
+        } else {
+            size_t c = std::string::npos;
+            for (size_t i = 0; i < raw.size(); i++)
+                if ((raw[i] == '#' || raw[i] == ';') && (i == 0 || raw[i - 1] == ' ' || raw[i - 1] == '\t')) { c = i; break; }
+            val = trim(raw.substr(0, c));
+        }
+        if (!key.empty()) p->cfg.push_back({ section, key, val });
+    }
+}
+
+bool hash_eq(const char* want, const char* have)
+{
+    if (!want || !have || !*have) return false;
+    if (!_strnicmp(want, "PPU-", 4)) want += 4;
+    if (!_strnicmp(have, "PPU-", 4)) have += 4;
+    return strlen(want) == 40 && _stricmp(want, have) == 0;
+}
+
+/* Checks (a)-(c) on the plugin's info. */
+bool validate_info(plugin* p, std::string& why)
+{
+    const ps3mod_info* in = &p->info;
+    if (!in->abi_version) { why = "ps3mod_info was not filled in (abi_version 0)"; return false; }
+    const uint32_t maj = PS3MOD_ABI_VERSION_MAJOR(in->abi_version), mnr = PS3MOD_ABI_VERSION_MINOR(in->abi_version);
+    if (maj != PS3MOD_ABI_MAJOR || mnr > PS3MOD_ABI_MINOR) {
+        why = strf("built for plugin ABI %u.%u, this exe provides %u.%u",
+                   maj, mnr, (unsigned)PS3MOD_ABI_MAJOR, (unsigned)PS3MOD_ABI_MINOR);
+        return false;
+    }
+    if (in->ctx_layout && in->ctx_layout != PS3MOD_CTX_LAYOUT) {
+        why = strf("ppu_context layout %u, this exe has %u", in->ctx_layout, (unsigned)PS3MOD_CTX_LAYOUT);
+        return false;
+    }
+    if (in->lift_abi && in->lift_abi != PS3MOD_LIFT_ABI) {
+        why = strf("lift ABI %u, this exe has %u", in->lift_abi, (unsigned)PS3MOD_LIFT_ABI);
+        return false;
+    }
+    if (!(in->flags & PS3MOD_INFO_ANY_GAME)) {
+        if (!in->required_ppu_hash || !*in->required_ppu_hash) {
+            why = "no required_ppu_hash (set PS3MOD_INFO_ANY_GAME for a game-agnostic plugin)";
+            return false;
+        }
+        if (!s_ppu_hash[0]) {
+            why = strf("needs %s, but the running ELF's PPU hash could not be computed", in->required_ppu_hash);
+            return false;
+        }
+        if (!hash_eq(in->required_ppu_hash, s_ppu_hash)) {
+            why = strf("built for %s, the running ELF is %s", in->required_ppu_hash, s_ppu_hash);
+            return false;
+        }
+    }
+    if (in->required_lift_id && *in->required_lift_id && strcmp(in->required_lift_id, s_lift_id) != 0) {
+        why = strf("built for lift %s, this exe is %s", in->required_lift_id, s_lift_id);
+        return false;
+    }
+    if (in->n_required_entries) {
+        if (!in->required_entries) { why = "n_required_entries set but required_entries is NULL"; return false; }
+        for (uint32_t i = 0; i < in->n_required_entries; i++) {
+            const uint32_t a = in->required_entries[i];
+            const int r = hookable(a);
+            if (r != PS3MOD_OK) {
+                why = strf("required entry 0x%08X is %s", a, r == PS3MOD_E_IMPORT_STUB
+                           ? "an import stub" : "not a lifted function entry in this exe");
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+/* Install what init staged. Pre-validated, so a failure here means the
+ * dispatcher ran out of memory or its rules changed: say so loudly. */
+/* Put one hook record into the dispatcher's chain (commit, or hook_add on a
+ * loaded plugin). Pre-validated, so a failure means the dispatcher ran out of
+ * memory or its rules changed: say so loudly. */
+void install_hook(plugin* p, hook_rec* r)
+{
+    const int rc = ppu_hook_function(r->addr, hook_adapter, r);
+    if (rc != PPU_HOOK_OK) {
+        fprintf(stderr, "[mods] %s: ERROR: installing the hook on 0x%08X failed (%d)\n",
+                p->file.c_str(), r->addr, rc);
+        return;
+    }
+    if (r->mode == PS3MOD_HOOK_REPLACE && !r->n_lr) {
+        spin_guard g(s_handle_lock);
+        s_replaced.push_back({ r->addr, p });
+    }
+    if (s_debug) {
+        std::string lrs;
+        for (uint32_t i = 0; i < r->n_lr; i++) lrs += strf(" 0x%08X", r->lr[i]);
+        fprintf(stderr, "[mods] %s: %s 0x%08X%s%s (handle %u%s)\n", p->file.c_str(),
+                r->mode == PS3MOD_HOOK_REPLACE ? "replace" : "wrap", r->addr,
+                lrs.empty() ? "" : " entry_lr in", lrs.c_str(), r->handle,
+                p->state == PLG_ACTIVE ? ", live" : "");
+    }
+}
+
+void commit(plugin* p)
+{
+    for (const staged_hook& h : p->hooks) install_hook(p, h.rec);
+    for (const staged_patch& sp : p->patches) {
+        if (memcmp(vm_base + sp.addr, sp.expect.data(), sp.expect.size()) != 0) {
+            fprintf(stderr, "[mods] %s: ERROR: bytes at 0x%08X changed since the patch was checked; skipped\n",
+                    p->file.c_str(), sp.addr);
+            continue;
+        }
+        memcpy(vm_base + sp.addr, sp.bytes.data(), sp.bytes.size());
+        fprintf(stderr, "[mods] %s: patched %u bytes at 0x%08X\n", p->file.c_str(),
+                (unsigned)sp.bytes.size(), sp.addr);
+    }
+    for (const staged_event& e : p->events)
+        if (add_event(e.ev, e.fn, e.user) != PS3MOD_OK)
+            fprintf(stderr, "[mods] %s: ERROR: too many event handlers (max %d)\n", p->file.c_str(), kMaxEvents);
+    if (p->has_pacing) {
+        static std::string who;
+        who = "mod:" + p->name;
+        ps3_pacing_req r;
+        r.vblank_hz = p->pacing.vblank_hz;
+        r.flip_hz = p->pacing.flip_hz;
+        r.vsync = p->pacing.vsync;
+        r.max_latency = p->pacing.max_latency;
+        r.who = who.c_str();
+        ps3_pacing_request(&r);
+        fprintf(stderr, "[mods] %s: frame pacing request: vblank %.3f flip %.3f vsync %d latency %d\n",
+                p->file.c_str(), p->pacing.vblank_hz, p->pacing.flip_hz, (int)p->pacing.vsync,
+                (int)p->pacing.max_latency);
+    }
+}
+
+void at_exit_shutdown(void)
+{
+    static std::atomic<int> s_done{0};
+    if (s_done.exchange(1)) return;      /* atexit and ps3mod_host_shutdown() */
+    s_active.store(0, std::memory_order_release);   /* no more PRESENT / VBLANK */
+    fire(PS3MOD_EV_SHUTDOWN, 1);
+    /* Reverse load order. The DLLs stay mapped: guest threads may still be
+     * inside a hook while the process exits. */
+    for (size_t i = s_plugins.size(); i-- > 0;) {
+        plugin* p = s_plugins[i];
+        if (p->state == PLG_ACTIVE && p->shutdown) p->shutdown();
+        p->state = PLG_GONE;
+    }
+}
