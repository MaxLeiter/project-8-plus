+/* Everything but the steady states 0 / 1: first call, and the armed off file
+ * (each calling thread looks at the clock every 256 of its calls). */
+extern "C" int ps3_hle_lean_slow(void)
+{
+    int m = __atomic_load_n(&g_ps3_hle_lean_mode[0], __ATOMIC_RELAXED);
+    if (m < 0) m = hle_trim_init();
+    if (m >= 2) {
+        static PPU_THREAD_LOCAL unsigned t_n;
+        if ((++t_n & 255u) == 0) {
+            hle_trim_poll();
+            m = __atomic_load_n(&g_ps3_hle_lean_mode[0], __ATOMIC_RELAXED);
+        }
+    }
+    return m == 1 || m == 2;
+}
+static inline int hle_lean_now(void)
+{
+    const int m = g_ps3_hle_lean_mode[0];
+    if (__builtin_expect(m == 1, 1)) return 1;
+    if (m == 0) return 0;
+    return ps3_hle_lean_slow();
+}
