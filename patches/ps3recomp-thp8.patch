diff --git a/runtime/ppu/ppu_mod_hooks.cpp b/runtime/ppu/ppu_mod_hooks.cpp
new file mode 100644
index 00000000..b08e121b
--- /dev/null
+++ b/runtime/ppu/ppu_mod_hooks.cpp
@@ -0,0 +1,316 @@
+/*
+ * ps3recomp - opt-in PPU function hooks: dispatcher and registry.
+ *
+ * Compiled only into a mod-capable build. The whole file is behind
+ * PPU_MOD_HOOKS, and it is in no default source list: a port adds it (and
+ * -DPPU_MOD_HOOKS for the lifted chunks and this file) only when it wants
+ * hooks. See ppu_mod_hooks.h for the contract and tools/ppu_lifter.py
+ * (FN_ENTRY_PREAMBLE) for the guard the lifter emits:
+ *
+ *   void func_X(ppu_context* ctx) { PPU_FN_ENTRY(i);
+ *     -> if (function_table_hook_flags[i] && ppu_hook_enter(function_table, i, ctx)) return;
+ *
+ * Chain per hooked function: head -> ... -> terminal link (the original body).
+ * ppu_hook_enter runs the head. ppu_hook_call_next on the terminal link sets a
+ * thread-local pass for exactly that function_table[] entry and calls its
+ * host function; the guard (its first statement) consumes the pass and lets
+ * the body run. Recursion inside the body goes back through the hooks, which
+ * is the PPC semantics of a new entry.
+ */
+#ifdef PPU_MOD_HOOKS
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <algorithm>
+#include <atomic>
+#include <new>
+
+#include "ppu_tls.h"       /* PPU_THREAD_LOCAL */
+#include "ppu_recomp.h"    /* ppu_context, func_entry, function_table[] */
+#include "ppu_mod_hooks.h"
+
+/* Emitted by ppu_lifter.py next to function_table[] (also declared by a
+ * generated ppu_recomp.h built with PPU_MOD_HOOKS; repeated here so this file
+ * states what it links against). */
+extern "C" {
+extern uint8_t        function_table_hook_flags[];
+extern const uint32_t function_table_unguarded[];
+int ppu_hook_enter(const func_entry* table, uint32_t idx, ppu_context* ctx);
+}
+/* Cross-fragment trampoline (ppu_loader.cpp). */
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+
+struct ppu_hook_link {
+    ppu_hook_fn          fn;      /* NULL: terminal link, the original body */
+    void*                user;
+    const ppu_hook_link* next;
+    const func_entry*    entry;   /* the hooked function_table[] entry */
+};
+
+namespace {
+
+struct hook_image {
+    const func_entry*                   table;
+    uint64_t                            count;
+    uint8_t*                            flags;
+    const uint32_t*                     unguarded;  /* 0xFFFFFFFF-terminated */
+    uint32_t*                           by_addr;    /* indices sorted by addr */
+    std::atomic<const ppu_hook_link*>*  heads;      /* [count], lazily */
+};
+
+const int        kMaxImages = 8;
+hook_image       s_images[kMaxImages];
+std::atomic<int> s_nimages{0};
+std::atomic<int> s_lock{0};
+bool             s_frozen = false;
+
+/* call_next -> original body: the entry whose next guard must let it through. */
+PPU_THREAD_LOCAL const func_entry* t_pass = nullptr;
+
+struct lock_guard {
+    lock_guard()  { while (s_lock.exchange(1, std::memory_order_acquire)) {} }
+    ~lock_guard() { s_lock.store(0, std::memory_order_release); }
+};
+
+int add_image_locked(const func_entry* table, uint64_t count, uint8_t* flags,
+                     const uint32_t* unguarded)
+{
+    int n = s_nimages.load(std::memory_order_relaxed);
+    for (int i = 0; i < n; i++)
+        if (s_images[i].table == table) return i;
+    if (n >= kMaxImages || !table || !flags || !count) return PPU_HOOK_E_ARG;
+    uint32_t* by = (uint32_t*)malloc((size_t)count * sizeof(uint32_t));
+    if (!by) return PPU_HOOK_E_NOMEM;
+    for (uint64_t i = 0; i < count; i++) by[i] = (uint32_t)i;
+    std::sort(by, by + count, [table](uint32_t a, uint32_t b) {
+        return table[a].addr < table[b].addr;
+    });
+    hook_image& im = s_images[n];
+    im.table = table; im.count = count; im.flags = flags;
+    im.unguarded = unguarded; im.by_addr = by; im.heads = nullptr;
+    s_nimages.store(n + 1, std::memory_order_release);
+    return n;
+}
+
+void ensure_main_image_locked()
+{
+    if (s_nimages.load(std::memory_order_relaxed) == 0)
+        add_image_locked(function_table, function_table_count,
+                         function_table_hook_flags, function_table_unguarded);
+}
+
+/* guest address -> (image, index); false if it is no function_table[] entry. */
+bool find_entry_locked(uint32_t addr, hook_image** out_im, uint32_t* out_idx)
+{
+    int n = s_nimages.load(std::memory_order_relaxed);
+    for (int k = 0; k < n; k++) {
+        hook_image& im = s_images[k];
+        uint32_t lo = 0, hi = (uint32_t)im.count;
+        while (lo < hi) {
+            uint32_t mid = lo + (hi - lo) / 2;
+            if (im.table[im.by_addr[mid]].addr < addr) lo = mid + 1; else hi = mid;
+        }
+        if (lo < im.count && im.table[im.by_addr[lo]].addr == addr) {
+            *out_im = &im; *out_idx = im.by_addr[lo];
+            return true;
+        }
+    }
+    return false;
+}
+
+bool is_unguarded(const hook_image& im, uint32_t idx)
+{
+    if (!im.unguarded) return false;
+    for (const uint32_t* p = im.unguarded; *p != 0xFFFFFFFFu; p++)
+        if (*p == idx) return true;
+    return false;
+}
+
+hook_image* image_of(const func_entry* table)
+{
+    int n = s_nimages.load(std::memory_order_acquire);
+    for (int k = 0; k < n; k++)
+        if (s_images[k].table == table) return &s_images[k];
+    return nullptr;
+}
+
+} /* namespace */
+
+extern "C" int ppu_hook_available(void) { return 1; }
+
+extern "C" int ppu_hook_add_image(const void* table, uint64_t count, uint8_t* flags,
+                                  const uint32_t* unguarded)
+{
+    lock_guard g;
+    ensure_main_image_locked();
+    int r = add_image_locked((const func_entry*)table, count, flags, unguarded);
+    return r < 0 ? r : PPU_HOOK_OK;
+}
+
+extern "C" int ppu_hook_is_entry(uint32_t guest_addr)
+{
+    lock_guard g;
+    ensure_main_image_locked();
+    hook_image* im; uint32_t idx;
+    return find_entry_locked(guest_addr, &im, &idx) && !is_unguarded(*im, idx);
+}
+
+extern "C" void ppu_hook_freeze(void)
+{
+    lock_guard g;
+    s_frozen = true;
+}
+
+extern "C" int ppu_hook_function(uint32_t guest_addr, ppu_hook_fn fn, void* user)
+{
+    if (!fn) return PPU_HOOK_E_ARG;
+    lock_guard g;
+    if (s_frozen) {
+        fprintf(stderr, "[hooks] refused hook on 0x%08X: registration is frozen\n", guest_addr);
+        return PPU_HOOK_E_FROZEN;
+    }
+    ensure_main_image_locked();
+    hook_image* im; uint32_t idx;
+    if (!find_entry_locked(guest_addr, &im, &idx)) {
+        fprintf(stderr, "[hooks] refused hook on 0x%08X: not a lifted function entry\n", guest_addr);
+        return PPU_HOOK_E_NOT_ENTRY;
+    }
+    if (is_unguarded(*im, idx)) {
+        fprintf(stderr, "[hooks] refused hook on 0x%08X: import stub (no PPU_FN_ENTRY); "
+                        "hook its NID in the HLE table instead\n", guest_addr);
+        return PPU_HOOK_E_UNGUARDED;
+    }
+    if (!im->heads) {
+        im->heads = new (std::nothrow) std::atomic<const ppu_hook_link*>[im->count]();
+        if (!im->heads) return PPU_HOOK_E_NOMEM;
+    }
+    const ppu_hook_link* head = im->heads[idx].load(std::memory_order_relaxed);
+    if (!head) {
+        ppu_hook_link* orig = (ppu_hook_link*)calloc(1, sizeof(ppu_hook_link));
+        if (!orig) return PPU_HOOK_E_NOMEM;
+        orig->entry = &im->table[idx];
+        head = orig;
+    }
+    ppu_hook_link* l = (ppu_hook_link*)calloc(1, sizeof(ppu_hook_link));
+    if (!l) return PPU_HOOK_E_NOMEM;
+    l->fn = fn; l->user = user; l->next = head; l->entry = &im->table[idx];
+    /* Publish the chain, then raise the guard byte. A guard that sees the byte
+     * but not yet the chain finds head == NULL and runs the original body. */
+    im->heads[idx].store(l, std::memory_order_release);
+    im->flags[idx] = 1;
+    fprintf(stderr, "[hooks] hooked %s (0x%08X, index %u)\n",
+            im->table[idx].name ? im->table[idx].name : "?", guest_addr, idx);
+    return PPU_HOOK_OK;
+}
+
+/* Called by PPU_FN_ENTRY only when the function's guard byte is set. */
+extern "C" int ppu_hook_enter(const func_entry* table, uint32_t idx, ppu_context* ctx)
+{
+    const func_entry* e = &table[idx];
+    if (t_pass == e) { t_pass = nullptr; return 0; }   /* call_next: run the body */
+    hook_image* im = image_of(table);
+    if (!im || !im->heads || idx >= im->count) return 0;
+    const ppu_hook_link* h = im->heads[idx].load(std::memory_order_acquire);
+    if (!h || !h->fn) return 0;
+    h->fn((struct ppu_context*)ctx, h->next, h->user, (uint32_t)ctx->lr);
+    return 1;
+}
+
+extern "C" void ppu_hook_call_next(struct ppu_context* c, const ppu_hook_link* next)
+{
+    ppu_context* ctx = (ppu_context*)c;
+    if (!next) return;
+    if (next->fn) {
+        next->fn(c, next->next, next->user, (uint32_t)ctx->lr);
+        return;
+    }
+    /* Terminal link: the original body. Its guard consumes t_pass. */
+    t_pass = next->entry;
+    next->entry->func(ctx);
+    t_pass = nullptr;
+    /* Run the tail calls the body left pending, so a post-hook sees final
+     * results (the caller's DRAIN_TRAMPOLINE would otherwise run them after
+     * the hook returned). */
+    while (g_trampoline_fn) {
+        void (*tf)(void*) = g_trampoline_fn;
+        g_trampoline_fn = nullptr;
+        tf((void*)ctx);
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* PPU_HOOK_TRACE self-test: pass-through wraps that log their first entries. */
+
+namespace {
+
+struct trace_rec {
+    uint32_t              addr;
+    std::atomic<uint64_t> hits;
+};
+trace_rec* s_trace     = nullptr;
+int        s_ntrace    = 0;
+uint64_t   s_trace_max = 1;
+
+void trace_hook(struct ppu_context* c, const ppu_hook_link* next, void* user, uint32_t lr)
+{
+    ppu_context* ctx = (ppu_context*)c;
+    trace_rec* t = (trace_rec*)user;
+    uint64_t n = t->hits.fetch_add(1, std::memory_order_relaxed);
+    if (n < s_trace_max)
+        fprintf(stderr, "[hooks] trace func_%08X #%llu enter lr=0x%08X r1=0x%llX r3=0x%llX r4=0x%llX thread=%llu\n",
+                t->addr, (unsigned long long)n, lr, (unsigned long long)ctx->gpr[1],
+                (unsigned long long)ctx->gpr[3], (unsigned long long)ctx->gpr[4],
+                (unsigned long long)ctx->thread_id);
+    ppu_hook_call_next(c, next);
+    if (n < s_trace_max)
+        fprintf(stderr, "[hooks] trace func_%08X #%llu return r3=0x%llX\n",
+                t->addr, (unsigned long long)n, (unsigned long long)ctx->gpr[3]);
+}
+
+void trace_report(void)
+{
+    static std::atomic<int> s_done{0};
+    if (s_done.exchange(1)) return;      /* atexit and ps3mod_host_shutdown() */
+    for (int i = 0; i < s_ntrace; i++)
+        fprintf(stderr, "[hooks] trace func_%08X: %llu entries\n", s_trace[i].addr,
+                (unsigned long long)s_trace[i].hits.load(std::memory_order_relaxed));
+}
+
+void init_from_env(void)
+{
+    const char* spec = getenv("PPU_HOOK_TRACE");
+    if (!spec || !*spec) return;
+    if (const char* m = getenv("PPU_HOOK_TRACE_MAX")) s_trace_max = strtoull(m, nullptr, 0);
+    int cap = 1;
+    for (const char* p = spec; *p; p++) if (*p == ',' || *p == ' ') cap++;
+    s_trace = new (std::nothrow) trace_rec[cap];
+    if (!s_trace) return;
+    const char* p = spec;
+    while (*p) {
+        while (*p == ',' || *p == ' ') p++;
+        if (!*p) break;
+        char* end = nullptr;
+        unsigned long long a = strtoull(p, &end, 16);
+        if (end == p) { p++; continue; }
+        p = end;
+        trace_rec& t = s_trace[s_ntrace];
+        t.addr = (uint32_t)a;
+        t.hits.store(0, std::memory_order_relaxed);
+        if (ppu_hook_function(t.addr, trace_hook, &t) == PPU_HOOK_OK) s_ntrace++;
+    }
+    if (s_ntrace) atexit(trace_report);
+}
+
+/* function_table[] is constant-initialized, so it is valid during dynamic
+ * initialization; the trace hooks are in place before main() runs. */
+struct env_init { env_init() { init_from_env(); } } s_env_init;
+
+} /* namespace */
+
+/* Host exit paths that end in ExitProcess (window close) skip atexit: flush the
+ * PPU_HOOK_TRACE report from there (idempotent). */
+extern "C" void ppu_hook_trace_flush(void) { trace_report(); }
+
+#endif /* PPU_MOD_HOOKS */
diff --git a/runtime/ppu/ppu_mod_hooks.h b/runtime/ppu/ppu_mod_hooks.h
new file mode 100644
index 00000000..1cac56f5
--- /dev/null
+++ b/runtime/ppu/ppu_mod_hooks.h
@@ -0,0 +1,108 @@
+/*
+ * ps3recomp - opt-in PPU function hooks (runtime side of PPU_FN_ENTRY)
+ *
+ * The lifter opens every lifted function (HLE import stubs excepted) with
+ * PPU_FN_ENTRY(i), i = its index in function_table[]. The macro is empty in a
+ * normal build. Built with -DPPU_MOD_HOOKS it tests one byte,
+ * function_table_hook_flags[i], and a hooked entry calls ppu_hook_enter()
+ * (ppu_mod_hooks.cpp), which runs the hook chain for that function. Since the
+ * guard is the function's first statement, a hook sees every way in: direct
+ * bl, tail call / trampoline, ps3_indirect_call (bctrl, vtables, OPDs),
+ * thread entry and guest callbacks.
+ *
+ * Hooks are registered by GUEST ADDRESS; the runtime maps the address to the
+ * function_table[] index. The address must be a lifted function entry
+ * (function_table[] .addr), not an import stub (hook those by NID in the HLE
+ * table instead).
+ *
+ * Hook contract
+ *   void hook(ctx, next, user, entry_lr)
+ *     entry_lr  ctx->lr at entry. For a direct `bl` it is the call site + 4, so
+ *               "only when called from S" is `entry_lr == S + 4`.
+ *     WRAP      edit arguments (r3..r10, f1..f13), call
+ *               ppu_hook_call_next(ctx, next), then edit results (r3 / f1 /
+ *               memory). call_next runs the next hook, or the original body
+ *               and every tail call it left pending, so r3/f1 are final when
+ *               it returns. ctx->lr must still be entry_lr when calling next
+ *               (the original saves it as its return address).
+ *     REPLACE   do not call next. Produce the results yourself and preserve the
+ *               PPC64 ELF non-volatiles: r1, r2, r13, r14-r31, f14-f31,
+ *               v20-v31, CR2-CR4. A replace hook may leave g_trampoline_fn set
+ *               (a tail call); the caller's DRAIN_TRAMPOLINE runs it.
+ *     Single-precision results are stored as (double)(float)x, like the lifted
+ *     fmuls/frsp.
+ *   Several hooks on one function form a chain; the one registered last runs
+ *   first (it wraps the earlier ones).
+ *
+ * Registration is meant for start-up (before ppu_run); ppu_hook_freeze() closes
+ * it. A late registration is still safe: the flag byte is set after the chain
+ * is published, and a guard that sees the flag before the chain just runs the
+ * original body.
+ *
+ * Diagnostics / self-test (PPU_MOD_HOOKS builds):
+ *   PPU_HOOK_TRACE=0x0069A11C[,0x...]  install a pass-through wrap hook on each
+ *       address that logs its first PPU_HOOK_TRACE_MAX (default 1) entries and
+ *       returns, and prints each address's entry count at exit.
+ *
+ * Without PPU_MOD_HOOKS this header only provides inline stubs that report
+ * PPU_HOOK_E_UNAVAILABLE, so a caller compiles in both builds and nothing of
+ * the mechanism is compiled or linked into the default build.
+ */
+#ifndef PS3RECOMP_PPU_MOD_HOOKS_H
+#define PS3RECOMP_PPU_MOD_HOOKS_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ppu_context;
+typedef struct ppu_hook_link ppu_hook_link;   /* opaque: rest of the chain */
+typedef void (*ppu_hook_fn)(struct ppu_context* ctx, const ppu_hook_link* next,
+                            void* user, uint32_t entry_lr);
+
+enum {
+    PPU_HOOK_OK            =  0,
+    PPU_HOOK_E_UNAVAILABLE = -1,  /* built without PPU_MOD_HOOKS */
+    PPU_HOOK_E_NOT_ENTRY   = -2,  /* address is not a function_table[] entry */
+    PPU_HOOK_E_UNGUARDED   = -3,  /* entry has no PPU_FN_ENTRY (import stub) */
+    PPU_HOOK_E_FROZEN      = -4,  /* ppu_hook_freeze() was called */
+    PPU_HOOK_E_NOMEM       = -5,
+    PPU_HOOK_E_ARG         = -6
+};
+
+#ifdef PPU_MOD_HOOKS
+
+/* 1: this build has the PPU_FN_ENTRY guards and the dispatcher. */
+int  ppu_hook_available(void);
+/* Add a hook to the function whose entry is guest_addr. */
+int  ppu_hook_function(uint32_t guest_addr, ppu_hook_fn fn, void* user);
+/* Run the rest of the chain (next hook, or the original body + pending tail
+ * calls). Call it at most once per hook invocation; never for a replace. */
+void ppu_hook_call_next(struct ppu_context* ctx, const ppu_hook_link* next);
+/* 1 if guest_addr can be hooked (a guarded function_table[] entry). */
+int  ppu_hook_is_entry(uint32_t guest_addr);
+/* Close registration (call before ppu_run). */
+void ppu_hook_freeze(void);
+/* Register a second lifted image (e.g. a --symbol-prefix PRX lift): its
+ * <prefix>function_table, _count, _hook_flags and _unguarded. The main image
+ * (unprefixed function_table) is registered automatically. */
+int  ppu_hook_add_image(const void* table, uint64_t count, uint8_t* flags,
+                        const uint32_t* unguarded);
+
+#else  /* !PPU_MOD_HOOKS: nothing of the mechanism exists in this build */
