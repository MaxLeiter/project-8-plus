+/* PS3_TICKER_CORE (perf round): the vblank_ticker walks the FIFO, translates every draw and presents -- it is
+ * THE frame-rate limit (one thread, 0-1 % idle in free skate). With ~7 busy game threads plus whatever else
+ * runs on the PC, Windows often puts another busy thread on its hyper-threading sibling, which costs the ticker
+ * a large share of its core. Here the ticker gets a physical core of its own: CPU sets (Windows 10+) pin it to
+ * one logical processor of the highest-numbered core with two, and the process default CPU sets keep every other
+ * thread of the game (guest threads, SPU workers, driver threads) off both logical processors of that core. Other
+ * processes are not affected. Priority: PS3_TICKER_PRIO = normal | above (default) | highest.
+ * OPT-IN: PS3_TICKER_CORE=1 enables it (default off: worth only +1-2 % on a quiet PC, and on a loaded one the
+ * fenced-off core plus the ABOVE_NORMAL ticker starved the boosted Bink audio thread -> audio dropouts; several
+ * instances would also all pick the same core). Live: PS3_TICKER_CORE_OFF_FILE=<path> (checked about once a
+ * second, reverts / reapplies). No CPU sets API or a CPU without SMT: nothing changes. */
+#ifdef _WIN32   /* CPU sets are a Windows API; other hosts get a no-op poll */
+namespace {
+struct ps3_cpuset {
+    DWORD Size; DWORD Type;
+    DWORD Id; WORD Group; BYTE LogicalProcessorIndex; BYTE CoreIndex; BYTE LastLevelCacheIndex;
+    BYTE NumaNodeIndex; BYTE EfficiencyClass; BYTE AllFlags; DWORD Reserved; unsigned long long AllocationTag;
+};
+typedef BOOL (WINAPI* fn_GetSystemCpuSetInformation)(void*, ULONG, PULONG, HANDLE, ULONG);
+typedef BOOL (WINAPI* fn_SetThreadSelectedCpuSets)(HANDLE, const ULONG*, ULONG);
+typedef BOOL (WINAPI* fn_SetProcessDefaultCpuSets)(HANDLE, const ULONG*, ULONG);
+struct ticker_sched {
+    int init = 0, enabled = 0, applied = 0, prio = THREAD_PRIORITY_ABOVE_NORMAL;
+    const char* off_file = nullptr;
+    ULONGLONG next_poll = 0;
+    fn_SetThreadSelectedCpuSets set_thread = nullptr;
+    fn_SetProcessDefaultCpuSets set_process = nullptr;
+    ULONG ticker_id = 0, others[256]; ULONG n_others = 0;
+};
+ticker_sched g_tsched;
+
+void ticker_sched_apply(int on)
+{
+    ticker_sched& s = g_tsched;
+    if (on == s.applied) return;
+    if (on) {
+        s.set_process(GetCurrentProcess(), s.others, s.n_others);
+        s.set_thread(GetCurrentThread(), &s.ticker_id, 1);
+        SetThreadPriority(GetCurrentThread(), s.prio);
+    } else {
+        s.set_thread(GetCurrentThread(), nullptr, 0);
+        s.set_process(GetCurrentProcess(), nullptr, 0);
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_NORMAL);
+    }
+    s.applied = on;
+    fprintf(stderr, "[ticker-core] %s\n", on ? "ticker on its own physical core" : "off (default placement)");
+}
+
+/* Called from the ticker thread: once at start, then every loop (cheap; polls the off file ~1/s). */
+void ticker_sched_poll(void)
+{
+    ticker_sched& s = g_tsched;
+    if (!s.init) {
+        s.init = 1;
+        const char* e = getenv("PS3_TICKER_CORE");
+        if (!e || e[0] != '1') { fprintf(stderr, "[ticker-core] off (opt-in: PS3_TICKER_CORE=1)\n"); return; }
+        const char* p = getenv("PS3_TICKER_PRIO");
+        if (p && !_stricmp(p, "normal")) s.prio = THREAD_PRIORITY_NORMAL;
+        else if (p && !_stricmp(p, "highest")) s.prio = THREAD_PRIORITY_HIGHEST;
+        s.off_file = getenv("PS3_TICKER_CORE_OFF_FILE");
+        HMODULE k = GetModuleHandleA("kernel32.dll");
+        fn_GetSystemCpuSetInformation get = k ? (fn_GetSystemCpuSetInformation)(void*)GetProcAddress(k, "GetSystemCpuSetInformation") : nullptr;
+        s.set_thread = k ? (fn_SetThreadSelectedCpuSets)(void*)GetProcAddress(k, "SetThreadSelectedCpuSets") : nullptr;
+        s.set_process = k ? (fn_SetProcessDefaultCpuSets)(void*)GetProcAddress(k, "SetProcessDefaultCpuSets") : nullptr;
+        if (!get || !s.set_thread || !s.set_process) { fprintf(stderr, "[ticker-core] no CPU sets API: off\n"); return; }
+        ULONG len = 0;
+        get(nullptr, 0, &len, GetCurrentProcess(), 0);
+        if (!len || len > (1u << 20)) { fprintf(stderr, "[ticker-core] no CPU set information: off\n"); return; }
+        unsigned char* buf = (unsigned char*)malloc(len);
+        if (!buf || !get(buf, len, &len, GetCurrentProcess(), 0)) { free(buf); fprintf(stderr, "[ticker-core] GetSystemCpuSetInformation failed: off\n"); return; }
+        /* group 0 only; per core: the logical processors' ids */
+        ULONG ids[256]; BYTE core[256]; ULONG n = 0;
+        for (ULONG off = 0; off + 8 <= len && n < 256; ) {
+            const ps3_cpuset* c = (const ps3_cpuset*)(buf + off);
+            if (!c->Size) break;
+            if (c->Type == 0 /* CpuSetInformation */ && c->Group == 0) { ids[n] = c->Id; core[n] = c->CoreIndex; n++; }
+            off += c->Size;
+        }
+        free(buf);
+        int best = -1, best_lp = -1;
+        for (ULONG i = 0; i < n; i++) {        /* highest core index that has two logical processors */
+            int cnt = 0, first = -1;
+            for (ULONG j = 0; j < n; j++) if (core[j] == core[i]) { cnt++; if (first < 0) first = (int)j; }
+            if (cnt >= 2 && (best < 0 || core[i] > best)) { best = core[i]; best_lp = first; }
+        }
+        if (best < 0 || n < 8) { fprintf(stderr, "[ticker-core] no SMT core to reserve (%lu logical processors): off\n", n); return; }
+        s.ticker_id = ids[best_lp];
+        for (ULONG i = 0; i < n; i++) if (core[i] != (BYTE)best) s.others[s.n_others++] = ids[i];
+        s.enabled = 1;
+        fprintf(stderr, "[ticker-core] core %d reserved for the ticker (cpu set %lu); %lu logical processors for the rest; "
+                        "priority %d%s\n", best, s.ticker_id, s.n_others, s.prio, s.off_file ? "; live off file" : "");
+        ticker_sched_apply(1);
+        return;
+    }
+    if (!s.enabled || !s.off_file) return;
+    const ULONGLONG now = GetTickCount64();
+    if (now < s.next_poll) return;
+    s.next_poll = now + 1000;
+    const int off = GetFileAttributesA(s.off_file) != INVALID_FILE_ATTRIBUTES;
+    ticker_sched_apply(!off);
+}
+}  // namespace
+#else
+namespace { void ticker_sched_poll(void) {} }
+#endif
+
+#if defined(PS3_WASM)
+/* PS3_TICKER_STATS=<s>: where the ticker's time goes (FIFO drain, presents, idle waits), every <s> seconds.
+ * Browser build only for now (NATIVE CANDIDATE: diagnostic; natively the wrappers below are the plain calls). */
+static long long s_tk_us[3], s_tk_n[3], s_tk_t0; static int s_tk_sec = -1;
+static void tk_note(int k, long long t0) { if (s_tk_sec > 0) { s_tk_us[k] += frame_trace_now_us() - t0; s_tk_n[k]++; } }
+static void tk_fifo(void) { const long long t = s_tk_sec > 0 ? frame_trace_now_us() : 0; cellGcm_rsx_process_fifo(); tk_note(0, t); }
+static void tk_present(void) { const long long t = s_tk_sec > 0 ? frame_trace_now_us() : 0; present_guest_frame(); tk_note(1, t); }
+static void tk_idle(unsigned ms) { const long long t = s_tk_sec > 0 ? frame_trace_now_us() : 0; cellGcm_fifo_kick_wait(ms); tk_note(2, t); }
+static void tk_report(void)
+{
+    if (s_tk_sec < 0) { const char* e = getenv("PS3_TICKER_STATS"); s_tk_sec = e ? atoi(e) : 0; s_tk_t0 = frame_trace_now_us(); }
+    if (s_tk_sec <= 0) return;
+    const long long now = frame_trace_now_us();
+    if (now - s_tk_t0 < (long long)s_tk_sec * 1000000) return;
+    fprintf(stderr, "[ticker] %ds: fifo %lld ms (%lld drains)  present %lld ms (%lld)  idle %lld ms (%lld)  other %lld ms\n", s_tk_sec,
+            s_tk_us[0] / 1000, s_tk_n[0], s_tk_us[1] / 1000, s_tk_n[1], s_tk_us[2] / 1000, s_tk_n[2],
+            (now - s_tk_t0 - s_tk_us[0] - s_tk_us[1] - s_tk_us[2]) / 1000);
+    for (int i = 0; i < 3; i++) s_tk_us[i] = s_tk_n[i] = 0;
+    s_tk_t0 = now;
+}
+#else
+#define tk_fifo()    cellGcm_rsx_process_fifo()
+#define tk_present() present_guest_frame()
+#define tk_idle(ms)  cellGcm_fifo_kick_wait(ms)
+#define tk_report()  ((void)0)
+#endif
+
+static DWORD WINAPI vblank_ticker(LPVOID)
+{
+    /* Window caption: $PS3_TITLE wins, else the TITLE field PARAM.SFO already
+     * gave cellGame, else a neutral name. It used to fall back to a specific
+     * other title, so every port announced itself as that game. */
+    const char* _title = getenv("PS3_TITLE");
+    if (!_title || !*_title) {
+        const char* sfo = cellGame_get_title();
+        if (sfo && *sfo && strcmp(sfo, "Unknown Title") != 0) _title = sfo;
+    }
+    if (!_title || !*_title) _title = "ps3recomp";
+    /* The live engine's RT-as-backbuffer rescue only treats a surface as the
+     * backbuffer when its clip EQUALS the backend size, so a title that renders
+     * into something other than 1280x720 must say so: RSX_W / RSX_H. */
+    uint32_t rsx_w = 1280, rsx_h = 720;
+    if (const char* e = getenv("RSX_W")) rsx_w = (uint32_t)strtoul(e, 0, 0);
+    if (const char* e = getenv("RSX_H")) rsx_h = (uint32_t)strtoul(e, 0, 0);
+    int rsx_ok;
+    if (rsx_live_draw_enabled()) {
+        rsx_ok = (rsx_null_backend_init(rsx_w, rsx_h, _title) == 0);
+        if (rsx_ok && rsx_live_draw_init(rsx_null_backend_get_hwnd(), rsx_w, rsx_h,
+                                         rsx_live_guest_ptr, nullptr) == 0) {
+            s_rsx_live = 1;
+            rsx_null_backend_suppress_present(1);
+            fprintf(stderr, "[rsx] live-draw engine up (D3D12); GDI present suppressed\n");
+        } else {
+            fprintf(stderr, "[rsx] live-draw init FAILED -- falling back to the D3D12 backend\n");
+            rsx_ok = (rsx_backend_init(rsx_w, rsx_h, _title) == 0);
+        }
+    } else {
+        rsx_ok = (rsx_backend_init(rsx_w, rsx_h, _title) == 0);
+    }
+    fprintf(stderr, "[rsx] backend init %s\n", rsx_ok ? "OK -- window open" : "FAILED");
+#ifdef PPU_MOD_HOOKS
+    /* plugins: window + render size for get_display, PS3MOD_EV_DISPLAY_READY */
+    if (rsx_ok) ps3mod_host_display_ready(s_rsx_live ? rsx_null_backend_get_hwnd() : nullptr, rsx_w, rsx_h);
+#endif
+    if (rsx_ok && s_rsx_live) {
+        struct P { static void present() { present_guest_frame(); }
+                   static int pump() { return rsx_pump_messages(); } };
+        cellGcm_set_par_hooks(&P::present, &P::pump);
+    }
+    unsigned last_flip = 0;
+    /* Decoupled pacing (libs/video/host_pacing.h: PS3_VBLANK_HZ / PS3_FLIP_HZ, or
+     * a mod's set_pacing): a clock thread of its own ticks the guest vblank and
+     * the flip completions and kicks this thread, which then only presents and
+     * walks the FIFO. Otherwise the legacy 16 ms ticks below, unchanged. */
+    const int paced = ps3_pacing_active();
+    unsigned long long paced_vblanks_seen = 0;
+    if (paced) {
+        void* hwnd = s_rsx_live ? rsx_null_backend_get_hwnd() : nullptr;
+#ifdef _WIN32
+        if (!hwnd) {   /* the D3D12 / null backends created their window on this thread */
+            struct F { static BOOL CALLBACK pick(HWND h, LPARAM lp)
+                       { if (IsWindowVisible(h) && !GetParent(h)) { *(HWND*)lp = h; return FALSE; } return TRUE; } };
+            HWND h = NULL; EnumThreadWindows(GetCurrentThreadId(), F::pick, (LPARAM)&h); hwnd = h;
+        }
+#endif
+        ps3_pacing_start(hwnd);
+    }
+    /* The game's frame pacing (vblank/flip handlers -> display frame counter) must
+     * advance at ~60Hz regardless of how long present() blocks. On a hidden/occluded
+     * window DXGI Present throttles hard, which previously stalled these ticks and
+     * paced the game's main loop to ~0.5fps. Drive the ticks off REAL elapsed time
+     * and catch up in a bounded burst so present latency never slows the game. */
+    ULONGLONG next_tick = GetTickCount64();
+    ticker_sched_poll();   /* PS3_TICKER_CORE */
+    for (;;) {
+        ticker_sched_poll();
+        ULONGLONG now;
+        int fired = 0;
+        if (paced) {
+            /* Woken by every vblank / flip tick, by a guest waiting on a fence or a
+             * flip, else after 2 ms. Plugin vblank events stay on this thread. */
+            { FT_T0(ft_w0); tk_idle(2); FT_ADD(FT_TICKER_IDLE_US, FT_SINCE(ft_w0)); tk_report(); }
+            now = GetTickCount64();
+            const unsigned long long vb = ps3_pacing_vblanks();
+            while (paced_vblanks_seen < vb && fired < 8) {
+#ifdef PPU_MOD_HOOKS
+                ps3mod_host_vblank();    /* plugins: PS3MOD_EV_VBLANK / RESIZE */
+#endif
+                paced_vblanks_seen++; fired++;
+            }
+            paced_vblanks_seen = vb;
+        } else {
+        /* Was Sleep(4). The FIFO kick event existed, was signalled on a dry
+         * fence queue, and had no waiter -- so a guest starved for `get` or a
+         * fence still paid the whole tick. Waiting on it keeps the same 4 ms
+         * ceiling when nothing kicks, and drains on demand when something
+         * does. */
+        { FT_T0(ft_w0); tk_idle(4); FT_ADD(FT_TICKER_IDLE_US, FT_SINCE(ft_w0)); tk_report(); }
+        now = GetTickCount64();
+        while ((long long)(now - next_tick) >= 0 && fired < 240) {
+            ps3_pacing_note_vblank();    /* [pace] stats only */
+            cellGcmTickVBlank();
+#ifdef PPU_MOD_HOOKS
+            ps3mod_host_vblank();    /* plugins: PS3MOD_EV_VBLANK / RESIZE */
+#endif
+            cellGcmTickFlip();
+            /* Present a pending flip BEFORE draining further: the flip fires
+             * at a get==put frame boundary (guest thread), so the batch held
+             * right now is exactly the completed frame. Presenting on a raw
+             * flip-count change after the drain raced the guest's next-frame
+             * writes and showed empty or mixed batches. */
+            {
+                if (rsx_ok && !cellGcm_par_owns_present() && cellGcm_take_flip_pending()) {
+                    tk_present();
+                    last_flip = cellGcm_flip_request_count();
+                }
+            }
+            /* Drain the game's GCM FIFO every tick -- this writes the RSX sync-fence
+             * labels (e.g. @0x03000410) that the game's per-frame logic blocks on.
+             * Doing it here (not after present) keeps those fences advancing at 60Hz
+             * even when present() throttles on a hidden/occluded window. */
+            if (rsx_ok) tk_fifo();
+            next_tick += 16;                 /* ~60 Hz */
+            fired++;
+        }
+        if (fired >= 240) next_tick = now;   /* fell too far behind -> resync */
+        }   /* !paced */
+        /* Drain at the outer ~4ms cadence too (not just the 16ms tick):
+         * titles fence EVERY render pass on an RSX label the drain writes;
+         * at 16ms per fence wave's six passes paced the guest to ~7 fps.
+         * The real RSX writes those fences in microseconds. */
+        if (rsx_ok) {
+            if (!cellGcm_par_owns_present() && cellGcm_take_flip_pending()) {
+                tk_present();
+                last_flip = cellGcm_flip_request_count();
+            }
+            tk_fifo();
+        }
+        /* YDKJ_INJECT_Q3: the main thread polls q3 (load/state-complete) each frame but
+         * it's never posted (producer signals a condvar, never enqueues). Inject a q3
+         * event periodically to test whether delivering the completion advances the
+         * game's state machine to instantiate + display the (force-parsed) menu movie. */
+        /* Per-iteration gates, read once (the ticker loops hundreds of times a
+         * second; the environment does not change after startup). */
+        static const char* s_inject_q3 = (const char*)-1;
+        static int s_pacetrace = -1;
+        if (s_inject_q3 == (const char*)-1) s_inject_q3 = getenv("YDKJ_INJECT_Q3");
+        if (s_pacetrace < 0) s_pacetrace = getenv("YDKJ_PACETRACE") ? 1 : 0;
+        if (s_inject_q3) {
+            static int s_q3=0; const char* qe=s_inject_q3; uint32_t qid=(uint32_t)strtoul(qe,0,0); if(qid==0||qid==1) qid=3;
+            if(++s_q3 % 8 == 0){ int r=sys_event_queue_inject(qid, 0x1234, 0, 0, 0);
+              static int _n=0; if(_n++<12) fprintf(stderr,"[INJQ3] injected q%u event rc=%d\n",qid,r); } }
+        /* Window closed: the grace period for the title's own exit path ran out. Never in the middle of
+         * a save: while cellSaveData writes one the deadline moves on (up to PS3_EXIT_SAVE_WAIT_MS, default
+         * 60000, after the grace); the write itself is crash-safe (tmp file + rename), this keeps the
+         * new save from being dropped. */
+        if (s_exit_deadline && GetTickCount64() >= s_exit_deadline && cellSaveData_busy() > 0) {
+            static ULONGLONG s_save_wait_end = 0;
+            if (!s_save_wait_end) {
+                const char* w = getenv("PS3_EXIT_SAVE_WAIT_MS");
+                s_save_wait_end = GetTickCount64() + (w ? strtoull(w, 0, 0) : 60000ull);
+                fprintf(stderr, "[boot] window closed: a save is being written -- waiting for it before exiting\n");
+            }
+            if (GetTickCount64() < s_save_wait_end) s_exit_deadline = GetTickCount64() + 100;
+        }
+        if (s_exit_deadline && GetTickCount64() >= s_exit_deadline) {
+            fprintf(stderr, "[boot] window closed: title did not exit within the grace period -- exiting\n");
+#ifdef PPU_MOD_HOOKS
+            ps3mod_host_shutdown();   /* ExitProcess skips atexit: plugin shutdown now */
+#endif
+            rsx_live_draw_save_pipelines();
+            fflush(stdout); fflush(stderr);
+            ExitProcess(0);
+        }
+        if (rsx_ok) {
+            if (rsx_pump_messages() != 0 && !s_exit_requested) {
+                s_exit_requested = 1;
+                /* The live backend only HIDES its window on close
+                 * (rsx_null_backend.c null_window_close): keep draining and
+                 * presenting so the title's frame loop -- and with it its exit
+                 * handler -- keeps running. Anything else destroyed its window. */
+                if (!(s_rsx_live && rsx_null_backend_window_hidden())) rsx_ok = 0;
+                /* Window closed / ESC = the console's "Quit Game": post
+                 * CELL_SYSUTIL_REQUEST_EXITGAME to the title's sysutil callbacks so it
+                 * can finish a save, clean up and call sys_process_exit itself (THP8
+                 * handles it at 0x614FE8). This used to just stop rendering and leave
+                 * the guest running headless until it was killed. No registered
+                 * callback -> nothing can observe the request: exit now. Otherwise
+                 * exit after PS3_EXIT_GRACE_MS (default 10000, 0 = never) in case the
+                 * title cannot get there (its frame loop may wait on GPU fences that
+                 * nothing drains once the window is gone). */
+                int slots = ps3_sysutil_request_exit_game();
+                const char* g = getenv("PS3_EXIT_GRACE_MS");
+                unsigned grace = g ? (unsigned)strtoul(g, 0, 0) : 10000u;
+                fprintf(stderr, "[boot] window closed: REQUEST_EXITGAME -> %d callback slot(s), grace %u ms\n",
+                        slots, grace);
+#ifdef PPU_MOD_HOOKS
+                if (slots == 0) ps3mod_host_shutdown();
+#endif
+                if (slots == 0) { rsx_live_draw_save_pipelines(); fflush(stdout); fflush(stderr); ExitProcess(0); }
+                if (grace) s_exit_deadline = GetTickCount64() + grace;
+            }
+            if (s_pacetrace) {
+                static ULONGLONG s_win=0; static int s_pf=0, s_pres=0; static ULONGLONG s_presms=0;
+                s_pf += fired; s_pres++;
+                ULONGLONG t0=GetTickCount64(); rsx_present_frame(); ULONGLONG t1=GetTickCount64();
+                s_presms += (t1-t0);
+                if (s_win==0) s_win=now;
+                if (now - s_win >= 1000) {
+                    fprintf(stderr,"[PACE] process_fifo=%d/s  present=%d/s  present_total=%llums/s (avg %llums)\n",
+                            s_pf, s_pres, s_presms, s_pres? s_presms/s_pres:0);
+                    s_pf=0; s_pres=0; s_presms=0; s_win=now;
+                }
+            } else {
+                /* Present only on a guest flip (frame boundary). A fixed-clock
+                 * present can catch the drain mid-frame -- notably while the
+                 * guest is blocked in the FIFO-wrap recycle callback -- and
+                 * flash a partial frame (clear + a few draws). Before the
+                 * first flip present freely so the window isn't stuck white
+                 * during boot. */
+                unsigned fc = cellGcm_flip_request_count();
+                if (cellGcm_par_owns_present()) {
+                    last_flip = fc;   /* the translation thread presented it */
+                } else if (fc != last_flip || fc == 0) {
+                    /* The drain that raised the count also set the pending
+                     * flag. Consume it with this present: left set, the next
+                     * loop's take_flip_pending() presented the SAME buffer a
+                     * second time (THP8 gameplay: ~30% of all presents were
+                     * such duplicates -- an extra GPU-idle flush + vsync
+                     * Present on this thread, and an [fps]/title count ~1.4x
+                     * the real flip rate). PS3_DUP_PRESENT=1 = old behaviour. */
+                    static int dup_present = -1;
+                    if (dup_present < 0) dup_present = getenv("PS3_DUP_PRESENT") ? 1 : 0;
+                    if (fc) {
+                        if (!dup_present) (void)cellGcm_take_flip_pending();
+                        tk_present();
+                    } else if (!paced || fired) rsx_present_frame();   /* boot: once per vblank */
+                    last_flip = fc;
+                } else if (fc == 0) {
+                    rsx_backend_present();
+                }
+            }
+        }
+    }
+    return 0;
+}
+
+extern "C" uint32_t    g_last_hle_nid;
+extern "C" const char* g_last_hle_name;
+
+#if defined(PS3_WASM) && defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+extern "C" const char* g_hle_inflight[];   /* ppu_hle.cpp; 64 entries */
+extern "C" void ppu_report_guest_lrs(void); /* ppu_loader.cpp */
+/* The browser cannot snapshot threads: the page calls this instead (ps3dump() in the console, web/host/boot.js).
+ * It only reads breadcrumbs, so any thread may run it. */
+extern "C" EMSCRIPTEN_KEEPALIVE void ps3_web_dump(void)
+{
+    fprintf(stderr, "[dump] last HLE call = 0x%08X (%s)\n", g_last_hle_nid, g_last_hle_name ? g_last_hle_name : "");
+    for (unsigned t = 0; t < 64u; t++)
+        if (g_hle_inflight[t]) fprintf(stderr, "[dump]   guest-tid %-3u inside %s\n", t, g_hle_inflight[t]);
+    ppu_report_guest_lrs();
+}
+#endif
+
+/* Windows-only from here to the end of hang_watchdog. Snapshotting every
+ * OTHER thread and reading its instruction pointer needs tlhelp32 plus
+ * SuspendThread/GetThreadContext; POSIX has no equivalent that does not
+ * amount to writing a debugger. The vblank ticker above, which is what the
+ * frame loop actually depends on, is deliberately outside this. */
+#ifdef _WIN32
+#include <tlhelp32.h>
+/* When the boot wedges, snapshot every other thread's instruction pointer as a
+ * module RVA (symbolize with llvm-symbolizer) so a guest spin/wait is pinned to
+ * an exact lifted function -- the HLE breadcrumb only covers HLE calls. */
+/* Snapshot every other thread's RIP. For threads in the boot module (lifted
+ * guest code) print the RVA (symbolizable) + a couple of stack-return RVAs;
+ * for threads parked in a DLL (OS waits / FMOD) print the module name so they
+ * are not mistaken for guest spins. Called twice so the caller can diff which
+ * guest thread is genuinely parked (same RIP) vs. still progressing. */
+/* Defined with the debug console below; writes to stderr and, when the
+ * console is servicing a command, also to its response file. */
+static void dbg_printf(const char* fmt, ...);
+/* While dump_threads holds a thread suspended, dbg_printf formats into this
+ * buffer instead of a stream: the suspended thread may own stderr's CRT lock,
+ * and writing then deadlocks the watchdog -- and with it every thread that
+ * logs. GH3 froze solid (0% CPU, log silent mid-boot) exactly that way. */
+static PS3_TLS char   s_dbg_capbuf[16384];
+static PS3_TLS char*  s_dbg_cap = NULL;
+static PS3_TLS size_t s_dbg_capn = 0;
+
+extern "C" const char* g_hle_inflight[];   /* ppu_hle.cpp; 64 entries */
+extern "C" void ppu_report_guest_lrs(void); /* ppu_loader.cpp */
+
+static void dump_threads(const char* label, HMODULE self)
+{
+    dbg_printf( "[WATCHDOG] %s; last HLE call = 0x%08X (%s)\n",
+            label, g_last_hle_nid, g_last_hle_name ? g_last_hle_name : "");
+
+    /* Which HLE each guest thread is INSIDE right now.
+     *
+     * ppu_hle.cpp has maintained this array for a while and nothing ever read
+     * it. It is the only way to see a thread parked in an HLE wait:
+     * sys_lwmutex_lock and sys_lwcond_wait are sysPrxForUser handlers, not lv2
+     * syscalls, so PS3_SCBLOCK_PROF cannot see them block, the usleep
+     * histogram cannot see them (they do not usleep), and the sampler just
+     * reports ntdll. A thread stuck and invisible to all three is exactly the
+     * case this answers. */
+    { int any = 0;
+      for (unsigned t = 0; t < 64u; t++) {
+          const char* n = g_hle_inflight[t];
+          if (!n) continue;
+          if (!any) { dbg_printf("[WATCHDOG] guest threads inside an HLE:\n"); any = 1; }
+          dbg_printf("[WATCHDOG]   guest-tid %-3u in %s\n", t, n);
+      }
+      if (!any) dbg_printf("[WATCHDOG] no guest thread is inside an HLE\n"); }
+    dbg_printf("[WATCHDOG] guest threads, by guest lr:\n");
+    ppu_report_guest_lrs();
+    DWORD me = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te; te.dwSize = sizeof te;
+    if (snap != INVALID_HANDLE_VALUE && Thread32First(snap, &te)) {
+        do {
+            if (te.th32OwnerProcessID != pid || te.th32ThreadID == me) continue;
+            HANDLE th = OpenThread(THREAD_GET_CONTEXT | THREAD_SUSPEND_RESUME,
+                                   FALSE, te.th32ThreadID);
+            if (!th) continue;
+            s_dbg_capn = 0; s_dbg_capbuf[0] = 0; s_dbg_cap = s_dbg_capbuf;
+            SuspendThread(th);
+            CONTEXT ctx; ctx.ContextFlags = CONTEXT_CONTROL;
+            if (GetThreadContext(th, &ctx)) {
+                HMODULE m = NULL;
+                GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                   GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   (LPCSTR)ctx.Rip, &m);
+                if (m == self) {
+                    dbg_printf( "[WATCHDOG]   tid %5lu BOOT rip rva=0x%llX\n",
+                            (unsigned long)te.th32ThreadID,
+                            (unsigned long long)((char*)ctx.Rip - (char*)self));
+                } else {
+                    char path[MAX_PATH] = "?";
+                    if (m) GetModuleFileNameA(m, path, sizeof path);
+                    const char* base = strrchr(path, '\\');
+                    dbg_printf( "[WATCHDOG]   tid %5lu in %s\n",
+                            (unsigned long)te.th32ThreadID, base ? base + 1 : path);
+                }
+                /* Scan the suspended thread's stack for boot-module return
+                 * addresses to reconstruct the lifted call chain — done for ALL
+                 * threads (even when RIP is parked in ntdll inside a CriticalSection
+                 * call), since that's exactly where the busy-spin's lwmutex churn
+                 * lands the main thread. Map RVAs -> func_ names via flow.map.
+                 * (some false positives expected — these are stack-scan hits.) */
+                {
+                    uint64_t* sp = (uint64_t*)ctx.Rsp;
+                    /* Bound the scan to the committed stack region so we never read
+                     * past the guard page. If the query fails or the region is not
+                     * committed+readable (thread mid-create, guard page, garbage
+                     * Rsp), skip the scan entirely -- a diagnostic AV here gets
+                     * caught by the crash filter and kills the whole run. */
+                    MEMORY_BASIC_INFORMATION mbi;
+                    uint64_t region_end = (uint64_t)sp;
+                    if (VirtualQuery((LPCVOID)sp, &mbi, sizeof mbi) &&
+                        mbi.State == MEM_COMMIT &&
+                        !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) &&
+                        (mbi.Protect & (PAGE_READONLY | PAGE_READWRITE |
+                                        PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)))
+                        region_end = (uint64_t)mbi.BaseAddress + mbi.RegionSize;
+                    int maxk = (int)((region_end - (uint64_t)sp) / 8);
+                    if (maxk > 0x200000 / 8) maxk = 0x200000 / 8;   /* lifted SPU frames are big */
+                    int found = 0;
+                    for (int k = 0; k < maxk && found < 40; k++) {
+                        uint64_t v = sp[k];
+                        if (v < (uint64_t)self) continue;
+                        HMODULE mm = NULL;
+                        GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                           GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                           (LPCSTR)v, &mm);
+                        if (mm == self) {
+                            /* Resolve to the guest function containing this return
+                             * address: the function_table entry with the largest host
+                             * pointer <= it. A raw RVA needs symbols a release build
+                             * does not have, and "ret rva=0x519F66" says nothing about
+                             * where a hung title actually is. Same mapping the
+                             * unresolved-call dump uses. */
+                            uint32_t bestGuest = 0;
+                            uintptr_t bestHost = 0, nextHost = 0, maxHost = 0;
+                            for (uint64_t q = 0; q < function_table_count; q++) {
+                                uintptr_t h = (uintptr_t)function_table[q].func;
+                                if (h > maxHost) maxHost = h;
+                                if (h <= (uintptr_t)v && h > bestHost) {
+                                    bestHost = h; bestGuest = function_table[q].addr;
+                                }
+                            }
+                            for (uint64_t q = 0; q < function_table_count; q++) {
+                                uintptr_t h = (uintptr_t)function_table[q].func;
+                                if (h > bestHost && (nextHost == 0 || h < nextHost)) nextHost = h;
+                            }
+                            /* The highest-addressed lifted function has no next, so its
+                             * extent is unknown -- and EVERY runtime/CRT address above it
+                             * was attributed to it. Refuse to guess there. A confident
+                             * wrong frame is worse than no frame. */
+                            if (bestHost == maxHost ||
+                                (uintptr_t)v - bestHost > 0x4000u) bestGuest = 0;
+                            dbg_printf( bestGuest
+                                    ? "[WATCHDOG]       tid %5lu ret rva=0x%llX  func_%08X+0x%llX\n"
+                                    : "[WATCHDOG]       tid %5lu ret rva=0x%llX\n",
+                                    (unsigned long)te.th32ThreadID,
+                                    (unsigned long long)(v - (uint64_t)self),
+                                    bestGuest, (unsigned long long)((uintptr_t)v - bestHost));
+                            found++;
+                        }
+                    }
+                }
+            }
+            ResumeThread(th);
+            s_dbg_cap = NULL;
+            if (s_dbg_capn) dbg_printf("%s", s_dbg_capbuf);
+            CloseHandle(th);
+        } while (Thread32Next(snap, &te));
+    }
+    if (snap != INVALID_HANDLE_VALUE) CloseHandle(snap);
+    fflush(stderr);
+}
