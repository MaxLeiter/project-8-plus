+#else /* !_WIN32: the same loader on dlopen (<mods>/plugins/*.so) */
+
+/* <exe dir>: /proc/self/exe (Linux), else nothing (then PS3_MODS_ROOT is needed). */
+std::string exe_dir_p(void)
+{
+    char buf[PATH_MAX + 1];
+    const ssize_t n = readlink("/proc/self/exe", buf, PATH_MAX);
+    if (n <= 0) return std::string();
+    buf[n] = 0;
+    const char* k = strrchr(buf, '/');
+    return k ? std::string(buf, (size_t)(k - buf)) : std::string();
+}
+
+bool is_dir_p(const std::string& p)
+{
+    struct stat st;
+    return stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+bool iless(const std::string& a, const std::string& b) { return strcasecmp(a.c_str(), b.c_str()) < 0; }
+
+/* Entries of dir: folders (want_dirs) or "*<ext>" files (ASCII case-insensitive); '_' / '.'
+ * prefixes dropped (a file so named is logged, as on Windows). Case-insensitive name order. */
+std::vector<std::string> list_dir_p(const std::string& dir, const char* ext, bool want_dirs)
+{
+    std::vector<std::string> out;
+    DIR* d = opendir(dir.c_str());
+    if (!d) return out;
+    const size_t el = ext ? strlen(ext) : 0;
+    while (const struct dirent* e = readdir(d)) {
+        const char* n = e->d_name;
+        if (!strcmp(n, ".") || !strcmp(n, "..")) continue;
+        const std::string full = dir + "/" + n;
+        if (is_dir_p(full) != want_dirs) continue;
+        if (!want_dirs) {
+            const size_t len = strlen(n);
+            if (len <= el || strcasecmp(n + len - el, ext) != 0) continue;
+        }
+        if (n[0] == '.' || n[0] == '_') {
+            if (!want_dirs)
+                fprintf(stderr, "[mods] %s skipped (disabled by its '%c' prefix)\n", full.c_str(), n[0]);
+            continue;
+        }
+        out.push_back(n);
+    }
+    closedir(d);
+    std::sort(out.begin(), out.end(), iless);
+    return out;
+}
+
+bool read_text_p(const std::string& path, std::string& out)
+{
+    FILE* f = fopen(path.c_str(), "rb");
+    if (!f) return false;
+    char buf[4096];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0 && out.size() < (4u << 20)) out.append(buf, n);
+    fclose(f);
+    return true;
+}
+
+/* PS3MOD_<PLUGIN>_<KEY>=value overrides, captured once at load. */
+void capture_env(plugin* p)
+{
+    const std::string prefix = "PS3MOD_" + env_norm(p->name.c_str()) + "_";
+    for (char** e = environ; e && *e; e++) {
+        const std::string s = *e;
+        const size_t eq = s.find('=');
+        if (eq == std::string::npos || eq <= prefix.size()) continue;
+        if (_strnicmp(s.c_str(), prefix.c_str(), prefix.size()) != 0) continue;
+        p->env.push_back({ env_norm(s.substr(prefix.size(), eq - prefix.size()).c_str()), s.substr(eq + 1) });
+    }
+}
+
+void unload(plugin* p, bool call_shutdown)
+{
+    if (call_shutdown && p->shutdown) p->shutdown();
+    p->state = PLG_GONE;
+    for (const staged_hook& h : p->hooks) h.rec->owner = nullptr;   /* never installed; handle dead */
+    drop_services(p);
+    s_plugins.erase(std::remove(s_plugins.begin(), s_plugins.end(), p), s_plugins.end());
+    if (p->dll) dlclose(p->dll);
+    delete p;
+}
+
+void refuse(plugin* p, const std::string& why, bool init_ran)
+{
+    fprintf(stderr, "[mods] plugin %s refused: %s\n", p->file.c_str(), why.c_str());
+    unload(p, init_ran);
+}
+
+/* RTLD_LOCAL: plugins do not see each other's symbols (as separate DLLs); RTLD_NOW: a missing
+ * symbol refuses the plugin here instead of crashing in the middle of a frame. */
+bool load_one(const std::string& dir, const std::string& file)
+{
+    plugin* p = new plugin();
+    const std::string path = dir + "/" + file;
+    p->file = file;
+    p->path = path;
+    {
+        const size_t dot = file.find_last_of('.');
+        const std::string base = file.substr(0, dot);
+        p->name = base;
+        p->title = p->name;
+        std::string cfg = dir + "/" + base + ".ini";
+        std::string text;
+        if (!read_text_p(cfg, text)) {
+            cfg = dir + "/" + base + ".toml";
+            if (!read_text_p(cfg, text)) cfg.clear();
+        }
+        if (!cfg.empty()) { p->config_path = cfg; cfg_parse(p, text); }
+    }
+    capture_env(p);
+
+    p->dll = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!p->dll) {
+        const char* err = dlerror();
+        fprintf(stderr, "[mods] plugin %s refused: dlopen failed (%s)\n", p->file.c_str(), err ? err : "?");
+        delete p;
+        return false;
+    }
+    p->query    = (ps3mod_query_fn)   dlsym(p->dll, PS3MOD_SYM_QUERY);
+    p->init     = (ps3mod_init_fn)    dlsym(p->dll, PS3MOD_SYM_INIT);
+    p->shutdown = (ps3mod_shutdown_fn)dlsym(p->dll, PS3MOD_SYM_SHUTDOWN);
+    make_host(p);
+    s_plugins.push_back(p);
+    if (!p->init) { refuse(p, "no exported " PS3MOD_SYM_INIT " (is it extern \"C\" PS3MOD_EXPORT, default visibility?)", false); return false; }
+
+    memset(p->info_buf, 0, sizeof p->info_buf);
+    p->info.size = (uint32_t)sizeof(ps3mod_info);
+    std::string why;
+    if (p->query) {
+        p->state = PLG_IDLE;
+        const int qr = p->query(&p->info);
+        if (qr != 0) { refuse(p, strf("ps3mod_query returned %d", qr), false); return false; }
+        if (!validate_info(p, why)) { refuse(p, why, false); return false; }
+    }
+
+    p->state = PLG_LOADING;
+    const int ir = p->init(&p->host, &p->info);
+    p->state = PLG_IDLE;   /* no more staging; nothing is live yet */
+    if (ir != 0) {
+        fprintf(stderr, "[mods] plugin %s not loaded: ps3mod_init returned %d\n", p->file.c_str(), ir);
+        unload(p, true);
+        return false;
+    }
+    if (!validate_info(p, why)) { refuse(p, why, true); return false; }
+    if (p->init_errors) {
+        refuse(p, strf("%d hook/patch/event registration(s) failed during ps3mod_init (see above)",
+                       p->init_errors), true);
+        return false;
+    }
+    if (p->info.name && *p->info.name) p->title = p->info.name;
+
+    commit(p);
+    p->state = PLG_ACTIVE;
+    fprintf(stderr, "[mods] plugin %s loaded: %s %s%s%s (%u hooks, %u patches, %u event handlers)\n",
+            p->file.c_str(), p->title.c_str(), p->info.version ? p->info.version : "",
+            p->config_path.empty() ? "" : "; config ", p->config_path.c_str(),
+            (unsigned)p->hooks.size(), (unsigned)p->patches.size(), (unsigned)p->events.size());
+    p->hooks.clear();   p->hooks.shrink_to_fit();
+    p->patches.clear(); p->patches.shrink_to_fit();
+    p->events.clear();  p->events.shrink_to_fit();
+    return true;
+}
+
+/* ps3mod_load_plugins off Windows: same rules, '/' paths, "*.so". */
+int load_plugins_posix(const char* elf_path)
+{
+    { const char* d = getenv("PS3MOD_DEBUG"); s_debug = d && *d && *d != '0'; }
+    if (const char* e = getenv("PS3_MODS_PLUGINS")) {
+        if (env_off(e)) {
+            fprintf(stderr, "[mods] plugins disabled (PS3_MODS_PLUGINS=%s)\n", e);
+            return 0;
+        }
+    }
+    std::string root;
+    if (const char* e = getenv("PS3_MODS_ROOT")) {
+        if (!*e || !strcmp(e, "0") || !_stricmp(e, "off")) return 0;   /* mods off */
+        root = e;
+    } else {
+        const std::string d = exe_dir_p();
+        if (d.empty()) return 0;
+        root = d + "/mods";
+    }
+    {   /* absolute, so plugin_path / mods_root stay usable after a chdir */
+        char full[PATH_MAX + 1];
+        if (realpath(root.c_str(), full)) root = full;
+    }
+    while (root.size() > 1 && root.back() == '/') root.pop_back();
+    if (!is_dir_p(root)) {
+        if (getenv("PS3_MODS_ROOT"))
+            fprintf(stderr, "[mods] PS3_MODS_ROOT '%s' is not a directory: no plugins\n", root.c_str());
+        return 0;
+    }
+    s_mods_root = root;
+
+    /* Candidates: packs (name order), then the root plugins folder. A Windows plugin (.dll) in the
+     * same folder is ignored here, so one mods folder can serve both builds. */
+    std::vector<std::pair<std::string, std::string>> cand;   /* (dir, file) */
+    for (const std::string& pack : list_dir_p(root, nullptr, true)) {
+        if (!_stricmp(pack.c_str(), "plugins")) continue;
+        const std::string pd = root + "/" + pack + "/plugins";
+        if (!is_dir_p(pd)) continue;
+        for (const std::string& f : list_dir_p(pd, ".so", false)) cand.push_back({ pd, f });
+    }
+    {
+        const std::string pd = root + "/plugins";
+        if (is_dir_p(pd))
+            for (const std::string& f : list_dir_p(pd, ".so", false)) cand.push_back({ pd, f });
+    }
+    if (cand.empty()) return 0;
+
+    build_index();
+    if (!compute_ppu_hash(elf_path, s_ppu_hash))
+        fprintf(stderr, "[mods] WARNING: could not compute the PPU hash of '%s'; "
+                        "plugins that name a game will be refused\n", elf_path ? elf_path : "(null)");
+    if (const char* e = getenv("RSX_W")) s_render_w.store((uint32_t)strtoul(e, nullptr, 0));
+    if (const char* e = getenv("RSX_H")) s_render_h.store((uint32_t)strtoul(e, nullptr, 0));
+    fprintf(stderr, "[mods] running ELF %s, %s, plugin ABI %u.%u, hooks %s; %u plugin(s) under %s\n",
+            s_ppu_hash[0] ? s_ppu_hash : "(PPU hash unknown)", s_lift_id,
+            (unsigned)PS3MOD_ABI_MAJOR, (unsigned)PS3MOD_ABI_MINOR,
+            ppu_hook_available() ? "on" : "OFF", (unsigned)cand.size(), s_mods_root.c_str());
+
+    int loaded = 0;
+    for (const auto& c : cand)
+        if (load_one(c.first, c.second)) loaded++;
+    if (loaded) {
+        s_active.store(1, std::memory_order_release);
+        atexit(at_exit_shutdown);
+    }
+    fprintf(stderr, "[mods] %d of %u plugin(s) loaded\n", loaded, (unsigned)cand.size());
+    return loaded;
+}
+
+#endif /* _WIN32 / PS3_WASM / POSIX (dlopen) */
+
+} /* namespace */
+
+/* ======================================================================== */
+/* Entry points (ppu_mod_loader.h)                                           */
+
+extern "C" int ps3mod_load_plugins(const char* elf_path)
+{
+#ifdef _WIN32
+    { const char* d = getenv("PS3MOD_DEBUG"); s_debug = d && *d && *d != '0'; }
+    if (const char* e = getenv("PS3_MODS_PLUGINS")) {
+        if (env_off(e)) {
+            fprintf(stderr, "[mods] plugins disabled (PS3_MODS_PLUGINS=%s)\n", e);
+            return 0;
+        }
+    }
+    std::wstring root;
+    if (const wchar_t* e = _wgetenv(L"PS3_MODS_ROOT")) {
+        if (!*e || !wcscmp(e, L"0") || !_wcsicmp(e, L"off")) return 0;   /* mods off */
+        root = e;
+    } else {
+        const std::wstring d = exe_dir_w();
+        if (d.empty()) return 0;
+        root = d + L"\\mods";
+    }
+    {   /* absolute: LoadLibraryExW + LOAD_WITH_ALTERED_SEARCH_PATH needs a full path */
+        std::vector<wchar_t> full(32768);
+        DWORD n = GetFullPathNameW(root.c_str(), (DWORD)full.size(), full.data(), nullptr);
+        if (n && n < full.size()) root.assign(full.data(), n);
+    }
+    while (root.size() > 3 && (root.back() == L'\\' || root.back() == L'/')) root.pop_back();
+    if (!is_dir_w(root)) {
+        if (_wgetenv(L"PS3_MODS_ROOT"))
+            fprintf(stderr, "[mods] PS3_MODS_ROOT '%s' is not a directory: no plugins\n", utf8(root.c_str()).c_str());
+        return 0;
+    }
+    s_mods_root = utf8(root.c_str());
+
+    /* Candidates: packs (name order), then the root plugins folder. */
+    std::vector<std::pair<std::wstring, std::wstring>> cand;   /* (dir, file) */
+    for (const std::wstring& pack : list_dir(root, L"*", true)) {
+        if (!_wcsicmp(pack.c_str(), L"plugins")) continue;
+        const std::wstring pd = root + L"\\" + pack + L"\\plugins";
+        if (!is_dir_w(pd)) continue;
+        for (const std::wstring& f : list_dir(pd, L"*.dll", false)) cand.push_back({ pd, f });
+    }
+    {
+        const std::wstring pd = root + L"\\plugins";
+        if (is_dir_w(pd))
+            for (const std::wstring& f : list_dir(pd, L"*.dll", false)) cand.push_back({ pd, f });
+    }
+    if (cand.empty()) return 0;
+
+    build_index();
+    if (!compute_ppu_hash(elf_path, s_ppu_hash))
+        fprintf(stderr, "[mods] WARNING: could not compute the PPU hash of '%s'; "
+                        "plugins that name a game will be refused\n", elf_path ? elf_path : "(null)");
+    if (const char* e = getenv("RSX_W")) s_render_w.store((uint32_t)strtoul(e, nullptr, 0));
+    if (const char* e = getenv("RSX_H")) s_render_h.store((uint32_t)strtoul(e, nullptr, 0));
+    fprintf(stderr, "[mods] running ELF %s, %s, plugin ABI %u.%u, hooks %s; %u plugin(s) under %s\n",
+            s_ppu_hash[0] ? s_ppu_hash : "(PPU hash unknown)", s_lift_id,
+            (unsigned)PS3MOD_ABI_MAJOR, (unsigned)PS3MOD_ABI_MINOR,
+            ppu_hook_available() ? "on" : "OFF", (unsigned)cand.size(), s_mods_root.c_str());
+
+    int loaded = 0;
+    for (const auto& c : cand)
+        if (load_one(c.first, c.second)) loaded++;
+    if (loaded) {
+        s_active.store(1, std::memory_order_release);
+        atexit(at_exit_shutdown);
+    }
+    fprintf(stderr, "[mods] %d of %u plugin(s) loaded\n", loaded, (unsigned)cand.size());
+    return loaded;
+#elif defined(PS3_WASM)
+    { const char* d = getenv("PS3MOD_DEBUG"); s_debug = d && *d && *d != '0'; }
+    if (const char* e = getenv("PS3_MODS_PLUGINS")) {
+        if (env_off(e)) {
+            fprintf(stderr, "[mods] plugins disabled (PS3_MODS_PLUGINS=%s)\n", e);
+            return 0;
+        }
+    }
+    std::string root = "/mods";
+    if (const char* e = getenv("PS3_MODS_ROOT")) {
+        if (!*e || !strcmp(e, "0") || !_stricmp(e, "off")) return 0;   /* mods off */
+        root = e;
+    }
+    while (root.size() > 1 && root.back() == '/') root.pop_back();
+    s_mods_root = root;
+    unsigned n = 0;
+    const ps3mod_static_plugin* sp = ps3mod_static_plugins(&n);
+    if (!sp || !n) return 0;
+
+    build_index();
+    if (!compute_ppu_hash(elf_path, s_ppu_hash))
+        fprintf(stderr, "[mods] WARNING: could not compute the PPU hash of '%s'; "
+                        "plugins that name a game will be refused\n", elf_path ? elf_path : "(null)");
+    if (const char* e = getenv("RSX_W")) s_render_w.store((uint32_t)strtoul(e, nullptr, 0));
+    if (const char* e = getenv("RSX_H")) s_render_h.store((uint32_t)strtoul(e, nullptr, 0));
+    fprintf(stderr, "[mods] running ELF %s, %s, plugin ABI %u.%u, hooks %s; %u built-in plugin(s), mods root %s%s\n",
+            s_ppu_hash[0] ? s_ppu_hash : "(PPU hash unknown)", s_lift_id,
+            (unsigned)PS3MOD_ABI_MAJOR, (unsigned)PS3MOD_ABI_MINOR,
+            ppu_hook_available() ? "on" : "OFF", n, s_mods_root.c_str(),
+            is_dir_u(s_mods_root) ? "" : " (not mounted: built-in defaults)");
+
+    int loaded = 0;
+    for (unsigned i = 0; i < n; i++)
+        if (load_static(s_mods_root, &sp[i])) loaded++;
+    if (loaded) {
+        s_active.store(1, std::memory_order_release);
+        atexit(at_exit_shutdown);
+    }
+    fprintf(stderr, "[mods] %d of %u plugin(s) loaded\n", loaded, n);
+    return loaded;
+#else
+    return load_plugins_posix(elf_path);
+#endif
+}
+
+extern "C" void ps3mod_host_display_ready(void* hwnd, uint32_t render_w, uint32_t render_h)
+{
+    if (!s_active.load(std::memory_order_acquire)) return;
+    if (render_w && render_h) { s_render_w.store(render_w); s_render_h.store(render_h); }
+#ifdef _WIN32
+    HWND h = (HWND)hwnd;
+    if (!h) EnumThreadWindows(GetCurrentThreadId(), pick_thread_window, (LPARAM)&h);
+    s_hwnd = h;
+    poll_client_size();
+#else
+    (void)hwnd;
+    poll_client_size();   /* the presenter's SDL window, if there is one */
+#endif
+    s_ready.store(1, std::memory_order_release);
+    ps3mod_display d;
+    fill_display(&d);
+    fprintf(stderr, "[mods] display ready: window %ux%u, backbuffer %ux%u, aspect %.4f\n",
+            d.window_w, d.window_h, d.backbuffer_w, d.backbuffer_h, (double)d.aspect);
+    fire(PS3MOD_EV_DISPLAY_READY, 1);
+}
+
+extern "C" void ps3mod_host_vblank(void)
+{
+    if (!s_active.load(std::memory_order_relaxed)) return;
+    const uint64_t n = s_vblanks.fetch_add(1, std::memory_order_relaxed) + 1;
+    /* Window size: polled every 4th vblank (~15 Hz) on the thread that owns
+     * the window. */
+    if ((n & 3) == 0 && s_ready.load(std::memory_order_relaxed) && poll_client_size())
+        fire(PS3MOD_EV_RESIZE, s_resizes.fetch_add(1, std::memory_order_relaxed) + 1);
+    fire(PS3MOD_EV_VBLANK, n);
+}
+
+/* The host is about to leave through ExitProcess (window close after the exit
+ * grace), which skips atexit: run the plugins' EV_SHUTDOWN + ps3mod_shutdown
+ * and the PPU_HOOK_TRACE report now. Idempotent with the atexit path. */
+extern "C" void ppu_hook_trace_flush(void);
+extern "C" void ps3mod_host_shutdown(void)
+{
+    ppu_hook_trace_flush();
+    at_exit_shutdown();   /* also off Windows: _exit paths skip atexit there too */
+}
+
+extern "C" void ps3mod_host_present(void)
+{
+    if (!s_active.load(std::memory_order_relaxed)) return;
+    const uint64_t n = s_frames.fetch_add(1, std::memory_order_relaxed) + 1;
+    fire(PS3MOD_EV_PRESENT, n);
+}
+
+#endif /* PPU_MOD_HOOKS */
diff --git a/runtime/ppu/ppu_mod_loader.h b/runtime/ppu/ppu_mod_loader.h
new file mode 100644
index 00000000..e5985c2a
--- /dev/null
+++ b/runtime/ppu/ppu_mod_loader.h
@@ -0,0 +1,59 @@
+/*
+ * ps3recomp - plugin (mod DLL) loader: the runtime-side entry points.
+ *
+ * The plugin ABI itself is include/ps3mod.h. This header is what the boot
+ * harness calls. Everything here exists only in a mod-capable build
+ * (-DPPU_MOD_HOOKS, with ppu_mod_hooks.cpp + ppu_mod_loader.cpp added to the
+ * game target). Without it the declarations become inline no-ops, so a caller
+ * compiles either way, but boot_main still keeps its calls inside
+ * #ifdef PPU_MOD_HOOKS so the default build is unchanged token for token.
+ *
+ * Call order (runtime/ppu/tests/boot_main.cpp):
+ *   main():          ps3mod_load_plugins(elf_path) after lv2_init_syscalls(),
+ *                    before the vblank ticker starts and before ppu_run().
+ *   vblank ticker:   ps3mod_host_display_ready() once the window/backend is up,
+ *                    ps3mod_host_vblank() per vblank tick,
+ *                    ps3mod_host_present() after each presented guest frame.
+ * All three host_* calls return at once when no plugin was loaded.
+ */
+#ifndef PS3RECOMP_PPU_MOD_LOADER_H
+#define PS3RECOMP_PPU_MOD_LOADER_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef PPU_MOD_HOOKS
+
+/* Discover, validate and initialise <mods>\plugins\*.dll (and
+ * <mods>\<pack>\plugins\*.dll). elf_path is the ELF that ppu_load_elf loaded;
+ * its RPCS3 PPU hash is what plugins are checked against. Returns the number
+ * of plugins loaded (0 if none, or disabled by PS3_MODS_PLUGINS=0). */
+int  ps3mod_load_plugins(const char* elf_path);
+
+/* Host events (ticker thread). hwnd may be NULL: the loader then takes the
+ * calling thread's top-level window (the backends create theirs on the ticker
+ * thread). render_w/h = the size the backend was initialised with (RSX_W/H). */
+void ps3mod_host_display_ready(void* hwnd, uint32_t render_w, uint32_t render_h);
+void ps3mod_host_vblank(void);
+void ps3mod_host_present(void);
+/* Before an ExitProcess that skips atexit: plugin shutdown + hook trace report. */
+void ps3mod_host_shutdown(void);
+
+#else  /* !PPU_MOD_HOOKS */
+
+static inline int  ps3mod_load_plugins(const char* p) { (void)p; return 0; }
+static inline void ps3mod_host_display_ready(void* h, uint32_t w, uint32_t hh) { (void)h; (void)w; (void)hh; }
+static inline void ps3mod_host_vblank(void) {}
+static inline void ps3mod_host_present(void) {}
+static inline void ps3mod_host_shutdown(void) {}
+
+#endif /* PPU_MOD_HOOKS */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_PPU_MOD_LOADER_H */
diff --git a/runtime/ppu/ppu_mod_static.h b/runtime/ppu/ppu_mod_static.h
new file mode 100644
index 00000000..bbcd1e6d
--- /dev/null
+++ b/runtime/ppu/ppu_mod_static.h
@@ -0,0 +1,34 @@
+/*
+ * ps3recomp - statically linked plugins (mod-capable WebAssembly builds).
