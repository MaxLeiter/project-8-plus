+    "    uint o = (e == 0u) ? sg : ((e == 31u) ? (sg | 0x7F800000u | (m << 13)) : (sg | ((e + 112u) << 23) | (m << 13)));\n"
+    "    return asfloat(o);\n"
+    "}\n"
+    "uint vf_vid(uint sv) {\n"
