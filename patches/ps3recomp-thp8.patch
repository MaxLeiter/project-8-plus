+ * texture found written 4 frames in a row (a movie frame, a CPU-built
+ * texture) stops being tracked for 64 frames and is hashed every frame like
+ * before, so its writer does not pay a write-watch fault per page per frame.
+ * Only spans of PS3_TEXDIRTY_MIN bytes (default 32768) or more are tracked:
+ * a GetWriteWatch call costs ~2-3 us whatever the size, the hash ~1.6 us at
+ * 16 KB and ~4 us at 32 KB (work/gpuoff/wwbench2.c), so a small texture is
+ * cheaper to hash. PS3_TEXDIRTY=0: hash every frame (old). PS3_TEXDIRTY_OFF_FILE=<path>: the
+ * same while <path> exists (polled once per frame).
+ * -----------------------------------------------------------------------*/
+static struct {
+    int init, enabled, off_now, gran;
+    u32 min_span;
+    const char* off_file;
+    u32 off_frame, stat_frame;
+    u64 checks, clean, dirty, untracked, created;
+} g_texdirty;
+
+static int ld_texdirty_active(void)
+{
+    if (!g_texdirty.init) {
+        g_texdirty.init = 1;
+        const char* e = getenv("PS3_TEXDIRTY");
+        g_texdirty.enabled = !(e && e[0] == '0') && gwt_available();
+        /* granule mode: one shared query per 256 KB granule per frame, so every
+         * texture is tracked (no small-texture hashing); per-texture mode keeps
+         * the 32 KB threshold (a query per texture costs more than hashing a
+         * small one). */
+        const char* gr = getenv("PS3_TEXDIRTY_GRAN");
+        g_texdirty.gran = !(gr && gr[0] == '0');
+        const char* m = getenv("PS3_TEXDIRTY_MIN");
+        g_texdirty.min_span = m ? (u32)strtoul(m, NULL, 0) : (g_texdirty.gran ? 0u : 32768u);
+        g_texdirty.off_file = getenv("PS3_TEXDIRTY_OFF_FILE");
+        fprintf(stderr, "[texdirty] %s%s\n", g_texdirty.enabled ? "on" : "off",
+                gwt_available() ? "" : " (guest VM without write watch)");
