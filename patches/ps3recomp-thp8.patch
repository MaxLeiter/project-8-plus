+/* Diagnostics the fast path does not reproduce: the walker's per-word gates and
+ * rsx_process_method's logs that read state the fast path no longer feeds. Any
+ * of them set = the old loop for the whole run. Read once. */
+static int gcm_fifo_dbg_armed(void)
+{
+    static int armed = -1;
+    if (armed < 0) {
+        static const char* const k[] = {
+            "GCM_OBJDBG", "GCM_SUBCH_GATE", "GCM_VAL_WATCH", "RSX_LIVE_FEED_DBG",
+            "RSX_TRACE", "SURFDBG", "RTT_DUMP", "VDATA_DBG", "LOAD_DBG", "TCONST_DBG",
+            "SEQ_DBG", "MVPDBG", "TCONST_FIFO", "GCM_WRAP_STATS", "GCM_TEST_WALK_STALL" };
+        armed = 0;
+        for (size_t i = 0; i < sizeof k / sizeof k[0]; i++)
+            if (getenv(k[i])) {
+                if (!armed) fprintf(stderr, "[fifo-fast] %s set: per-word walker loop\n", k[i]);
+                armed = 1;
+            }
+    }
+    return armed;
+}
+
+/* Methods (subchannel 0/1, < 0x2000) rsx_process_method must see even when the
+ * backend reads no rsx_state: they write guest memory (back-end semaphores), the
+ * reference, a statically held semaphore offset, or feed a backend callback / log
+ * (clear values + CLEAR_SURFACE, BEGIN_END, draws, index array) -- plus GET_REPORT,
+ * which the walker itself handles. Everything else only stores into rsx_state. */
+static u8 s_gcm_fx[0x2000 >> 2];
+static void gcm_fx_init(void)
+{
+    static const u16 fx[] = {
+        0x0050,                                   /* NV406E_SET_REFERENCE          */
+        0x1800,                                   /* NV4097_GET_REPORT             */
+        NV4097_SET_BEGIN_END, NV4097_DRAW_ARRAYS, NV4097_DRAW_INDEX_ARRAY,
+        NV4097_SET_INDEX_ARRAY_ADDRESS, NV4097_SET_INDEX_ARRAY_DMA,
+        0x1D6C, 0x1D70, 0x1D74,                   /* back-end semaphore offset/release */
+        NV4097_SET_ZSTENCIL_CLEAR_VALUE, NV4097_SET_COLOR_CLEAR_VALUE, NV4097_CLEAR_SURFACE };
+    for (size_t i = 0; i < sizeof fx / sizeof fx[0]; i++) s_gcm_fx[fx[i] >> 2] = 1;
+}
+
+/* NV4097_GET_REPORT: (type << 24) | offset into the report area. Sample counts
+ * are not measured, so a ZPASS query reports "visible" -- the conservative
+ * answer; reading 0 tells the title every queried object is occluded. */
+static void gcm_get_report(u32 v)
+{
+    const u32 idx = (v & 0xFFFFFFu) / 16u;
+    { static int rn = 0; if (rn < 6 && ++rn) printf("[GET_REPORT] type=%u idx=%u%c", v >> 24, idx, 10); }
+    if (idx < CELL_GCM_MAX_REPORT_COUNT) {
+        s_report_data[idx].timestamp = get_timestamp_ns();
+        s_report_data[idx].value = (v >> 24) == 1u ? 0xFFFFu : 0u;
+    }
+}
+
+static inline u32 gcm_be32(const u8* p)
+{
+    u32 raw;
+    memcpy(&raw, p, 4);
+    return ps3_bswap32(raw);
+}
+
+static struct { int on; u64 passes, headers, fast_words, side_words, slow_words, batches, twod_words; LONGLONG ticks;
+                LONGLONG t_last; unsigned flips_last; u32 slow_sub[8]; } s_fst = { -1 };
+/* PS3_FIFO_STATS: words per (subchannel, method) that took the old loop -- the top
+ * few are printed with each [fifo-stats] line. */
+static u32 s_fst_slow_m[8][0x2000 >> 2];
+
+/* The walker's consumers, file scope since the split executor shares them: the
+ * walker's own rsx_state (fed to rsx_process_method), the live engine, the
+ * draw engine and the subchannel-1 routing switch. gcm_consumers_init at the
+ * start of every pass (walker or executor). */
+static rsx_state s_gcm_rstate;
+static int s_gcm_rstate_inited = 0;
+static int s_gcm_live = -1, s_gcm_eng = -1, s_gcm_s1_2d = -1;
+static void gcm_consumers_init(void)
+{
+    if (s_gcm_s1_2d < 0) { const char* e = getenv("GCM_SUBCH1_2D"); s_gcm_s1_2d = e ? atoi(e) : 0; }
+    if (s_gcm_live < 0) s_gcm_live = rsx_live_draw_enabled();
+    if (s_gcm_eng < 0) s_gcm_eng = rsx_draw_engine_enabled();
+    if (!s_gcm_rstate_inited) { rsx_state_init(&s_gcm_rstate); s_gcm_rstate_inited = 1; }
+}
+
+/* One data word of a method header, the walker's per-word loop body (any
+ * subchannel): diagnostics, the live engine, the draw engine, then the driver
+ * methods / 3D (rsx_process_method, reference, report) / 2D routing. Shared by
+ * the walker's old loop and the split executor. hdr_off: the header's FIFO offset. */
+static void gcm_exec_word(u32 subch, u32 m, u32 v, u32 hdr_off, int live)
+{
+    extern u32 g_rsx_last_reference;
+    /* GCM_SET_USER_COMMAND is method 0xEB00, which this decode
+     * splits into subchannel 7 / method 0x0B00 -- so it was landing
+     * in the 2D engine path and being dropped as unrecognised. It
+     * is not a 2D method at all: it tells the RSX to raise a
+     * USER_CMD interrupt, which is what ps1_netemu's flip path
+     * blocks on. */
+    { static int sd = -1; static unsigned long s7 = 0;
+      if (sd < 0) sd = getenv("GCM_SUBCH7") ? 1 : 0;
+      if (sd && subch == 7 && ((s7 < 16 && ++s7)))
+          fprintf(stderr, "[subch7] method=0x%04X data=0x%08X\n", m, v); }
+    if (subch == 7 && m == 0x0B00u) {
+        extern void rsx_raise_user_cmd(u32 arg);
+        rsx_raise_user_cmd(v);
+        return;
+    }
+    /* GCM_SUBCH1_3D=1: treat subchannel 1 as the 3D object too.
+     * The title issues NV4097 methods on it -- 0x1A80..0x1AC0 is
+     * SET_TEXTURE_OFFSET for units 4-6 -- and the 2D path silently
+     * discards whatever it does not recognise, so that state never
+     * reaches the renderer. SET_OBJECT binds are not tracked, which
+     * is what makes the subchannel-to-engine mapping a guess. */
+    /* GCM_OBJDBG=1: log every SET_OBJECT (method 0). The handle a
+     * title binds to a subchannel is what says which engine that
+     * subchannel drives; comparing subchannel 1 against subchannel 0
+     * turns the routing below from a guess into a reading. */
+    { static int od = -1;
+      if (od < 0) { const char* e = getenv("GCM_OBJDBG"); od = e ? 1 : 0; }
+      if (od && m == 0) {
+          static unsigned seen[8]; static int have[8];
+          const unsigned h = v;
+          if (subch < 8 && (!have[subch] || seen[subch] != h)) {
+              have[subch] = 1; seen[subch] = h;
+              printf("[GCM-OBJ] subch=%u SET_OBJECT handle=0x%08X%c",
+                     subch, h, 10); fflush(stdout);
+          } } }
+    /* The subchannel is a binding slot, not an engine selector: a
+     * title may bind NV4097 to something other than subchannel 0.
+     * Twisted Metal uses subchannel 1, and caner (canersaka) hit
+     * the same thing in Yakuza Dead Souls, where SPU-built command
+     * lists bind NV4097 elsewhere -- his rsx_live_draw.c masks the
+     * subchannel out of the method for exactly this reason.
+     *
+     * gcm_2d_method only ever handles subchannels 2..7 (NV3062,
+     * NV308A/NV309E, NV3089), so anything arriving on 1 was being
+     * dropped on the floor -- for this title that included
+     * SET_SHADER_PROGRAM, leaving one stale fragment program bound
+     * for every draw in the game. Treat the subchannels the 2D path
+     * does not claim as 3D. GCM_SUBCH1_2D=1 restores the old split.
+     */
+    const int s1_2d = s_gcm_s1_2d;
+    /* GCM_SUBCH_GATE=<file>: while <file> exists, log every method on a
+     * non-zero subchannel -- what each binding slot actually carries. */
+    { static const char* sg = (const char*)-1; static unsigned poll; static int open_g;
+      if (sg == (const char*)-1) sg = getenv("GCM_SUBCH_GATE");
+      const u32 cm3 = m & 0x1FFCu;
+      /* GCM_VAL_WATCH=<hex>: every FIFO word carrying that value, any method. */
+      { static u32 vw = 1;
+        if (vw == 1) { const char* e = getenv("GCM_VAL_WATCH"); vw = e ? (u32)strtoul(e, 0, 16) : 0; }
+        if (vw && v == vw) {
+            static int vn; if ((vn < 64 && ++vn))
+                printf("[valwatch] subch=%u method=0x%04X = 0x%08X get=0x%X%c", subch, m, vw, hdr_off, 10);
+        } }
+      /* ...and surface offsets (colour 0x210/0x218/0x288/0x28C, zeta 0x214) and texture 1 offset */
+      if (sg && !subch && (cm3 == 0x210 || cm3 == 0x214 || cm3 == 0x218 || cm3 == 0x288 || cm3 == 0x28C ||
+                           cm3 == 0x1A20)) {
+          if ((poll++ & 255u) == 0) { FILE* g = fopen(sg, "rb"); open_g = g != NULL; if (g) fclose(g); }
+          if (open_g) printf("[surfreg] 0x%04X = 0x%08X%c", cm3, v, 10);
+      }
+      if (sg && subch) {
+          if ((poll++ & 255u) == 0) { FILE* g = fopen(sg, "rb"); open_g = g != NULL; if (g) fclose(g); }
+          if (open_g) printf("[subch] %u 0x%04X = 0x%08X%c", subch, m, v, 10);
+      } }
+    /* Mirror the whole method stream into the live NV4097->D3D12
+     * engine (caner / canersaka). Inert unless RSX_LIVE_DRAW is set.
+     * It wants the raw method with its subchannel bits -- it
+     * canonicalises with & 0x1FFC itself. */
+    if (live && s_gcm_live) rsx_live_draw_method((subch << 13) | m, v);
+
+    /* And into the platform-neutral register-file draw engine,
+     * which is the macOS path under PS3RECOMP_RSX_ENGINE=dispatch.
+     * It wants the raw method with its subchannel bits for the
+     * same reason the live engine does, and masks them itself. */
+    if (s_gcm_eng) rsx_draw_engine_method((subch << 13) | m, v);
+
+    /* RSX_LIVE_FEED_DBG=1: what the FIFO actually carries. Counted
+     * for any run, live engine or not, so the method stream and the
+     * backend's draw callbacks can be compared in one measurement. */
+    { static int fdbg = -1;
+      if (fdbg < 0) fdbg = getenv("RSX_LIVE_FEED_DBG") ? 1 : 0;
+      if (fdbg) {
+          static long long n_be = 0, n_va = 0, n_ia = 0, tick = 0;
+          const u32 cm = m & 0x1FFCu;
+          if      (cm == 0x1808u) n_be++;
+          else if (cm == 0x1814u) n_va++;
+          else if (cm == 0x1824u) n_ia++;
+          if (((++tick) % 200000) == 0)
+              printf("[feed] begin_end=%lld draw_arrays=%lld draw_index=%lld\n",
+                     n_be, n_va, n_ia), fflush(stdout);
+      } }
+
+    /* Driver methods (0xE9xx, 0xEBxx) occupy bits 2-15 of the
+     * FIFO word; the standard 11-bit extraction (w & 0x1FFC)
+     * truncates them.  Reconstruct the full address the same way
+     * the draw-engine call above does. */
+    { const u32 mfull = (subch << 13) | m;
+    if (mfull == 0xEB00u || mfull == 0xEB04u) {
+        cellGcmQueueUserCommand(v);
+    } else if (mfull == 0xE920u || mfull == 0xE924u) {
+        cellGcmSetFlipCommand(v & 7u);
+    } else if (subch == 0 || (subch == 1 && !s1_2d)) {
+        rsx_process_method(&s_gcm_rstate, m, v);
+        /* NV406E_SET_REFERENCE: queue the fence value for PACED
+         * publication (gcm_ref_publish below) instead of letting a
+         * later fence in the same batch overwrite it. */
+        if (m == 0x50) gcm_ref_push_at(g_rsx_last_reference, hdr_off);
+        /* NV4097_GET_REPORT (gcm_get_report). */
+        if (m == 0x1800) gcm_get_report(v);
+    } else
+        gcm_2d_method(subch, m, v);
+    }
+}
+
+/* NV406E semaphore word (subchannel 0): OFFSET(0x64) / ACQUIRE(0x68) /
+ * RELEASE(0x6C). Returns 1 when an ACQUIRE has to block the drain
+ * (GCM_SEMA_ACQUIRE=1 and the label differs). */
+static int gcm_sema_word(u32 m, u32 v)
+{
+    u32 la = GCM_LABEL_GUEST_BASE + (s_sema_offset & 0xFFFFu);
+    { static int rd = -1, sn = 0; if (rd < 0) rd = getenv("GCM_RECDBG") ? 1 : 0;
+      if (rd && (sn < 12 && ++sn))
+          fprintf(stderr, "[SEMA] m=0x%02X v=0x%08X off=0x%X\n", m, v, s_sema_offset); }
+    if (m == 0x64u)      s_sema_offset = v;
+    else if (m == 0x6Cu) vm_write32(la, v);
+    else if (m == 0x68u && vm_read32(la) != v) {
+        /* GCM_SEMA_ACQUIRE=1 makes ACQUIRE actually block, which is what
+         * the hardware does. Off by default: a title whose label nothing
+         * ever writes would wedge the drain permanently, and RELEASE on
+         * its own is the half that unblocks a waiting guest. */
+        static int blk = -1;
+        if (blk < 0) { const char* e = getenv("GCM_SEMA_ACQUIRE"); blk = e ? atoi(e) : 0; }
+        if (blk) return 1;
+    }
+    return 0;
+}
+
+/* An lv1 driver flip word (0xFEADxxxx) in the FIFO: the flip's execution half. */
+static void gcm_exec_flip_word(u32 w)
+{
+    extern s32 cellGcmSetFlipCommand(u32 bufferId);
+    /* Count the flip WORDS the title actually writes into the FIFO,
+     * separately from the presents that result. When a title stops
+     * appearing on screen the first question is which side stopped:
+     * this counter still climbing while presents do not is a runtime
+     * problem, both stopping together is the guest's. */
+    { static unsigned long long flips = 0; static int dbg = -1;
+      if (dbg < 0) dbg = getenv("GCM_FLIPCOUNT") ? 1 : 0;
+      ++flips;
+      if (dbg && (flips <= 8ull || (flips % 200ull) == 0))
+          fprintf(stderr, "[flipword] %llu FIFO flip words decoded%c",
+                  flips, 10); }
+    if ((w & 0xFFFFFF00u) == GCM_FLIP_MARKER) {
+        /* Queued by _cellGcmSetFlipCommand, which already did the
+         * guest-visible half of the request. */
+        s_current_display_buffer_id = w & 7u;
+        s_flip_pending = 1;
+        s_flip_request_count++;
+        InterlockedIncrement(&s_flip_executed);
+        if (s_flip_exec_ev) SetEvent((HANDLE)s_flip_exec_ev);
+        /* Interrupt-thread mode: executed now, completed (status DONE,
+         * flip handler) at the next vblank on the interrupt thread. */
+        if (gcm_irq_mode()) gcm_irq_note_exec();
+    } else {
+        cellGcmSetFlipCommand(w & 0xFFu);
+    }
+}
+
+/* Pure-state runs waiting for the live engine, dispatched in order at each flush
+ * (before any side-effect word, when full, at the end of a batch). The run data
+ * stays in guest memory until then, so the walker's `get` (s_fifo_getoff) must
+ * never move past a header with a pending run: the guest may reuse ring bytes
+ * behind `get` (gcm_ring_wrap's segments). */
+#define GCM_RUNQ_MAX 64
+typedef struct { rsx_dsp_run r[GCM_RUNQ_MAX]; u32 n; int live; } gcm_runq;
+
+static void gcm_runq_flush(gcm_runq* q)
+{
+    if (!q->n) return;
+    if (q->live && !rsx_live_draw_method_runs(q->r, q->n))
+        for (u32 k = 0; k < q->n; k++) {
+            const rsx_dsp_run* r = &q->r[k];
+            for (u32 i = 0; i < r->count; i++)
+                rsx_live_draw_method(r->method + i * r->step, gcm_be32(r->be + (size_t)i * 4));
+        }
+    q->n = 0;
+}
+
+/* One subchannel-0/1 method header (count >= 1 data words at p, all in one IO
+ * page, method + (count-1)*step < 0x2000) the fast way: pure-state words are
+ * queued for the live engine, each side-effect word flushes the queue and is then
+ * handled exactly as the old loop handles a word (live engine, rsx_process_method,
+ * reference queue, report). */
+static inline void gcm_fifo_hdr_fast(gcm_runq* q, rsx_state* st, u32 subch, u32 method, u32 count,
+                                     u32 step, const u8* p, u32 hdr_off, int state_free)
+{
+    extern u32 g_rsx_last_reference;
+    const u32 mbase = (subch << 13) | method;
+    u32 i = 0, side = 0;
+    while (i < count) {
+        u32 j = i;
+        if (state_free) {
+            if (step) { while (j < count && !s_gcm_fx[(method >> 2) + j]) j++; }
+            else if (!s_gcm_fx[method >> 2]) j = count;
+        }
+        if (j > i) {   /* [i, j): pure state for the walker's rsx_state -> live engine only */
+            if (q->n == GCM_RUNQ_MAX) { gcm_runq_flush(q); s_fifo_getoff = hdr_off; }
+            rsx_dsp_run* r = &q->r[q->n++];
+            r->method = mbase + i * step; r->count = j - i; r->step = step; r->be = p + (size_t)i * 4;
+            i = j;
+            if (i == count) break;
+        }
+        /* word i: everything queued so far first, then the live engine, then the
+         * walker's own handling (old loop order) */
+        if (q->n) { gcm_runq_flush(q); s_fifo_getoff = hdr_off; }
+        const u32 m = method + i * step, v = gcm_be32(p + (size_t)i * 4);
+        if (q->live) rsx_live_draw_method(mbase + i * step, v);
+        rsx_process_method(st, m, v);
+        /* NV406E_SET_REFERENCE: queue the fence value for paced publication. */
+        if (m == 0x50) gcm_ref_push_at(g_rsx_last_reference, hdr_off);
+        if (m == 0x1800) gcm_get_report(v);
+        side++;
+        i++;
+    }
+    if (s_fst.on > 0) { s_fst.side_words += side; s_fst.fast_words += count - side; }
+}
+
+/* The fast path's batch: consecutive simple method headers from s_fifo_getoff,
+ * within its 1 MB IO page, up to `max` headers. Simple = an incrementing or
+ * non-incrementing method header (not JUMP / CALL / RET / flip word) on
+ * subchannels 0-6 (not 7: driver methods; not 1 under GCM_SUBCH1_2D) that is no
+ * NV406E semaphore method and whose data stays in the page and below method 0x2000. Per header the old loop's
+ * bookkeeping is kept (drain beat, last ring offset, trace ring); a ring wrap
+ * posted at the next offset, `put`, or anything not simple ends the batch and the
+ * old loop takes over. Returns the number of headers consumed. */
+static u32 gcm_fifo_batch(rsx_state* st, u32 put, int live, int s1_2d, u32 max)
+{
+    u32 off = s_fifo_getoff;
+    const u32 ea = gcm_io2ea(off);
+    if (!ea || !max) return 0;
+    const u8* pbase = vm_base + (ea & ~0xFFFFFu);   /* host pointer of this IO page */
+    const u32 page = off >> 20;
+    const int state_free = rsx_backend_state_free();
+    gcm_runq q; q.n = 0; q.live = live;
+    u32 n = 0;
+    /* PS3_DSP_TRIM: the old loop's per-header bookkeeping kept in registers and
+     * stored once at the end of the batch (same values: offsets only grow inside
+     * a batch, so the last one below `put` is the one the per-header stores leave). */
+    const int trim = s_gcm_trim;
+    u32 beat = 0, tr_i = s_tr_i, last_lt = 0xFFFFFFFFu;
+    while (n < max) {
+        if (off == put || (off >> 20) != page) break;
+        { const LONG tk = s_wrap_taken;
+          if (tk != s_wrap_posted && off == s_wrap_src[(u32)tk % GCM_WRAP_SLOTS]) break; }
+        const u32 po = off & 0xFFFFFu;
+        if (po > 0x100000u - 4u) break;
+        const u8* p = pbase + po;
+        const u32 w = gcm_be32(p);
+        const u32 type = w >> 29;
+        if ((type != 0 && type != 2) || (w & 3u) == 2u || w == 0x00020000u) break;
+        const u32 count = (w >> 18) & 0x7FFu, method = w & 0x1FFCu, subch = (w >> 13) & 7u;
+        if (subch == 7 || (subch == 1 && s1_2d)) break;   /* driver methods / old 2D split: old loop */
+        if (subch == 0 && (method == 0x64u || method == 0x68u || method == 0x6Cu)) break;
+        const u32 step = type == 0 ? 4u : 0u;
+        if (count && (method + (count - 1) * step >= 0x2000u || po + 4u + count * 4u > 0x100000u)) break;
+        /* the old loop's per-header bookkeeping */
+        s_tr_off[tr_i % GCM_TRACE_N] = off;
+        s_tr_w[tr_i % GCM_TRACE_N] = w;
+        tr_i++;
+        if (trim) { beat++; if (off < put) last_lt = off; }
+        else { s_gcm_drain_beat++; if (off < put) s_last_ring_off = off + 4; s_tr_i = tr_i; }
+        if (count && subch >= 2) {
+            /* 2D engine objects (NV3062 / NV308A / NV309E / NV3089 on subchannels
+             * 2-6): the live engine only stores these words (its register file
+             * above 0x4000 is never read), then gcm_2d_method per word as in the old
+             * loop. Everything queued is dispatched first, so a blit or inline
+             * write (e.g. a fragment-program constant patch) lands after the draws
+             * before it and before the ones after it. */
+            if (q.n == GCM_RUNQ_MAX) { gcm_runq_flush(&q); s_fifo_getoff = off; }
+            rsx_dsp_run* r = &q.r[q.n++];
+            r->method = (subch << 13) | method; r->count = count; r->step = step; r->be = p + 4;
+            gcm_runq_flush(&q);
+            s_fifo_getoff = off;
+            gcm_2d_wt_open();
+            for (u32 i = 0; i < count; i++)
+                gcm_2d_method(subch, method + i * step, gcm_be32(p + 4 + (size_t)i * 4));
+            gcm_2d_wt_close();
+            if (s_fst.on > 0) s_fst.twod_words += count;
+        } else if (count)
+            gcm_fifo_hdr_fast(&q, st, subch, method, count, step, p + 4, off, state_free);
+        off += 4 + count * 4;
+        if (!q.n) s_fifo_getoff = off;      /* nothing pending: consumed up to here */
+        n++;
+    }
+    gcm_runq_flush(&q);
+    s_fifo_getoff = off;
+    if (trim) {
+        s_tr_i = tr_i;
+        if (beat) s_gcm_drain_beat += beat;
+        if (last_lt != 0xFFFFFFFFu) s_last_ring_off = last_lt + 4;
+    }
+    if (s_fst.on > 0 && n) { s_fst.headers += n; s_fst.batches++; }
+    return n;
+}
+
+/* ---- Parallel draw translation, increment 1 (PS3_PAR_DRAW, default on) --------
+ * The ticker walks the FIFO, runs the NV4097 dispatcher, translates every draw to
+ * D3D12 and presents; at the heaviest views it is the frame-rate limit, and ~60% of
+ * it is the per-draw translation. Here the ticker (the PRODUCER) keeps the walk and
+ * the dispatcher -- on a dispatcher of its own, P, a copy of the live engine's --
+ * and a translation thread X does the rest:
+ *   - P's sink callbacks (clear / begin / end / draw batches / inline array / flip)
+ *     write EXEC items: the registers, transform constants and program words P
+ *     changed since the previous item (rsx_dsp_track) plus the callback and its
+ *     arguments. X applies the delta to the live engine's dispatcher and calls the
+ *     live engine's sink (sink_end_impl & co.) -- so the live engine only ever runs
+ *     on X, exactly as it ran on the ticker.
+ *   - everything else the walk EXECUTES (the walker's side-effect methods:
+ *     rsx_process_method, references, reports, back-end semaphores; NV406E
+ *     semaphores; 2D-engine methods incl. the inline transfers that patch fragment
+ *     programs in place and the NV3089 blits; user commands; flips) are items X
+ *     executes in FIFO order with the EXECs -- every guest-visible effect therefore
+ *     happens after the draws before it have read guest memory, and X presents
+ *     right after each flip, as the ticker did. The guest-visible `get` is
+ *     published by X (POS / FLIP records).
+ *   - the producer holds at each flip until X has executed it (PS3_PAR_DRAW_DEPTH,
+ *     default 0): the walk runs ahead only inside the frame, so the title stays as
+ *     far ahead of the presented frame as with the single-thread path.
+ * Mode, owned by the ticker: OFF -> ON at the start of the pass after a
+ * single-thread pass that ended at a flip / caught up (after the guest's first flip;
+ * P = a copy of the live dispatcher); ON -> STOPPING when the switch goes off (at
+ * the end of an emit pass at a frame boundary: P's pending delta goes out as a SYNC
+ * item); STOPPING -> OFF once X has drained the ring (under s_x_lock).
+ * Requires the fast path's conditions, the live engine with its per-word ingress
+ * not serialized, and the boot harness's present hook. PS3_PAR_DRAW=0: never.
+ * PS3_PAR_DRAW_OFF_FILE=<path>: off while <path> exists (checked <= every 250 ms).
+ * PS3_PAR_DRAW_VERIFY=<n>: X also replays the raw method stream into a dispatcher of
+ * its own and compares each EXEC (callback, arguments) and every n-th one's full
+ * dispatcher state with the live engine's after the delta -- [par-verify] lines. */
+#define GCM_PAR_OFF      0
+#define GCM_PAR_ON       1
+#define GCM_PAR_STOPPING 2
+static volatile LONG s_par_mode = GCM_PAR_OFF;
+static volatile LONG s_par_start_req = 0, s_par_stop_req = 0;
+static HANDLE s_x_ev = NULL;            /* wakes X (auto-reset): records published */
+static HANDLE s_p_ev = NULL;            /* wakes the producer waiting for X (auto-reset) */
+static volatile LONG s_p_waiting = 0;
+static SRWLOCK s_x_lock = SRWLOCK_INIT; /* X holds it while it drains */
+static const char* s_gcm_last_why = "caught-up";   /* why the last walker pass ended */
+static ULONGLONG s_flip_word_t = 0;                /* when the walker last decoded a flip word */
+static void (*s_par_present_cb)(void) = NULL;
+static int  (*s_par_pump_cb)(void) = NULL;
+static rsx_dispatch* s_par_P = NULL;    /* producer dispatcher */
+static rsx_dispatch* s_par_V = NULL;    /* X's verification dispatcher (PS3_PAR_DRAW_VERIFY) */
+static rsx_dsp_track s_par_track;
+static u32 s_par_cep = 0, s_par_vep = 0; /* P's epochs at the last EXEC */
+static int s_par_verify = -1;
+static unsigned s_x_last_flip = 0;
+
+void cellGcm_set_par_hooks(void (*present)(void), int (*pump)(void))
+{
+    s_par_present_cb = present;
+    s_par_pump_cb = pump;
+}
+int cellGcm_par_owns_present(void) { return s_par_mode != GCM_PAR_OFF; }
+
+#define GCM_RING_BYTES      (16u << 20)
+#define GCM_BATCH_DATA_MAX  (64u << 10)
+#define GCM_BATCH_ITEMS_MAX 256u
+typedef struct { u32 kind, bytes, a, b, c, end, r0, r1; } gcm_rec;   /* 32 bytes */
+/* BATCH item kinds (rsx_dsp_run.step; plain runs -- verify mode's raw stream --
+ * have step 0 or 4) */
+#define GCM_IT_SIDE 0xFFFFFFFFu   /* walker half of a side-effect word (subch 0/1; count = header offset) */
+#define GCM_IT_2D   0x80000000u   /* | step: gcm_2d_method half of a 2D-engine header (subch in method >> 13) */
+#define GCM_IT_OLD  0x40000000u   /* | subch << 8 | step: old-loop header (walker half); be = [hdr_off][words] */
+#define GCM_IT_SEMA 0x20000000u   /* | step: NV406E semaphore header; be = [hdr_off][words] */
+#define GCM_IT_EXEC 0x10000000u   /* P's sink callback: method = GCM_EX_*, count = payload bytes */
+enum { GCM_EX_SYNC = 0, GCM_EX_CLEAR, GCM_EX_BEGIN, GCM_EX_END, GCM_EX_ARRAYS, GCM_EX_INDEX,
+       GCM_EX_INLINE, GCM_EX_FLIP };
+typedef struct {
+    u32 nregs;                    /* (idx | count << 14, value) pairs follow       */
+    u32 clo, chi;                 /* constant slots [clo, chi) follow (16 B each)  */
+    u32 vlo, vhi;                 /* program words [vlo, vhi) follow                */
+    u32 inl;                      /* inline-array bytes follow (GCM_EX_INLINE)      */
+    u32 a0, a1;                   /* callback arguments                             */
+    u32 in_begin_end, prim, inline_len, inline_dropped;
+    u32 cep_d, vep_d;             /* const_epoch / vp_epoch increments              */
+} gcm_exec_hdr;                   /* 64 bytes */
+
+/* Published counters, one cache line each: producer -> X (wpos), X -> producer (rpos, flips). */
+static struct { _Alignas(64) volatile LONG64 v; char pad_[56]; } s_ring_wpos, s_ring_rpos, s_ring_flips_exec;
+#define s_ring_wposv  s_ring_wpos.v
+#define s_ring_rposv  s_ring_rpos.v
+#define s_flips_exec  s_ring_flips_exec.v
+#if defined(PS3_WASM)
+/* rsx_live_draw.c PS3_WASM_TEXPF: X's frame tag = flip records X executed; P tags its kicks with the FLIP records it
+ * wrote (the same count at the same item); X bumps an effect epoch for every guest-visible item it executes */
+void rsx_live_draw_tpf_effect(void);
+void rsx_live_draw_tpf_kick(const rsx_dispatch* P, unsigned long long tag);
+/* (not a cell* name: tools/gen_hle_nids.py registers every non-static cell* definition as an HLE export, on every
+ * platform -- this one is browser-only) */
+unsigned long long gcm_par_flips_exec_count(void) { return (unsigned long long)__atomic_load_n(&s_flips_exec, __ATOMIC_ACQUIRE); }
+#endif
+static struct {
+    _Alignas(64) u8* base;
+    u64 wcur;                       /* producer: write cursor, published at wpos */
+    gcm_rec* open;                  /* producer: the BATCH being filled */
+    u8* dcur; u8* dend;
+    u32 nit;
+    LONG64 flips_emitted;           /* producer: FLIP records written */
+    rsx_dsp_run it[GCM_BATCH_ITEMS_MAX];
+} s_ring;
+static struct {
+    _Alignas(64) u32 t_get;         /* X: FIFO offset everything before which X executed */
+    u64 signal_rpos;                /* X: rpos at the last wake of a waiting producer */
+} s_ring_t;
+static int gcm_par_depth(void)
+{
+    static int d = -1;
+    if (d < 0) { const char* e = getenv("PS3_PAR_DRAW_DEPTH"); d = e ? atoi(e) : 0; if (d < 0) d = 0; if (d > 8) d = 8; }
+    return d;
+}
+static struct { u64 recs, items, execs, exec_bytes, full_waits, flip_waits, verify_fail, lite_rel, lite_arm, lite_flips, lite_would;
+#if defined(PS3_WASM)
+                u64 w_tmo, w_late, w_rechk;   /* flip-wait re-check stats (gcm_w_flip_wait) */
+#endif
+                LONGLONG t_ticks, w_flip_ticks; } s_sst;
+
+static inline LONG64 gcm_ld64_acq(volatile LONG64* p)
+{
+    const LONG64 v = *p;
+    atomic_thread_fence(memory_order_acquire);
+    return v;
+}
+static u32 gcm_walker_getoff(void) { return *(const volatile u32*)&s_fifo_getoff; }
+/* PS3_WAITFLIP_BUSYX: X has published records it has not executed yet (any thread; PAR mode only) */
+static int gcm_x_has_work(void)
+{
+    if (s_par_mode == GCM_PAR_OFF) return 0;
+    return (u64)gcm_ld64_acq(&s_ring_wposv) != (u64)s_ring_rposv;
+}
+
+static void gcm_kick_all(void)
+{
+    if (s_gcm_kick_ev) SetEvent(s_gcm_kick_ev);
+}
+
+/* Producer: make the records written so far visible to X, and wake it. */
+static void gcm_w_publish(void)
+{
+    if ((u64)s_ring_wposv == s_ring.wcur) return;
+    atomic_thread_fence(memory_order_release);
+    InterlockedExchange64(&s_ring_wposv, (LONG64)s_ring.wcur);
+    if (s_x_ev) SetEvent(s_x_ev);
+}
+
+/* Guest (gcm_walker_wait): a producer held at a flip re-checks at once (PS3_WALKER_LITE). */
+static void gcm_ring_blocked_wake(void)
+{
+    if (s_lite_armed && s_p_waiting && s_p_ev) SetEvent(s_p_ev);
+}
+
+/* Producer: wait for X (ring space / an executed flip) for up to 2 ms, pumping the
+ * window's messages -- the producer is the window thread, and a DXGI call on X may
+ * need it. */
+static void gcm_p_wait(void)
+{
+    InterlockedExchange(&s_p_waiting, 1);
+    WaitForSingleObject(s_p_ev, 2);
+    InterlockedExchange(&s_p_waiting, 0);
+    if (s_par_pump_cb) (void)s_par_pump_cb();
+}
+
+static void gcm_w_close(void);
+
+/* Producer: `bytes` (8-aligned) of contiguous ring space at the write cursor. Pads to
+ * the ring start when the tail is too short; while the ring is full, publishes what
+ * it has and waits for X. */
+static u8* gcm_ring_reserve(u32 bytes)
+{
+    for (;;) {
+        u64 off = s_ring.wcur % GCM_RING_BYTES;
+        const u64 tail = GCM_RING_BYTES - off;
+        const u64 need = bytes + (tail < bytes ? tail : 0);
+        if (s_ring.wcur + need - (u64)gcm_ld64_acq(&s_ring_rposv) <= GCM_RING_BYTES) {
+            if (tail < bytes) {
+                if (tail >= sizeof(gcm_rec)) {
+                    gcm_rec* pr = (gcm_rec*)(s_ring.base + off);
+                    pr->kind = GCM_REC_PAD; pr->bytes = (u32)tail;
+                }
+                s_ring.wcur += tail;
+                off = 0;
+            }
+            return s_ring.base + off;
+        }
+        gcm_w_publish();
+        s_sst.full_waits++;
+        gcm_p_wait();
+    }
+}
+
+static void gcm_w_close(void)
+{
+    gcm_rec* r = s_ring.open;
+    if (!r) return;
+    s_ring.open = NULL;
+    if (!s_ring.nit) return;                          /* empty: the space is reused */
+    u8* items = (u8*)(((uintptr_t)s_ring.dcur + 7u) & ~(uintptr_t)7u);
+    memcpy(items, s_ring.it, (size_t)s_ring.nit * sizeof(rsx_dsp_run));
+    const u8* endp = items + (size_t)s_ring.nit * sizeof(rsx_dsp_run);
+    r->kind = GCM_REC_BATCH;
+    r->a = s_ring.nit;
+    r->c = (u32)(items - (u8*)r);
+    r->bytes = (u32)((endp - (u8*)r + 7) & ~7);
+    s_ring.wcur += r->bytes;
+    s_sst.recs++; s_sst.items += s_ring.nit;
+    s_ring.nit = 0;
+}
+
+/* Producer: room for `nbytes` of data and `nitems` items in the open BATCH (opens a
+ * new one -- larger than usual for an outsized EXEC -- when needed). */
+static u8* gcm_w_data_n(u32 nbytes, u32 nitems)
+{
+    nbytes = (nbytes + 3u) & ~3u;
+    if (!s_ring.open || s_ring.nit + nitems > GCM_BATCH_ITEMS_MAX || s_ring.dcur + nbytes > s_ring.dend) {
+        gcm_w_close();
+        const u32 data = nbytes > GCM_BATCH_DATA_MAX ? nbytes : GCM_BATCH_DATA_MAX;
+        u8* p = gcm_ring_reserve((u32)sizeof(gcm_rec) + data +
+                                 GCM_BATCH_ITEMS_MAX * (u32)sizeof(rsx_dsp_run) + 8u);
+        s_ring.open = (gcm_rec*)p;
+        s_ring.dcur = p + sizeof(gcm_rec);
+        s_ring.dend = s_ring.dcur + data;
+        s_ring.nit = 0;
+    }
+    u8* d = s_ring.dcur;
+    s_ring.dcur += nbytes;
+    return d;
+}
+static inline u8* gcm_w_data(u32 nbytes) { return gcm_w_data_n(nbytes, 1); }
+
+static inline void gcm_w_item(u32 method, u32 count, u32 step, const u8* be)
+{
+    rsx_dsp_run* it = &s_ring.it[s_ring.nit++];
+    it->method = method; it->count = count; it->step = step; it->be = be;
+}
+
+/* PS3_WALKER_LITE (default on; =0 off; PS3_WALKER_LITE_OFF_FILE=<path> live off while <path> exists, checked at most every
+ * 250 ms): the producer's hold at a flip (below) is released -- the walker reads on into the next frame, at most ONE flip
+ * beyond PS3_PAR_DRAW_DEPTH -- only while a guest thread is blocked in gcm_walker_wait for ring space. Then the guest is
+ * idle anyway and the ring bytes it waits for are exactly what the held walker would read: the read-ahead turns the guest's
+ * wait into walker work, and it cannot compete with a running render thread (census23 spawn_unc: RT fifo wait 3.33 ms +
+ * X idle HELD 2.17 ms per frame, the walker held at the flip while X presents). Without a ring-blocked guest (the capped
+ * and the act phases: ~0.1 ms/frame of fifo wait) the walker holds exactly as before, so the unconditional read-ahead's
+ * costs (PS3_WALKER_AHEAD: uncapped spawn 1% low -5.6%) cannot appear there. Uncapped (flip=present): gated by sustained
+ * ring pressure (below); capped (PS3_WALKER_LITE_CAPPED, default 1): per ring-space wait (see gcm_walker_lite). The
+ * title's own bound is unchanged:
+ * SetWaitFlip still waits until at most one flip is unexecuted by X. Released holds per flip in the [fifo-stats] par line. */
+static int gcm_lite_uncapped_clock(void) { return ps3_pacing_active() && ps3_pacing_flip_mode() == PS3_FLIPCLK_PRESENT; }
+static int gcm_walker_lite(void)
+{
+    static int on = -1, off_now = 0; static const char* off = NULL; static ULONGLONG chk = 0;
+    if (on < 0) {
+        const char* e = getenv("PS3_WALKER_LITE");
+        on = !(e && *e == '0');
+        off = getenv("PS3_WALKER_LITE_OFF_FILE"); if (off && !*off) off = NULL;
+        fprintf(stderr, "[par-draw] walker read-ahead while the guest waits for ring space (PS3_WALKER_LITE): %s%s%s\n",
+                on ? "on" : "off", off ? ", live off file " : "", off ? off : "");
+    }
+    if (!on) return 0;
+    /* PS3_WALKER_LITE_CAPPED (default 1): also with a paced (capped) flip clock, there with the per-wait gate
+     * (PS3_WALKER_LITE_ARM_US_CAPPED, default 0 = release at every ring-space wait). =0: uncapped flip clock (flip=present)
+     * only, the capped phases keep the old code path. Basis: exclusive capx (window N) PASS -- act_f120* simulated on-screen
+     * 1% low +6.9%, repeats/1000 0.94 vs 2.56, present-side guard ok, latency +0.5/+0.2 ms, 0 vs 0 frames > 50 ms; two loaded
+     * pool boots (capload1/2, ~95% machine load): no phase failing the per-phase guard in both, frames > 50 ms ON <= OFF. */
+    { static int capped = -1;
+      if (capped < 0) { const char* c = getenv("PS3_WALKER_LITE_CAPPED"); capped = !(c && *c == '0'); }
+      if (!capped && !gcm_lite_uncapped_clock()) return 0; }
+    if (off) {
+        const ULONGLONG now = GetTickCount64();
+        if (now - chk >= 250) {
+            chk = now;
+            const int o = GetFileAttributesA(off) != INVALID_FILE_ATTRIBUTES;
+            if (o != off_now) { off_now = o; fprintf(stderr, "[par-draw] PS3_WALKER_LITE %s (%s)\n", o ? "OFF" : "on", off); }
+        }
+        if (off_now) return 0;
+    }
+    return 1;
+}
+
+/* Producer: hold at a flip until X has executed all but PS3_PAR_DRAW_DEPTH of the
+ * flips written (PS3_WALKER_LITE: but one flip less while the guest waits for ring space). */
+/* PS3_WALKER_LITE ring-pressure gate (walker, once per flip): exponential mean (1/PS3_WALKER_LITE_EMA = 1/64 per flip, ~0.4 s
+ * at 150 fps: sustained pressure, not one long wrap) of the guest's ring-space wait per flip; armed above
+ * PS3_WALKER_LITE_ARM_US (1000) us/flip with the uncapped clock (PS3_WALKER_LITE_ARM_US_CAPPED, default 0, with a capped
+ * one), disarmed below half of it. (1/8 armed on single act wraps: alab6 act 0.03 rel/flip.) Without pressure (act: ~0.1 ms/flip,
+ * capped: 0) nothing of the lever runs -- no release, no guest wake -- only the guest's wait counter. */
+static int gcm_lite_pressure(void)
+{
+    static LONGLONG last = 0; static double ema_us = 0; static int arm_us = -1, arm_cap_us = 0, ema_n = 64; static double tick_us = 0;
+    if (arm_us < 0) {
+        const char* e = getenv("PS3_WALKER_LITE_ARM_US"); arm_us = e ? atoi(e) : 1000; if (arm_us < 0) arm_us = 0;
+        const char* c = getenv("PS3_WALKER_LITE_ARM_US_CAPPED"); arm_cap_us = c ? atoi(c) : 0; if (arm_cap_us < 0) arm_cap_us = 0;
+        fprintf(stderr, "[par-draw] PS3_WALKER_LITE ring-pressure gate: arm above %d us/flip uncapped, %d us/flip capped\n",
+                arm_us, arm_cap_us);
+        const char* n = getenv("PS3_WALKER_LITE_EMA"); if (n) ema_n = atoi(n); if (ema_n < 1) ema_n = 1;
+        LARGE_INTEGER f; QueryPerformanceFrequency(&f); tick_us = 1e6 / (double)f.QuadPart;
+    }
+    static int would = 0;                 /* the gate's own state (hysteresis), also where the lever is off (capped) */
+    const LONGLONG t = s_ring_blocked_ticks;
+    ema_us += ((double)(t - last) * tick_us - ema_us) / (double)ema_n;
+    last = t;
+    const int thr = gcm_lite_uncapped_clock() ? arm_us : arm_cap_us;   /* per flip-clock mode */
+    would = would ? ema_us >= thr * 0.5 : ema_us > thr;
+    s_sst.lite_flips++; s_sst.lite_would += (unsigned)would;   /* counters only: the would-arm fraction per stats window */
+    return would;
+}
+
+static void gcm_w_flip_wait(void)
+{
+    const LONG64 want = s_ring.flips_emitted - gcm_par_depth();
+    const int pressure = gcm_lite_pressure();             /* every flip: also counts where the lever is off */
+    const int lite = gcm_walker_lite() && pressure;
+    if (lite != (int)s_lite_armed) { InterlockedExchange(&s_lite_armed, lite); s_sst.lite_arm += lite ? 1u : 0u; }
+    if (gcm_ld64_acq(&s_flips_exec) >= want) return;
+    LARGE_INTEGER q0; QueryPerformanceCounter(&q0);
+#if defined(PS3_WASM)
+    /* WebAssembly (PS3_PAR_FLIPWAIT_RECHECK, default on): announce the wait, THEN re-check, then sleep. X bumps
+     * s_flips_exec and only then reads s_p_waiting (both seq_cst); the plain loop read s_flips_exec before raising
+     * s_p_waiting, so an X that finished the flip in between sent no SetEvent and the producer slept the full 2 ms
+     * timeout -- the browser's timed-wait floor. With the re-check either X sees the flag and signals, or the
+     * producer sees the count. [fifo-stats] "flip-wait timeouts" counts the waits that still timed out and how many
+     * of those found the flip done (late). */
+    static int s_recheck = -1;
+    if (s_recheck < 0) { const char* e = getenv("PS3_PAR_FLIPWAIT_RECHECK"); s_recheck = !(e && *e == '0'); }
+    if (s_recheck) {
+        while (gcm_ld64_acq(&s_flips_exec) < want && s_par_mode == GCM_PAR_ON) {
+            if (lite && s_ring_blocked && gcm_ld64_acq(&s_flips_exec) >= want - 1) { s_sst.lite_rel++; break; }
+            InterlockedExchange(&s_p_waiting, 1);
+            if (InterlockedExchangeAdd64(&s_flips_exec, 0) < want && s_par_mode == GCM_PAR_ON) {
+                if (WaitForSingleObject(s_p_ev, 2) == WAIT_TIMEOUT) {
+                    s_sst.w_tmo++;
+                    if (gcm_ld64_acq(&s_flips_exec) >= want) s_sst.w_late++;
+                }
+            } else s_sst.w_rechk++;
+            InterlockedExchange(&s_p_waiting, 0);
+            if (s_par_pump_cb) (void)s_par_pump_cb();
+        }
+    } else
+#endif
+    while (gcm_ld64_acq(&s_flips_exec) < want && s_par_mode == GCM_PAR_ON) {
+        if (lite && s_ring_blocked && gcm_ld64_acq(&s_flips_exec) >= want - 1) { s_sst.lite_rel++; break; }
+        gcm_p_wait();
+    }
+    LARGE_INTEGER q1; QueryPerformanceCounter(&q1);
+    s_sst.flip_waits++; s_sst.w_flip_ticks += q1.QuadPart - q0.QuadPart;
+#if defined(PS3_WASM)
+    FT_ADD(FT_W_PFLIP_US, (q1.QuadPart - q0.QuadPart) / 1000);   /* QPC = ns on wasm (win32_compat) */
+#endif
+}
+
+/* Producer: a small record (FLIP / REF / POS) after everything before it. */
+static void gcm_w_small(u32 kind, u32 a, u32 b, u32 end)
+{
+    gcm_w_close();
+    gcm_rec* r = (gcm_rec*)gcm_ring_reserve((u32)sizeof(gcm_rec));
+    r->kind = kind; r->bytes = (u32)sizeof(gcm_rec); r->a = a; r->b = b; r->c = 0; r->end = end;
+    s_ring.wcur += sizeof(gcm_rec);
+    s_sst.recs++;
+}
+
+/* Producer, verify mode: the raw words for X's verification dispatcher. */
+static inline void gcm_w_raw(u32 method, const u8* p, u32 count, u32 step)
+{
+    if (s_par_verify <= 0 || !count) return;
+    u8* d = gcm_w_data(count * 4);
+    memcpy(d, p, (size_t)count * 4);
+    gcm_w_item(method, count, step, d);
+}
+
+/* P's write tracking -> one EXEC item (the producer, inside P's sink callback). */
+static void gcm_par_emit(u32 type, u32 a0, u32 a1, const u8* inl, u32 inl_bytes)
+{
+    rsx_dispatch* P = s_par_P;
+    rsx_dsp_track* t = &s_par_track;
+    u32 clo = P->const_dirty_lo, chi = P->const_dirty_hi;
+    if (chi > RSX_DSP_NUM_CONSTANTS) chi = RSX_DSP_NUM_CONSTANTS;
+    if (chi <= clo) clo = chi = 0;
+    u32 vlo = t->vlo, vhi = t->vhi;
+    if (vhi > RSX_DSP_VP_WORDS) vhi = RSX_DSP_VP_WORDS;
+    if (vhi <= vlo) vlo = vhi = 0;
+    if (!inl) inl_bytes = 0;
+    const u32 bytes = (u32)sizeof(gcm_exec_hdr) + t->n * 8u + (chi - clo) * 16u + (vhi - vlo) * 4u +
+                      ((inl_bytes + 3u) & ~3u);
+    u8* d = gcm_w_data(bytes);
+    gcm_exec_hdr* h = (gcm_exec_hdr*)d;
+    h->nregs = t->n; h->clo = clo; h->chi = chi; h->vlo = vlo; h->vhi = vhi; h->inl = inl_bytes;
+    h->a0 = a0; h->a1 = a1;
+    h->in_begin_end = (u32)P->in_begin_end; h->prim = P->current_primitive;
+    h->inline_len = P->inline_len; h->inline_dropped = P->inline_dropped;
+    h->cep_d = P->const_epoch - s_par_cep; h->vep_d = P->vp_epoch - s_par_vep;
+    s_par_cep = P->const_epoch; s_par_vep = P->vp_epoch;
+    u32* e = (u32*)(d + sizeof(gcm_exec_hdr));
+    for (u32 k = 0; k < t->n; k++) {
+        const u32 idx = t->idx[k];
+        u32 cnt = P->seen[idx] - t->seen0[k];
+        if (cnt > 0x3FFFFu) cnt = 0x3FFFFu;
+        e[2 * k] = idx | (cnt << 14);
+        e[2 * k + 1] = P->regs[idx];
+        t->bits[idx >> 6] &= ~(1ull << (idx & 63u));
+    }
+    u8* q = (u8*)(e + 2 * t->n);
+    if (chi > clo) { memcpy(q, &P->constants[clo][0], (size_t)(chi - clo) * 16u); q += (size_t)(chi - clo) * 16u; }
+    if (vhi > vlo) { memcpy(q, &P->vp[vlo], (size_t)(vhi - vlo) * 4u); q += (size_t)(vhi - vlo) * 4u; }
+    if (inl_bytes) memcpy(q, inl, inl_bytes);
+    gcm_w_item(type, bytes, GCM_IT_EXEC, d);
+    t->n = 0; t->vlo = t->vhi = 0;
+    P->const_dirty_lo = P->const_dirty_hi = 0;
+    s_sst.execs++; s_sst.exec_bytes += bytes;
+}
+static void par_sink_clear(void* u, const rsx_dispatch* r, u32 mask) { (void)u; (void)r; gcm_par_emit(GCM_EX_CLEAR, mask, 0, NULL, 0); }
+static void par_sink_begin(void* u, const rsx_dispatch* r, u32 prim) { (void)u; (void)r; gcm_par_emit(GCM_EX_BEGIN, prim, 0, NULL, 0); }
+#if defined(PS3_WASM)
+static void par_sink_end(void* u, const rsx_dispatch* r)
+{
+    (void)u;
+    /* PS3_WASM_TEXPF (no-op when off); only at depth 0, where P starts a frame after X executed the previous flip */
+    if (gcm_par_depth() == 0) rsx_live_draw_tpf_kick(r, (unsigned long long)s_ring.flips_emitted);
+    gcm_par_emit(GCM_EX_END, 0, 0, NULL, 0);
+}
+#else
+static void par_sink_end(void* u, const rsx_dispatch* r) { (void)u; (void)r; gcm_par_emit(GCM_EX_END, 0, 0, NULL, 0); }
+#endif
+static void par_sink_arrays(void* u, const rsx_dispatch* r, u32 f, u32 c) { (void)u; (void)r; gcm_par_emit(GCM_EX_ARRAYS, f, c, NULL, 0); }
+static void par_sink_index(void* u, const rsx_dispatch* r, u32 f, u32 c) { (void)u; (void)r; gcm_par_emit(GCM_EX_INDEX, f, c, NULL, 0); }
+static void par_sink_inline(void* u, const rsx_dispatch* r, const u8* data, u32 bytes)
+{ (void)u; (void)r; gcm_par_emit(GCM_EX_INLINE, bytes, 0, data, bytes); }
+static void par_sink_flip(void* u, const rsx_dispatch* r, u32 arg) { (void)u; (void)r; gcm_par_emit(GCM_EX_FLIP, arg, 0, NULL, 0); }
+
+/* Producer: words for the live engine -> P (and, verifying, the raw stream). */
+static inline void gcm_w_live_run(u32 method, const u8* p, u32 count, u32 step)
+{
+    gcm_w_raw(method, p, count, step);
+    rsx_dispatch_method_run(s_par_P, method, p, count, step);
+}
+
+/* Producer: one header copied word by word through the IO table, stopping at the
+ * first unmapped word as the old loop does; executed per word by X. Semaphore
+ * headers: one item. Old-loop headers: per word, the live-engine half into P first
+ * (with the old loop's exception: GCM_SET_USER_COMMAND never reaches the live
+ * engine), then that word's walker half as an item -- the old loop's order. */
+static void gcm_w_copy_hdr(u32 kind_step, u32 method, u32 count, u32 hdr_off)
+{
+    u32 n = 0;
+    while (n < count && gcm_io2ea(hdr_off + 4 + n * 4)) n++;
+    const u32 subch = (kind_step >> 8) & 7u, step = kind_step & 4u;
+    if (!(kind_step & GCM_IT_OLD)) {
+        u8* d = gcm_w_data(4 + n * 4);
+        { const u32 h = ps3_bswap32(hdr_off); memcpy(d, &h, 4); }
+        for (u32 i = 0; i < n; i++) {
+            const u32 raw = ps3_bswap32(vm_read32(gcm_io2ea(hdr_off + 4 + i * 4)));
+            memcpy(d + 4 + (size_t)i * 4, &raw, 4);
+        }
+        gcm_w_item(method, n, kind_step, d);
+        return;
+    }
+    for (u32 i = 0; i < n; i++) {
+        const u32 m = method + i * step;
+        const u32 raw = ps3_bswap32(vm_read32(gcm_io2ea(hdr_off + 4 + i * 4)));
+        if (s_gcm_live && !(subch == 7 && m == 0x0B00u))
+            gcm_w_live_run((subch << 13) | m, (const u8*)&raw, 1, 4u);
+        u8* d = gcm_w_data(8);
+        { const u32 h = ps3_bswap32(hdr_off); memcpy(d, &h, 4); }
+        memcpy(d + 4, &raw, 4);
+        gcm_w_item(m, 1, (kind_step & ~4u), d);   /* one word: step irrelevant */
+    }
+}
+
+/* Producer: one subchannel-0/1 header of the batch (cf. gcm_fifo_hdr_fast): the
+ * live-engine half into P (EXECs come out of its sink), the walker half of each
+ * side-effect word as an item right after. */
+static inline void gcm_w_hdr(u32 subch, u32 method, u32 count, u32 step, const u8* p, u32 hdr_off,
+                             int state_free)
+{
+    const u32 mbase = (subch << 13) | method;
+    u32 i = 0, side = 0;
+    while (i < count) {
+        u32 j = i;
+        if (state_free) {
+            if (step) { while (j < count && !s_gcm_fx[(method >> 2) + j]) j++; }
+            else if (!s_gcm_fx[method >> 2]) j = count;
+        }
+        if (j > i) {
+            gcm_w_live_run(mbase + i * step, p + (size_t)i * 4, j - i, step);
+            i = j;
+            if (i == count) break;
+        }
+        gcm_w_live_run(mbase + i * step, p + (size_t)i * 4, 1, 4u);
+        u8* d = gcm_w_data(4);
+        memcpy(d, p + (size_t)i * 4, 4);
+        gcm_w_item(mbase + i * step, hdr_off, GCM_IT_SIDE, d);
+        side++;
+        i++;
+    }
+    if (s_fst.on > 0) { s_fst.side_words += side; s_fst.fast_words += count - side; }
+}
+
+/* Producer: gcm_fifo_batch's walk, emitting instead of executing. */
+static u32 gcm_fifo_batch_emit(u32 put, int s1_2d, u32 max)
+{
+    u32 off = s_fifo_getoff;
+    const u32 ea = gcm_io2ea(off);
+    if (!ea || !max) return 0;
+    const u8* pbase = vm_base + (ea & ~0xFFFFFu);
+    const u32 page = off >> 20;
+    const int state_free = rsx_backend_state_free();
+    u32 n = 0;
+    while (n < max) {
+        if (off == put || (off >> 20) != page) break;
+        { const LONG tk = s_wrap_taken;
+          if (tk != s_wrap_posted && off == s_wrap_src[(u32)tk % GCM_WRAP_SLOTS]) break; }
+        const u32 po = off & 0xFFFFFu;
+        if (po > 0x100000u - 4u) break;
+        const u8* p = pbase + po;
+        const u32 w = gcm_be32(p);
+        const u32 type = w >> 29;
