+            case 3:                       /* underflow: results in the denormal range get flushed */
+                if (mul || fma) { a = mkd(s1, 480 + (int)(rnd() % 60), rdfrac()); b = mkd(s2, 480 + (int)(rnd() % 60), rdfrac());
