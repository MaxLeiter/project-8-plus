+    const char* (*key_name)(uint32_t code);
+    uint32_t    (*key_label)(uint32_t code, char* out, uint32_t cap);
+
+    /* -- texture redirect (ABI 1.3) ------------------------------------------------
+     * Sample the DDS file path_utf8 for every guest texture whose texrepl key is `key`
+     * (rsx_texrepl.h KEY), instead of what the texture packs give it or the original;
