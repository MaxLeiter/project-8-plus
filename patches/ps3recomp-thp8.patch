+
+static void hle_trim_poll(void)
+{
+    static volatile unsigned long long s_next;
+    const unsigned long long now = hle_now_ms();
+    if (now < s_next) return;
+    s_next = now + 250;
+    const int want = hle_path_exists(s_hle_trim_off) ? 3 : 2;
+    if (__atomic_exchange_n(&g_ps3_hle_lean_mode[0], want, __ATOMIC_RELAXED) != want)
+        fprintf(stderr, "[hle-trim] %s\n", want == 2 ? "on (PS3_HLE_TRIM_OFF_FILE absent): lean import path"
+                                                     : "off (PS3_HLE_TRIM_OFF_FILE present): full import path");
+}
