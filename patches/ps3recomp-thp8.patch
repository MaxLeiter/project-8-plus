+/*
+ * ps3recomp - optional host graphics upgrades for the D3D12 live-draw backend
+ * (options + present pass). See rsx_live_gfx.h. Everything defaults to off.
+ */
+#define _CRT_SECURE_NO_WARNINGS
+#include "rsx_live_gfx.h"
+
+#include <ctype.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+/* ---------------------------------------------------------------------------
+ * options
+ * -----------------------------------------------------------------------*/
+static ldgfx_options s_opt;
+static int s_opt_loaded = 0;
+static float s_scale_target_w = 0.0f, s_scale_target_h = 0.0f;   /* "WxH" form */
+
+/* Environment first (GetEnvironmentVariableA, so a plugin that sets a value
+ * with SetEnvironmentVariableA before the renderer starts is seen even if it
+ * links another CRT), then the ini. Returns 1 = env, 2 = ini, 0 = unset. */
+static char s_ini_path[1024];
+static int s_ini_present = 0;
+
+static int opt_raw(const char* key, char* out, size_t cap)
+{
+    char env[64];
+    snprintf(env, sizeof env, "PS3_GFX_%s", key);
+#if defined(_WIN32)
+    DWORD n = GetEnvironmentVariableA(env, out, (DWORD)cap);
+    if (n > 0 && n < cap) return 1;
+    if (s_ini_present) {
+        char lower[64];
+        size_t i = 0;
+        for (; key[i] && i + 1 < sizeof lower; i++) lower[i] = (char)tolower((unsigned char)key[i]);
+        lower[i] = 0;
+        n = GetPrivateProfileStringA("graphics", lower, "", out, (DWORD)cap, s_ini_path);
+        if (n > 0) return 2;
+    }
+#else
+    const char* e = getenv(env);
+    if (e && *e) { snprintf(out, cap, "%s", e); return 1; }
+#endif
+    out[0] = 0;
+    return 0;
+}
+
+static void opt_trim(char* s)
+{
+    size_t n = strlen(s);
+    while (n && isspace((unsigned char)s[n - 1])) s[--n] = 0;
+    size_t i = 0;
+    while (s[i] && isspace((unsigned char)s[i])) i++;
+    if (i) memmove(s, s + i, n - i + 1);
+    for (char* p = s; *p; p++) *p = (char)tolower((unsigned char)*p);
+}
+
+static float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
+
+static void parse_scale(const char* v)
+{
+    float a = 0, b = 0;
+    if (!strcmp(v, "auto")) { s_opt.scale_auto = 1; return; }
+    s_opt.scale_auto = 0;
+    if (sscanf(v, "%fx%f", &a, &b) == 2 && a >= 64 && b >= 64) {
+        s_scale_target_w = a; s_scale_target_h = b;     /* resolved against the canvas */
+        return;
+    }
+    s_scale_target_w = s_scale_target_h = 0.0f;
+    if (sscanf(v, "%f", &a) == 1 && a > 0) {
+        a = clampf(a, 1.0f, 6.0f);
+        s_opt.scale_x = s_opt.scale_y = a;
+    }
+}
+
+static u32 parse_pow2(const char* v, u32 lo, u32 hi)
+{
+    u32 n = (u32)strtoul(v, NULL, 10), p = 1;
+    if (n < lo) n = lo;
+    if (n > hi) n = hi;
+    while (p * 2 <= n) p *= 2;
+    return p;
+}
+
+static void apply_preset(const char* p)
+{
+    if (!strcmp(p, "high")) {
+        s_opt.scale_x = s_opt.scale_y = 2.0f;
+        s_opt.aa = LDGFX_AA_FXAA;
+        s_opt.aniso = 16;
+        s_opt.shadow_scale = 2;
+        s_opt.shadow_filter = LDGFX_SHADOW_PCF;
+        s_opt.shadow_radius = 1;
+        s_opt.kick = 128;
+        s_opt.ssaa = 1.5f;
+        s_opt.sharpen = 35;
+    } else if (!strcmp(p, "ultra")) {
+        s_opt.scale_auto = 1;
+        s_opt.aa = LDGFX_AA_FXAA;
+        s_opt.aniso = 16;
+        s_opt.shadow_scale = 4;
+        s_opt.shadow_filter = LDGFX_SHADOW_PCSS;
+        s_opt.shadow_radius = 2;
+        s_opt.kick = 128;
+        s_opt.ssaa = 1.5f;   /* 2 = ~6.6-7.5 ms GPU at 5120x1440: no 120 fps margin */
+        s_opt.sharpen = 35;
+    }
+#if defined(PS3_WASM)
+    /* Browser build: no command-list kicks. Each one is a full submit to the WebGPU device worker, which replays lists
+     * one after another, so there is no GPU overlap to win and every kick is overhead (slot I, preset high: kick 0
+     * 42.5 fps median vs 40.4 with 128, submits 2 vs 14.5 per frame). PS3_GFX_KICK, read after the preset, still wins. */
+    s_opt.kick = 0;
+#endif
+}
+
+static void* s_resolve_hwnd;
+static u32 s_resolve_w, s_resolve_h;
+static int s_live = -1;
+/* PS3_GFX_VIS_OFF_FILE=<path> (A/B benches): while <path> exists the visuals
+ * options (SSAA, SHARPEN) are off; polled with the PS3_GFX_LIVE reload. */
+static char s_ab_path[1024];
+static int s_ab_init = 0, s_ab_off = 0;
+static int ab_off_now(void)
+{
+#if defined(_WIN32)
+    if (!s_ab_init) {
+        DWORD n = GetEnvironmentVariableA("PS3_GFX_VIS_OFF_FILE", s_ab_path, sizeof s_ab_path);
+        if (!(n > 0 && n < sizeof s_ab_path)) s_ab_path[0] = 0;
+        s_ab_init = 1;
+    }
+    return s_ab_path[0] && GetFileAttributesA(s_ab_path) != INVALID_FILE_ATTRIBUTES;
+#else
+    return 0;
+#endif
+}
+#if defined(_WIN32)
+static FILETIME s_ini_mtime;
+#endif
+
+const ldgfx_options* ldgfx_opts(void)
+{
+    if (s_opt_loaded) return &s_opt;
+#if defined(_WIN32)
+    if (s_live < 0) {
+        char lv[8];
+        DWORD n = GetEnvironmentVariableA("PS3_GFX_LIVE", lv, sizeof lv);
+        s_live = (n > 0 && n < sizeof lv && lv[0] != '0') ? 1 : 0;
+    }
+#else
+    s_live = 0;
+#endif
+    memset(&s_opt, 0, sizeof s_opt);
+    s_opt.scale_x = s_opt.scale_y = 1.0f;
+    s_opt.shadow_scale = 1;
+    s_opt.shadow_filter = LDGFX_SHADOW_HW;
+    s_opt.shadow_radius = 1;
+    s_opt.pcss_k = 4000;
+    s_opt.aniso = 1;
+    s_opt.aa = LDGFX_AA_OFF;
+    s_opt.ssaa = 1.0f;
+    s_opt.sharpen = 0;
+#if defined(_WIN32)
+    {
+        DWORD n = GetEnvironmentVariableA("PS3_GFX_INI", s_ini_path, sizeof s_ini_path);
+        if (!(n > 0 && n < sizeof s_ini_path)) {
+            n = GetModuleFileNameA(NULL, s_ini_path, sizeof s_ini_path);
+            char* slash = n ? strrchr(s_ini_path, '\\') : NULL;
+            if (slash && (size_t)(slash - s_ini_path) + 14 < sizeof s_ini_path)
+                strcpy(slash + 1, "graphics.ini");
+            else
+                s_ini_path[0] = 0;
+        }
+        WIN32_FILE_ATTRIBUTE_DATA fa;
+        s_ini_present = s_ini_path[0] &&
+                        GetFileAttributesExA(s_ini_path, GetFileExInfoStandard, &fa);
+        if (s_ini_present) s_ini_mtime = fa.ftLastWriteTime;
+        /* GetPrivateProfileString looks a path without a drive up in the
+         * Windows directory: make it absolute. */
+        if (s_ini_present) {
+            char full[1024];
+            if (GetFullPathNameA(s_ini_path, sizeof full, full, NULL))
+                snprintf(s_ini_path, sizeof s_ini_path, "%s", full);
+        }
+    }
+#endif
+    int src_env = 0, src_ini = 0;
+    char v[256];
+    int r;
+#define OPT(key) ((r = opt_raw(key, v, sizeof v)) ? (opt_trim(v), (r == 1 ? src_env++ : src_ini++), 1) : 0)
+    if (OPT("PRESET")) apply_preset(v);
+    if (OPT("SCALE")) parse_scale(v);
+    if (OPT("AA")) s_opt.aa = (!strcmp(v, "fxaa") || !strcmp(v, "1") || !strcmp(v, "on"))
+                              ? LDGFX_AA_FXAA
+                            : (!strcmp(v, "fxaa_all") || !strcmp(v, "2")) ? LDGFX_AA_FXAA_ALL
+                                                                         : LDGFX_AA_OFF;
+    if (OPT("ANISO")) s_opt.aniso = parse_pow2(v, 1, 16);
+    if (OPT("SHADOW_SCALE")) s_opt.shadow_scale = parse_pow2(v, 1, 4);
+    if (OPT("SHADOW_FILTER"))
+        s_opt.shadow_filter = !strcmp(v, "pcss") ? LDGFX_SHADOW_PCSS
+                            : !strcmp(v, "pcf")  ? LDGFX_SHADOW_PCF
+                                                 : LDGFX_SHADOW_HW;
+    if (OPT("SHADOW_RADIUS")) {
+        u32 n = (u32)strtoul(v, NULL, 10);
+        s_opt.shadow_radius = n < 1 ? 1 : n > 4 ? 4 : n;
+    }
+    if (OPT("KICK")) {
+        u32 n = (u32)strtoul(v, NULL, 10);
+        s_opt.kick = n == 0 ? 0 : n < 16 ? 16 : n > 100000 ? 100000 : n;
+    }
+    if (OPT("PCSS_K")) {
+        u32 n = (u32)strtoul(v, NULL, 10);
+        s_opt.pcss_k = n < 1 ? 1 : n > 1000000 ? 1000000 : n;
+    }
+    if (OPT("SSAA")) {
+        float f = 1.0f;
+        if (sscanf(v, "%f", &f) == 1) s_opt.ssaa = clampf(f, 1.0f, 2.0f);
+    }
+    if (OPT("SHARPEN")) {
+        u32 n = (u32)strtoul(v, NULL, 10);
+        s_opt.sharpen = n > 100 ? 100 : n;
+    }
+#undef OPT
+    s_ab_off = ab_off_now();
+    if (s_ab_off) { s_opt.ssaa = 1.0f; s_opt.sharpen = 0; }
+    snprintf(s_opt.source, sizeof s_opt.source, "%s",
+             src_env && src_ini ? "ini+env" : src_env ? "env" : src_ini ? "ini" : "default");
+    s_opt_loaded = 1;
+    return &s_opt;
+}
+
+int ldgfx_poll_reload(void)
+{
+#if defined(_WIN32)
+    ldgfx_opts();
+    const int ab_flip = s_ab_path[0] && ab_off_now() != s_ab_off;
+    if (!ab_flip) {
+        if (s_live != 1 || !s_ini_present) return 0;
+        WIN32_FILE_ATTRIBUTE_DATA fa;
+        if (!GetFileAttributesExA(s_ini_path, GetFileExInfoStandard, &fa)) return 0;
+        if (CompareFileTime(&fa.ftLastWriteTime, &s_ini_mtime) == 0) return 0;
+    }
+    const ldgfx_options before = s_opt;
+    s_opt_loaded = 0;
+    ldgfx_opts();
+    if (s_resolve_w) ldgfx_resolve_auto_scale(s_resolve_hwnd, s_resolve_w, s_resolve_h);
+    if (ab_flip) fprintf(stderr, "[gfx] visuals A/B file %s: options reloaded\n", s_ab_path);
+    else fprintf(stderr, "[gfx] %s changed: options reloaded\n", s_ini_path);
+    ldgfx_log_options();
+    return memcmp(&before, &s_opt, sizeof s_opt) != 0;
+#else
+    return 0;
+#endif
+}
+
+int ldgfx_live(void) { ldgfx_opts(); return s_live == 1; }
+
+int ldgfx_polling(void) { ldgfx_opts(); return s_live == 1 || s_ab_path[0] != 0; }
+
+void ldgfx_resolve_auto_scale(void* hwnd, u32 guest_w, u32 guest_h)
+{
+    ldgfx_opts();
+    if (!guest_w || !guest_h) return;
+    s_resolve_hwnd = hwnd; s_resolve_w = guest_w; s_resolve_h = guest_h;
+    float tw = s_scale_target_w, th = s_scale_target_h;
+#if defined(_WIN32)
+    if (s_opt.scale_auto) {
+        MONITORINFO mi;
+        mi.cbSize = sizeof mi;
+        HMONITOR mon = MonitorFromWindow(hwnd ? (HWND)hwnd : GetDesktopWindow(),
+                                         MONITOR_DEFAULTTONEAREST);
+        if (mon && GetMonitorInfoA(mon, &mi)) {
+            tw = (float)(mi.rcMonitor.right - mi.rcMonitor.left);
+            th = (float)(mi.rcMonitor.bottom - mi.rcMonitor.top);
+            char keep[8];
+            DWORD n = GetEnvironmentVariableA("PS3_FULLSCREEN_ASPECT", keep, sizeof keep);
+            if (n > 0 && n < sizeof keep && keep[0] && keep[0] != '0') {
+                /* the window keeps the guest aspect: uniform scale */
+                const float k = fminf(tw / (float)guest_w, th / (float)guest_h);
+                tw = k * (float)guest_w;
+                th = k * (float)guest_h;
+            }
+        }
+    }
+#elif defined(PS3_WASM)
+    /* Browser build: "auto" = the canvas backing size (CSS size x devicePixelRatio, from the device worker), the
+     * output the present pass resolves to -- per axis, never below the scale already chosen (a preset's 2x): a canvas
+     * still at the guest size keeps the preset's detail, a 32:9 one (5120x1300) gets 4x2 as natively; unknown canvas =
+     * that scale. */
+    (void)hwnd;
+    if (s_opt.scale_auto) {
+        extern int wgs_canvas_size(unsigned* w, unsigned* h);
+        unsigned cw = 0, ch = 0;
+        if (wgs_canvas_size(&cw, &ch) && cw && ch) {
+            tw = fmaxf((float)cw, s_opt.scale_x * (float)guest_w);
+            th = fmaxf((float)ch, s_opt.scale_y * (float)guest_h);
+            fprintf(stderr, "[gfx] render scale auto: canvas %ux%u -> %.3gx%.3g\n", cw, ch,
+                    tw / (float)guest_w, th / (float)guest_h);
+        } else {
+            fprintf(stderr, "[gfx] render scale auto: canvas not known yet -- keeping %.3gx%.3g\n",
+                    s_opt.scale_x, s_opt.scale_y);
+        }
+    }
+#else
+    (void)hwnd;
+#endif
+    if (tw > 0 && th > 0) {
+        s_opt.scale_x = clampf(tw / (float)guest_w, 1.0f, 6.0f);
+        s_opt.scale_y = clampf(th / (float)guest_h, 1.0f, 6.0f);
+    }
+    s_opt.scale_auto = 0;
+    s_scale_target_w = s_scale_target_h = 0.0f;
+    /* PS3_GFX_SSAA: supersample on top of the resolved scale (up to 8x per
+     * axis and 40 Mpixel for the canvas -- an 8K frame is 33 Mpixel). */
+    if (s_opt.ssaa > 1.0f) {
+        float k = s_opt.ssaa;
+        const float px = (float)guest_w * (float)guest_h * s_opt.scale_x * s_opt.scale_y;
+        if (px * k * k > 40.0e6f) k = sqrtf(40.0e6f / px);
+        if (k > 1.0f) {
+            s_opt.scale_x = clampf(s_opt.scale_x * k, 1.0f, 8.0f);
+            s_opt.scale_y = clampf(s_opt.scale_y * k, 1.0f, 8.0f);
+        }
+    }
+#if defined(PS3_WASM)
+    /* Browser build: a WebGPU device guarantees 8192 texels per texture side (maxTextureDimension2D), and the
+     * canvas-sized render targets are the largest ones scaled */
+    {
+        const float mx = 8192.0f / (float)guest_w, my = 8192.0f / (float)guest_h;
+        if (s_opt.scale_x > mx || s_opt.scale_y > my) {
+            s_opt.scale_x = clampf(s_opt.scale_x, 1.0f, mx);
+            s_opt.scale_y = clampf(s_opt.scale_y, 1.0f, my);
+            fprintf(stderr, "[gfx] render scale capped to %.3gx%.3g (WebGPU: 8192 per texture side)\n",
+                    s_opt.scale_x, s_opt.scale_y);
+        }
+    }
+#endif
+}
+
+void ldgfx_disable_present_features(void)
+{
+    ldgfx_opts();
+    if (s_opt.scale_x != 1.0f || s_opt.scale_y != 1.0f || s_opt.aa != LDGFX_AA_OFF)
+        fprintf(stderr, "[gfx] present pass unavailable: render scale and AA disabled\n");
+    s_opt.scale_x = s_opt.scale_y = 1.0f;
+    s_opt.aa = LDGFX_AA_OFF;
+}
+
+int ldgfx_scaling(void)
+{
+    const ldgfx_options* o = ldgfx_opts();
+    return o->scale_x != 1.0f || o->scale_y != 1.0f;
+}
+
+int ldgfx_present_pass_wanted(void)
+{
+    const ldgfx_options* o = ldgfx_opts();
+    return ldgfx_scaling() || o->aa != LDGFX_AA_OFF || o->sharpen || o->ssaa > 1.0f;
+}
+
+int ldgfx_any(void)
+{
+    const ldgfx_options* o = ldgfx_opts();
+    return ldgfx_present_pass_wanted() || o->aniso > 1 || o->shadow_scale > 1 ||
+           o->shadow_filter != LDGFX_SHADOW_HW || o->kick;
+}
+
+void ldgfx_log_options(void)
+{
+    const ldgfx_options* o = ldgfx_opts();
+    static const char* sf[] = { "hw", "pcf", "pcss" };
+    fprintf(stderr,
+            "[gfx] options (%s%s%s): scale=%.3gx%.3g aa=%s aniso=%ux shadow_scale=%ux "
+            "shadow_filter=%s radius=%u pcss_k=%u kick=%u ssaa=%.3g sharpen=%u%s\n",
+            o->source, s_ini_present ? ", ini " : "", s_ini_present ? s_ini_path : "",
+            o->scale_x, o->scale_y,
+            o->aa == LDGFX_AA_FXAA_ALL ? "fxaa_all" : o->aa ? "fxaa" : "off", o->aniso, o->shadow_scale,
+            sf[o->shadow_filter < 3 ? o->shadow_filter : 0], o->shadow_radius, o->pcss_k, o->kick,
+            o->ssaa, o->sharpen, ldgfx_any() ? "" : " (vanilla)");
+}
+
+/* ---------------------------------------------------------------------------
+ * WPOS rewrite
+ * -----------------------------------------------------------------------*/
+int ldgfx_hlsl_scale_wpos(char* hlsl, size_t cap, float kx, float ky)
+{
+    static const char needle[] = "input.position";
+    static const char repl[] = "rsx_wpos";
+    char* m = strstr(hlsl, " main(PSInput input)");
+    if (!m) return 0;
+    char* brace = strchr(m, '{');
+    if (!brace) return 0;
+    if (!strstr(brace, needle)) return 0;
+    int n = 0;
+    for (char* p = strstr(brace, needle); p; p = strstr(p, needle)) {
+        const size_t nl = sizeof needle - 1, rl = sizeof repl - 1;
+        memcpy(p, repl, rl);
+        memmove(p + rl, p + nl, strlen(p + nl) + 1);
+        p += rl;
+        n++;
+    }
+    char decl[160];
+    const int dl = snprintf(decl, sizeof decl,
+                            "\n    float4 rsx_wpos = input.position * float4(%.9g, %.9g, 1.0, 1.0);",
+                            1.0 / (double)kx, 1.0 / (double)ky);
+    const size_t used = strlen(hlsl);
+    if (dl <= 0 || used + (size_t)dl + 1 > cap) return -1;
+    memmove(brace + 1 + dl, brace + 1, used - (size_t)(brace + 1 - hlsl) + 1);
+    memcpy(brace + 1, decl, (size_t)dl);
+    return n;
+}
+
+/* ---------------------------------------------------------------------------
+ * present pass (Windows / D3D12; the browser build: D3D12 over WebGPU)
+ * -----------------------------------------------------------------------*/
+#if defined(_WIN32) || defined(PS3_WASM)
+#if !defined(PS3_WASM)
+#include <d3dcompiler.h>
+#endif
+
+static const char s_present_hlsl[] =
+"cbuffer P : register(b0) { float4 src_size; float4 dst_size; float4 prm; };\n"
+"Texture2D src : register(t0);\n"
+"SamplerState s_lin : register(s0);\n"
+"struct V { float4 pos : SV_Position; float2 uv : TEXCOORD0; };\n"
+"V vs_main(uint id : SV_VertexID) {\n"
+"    V o; float2 t = float2((id << 1) & 2, id & 2);\n"
+"    o.uv = t; o.pos = float4(t.x * 2.0 - 1.0, 1.0 - t.y * 2.0, 0.0, 1.0); return o;\n"
+"}\n"
+"float3 tap(float2 uv) { return src.SampleLevel(s_lin, uv, 0).rgb; }\n"
+"float luma(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }\n"
+/* FXAA (quality-style): local contrast gate, edge orientation from the 3x3
+ * second derivatives, end-of-edge search on both sides, blend towards the
+ * edge by the distance to its nearer end, plus a sub-pixel term (kept at 0.5
+ * so HUD text stays crisp). */
+"float4 ps_fxaa(V i) : SV_Target {\n"
+"    float2 px = src_size.zw; float2 uv = i.uv;\n"
+"    float3 cM = tap(uv); float lM = luma(cM);\n"
+"    float lN = luma(tap(uv + float2(0, -px.y))), lS = luma(tap(uv + float2(0, px.y)));\n"
+"    float lW = luma(tap(uv + float2(-px.x, 0))), lE = luma(tap(uv + float2(px.x, 0)));\n"
+"    float lMax = max(lM, max(max(lN, lS), max(lW, lE)));\n"
+"    float lMin = min(lM, min(min(lN, lS), min(lW, lE)));\n"
+"    float range = lMax - lMin;\n"
+"    if (range < max(0.0312, lMax * 0.125)) return float4(cM, 1.0);\n"
+"    float lNW = luma(tap(uv + float2(-px.x, -px.y))), lNE = luma(tap(uv + float2(px.x, -px.y)));\n"
+"    float lSW = luma(tap(uv + float2(-px.x, px.y))), lSE = luma(tap(uv + float2(px.x, px.y)));\n"
+"    float edgeH = abs(lNW - 2.0 * lW + lSW) + 2.0 * abs(lN - 2.0 * lM + lS) + abs(lNE - 2.0 * lE + lSE);\n"
+"    float edgeV = abs(lNW - 2.0 * lN + lNE) + 2.0 * abs(lW - 2.0 * lM + lE) + abs(lSW - 2.0 * lS + lSE);\n"
+"    bool horz = edgeH >= edgeV;\n"
+"    float l1 = horz ? lN : lW, l2 = horz ? lS : lE;\n"
+"    float g1 = abs(l1 - lM), g2 = abs(l2 - lM);\n"
+"    float gs = 0.25 * max(g1, g2);\n"
+"    float stepLen = horz ? px.y : px.x;\n"
+"    float lLocal;\n"
+"    if (g1 >= g2) { stepLen = -stepLen; lLocal = 0.5 * (l1 + lM); } else { lLocal = 0.5 * (l2 + lM); }\n"
+"    float2 cur = uv;\n"
+"    if (horz) cur.y += stepLen * 0.5; else cur.x += stepLen * 0.5;\n"
+"    float2 off = horz ? float2(px.x, 0) : float2(0, px.y);\n"
+"    float2 uv1 = cur - off, uv2 = cur + off;\n"
+"    float e1 = luma(tap(uv1)) - lLocal, e2 = luma(tap(uv2)) - lLocal;\n"
+"    bool r1 = abs(e1) >= gs, r2 = abs(e2) >= gs;\n"
+"    [loop] for (int k = 0; k < 10; k++) {\n"
+"        if (r1 && r2) break;\n"
+"        float q = k < 3 ? 1.0 : (k < 6 ? 1.5 : (k < 8 ? 2.0 : 4.0));\n"
+"        if (!r1) { uv1 -= off * q; e1 = luma(tap(uv1)) - lLocal; r1 = abs(e1) >= gs; }\n"
+"        if (!r2) { uv2 += off * q; e2 = luma(tap(uv2)) - lLocal; r2 = abs(e2) >= gs; }\n"
+"    }\n"
+"    float d1 = horz ? (uv.x - uv1.x) : (uv.y - uv1.y);\n"
+"    float d2 = horz ? (uv2.x - uv.x) : (uv2.y - uv.y);\n"
+"    bool closer1 = d1 < d2;\n"
+"    float pixOff = 0.5 - min(d1, d2) / max(d1 + d2, 1e-6);\n"
+"    bool mSmaller = lM < lLocal;\n"
+"    float fin = (((closer1 ? e1 : e2) < 0.0) != mSmaller) ? pixOff : 0.0;\n"
+"    float lAvg = (2.0 * (lN + lS + lW + lE) + (lNW + lNE + lSW + lSE)) / 12.0;\n"
+"    float sub = saturate(abs(lAvg - lM) / range);\n"
+"    sub = (-2.0 * sub + 3.0) * sub * sub;\n"
+"    fin = max(fin, sub * sub * 0.5);\n"
+"    float2 fuv = uv;\n"
+"    if (horz) fuv.y += fin * stepLen; else fuv.x += fin * stepLen;\n"
+"    return float4(tap(fuv), 1.0);\n"
+"}\n"
+/* Resample to the window: Catmull-Rom (9 bilinear taps) when no axis
+ * shrinks; else an area filter over the output pixel's footprint, averaged in
+ * approximate linear light. Per axis: an even integer ratio (2, 4, ...) uses
+ * ratio/2 bilinear taps on texel corners (each one an exact 2x2 average, so
+ * the whole is the exact box); any other ratio (1.5x supersampling, a window
+ * Windows shrank to fit) ceil(ratio) taps spread evenly over the footprint, so
+ * every output pixel averages the same area whatever its phase (one centred
+ * bilinear tap at 1.5x would reduce to a single texel at some phases). */
+"float3 catmull(float2 uv) {\n"
+"    float2 sp = uv * src_size.xy; float2 tc = floor(sp - 0.5) + 0.5; float2 f = sp - tc;\n"
+"    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));\n"
+"    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);\n"
+"    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));\n"
+"    float2 w3 = f * f * (-0.5 + 0.5 * f);\n"
+"    float2 w12 = w1 + w2; float2 o12 = w2 / w12;\n"
+"    float2 t0 = (tc - 1.0) * src_size.zw, t3 = (tc + 2.0) * src_size.zw;\n"
+"    float2 t12 = (tc + o12) * src_size.zw;\n"
+"    float3 r = tap(float2(t0.x, t0.y)) * (w0.x * w0.y) + tap(float2(t12.x, t0.y)) * (w12.x * w0.y)\n"
+"             + tap(float2(t3.x, t0.y)) * (w3.x * w0.y)\n"
+"             + tap(float2(t0.x, t12.y)) * (w0.x * w12.y) + tap(float2(t12.x, t12.y)) * (w12.x * w12.y)\n"
+"             + tap(float2(t3.x, t12.y)) * (w3.x * w12.y)\n"
+"             + tap(float2(t0.x, t3.y)) * (w0.x * w3.y) + tap(float2(t12.x, t3.y)) * (w12.x * w3.y)\n"
+"             + tap(float2(t3.x, t3.y)) * (w3.x * w3.y);\n"
+"    return saturate(r);\n"
+"}\n"
+/* Contrast-adaptive sharpening (after FXAA / resampling, same size in and
+ * out): a negative-lobe cross filter whose lobe weight shrinks where the 3x3
+ * neighbourhood already spans the full range (edges, text), so flat and
+ * soft areas get crisper without halos or ringing. prm.x = lobe strength
+ * (0 = none, 1 = strongest, -1/5 of the centre per neighbour). */
+"float4 ps_cas(V i) : SV_Target {\n"
+"    float2 px = src_size.zw; float2 uv = i.uv;\n"
+"    float3 e = tap(uv);\n"
+"    float3 b = tap(uv + float2(0, -px.y)), h = tap(uv + float2(0, px.y));\n"
+"    float3 d = tap(uv + float2(-px.x, 0)), f = tap(uv + float2(px.x, 0));\n"
+"    float3 a = tap(uv - px), c = tap(uv + float2(px.x, -px.y));\n"
+"    float3 g = tap(uv + float2(-px.x, px.y)), k = tap(uv + px);\n"
+"    float3 mn = min(e, min(min(b, d), min(f, h)));\n"
+"    float3 mx = max(e, max(max(b, d), max(f, h)));\n"
+"    mn += min(mn, min(min(a, c), min(g, k)));\n"
+"    mx += max(mx, max(max(a, c), max(g, k)));\n"
+"    float3 amp = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-4)));\n"
+"    float3 w = -amp * lerp(0.125, 0.2, prm.x);\n"
+"    return float4(saturate((e + (b + d + f + h) * w) / (1.0 + 4.0 * w)), 1.0);\n"
+"}\n"
+"float4 ps_scale(V i) : SV_Target {\n"
+"    float2 ratio = src_size.xy * dst_size.zw;\n"
+"    if (ratio.x <= 1.001 && ratio.y <= 1.001) return float4(catmull(i.uv), 1.0);\n"
+"    float2 ev = abs(ratio - 2.0 * round(ratio * 0.5));\n"
+"    int2 n = clamp(ev < 0.01 ? (int2)round(ratio * 0.5) : (int2)ceil(ratio - 0.01), int2(1, 1), int2(8, 8));\n"
+"    float2 stp = (ratio / (float2)n) * src_size.zw;\n"
+"    float2 base = i.uv - stp * ((float2)n - 1.0) * 0.5;\n"
+"    float3 acc = 0;\n"
+"    [loop] for (int y = 0; y < n.y; y++)\n"
+"        [loop] for (int x = 0; x < n.x; x++) { float3 c = tap(base + stp * float2(x, y)); acc += c * c; }\n"
+"    return float4(sqrt(acc / (float)(n.x * n.y)), 1.0);\n"
+"}\n";
+
+static ID3D12Device*         s_dev;
+static ldgfx_retire_fn       s_retire;
+static ID3D12RootSignature*  s_rs;
+static ID3D12PipelineState*  s_pso_fxaa;
+static ID3D12PipelineState*  s_pso_scale;
+static ID3D12PipelineState*  s_pso_cas;
+/* Descriptor rings: a slot written for one pass must not be rewritten before
+ * the command list that uses it has executed (descriptors are read at
+ * execution). The live draw flushes (submit + wait) at least once per frame,
+ * and a frame uses a handful of slots, so a 256-entry ring never laps. */
+#define LDGFX_SRV_RING 256u
+#define LDGFX_RTV_RING 16u
+static ID3D12DescriptorHeap* s_srv_heap;   /* shader visible, ring */
+static ID3D12DescriptorHeap* s_rtv_heap;   /* [0] tmp, [1..] ring */
+static u32                   s_srv_next, s_rtv_next, s_rtv_step;
+static u32                   s_srv_step;
+static ID3D12Resource*       s_tmp;        /* FXAA output when a resample follows */
+static u32                   s_tmp_w, s_tmp_h;
+static D3D12_RESOURCE_STATES s_tmp_state;
+static ID3D12Resource*       s_tmp2;       /* resample output when sharpening follows */
+static u32                   s_tmp2_w, s_tmp2_h;
+static D3D12_RESOURCE_STATES s_tmp2_state;
+static int                   s_ready = 0, s_failed = 0;
+static int                   s_scene = 1;   /* ldgfx_present_scene_hint */
+
+void ldgfx_present_scene_hint(int scene) { s_scene = scene ? 1 : 0; }
+
+static ID3DBlob* compile(const char* entry, const char* target)
+{
+    ID3DBlob* blob = NULL;
+    ID3DBlob* err = NULL;
+    HRESULT hr = D3DCompile(s_present_hlsl, sizeof s_present_hlsl - 1, "ldgfx_present",
+                            NULL, NULL, entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+                            &blob, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[gfx] present shader %s compile failed hr=0x%08lX: %s\n", entry,
+                (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "<no diagnostics>");
+        if (blob) blob->lpVtbl->Release(blob);
+        blob = NULL;
+    }
+    if (err) err->lpVtbl->Release(err);
+    return blob;
+}
+
+static ID3D12PipelineState* make_pso(ID3DBlob* vs, ID3DBlob* ps)
+{
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_rs;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+    pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+    pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pd.SampleDesc.Count = 1;
+    ID3D12PipelineState* pso = NULL;
+    if (FAILED(s_dev->lpVtbl->CreateGraphicsPipelineState(s_dev, &pd, &IID_ID3D12PipelineState,
+                                                         (void**)&pso)))
+        pso = NULL;
+    return pso;
+}
+
+int ldgfx_present_init(ID3D12Device* dev, ldgfx_retire_fn retire)
+{
+    if (s_ready) return 0;
+    if (s_failed || !dev) return -1;
+    s_dev = dev;
+    s_retire = retire;
+    s_failed = 1;   /* until proven otherwise */
+
+    D3D12_DESCRIPTOR_RANGE range;
+    memset(&range, 0, sizeof range);
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    range.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER rp[2];
+    memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[0].Constants.Num32BitValues = 12;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[1].DescriptorTable.NumDescriptorRanges = 1;
+    rp[1].DescriptorTable.pDescriptorRanges = &range;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC smp;
+    memset(&smp, 0, sizeof smp);
+    smp.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    smp.AddressU = smp.AddressV = smp.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    smp.MaxLOD = D3D12_FLOAT32_MAX;
+    smp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rsd;
+    memset(&rsd, 0, sizeof rsd);
+    rsd.NumParameters = 2;
+    rsd.pParameters = rp;
+    rsd.NumStaticSamplers = 1;
+    rsd.pStaticSamplers = &smp;
+    ID3DBlob* sig = NULL;
+    ID3DBlob* err = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err))) {
+        fprintf(stderr, "[gfx] present root signature failed: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        if (err) err->lpVtbl->Release(err);
+        return -1;
+    }
+    if (err) err->lpVtbl->Release(err);
+    HRESULT hr = dev->lpVtbl->CreateRootSignature(dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                  sig->lpVtbl->GetBufferSize(sig),
+                                                  &IID_ID3D12RootSignature, (void**)&s_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr)) return -1;
+
+    ID3DBlob* vs = compile("vs_main", "vs_5_0");
+    ID3DBlob* pf = compile("ps_fxaa", "ps_5_0");
+    ID3DBlob* ps = compile("ps_scale", "ps_5_0");
+    ID3DBlob* pc = compile("ps_cas", "ps_5_0");
+    if (vs && pf) s_pso_fxaa = make_pso(vs, pf);
+    if (vs && ps) s_pso_scale = make_pso(vs, ps);
+    if (vs && pc) s_pso_cas = make_pso(vs, pc);
+    if (vs) vs->lpVtbl->Release(vs);
+    if (pf) pf->lpVtbl->Release(pf);
+    if (ps) ps->lpVtbl->Release(ps);
+    if (pc) pc->lpVtbl->Release(pc);
+    if (!s_pso_fxaa || !s_pso_scale || !s_pso_cas) {
+        fprintf(stderr, "[gfx] present PSO creation failed\n");
+        return -1;
+    }
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd;
+    memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    hd.NumDescriptors = LDGFX_SRV_RING;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                 (void**)&s_srv_heap)))
+        return -1;
+    s_srv_step = dev->lpVtbl->GetDescriptorHandleIncrementSize(
+        dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+    hd.NumDescriptors = 2 + LDGFX_RTV_RING;
+    if (FAILED(dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                 (void**)&s_rtv_heap)))
+        return -1;
+    s_rtv_step = dev->lpVtbl->GetDescriptorHandleIncrementSize(dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    s_failed = 0;
+    s_ready = 1;
+    fprintf(stderr, "[gfx] present pass ready (fxaa + resample + sharpen)\n");
+    return 0;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE srv_cpu_at(u32 i)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_srv_heap, &h);
+    h.ptr += (size_t)i * s_srv_step;
+    return h;
+}
+
+static D3D12_GPU_DESCRIPTOR_HANDLE srv_gpu_at(u32 i)
+{
+    D3D12_GPU_DESCRIPTOR_HANDLE h;
+    s_srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_srv_heap, &h);
+    h.ptr += (u64)i * s_srv_step;
+    return h;
+}
+
+/* SRV of `res` in the next ring slot; returns the slot. */
+static u32 srv_ring(ID3D12Resource* res, DXGI_FORMAT fmt)
+{
+    const u32 i = s_srv_next++ % LDGFX_SRV_RING;
+    D3D12_SHADER_RESOURCE_VIEW_DESC sd;
+    memset(&sd, 0, sizeof sd);
+    sd.Format = fmt;
+    sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sd.Texture2D.MipLevels = 1;
+    s_dev->lpVtbl->CreateShaderResourceView(s_dev, res, &sd, srv_cpu_at(i));
+    return i;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE rtv_at(u32 i)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_rtv_heap, &h);
+    h.ptr += (size_t)i * s_rtv_step;
+    return h;
+}
+
+static int ensure_tmp_at(ID3D12Resource** tmp, u32* tw, u32* th, D3D12_RESOURCE_STATES* st,
+                         u32 rtv_index, u32 w, u32 h);
+static int ensure_tmp(u32 w, u32 h) { return ensure_tmp_at(&s_tmp, &s_tmp_w, &s_tmp_h, &s_tmp_state, 0, w, h); }
+static int ensure_tmp2(u32 w, u32 h) { return ensure_tmp_at(&s_tmp2, &s_tmp2_w, &s_tmp2_h, &s_tmp2_state, 1, w, h); }
+static int ensure_tmp_at(ID3D12Resource** tmp, u32* tw, u32* th, D3D12_RESOURCE_STATES* st,
+                         u32 rtv_index, u32 w, u32 h)
+{
+    if (*tmp && *tw == w && *th == h) return 1;
+    if (*tmp) {
+        if (s_retire) s_retire(*tmp); else (*tmp)->lpVtbl->Release(*tmp);
+        *tmp = NULL;
+    }
+    D3D12_HEAP_PROPERTIES hp;
+    memset(&hp, 0, sizeof hp);
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd;
+    memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                                                      D3D12_RESOURCE_STATE_RENDER_TARGET, NULL,
+                                                      &IID_ID3D12Resource, (void**)tmp))) {
+        *tmp = NULL;
+        return 0;
+    }
+    *tw = w; *th = h;
+    *st = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    s_dev->lpVtbl->CreateRenderTargetView(s_dev, *tmp, NULL, rtv_at(rtv_index));
+    return 1;
+}
+
+static void transition(ID3D12GraphicsCommandList* list, ID3D12Resource* r,
+                       D3D12_RESOURCE_STATES a, D3D12_RESOURCE_STATES b)
+{
+    if (a == b) return;
+    D3D12_RESOURCE_BARRIER bar;
+    memset(&bar, 0, sizeof bar);
+    bar.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    bar.Transition.pResource = r;
+    bar.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    bar.Transition.StateBefore = a;
+    bar.Transition.StateAfter = b;
+    list->lpVtbl->ResourceBarrier(list, 1, &bar);
+}
+
+static void draw_pass(ID3D12GraphicsCommandList* list, ID3D12PipelineState* pso, u32 srv,
+                      u32 sw, u32 sh, D3D12_CPU_DESCRIPTOR_HANDLE rtv, u32 dw, u32 dh)
+{
+    const ldgfx_options* o = ldgfx_opts();
+    float c[12] = { (float)sw, (float)sh, 1.0f / (float)sw, 1.0f / (float)sh,
+                    (float)dw, (float)dh, 1.0f / (float)dw, 1.0f / (float)dh,
+                    (float)o->sharpen / 100.0f, 0.0f, 0.0f, 0.0f };
+    D3D12_VIEWPORT vp = { 0.0f, 0.0f, (float)dw, (float)dh, 0.0f, 1.0f };
+    D3D12_RECT sc = { 0, 0, (LONG)dw, (LONG)dh };
+    list->lpVtbl->SetPipelineState(list, pso);
+    list->lpVtbl->SetGraphicsRootSignature(list, s_rs);
+    list->lpVtbl->SetDescriptorHeaps(list, 1, &s_srv_heap);
+    list->lpVtbl->SetGraphicsRoot32BitConstants(list, 0, 12, c, 0);
+    list->lpVtbl->SetGraphicsRootDescriptorTable(list, 1, srv_gpu_at(srv));
+    list->lpVtbl->RSSetViewports(list, 1, &vp);
+    list->lpVtbl->RSSetScissorRects(list, 1, &sc);
+    list->lpVtbl->OMSetRenderTargets(list, 1, &rtv, FALSE, NULL);
+    list->lpVtbl->IASetPrimitiveTopology(list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    list->lpVtbl->DrawInstanced(list, 3, 1, 0, 0);
+}
+
+int ldgfx_present_record(ID3D12GraphicsCommandList* list,
+                         ID3D12Resource* src, u32 src_w, u32 src_h, DXGI_FORMAT src_fmt,
+                         ID3D12Resource* dst, D3D12_CPU_DESCRIPTOR_HANDLE dst_rtv,
+                         u32 dst_w, u32 dst_h)
+{
+    if (!s_ready || !list || !src || !dst || !src_w || !src_h || !dst_w || !dst_h) return -1;
+    const ldgfx_options* o = ldgfx_opts();
+    /* aa=fxaa_all: FXAA here, over everything incl. the HUD. aa=fxaa runs
+     * it earlier, on the scene only (ldgfx_fxaa_copy at the composite). */
+    const int fxaa = o->aa == LDGFX_AA_FXAA_ALL;
+    const int resample = src_w != dst_w || src_h != dst_h;
+    if (fxaa && resample && !ensure_tmp(src_w, src_h)) return -1;
+    /* PS3_GFX_SHARPEN: the last pass, on the window-size image. A resample
+     * (or FXAA) before it goes to s_tmp2 at the window size. */
+    const int sharpen = o->sharpen > 0 && s_scene;
+    const int pre = resample || fxaa;   /* a pass before the sharpening */
+    if (sharpen && pre && !ensure_tmp2(dst_w, dst_h)) return -1;
+
+    u32 in_srv = srv_ring(src, src_fmt), in_w = src_w, in_h = src_h;
+    transition(list, src, D3D12_RESOURCE_STATE_RENDER_TARGET,
+               D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    if (fxaa && resample) {
+        transition(list, s_tmp, s_tmp_state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        draw_pass(list, s_pso_fxaa, in_srv, src_w, src_h, rtv_at(0), src_w, src_h);
+        transition(list, s_tmp, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                   D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        s_tmp_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        in_srv = srv_ring(s_tmp, DXGI_FORMAT_R8G8B8A8_UNORM);
+    }
+    if (sharpen && pre) {
+        transition(list, s_tmp2, s_tmp2_state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        draw_pass(list, (fxaa && !resample) ? s_pso_fxaa : s_pso_scale, in_srv, in_w, in_h,
+                  rtv_at(1), dst_w, dst_h);
+        transition(list, s_tmp2, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                   D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        s_tmp2_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        in_srv = srv_ring(s_tmp2, DXGI_FORMAT_R8G8B8A8_UNORM);
+        in_w = dst_w; in_h = dst_h;
+    }
+    transition(list, dst, D3D12_RESOURCE_STATE_PRESENT, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    draw_pass(list, sharpen ? s_pso_cas : (fxaa && !resample) ? s_pso_fxaa : s_pso_scale, in_srv,
+              in_w, in_h, dst_rtv, dst_w, dst_h);
+    transition(list, dst, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PRESENT);
+    transition(list, src, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+               D3D12_RESOURCE_STATE_RENDER_TARGET);
+    return 0;
+}
+
+int ldgfx_fxaa_copy(ID3D12GraphicsCommandList* list, ID3D12Resource* src, u32 w, u32 h,
+                    ID3D12Resource* dst, D3D12_RESOURCE_STATES dst_state)
+{
+    if (!s_ready || !list || !src || !dst || !w || !h) return -1;
+    const u32 srv = srv_ring(src, DXGI_FORMAT_R8G8B8A8_UNORM);
+    const u32 ri = 2 + (s_rtv_next++ % LDGFX_RTV_RING);
+    s_dev->lpVtbl->CreateRenderTargetView(s_dev, dst, NULL, rtv_at(ri));
+    transition(list, src, D3D12_RESOURCE_STATE_RENDER_TARGET,
+               D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    transition(list, dst, dst_state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    draw_pass(list, s_pso_fxaa, srv, w, h, rtv_at(ri), w, h);
+    transition(list, dst, D3D12_RESOURCE_STATE_RENDER_TARGET,
+               D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    transition(list, src, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+               D3D12_RESOURCE_STATE_RENDER_TARGET);
+    return 0;
+}
+
+void ldgfx_present_shutdown(void)
+{
+    if (s_tmp) { s_tmp->lpVtbl->Release(s_tmp); s_tmp = NULL; }
+    if (s_tmp2) { s_tmp2->lpVtbl->Release(s_tmp2); s_tmp2 = NULL; }
+    if (s_pso_cas) { s_pso_cas->lpVtbl->Release(s_pso_cas); s_pso_cas = NULL; }
+    if (s_pso_fxaa) { s_pso_fxaa->lpVtbl->Release(s_pso_fxaa); s_pso_fxaa = NULL; }
+    if (s_pso_scale) { s_pso_scale->lpVtbl->Release(s_pso_scale); s_pso_scale = NULL; }
+    if (s_rs) { s_rs->lpVtbl->Release(s_rs); s_rs = NULL; }
+    if (s_srv_heap) { s_srv_heap->lpVtbl->Release(s_srv_heap); s_srv_heap = NULL; }
+    if (s_rtv_heap) { s_rtv_heap->lpVtbl->Release(s_rtv_heap); s_rtv_heap = NULL; }
+    s_ready = 0;
+}
+#endif /* _WIN32 || PS3_WASM */
diff --git a/libs/video/rsx_live_gfx.h b/libs/video/rsx_live_gfx.h
new file mode 100644
index 00000000..275e8b49
--- /dev/null
+++ b/libs/video/rsx_live_gfx.h
@@ -0,0 +1,172 @@
+/*
+ * ps3recomp - optional host graphics upgrades for the D3D12 live-draw backend
+ *
+ * Everything here is OFF by default: with no option set the live-draw path is
+ * byte-for-byte the vanilla renderer (same PSO keys, same HLSL, same present).
+ *
+ * Options (environment wins over the ini file; the ini is PS3_GFX_INI, else
+ * graphics.ini next to the executable, section [graphics], same key names
+ * without the PS3_GFX_ prefix, lower case):
+ *
+ *   PS3_GFX_PRESET=vanilla|high|ultra   defaults for the keys below:
+ *                       high  = SCALE 2, AA fxaa, ANISO 16, SHADOW_SCALE 2,
+ *                               SHADOW_FILTER pcf (radius 1), KICK 128,
+ *                               SSAA 1.5, SHARPEN 35
+ *                       ultra = SCALE auto, AA fxaa, ANISO 16, SHADOW_SCALE 4,
+ *                               SHADOW_FILTER pcss (radius 2), KICK 128,
+ *                               SSAA 1.5, SHARPEN 35
+ *   PS3_GFX_SCALE=1|<k>|<W>x<H>|auto    internal render resolution: every
+ *                       render target (and zeta) is allocated k times the guest
+ *                       size and rasterised at that size (supersampling / HD
+ *                       output). <W>x<H> = host size of the 1280x720 canvas
+ *                       (non-uniform allowed, e.g. 5120x1440 for 32:9 Hor+);
+ *                       auto = the window's monitor (uniform when
+ *                       PS3_FULLSCREEN_ASPECT keeps the 16:9 aspect).
+ *   PS3_GFX_AA=off|fxaa|fxaa_all        post-process anti-aliasing. fxaa: on the
+ *                       3D scene only -- applied to the copy a display buffer's
+ *                       own composite pass reads (THP8: every gameplay frame), so
+ *                       the HUD drawn afterwards stays untouched; frames without
+ *                       such a pass (menus) get none. fxaa_all: at present, over
+ *                       everything including HUD text.
+ *   PS3_GFX_ANISO=1|2|4|8|16            anisotropic filtering for mipmapped,
+ *                       linearly filtered textures (not render targets / UI)
+ *   PS3_GFX_SHADOW_SCALE=1|2|4          host shadow-map resolution multiplier
+ *                       (zetas sampled with depth compare)
+ *   PS3_GFX_SHADOW_FILTER=hw|pcf|pcss   depth-compare filtering: hw = NV40 2x2
+ *                       bilinear PCF (vanilla), pcf = wide smooth PCF,
+ *                       pcss = contact-hardening soft shadows
+ *   PS3_GFX_SHADOW_RADIUS=1..4          pcf kernel radius / pcss radius unit
+ *                       (GUEST shadow-map texels: scales with SHADOW_SCALE)
+ *   PS3_GFX_KICK=<n>                    performance: submit the frame's command
+ *                       list to the GPU every n draws without waiting, so the
+ *                       GPU renders while the render thread records the rest
+ *                       (the present still waits for the whole frame). Hides
+ *                       the GPU time of the options above. 0 = off (vanilla).
+ *   PS3_GFX_PCSS_K=<n>                  pcss penumbra width, 1/1000 map widths
+ *                       per unit of light-space depth gap (default 4000)
+ *   PS3_GFX_SSAA=1..2                   supersampling on top of SCALE: the
+ *                       resolved render scale (a factor, WxH or auto = the
+ *                       monitor) is multiplied by this per axis, so with
+ *                       auto the frame renders above the monitor resolution
+ *                       and is box-filtered down at present (2 = 4 samples
+ *                       per pixel). Capped at 8x per axis / 40 Mpixel.
+ *   PS3_GFX_SHARPEN=0..100              contrast-adaptive sharpening at the
+ *                       end of the present pass (after FXAA / resampling),
+ *                       percent strength; 0 = off
+ *
+ * The present pass (FXAA and/or resampling the scaled frame to the window) is
+ * only used when SCALE != 1 or AA is on; then the swap chain follows the
+ * window's client size instead of staying at the guest canvas size.
+ */
+#ifndef PS3RECOMP_RSX_LIVE_GFX_H
+#define PS3RECOMP_RSX_LIVE_GFX_H
+
+#include "ps3emu/ps3types.h"
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { LDGFX_SHADOW_HW = 0, LDGFX_SHADOW_PCF = 1, LDGFX_SHADOW_PCSS = 2 };
+enum { LDGFX_AA_OFF = 0, LDGFX_AA_FXAA = 1, LDGFX_AA_FXAA_ALL = 2 };
+
+typedef struct ldgfx_options {
+    float scale_x, scale_y;   /* internal render scale; 1,1 = guest size       */
+    int   scale_auto;         /* "auto": resolved by ldgfx_resolve_auto_scale   */
+    u32   shadow_scale;       /* 1, 2 or 4                                      */
+    u32   shadow_filter;      /* LDGFX_SHADOW_*                                 */
+    u32   shadow_radius;      /* 1..4                                           */
+    u32   pcss_k;             /* PCSS penumbra: 1/1000 map widths per depth unit */
+    u32   aniso;              /* 1 = off, else 2..16                            */
+    u32   aa;                 /* LDGFX_AA_*                                     */
+    u32   kick;               /* submit the open command list every N draws     */
+    float ssaa;               /* supersampling factor on top of the scale, 1..2 */
+    u32   sharpen;            /* present-pass sharpening, percent (0 = off)     */
+    char  source[16];         /* "default" / "ini" / "env" / "ini+env"          */
+} ldgfx_options;
+
+/* Read once (thread-safe enough: first call is on the render thread at init). */
+const ldgfx_options* ldgfx_opts(void);
+
+/* Resolve PS3_GFX_SCALE=auto against the monitor of `hwnd` for a guest canvas
+ * of guest_w x guest_h. No-op unless auto was requested. */
+void ldgfx_resolve_auto_scale(void* hwnd, u32 guest_w, u32 guest_h);
+
+/* One summary line on stderr. */
+void ldgfx_log_options(void);
+
+/* The present pass is unavailable: render scale back to 1, AA off. */
+void ldgfx_disable_present_features(void);
+
+/* PS3_GFX_LIVE=1 (A/B testing): the ini is re-read when its time stamp
+ * changes. Call once per presented frame; returns 1 when an option changed.
+ * Render targets pick up a new scale at their next use (one frame of content
+ * is lost), PSOs and samplers are keyed by the options. */
+int ldgfx_poll_reload(void);
+int ldgfx_live(void);
+/* 1 when ldgfx_poll_reload has anything to watch (PS3_GFX_LIVE or the
+ * PS3_GFX_VIS_OFF_FILE A/B switch). */
+int ldgfx_polling(void);
+
+/* 1 when any option changes rendering at all (cheap). */
+int ldgfx_any(void);
+
+/* 1 when frames go through the present pass (scale != 1 or AA on). */
+int ldgfx_present_pass_wanted(void);
+
+/* 1 when the render scale is not 1 (render targets are host-scaled). */
+int ldgfx_scaling(void);
+
+/* Rewrite WPOS reads (`input.position`) in a decompiled fragment program's
+ * main() to guest pixel units: input.position * (1/kx, 1/ky, 1, 1). Returns
+ * the number of sites patched, or -1 when the buffer is too small. */
+int ldgfx_hlsl_scale_wpos(char* hlsl, size_t cap, float kx, float ky);
+
+#if defined(_WIN32) || defined(PS3_WASM)
+#if defined(PS3_WASM)
+/* Browser build: the present pass runs through the D3D12-over-WebGPU layer (libs/video/webgpu); its HLSL is
+ * translated to WGSL by the device worker like every other live-draw shader. */
+#include "rsx_live_draw_vkd3d.h"
+#else
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#endif
+
+typedef void (*ldgfx_retire_fn)(ID3D12Resource* res);
+
+/* Compiles the present-pass shaders / root signature. 0 = ok. */
+int  ldgfx_present_init(ID3D12Device* dev, ldgfx_retire_fn retire);
+
+/* Records the present pass: `src` (a colour surface in RENDER_TARGET state,
+ * restored afterwards) -> optional FXAA -> resample into `dst` (a swap-chain
+ * buffer in PRESENT state, restored afterwards; dst_rtv its RTV). Leaves the
+ * list's descriptor heaps changed (the next draw sets its own). 0 = recorded,
+ * -1 = not available (the caller falls back to CopyResource when sizes match). */
+int  ldgfx_present_record(ID3D12GraphicsCommandList* list,
+                          ID3D12Resource* src, u32 src_w, u32 src_h,
+                          DXGI_FORMAT src_fmt,
+                          ID3D12Resource* dst, D3D12_CPU_DESCRIPTOR_HANDLE dst_rtv,
+                          u32 dst_w, u32 dst_h);
+
+/* FXAA of `src` (RGBA8, RENDER_TARGET state, restored) into `dst` (same size,
+ * RGBA8, created with ALLOW_RENDER_TARGET; in `dst_state`, left in
+ * PIXEL_SHADER_RESOURCE). 0 = recorded. */
+int  ldgfx_fxaa_copy(ID3D12GraphicsCommandList* list, ID3D12Resource* src, u32 w, u32 h,
+                     ID3D12Resource* dst, D3D12_RESOURCE_STATES dst_state);
+
+/* 1 = the frame being presented is gameplay (it had a scene composite):
+ * PS3_GFX_SHARPEN applies; 0 = menus / movies, no sharpening. */
+void ldgfx_present_scene_hint(int scene);
+
+void ldgfx_present_shutdown(void);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_RSX_LIVE_GFX_H */
