+                char fn[MAX_PATH];
+                snprintf(fn, sizeof fn, "%s/%c_%016llX.hlsl", dd, it->stage, (unsigned long long)it->hash);
+                FILE* f = fopen(fn, "wb");
+                if (f) { fwrite(it->hlsl, 1, it->len, f); fclose(f); }
+            }
+        }
+        it->hr = D3DCompile(it->hlsl, it->len, it->stage == 'V' ? "xvs" : "xps", NULL, NULL, "main",
+                            it->stage == 'V' ? "vs_5_0" : "ps_5_0", 0, 0, &it->blob, &err);
+        if (FAILED(it->hr) && it->blob) { it->blob->lpVtbl->Release(it->blob); it->blob = NULL; }
+        if (FAILED(it->hr)) {
+            static volatile LONG said = 0;
+            if (InterlockedIncrement(&said) <= 4)
+                printf("[shader-warm] %cS compile failed (hash %016llX): %.3000s\n", it->stage,
+                       (unsigned long long)it->hash,
+                       err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "no diagnostic");
+        }
+        if (err) err->lpVtbl->Release(err);
+        InterlockedIncrement(&g_warm_done);
+    }
+}
+
+typedef struct {
+    u32 vline, pline;            /* V / P ordinals in the key list */
+    u32 inmask, packed, gpf;
+    render_state_t rs;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    WCHAR name[20];
+    ld_psolib_ix ix;             /* the library index entry */
+    int state;                   /* 0 to build, 1 in the library, 2 built, -1 create failed, -2 shader missing, -3 duplicate */
+} warm_pso;
+static warm_pso* g_warm_psos;
+static u32* g_warm_pso_todo;
+static u32 g_warm_pso_n;
+static volatile LONG g_warm_pso_next, g_warm_pso_done;
+
+static DWORD LD_THREAD_CC warm_pso_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        const LONG i = InterlockedIncrement(&g_warm_pso_next) - 1;
+        if (i >= (LONG)g_warm_pso_n) return 0;
+        warm_pso* w = &g_warm_psos[g_warm_pso_todo[i]];
+        ID3D12PipelineState* pso = ld_psolib_load(w->name, &w->pd);   /* names are unique here */
+        if (pso) {
+            w->state = 1;
+        } else {
+            const HRESULT hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &w->pd, &IID_ID3D12PipelineState,
+                                                                          (void**)&pso);
+            if (SUCCEEDED(hr) && pso) {
+                ld_psolib_store(w->name, pso, 1, &w->ix);
+                w->state = 2;
+            } else {
+                static volatile LONG said = 0;
+                if (InterlockedIncrement(&said) <= 4)
+                    printf("[shader-warm] pipeline create failed hr=0x%08lX (G line V%u P%u)\n",
+                           (unsigned long)hr, w->vline, w->pline);
+                w->state = -1;
+                pso = NULL;
+            }
+        }
+        if (pso) pso->lpVtbl->Release(pso);
+        InterlockedIncrement(&g_warm_pso_done);
+    }
+}
+
+static u64 warm_fnv(const u8* p, u32 n, u64 h)
+{
+    for (u32 i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+/* FNV-1a over the instruction slots of a fragment program (constant slots
+ * skipped); 0 when the program does not terminate inside `bytes`. */
+static u64 warm_fp_instr_hash(const u8* fp, u32 bytes)
+{
+    u64 h = 1469598103934665603ull;
+    u32 off = 0;
+    while (off + 16 <= bytes) {
+        const u32 w0 = rsx_fp_read_word(fp + off), w1 = rsx_fp_read_word(fp + off + 4);
+        const u32 w2 = rsx_fp_read_word(fp + off + 8), w3 = rsx_fp_read_word(fp + off + 12);
+        h = warm_fnv(fp + off, 16, h);
+        off += 16;
+        if ((w1 & 3u) == 2u || (w2 & 3u) == 2u || (w3 & 3u) == 2u) off += 16;
+        if (w0 & 1u) return off <= bytes ? h : 0;
+    }
+    return 0;
+}
+
+/* run `fn` on min(jobs, n) threads, printing "[shader-warm] <what>k/n" */
+static void warm_run(LPTHREAD_START_ROUTINE fn, int jobs, u32 n, volatile LONG* done, const char* what)
+{
+    HANDLE th[64];
+    int nth = 0;
+    for (int t = 0; t < jobs && (u32)t < n; t++) {
+        th[nth] = CreateThread(NULL, 0, fn, NULL, 0, NULL);
+        if (th[nth]) nth++;
+    }
+    if (!nth && n) fn(NULL);
+    LONG shown = -1;
+    while (nth) {
+        const DWORD r = WaitForMultipleObjects((DWORD)nth, th, TRUE, 500);
+        const LONG d = *done;
+        if (d != shown) { printf("[shader-warm] %s%ld/%u\n", what, d, n); fflush(stdout); shown = d; }
+        if (r != WAIT_TIMEOUT) break;
+    }
+    for (int t = 0; t < nth; t++) CloseHandle(th[t]);
+}
+
+/* the pipelines of the key list into the PSO library; returns the failed count */
+static u32 warm_pipelines(int jobs, const int* vmap, u32 nv, const int* pmap, u32 np)
+{
+    const long long t0 = frame_trace_now_us();
+    const char* e = getenv("PS3_PSO_LIBRARY");
+    if (e && e[0] == '0') { printf("[shader-warm] pipelines: skipped (PS3_PSO_LIBRARY=0)\n"); return 0; }
+    if (FAILED(D3D12CreateDevice(NULL, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&g.dev)) || !g.dev) {
+        g.dev = NULL;
+        printf("[shader-warm] pipelines: skipped (no D3D12 device)\n");
+        return 0;
+    }
+    g_ld_warm_mode = 1;
+    if (make_root_signature() != 0) { printf("[shader-warm] pipelines: skipped (root signature)\n"); return 0; }
+    ld_psolib_init(0);
+    if (g_psolib.state != 1) { printf("[shader-warm] pipelines: skipped (no pipeline library)\n"); return 0; }
+    const LONG had = g_psolib.pipelines;
+    u32 missing = 0, dups = 0;
+    g_warm_pso_todo = (u32*)calloc(g_warm_pso_n ? g_warm_pso_n : 1, sizeof(u32));
+    u32 todo = 0;
+    for (u32 i = 0; i < g_warm_pso_n; i++) {
+        warm_pso* w = &g_warm_psos[i];
+        const int vi = w->vline < nv ? vmap[w->vline] : -1;
+        const int pi = w->pline < np ? pmap[w->pline] : -1;
+        warm_item* vs = vi >= 0 ? &g_warm_items[vi] : NULL;
+        warm_item* ps = pi >= 0 ? &g_warm_items[pi] : NULL;
+        if (vs && !vs->blob && vs->cached) vs->blob = shader_disk_cache_load('V', vs->hlsl, vs->len, vs->hash);
+        if (ps && !ps->blob && ps->cached) ps->blob = shader_disk_cache_load('P', ps->hlsl, ps->len, ps->hash);
+        if (!vs || !ps || !vs->blob || !ps->blob) { w->state = -2; missing++; continue; }
+        rsx_vertex_layout_plan plan;
+        rsx_vertex_layout_plan_init(&plan, w->inmask);
+        ld_fill_pso_desc(&w->pd, w->il, vs->blob, ps->blob, &w->rs, &plan, (int)w->packed, (int)w->gpf);
+        const u64 nh = ld_psolib_name(&w->pd, w->name);
+        ld_psolib_ix_make(&w->ix, nh, vs->hash, vs->len, ps->hash, ps->len, 1, w->inmask, (int)w->packed,
+                          (int)w->gpf, &w->rs);
+        int dup = 0;
+        for (u32 j = 0; j < todo && !dup; j++)
+            dup = memcmp(g_warm_psos[g_warm_pso_todo[j]].name, w->name, sizeof(w->name)) == 0;
+        if (dup) { w->state = -3; dups++; continue; }
+        g_warm_pso_todo[todo++] = i;
+    }
+    const u32 lines = g_warm_pso_n;
+    g_warm_pso_n = todo; g_warm_pso_next = 0; g_warm_pso_done = 0;
+    printf("[shader-warm] pipelines: %u in the key list, %u distinct, %u without shaders, library holds %ld\n",
+           lines, todo, missing, (long)had);
+    fflush(stdout);
+    warm_run(warm_pso_worker, jobs, todo, &g_warm_pso_done, "pipelines ");
+    u32 inlib = 0, built = 0, failed = 0;
+    for (u32 j = 0; j < todo; j++) {
+        const int st = g_warm_psos[g_warm_pso_todo[j]].state;
+        inlib += st == 1; built += st == 2; failed += st == -1;
+    }
+    const int saved = ld_psolib_save("warm-up");
+    printf("[shader-warm] pipelines done: %u built, %u already in the library, %u failed, %u without shaders "
+           "(%u duplicate lines); library %ld pipelines%s, %.1f s\n",
+           built, inlib, failed, missing, dups, (long)g_psolib.pipelines,
+           saved > 0 ? " saved" : saved < 0 ? " NOT SAVED" : " unchanged", (double)(frame_trace_now_us() - t0) / 1e6);
+    fflush(stdout);
+    free(g_warm_pso_todo); g_warm_pso_todo = NULL;
+    return failed + (saved < 0 ? 1u : 0u);
+}
+
+/* G line render state, LD_RS_PSO_FIELDS order */
+static int warm_parse_rs(const char* s, render_state_t* rs)
+{
+    memset(rs, 0, sizeof(*rs));
+    char* end = (char*)s;
+    int n = 0, bad = 0;
+#define LD_RS_PARSE(f) if (!bad) { rs->f = (u32)strtoul(s, &end, 16); if (end == s) bad = 1; else { n++; s = end; if (*s == ',') s++; } }
+    LD_RS_PSO_FIELDS(LD_RS_PARSE)
+#undef LD_RS_PARSE
+    return !bad && n == LD_RS_PSO_NFIELDS;
+}
+
+int rsx_shader_warm(const char* keylist, const char* data_root, int jobs)
+{
+    FILE* kf = fopen(keylist, "rb");
+    if (!kf) { printf("[shader-warm] cannot open key list %s\n", keylist); return -1; }
+    {   /* the same fragment-constant mode a run would use (rsx_live_draw_init) */
+        const char* m = getenv("RSX_FP_CONSTANT_MODE");
+        g.fp_constant_mode = (m && (m[0] == 'L' || m[0] == 'l')) ? 'L' : 'B';
+    }
+    if (!shader_disk_cache_prepare()) { fclose(kf); printf("[shader-warm] no shader disk cache\n"); return -1; }
+    enum { WARM_MAX_SRC = 16 };
+    u8* src[WARM_MAX_SRC] = {0};
+    u32 src_len[WARM_MAX_SRC] = {0};
+    u32 cap = 1024, n = 0, skipped = 0, cached = 0, lines = 0, todo = 0;
+    u32 nv = 0, np = 0, vcap = 1024, pcap = 1024, gcap = 1024, gbad = 0;
+    g_warm_items = (warm_item*)calloc(cap, sizeof(warm_item));
+    int* vmap = (int*)malloc(vcap * sizeof(int));
+    int* pmap = (int*)malloc(pcap * sizeof(int));
+    g_warm_psos = (warm_pso*)calloc(gcap, sizeof(warm_pso));
+    g_warm_pso_n = 0;
+    static char hlsl[256 * 1024];
+    static u8 vp_le[RSX_DSP_VP_INSTR * 16];
+    static rsx_fp_constant_block fpc;
+    char line[2048];
+    int fatal = 0;
+    while (fgets(line, sizeof line, kf)) {
+        if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;
+        if (line[0] == 'S') {
+            unsigned id = 0; char rel[1024];
+            if (sscanf(line + 1, "%x %1023s", &id, rel) != 2 || id >= WARM_MAX_SRC) continue;
+            char path[MAX_PATH * 2];
+            snprintf(path, sizeof path, "%s/%s", data_root, rel);
+            FILE* f = fopen(path, "rb");
+            if (!f) { printf("[shader-warm] cannot open %s\n", path); fatal = 1; continue; }
+            fseek(f, 0, SEEK_END); const long len = ftell(f); fseek(f, 0, SEEK_SET);
+            src[id] = (u8*)malloc((size_t)len + 64);
+            if (src[id] && fread(src[id], 1, (size_t)len, f) == (size_t)len) src_len[id] = (u32)len;
+            else { free(src[id]); src[id] = NULL; fatal = 1; }
+            fclose(f);
+            continue;
+        }
+        if (line[0] == 'G') {
+            unsigned vl = 0, pl = 0, inm = 0, packed = 0, gpf = 0; int used = 0;
+            if (g_warm_pso_n == gcap) {
+                warm_pso* g2 = (warm_pso*)realloc(g_warm_psos, (size_t)gcap * 2 * sizeof(warm_pso));
+                if (!g2) continue;
+                memset(g2 + gcap, 0, (size_t)gcap * sizeof(warm_pso));
+                g_warm_psos = g2; gcap *= 2;
+            }
+            warm_pso* w = &g_warm_psos[g_warm_pso_n];
+            if (sscanf(line + 1, "%x %x %x %x %x %n", &vl, &pl, &inm, &packed, &gpf, &used) == 5 &&
+                warm_parse_rs(line + 1 + used, &w->rs)) {
+                w->vline = vl; w->pline = pl; w->inmask = inm & 0xFFFFu; w->packed = packed != 0; w->gpf = gpf != 0;
+                g_warm_pso_n++;
+            } else {
+                gbad++;
+            }
+            continue;
+        }
+        if (line[0] != 'V' && line[0] != 'P') continue;
+        lines++;
+        int* map_slot;
+        if (line[0] == 'V') {
+            if (nv == vcap) { int* m2 = (int*)realloc(vmap, (size_t)vcap * 2 * sizeof(int)); if (!m2) break; vmap = m2; vcap *= 2; }
+            map_slot = &vmap[nv++];
+        } else {
+            if (np == pcap) { int* m2 = (int*)realloc(pmap, (size_t)pcap * 2 * sizeof(int)); if (!m2) break; pmap = m2; pcap *= 2; }
+            map_slot = &pmap[np++];
+        }
+        *map_slot = -1;
+        unsigned sid = 0, off = 0, bytes = 0; unsigned long long hash = 0;
+        int used = 0;
+        if (sscanf(line + 1, "%x %x %x %llx%n", &sid, &off, &bytes, &hash, &used) != 4 ||
+            sid >= WARM_MAX_SRC || !src[sid] || (u64)off + bytes > src_len[sid] || !bytes) {
+            skipped++; continue;
+        }
+        const u8* p = src[sid] + off;
+        const char* rest = line + 1 + used;
+        int ok = 0;
+        if (line[0] == 'V') {
+            unsigned vstart = 0, vtex = 0, inmask = 0, gpf = 0;
+            if (sscanf(rest, "%x %x %x %x", &vstart, &vtex, &inmask, &gpf) == 4 &&
+                bytes % 16 == 0 && bytes <= sizeof(vp_le) &&
+                warm_fnv(p, bytes, 1469598103934665603ull) == hash) {
+                for (u32 i = 0; i < bytes; i += 4) {   /* big-endian words -> the host words of g.rsx.vp */
+                    vp_le[i] = p[i + 3]; vp_le[i + 1] = p[i + 2]; vp_le[i + 2] = p[i + 1]; vp_le[i + 3] = p[i];
+                }
+                const u32 instrs = rsx_vp_program_size_instrs(vp_le, bytes);
+                ok = instrs && ld_build_vs_hlsl(vp_le, instrs, vstart, vtex, inmask, 1, gpf != 0,
+                                                hlsl, sizeof(hlsl)) > 0;
+            }
+        } else if (ld_fp_constants_buffered()) {
+            unsigned ctrl = 0, cube = 0, aen = 0, afunc = 0, sm = 0, pcf = 0, d16 = 0, flt = 0, unm = 0;
+            char zf[40] = {0};
+            int used2 = 0;
+            if (sscanf(rest, "%x %x %x %x %x %x %x %x %39s %x%n", &ctrl, &cube, &aen, &afunc, &sm, &pcf,
+                       &d16, &flt, zf, &unm, &used2) == 10 &&
+                warm_fp_instr_hash(p, bytes) == hash &&
+                rsx_fp_program_size(p, bytes) == bytes) {
+                rsx_fp_shadow_desc sh;
+                memset(&sh, 0, sizeof(sh));
+                sh.mask = sm; sh.pcf_mask = pcf; sh.depth16_mask = d16; sh.float_mask = flt;
+                for (u32 u = 0; u < 16 && zf[2 * u] && zf[2 * u + 1]; u++) {
+                    char b[3] = { zf[2 * u], zf[2 * u + 1], 0 };
+                    sh.zfunc[u] = (u8)strtoul(b, NULL, 16);
+                }
+                if (sh.mask) {     /* host filter options, exactly as get_pso */
+                    const ldgfx_options* go = ldgfx_opts();
+                    if (go->shadow_filter != LDGFX_SHADOW_HW) {
+                        sh.filter = (u8)go->shadow_filter;
+                        sh.radius = (u8)go->shadow_radius;
+                        sh.scale = (u8)go->shadow_scale;
+                        sh.pcss_k = go->pcss_k;
+                    }
+                }
+                u32 dim[16][2] = {{0}};
+                const char* q = rest + used2;
+                unsigned uu, w, h2; int adv = 0;
+                while (sscanf(q, " %x:%ux%u%n", &uu, &w, &h2, &adv) == 3 && uu < 16) {
+                    dim[uu][0] = w; dim[uu][1] = h2; q += adv;
+                }
+                const int nconst = rsx_fp_collect_constants(p, bytes, &fpc);
+                ok = nconst >= 0 &&
+                     ld_build_ps_hlsl(p, bytes, ctrl, cube, &sh, aen, afunc, 0.0f, unm,
+                                      (const u32 (*)[2])dim, 1.0f, 1.0f, nconst, hlsl, sizeof(hlsl)) > 0;
+            }
+        }
+        if (!ok) { skipped++; continue; }
+        const u32 len = (u32)strlen(hlsl);
+        const u64 h = fnv1a(hlsl, len, 1469598103934665603ull);
+        int dup = -1;
+        for (u32 i = 0; i < n && dup < 0; i++)
+            if (g_warm_items[i].hash == h && g_warm_items[i].len == len && g_warm_items[i].stage == line[0])
+                dup = (int)i;
+        if (dup >= 0) { *map_slot = dup; continue; }
+        if (n == cap) {
+            warm_item* g2 = (warm_item*)realloc(g_warm_items, (size_t)cap * 2 * sizeof(warm_item));
+            if (!g2) break;
+            memset(g2 + cap, 0, (size_t)cap * sizeof(warm_item));
+            g_warm_items = g2; cap *= 2;
+        }
+        warm_item* it = &g_warm_items[n];
+        it->stage = line[0]; it->len = len; it->hash = h;
+        it->hlsl = (char*)malloc((size_t)len + 1);
+        if (!it->hlsl) break;
+        memcpy(it->hlsl, hlsl, (size_t)len + 1);
+        {   /* PS3_WARM_HLSL_DUMP=<dir> (measurement only): every warm-up shader's HLSL, <stage>_<hash>.hlsl */
+            static const char* wd = (const char*)-1;
+            if (wd == (const char*)-1) wd = getenv("PS3_WARM_HLSL_DUMP");
+            if (wd) {
+                char fn[MAX_PATH];
+                snprintf(fn, sizeof fn, "%s/%c_%016llx.hlsl", wd, line[0], (unsigned long long)h);
+                FILE* df = fopen(fn, "wb");
+                if (df) { fwrite(hlsl, 1, len, df); fclose(df); }
+            }
+        }
+        char path[MAX_PATH];
+        it->cached = shader_disk_cache_path(path, (u32)line[0], h, len) &&
+                     GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
+        if (it->cached) cached++; else todo++;
+        *map_slot = (int)n;
+        n++;
+    }
+    fclose(kf);
+    printf("[shader-warm] %u entries: %u to compile, %u already cached, %u skipped (not found / changed)%s\n",
+           lines, todo, cached, skipped, g_warm_pso_n ? "" : "; no pipeline lines");
+    if (gbad) printf("[shader-warm] %u malformed pipeline lines ignored\n", gbad);
+    fflush(stdout);
+    if (jobs <= 0) { SYSTEM_INFO si; GetSystemInfo(&si); jobs = (int)si.dwNumberOfProcessors; }
+    if (jobs > 64) jobs = 64;
+    g_warm_todo = (u32*)calloc(todo ? todo : 1, sizeof(u32));
+    g_warm_n = 0;
+    for (u32 i = 0; i < n; i++) if (!g_warm_items[i].cached) g_warm_todo[g_warm_n++] = i;
+    g_warm_next = 0; g_warm_done = 0;
+    warm_run(warm_worker, jobs, g_warm_n, &g_warm_done, "");
+    u32 failed = 0;
+    for (u32 j = 0; j < g_warm_n; j++) {
+        warm_item* it = &g_warm_items[g_warm_todo[j]];
+        if (it->blob) shader_disk_cache_store((u32)it->stage, it->hlsl, it->len, it->hash, it->blob);
+        else failed++;
+    }
+    printf("[shader-warm] done: %u compiled, %u failed, %u already cached, %u skipped\n",
+           g_warm_n - failed, failed, cached, skipped);
+    fflush(stdout);
+    const u32 pso_failed = g_warm_pso_n ? warm_pipelines(jobs, vmap, nv, pmap, np) : 0u;
+    for (u32 i = 0; i < n; i++) {
+        if (g_warm_items[i].blob) g_warm_items[i].blob->lpVtbl->Release(g_warm_items[i].blob);
+        free(g_warm_items[i].hlsl);
+    }
+    free(g_warm_items); g_warm_items = NULL;
+    free(g_warm_todo); g_warm_todo = NULL;
+    free(g_warm_psos); g_warm_psos = NULL;
+    free(vmap); free(pmap);
+    for (u32 i = 0; i < WARM_MAX_SRC; i++) free(src[i]);
+    if (fatal) return -1;
+    /* Entries that no longer match this exe or the player's files (a key list
+     * from another build), compile and create failures are counted above but
+     * are no failure of the warm-up: the game builds what is missing itself. */
+    printf("[shader-warm] result: %u skipped (not found / changed), %u shader compiles failed, %u pipelines failed\n",
+           skipped, failed, pso_failed);
+    fflush(stdout);
+    return 0;
+}
+
 void rsx_live_draw_shutdown(void)
 {
     if (!g.ready) return;
+    ld_dcl_shutdown();   /* PS3_DCL: drain, stop the recorder; direct recording from here */
+    rsx_live_draw_save_pipelines();   /* PS3_PSO_LIBRARY */
+    ld_heap_cache_reset();
+    texrepl_shutdown();
     ld_vertex_diag_emit("shutdown", 1);
     ld_present_measure_dump();
     /* let the GPU drain, then release. (Best-effort; process teardown also
@@ -9950,6 +19476,9 @@ void rsx_live_draw_shutdown(void)
         if (g.zdepths[i].snapshot)
             g.zdepths[i].snapshot->lpVtbl->Release(
                 g.zdepths[i].snapshot);
+        if (g.zdepths[i].view_y16)
+            g.zdepths[i].view_y16->lpVtbl->Release(
