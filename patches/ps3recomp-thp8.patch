+/* ---- float <-> int conversions (RI8 scale: f->i 2^(173-i8), i->f 2^(i8-155)).
+ * f->i: zero-exponent operand = 0, exponent 255 is a huge number (saturates),
+ * truncation toward zero, saturation to the integer range. Exact integer
+ * arithmetic, environment independent. ---- */
+static inline int32_t spu__cflts1(uint32_t x, int scale)
+{
+    uint32_t ex = (x >> 23) & 0xFFu;
+    if (!ex) return 0;
+    int sh = (int)ex - 150 + scale;            /* value = sig * 2^sh */
+    uint64_t sig = (x & 0x7FFFFFu) | 0x800000u;
+    int neg = (int)(x >> 31);
+    if (sh >= 8) return neg ? INT32_MIN : INT32_MAX;     /* >= 2^31 in magnitude */
+    uint64_t v = sh >= 0 ? (sig << sh) : (sh > -32 ? (sig >> -sh) : 0);
+    if (neg) return v >= 0x80000000ull ? INT32_MIN : (int32_t)(0 - (int64_t)v);
+    return v > 0x7FFFFFFFull ? INT32_MAX : (int32_t)v;
