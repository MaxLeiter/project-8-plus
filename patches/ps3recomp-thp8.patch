+/* 1 = locked, 0 = another process holds it, -1 = no lock file */
+static int sd_lock_try(u32 off)
+{
+    if (!sd_lock_open()) return -1;
+#ifdef _WIN32
+    OVERLAPPED ov;
+    memset(&ov, 0, sizeof ov);
+    ov.Offset = off;
+    if (LockFileEx(s_lock_h, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, 0, 1, 0, &ov)) return 1;
+    return GetLastError() == ERROR_LOCK_VIOLATION || GetLastError() == ERROR_IO_PENDING ? 0 : -1;
+#else
+    struct flock fl;
+    memset(&fl, 0, sizeof fl);
+    fl.l_type = F_WRLCK; fl.l_whence = SEEK_SET; fl.l_start = (off_t)off; fl.l_len = 1;
+    if (fcntl(s_lock_fd, F_SETLK, &fl) == 0) return 1;
+    return (errno == EACCES || errno == EAGAIN) ? 0 : -1;
+#endif
+}
+
+static void sd_lock_release(u32 off)
+{
+#ifdef _WIN32
+    OVERLAPPED ov;
+    memset(&ov, 0, sizeof ov);
+    ov.Offset = off;
+    if (s_lock_h != INVALID_HANDLE_VALUE) UnlockFileEx(s_lock_h, 0, 1, 0, &ov);
+#else
+    struct flock fl;
+    memset(&fl, 0, sizeof fl);
+    fl.l_type = F_UNLCK; fl.l_whence = SEEK_SET; fl.l_start = (off_t)off; fl.l_len = 1;
+    if (s_lock_fd >= 0) fcntl(s_lock_fd, F_SETLK, &fl);
+#endif
+}
