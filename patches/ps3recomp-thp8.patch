+/* ---------------------------------------------------------------------------
+ * Host file layer: every host path in this file is UTF-8.
+ *
+ * The shared save folder lives in the player's Documents (Project 8 Plus 0.9.2: one save folder for every
+ * install and version), and a user folder may hold characters outside the ANSI code page (a Windows user
+ * named Łukasz or 田中). The narrow CRT calls (fopen, _stat64, FindFirstFileA, MoveFileExA) and getenv() go
+ * through that code page on Windows, so such a folder turned into '?' and every save failed. On Windows the
+ * helpers below convert UTF-8 to UTF-16 and use the wide calls; environment variables are read with
+ * _wgetenv. A string that is not valid UTF-8 (a legacy ANSI path) is converted from the ANSI code page, as
+ * the narrow call did. POSIX: the bytes go to the system unchanged.
+ * -----------------------------------------------------------------------*/
+#define SD_PATH_MAX 1024
+
+#ifdef _WIN32
+/* UTF-8 (or ANSI) -> UTF-16 with backslashes; a long absolute path gets the \\?\ prefix. 0 on failure. */
+static int sd_wide(const char* p, wchar_t* w, int cap)
+{
+    int off = 0;
+    size_t n = strlen(p);
+    if (n >= 240 && ((p[0] && p[1] == ':' && (p[2] == '\\' || p[2] == '/')))) {
+        wcscpy(w, L"\\\\?\\");
+        off = 4;
+    }
+    int k = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, p, -1, w + off, cap - off);
+    if (k <= 0) k = MultiByteToWideChar(CP_ACP, 0, p, -1, w + off, cap - off);
+    if (k <= 0) { w[0] = 0; return 0; }
+    for (wchar_t* c = w + off; *c; c++) if (*c == L'/') *c = L'\\';
+    return 1;
+}
+
+static int sd_utf8(const wchar_t* w, char* out, int cap)
+{
+    int k = WideCharToMultiByte(CP_UTF8, 0, w, -1, out, cap, NULL, NULL);
+    if (k <= 0) { out[0] = 0; return 0; }
+    return 1;
+}
+#endif
+
+/* getenv as UTF-8 into out; 1 when set and non-empty */
+static int sd_getenv(const char* name, char* out, size_t cap)
+{
+    out[0] = 0;
+#ifdef _WIN32
+    wchar_t wn[64];
+    if (!MultiByteToWideChar(CP_UTF8, 0, name, -1, wn, 64)) return 0;
+    const wchar_t* v = _wgetenv(wn);
+    if (!v || !*v) return 0;
+    return sd_utf8(v, out, (int)cap) && out[0];
+#else
+    const char* v = getenv(name);
+    if (!v || !*v) return 0;
+    snprintf(out, cap, "%s", v);
+    return 1;
+#endif
+}
+
+static FILE* sd_fopen(const char* path, const char* mode)
+{
+#ifdef _WIN32
+    wchar_t w[SD_PATH_MAX + 8], wm[8];
+    if (!sd_wide(path, w, SD_PATH_MAX + 8)) return NULL;
+    MultiByteToWideChar(CP_UTF8, 0, mode, -1, wm, 8);
+    return _wfopen(w, wm);
+#else
+    return fopen(path, mode);
+#endif
