diff --git a/libs/network/sysNet.c b/libs/network/sysNet.c
index 0aa810e5..7787b0d3 100644
--- a/libs/network/sysNet.c
+++ b/libs/network/sysNet.c
@@ -797,3 +797,116 @@ void ps3_net_host_register(unsigned int (*guest_alloc)(unsigned int size, unsign
     printf("[sys_net] PS3_NET_ONLINE: host sockets registered (%u exports)\n",
            (unsigned)(sizeof(tab) / sizeof(tab[0])));
 }
+
+/* ---------------------------------------------------------------------------
+ * Offline model: the exports ppu_sysprx.cpp's offline table does not cover
+ *
+ * ppu_sysprx.cpp answers socket/bind/setsockopt/close/send(to)/recv(from)/
+ * poll/select/errno offline. THP8 (Havok's hkPs3Socket VDB server, stream/impl/
+ * hkPs3Socket.cpp, sub_00A22534..) also imports listen, accept, connect, send,
+ * inet_addr and sys_net_show_ifconfig, which fell to the unresolved path: a
+ * faked 0 from connect() reads as "connected" and from accept() as "fd 0".
+ * Model a console with no link instead:
+ *   listen   -> 0     (bind already succeeds offline; select never reports a peer)
+ *   accept   -> -1    (EWOULDBLOCK; only reached after select says readable)
+ *   connect  -> -1    (ECONNREFUSED; nothing is there)
+ *   send     -> -1    (ENOTCONN; no socket ever connects)
+ *   shutdown -> -1    (ENOTCONN)
+ *   inet_addr/inet_aton -> real parse (pure function, no host stack needed)
+ * errno: the guest reads it through ppu_sysprx.cpp's offline _sys_net_errno_loc
+ * cell, which reports EWOULDBLOCK; the codes above are kept in s_errno for the
+ * log only. Registered from lv2_init_syscalls(), i.e. AFTER ppu_sysprx_register:
+ * ctx registration is first-wins, so with PS3_NET_ONLINE the host-socket
+ * handlers above still take precedence.
+ * -----------------------------------------------------------------------*/
+
+/* BSD inet_aton grammar: 1-4 parts, each decimal / 0octal / 0xhex; the last
+ * part fills the remaining low bytes. Returns 1 and the address in host order
+ * (= the PS3's network-order value, it being big-endian), or 0 if malformed. */
+static int net_parse_inaddr(uint32_t ea, uint32_t* out)
+{
+    uint32_t parts[4];
+    int np = 0;
+    char s[64];
+    if (!ea) return 0;
+    for (int i = 0; i < (int)sizeof(s); i++) {
+        s[i] = (char)vm_read8(ea + (uint32_t)i);
+        if (!s[i]) break;
+        if (i == (int)sizeof(s) - 1) return 0;
+    }
+    const char* p = s;
+    for (;;) {
+        uint64_t v = 0;
+        int base = 10, digits = 0;
+        if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) { base = 16; p += 2; }
+        else if (p[0] == '0') { base = 8; }
+        for (;; p++, digits++) {
+            int d;
+            if (*p >= '0' && *p <= '9') d = *p - '0';
+            else if (base == 16 && *p >= 'a' && *p <= 'f') d = *p - 'a' + 10;
+            else if (base == 16 && *p >= 'A' && *p <= 'F') d = *p - 'A' + 10;
+            else break;
+            if (d >= base) return 0;
+            v = v * (uint64_t)base + (uint64_t)d;
+            if (v > 0xFFFFFFFFull) return 0;
+        }
+        if (!digits) return 0;
+        if (np == 4) return 0;
+        parts[np++] = (uint32_t)v;
+        if (*p == '.') { p++; continue; }
+        if (*p != 0) return 0;
+        break;
+    }
+    uint32_t a;
+    switch (np) {
+    case 1: a = parts[0]; break;
+    case 2: if (parts[0] > 0xFF || parts[1] > 0xFFFFFF) return 0;
+            a = parts[0] << 24 | parts[1]; break;
+    case 3: if (parts[0] > 0xFF || parts[1] > 0xFF || parts[2] > 0xFFFF) return 0;
+            a = parts[0] << 24 | parts[1] << 16 | parts[2]; break;
+    default: if (parts[0] > 0xFF || parts[1] > 0xFF || parts[2] > 0xFF || parts[3] > 0xFF) return 0;
+             a = parts[0] << 24 | parts[1] << 16 | parts[2] << 8 | parts[3]; break;
+    }
+    *out = a;
+    return 1;
+}
+
+static void off_listen(ppu_context* ctx)   { RET_S(0); }
+static void off_accept(ppu_context* ctx)   { RET_S(fail(SYS_NET_EWOULDBLOCK)); }
+static void off_connect(ppu_context* ctx)  { RET_S(fail(SYS_NET_ECONNREFUSED)); }
+static void off_send(ppu_context* ctx)     { RET_S(fail(SYS_NET_ENOTCONN)); }
+static void off_shutdown(ppu_context* ctx) { RET_S(fail(SYS_NET_ENOTCONN)); }
+static void off_inet_addr(ppu_context* ctx)
+{
+    uint32_t a;
+    RET_U(net_parse_inaddr(R32(3), &a) ? a : 0xFFFFFFFFu);   /* INADDR_NONE */
+}
+static void off_inet_aton(ppu_context* ctx)
+{
+    uint32_t a;
+    if (!net_parse_inaddr(R32(3), &a)) { RET_S(0); return; }
+    if (R32(4)) vm_write32(R32(4), a);   /* struct in_addr: BE = network order */
+    RET_S(1);
+}
+
+/* sys_net_show_ifconfig (NID 0xB48636C4): debug dump of the interface list.
+ * THP8's VDB server calls it right after listen() and ignores the result.
+ * Plain C signature so gen_hle_nids registers it from this file. */
+int32_t sys_net_show_ifconfig(void)
+{
+    static int n = 0;
+    if (n++ < 2) printf("[sys_net] show_ifconfig: (offline, no interfaces)\n");
+    return CELL_OK;
+}
+
+void ps3_net_offline_register(void)
+{
+    static const struct { const char* name; void (*fn)(ppu_context*); } tab[] = {
+        { "listen", off_listen },     { "accept", off_accept },
+        { "connect", off_connect },   { "send", off_send },
+        { "shutdown", off_shutdown }, { "inet_addr", off_inet_addr },
+        { "inet_aton", off_inet_aton },
+    };
+    for (size_t i = 0; i < sizeof(tab) / sizeof(tab[0]); i++)
+        ps3_hle_register_ctx(ps3_compute_nid(tab[i].name), tab[i].name, tab[i].fn);
+}
