+/*
+ * ps3recomp - SPU floating-point semantics (included by spu_helpers.h).
+ *
+ * SINGLE PRECISION (SPU ISA v1.2 ch. 9, "Floating-Point Instructions"): the SPU
+ * single-precision unit is not IEEE. Operands with a zero exponent field are
+ * zero (denormals are never produced or honoured), exponent 255 is an ordinary
+ * "extended range" exponent (there is no Inf or NaN), every result is rounded
+ * toward zero, a result below 2^-126 is +0, a result beyond the extended range
+ * saturates to sign|0x7FFFFFFF, and fma/fms/fnms are fused (one rounding).
+ * fm/fa/fs are the same unit, so a zero result is always +0.
+ *
+ * How we get there cheaply: spu_run_with_halt() runs SPU code with the host
+ * FP environment set to round-toward-zero + denormals-are-zero + flush-to-zero
+ * (spu_fp_enter / SPU_MXCSR). Under that environment a host SSE result equals
+ * the SPU result for every lane whose result is not "special": the only
+ * divergences are an exponent-255 operand (host Inf/NaN in, Inf/NaN out), an
+ * overflow (round-toward-zero overflow returns FLT_MAX), and the sign of zero.
+ * So the fast path is the plain SSE op, one compare to detect a lane at or
+ * beyond FLT_MAX (-> exact integer slow path, spu__sp_*) and one mask to turn
+ * zero results into +0. fma is computed in double (the 24x24-bit product is
+ * exact, the sum rounds toward zero, and directed rounding twice is the same as
+ * once), which is fused and needs no FMA hardware.
+ *
+ * Without the SPU environment (unit tests, a helper called from a PPU thread)
+ * the fast paths round to nearest and keep denormals -- close, not exact. The
+ * exact paths (spu__sp_*) never depend on the environment.
+ *
+ * DOUBLE PRECISION is IEEE with round-to-nearest (FPSCR default), denormal
+ * operands read as signed zero, denormal results flushed to signed zero, and
+ * every NaN result the default NaN 0x7FF8000000000000. The DP helpers switch
+ * the host rounding mode to nearest for the duration of the operation (DAZ/FTZ
+ * stay on), which is cheap and DP is rare in SPU code.
+ */
+#ifndef SPU_FLOAT_H
+#define SPU_FLOAT_H
+
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__) || defined(_M_IX86)
+#  include <emmintrin.h>
+#  if defined(__FMA__)
+#    include <immintrin.h>   /* _mm_fmadd_ps (SPU_FMA3); MinGW/zig do not pull it in via emmintrin.h */
+#  endif
+#  define SPU_FP_SSE2 1
+#endif
+
+#if defined(__GNUC__) || defined(__clang__)
+#  define SPU_FP_NOINLINE __attribute__((noinline, cold))
+#  define SPU_FP_UNLIKELY(x) __builtin_expect(!!(x), 0)
+#else
+#  define SPU_FP_NOINLINE
+#  define SPU_FP_UNLIKELY(x) (x)
+#endif
+
+/* ---------------------------------------------------------------------------
+ * Host FP environment for SPU execution
+ * -------------------------------------------------------------------------*/
+#if defined(SPU_FP_SSE2)
+/* MXCSR: all exceptions masked (0x1F80) | round toward zero (0x6000) |
+ * flush-to-zero (0x8000) | denormals-are-zero (0x0040). */
+#  define SPU_MXCSR 0xFFC0u
+typedef unsigned spu_fp_env;
+static inline spu_fp_env spu_fp_enter(void) { spu_fp_env o = _mm_getcsr(); _mm_setcsr(SPU_MXCSR); return o; }
+static inline void spu_fp_leave(spu_fp_env o) { _mm_setcsr(o); }
+/* Round-to-nearest window for the double-precision helpers. */
+static inline spu_fp_env spu__dp_begin(void) { spu_fp_env o = _mm_getcsr(); _mm_setcsr(o & ~0x6000u); return o; }
+static inline void spu__dp_end(spu_fp_env o) { _mm_setcsr(o); }
+#elif defined(__aarch64__)
+typedef unsigned long long spu_fp_env;
+static inline spu_fp_env spu__fpcr(void) { unsigned long long v; __asm__ volatile("mrs %0, fpcr" : "=r"(v)); return v; }
+static inline void spu__set_fpcr(spu_fp_env v) { __asm__ volatile("msr fpcr, %0" :: "r"(v)); }
+/* RMode (bits 22-23) = 0b11 round toward zero, FZ (bit 24) flushes inputs and outputs. */
+static inline spu_fp_env spu_fp_enter(void) { spu_fp_env o = spu__fpcr(); spu__set_fpcr((o & ~(3ull << 22)) | (3ull << 22) | (1ull << 24)); return o; }
+static inline void spu_fp_leave(spu_fp_env o) { spu__set_fpcr(o); }
+static inline spu_fp_env spu__dp_begin(void) { spu_fp_env o = spu__fpcr(); spu__set_fpcr(o & ~(3ull << 22)); return o; }
+static inline void spu__dp_end(spu_fp_env o) { spu__set_fpcr(o); }
+#else
+typedef unsigned spu_fp_env;
+static inline spu_fp_env spu_fp_enter(void) { return 0; }
+static inline void spu_fp_leave(spu_fp_env o) { (void)o; }
+static inline spu_fp_env spu__dp_begin(void) { return 0; }
+static inline void spu__dp_end(spu_fp_env o) { (void)o; }
+#endif
+
+/* Keep an FP value from being computed outside a rounding-mode window: the
+ * empty asm "modifies" it, and asm volatile stays ordered against the MXCSR
+ * writes (both are side effects). */
+#if (defined(__GNUC__) || defined(__clang__)) && defined(SPU_FP_SSE2)
+#  define SPU_FP_OPAQUE(v) __asm__ volatile("" : "+x"(v))
+#elif (defined(__GNUC__) || defined(__clang__)) && defined(__aarch64__)
+#  define SPU_FP_OPAQUE(v) __asm__ volatile("" : "+w"(v))
+#else
+#  define SPU_FP_OPAQUE(v) ((void)0)
+#endif
+
+/* Pin a value as runtime-only: the empty asm "might change" it, so the compiler
+ * cannot constant-fold an SPU float op whose operands it happens to know (a
+ * lifted `ilhu`/`iohl` constant feeding `fm`). Folding happens at compile time
+ * under the default round-to-nearest/IEEE rules, not the SPU's; the pinned op
+ * runs at run time under the SPU environment. Costs no instruction. */
+#if (defined(__GNUC__) || defined(__clang__)) && defined(SPU_FP_SSE2)
+#  define SPU_FP_PIN(v) __asm__("" : "+x"(v))
+#else
+#  define SPU_FP_PIN(v) ((void)0)
+#endif
+
+static inline uint32_t spu__f2u(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+static inline float spu__u2f(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+static inline uint64_t spu__d2u(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+static inline double spu__u2d(uint64_t u) { double d; memcpy(&d, &u, 8); return d; }
+
+/* ---------------------------------------------------------------------------
+ * Exact single-precision arithmetic (slow path; environment independent).
+ * A value is (sign, m, e) = (-1)^sign * m * 2^e, m an integer.
+ * -------------------------------------------------------------------------*/
+#if defined(__SIZEOF_INT128__)
+#define SPU_FP_EXACT 1
+typedef unsigned __int128 spu__wide;
+
+static inline int spu__bitlen_w(spu__wide m)
+{
+    uint64_t hi = (uint64_t)(m >> 64), lo = (uint64_t)m;
+    return hi ? 128 - __builtin_clzll(hi) : (lo ? 64 - __builtin_clzll(lo) : 0);
+}
+
+/* Round toward zero to a 24-bit significand and encode: +0 below 2^-126,
+ * saturation beyond the extended range, exponent 255 allowed. */
+static inline uint32_t spu__sp_pack(uint32_t s, spu__wide m, int e)
+{
+    if (!m) return 0;
+    int L = spu__bitlen_w(m);
+    if (L > 24) { m >>= (L - 24); e += L - 24; }
+    else        { m <<= (24 - L); e -= 24 - L; }
+    int ex = e + 150;                          /* m in [2^23,2^24): field = e+23+127 */
+    if (ex <= 0)  return 0;
+    if (ex > 255) return (s << 31) | 0x7FFFFFFFu;
+    return (s << 31) | ((uint32_t)ex << 23) | ((uint32_t)m & 0x7FFFFFu);
+}
+
+static inline void spu__sp_unpack(uint32_t x, uint32_t* s, uint64_t* m, int* e)
+{
+    uint32_t ex = (x >> 23) & 0xFFu;
+    *s = x >> 31;
+    if (!ex) { *m = 0; *e = 0; return; }       /* zero / denormal operand = zero */
+    *m = (x & 0x7FFFFFu) | 0x800000u;
+    *e = (int)ex - 150;
+}
+
+/* Exact (s1,m1,e1) + (s2,m2,e2), m up to 48 bits, rounded toward zero. */
+static inline uint32_t spu__sp_add(uint32_t s1, uint64_t m1, int e1,
+                                   uint32_t s2, uint64_t m2, int e2)
+{
+    if (!m2) return spu__sp_pack(s1, m1, e1);
+    if (!m1) return spu__sp_pack(s2, m2, e2);
+    if (e1 < e2) {
+        uint32_t ts = s1; s1 = s2; s2 = ts;
+        uint64_t tm = m1; m1 = m2; m2 = tm;
+        int te = e1; e1 = e2; e2 = te;
+    }
+    spu__wide a = m1, b = m2;
+    int d = e1 - e2, e;
+    if (d > 72) {
+        /* The smaller operand lies wholly below the 24 bits the result keeps
+         * (m2 < 2^48 sits >= 24 bits under a's lowest bit): only its sign can
+         * matter (a borrow under round-toward-zero), so a one-unit sticky is
+         * exact for the truncated result. */
+        a <<= 72; b = 1; e = e1 - 72;
+    } else {
+        a <<= d; e = e2;
+    }
+    spu__wide m; uint32_t s;
+    if (s1 == s2)    { m = a + b; s = s1; }
+    else if (a >= b) { m = a - b; s = s1; }
+    else             { m = b - a; s = s2; }
+    return spu__sp_pack(s, m, e);              /* exact zero -> +0 */
+}
+
+static inline uint32_t spu__sp_fa1(uint32_t a, uint32_t b, uint32_t negb)
+{
+    uint32_t sa, sb; uint64_t ma, mb; int ea, eb;
+    spu__sp_unpack(a, &sa, &ma, &ea); spu__sp_unpack(b, &sb, &mb, &eb);
+    return spu__sp_add(sa, ma, ea, sb ^ negb, mb, eb);
+}
+static inline uint32_t spu__sp_fm1(uint32_t a, uint32_t b)
+{
+    uint32_t sa, sb; uint64_t ma, mb; int ea, eb;
+    spu__sp_unpack(a, &sa, &ma, &ea); spu__sp_unpack(b, &sb, &mb, &eb);
+    return spu__sp_pack(sa ^ sb, (spu__wide)(ma * mb), ea + eb);
+}
+/* (negp ? -(a*b) : a*b) + (negc ? -c : c), fused. */
+static inline uint32_t spu__sp_fma1(uint32_t a, uint32_t b, uint32_t c, uint32_t negp, uint32_t negc)
+{
+    uint32_t sa, sb, sc; uint64_t ma, mb, mc; int ea, eb, ec;
+    spu__sp_unpack(a, &sa, &ma, &ea); spu__sp_unpack(b, &sb, &mb, &eb);
+    spu__sp_unpack(c, &sc, &mc, &ec);
+    return spu__sp_add(sa ^ sb ^ negp, ma * mb, ea + eb, sc ^ negc, mc, ec);
+}
+/* int (|v| < 2^32) * 2^scale, rounded toward zero. */
+static inline uint32_t spu__sp_from_int(uint32_t s, uint64_t mag, int scale)
+{
+    return spu__sp_pack(s, mag, scale);
+}
+#endif /* __SIZEOF_INT128__ */
+
+/* ---------------------------------------------------------------------------
+ * Fast paths
+ * -------------------------------------------------------------------------*/
+/* WebAssembly SIMD128 (wasm-spu): vector forms of the wasm paths, bit-identical to them / the exact model.
+ * -DSPU_WASM_SCALAR=1 keeps the scalar wasm code (A/B and the reference in work/wasm/spu/test). */
+#if defined(__wasm_simd128__) && !defined(SPU_WASM_SCALAR)
+#  define SPU_FP_WSIMD 1
+#  include <wasm_simd128.h>
+static inline v128_t spu__wv(u128 a) { v128_t r; memcpy(&r, &a, 16); return r; }
+static inline u128 spu__wu(v128_t a) { u128 r; memcpy(&r, &a, 16); return r; }
+#endif
+#if defined(SPU_FP_SSE2)
+static inline __m128 spu__ps(u128 a) { __m128 r; memcpy(&r, &a, 16); SPU_FP_PIN(r); return r; }
+static inline __m128i spu__pi(u128 a) { __m128i r; memcpy(&r, &a, 16); return r; }
+static inline u128 spu__from_ps(__m128 a) { u128 r; memcpy(&r, &a, 16); return r; }
+static inline u128 spu__from_pi(__m128i a) { u128 r; memcpy(&r, &a, 16); return r; }
+/* Lanes whose host result is at/above FLT_MAX in magnitude: an exponent-255
+ * operand (host Inf/NaN propagates) or a round-toward-zero overflow. */
+static inline int spu__fbad(__m128 r)
+{
+    __m128i ab = _mm_and_si128(_mm_castps_si128(r), _mm_set1_epi32(0x7FFFFFFF));
+    return _mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(ab, _mm_set1_epi32(0x7F7FFFFE))));
+}
+/* Zero-exponent result lanes (+-0, or a denormal the host did not flush) -> +0. */
+static inline __m128 spu__fclean(__m128 r)
+{
+    __m128i ri = _mm_castps_si128(r);
+    __m128i z  = _mm_cmpeq_epi32(_mm_and_si128(ri, _mm_set1_epi32(0x7F800000)), _mm_setzero_si128());
+    return _mm_castsi128_ps(_mm_andnot_si128(z, ri));
+}
+#endif
+
+#if defined(SPU_FP_EXACT)
+static SPU_FP_NOINLINE u128 spu__fa_slow(u128 a, u128 b, uint32_t negb)
+{ u128 r; for (int i = 0; i < 4; i++) r._u32[i] = spu__sp_fa1(a._u32[i], b._u32[i], negb); return r; }
+static SPU_FP_NOINLINE u128 spu__fm_slow(u128 a, u128 b)
+{ u128 r; for (int i = 0; i < 4; i++) r._u32[i] = spu__sp_fm1(a._u32[i], b._u32[i]); return r; }
+static SPU_FP_NOINLINE u128 spu__fma_slow(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc)
+{ u128 r; for (int i = 0; i < 4; i++) r._u32[i] = spu__sp_fma1(a._u32[i], b._u32[i], c._u32[i], negp, negc); return r; }
+#if defined(SPU_FP_SSE2)
+/* Lane-wise fix-up: the SSE ops are lane-independent, and a lane whose host
+ * result is not "bad" (spu__fbad) already equals the SPU result after
+ * spu__fclean -- the rule the fast path itself relies on. So when only some
+ * lanes are special (typically one exponent-255 / garbage lane of a vector
+ * whose other three are ordinary numbers) recompute just those lanes with the
+ * exact model and keep the fast result for the rest: bit-identical to
+ * recomputing all four, at a quarter of the cost per bad lane. `bad` is the
+ * spu__fbad movemask. */
+/* Fast exact lane model (PS3_SPU_FP_FASTFIX, default on; =0 or the live PS3_SPU_FP_FASTFIX_OFF_FILE -> the
+ * integer model above). Every SPU single -- exponent 255 included -- is exactly a double (exponent field + 896,
+ * significand << 29; exponent 0 = zero). A product of two is exact in a double (48 significant bits, exponents
+ * within +-300), and a sum rounded toward zero to 53 bits and then truncated to 24 is the exact sum truncated to
+ * 24 (truncations compose; every 24-bit value is a 53-bit value). Results stay normal doubles (a non-zero exact
+ * result is a multiple of 2^-298). So: convert, one multiply and/or one add in double under round-toward-zero
+ * (the SPU environment already is; otherwise set for the lane), then pack like spu__sp_pack: +0 below 2^-126,
+ * sign|0x7FFFFFFF beyond the extended range, exponent 255 kept. tests/test_spu_float.c checks it against
+ * the integer model on every lane. The fast model recomputes all four lanes (it is exact for every input, so
+ * the bad mask is not needed) with vector integer ops on the bit patterns; THP8's QBVS culling job (bounds at the
+ * extended range) spent ~20% of its time in this fix-up with the per-lane integer model. */
+static inline double spu__sp2d(uint32_t x)
+{
+    const uint32_t ex = (x >> 23) & 0xFFu;
+    if (!ex) return 0.0;
+    return spu__u2d(((uint64_t)(x >> 31) << 63) | ((uint64_t)(ex + 896u) << 52) | ((uint64_t)(x & 0x7FFFFFu) << 29));
+}
+static inline uint32_t spu__d2sp(double d)
+{
+    const uint64_t u = spu__d2u(d);
+    const int ex = (int)((u >> 52) & 0x7FFu) - 896;
+    if (ex <= 0) return 0;
+    const uint32_t s = (uint32_t)(u >> 63) << 31;
+    if (ex > 255) return s | 0x7FFFFFFFu;
+    return s | ((uint32_t)ex << 23) | (uint32_t)((u >> 29) & 0x7FFFFFu);
+}
+/* The same, four lanes at a time (SSE2 integer ops on the bit patterns): lanes 0,1 -> *lo, 2,3 -> *hi. */
+static inline void spu__sp2d4(__m128i v, __m128d* lo, __m128d* hi)
+{
+    const __m128i z = _mm_setzero_si128(), sb = _mm_set1_epi64x(1ll << 60), eb = _mm_set1_epi64x(896ll << 52);
+    const __m128i zero = _mm_cmpeq_epi32(_mm_and_si128(v, _mm_set1_epi32(0x7F800000)), z);
+    __m128i tl = _mm_slli_epi64(_mm_unpacklo_epi32(v, z), 29), th = _mm_slli_epi64(_mm_unpackhi_epi32(v, z), 29);
+    tl = _mm_or_si128(_mm_add_epi64(_mm_andnot_si128(sb, tl), eb), _mm_slli_epi64(_mm_and_si128(tl, sb), 3));
+    th = _mm_or_si128(_mm_add_epi64(_mm_andnot_si128(sb, th), eb), _mm_slli_epi64(_mm_and_si128(th, sb), 3));
+    *lo = _mm_castsi128_pd(_mm_andnot_si128(_mm_unpacklo_epi32(zero, zero), tl));
+    *hi = _mm_castsi128_pd(_mm_andnot_si128(_mm_unpackhi_epi32(zero, zero), th));
+}
+static inline __m128i spu__d2sp4(__m128d lo, __m128d hi)
+{
+    const __m128i ul = _mm_castpd_si128(lo), uh = _mm_castpd_si128(hi);
+    const __m128i ml = _mm_srli_epi64(ul, 29), mh = _mm_srli_epi64(uh, 29);
+    const __m128i M = _mm_and_si128(_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(ml), _mm_castsi128_ps(mh), _MM_SHUFFLE(2, 0, 2, 0))),
+                                    _mm_set1_epi32(0x7FFFFF));
+    const __m128i H = _mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(ul), _mm_castsi128_ps(uh), _MM_SHUFFLE(3, 1, 3, 1)));
+    const __m128i S = _mm_and_si128(H, _mm_set1_epi32((int)0x80000000));
+    const __m128i E = _mm_sub_epi32(_mm_and_si128(_mm_srli_epi32(H, 20), _mm_set1_epi32(0x7FF)), _mm_set1_epi32(896));
+    const __m128i under = _mm_cmpgt_epi32(_mm_set1_epi32(1), E), over = _mm_cmpgt_epi32(E, _mm_set1_epi32(255));
+    __m128i r = _mm_or_si128(S, _mm_or_si128(_mm_slli_epi32(E, 23), M));
+    r = _mm_or_si128(_mm_andnot_si128(over, r), _mm_and_si128(over, _mm_or_si128(S, _mm_set1_epi32(0x7FFFFFFF))));
+    return _mm_andnot_si128(under, r);
+}
+int spu_fp_fastfix_on(void);   /* runtime/spu/spu_channels.c: env + live off-file */
+/* (negp ? -(a*b) : a*b) + (negc ? -c : c) for all four lanes, mul = 0: a + (negc ? -c : c). Round toward zero is
+ * the SPU environment's mode; set it for the call when the caller runs without it. */
+static inline u128 spu__fx4(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc, int mul, int add)
+{
+    __m128d al, ah, bl, bh, cl, ch;
+    spu__sp2d4(_mm_xor_si128(spu__pi(a), _mm_set1_epi32((int)(negp << 31))), &al, &ah);
+    if (mul) spu__sp2d4(spu__pi(b), &bl, &bh);
+    if (add) spu__sp2d4(_mm_xor_si128(spu__pi(c), _mm_set1_epi32((int)(negc << 31))), &cl, &ch);
+    const spu_fp_env o = _mm_getcsr(); const int set = (o & 0x6000u) != 0x6000u;
+    if (set) _mm_setcsr(o | 0x6000u);
+    SPU_FP_OPAQUE(al); SPU_FP_OPAQUE(ah);
+    if (mul) { SPU_FP_OPAQUE(bl); SPU_FP_OPAQUE(bh); al = _mm_mul_pd(al, bl); ah = _mm_mul_pd(ah, bh); }
+    if (add) { SPU_FP_OPAQUE(cl); SPU_FP_OPAQUE(ch); SPU_FP_OPAQUE(al); SPU_FP_OPAQUE(ah); al = _mm_add_pd(al, cl); ah = _mm_add_pd(ah, ch); }
+    SPU_FP_OPAQUE(al); SPU_FP_OPAQUE(ah);
+    if (set) _mm_setcsr(o);
+    return spu__from_pi(spu__d2sp4(al, ah));
+}
+/* The fix-up call itself (THP8 QBVS: a flagged lane on a large share of its fma's, so the call is hot):
+ *  - the switch is a global read (g_spu_fp_fastfix: -1 unread, 0 off, 1 on, 2 = on with a live off-file -> ask);
+ *  - vector arguments in registers and no callee-saved XMM: on Win64 the fix-ups use the SysV convention
+ *    (SPU_FP_FIXCC_SYSV, default 1 with clang on x86-64 Windows; the Win64 convention passed every u128 through
+ *    memory and saved xmm6..xmm15 on each call), and no stack cookie (nothing address-taken).
+ * Same values either way (the arithmetic is unchanged). Build option: -DSPU_FP_FIXCC_SYSV=0. */
+extern volatile int g_spu_fp_fastfix;
+static inline int spu__ff_on(void) { const int g = g_spu_fp_fastfix; return (g == 0 || g == 1) ? g : spu_fp_fastfix_on(); }
+#ifndef SPU_FP_FIXCC_SYSV
+#  if defined(_WIN32) && defined(__x86_64__) && defined(__clang__)
+#    define SPU_FP_FIXCC_SYSV 1
+#  else
+#    define SPU_FP_FIXCC_SYSV 0
+#  endif
+#endif
+#if SPU_FP_FIXCC_SYSV
+#  define SPU_FP_FIXCC __attribute__((sysv_abi, no_stack_protector))
+#elif defined(__clang__)
+#  define SPU_FP_FIXCC __attribute__((no_stack_protector))
+#else
+#  define SPU_FP_FIXCC
+#endif
+static SPU_FP_NOINLINE SPU_FP_FIXCC __m128i spu__fa_fixv(__m128i r, int bad, __m128i a, __m128i b, uint32_t negb)
+{
+    const u128 A = spu__from_pi(a), B = spu__from_pi(b);
+    if (spu__ff_on()) return spu__pi(spu__fx4(A, A, B, 0, negb, 0, 1));
+    u128 R = spu__from_pi(r);
+    for (int i = 0; i < 4; i++) if (bad & (1 << i)) R._u32[i] = spu__sp_fa1(A._u32[i], B._u32[i], negb);
+    return spu__pi(R);
+}
+static SPU_FP_NOINLINE SPU_FP_FIXCC __m128i spu__fm_fixv(__m128i r, int bad, __m128i a, __m128i b)
+{
+    const u128 A = spu__from_pi(a), B = spu__from_pi(b);
+    if (spu__ff_on()) return spu__pi(spu__fx4(A, B, B, 0, 0, 1, 0));
+    u128 R = spu__from_pi(r);
+    for (int i = 0; i < 4; i++) if (bad & (1 << i)) R._u32[i] = spu__sp_fm1(A._u32[i], B._u32[i]);
+    return spu__pi(R);
+}
+static SPU_FP_NOINLINE SPU_FP_FIXCC __m128i spu__fma_fixv(__m128i r, int bad, __m128i a, __m128i b, __m128i c, uint32_t negp, uint32_t negc)
+{
+    const u128 A = spu__from_pi(a), B = spu__from_pi(b), C = spu__from_pi(c);
+    if (spu__ff_on()) return spu__pi(spu__fx4(A, B, C, negp, negc, 1, 1));
+    u128 R = spu__from_pi(r);
+    for (int i = 0; i < 4; i++) if (bad & (1 << i)) R._u32[i] = spu__sp_fma1(A._u32[i], B._u32[i], C._u32[i], negp, negc);
+    return spu__pi(R);
+}
+static inline u128 spu__fa_fix(u128 r, int bad, u128 a, u128 b, uint32_t negb)
+{ return spu__from_pi(spu__fa_fixv(spu__pi(r), bad, spu__pi(a), spu__pi(b), negb)); }
+static inline u128 spu__fm_fix(u128 r, int bad, u128 a, u128 b)
+{ return spu__from_pi(spu__fm_fixv(spu__pi(r), bad, spu__pi(a), spu__pi(b))); }
+static inline u128 spu__fma_fix(u128 r, int bad, u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc)
+{ return spu__from_pi(spu__fma_fixv(spu__pi(r), bad, spu__pi(a), spu__pi(b), spu__pi(c), negp, negc)); }
+#endif
+#endif
+
+#if defined(SPU_FP_EXACT) && defined(__wasm__)
+/* WebAssembly per-lane model (scalar; used by the scalar wasm helpers below and kept defined next to the SIMD128
+ * ones for work/wasm/hosttest/spu_float_wasm_test.c): */
+static inline double spu__wf(uint32_t u) { return (u & 0x7F800000u) ? (double)spu__u2f(u) : 0.0; }
+/* exact value x + e (|e| <= half an ulp of x); 0xFFFFFFFF = not representable here, use the exact model */
+static inline uint32_t spu__wrtz(double x, double e)
+{
+    const double ax = x < 0 ? -x : x;
+    if (ax >= 0x1p128) return 0xFFFFFFFFu;
+    if (ax < 0x1p-126) return 0;               /* +0 below 2^-126 ... */
+    if (ax == 0x1p-126 && ((x > 0) ? (e < 0) : (e > 0))) return 0;   /* ... also just below it */
+    const float f = (float)x;
+    uint32_t u = spu__f2u(f);
+    if ((u & 0x7F800000u) == 0x7F800000u) return 0xFFFFFFFFu;   /* rounded up to 2^128 */
+    const double d = (double)f - x;            /* exact (Sterbenz) */
+    const int away = d != 0 ? ((x > 0) ? (d > 0) : (d < 0)) : ((x > 0) ? (e < 0) : (e > 0));
+    if (away) u -= 1;                          /* one ulp toward zero (magnitude), across a binade too */
+    if (!(u & 0x7F800000u)) return 0;          /* stepped below 2^-126 */
+    return u;
+}
+static inline int spu__wspecial(uint32_t u) { return (u & 0x7F800000u) == 0x7F800000u; }
+static inline uint32_t spu__wfa1(uint32_t a, uint32_t b, uint32_t negb)
+{
+    if (spu__wspecial(a) || spu__wspecial(b)) return spu__sp_fa1(a, b, negb);
+    const double x = spu__wf(a), y = negb ? -spu__wf(b) : spu__wf(b);
+    const double s = x + y, bb = s - x, e = (x - (s - bb)) + (y - bb);   /* TwoSum */
+    const uint32_t r = spu__wrtz(s, e);
+    return r == 0xFFFFFFFFu ? spu__sp_fa1(a, b, negb) : r;
+}
+static inline uint32_t spu__wfm1(uint32_t a, uint32_t b)
+{
+    if (spu__wspecial(a) || spu__wspecial(b)) return spu__sp_fm1(a, b);
+    const uint32_t r = spu__wrtz(spu__wf(a) * spu__wf(b), 0.0);           /* exact product */
+    return r == 0xFFFFFFFFu ? spu__sp_fm1(a, b) : r;
+}
+static inline uint32_t spu__wfma1(uint32_t a, uint32_t b, uint32_t c, uint32_t negp, uint32_t negc)
+{
+    if (spu__wspecial(a) || spu__wspecial(b) || spu__wspecial(c)) return spu__sp_fma1(a, b, c, negp, negc);
+    double p = spu__wf(a) * spu__wf(b), y = spu__wf(c);                 /* p exact */
+    if (negp) p = -p;
+    if (negc) y = -y;
+    const double s = p + y, bb = s - p, e = (p - (s - bb)) + (y - bb);
+    const uint32_t r = spu__wrtz(s, e);
+    return r == 0xFFFFFFFFu ? spu__sp_fma1(a, b, c, negp, negc) : r;
+}
+#endif
+
+/* ---- the single-precision arithmetic helpers ---- */
+#if defined(SPU_FP_SSE2) && defined(SPU_FP_EXACT)
+static inline u128 spu_fa(u128 a, u128 b)
+{
+    __m128 r = _mm_add_ps(spu__ps(a), spu__ps(b));
+    int bad = spu__fbad(r);
+    if (SPU_FP_UNLIKELY(bad)) return spu__fa_fix(spu__from_ps(spu__fclean(r)), bad, a, b, 0);
+    return spu__from_ps(spu__fclean(r));
+}
+static inline u128 spu_fs(u128 a, u128 b)
+{
+    __m128 r = _mm_sub_ps(spu__ps(a), spu__ps(b));
+    int bad = spu__fbad(r);
+    if (SPU_FP_UNLIKELY(bad)) return spu__fa_fix(spu__from_ps(spu__fclean(r)), bad, a, b, 1);
+    return spu__from_ps(spu__fclean(r));
+}
+static inline u128 spu_fm(u128 a, u128 b)
+{
+    __m128 r = _mm_mul_ps(spu__ps(a), spu__ps(b));
+    int bad = spu__fbad(r);
+    if (SPU_FP_UNLIKELY(bad)) return spu__fm_fix(spu__from_ps(spu__fclean(r)), bad, a, b);
+    return spu__from_ps(spu__fclean(r));
+}
+/* Fused via double: the product of two 24-bit significands is exact in a
+ * double, the add rounds once (toward zero under the SPU environment), and
+ * the narrowing rounds toward zero again -- equal to one directed rounding. */
+/* SPU_FMA3 (default 1; only when the TU is compiled with -mfma, i.e. an FMA3 build): one vfmadd. The fused
+ * result is the exact a*b+c rounded once by MXCSR (RTZ under SPU_MXCSR) -- the same value the double-precision
+ * sequence below produces (exact product, two truncations that compose to one); DAZ zeroes denormal inputs and
+ * FTZ flushes tiny results in both, and spu__fbad/fclean treat the edges identically. tests/test_spu_float.c
+ * (built with -mfma) checks it against the exact model, incl. near-cancellation operands. */
+#if defined(__FMA__) && (!defined(SPU_FMA3) || SPU_FMA3)
+static inline __m128 spu__fma_ps(__m128 A, __m128 B, __m128 C) { return _mm_fmadd_ps(A, B, C); }
+#else
+static inline __m128 spu__fma_ps(__m128 A, __m128 B, __m128 C)
+{
+    __m128d plo = _mm_mul_pd(_mm_cvtps_pd(A), _mm_cvtps_pd(B));
+    __m128d phi = _mm_mul_pd(_mm_cvtps_pd(_mm_movehl_ps(A, A)), _mm_cvtps_pd(_mm_movehl_ps(B, B)));
+    __m128d slo = _mm_add_pd(plo, _mm_cvtps_pd(C));
+    __m128d shi = _mm_add_pd(phi, _mm_cvtps_pd(_mm_movehl_ps(C, C)));
+    return _mm_movelh_ps(_mm_cvtpd_ps(slo), _mm_cvtpd_ps(shi));
+}
+#endif
+static inline u128 spu_fma(u128 a, u128 b, u128 c)
+{
+    __m128 r = spu__fma_ps(spu__ps(a), spu__ps(b), spu__ps(c));
+    int bad = spu__fbad(r);
+    if (SPU_FP_UNLIKELY(bad)) return spu__fma_fix(spu__from_ps(spu__fclean(r)), bad, a, b, c, 0, 0);
+    return spu__from_ps(spu__fclean(r));
+}
+/* fms: a*b - c */
+static inline u128 spu_fms(u128 a, u128 b, u128 c)
+{
+    __m128 C = _mm_xor_ps(spu__ps(c), _mm_castsi128_ps(_mm_set1_epi32((int)0x80000000)));
+    __m128 r = spu__fma_ps(spu__ps(a), spu__ps(b), C);
+    int bad = spu__fbad(r);
+    if (SPU_FP_UNLIKELY(bad)) return spu__fma_fix(spu__from_ps(spu__fclean(r)), bad, a, b, c, 0, 1);
+    return spu__from_ps(spu__fclean(r));
+}
+/* fnms: c - a*b */
+static inline u128 spu_fnms(u128 a, u128 b, u128 c)
+{
+    __m128 A = _mm_xor_ps(spu__ps(a), _mm_castsi128_ps(_mm_set1_epi32((int)0x80000000)));
+    __m128 r = spu__fma_ps(A, spu__ps(b), spu__ps(c));
+    int bad = spu__fbad(r);
+    if (SPU_FP_UNLIKELY(bad)) return spu__fma_fix(spu__from_ps(spu__fclean(r)), bad, a, b, c, 1, 0);
+    return spu__from_ps(spu__fclean(r));
+}
+#elif defined(SPU_FP_EXACT) && defined(SPU_FP_WSIMD)
+/* WebAssembly SIMD128: the per-lane model of the scalar wasm path below (exact value in double, TwoSum error
+ * term, round to nearest float, then one ulp toward zero when that landed beyond the exact value), computed two
+ * lanes at a time in f64x2 and inline. The scalar path was an out-of-line call per op (u128 by pointer) with
+ * four branchy lanes; THP8's skinning job runs ~170 of these per vertex group. A vector with a lane the inline
+ * model does not cover -- an exponent-255 operand, or a result that rounds to 2^128 or beyond (SPU extended range
+ * / saturation) -- is recomputed by the cold "full" form (spu__wf*_full), the same model extended to the whole
+ * SPU range: an exponent-255 operand is built as a double from its bits, and a result of 2^128 or more is
+ * rounded at half its size and put back with exponent field +1 (beyond the range that lands on the saturation
+ * value sign|0x7FFFFFFF). No __int128 (a libcall on wasm; the QBVS job hit it in ~8% of its time). Zero-exponent
+ * operands read as zero and every zero / sub-2^-126 result is +0. Bit-identical to the exact model spu__sp_*
+ * (work/wasm/spu/test/simd_test.c, randomized + edge operands). SPU_WASM_SCALAR=1 restores the scalar path. */
+/* operand with a zero exponent field -> +0 */
+static inline v128_t spu__wz(v128_t x)
+{
+    const v128_t e = wasm_v128_and(x, wasm_i32x4_const_splat(0x7F800000));
+    return wasm_v128_andnot(x, wasm_i32x4_eq(e, wasm_i32x4_const_splat(0)));
+}
+/* lanes with exponent field 255 */
+static inline v128_t spu__wsp(v128_t x)
+{
+    const v128_t m = wasm_i32x4_const_splat(0x7F800000);
+    return wasm_i32x4_eq(wasm_v128_and(x, m), m);
+}
+static inline v128_t spu__wlo(v128_t x) { return wasm_f64x2_promote_low_f32x4(x); }
+static inline v128_t spu__whi(v128_t x) { return wasm_f64x2_promote_low_f32x4(wasm_i32x4_shuffle(x, x, 2, 3, 2, 3)); }
+/* TwoSum: s + *e == x + y exactly */
+static inline v128_t spu__w2sum(v128_t x, v128_t y, v128_t* e)
+{
+    const v128_t s = wasm_f64x2_add(x, y), bb = wasm_f64x2_sub(s, x);
+    *e = wasm_f64x2_add(wasm_f64x2_sub(x, wasm_f64x2_sub(s, bb)), wasm_f64x2_sub(y, bb));
+    return s;
+}
+/* 64-bit lane mask (all ones / zero) of "rounding to nearest float went away from zero" for exact value s + e */
+static inline v128_t spu__waway(v128_t s, v128_t e, v128_t f2)
+{
+    const v128_t z = wasm_f64x2_const_splat(0.0);
+    const v128_t d = wasm_f64x2_sub(f2, s);                                   /* exact (Sterbenz) */
+    v128_t t = wasm_v128_bitselect(d, wasm_f64x2_neg(e), wasm_f64x2_ne(d, z)); /* d != 0 ? d : -e */
+    t = wasm_v128_xor(t, wasm_v128_and(s, wasm_i64x2_const_splat((long long)0x8000000000000000ull)));
+    return wasm_f64x2_gt(t, z);
+}
+/* round-toward-zero to SPU float of (slo+elo | shi+ehi); *bad = lanes the model does not cover */
+static inline v128_t spu__wrtz4(v128_t slo, v128_t elo, v128_t shi, v128_t ehi, v128_t* bad)
+{
+    const v128_t f = wasm_i32x4_shuffle(wasm_f32x4_demote_f64x2_zero(slo), wasm_f32x4_demote_f64x2_zero(shi), 0, 1, 4, 5);
+    const v128_t alo = spu__waway(slo, elo, spu__wlo(f));
+    const v128_t ahi = spu__waway(shi, ehi, spu__whi(f));
+    const v128_t u = wasm_i32x4_add(f, wasm_i32x4_shuffle(alo, ahi, 0, 2, 4, 6));  /* -1 = one ulp toward zero */
+    *bad = spu__wsp(f);                                                        /* rounded to 2^128 or beyond */
+    return wasm_v128_andnot(u, wasm_i32x4_eq(wasm_v128_and(u, wasm_i32x4_const_splat(0x7F800000)),
+                                             wasm_i32x4_const_splat(0)));      /* below 2^-126 -> +0 */
+}
+static inline v128_t spu__wneg32(v128_t x) { return wasm_v128_xor(x, wasm_i32x4_const_splat((int)0x80000000u)); }
+/* ---- the full-range form (cold) ---- */
+/* double of each (zero-exponent-cleared) SPU operand lane of one half, exponent 255 included: lower the exponent
+ * field by one (a finite float), widen, double it again (exact) */
+static inline v128_t spu__wxd(v128_t x, int hi)
+{
+    const v128_t sp = spu__wsp(x);
+    const v128_t xr = wasm_i32x4_sub(x, wasm_v128_and(sp, wasm_i32x4_const_splat(0x00800000)));
+    const v128_t d = hi ? spu__whi(xr) : spu__wlo(xr);
+    const v128_t sp64 = hi ? wasm_i64x2_extend_high_i32x4(sp) : wasm_i64x2_extend_low_i32x4(sp);
+    return wasm_v128_bitselect(wasm_f64x2_add(d, d), d, sp64);
+}
+/* round-toward-zero to SPU float of (slo+elo | shi+ehi) over the whole SPU range (no "bad" lanes) */
+static inline v128_t spu__wrtzx(v128_t slo, v128_t elo, v128_t shi, v128_t ehi)
+{
+    const v128_t lim = wasm_f64x2_const_splat(0x1p128), h = wasm_f64x2_const_splat(0.5);
+    const v128_t blo = wasm_f64x2_ge(wasm_f64x2_abs(slo), lim), bhi = wasm_f64x2_ge(wasm_f64x2_abs(shi), lim);
+    slo = wasm_v128_bitselect(wasm_f64x2_mul(slo, h), slo, blo); elo = wasm_v128_bitselect(wasm_f64x2_mul(elo, h), elo, blo);
+    shi = wasm_v128_bitselect(wasm_f64x2_mul(shi, h), shi, bhi); ehi = wasm_v128_bitselect(wasm_f64x2_mul(ehi, h), ehi, bhi);
+    const v128_t f = wasm_i32x4_shuffle(wasm_f32x4_demote_f64x2_zero(slo), wasm_f32x4_demote_f64x2_zero(shi), 0, 1, 4, 5);
+    const v128_t alo = spu__waway(slo, elo, spu__wlo(f));       /* f = Inf (halved value >= 2^128): away -> FLT_MAX */
+    const v128_t ahi = spu__waway(shi, ehi, spu__whi(f));
+    v128_t u = wasm_i32x4_add(f, wasm_i32x4_shuffle(alo, ahi, 0, 2, 4, 6));
+    u = wasm_i32x4_add(u, wasm_v128_and(wasm_i32x4_shuffle(blo, bhi, 0, 2, 4, 6), wasm_i32x4_const_splat(0x00800000)));
+    return wasm_v128_andnot(u, wasm_i32x4_eq(wasm_v128_and(u, wasm_i32x4_const_splat(0x7F800000)),
+                                             wasm_i32x4_const_splat(0)));
+}
+static SPU_FP_NOINLINE u128 spu__wfa_full(u128 a, u128 b, uint32_t negb)
+{
+    const v128_t x = spu__wz(spu__wv(a));
+    v128_t y = spu__wz(spu__wv(b)), elo, ehi;
+    if (negb) y = spu__wneg32(y);
+    const v128_t slo = spu__w2sum(spu__wxd(x, 0), spu__wxd(y, 0), &elo);
+    const v128_t shi = spu__w2sum(spu__wxd(x, 1), spu__wxd(y, 1), &ehi);
+    return spu__wu(spu__wrtzx(slo, elo, shi, ehi));
+}
+static SPU_FP_NOINLINE u128 spu__wfm_full(u128 a, u128 b)
+{
+    const v128_t x = spu__wz(spu__wv(a)), y = spu__wz(spu__wv(b)), z = wasm_f64x2_const_splat(0.0);
+    return spu__wu(spu__wrtzx(wasm_f64x2_mul(spu__wxd(x, 0), spu__wxd(y, 0)), z,
+                              wasm_f64x2_mul(spu__wxd(x, 1), spu__wxd(y, 1)), z));
+}
+static SPU_FP_NOINLINE u128 spu__wfma_full(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc)
+{
+    v128_t x = spu__wz(spu__wv(a)), w = spu__wz(spu__wv(c)), elo, ehi;
+    const v128_t y = spu__wz(spu__wv(b));
+    if (negp) x = spu__wneg32(x);
+    if (negc) w = spu__wneg32(w);
+    const v128_t slo = spu__w2sum(wasm_f64x2_mul(spu__wxd(x, 0), spu__wxd(y, 0)), spu__wxd(w, 0), &elo);
+    const v128_t shi = spu__w2sum(wasm_f64x2_mul(spu__wxd(x, 1), spu__wxd(y, 1)), spu__wxd(w, 1), &ehi);
+    return spu__wu(spu__wrtzx(slo, elo, shi, ehi));
+}
+/* a + (negb ? -b : b) */
+static inline u128 spu__wfa(u128 a, u128 b, uint32_t negb)
+{
+    const v128_t A = spu__wv(a), B = spu__wv(b);
+    v128_t x = spu__wz(A), y = spu__wz(B), elo, ehi, bad;
+    if (negb) y = spu__wneg32(y);
+    const v128_t slo = spu__w2sum(spu__wlo(x), spu__wlo(y), &elo);
+    const v128_t shi = spu__w2sum(spu__whi(x), spu__whi(y), &ehi);
+    const v128_t r = spu__wrtz4(slo, elo, shi, ehi, &bad);
+    const int m = wasm_i32x4_bitmask(wasm_v128_or(bad, wasm_v128_or(spu__wsp(A), spu__wsp(B))));
+    if (SPU_FP_UNLIKELY(m)) return spu__wfa_full(a, b, negb);
+    return spu__wu(r);
+}
+static inline u128 spu_fa(u128 a, u128 b) { return spu__wfa(a, b, 0); }
+static inline u128 spu_fs(u128 a, u128 b) { return spu__wfa(a, b, 1); }
+/* An exact product needs no rounding step: toward zero = clear the double's fraction bits below the float's 23
+ * (then the narrowing is exact in the normal range). |p| < 2^-126 (where the narrowing could round up to 2^-126,
+ * and every zero, of either sign) -> +0; a lane at 2^128 or beyond narrows to Inf -> the full form. */
+static inline v128_t spu__wtrunc(v128_t p) { return wasm_v128_and(p, wasm_i64x2_const_splat((long long)0xFFFFFFFFE0000000ull)); }
+static inline v128_t spu__wtiny(v128_t p) { return wasm_f64x2_lt(wasm_f64x2_abs(p), wasm_f64x2_const_splat(0x1p-126)); }
+static inline u128 spu_fm(u128 a, u128 b)
+{
+    const v128_t A = spu__wv(a), B = spu__wv(b);
+    const v128_t x = spu__wz(A), y = spu__wz(B);
+    const v128_t plo = wasm_f64x2_mul(spu__wlo(x), spu__wlo(y)), phi = wasm_f64x2_mul(spu__whi(x), spu__whi(y));
+    const v128_t f = wasm_i32x4_shuffle(wasm_f32x4_demote_f64x2_zero(spu__wtrunc(plo)),
+                                        wasm_f32x4_demote_f64x2_zero(spu__wtrunc(phi)), 0, 1, 4, 5);
+    const v128_t r = wasm_v128_andnot(f, wasm_i32x4_shuffle(spu__wtiny(plo), spu__wtiny(phi), 0, 2, 4, 6));
+    const v128_t bad = spu__wsp(f);
+    const int m = wasm_i32x4_bitmask(wasm_v128_or(bad, wasm_v128_or(spu__wsp(A), spu__wsp(B))));
+    if (SPU_FP_UNLIKELY(m)) return spu__wfm_full(a, b);
+    return spu__wu(r);
+}
+/* (negp ? -(a*b) : a*b) + (negc ? -c : c), fused */
+static inline u128 spu__wfma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc)
+{
+    const v128_t A = spu__wv(a), B = spu__wv(b), C = spu__wv(c);
+    v128_t x = spu__wz(A), y = spu__wz(B), w = spu__wz(C), elo, ehi, bad;
