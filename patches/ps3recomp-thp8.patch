+/* ===========================================================================
+ * 4. Atomics: GETLLAR / PUTLLC / PUTLLUC and the reservation
+ * ===========================================================================*/
+#define EA_LINE   0x00400000u
+#define EA_LINE2  0x00400080u
+
+static void getllar(spu_context* c, uint32_t lsa, uint32_t ea) { mfc(c, MFC_GETLLAR_CMD, lsa, ea, 128, 0); }
+static void putllc (spu_context* c, uint32_t lsa, uint32_t ea) { mfc(c, MFC_PUTLLC_CMD,  lsa, ea, 128, 0); }
+static void putlluc(spu_context* c, uint32_t lsa, uint32_t ea) { mfc(c, MFC_PUTLLUC_CMD, lsa, ea, 128, 0); }
+
+static void test_atomics(void)
+{
+    spu_context* a = new_ctx(6);
+    spu_context* b = new_ctx(7);
+
+    TEST("atomic.getllar-putllc");
+    fill(vm_base + EA_LINE, 128, 0x10);
+    getllar(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 4);                 /* GETLLAR complete */
+    CHECK(memcmp(a->ls + 0x7000, vm_base + EA_LINE, 128) == 0);
+    a->ls[0x7000 + 5] ^= 0xFF;
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 0);                 /* PUTLLC success */
+    CHECK(memcmp(a->ls + 0x7000, vm_base + EA_LINE, 128) == 0);
+
+    TEST("atomic.putllc-without-reservation");
+    a->ls[0x7000] ^= 1;
+    putllc(a, 0x7000, EA_LINE);                           /* reservation was consumed */
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    CHECK(vm_base[EA_LINE] != a->ls[0x7000]);
+
+    TEST("atomic.putllc-other-line");
+    getllar(a, 0x7000, EA_LINE);
+    putllc(a, 0x7000, EA_LINE2);                          /* reserved a different line */
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+
+    TEST("atomic.lost-to-ppu-store");
+    getllar(a, 0x7000, EA_LINE);
+    ppu_store32(EA_LINE + 0x40, 0xDEADBEEFu);
+    a->ls[0x7000] ^= 1;
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    CHECK_EQ(be32(vm_base + EA_LINE + 0x40), 0xDEADBEEFu);   /* the PPU store survived */
+    CHECK(a->event_status & 0x400);                        /* LR pending */
+    wr(a, SPU_WrEventAck, 0x400);
+
+    TEST("atomic.lost-to-silent-store");
+    /* A writer that bypasses the coherence hooks (a lifted vector store) still
+     * fails the PUTLLC: the commit compares the line against the snapshot. */
+    getllar(a, 0x7000, EA_LINE);
+    vm_base[EA_LINE + 0x7F] ^= 0x5A;
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+
+    TEST("atomic.lost-to-peer-put");
+    getllar(a, 0x7000, EA_LINE);
+    fill(b->ls + 0x100, 16, 0x99);
+    mfc(b, MFC_PUT_CMD, 0x100, EA_LINE + 0x10, 16, 1);   /* plain DMA PUT into the line */
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    CHECK(a->event_status & 0x400);
+    wr(a, SPU_WrEventAck, 0x400);
+
+    TEST("atomic.lost-to-peer-putllc");
+    getllar(a, 0x7000, EA_LINE);
+    getllar(b, 0x7000, EA_LINE);
+    b->ls[0x7001] ^= 0x80;
+    putllc(b, 0x7000, EA_LINE);
+    CHECK_EQ(rd(b, MFC_RdAtomicStat), 0);
+    CHECK_EQ(b->event_status & 0x400, 0);                  /* the winner is not told it lost */
+    a->ls[0x7002] ^= 0x80;
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    CHECK(memcmp(vm_base + EA_LINE, b->ls + 0x7000, 128) == 0);   /* b's commit stands */
+    wr(a, SPU_WrEventAck, 0x400);
+
+    TEST("atomic.putlluc");
+    getllar(a, 0x7000, EA_LINE);
+    fill(b->ls + 0x7000, 128, 0x31);
+    putlluc(b, 0x7000, EA_LINE);
+    CHECK_EQ(rd(b, MFC_RdAtomicStat), 2);                 /* PUTLLUC complete */
+    CHECK(memcmp(vm_base + EA_LINE, b->ls + 0x7000, 128) == 0);
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 1);
+    /* A PUTLLUC also drops the issuer's own reservation. */
+    wr(b, SPU_WrEventAck, 0x400);
+    getllar(b, 0x7000, EA_LINE);
+    putlluc(b, 0x7000, EA_LINE);
+    CHECK_EQ(b->event_status & 0x400, 0);   /* consumed like a PUTLLC, no Lr (RPCS3 do_putlluc) */
+    putllc(b, 0x7000, EA_LINE);
+    CHECK_EQ(rd(b, MFC_RdAtomicStat), 1);
+    wr(a, SPU_WrEventAck, 0x400); wr(b, SPU_WrEventAck, 0x400);
+
+    TEST("atomic.lr-event");
+    /* Reservation-lost event: enabled, it is pending & readable; ack clears. */
+    wr(a, SPU_WrEventMask, 0x400);
+    getllar(a, 0x7000, EA_LINE);
+    CHECK_EQ(cnt(a, SPU_RdEventStat), 0);
+    ppu_store32(EA_LINE, 0x01020304u);
+    CHECK_EQ(cnt(a, SPU_RdEventStat), 1);
+    CHECK_EQ(rd(a, SPU_RdEventStat), 0x400);
+    wr(a, SPU_WrEventAck, 0x400);
+    CHECK_EQ(cnt(a, SPU_RdEventStat), 0);
+    /* A store to a different line does not take the reservation. */
+    getllar(a, 0x7000, EA_LINE);
+    ppu_store32(EA_LINE2, 0x55u);
+    CHECK_EQ(cnt(a, SPU_RdEventStat), 0);
+    putllc(a, 0x7000, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 0);
+    wr(a, SPU_WrEventMask, 0);
+
+    TEST("atomic.lsa-alignment");
+    /* GETLLAR/PUTLLC move a 128-byte line to/from a 128-byte aligned LSA: the
+     * low seven bits of MFC_LSA are ignored. An unaligned LSA near the top of
+     * local store must not run past it. */
+    fill(vm_base + EA_LINE, 128, 0x44);
+    memset(a->ls + 0x7000, 0, 0x100);
+    getllar(a, 0x7000 + 0x30, EA_LINE);
+    CHECK(memcmp(a->ls + 0x7000, vm_base + EA_LINE, 128) == 0);
+    CHECK_EQ(a->ls[0x7080], 0);
+    { /* The context fields right behind ls_store (the `ls` pointer first).
+       * Restored if overrun, so the rest of the run survives to report. */
+      uint8_t* after = a->ls_store + SPU_LS_SIZE;
+      uint8_t saved[128]; memcpy(saved, after, sizeof saved);
+      getllar(a, SPU_LS_SIZE - 0x10, EA_LINE);
+      int intact = memcmp(saved, after, sizeof saved) == 0;
+      if (!intact) memcpy(after, saved, sizeof saved);
+      CHECK(intact);
+      CHECK(memcmp(a->ls + SPU_LS_SIZE - 128, vm_base + EA_LINE, 128) == 0); }
+    a->ls[SPU_LS_SIZE - 128 + 3] ^= 0x11;
+    putllc(a, SPU_LS_SIZE - 0x10, EA_LINE);
+    CHECK_EQ(rd(a, MFC_RdAtomicStat), 0);
+    CHECK(memcmp(a->ls + SPU_LS_SIZE - 128, vm_base + EA_LINE, 128) == 0);
+
+    free_ctx(a); free_ctx(b);
+}
+
+/* Lock-free increments from several agents on one line, no update lost:
+ * SPUs doing the GETLLAR/PUTLLC retry loop Havok's cellAtomicIncr does
+ * (hkthread LS 0xA82C), and a PPU doing lwarx/stwcx. through the coherent
+ * commit ppu_stwcx uses. */
+typedef struct { int kind; int n; spu_context* ctx; uint32_t word_off; volatile LONG* go; long retries; } incr_arg;
+
+static DWORD WINAPI incr_thread(LPVOID p)
+{
+    incr_arg* a = (incr_arg*)p;
+    while (!*a->go) YieldProcessor();
+    for (int i = 0; i < a->n; i++) {
+        if (a->kind == 0) {              /* SPU */
+            for (;;) {
+                getllar(a->ctx, 0x7000, EA_LINE);
+                uint8_t* w = a->ctx->ls + 0x7000 + a->word_off;
+                put_be32(w, be32(w) + 1);
+                putllc(a->ctx, 0x7000, EA_LINE);
+                if (rd(a->ctx, MFC_RdAtomicStat) == 0) break;
+                a->retries++;
+            }
+        } else {                         /* PPU: lwarx / stwcx. (ppu_stwcx) */
+            volatile LONG* word = (volatile LONG*)(vm_base + EA_LINE + a->word_off);
+            for (;;) {
+                LONG old = *word;
+                uint32_t v = _byteswap_ulong((unsigned long)old) + 1;
+                LONG nv = (LONG)_byteswap_ulong(v);
+                int ok;
+                if (spu_coh_is_reserved(EA_LINE)) {
+                    spu_lockline_lock();
+                    ok = InterlockedCompareExchange(word, nv, old) == old;
+                    if (ok) spu_coh_notify_write(EA_LINE);
+                    spu_lockline_unlock();
+                } else {
+                    ok = InterlockedCompareExchange(word, nv, old) == old;
+                }
+                if (ok) break;
+                a->retries++;
+            }
+        }
+    }
+    return 0;
+}
+
+static void test_atomic_contention(void)
+{
+    TEST("atomic.no-lost-increments");
+    enum { NSPU = 3, NPER = 40000, NPPU = 40000 };
+    spu_context* c[NSPU];
+    memset(vm_base + EA_LINE, 0, 128);
+    volatile LONG go = 0;
+    incr_arg args[NSPU + 1];
+    HANDLE th[NSPU + 1];
+    for (int i = 0; i < NSPU; i++) {
+        c[i] = new_ctx(0x20 + i);
+        args[i].kind = 0; args[i].n = NPER; args[i].ctx = c[i]; args[i].word_off = 0x20;
+        args[i].go = &go; args[i].retries = 0;
+        getllar(c[i], 0x7000, EA_LINE);   /* marks the line before the PPU's first check */
+    }
+    args[NSPU].kind = 1; args[NSPU].n = NPPU; args[NSPU].ctx = NULL; args[NSPU].word_off = 0x20;
+    args[NSPU].go = &go; args[NSPU].retries = 0;
+    for (int i = 0; i <= NSPU; i++) th[i] = CreateThread(NULL, 0, incr_thread, &args[i], 0, NULL);
+    uint64_t t0 = qpc_ns();
+    InterlockedExchange(&go, 1);
+    DWORD w = WaitForMultipleObjects(NSPU + 1, th, TRUE, 60000);
+    uint64_t t1 = qpc_ns();
+    CHECK_EQ(w, WAIT_OBJECT_0);
+    for (int i = 0; i <= NSPU; i++) CloseHandle(th[i]);
+    uint32_t total = be32(vm_base + EA_LINE + 0x20);
+    long retries = 0; for (int i = 0; i <= NSPU; i++) retries += args[i].retries;
+    printf("  [atomic.no-lost-increments] %u increments (expected %u) in %.0f ms, %ld retries\n",
+           total, (unsigned)(NSPU * NPER + NPPU), (double)(t1 - t0) / 1e6, retries);
+    CHECK_EQ(total, (uint32_t)(NSPU * NPER + NPPU));
+    /* The rest of the line is untouched by the increments. */
+    { int clean = 1; for (int k = 0; k < 128; k++) if ((k < 0x20 || k >= 0x24) && vm_base[EA_LINE + k]) clean = 0;
+      CHECK(clean); }
+    for (int i = 0; i < NSPU; i++) free_ctx(c[i]);
+}
+
+/* A GETLLAR poll of a line nobody writes parks (SPU_LLAR_PARK, default on)
+ * and must still see the write that ends the wait promptly: the THP8 job
+ * policy's lock-line spin at LS 0x16E8. */
+typedef struct { spu_context* ctx; uint32_t want; volatile LONG seen; uint64_t t_seen; volatile long polls; } poll_arg;
+static DWORD WINAPI llar_poll_thread(LPVOID p)
+{
+    poll_arg* a = (poll_arg*)p;
+    for (;;) {
+        getllar(a->ctx, 0x7000, EA_LINE);
+        a->polls++;
+        if (be32(a->ctx->ls + 0x7000) == a->want) break;
+    }
+    a->t_seen = qpc_ns();
+    InterlockedExchange(&a->seen, 1);
+    return 0;
+}
+
+static void test_llar_park(void)
+{
+    TEST("atomic.llar-poll-park");
+    spu_context* p = new_ctx(0x30);
+    spu_context* w = new_ctx(0x31);
+    memset(vm_base + EA_LINE, 0, 128);
+    double worst = 0;
+    for (int round = 0; round < 3; round++) {
+        poll_arg a = { p, 0x1000u + (uint32_t)round, 0, 0, 0 };
+        HANDLE h = CreateThread(NULL, 0, llar_poll_thread, &a, 0, NULL);
+        DWORD tid = GetThreadId(h);
+        while (a.polls < 200) Sleep(1);              /* past the spin, into the parked regime */
+        Sleep(40);
+        CHECK_EQ(a.seen, 0);
+        long polls_before = a.polls;
+        uint64_t t_wr = qpc_ns();
+        if (round == 0) {                            /* peer SPU PUTLLC */
+            getllar(w, 0x7000, EA_LINE);
+            put_be32(w->ls + 0x7000, a.want);
+            putllc(w, 0x7000, EA_LINE);
+            CHECK_EQ(rd(w, MFC_RdAtomicStat), 0);
+        } else if (round == 1) {                     /* PPU coherent store */
+            ppu_store32(EA_LINE, a.want);
+        } else {                                     /* peer DMA PUT */
+            put_be32(w->ls + 0x200, a.want);
+            mfc(w, MFC_PUT_CMD, 0x200, EA_LINE, 16, 2);
+        }
+        /* The write must wake the parked poller, not its park timeout. */
+        int lost = await_or_lost(&a.seen, 1, tid);
+        DWORD r = WaitForSingleObject(h, 5000);
+        CHECK_EQ(r, WAIT_OBJECT_0);
+        CloseHandle(h);
+        double ms = (double)(a.t_seen - t_wr) / 1e6;
+        if (ms > worst) worst = ms;
+        printf("  [atomic.llar-poll-park] round %d: seen after %.3f ms; %ld polls (%ld before the write)%s\n",
+               round, ms, a.polls, polls_before, lost == 1 ? "; poller slept through the write" : "");
+        CHECK_EQ(lost, 0);
+        CHECK(polls_before < 100000);                /* parked, not spinning flat out */
+    }
+    free_ctx(p); free_ctx(w);
+}
+
+/* A thread parked in rdch SPU_RdEventStat (evmask Lr) wakes on the store that
+ * takes its reservation -- a PPU store or a peer's PUTLLC. The reader is one
+ * persistent thread; the store is released at random points around its way
+ * into the wait (see blocking_read_case). */
+typedef struct {
+    spu_context* ctx;
+    volatile LONG go, done;
+    uint32_t got; uint64_t t_go, t_ret;
+} ev_arg;
+static DWORD WINAPI ev_thread(LPVOID p)
+{
+    ev_arg* a = (ev_arg*)p;
+    for (LONG k = 1; ; k++) {
+        while (a->go < k) { if (a->go < 0) return 0; YieldProcessor(); }
+        a->t_go = qpc_ns();
+        a->got = rd(a->ctx, SPU_RdEventStat);
+        a->t_ret = qpc_ns();
+        InterlockedExchange(&a->done, k);
+    }
+}
+
+static void test_lr_blocking(void)
+{
+    TEST("atomic.lr-blocking-read");
+    spu_context* a = new_ctx(0x40);
+    spu_context* b = new_ctx(0x41);
+    a->ch_block = 1;
+    ev_arg e; memset(&e, 0, sizeof e); e.ctx = a;
+    HANDLE h = CreateThread(NULL, 0, ev_thread, &e, 0, NULL);
+    enum { N = 600 };
+    double worst = 0; int lost = 0, ok = 1;
+    srand(777);
+    for (int i = 1; i <= N; i++) {
+        wr(a, SPU_WrEventMask, 0x400);
+        getllar(a, 0x7000, EA_LINE);
+        InterlockedExchange(&e.go, i);
+        if (i == 1) { CHECK(await_parked(a, GetThreadId(h))); Sleep(30); CHECK_EQ(e.done, 0); }
+        else spin_us((unsigned)(rand() % 60));
+        uint64_t t_wr = qpc_ns();
+        if (i & 1) ppu_store32(EA_LINE + 4, (uint32_t)i);
+        else { getllar(b, 0x7000, EA_LINE); b->ls[0x7010] ^= 1; putllc(b, 0x7000, EA_LINE); }
+        int r = await_or_lost(&e.done, i, GetThreadId(h));
+        if (r == 1) lost++;
+        if (r == 2) { CHECK_EQ(e.done, i); break; }
+        if (e.got != 0x400) ok = 0;
+        double ms = e.t_ret > t_wr ? (double)(e.t_ret - t_wr) / 1e6 : 0;
+        if (ms > worst) worst = ms;
+        wr(a, SPU_WrEventAck, 0x400);
+    }
+    CHECK(ok);
+    InterlockedExchange(&e.go, -1);
+    WaitForSingleObject(h, 5000); CloseHandle(h);
+    printf("  [atomic.lr-blocking-read] %d handoffs: worst %.2f ms, lost wakes: %d\n", N, worst, lost);
+    CHECK_EQ(lost, 0);
+    wr(a, SPU_WrEventMask, 0);
+    free_ctx(a); free_ctx(b);
+}
