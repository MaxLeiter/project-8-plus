+def _vpkpx(s, f):
+    out = []
+    for w in W(s.vr[f.ra]) + W(s.vr[f.rb]):
+        out.append(((w >> 24) & 1) << 15 | ((w >> 19) & 31) << 10 | ((w >> 11) & 31) << 5 | ((w >> 3) & 31))
+    s.set_v(f.rt, fromH(out))
+
+
+def _vupkpx(high):
+    def sem(s, f):
+        h = H(s.vr[f.rb])
+        part = h[:4] if high else h[4:]
+        out = []
+        for x in part:
+            out.append((0xFF if x >> 15 else 0) << 24 | ((x >> 10) & 31) << 16 | ((x >> 5) & 31) << 8 | (x & 31))
+        s.set_v(f.rt, fromW([sext(o, 32) & MASK32 for o in out]))
+    return sem
+
+
+vx("vpkpx", 782, _vpkpx)
+vx("vupkhpx", 846, _vupkpx(True), unary=True)
+vx("vupklpx", 974, _vupkpx(False), unary=True)
