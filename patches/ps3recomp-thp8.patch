+/* ------------------------------------------------------------------------------------------------ events
+ * ld_vkd3d_create_event / ld_vkd3d_wait_event stand in for CreateEventA / WaitForSingleObject (see
+ * rsx_live_draw_vkd3d.h). An event is armed by ID3D12Fence::SetEventOnCompletion with (fence, value). */
+struct wgs_fence;
+typedef struct wgs_event { struct wgs_fence* fence; u64 value; volatile u32 armed; } wgs_event;
+HANDLE ld_vkd3d_create_event(void) { return (HANDLE)wgs_zalloc(sizeof(wgs_event)); }
+static u64 fence_completed(struct wgs_fence* f);
+static int fence_wait(struct wgs_fence* f, u64 value, unsigned ms);
+unsigned ld_vkd3d_wait_event(HANDLE h, unsigned ms)
+{
+    wgs_event* e = (wgs_event*)h;
+    if (!e) return 0xFFFFFFFFu;                         /* WAIT_FAILED */
+    if (!e->armed) return 0;                            /* WAIT_OBJECT_0: nothing pending */
+    const int ok = fence_wait(e->fence, e->value, ms);
+    if (ok) e->armed = 0;
+    return ok ? 0u : 0x102u;                            /* WAIT_OBJECT_0 / WAIT_TIMEOUT */
+}
