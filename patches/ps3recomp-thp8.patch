+        u32 j = ld_pre_hash(x) & (g_pre.cap - 1u);
+        while (g_pre.t[j].pso && memcmp(ld_pre_kp(&g_pre.t[j].k), ld_pre_kp(x), LD_PRE_KEY_BYTES)) j = (j + 1u) & (g_pre.cap - 1u);
