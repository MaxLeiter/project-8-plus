+static uint32_t rand_float(void)
+{
+    uint32_t s = rnd32() & 0x80000000u, e, f = rnd32() & 0x7FFFFF;
+    switch (rnd() % 6) {
+    case 0: e = 1 + rnd() % 3; break;
+    case 1: e = 252 + rnd() % 4; break;          /* incl. 255 (extended range) */
+    case 2: e = 120 + rnd() % 16; break;
+    default: e = rnd() % 256; break;
+    }
+    if (rnd() % 8 == 0) f = (rnd() & 1) ? 0 : 0x7FFFFF;
+    return s | (e << 23) | f;
+}
+static uint64_t rand_double(void)
+{
+    uint64_t s = (rnd() & 1) ? 0x8000000000000000ull : 0, e, f = rnd() & 0xFFFFFFFFFFFFFull;
+    switch (rnd() % 6) {
+    case 0: e = rnd() % 3; break;
+    case 1: e = 2045 + rnd() % 3; break;
+    case 2: e = 1015 + rnd() % 16; break;
+    default: e = rnd() % 2048; break;
+    }
+    if (rnd() % 8 == 0) f = (rnd() & 1) ? 0 : 0xFFFFFFFFFFFFFull;
+    return s | (e << 52) | f;
+}
+static void put32(uint8_t* p, uint32_t v) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
