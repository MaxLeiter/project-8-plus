+/* ------------------------------------------------------------------------------------------------ descriptors */
+enum { WGS_D_RTV = 100, WGS_D_DSV = 101 };
+typedef struct wgs_desc { u32 kind; u32 w[15]; } wgs_desc;      /* 64 bytes; kind = WGS_B_* or WGS_D_* (0 = empty) */
+
+typedef struct wgs_dheap {
+    ID3D12DescriptorHeap iface;
+    volatile LONG refs;
+    u32 id;
+    D3D12_DESCRIPTOR_HEAP_DESC desc;
+    wgs_desc* slots;
+} wgs_dheap;
+#define WGS_MAX_HEAPS 4096
+static wgs_dheap* s_heaps[WGS_MAX_HEAPS];        /* by heap index (GPU handles carry it) */
+static volatile u32 s_heap_n = 1;
+
+static HRESULT STDMETHODCALLTYPE dh_qi(ID3D12DescriptorHeap* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12DescriptorHeap)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE dh_addref(ID3D12DescriptorHeap* t) { return (ULONG)__atomic_add_fetch(&((wgs_dheap*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE dh_release(ID3D12DescriptorHeap* t)
+{
+    wgs_dheap* h = (wgs_dheap*)t;
+    const LONG n = __atomic_sub_fetch(&h->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) { s_heaps[h->id] = NULL; free(h->slots); free(h); }
+    return (ULONG)n;
+}
+static D3D12_DESCRIPTOR_HEAP_DESC* STDMETHODCALLTYPE dh_get_desc(ID3D12DescriptorHeap* t, D3D12_DESCRIPTOR_HEAP_DESC* ret) { *ret = ((wgs_dheap*)t)->desc; return ret; }
+static D3D12_CPU_DESCRIPTOR_HANDLE* STDMETHODCALLTYPE dh_cpu_start(ID3D12DescriptorHeap* t, D3D12_CPU_DESCRIPTOR_HANDLE* ret)
+{ ret->ptr = (SIZE_T)(uintptr_t)((wgs_dheap*)t)->slots; return ret; }
+static D3D12_GPU_DESCRIPTOR_HANDLE* STDMETHODCALLTYPE dh_gpu_start(ID3D12DescriptorHeap* t, D3D12_GPU_DESCRIPTOR_HANDLE* ret)
+{ ret->ptr = (u64)((wgs_dheap*)t)->id << 32; return ret; }
+static HRESULT STDMETHODCALLTYPE dh_set_name(ID3D12DescriptorHeap* t, const WCHAR* n) { (void)t; (void)n; return S_OK; }
+static ID3D12DescriptorHeapVtbl s_dh_vtbl;
+
+/* GPU descriptor handle -> slot */
+static wgs_desc* gpu_slot(u64 h)
+{
+    const u32 hi = (u32)(h >> 32), off = (u32)h;
+    wgs_dheap* hp = hi < WGS_MAX_HEAPS ? s_heaps[hi] : NULL;
+    if (!hp) return NULL;
+    const u32 i = off / (u32)sizeof(wgs_desc);
+    return i < hp->desc.NumDescriptors ? &hp->slots[i] : NULL;
+}
+static wgs_desc* cpu_slot(SIZE_T p) { return (wgs_desc*)(uintptr_t)p; }
+
+/* ------------------------------------------------------------------------------------------------ root signatures */
+typedef struct { u32 type, count, base, space, offset; } wgs_range;
+typedef struct {
+    u32 type, vis;
+    u32 nranges; wgs_range ranges[8];      /* tables */
+    u32 reg, space, num;                   /* root CBV/SRV/UAV/constants */
+} wgs_param;
+typedef struct wgs_rootsig {
+    ID3D12RootSignature iface;
+    volatile LONG refs;
+    u32 id;
+    u32 nparams;
+    wgs_param params[32];
+} wgs_rootsig;
+
+static HRESULT STDMETHODCALLTYPE rs_qi(ID3D12RootSignature* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12RootSignature)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE rs_addref(ID3D12RootSignature* t) { return (ULONG)__atomic_add_fetch(&((wgs_rootsig*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE rs_release(ID3D12RootSignature* t)
+{
+    wgs_rootsig* s = (wgs_rootsig*)t;
+    const LONG n = __atomic_sub_fetch(&s->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) free(s);           /* the worker keeps its copy: PSOs made from it may still be in flight */
+    return (ULONG)n;
+}
+static ID3D12RootSignatureVtbl s_rs_vtbl;
+
+/* Binding numbers: see wgs_proto.h; vertex-only parameters get +128 so a VS register never meets the PS one. */
+static u32 bind_num(u32 cls, u32 reg, u32 vis)
+{
+    const u32 base = cls == 't' ? 0u : cls == 's' ? 32u : cls == 'b' ? 48u : 64u;
+    return base + reg + (vis == D3D12_SHADER_VISIBILITY_VERTEX ? 128u : 0u);
+}
+
+/* ------------------------------------------------------------------------------------------------ pipeline states */
+typedef struct wgs_pso {
+    ID3D12PipelineState iface;
+    volatile LONG refs;
+    u32 id;
+    int compute;
+} wgs_pso;
+static HRESULT STDMETHODCALLTYPE pso_qi(ID3D12PipelineState* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12PipelineState)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE pso_addref(ID3D12PipelineState* t) { return (ULONG)__atomic_add_fetch(&((wgs_pso*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE pso_release(ID3D12PipelineState* t)
+{
+    wgs_pso* p = (wgs_pso*)t;
+    const LONG n = __atomic_sub_fetch(&p->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) { wgs_msg* m = &t_msg; msg_begin(m, WGS_DESTROY); msg_u32(m, p->id); ring_post(m); free(p); }
+    return (ULONG)n;
+}
+static HRESULT STDMETHODCALLTYPE pso_get_cached_blob(ID3D12PipelineState* t, ID3DBlob** b) { (void)t; if (b) *b = NULL; return E_NOTIMPL; }
+static HRESULT STDMETHODCALLTYPE pso_set_name(ID3D12PipelineState* t, const WCHAR* n) { (void)t; (void)n; return S_OK; }
+static ID3D12PipelineStateVtbl s_pso_vtbl;
+
+static void msg_blend(wgs_msg* m, const D3D12_BLEND_DESC* b)
+{
+    msg_u32(m, b->AlphaToCoverageEnable); msg_u32(m, b->IndependentBlendEnable);
+    for (int i = 0; i < 8; i++) {
+        const D3D12_RENDER_TARGET_BLEND_DESC* r = &b->RenderTarget[i];
+        msg_u32(m, r->BlendEnable); msg_u32(m, r->LogicOpEnable); msg_u32(m, r->SrcBlend); msg_u32(m, r->DestBlend);
+        msg_u32(m, r->BlendOp); msg_u32(m, r->SrcBlendAlpha); msg_u32(m, r->DestBlendAlpha); msg_u32(m, r->BlendOpAlpha);
+        msg_u32(m, r->LogicOp); msg_u32(m, r->RenderTargetWriteMask);
+    }
+}
+static void msg_raster(wgs_msg* m, const D3D12_RASTERIZER_DESC* r)
+{
+    msg_u32(m, r->FillMode); msg_u32(m, r->CullMode); msg_u32(m, r->FrontCounterClockwise); msg_u32(m, (u32)r->DepthBias);
+    msg_u32(m, f2u(r->DepthBiasClamp)); msg_u32(m, f2u(r->SlopeScaledDepthBias)); msg_u32(m, r->DepthClipEnable);
+    msg_u32(m, r->MultisampleEnable); msg_u32(m, r->ConservativeRaster);
+}
+static void msg_depth(wgs_msg* m, const D3D12_DEPTH_STENCIL_DESC* d)
+{
+    msg_u32(m, d->DepthEnable); msg_u32(m, d->DepthWriteMask); msg_u32(m, d->DepthFunc); msg_u32(m, d->StencilEnable);
+    msg_u32(m, d->StencilReadMask); msg_u32(m, d->StencilWriteMask);
+    const D3D12_DEPTH_STENCILOP_DESC* f[2] = { &d->FrontFace, &d->BackFace };
+    for (int i = 0; i < 2; i++) { msg_u32(m, f[i]->StencilFailOp); msg_u32(m, f[i]->StencilDepthFailOp); msg_u32(m, f[i]->StencilPassOp); msg_u32(m, f[i]->StencilFunc); }
+}
+
+/* ------------------------------------------------------------------------------------------------ fences */
+typedef struct wgs_fence {
+    ID3D12Fence iface;
+    volatile LONG refs;
+    u32 id;
+    volatile u64 completed __attribute__((aligned(8)));   /* written by the worker (Atomics.store on a BigInt64Array) */
+} wgs_fence;
+static u64 fence_completed(wgs_fence* f) { return __atomic_load_n(&f->completed, __ATOMIC_ACQUIRE); }
+static int fence_wait(wgs_fence* f, u64 value, unsigned ms)
+{
+    unsigned long long waited_ns = 0;
+    double w0 = 0;
+    for (;;) {
+        const u64 c = fence_completed(f);
+        if (c >= value) {
+            if (w0) {
+                wgs_stats_note(0, wgs_now_ms() - w0);
+#if defined(PS3_WASM)
+                FT_ADD(FT_W_FENCE_N, 1); FT_ADD(FT_W_FENCE_US, (long long)((wgs_now_ms() - w0) * 1000.0));   /* PS3_SPIKE_MS */
+#endif
+            }
+            return 1;
+        }
+        if (!w0) w0 = wgs_now_ms();
+        if (ms != 0xFFFFFFFFu && waited_ns >= (unsigned long long)ms * 1000000ull) return 0;
+        wgs_wait32((volatile u32*)&f->completed, (u32)c, 1000000);          /* the low word changes on every signal */
+        waited_ns += 1000000;
+    }
+}
+static HRESULT STDMETHODCALLTYPE fence_qi(ID3D12Fence* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12Fence)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
