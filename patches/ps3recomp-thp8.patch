diff --git a/tools/test_ppu_fn_entry.py b/tools/test_ppu_fn_entry.py
new file mode 100644
index 00000000..486806a5
--- /dev/null
+++ b/tools/test_ppu_fn_entry.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Self-check: the PPU_FN_ENTRY mod-hook marker.
+
+Every lifted function except an HLE import stub opens with PPU_FN_ENTRY(i) on
+its signature line, i = its function_table[] index; the header carries the
+macro (empty unless PPU_MOD_HOOKS) and the table chunk the guard bytes plus the
+unguarded (stub) indices, both under #ifdef PPU_MOD_HOOKS. --no-fn-entry
+(fn_entry = False) must reproduce the marker-free output exactly, and the
+marker must not change any line count (the chunk split depends on it).
+
+Run: python tools/test_ppu_fn_entry.py
+"""
+import os
+import re
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from ppu_lifter import FN_ENTRY_PREAMBLE, LiftedFunction, PPULifter  # noqa: E402
+
+SIG = re.compile(r"^void (\w+)\(ppu_context\* ctx\) \{(.*)$")
+ROW = re.compile(r"^    \{ 0x[0-9A-F]{8}ULL, (\w+), ")
+
+
+def _lifter(prefix=""):
+    lf = PPULifter(prefix=prefix)
+    p = lf.prefix
+    lf.hle_stub_nids = {0x30: 0x12345678}
+    lf.functions = [
+        LiftedFunction(name=f"{p}func_00000010", start_addr=0x10, end_addr=0x20,
+                       body_lines=["    return;"]),
+        LiftedFunction(name=f"{p}func_00000030", start_addr=0x30, end_addr=0x50,
+                       body_lines=["    ps3_hle_call(0x12345678u, ctx); return;  /* import stub */"]),
+        LiftedFunction(name=f"{p}func_00000050", start_addr=0x50, end_addr=0x60,
+                       body_lines=["    return;"]),
+        # a mid-function tail-entry wrapper: appended last, so table order is
+        # not address order -- the index must follow the table, not the address
+        LiftedFunction(name=f"{p}func_00000018", start_addr=0x18, end_addr=0x20,
+                       body_lines=["    return;"]),
+    ]
+    return lf
+
+
+def _check_markers(lines):
+    table = [m.group(1) for m in map(ROW.match, lines) if m]
+    assert len(table) == 4, table
+    seen = 0
+    for ln in lines:
+        m = SIG.match(ln)
+        if not m:
+            continue
+        name, tail = m.group(1), m.group(2)
+        idx = table.index(name)
+        if name.endswith("func_00000030"):
+            assert tail == "", f"import stub must carry no guard: {ln!r}"
+        else:
+            assert tail == f" PPU_FN_ENTRY({idx});", f"{name}: want index {idx}: {ln!r}"
+        seen += 1
+    assert seen == 4, seen
+    return table
+
+
+def main() -> int:
+    # --- single-file emission ------------------------------------------------
+    lf = _lifter()
+    on = lf.emit_source().split("\n")
+    table = _check_markers(on)
+    text = "\n".join(on)
+    stub_idx = table.index("func_00000030")
+    assert "#ifdef PPU_MOD_HOOKS\n" in text
+    assert "uint8_t function_table_hook_flags[5];" in text, text[-600:]
+    assert re.search(r"function_table_unguarded\[\] = \{\n    %d,\n    0xFFFFFFFFu\n\};\n#endif"
+                     % stub_idx, text), text[-600:]
+    hdr_on = lf.emit_header()
+    assert "#  define PPU_FN_ENTRY(i) ((void)0)" in hdr_on
+    assert "function_table_hook_flags[(i)]" in hdr_on
+    assert "ppu_hook_enter(function_table, (uint32_t)(i), ctx)" in hdr_on
+
+    # --- off: no trace of the mechanism, same lines otherwise ----------------
+    lf.fn_entry = False
+    off = lf.emit_source().split("\n")
+    hdr_off = lf.emit_header()
+    assert not any("PPU_FN_ENTRY" in ln or "hook_flags" in ln for ln in off)
+    assert "PPU_FN_ENTRY" not in hdr_off and "PPU_MOD_HOOKS" not in hdr_off
+    assert FN_ENTRY_PREAMBLE in hdr_on, "header block missing"
+    assert hdr_on.replace(FN_ENTRY_PREAMBLE, "", 1) == hdr_off, \
+        "the header may differ only by the macro block"
+    # The function part is line-for-line the same apart from the marker on the
+    # signature line; the table chunk adds only the #ifdef PPU_MOD_HOOKS block.
+    block = on[len(off):]
+    assert block[0] == "#ifdef PPU_MOD_HOOKS" and block[-2] == "#endif", block
+    changed = 0
+    for a, b in zip(on[:len(off)], off):
+        if a != b:
+            assert SIG.match(a) and re.sub(r" PPU_FN_ENTRY\(\d+\);$", "", a) == b, (a, b)
+            changed += 1
+    assert changed == 3, changed
+
+    # --- chunked emission: the index survives the split ----------------------
+    lf.fn_entry = True
+    with tempfile.TemporaryDirectory() as tmp:
+        paths = lf.write_source_files(tmp, max_lines=10)   # one function per chunk
+        assert len(paths) == 4, paths
+        lines = []
+        for p in paths:
+            with open(p) as fh:
+                lines += fh.read().split("\n")
+        _check_markers(lines)
+
+    # --- symbol prefix: per-image guard symbols ------------------------------
+    lp = _lifter("libsre_")
+    hdr = lp.emit_header()
+    src = lp.emit_source()
+    assert "libsre_function_table_hook_flags[(i)]" in hdr, hdr
+    assert "ppu_hook_enter(libsre_function_table, (uint32_t)(i), ctx)" in hdr
+    assert "extern const uint32_t libsre_function_table_unguarded[];" in hdr
+    assert "uint8_t libsre_function_table_hook_flags[5];" in src
+    assert "const uint32_t libsre_function_table_unguarded[] = {" in src
+
+    print("PASS: PPU_FN_ENTRY marker, header block, guard table, --no-fn-entry")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
