+static int name_eq(const char* a, size_t n, const char* b)
+{
+    size_t i;
+    if (strlen(b) != n) return 0;
+    for (i = 0; i < n; i++) {
+        char x = a[i], y = b[i];
+        if (x >= 'a' && x <= 'z') x = (char)(x - 32);
+        if (y >= 'a' && y <= 'z') y = (char)(y - 32);
+        if (x != y) return 0;
+    }
+    return 1;
+}
+
+int host_key_parse(const char* name, size_t n, unsigned out[2])
+{
+    size_t i;
+    if (!name || !n) return 0;
+    if (name_eq(name, n, "Shift")) { out[0] = 0x2A; out[1] = 0x36; return 2; }
+    if (name_eq(name, n, "Ctrl") || name_eq(name, n, "Control")) { out[0] = 0x1D; out[1] = HK_EXT | 0x1D; return 2; }
+    if (name_eq(name, n, "Alt")) { out[0] = 0x38; out[1] = HK_EXT | 0x38; return 2; }
+    for (i = 0; i < sizeof s_alias / sizeof s_alias[0]; i++)
+        if (name_eq(name, n, s_alias[i].alias)) { name = s_alias[i].name; n = strlen(name); break; }
+    for (i = 0; i < sizeof s_names / sizeof s_names[0]; i++)
+        if (name_eq(name, n, s_names[i].name)) { out[0] = s_names[i].code; return 1; }
+    /* "sc:1E" / "sc:E0 48": a raw scancode (keys without a name, e.g. on a non-US keyboard) */
+    if (n > 3 && (name[0] == 's' || name[0] == 'S') && (name[1] == 'c' || name[1] == 'C') && name[2] == ':') {
+        unsigned v = 0, ext = 0;
+        size_t k = 3;
+        if (n >= k + 2 && (name[k] == 'e' || name[k] == 'E') && name[k + 1] == '0' && n > k + 2) { ext = HK_EXT; k += 2; }
+        for (; k < n; k++) {
+            const char c = name[k];
+            if (c == ' ' || c == '_') continue;
+            v <<= 4;
+            if (c >= '0' && c <= '9') v |= (unsigned)(c - '0');
+            else if (c >= 'a' && c <= 'f') v |= (unsigned)(c - 'a' + 10);
+            else if (c >= 'A' && c <= 'F') v |= (unsigned)(c - 'A' + 10);
+            else return 0;
+        }
+        if (v == 0 || v > 0xFF) return 0;
+        out[0] = v | ext;
+        return 1;
+    }
+    return 0;
+}
+
+const char* host_key_name(unsigned code)
+{
+    size_t i;
+    for (i = 0; i < sizeof s_names / sizeof s_names[0]; i++)
+        if (s_names[i].code == code) return s_names[i].name;
+    return NULL;
+}
