+/* ===========================================================================
+ * 5. Events, decrementer, machine status, SRR0
+ * ===========================================================================*/
+static void test_events(void)
+{
+    TEST("event.mask");
+    spu_context* c = new_ctx(8);
+    CHECK_EQ(rd(c, SPU_RdEventMask), 0);
+    wr(c, SPU_WrEventMask, 0x402);
+    CHECK_EQ(rd(c, SPU_RdEventMask), 0x402);
+
+    TEST("event.stat-is-masked");
+    /* RdEventStat returns the pending events that are ENABLED. Make LR and SN
+     * pending through their real producers, enable only one at a time. */
+    spu_context* b = new_ctx(9);
+    getllar(c, 0x7000, EA_LINE);
+    ppu_store32(EA_LINE + 8, 1);                        /* LR (0x400) pending */
+    list_elem(c, 0xA00, 16, EA_BUF, 1); list_elem(c, 0xA08, 16, EA_BUF, 0);
+    mfc(c, MFC_GETL_CMD, 0xB000, 0xA00, 16, 4);          /* SN (0x2) pending */
+    wr(c, SPU_WrEventMask, 0x2);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 1);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x2);
+    wr(c, SPU_WrEventMask, 0x400);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x400);
+    wr(c, SPU_WrEventMask, 0x402);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x402);
+
+    TEST("event.ack");
+    wr(c, SPU_WrEventAck, 0x2);                          /* only the acked bit */
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x400);
+    wr(c, SPU_WrEventAck, 0x400);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    wr(c, SPU_WrEventMask, 0x1);                         /* nothing pending under the mask */
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    (void)rd(c, MFC_RdListStallStat); wr(c, MFC_WrListStallAck, 4);
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu);
+    wr(c, SPU_WrEventMask, 0);
+    free_ctx(b);
+
+    TEST("event.decrementer-rate");
+    /* 79.8 MHz, counting down from the value written. */
+    uint64_t t0 = qpc_ns();
+    wr(c, SPU_WrDec, 0x7FFFFFFFu);
+    uint64_t t1 = qpc_ns();
+    Sleep(60);
+    uint64_t t2 = qpc_ns();
+    uint32_t d = rd(c, SPU_RdDec);
+    uint64_t t3 = qpc_ns();
+    uint32_t elapsed = 0x7FFFFFFFu - d;
+    double lo = (double)(t2 - t1) * 0.0798 - 2000.0, hi = (double)(t3 - t0) * 0.0798 + 2000.0;
+    printf("  [event.decrementer-rate] %u ticks over %.3f..%.3f ms (expect %.0f..%.0f)\n",
+           elapsed, (double)(t2 - t1) / 1e6, (double)(t3 - t0) / 1e6, lo, hi);
+    CHECK((double)elapsed >= lo && (double)elapsed <= hi);
+    /* Monotonic, and wraps through zero like a 32-bit down counter. */
+    wr(c, SPU_WrDec, 100);
+    Sleep(2);
+    uint32_t d2 = rd(c, SPU_RdDec);
+    CHECK(d2 > 0x80000000u);                 /* went "negative" */
+
+    TEST("event.decrementer-long-run");
+    /* A persistent thread (Havok reads RdDec for its timers without ever
+     * writing WrDec) runs for hours: the decrementer has to keep counting at
+     * the same rate. Pretend the base was stamped 300 s / 1 h ago. */
+    { static const uint64_t ages_s[] = { 200, 300, 3600, 86400 };
+      for (int k = 0; k < 4; k++) {
+          wr(c, SPU_WrDec, 0xFFFFFFFFu);
+          c->dec_base_ns -= ages_s[k] * 1000000000ull;
+          uint32_t v = rd(c, SPU_RdDec);
+          uint32_t want = 0xFFFFFFFFu - (uint32_t)(ages_s[k] * 79800000ull);
+          int32_t diff = (int32_t)(want - v);     /* ticks the read is ahead of the expectation */
+          printf("  [event.decrementer-long-run] %llus: got 0x%08X want ~0x%08X (diff %d ticks)\n",
+                 (unsigned long long)ages_s[k], v, want, diff);
+          CHECK(diff >= 0 && diff < 800000);     /* < 10 ms of ticks of real elapsed time */
+      } }
+
+    TEST("event.machstat-srr0");
+    /* SPU_RdMachStat bit 31 (LSB) is the interrupt-enable status. */
+    c->int_enable = 0;
+    CHECK_EQ(rd(c, SPU_RdMachStat) & 1, 0);
+    c->int_enable = 1;
+    CHECK_EQ(rd(c, SPU_RdMachStat) & 1, 1);
+    c->int_enable = 0;
+    /* SRR0 holds a word-aligned local-store address. */
+    wr(c, SPU_WrSRR0, 0x1234u);
+    CHECK_EQ(rd(c, SPU_RdSRR0), 0x1234u);
+    wr(c, SPU_WrSRR0, 0xFFFFFFFFu);
+    CHECK_EQ(rd(c, SPU_RdSRR0), 0x3FFFCu);
+
+    TEST("event.counts-constant");
+    /* Channels that never stall report a count of 1. */
+    static const uint32_t ones[] = { SPU_WrEventMask, SPU_WrEventAck, SPU_WrDec, SPU_RdDec,
+        SPU_RdEventMask, SPU_RdMachStat, SPU_WrSRR0, SPU_RdSRR0, MFC_RdTagMask, MFC_LSA,
+        MFC_EAH, MFC_EAL, MFC_Size, MFC_TagID, MFC_WrTagMask, MFC_WrTagUpdate, MFC_WrListStallAck };
+    { int ok = 1; for (unsigned k = 0; k < sizeof ones / sizeof ones[0]; k++) if (cnt(c, ones[k]) != 1) ok = 0;
+      CHECK(ok); }
+    NOTE(cnt(c, MFC_RdAtomicStat) == 0, "rchcnt(MFC_RdAtomicStat) is 1 with no atomic command completed (hardware: 0)");
+    free_ctx(c);
+}
