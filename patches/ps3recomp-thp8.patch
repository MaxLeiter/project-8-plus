+ * ps3recomp - the SDL keyboard/mouse-state subset host_input.c uses, over the browser (PS3_WASM builds only).
+ *
+ * Scancodes are USB HID keyboard usage IDs (what SDL's scancodes are); the page maps KeyboardEvent.code to the
+ * same IDs (web/host/input.js) and writes ps3_web_input.keys[] / mouse_buttons (web_input.h).
+ */
+#ifndef PS3RECOMP_WEB_SDL_KEYS_H
+#define PS3RECOMP_WEB_SDL_KEYS_H
+
+#include <stdint.h>
+#include "web_input.h"
+
+typedef uint8_t  Uint8;
+typedef uint32_t Uint32;
+
+#define SDL_INIT_VIDEO 0x20u
+static inline Uint32 SDL_WasInit(Uint32 flags) { return flags; }
+static inline const Uint8* SDL_GetKeyboardState(int* numkeys)
+{
+    if (numkeys) *numkeys = 512;
+    return ps3_web_input_state()->keys;
+}
