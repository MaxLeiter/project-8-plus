+#if !defined(PS3_WASM)
+static SPU_THREAD_LOCAL unsigned long long t_gs_job0;   /* (browser build: declared with the batch breakdown) */
+#endif
+static int s_cap_jobs = -1;   /* SPU_CAPTURE has a job= spec (read at the first PM poll) */
+static SPU_THREAD_LOCAL uint32_t t_gs_jobkey;
+static void gs_job_note(uint32_t key, unsigned long long ticks)
+{
+    for (int i = 0; i < GS_JOBK; i++) {
+        uint32_t k = s_gs_job[i].key;
+        if (k == 0) { uint32_t z = 0; if (!__atomic_compare_exchange_n(&s_gs_job[i].key, &z, key, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) k = z; else k = key; }
+        if (k != key) continue;
+        __atomic_fetch_add(&s_gs_job[i].n, 1, __ATOMIC_RELAXED);
+        __atomic_fetch_add(&s_gs_job[i].ticks, (long long)ticks, __ATOMIC_RELAXED);
+        long long m = s_gs_job[i].max; while ((long long)ticks > m && !__atomic_compare_exchange_n(&s_gs_job[i].max, &m, (long long)ticks, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+        return;
+    }
+}
+static void gs_job_line(void)
+{
+    static double s_tpu;   /* TSC ticks per us, calibrated against QPC once */
+    if (!s_tpu) {
+#if defined(_WIN32)
+        LARGE_INTEGER f, a, b; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&a);
+        unsigned long long t0 = __rdtsc(); do QueryPerformanceCounter(&b); while ((b.QuadPart - a.QuadPart) * 100 < f.QuadPart);
+        s_tpu = (double)(__rdtsc() - t0) / ((double)(b.QuadPart - a.QuadPart) * 1e6 / (double)f.QuadPart);
+#else
+        struct timespec a, b; clock_gettime(CLOCK_MONOTONIC, &a); unsigned long long t0 = __rdtsc();
+        do clock_gettime(CLOCK_MONOTONIC, &b); while ((b.tv_sec - a.tv_sec) * 1000000000LL + (b.tv_nsec - a.tv_nsec) < 10000000LL);
+        s_tpu = (double)(__rdtsc() - t0) / (((b.tv_sec - a.tv_sec) * 1000000000LL + (b.tv_nsec - a.tv_nsec)) / 1000.0);
+#endif
+    }
+    char b[700]; int p = snprintf(b, sizeof b, "[game-stats] job batches:");
+    for (int i = 0; i < GS_JOBK && s_gs_job[i].key; i++) {
+        long long n = __atomic_exchange_n(&s_gs_job[i].n, 0, __ATOMIC_RELAXED);
+        long long t = __atomic_exchange_n(&s_gs_job[i].ticks, 0, __ATOMIC_RELAXED);
+        long long m = __atomic_exchange_n(&s_gs_job[i].max, 0, __ATOMIC_RELAXED);
+        if (n) p += snprintf(b + p, sizeof b - p, " %08X n=%lld avg=%.0fus max=%.0fus tot=%.1fms |",
+                             s_gs_job[i].key, n, (double)t / n / s_tpu, (double)m / s_tpu, (double)t / s_tpu / 1000.0);
+    }
+    fprintf(stderr, "%s\n", b);
+#if defined(PS3_WASM)
+    {   const long long tot = __atomic_exchange_n(&s_bt_total_ns, 0, __ATOMIC_RELAXED);
+        const long long an = __atomic_exchange_n(&s_bt_atom_ns, 0, __ATOMIC_RELAXED), dn = __atomic_exchange_n(&s_bt_dma_ns, 0, __ATOMIC_RELAXED);
+        const long long ac = __atomic_exchange_n(&s_bt_atom_n, 0, __ATOMIC_RELAXED), dc = __atomic_exchange_n(&s_bt_dma_n, 0, __ATOMIC_RELAXED);
+        const long long cn = __atomic_exchange_n(&s_bt_ch_ns, 0, __ATOMIC_RELAXED), cc = __atomic_exchange_n(&s_bt_ch_n, 0, __ATOMIC_RELAXED);
+        const long long pn = __atomic_exchange_n(&s_bt_park_ns, 0, __ATOMIC_RELAXED), pc = __atomic_exchange_n(&s_bt_park_n, 0, __ATOMIC_RELAXED);
+        if (tot) fprintf(stderr, "[game-stats] batch time %.1f ms: atomic %.1f ms (%lld ops, %.2f us/op; of it parked %.1f ms in %lld parks)"
+                         " dma %.1f ms (%lld cmds, %.2f us/cmd) rdch %.1f ms (%lld) code %.1f ms\n",
+                         tot / 1e6, an / 1e6, ac, ac ? an / 1e3 / ac : 0.0, pn / 1e6, pc, dn / 1e6, dc, dc ? dn / 1e3 / dc : 0.0,
+                         cn / 1e6, cc, (tot - an - dn - cn) / 1e6); }
+#endif
+}
+static void gs_maybe_print(void)
+{
+    extern unsigned long long game_stats_now_us(void);
+    extern volatile long g_gs_ppu_wake, g_gs_spu_wake, g_gs_arm_filtered;
+    extern volatile long g_gs_sync_calls, g_gs_sync_contended;
+    extern volatile long long g_gs_sync_spin_us;
+    extern volatile long g_gs_spin_parked[4];
+    static volatile unsigned long long s_last;
+    unsigned long long now = game_stats_now_us(), last = s_last;
+    if (!last) { __atomic_compare_exchange_n(&s_last, &last, now, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED); return; }
+    if (now - last < (unsigned long long)s_gs * 1000000ull) return;
