+#  define MODS_LOAD_PTR(pp)     __atomic_load_n((pp), __ATOMIC_ACQUIRE)
+#  define MODS_STORE_PTR(pp, v) __atomic_store_n((pp), (v), __ATOMIC_RELEASE)
+#endif
+
+#define MODS_PATH 1100
