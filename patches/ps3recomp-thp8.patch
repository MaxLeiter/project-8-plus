+        fprintf(stderr,
+                "[rsx-vertex-surface] mode=%s target=%u "
+                "pixels=%llu nonblack=%s%llu path=%s\n",
+                ld_vertex_mode_name(), presented,
+                (unsigned long long)presented_surface->w *
+                    presented_surface->h,
+                nonblack == UINT64_MAX ? "unknown:" : "",
+                (unsigned long long)(
+                    nonblack == UINT64_MAX ? 0 : nonblack),
+                path);
+    }
+    fflush(stderr);
+}
