+                shader_disk_cache_store(s ? 'P' : 'V', j->hlsl[s], j->len[s], j->hash[s], j->blob[s]);
+            }
+            if (err) err->lpVtbl->Release(err);
+        }
+        if (ok) {
+            rsx_vertex_layout_plan plan;
+            rsx_vertex_layout_plan_init(&plan, j->inmask);
+            D3D12_INPUT_ELEMENT_DESC il[16];
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+            WCHAR name[20];
+            ld_fill_pso_desc(&pd, il, j->blob[0], j->blob[1], &j->rs, j->masked ? &plan : NULL, j->packed, j->gpf);
+            j->lib_hash = ld_psolib_name(&pd, name);
+            /* never LoadGraphicsPipeline here: the render thread may be loading
+             * the same entry (the library does not synchronise that) */
+            const HRESULT hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState,
+                                                                          (void**)&j->pso);
+            if (SUCCEEDED(hr) && j->pso) {
+                ld_psolib_ix ix;
+                ld_psolib_ix_make(&ix, j->lib_hash, j->hash[0], j->len[0], j->hash[1], j->len[1], j->masked,
+                                  j->inmask, j->packed, j->gpf, &j->rs);
+                ld_psolib_store(name, j->pso, !render_thread, &ix);   /* the render thread never waits on a save */
+            } else {
+                static volatile LONG said = 0;
+                if (InterlockedIncrement(&said) <= 8)
+                    fprintf(stderr, "[pso-fail] async create hr=0x%08lX\n", (unsigned long)hr);
+                j->pso = NULL;
+            }
+        }
+        InterlockedExchange(&j->done, 1);
+    }
+}
+
+static DWORD LD_THREAD_CC pso_async_worker(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);   /* never above the game's own threads */
+    for (;;) {
+        AcquireSRWLockExclusive(&g_psoa.lock);
+        while (!g_psoa.todo)
+            SleepConditionVariableSRW(&g_psoa.cv, &g_psoa.lock, INFINITE, 0);
+        pso_job* j = g_psoa.todo;
+        g_psoa.todo = j->next;
+        if (!g_psoa.todo) g_psoa.todo_tail = NULL;
+        ReleaseSRWLockExclusive(&g_psoa.lock);
+        pso_job_run(j, 0);
+    }
+}
+
+/* take a job out of the worker queue if no worker has started it (1 = taken) */
+static int pso_job_unqueue(pso_job* j)
+{
+    int taken = 0;
+    AcquireSRWLockExclusive(&g_psoa.lock);
+    for (pso_job *q = g_psoa.todo, *prev = NULL; q; prev = q, q = q->next) {
+        if (q != j) continue;
+        if (prev) prev->next = q->next; else g_psoa.todo = q->next;
+        if (g_psoa.todo_tail == q) g_psoa.todo_tail = prev;
+        q->next = NULL;
+        taken = 1;
+        break;
+    }
+    ReleaseSRWLockExclusive(&g_psoa.lock);
+    return taken;
+}
+
+static int ld_pso_async_on(void)
+{
+    if (g_psoa.on < 0) {
+        const char* e = getenv("PS3_PSO_ASYNC");
+        g_psoa.on = !(e && e[0] == '0') && g_psolib.state == 1;
+        if (!(e && e[0] == '0') && g_psolib.state != 1)
+            fprintf(stderr, "[pso-async] off: needs the PSO library (PS3_PSO_LIBRARY)\n");
+        g_psoa.off_file = getenv("PS3_PSO_ASYNC_OFF_FILE");
+        const char* w = getenv("PS3_PSO_ASYNC_WAIT_MS");
+        g_psoa.wait_us = (u32)((w ? atof(w) : 2.0) * 1000.0);
+        const char* b = getenv("PS3_PSO_ASYNC_BURST");
+        g_psoa.burst_n = b ? (u32)strtoul(b, NULL, 0) : 32u;
+        const char* md = getenv("PS3_PSO_ASYNC_MODE");
+        g_psoa.mode_all = md && !strcmp(md, "all");
+        if (g_psoa.on) {
+            InitializeSRWLock(&g_psoa.lock);
+            InitializeConditionVariable(&g_psoa.cv);
+            const char* t = getenv("PS3_PSO_ASYNC_THREADS");
+            int n = t ? atoi(t) : 3;
+            if (n < 1) n = 1;
+            if (n > 8) n = 8;
+            for (int i = 0; i < n; i++) {
+                HANDLE th = CreateThread(NULL, 0, pso_async_worker, NULL, 0, NULL);
+                if (th) g_psoa.wth[g_psoa.workers++] = th;   /* kept: the workers live as long as the process */
+            }
+            if (!g_psoa.workers) g_psoa.on = 0;
+            fprintf(stderr, "[pso-async] on: %d workers, mode %s (skips only in frames with >= %u misses), "
+                            "render thread waits <= %.1f ms per frame%s\n",
+                    g_psoa.workers, g_psoa.mode_all ? "all" : "burst", g_psoa.burst_n, g_psoa.wait_us / 1000.0,
+                    g_psoa.off_file ? " (PS3_PSO_ASYNC_OFF_FILE)" : "");
+        }
+    }
+    if (!g_psoa.on) return 0;
+    if (g_psoa.off_file && g_psoa.off_frame != g_ld_frames + 1u) {
+        g_psoa.off_frame = g_ld_frames + 1u;
+        struct stat st;
+        const int off = stat(g_psoa.off_file, &st) == 0;
+        if (off != g_psoa.off_now)
+            fprintf(stderr, "[pso-async] frame %u: %s\n", g_ld_frames, off ? "synchronous" : "async");
+        g_psoa.off_now = off;
+    }
+    return !g_psoa.off_now;
+}
+
+/* Library loads are a full driver compile when the driver's own cache is cold
+ * (NVIDIA keys it by exe path: a new install dir or exe path). After 8 loads
+ * averaging > 2 ms the async path stops loading on the render thread and lets
+ * the workers create (which warms the driver cache) instead. */
+static int ld_psolib_loads_slow(void)
+{
+    const LONG n = g_psolib.loads;
+    static int said;
+    const int slow = n >= 8 && g_psolib.load_us > (LONG64)n * 2000;
+    if (slow && !said) {
+        said = 1;
+        fprintf(stderr, "[pso-async] library loads average %.1f ms (cold driver cache): misses go to the workers\n",
+                (double)g_psolib.load_us / n / 1000.0);
+    }
+    return slow;
+}
+
+/* a blob from the memory or disk cache (a reference), or NULL */
+static ID3DBlob* ld_blob_lookup(u32 stage, const char* hlsl, u32 len, u64 hash)
+{
+    shader_blob_cache_t* c = stage == 'V' ? &g.vs_blobs : &g.ps_blobs;
+    int pb = 0, seen = 0;
+    ID3DBlob* b = shader_blob_cache_find(c, hlsl, len, hash, &pb, &seen);
+    if (b) return b;
+    b = ld_disk_load_rt(stage, hlsl, len, hash);
+    if (b) shader_blob_cache_insert_accounted(c, hlsl, len, hash, b, stage, seen);
+    return b;
+}
+
+/* render thread: a finished job -> its PSO (a reference, or NULL on failure) */
+static ID3D12PipelineState* ld_pso_job_take(pso_job* j)
+{
+    for (int s = 0; s < 2; s++) {
+        if (j->compiled[s] && j->blob[s])
+            shader_blob_cache_insert_accounted(s ? &g.ps_blobs : &g.vs_blobs, j->hlsl[s], j->len[s], j->hash[s],
+                                               j->blob[s], s ? 'P' : 'V', 0);
+        if (j->blob[s]) j->blob[s]->lpVtbl->Release(j->blob[s]);
+        free(j->hlsl[s]);
+    }
+    ID3D12PipelineState* pso = j->pso;
+    if (pso) { if (ld_pso_dedup_on()) ld_pso_dedup_add(j->lib_hash, pso); } else g_psoa.failed++;
+    const u32 waited = g_ld_frames - j->frame;
+    if (waited > g_psoa.wait_frames_max) g_psoa.wait_frames_max = waited;
+    free(j);
+    return pso;
+}
+
+/* build_pso with the slow parts on the workers. *job = the pending job (draws
+ * of this key are skipped until it is done), NULL = resolved now. */
+static ID3D12PipelineState* build_pso_async(
+    const char* vs_hlsl, const char* ps_hlsl, const render_state_t* rs,
+    const rsx_vertex_layout_plan* masked_layout, int packed_offsets, int gpu_fetch, pso_job** job)
+{
+    *job = NULL;
+    const u32 vl = (u32)strlen(vs_hlsl), pl = (u32)strlen(ps_hlsl);
+    const u64 vh = fnv1a(vs_hlsl, vl, 1469598103934665603ull), ph = fnv1a(ps_hlsl, pl, 1469598103934665603ull);
+    ID3DBlob* vs = ld_blob_lookup('V', vs_hlsl, vl, vh);
+    ID3DBlob* ps = ld_blob_lookup('P', ps_hlsl, pl, ph);
+    if (vs && ps) {   /* all inputs at hand: dedup / library, both cheap */
+        D3D12_INPUT_ELEMENT_DESC il[16];
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+        WCHAR name[20];
+        ld_fill_pso_desc(&pd, il, vs, ps, rs, masked_layout, packed_offsets, gpu_fetch);
+        const u64 h = ld_psolib_name(&pd, name);
+        FT_T0(ft_d0);
+        ID3D12PipelineState* pso = ld_pso_dedup_on() ? ld_pso_dedup_find(h) : NULL;
+        if (pso) {
+            FT_ADD(FT_PSOLIB_N, 1); FT_ADD(FT_PSOLIB_US, FT_SINCE(ft_d0));
+        } else if (!g_psolib_ab_off && !ld_psolib_loads_slow() && (pso = ld_psolib_load(name, &pd)) != NULL) {
+            if (ld_pso_dedup_on()) ld_pso_dedup_add(h, pso);
+        }
+        if (pso) {
+            vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+            return pso;
+        }
+    }
+    pso_job* j = (pso_job*)calloc(1, sizeof(pso_job));
+    if (!j) { if (vs) vs->lpVtbl->Release(vs); if (ps) ps->lpVtbl->Release(ps); return NULL; }
+    const char* src[2] = { vs_hlsl, ps_hlsl };
+    j->blob[0] = vs; j->blob[1] = ps;
+    j->len[0] = vl; j->len[1] = pl; j->hash[0] = vh; j->hash[1] = ph;
+    for (int s = 0; s < 2; s++) {   /* the source also re-keys a compiled blob into the memory cache */
+        j->hlsl[s] = (char*)malloc((size_t)j->len[s] + 1u);
+        if (j->hlsl[s]) memcpy(j->hlsl[s], src[s], (size_t)j->len[s] + 1u);
+        else if (!j->blob[s]) { for (int t = 0; t < 2; t++) { if (j->blob[t]) j->blob[t]->lpVtbl->Release(j->blob[t]); free(j->hlsl[t]); } free(j); return NULL; }
+    }
+    j->rs = *rs;
+    j->inmask = masked_layout ? masked_layout->mask : 0xFFFFu;
+    j->masked = masked_layout != NULL;
+    j->packed = packed_offsets;
+    j->gpf = gpu_fetch;
+    j->frame = g_ld_frames;
+    g_psoa.jobs++; g_psoa.t_jobs++;
+    AcquireSRWLockExclusive(&g_psoa.lock);
+    if (g_psoa.todo_tail) g_psoa.todo_tail->next = j; else g_psoa.todo = j;
+    g_psoa.todo_tail = j;
+    ReleaseSRWLockExclusive(&g_psoa.lock);
+    WakeConditionVariable(&g_psoa.cv);
+    /* A fast create (warm driver cache) comes back within the wait. The budget
+     * is per frame, not per miss: a burst of misses on a cold driver cache
+     * (each job 10-40 ms) must not add up 2 ms per miss of useless waiting. */
+    if (g_psoa.frame_wait_frame != g_ld_frames + 1u) {
+        g_psoa.frame_wait_frame = g_ld_frames + 1u;
+        g_psoa.frame_waited_us = 0;
+    }
+    if (g_psoa.frame_waited_us < g_psoa.wait_us) {
+        LARGE_INTEGER f, t0, t;
+        QueryPerformanceFrequency(&f);
+        QueryPerformanceCounter(&t0);
+        const u32 left = g_psoa.wait_us - g_psoa.frame_waited_us;
+        const LONGLONG limit = (LONGLONG)((double)f.QuadPart * left / 1e6);
+        t = t0;
+        do {
+            if (j->done) break;
+            SwitchToThread();
+            QueryPerformanceCounter(&t);
+        } while (t.QuadPart - t0.QuadPart < limit);
+        g_psoa.frame_waited_us += (u32)((double)(t.QuadPart - t0.QuadPart) * 1e6 / (double)f.QuadPart);
+    }
+    if (j->done) { g_psoa.sync_done++; return ld_pso_job_take(j); }
+    *job = j;
+    return NULL;
+}
+
+/* Where a draw may be skipped. A frame with PS3_PSO_ASYNC_BURST (32) or more
+ * get_pso misses is a scene change: in THP8 the level, a zone or a menu builds
+ * its first frames behind a loading screen (skip-frame dumps of cold loads:
+ * every burst frame -- 1266, 416, 347, 142 skipped draws -- showed the loading
+ * screen both with and without them). Only there do new pipelines go to the
+ * workers and their draws skip, which keeps the parallel compile of a cold load.
+ * Everywhere else (PS3_PSO_ASYNC_MODE=burst, default) a miss compiles
+ * synchronously and a draw whose pipeline is still with a worker waits for it:
+ * menus, skater select, the first visible level frame and play never lose a
+ * draw (a cold library showed a vanished skater jacket, a missing menu panel,
+ * a black loading screen and 1-3 draw pop-ins while skating). PS3_PSO_ASYNC_
+ * MODE=all: the batch9 behaviour (async for every miss outside the never-skip
+ * classes). Called once per get_pso miss (render thread); returns 1 when this
+ * miss may go async. */
+static int ld_pso_burst_frame(void)   /* this frame reached the burst count (no counting) */
+{
+    return g_psoa.miss_frame == g_ld_frames + 1u && g_psoa.burst_n && g_psoa.miss_n >= g_psoa.burst_n;
+}
+
+static int ld_pso_async_allowed(void)
+{
+    if (g_psoa.miss_frame != g_ld_frames + 1u) { g_psoa.miss_frame = g_ld_frames + 1u; g_psoa.miss_n = 0; }
+    if (++g_psoa.miss_n == g_psoa.burst_n && g_psoa.burst_n) {
+        g_psoa.sync_windows++;
+        if (g_psoa.sync_windows <= 64 || (g_psoa.sync_windows & (g_psoa.sync_windows - 1)) == 0)
+            fprintf(stderr, "[pso-async] frame %u: %u misses in one frame (scene change): async with skips "
+                            "for the rest of this frame\n", g_ld_frames, g_psoa.miss_n);
+    }
+    return g_psoa.mode_all || ld_pso_burst_frame();
+}
+
+/* PS3_PSO_SKIP_DUMP=<dir> (test only): at present, the first frame of every
+ * streak of frames in which PS3_PSO_ASYNC skipped draws, and the first frame
+ * after it (the pipelines back), as <dir>/pso_skip_f<frame>_<skipped>.ppm and
+ * _after.ppm; at most PS3_PSO_SKIP_DUMP_MAX (60) files. Returns the path to
+ * dump the presented surface to, or NULL. */
+static const char* ld_pso_skip_dump_path(char* buf, size_t cap)
+{
+    static const char* dir = (const char*)-1;
+    static u32 max_files, files, in_streak;
+    if (dir == (const char*)-1) {
+        dir = getenv("PS3_PSO_SKIP_DUMP");
+        if (dir && !*dir) dir = NULL;
+        const char* m = getenv("PS3_PSO_SKIP_DUMP_MAX");
+        max_files = m ? (u32)strtoul(m, NULL, 0) : 60u;
+        if (dir) CreateDirectoryA(dir, NULL);
+    }
+    if (!dir || files >= max_files) return NULL;
+    const u32 skips = g_psoa.frame_skips_frame == g_ld_frames + 1u ? g_psoa.frame_skips : 0u;
+    if (skips && !in_streak) {
+        in_streak = 1; files++;
+        snprintf(buf, cap, "%s/pso_skip_f%06u_%u.ppm", dir, g_ld_frames, skips);
+        return buf;
+    }
+    if (!skips && in_streak) {
+        in_streak = 0; files++;
+        snprintf(buf, cap, "%s/pso_skip_f%06u_after.ppm", dir, g_ld_frames);
+        return buf;
+    }
+    return NULL;
+}
+
+/* Draws PS3_PSO_ASYNC never skips -- their pipelines compile synchronously
+ * (a short wait beats a vanishing skater or a black loading screen):
+ *   2D / UI / full-screen passes: depth test off (menus, HUD, loading
+ *     screens, post-processing quads);
+ *   characters: the position stream comes from main memory -- THP8 skins its
+ *     characters on the SPU into main-memory vertex buffers ("CPU Skinning
+ *     Main Buffer"); static world geometry is in local memory.
+ * PS3_PSO_ASYNC_NEVERSKIP: 3 (default) both, 1 depth-off only, 2 main-memory
+ * only, 0 none. PS3_PSO_CLASS_LOG=1: one [pso-class] line per get_pso miss
+ * (first 4000) with the inputs of this decision. Called per miss. */
+static int ld_pso_never_skip(const render_state_t* rs, const rsx_vertex_layout_plan* layout, u32 vp_instrs,
+                             u32 fp_size, u64 key)
+{
+    static int mode = -1, clog = -1;
+    static u32 logged;
+    if (mode < 0) {
+        const char* e = getenv("PS3_PSO_ASYNC_NEVERSKIP");
+        mode = e ? atoi(e) & 3 : 3;
+        clog = getenv("PS3_PSO_CLASS_LOG") ? 1 : 0;
+    }
+    /* the position stream: attribute 0, else the first enabled one of the layout */
+    rsx_dsp_vertex_attr a;
+    memset(&a, 0, sizeof(a));
+    u32 ai = 0;
+    rsx_dsp_get_vertex_attr(&g.rsx, 0, &a);
+    if (!a.size && layout) {
+        for (u32 s = 0; s < layout->count; s++) {
+            rsx_dsp_get_vertex_attr(&g.rsx, layout->attrs[s], &a);
+            if (a.size) { ai = layout->attrs[s]; break; }
+        }
+    }
+    const int ui = !rs->depth_test;
+    const int mainmem = a.size && a.location == RSX_LOCATION_MAIN;
+    const int sync = ((mode & 1) && ui) || ((mode & 2) && mainmem);
+    if (clog && logged < 4000) {
+        logged++;
+        fprintf(stderr, "[pso-class] frame %u key %016llx: %s depth %u/%u blend %u cmask %08X rt %u%s pos a%u loc %u "
+                        "stride %u in %X vp %u fp %u\n",
+                g_ld_frames, (unsigned long long)key, sync ? (ui ? "SYNC-ui" : "SYNC-main") : "async",
+                rs->depth_test, rs->depth_write, rs->blend_enable, rs->color_mask, rs->rt_count,
+                rs->rt_fp16 ? " fp16" : "", ai, a.size ? a.location : 9u, a.stride, layout ? layout->mask : 0xFFFFu,
+                vp_instrs, fp_size);
+    }
+    if (sync) g_psoa.class_sync++;
+    return sync;
+}
+
+static void ld_pso_skip_note(const render_state_t* rs)
+{
+    if (g_psoa.frame_skips_frame != g_ld_frames + 1u) { g_psoa.frame_skips_frame = g_ld_frames + 1u; g_psoa.frame_skips = 0; }
+    g_psoa.frame_skips++;
+    g_psoa.skips++; g_psoa.t_skips++;
+    if (g_psoa.last_skip_frame != g_ld_frames + 1u) {
+        g_psoa.last_skip_frame = g_ld_frames + 1u;
+        g_psoa.skip_frames++; g_psoa.t_skip_frames++;
+    }
+    if (rs) {
+        if (!rs->color_mask) g_psoa.cls_depth_only++;
+        if (rs->rt_count > 1) g_psoa.cls_mrt++;
+        if (rs->rt_fp16) g_psoa.cls_fp16++;
+        if (rs->blend_enable) g_psoa.cls_blend++;
+    }
+}
+
+/* once per frame (render thread): resolve finished jobs, stats */
+static void ld_pso_async_tick(void)
+{
+    if (g_psoa.on != 1) return;
+    for (u32 i = 0; i < g_psoa.n_pending;) {
+        psocache_t* e = &g.psos[g_psoa.pending[i]];
+        if (e->job && e->job->done) {
+            e->pso = ld_pso_job_take(e->job);
+            e->job = NULL;
+            g_psoa.async_done++;
+        }
+        if (!e->job) g_psoa.pending[i] = g_psoa.pending[--g_psoa.n_pending];
+        else i++;
+    }
+    if (g_ld_frames >= g_psoa.stat_frame + 600u) {
+        if (g_psoa.jobs | g_psoa.skips)
+            fprintf(stderr, "[pso-async] frame %u: %llu jobs (%llu back within the wait, %llu later, %llu failed), "
+                    "%llu skipped draws in %llu frames, longest wait %llu frames; skipped by class: depth-only %llu "
+                    "mrt %llu fp16 %llu blend %llu; total %llu jobs %llu skips %llu frames\n",
+                    g_ld_frames, (unsigned long long)g_psoa.jobs, (unsigned long long)g_psoa.sync_done,
+                    (unsigned long long)g_psoa.async_done, (unsigned long long)g_psoa.failed,
+                    (unsigned long long)g_psoa.skips, (unsigned long long)g_psoa.skip_frames,
+                    (unsigned long long)g_psoa.wait_frames_max, (unsigned long long)g_psoa.cls_depth_only,
+                    (unsigned long long)g_psoa.cls_mrt, (unsigned long long)g_psoa.cls_fp16,
+                    (unsigned long long)g_psoa.cls_blend, (unsigned long long)g_psoa.t_jobs,
+                    (unsigned long long)g_psoa.t_skips, (unsigned long long)g_psoa.t_skip_frames);
+        if (g_psoa.sync_builds | g_psoa.sync_waits)
+            fprintf(stderr, "[pso-async] frame %u: scene-change frames (total) %llu; %llu synchronous builds "
+                    "(%llu never-skip class: ui / characters), %llu draws waited for a pending job instead of "
+                    "skipping (%llu taken from the queue; longest wait %.1f ms)\n", g_ld_frames,
+                    (unsigned long long)g_psoa.sync_windows, (unsigned long long)g_psoa.sync_builds,
+                    (unsigned long long)g_psoa.class_sync, (unsigned long long)g_psoa.sync_waits,
+                    (unsigned long long)g_psoa.sync_steals, g_psoa.sync_wait_max_us / 1000.0);
+        g_psoa.sync_builds = g_psoa.sync_waits = g_psoa.sync_steals = g_psoa.class_sync = 0;
+        g_psoa.sync_wait_max_us = 0;
+        g_psoa.jobs = g_psoa.sync_done = g_psoa.async_done = g_psoa.failed = 0;
+        g_psoa.skips = g_psoa.skip_frames = g_psoa.wait_frames_max = 0;
+        g_psoa.cls_depth_only = g_psoa.cls_mrt = g_psoa.cls_fp16 = g_psoa.cls_blend = 0;
+        g_psoa.stat_frame = g_ld_frames;
+    }
+}
+
+/* every pending job finished and resolved (before the in-process cache is dropped) */
+static void ld_pso_async_drain(void)
+{
+    if (g_psoa.on != 1) return;
+    for (u32 i = 0; i < g_psoa.n_pending; i++) {
+        psocache_t* e = &g.psos[g_psoa.pending[i]];
+        if (!e->job) continue;
+        while (!e->job->done) Sleep(1);
+        e->pso = ld_pso_job_take(e->job);
+        e->job = NULL;
+    }
+    g_psoa.n_pending = 0;
+}
+
+/* get_pso hit: the cached PSO, or NULL while its job runs (draw skipped) */
+static ID3D12PipelineState* ld_pso_hit(int i, const render_state_t* rs)
+{
+    psocache_t* e = &g.psos[i];
+    if (e->job) {
+        if (!e->job->done && !g_psoa.mode_all && !ld_pso_burst_frame()) {
+            /* outside a scene-change frame: never skip. A job still in the queue (a scene change queues
+             * ~100) runs here at once instead of after everything queued before it; for one a worker has
+             * started, wait -- the workers run BELOW_NORMAL, so while the render thread is blocked on one
+             * they run at NORMAL and a busy CPU cannot starve that job. */
+            LARGE_INTEGER qf, q0, q1;
+            QueryPerformanceFrequency(&qf);
+            QueryPerformanceCounter(&q0);
+            if (pso_job_unqueue(e->job)) {
+                pso_job_run(e->job, 1);
+                g_psoa.sync_steals++;
+            } else {
+                for (int w = 0; w < g_psoa.workers; w++) SetThreadPriority(g_psoa.wth[w], THREAD_PRIORITY_NORMAL);
+                while (!e->job->done) SwitchToThread();
+                for (int w = 0; w < g_psoa.workers; w++)
+                    SetThreadPriority(g_psoa.wth[w], THREAD_PRIORITY_BELOW_NORMAL);
+            }
+            QueryPerformanceCounter(&q1);
+            const u32 us = (u32)((q1.QuadPart - q0.QuadPart) * 1000000 / qf.QuadPart);
+            if (us > g_psoa.sync_wait_max_us) g_psoa.sync_wait_max_us = us;
+            g_psoa.sync_waits++;
+        }
+        if (!e->job->done) { e->job->skips++; ld_pso_skip_note(rs); return NULL; }
+        e->pso = ld_pso_job_take(e->job);
+        e->job = NULL;
+        g_psoa.async_done++;
+    }
+    return e->pso;
+}
+
+/* ---------------------------------------------------------------------------
+ * Per-draw fast paths (perf round 2026-10). Each has a kill switch:
+ * PS3_<NAME>=0 at start, or PS3_<NAME>_OFF_FILE=<path>: the old path while
+ * <path> exists (checked at most once per frame and every 250 ms).
+ * -----------------------------------------------------------------------*/
+
+/* PS3_DRAW_PCACHE: program analysis caches. get_pso and
+ * ld_current_vertex_layout re-derived everything from the program bytes on
+ * every draw -- the VP size scan (twice), input analysis, word hash and TXL
+ * scan; the FP size scan, structural hash (byte-wise FNV) and inline-constant
+ * collection: ~10 % of the vblank ticker at the Houses spawn view. Each result
+ * is a pure function of the program bytes, so it is kept with a copy of those
+ * bytes and reused while memcmp finds them unchanged (the VP slots change by
+ * upload; the FP lives in guest memory and may be rewritten in place). A hit
+ * is exactly the old computation: the size scans stop at the first END
+ * instruction, which lies inside the compared bytes. */
+static ld_switch g_ld_sw_pcache = { .name = "DRAW_PCACHE" };
+static struct { u64 vp_hit, vp_miss, fp_hit, fp_miss, fp_key_miss, fp_changed; u32 stat_frame; } g_ld_pcache;
+
+/* PS3_DRAW_VERIFY=1 (testing the fast paths, default off): every draw also
+ * runs the old computation next to each fast path and compares -- program
+ * sizes, hashes, masks, FP key and constants, the decoded texture units,
+ * render state, vertex-texture mask and sampler-table hits. Mismatches are
+ * counted ("[perf-draw] verify" every 600 frames) and the first 32 printed.
+ * What is drawn is always the fast path's result. */
+static int ld_verify_on(void)
+{
+    if (g_ld_verify < 0) {
+        const char* e = getenv("PS3_DRAW_VERIFY");
+        g_ld_verify = e && e[0] && e[0] != '0';
+        if (g_ld_verify) fprintf(stderr, "[perf-draw] PS3_DRAW_VERIFY: fast paths cross-checked every draw\n");
+    }
+    return g_ld_verify;
+}
+static void ld_verify(int ok, const char* what, u64 a, u64 b)
+{
+    g_ld_vfy.checks++;
+    if (ok) return;
+    g_ld_vfy.bad++;
+    if (g_ld_vfy.said++ < 32)
+        fprintf(stderr, "[perf-draw] VERIFY MISMATCH frame %u: %s fast=0x%llX old=0x%llX\n",
+                g_ld_frames, what, (unsigned long long)a, (unsigned long long)b);
+}
+
+typedef struct {
+    u32 instrs;          /* 0 = empty way */
+    u32 cap;             /* bytes allocated at words */
+    u8* words;           /* g.rsx.vp bytes [start * 16, (start + instrs) * 16) */
+    u64 hash;            /* ld_hash_words(words, instrs * 16, FNV basis) */
+    u32 input_mask;      /* ld_current_vertex_layout's analysed input mask */
+    u32 txl_mask;        /* vp_txl_unit_mask */
+    u32 epoch;           /* g.rsx.vp_epoch when the words last matched (0 = unknown) */
+    u32 const_need;      /* constants [0, n) the program reads; 512 if it indexes them */
+} ld_vp_entry;
+#define LD_VPC_WAYS 2u
+static ld_vp_entry g_ld_vpc[RSX_DSP_VP_INSTR][LD_VPC_WAYS];
+
+static void ld_vp_analyse(const u8* vp_uc, u32 instrs, ld_vp_entry* e)
+{
+    rsx_vp_input_analysis analysis = {0xFFFFu, 0};
+    if (rsx_vp_analyze_inputs(vp_uc, instrs * 16, &analysis) != (int)instrs ||
+        !analysis.exact)
+        analysis.input_mask = 0xFFFFu;
+    e->instrs = instrs;
+    e->input_mask = analysis.input_mask;
+    e->hash = ld_hash_words(vp_uc, instrs * 16, 1469598103934665603ull);
+    e->txl_mask = vp_txl_unit_mask(vp_uc, instrs);
+    /* constant reads: D1 const_src [12:21] (used as vp_c[const_src & 511]),
+     * D3 bit 1 = indexed (relative) addressing -> any slot */
+    u32 need = 0;
+    for (u32 i = 0; i < instrs && need < RSX_DSP_NUM_CONSTANTS; i++) {
+        const u8* q = vp_uc + i * 16u;
+        u32 d1, d2, d3;
+        memcpy(&d1, q + 4, 4); memcpy(&d2, q + 8, 4); memcpy(&d3, q + 12, 4);
+        const u32 src0 = ((d2 >> 23) & 0x1FFu) | ((d1 & 0xFFu) << 9);
+        const u32 src1 = (d2 >> 6) & 0x1FFFFu;
+        const u32 src2 = ((d3 >> 21) & 0x7FFu) | ((d2 & 0x3Fu) << 11);
+        if ((src0 & 3u) != 3u && (src1 & 3u) != 3u && (src2 & 3u) != 3u) continue;
+        if ((d3 >> 1) & 1u) { need = RSX_DSP_NUM_CONSTANTS; break; }
+        const u32 c = ((d1 >> 12) & 0x3FFu) & 511u;
+        if (c + 1u > need) need = c + 1u;
+    }
+    e->const_need = need ? need : 1u;
+}
+
+/* The program at VP slot `start` (< RSX_DSP_VP_INSTR): 0 = no END bit (the
+ * callers' "no program" path), else *out holds its analysis. */
+static int ld_vp_lookup(u32 start, ld_vp_entry* out)
+{
+    ld_vp_entry* set = g_ld_vpc[start];
+    const u8* vp_uc = (const u8*)(g.rsx.vp + start * 4);
+#if defined(RSX_DSP_HAS_VP_EPOCH)
+    /* The dispatcher bumps vp_epoch whenever a vp[] word changes: an entry
+     * that matched at the current epoch still matches without a compare. */
+    const u32 ep = g.rsx.vp_epoch;
+    if (ep && set[0].instrs && set[0].epoch == ep) {
+        g_ld_pcache.vp_hit++;
+        *out = set[0];
+        return 1;
+    }
+#else
+    const u32 ep = 0;
+#endif
+    for (u32 w = 0; w < LD_VPC_WAYS; w++) {
+        if (set[w].instrs && memcmp(vp_uc, set[w].words, set[w].instrs * 16u) == 0) {
+            set[w].epoch = ep;
+            if (w) { const ld_vp_entry t = set[0]; set[0] = set[w]; set[w] = t; }
+            g_ld_pcache.vp_hit++;
+            *out = set[0];
+            return 1;
+        }
+    }
+    g_ld_pcache.vp_miss++;
+    const u32 instrs = rsx_vp_program_size_instrs(vp_uc, (RSX_DSP_VP_INSTR - start) * 16);
+    if (!instrs) return 0;
+    /* the last way becomes the first: [a b] -> [new a] */
+    ld_vp_entry e = set[LD_VPC_WAYS - 1u];
+    for (u32 w = LD_VPC_WAYS - 1u; w > 0; w--) set[w] = set[w - 1u];
+    if (e.cap < instrs * 16u) {
+        free(e.words);
+        e.words = (u8*)malloc(instrs * 16u);
+        e.cap = e.words ? instrs * 16u : 0;
+    }
+    ld_vp_analyse(vp_uc, instrs, &e);
+    e.epoch = ep;
+    if (e.words) memcpy(e.words, vp_uc, instrs * 16u);
+    else { e.instrs = 0; e.epoch = 0; }   /* no copy: never matches */
+    *out = e;
+    out->instrs = instrs;
+    set[0] = e;
+    return 1;
+}
+
+/* Fragment-program bytes as of the draw being translated. Normally guest
+ * memory; with parallel translation (perf-fifo's PS3_DRAW_PAR) the walker
+ * captures each draw's program (rsx_live_draw_fp_capture: THP8 patches FP
+ * constants in place right before the draws) and the translating thread
+ * hands it in (rsx_live_draw_set_fp_capture) -- then the program at that
+ * (location, offset) is read from the capture only. */
+static struct { u32 loc, off, size; const u8* bytes; } g_ld_fpcap;
+static const u8* ld_fp_src(u32 loc, u32 off, u32 min_bytes)
+{
+    if (g_ld_fpcap.bytes && g_ld_fpcap.loc == loc && g_ld_fpcap.off == off)
+        return min_bytes <= g_ld_fpcap.size ? g_ld_fpcap.bytes : NULL;
+    return guest_ptr(loc, off, min_bytes);
+}
+static u32 ld_fp_src_max(u32 loc, u32 off)
+{
+    return g_ld_fpcap.bytes && g_ld_fpcap.loc == loc && g_ld_fpcap.off == off ? g_ld_fpcap.size : 0x10000u;
+}
+void rsx_live_draw_set_fp_capture(u32 loc, u32 off, const u8* bytes, u32 size)
+{
+    g_ld_fpcap.loc = loc; g_ld_fpcap.off = off;
+    g_ld_fpcap.size = bytes ? size : 0u;
+    g_ld_fpcap.bytes = size ? bytes : NULL;
+}
+u32 rsx_live_draw_fp_capture(u32 loc, u32 off, u8* out, u32 cap)
+{
+    const u8* p = guest_ptr(loc, off, 16);
+    if (!p) return 0;
+    const u32 n = rsx_fp_program_size(p, 0x10000);
+    if (!n || n > cap) return 0;
+    p = guest_ptr(loc, off, n);
+    if (!p) return 0;
+    memcpy(out, p, n);
+    return n;
+}
+
+typedef struct {
+    u32 loc, off, size;  /* size 0 = empty way */
+    u32 cap;             /* bytes allocated at bytes (program + constants) */
+    u8* bytes;           /* guest program bytes [off, off + size) */
+    u32 (*consts)[4];    /* rsx_fp_collect_constants values (after bytes) */
+    int nconst;          /* its return value (< 0: collection failed) */
+    u16* cslot;          /* 16-byte slot of each inline constant (after consts); NULL = none known */
+    u32 nkeys;
+    u64 seed[4], key[4]; /* get_pso's FP key step per VP-hash seed, MRU first */
+} ld_fp_entry;
+#define LD_FPC_SETS 512u
+#define LD_FPC_WAYS 2u
+static ld_fp_entry g_ld_fpc[LD_FPC_SETS][LD_FPC_WAYS];
+
+static ld_fp_entry* ld_fp_set(u32 loc, u32 off)
+{
+    return g_ld_fpc[(u32)ld_fmix64(((u64)loc << 32) | off) & (LD_FPC_SETS - 1u)];
+}
+
+/* The cached entry of the FP at (loc, off) if guest memory still holds the
+ * same bytes; *uc gets the guest pointer. NULL: take the uncached path. */
+static ld_fp_entry* ld_fp_lookup(u32 loc, u32 off, const u8** uc)
+{
+    ld_fp_entry* set = ld_fp_set(loc, off);
+    for (u32 w = 0; w < LD_FPC_WAYS; w++) {
+        ld_fp_entry* e = &set[w];
+        if (!e->size || e->loc != loc || e->off != off) continue;
+        const u8* p = ld_fp_src(loc, off, e->size);
+        if (!p) { g_ld_pcache.fp_changed++; break; }
+        if (memcmp(p, e->bytes, e->size) == 0) {
+            /* unchanged, constants included: e->consts match (invariant) */
+        } else if (e->cslot && ld_fp_constants_buffered()) {
+            /* Titles patch fragment-program constants in place (one program,
+             * many materials): compare only the instruction slots. They
+             * decide where every constant slot and the END are, and they are
+             * all the structural key hashes; a changed constant slot is
+             * re-read from the guest bytes, exactly as rsx_fp_collect_constants
+             * does, and copied into e->bytes (invariant: e->consts[k] is the
+             * conversion of e->bytes' constant slot k). */
+            u32 prev = 0, k = 0;
+            const u32 nslot = e->size / 16u;
+            for (; k < (u32)e->nconst; k++) {
+                const u32 c = e->cslot[k];
+                if (c > prev && memcmp(p + prev * 16u, e->bytes + prev * 16u, (c - prev) * 16u) != 0) break;
+                prev = c + 1u;
+            }
+            if (k < (u32)e->nconst ||
+                (nslot > prev && memcmp(p + prev * 16u, e->bytes + prev * 16u, (nslot - prev) * 16u) != 0)) {
+                g_ld_pcache.fp_changed++; break;
+            }
+            for (k = 0; k < (u32)e->nconst; k++) {
+                const u8* q = p + (u32)e->cslot[k] * 16u;
+                u8* raw = e->bytes + (u32)e->cslot[k] * 16u;
+                if (memcmp(q, raw, 16) == 0) continue;
+                memcpy(raw, q, 16);
+                for (u32 cc = 0; cc < 4; cc++)
+                    e->consts[k][cc] = rsx_fp_sanitize_constant_word(rsx_fp_read_word(q + cc * 4u));
+            }
+        } else { g_ld_pcache.fp_changed++; break; }
+        if (w) { const ld_fp_entry t = set[0]; set[0] = *e; *e = t; }
+        g_ld_pcache.fp_hit++;
+        *uc = p;
+        return &set[0];
+    }
+    g_ld_pcache.fp_miss++;
+    return NULL;
+}
+
+/* Remember the FP at (loc, off) = uc[0, size) and its collected constants
+ * (rsx_fp_collect_constants' return value n and block c). */
+static ld_fp_entry* ld_fp_insert(u32 loc, u32 off, const u8* uc, u32 size, int n,
+                                 const rsx_fp_constant_block* c)
+{
+    ld_fp_entry* set = ld_fp_set(loc, off);
+    u32 w = 0;
+    while (w < LD_FPC_WAYS - 1u && !(set[w].size && set[w].loc == loc && set[w].off == off)) w++;
+    ld_fp_entry e = set[w];   /* the same program's old way, else the last */
+    for (; w > 0; w--) set[w] = set[w - 1u];
+    const u32 nc = n > 0 ? (u32)n : 0u;
+    const u32 need = ((size + 15u) & ~15u) + nc * 16u + nc * 2u;
+    if (e.cap < need) {
+        free(e.bytes);
+        e.bytes = (u8*)malloc(need);
+        e.cap = e.bytes ? need : 0;
+    }
+    e.size = 0;
+    e.nkeys = 0;
+    if (e.bytes) {
+        memcpy(e.bytes, uc, size);
+        e.consts = (u32 (*)[4])(e.bytes + ((size + 15u) & ~15u));
+        if (nc) memcpy(e.consts, c->values, nc * 16u);
+        e.loc = loc; e.off = off; e.size = size; e.nconst = n;
+        /* constant slot positions for the structure compare (lookup) */
+        e.cslot = (u16*)((u8*)e.consts + nc * 16u);
+        if (n < 0 || rsx_fp_constant_slots(uc, size, e.cslot, nc) != n) e.cslot = NULL;
+    }
+    set[0] = e;
+    return set[0].size ? &set[0] : NULL;
+}
+
+/* get_pso's FP key step: rsx_fp_structural_hash (buffered constants) or the
+ * byte FNV (literal) of the program, seeded with the VP key hash. */
+static u64 ld_fp_key(ld_fp_entry* e, u64 seed)
+{
+    for (u32 i = 0; i < e->nkeys; i++) {
+        if (e->seed[i] != seed) continue;
+        const u64 k = e->key[i];
+        for (; i > 0; i--) { e->seed[i] = e->seed[i - 1]; e->key[i] = e->key[i - 1]; }
+        e->seed[0] = seed; e->key[0] = k;
+        return k;
+    }
+    g_ld_pcache.fp_key_miss++;
+    const u64 k = ld_fp_constants_buffered()
+        ? rsx_fp_structural_hash(e->bytes, e->size, seed)
+        : fnv1a(e->bytes, e->size, seed);
+    u32 i = e->nkeys < 4u ? e->nkeys++ : 3u;
+    for (; i > 0; i--) { e->seed[i] = e->seed[i - 1]; e->key[i] = e->key[i - 1]; }
+    e->seed[0] = seed; e->key[0] = k;
+    return k;
+}
+
+/* PS3_DRAW_ONCE: per-draw state decoded once per draw instead of up to four
+ * times. The 16 fragment texture units (get_pso walked all of them twice and
+ * the bind loop once, each unit through rsx_dsp_get_texture) are decoded once
+ * before get_pso, and only the enabled ones: every consumer skips a disabled
+ * unit. get_pso's render state and vertex-texture mask are reused by the
+ * zeta-view bind test, the bind loop and the depth bookkeeping after the draw.
+ * The FIFO walker runs on this thread, so no register changes inside
+ * sink_end_impl; `valid` is cleared at its start and set before get_pso. */
+static ld_switch g_ld_sw_once = { .name = "DRAW_ONCE" };
+/* PS3_DRAW_TABLES: descriptor tables -- sampler_table's hash index and
+ * srv_table's reuse of an identical table (see there). */
+static ld_switch g_ld_sw_tables = { .name = "DRAW_TABLES" };
+/* PS3_DRAW_SAMPLED: the bind loop resolves only the texture units the fragment
+ * program samples (TEX/TXP/TXD/TXB/TXL, rsx_fp_texture_unit_masks -- the
+ * mask the PSO key already trusts). An enabled unit the program never reads
+ * (THP8 leaves shadow / DOF units enabled across passes) binds white + the
+ * default sampler, as a disabled unit does: RSX never fetches it, so the
+ * frame is the same, but no texture decode / hash, surface feedback copy or
+ * depth snapshot is done for it, and more draws share descriptor tables. */
+static ld_switch g_ld_sw_sampled = { .name = "DRAW_SAMPLED" };
+static u64 g_ld_unsampled_skips;
+/* PS3_DRAW_CBTRIM: upload only the transform constants the VP reads
+ * (ld_vp_analyse const_need; 512 when it indexes them). */
+static ld_switch g_ld_sw_cbtrim = { .name = "DRAW_CBTRIM" };
+static u64 g_ld_cbtrim_bytes;
+/* PS3_DRAW_SHADOW: command-list state shadow (g_ld_cl, see ld_flush). */
+static ld_switch g_ld_sw_shadow = { .name = "DRAW_SHADOW" };
+static struct {
+    int valid, rs_valid, vtex_valid;
+    u32 tex_mask;                              /* enabled fragment units */
+    u32 vtex_mask;
+    render_state_t rs;
+    rsx_dsp_texture tex[RSX_DSP_NUM_TEXTURES];
+} g_ld_once;
+
+/* PS3_DRAW_PSCB (ld_upload_pixel_constants) state, declared here for the stats. */
+static ld_switch g_ld_sw_pscb = { .name = "DRAW_PSCB" };
+static u32 g_ld_pscb_epoch = 1;   /* bumped whenever ps_cb_used is reset */
+#define LD_PSCB_MAX_SLOTS 256u
+static struct {
+    u32 epoch, offset, slots;      /* slots = value slots + 2 (alpha, wpos); 0 = none */
+    u32 data[(LD_PSCB_MAX_SLOTS + 2u) * 4u];
+    u64 reused, uploaded;
+} g_ld_pscb;
+
+static int ld_surface_may_exist(u32 location, u32 offset)
+{
+    if (g_ld_surf_filter.gen != g_ld_surf_addr_gen || g_ld_surf_filter.n != g.n_surfaces) {
+        memset(g_ld_surf_filter.bits, 0, sizeof(g_ld_surf_filter.bits));
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            const u32 b = ld_surf_bit(g.surfaces[i].location, g.surfaces[i].offset);
+            g_ld_surf_filter.bits[b >> 6] |= 1ull << (b & 63u);
+        }
+        g_ld_surf_filter.gen = g_ld_surf_addr_gen;
+        g_ld_surf_filter.n = g.n_surfaces;
+    }
+    const u32 b = ld_surf_bit(location, offset);
+    return (int)((g_ld_surf_filter.bits[b >> 6] >> (b & 63u)) & 1u);
+}
+
+/* Every 600 frames: program-cache hit rates (per frame). */
+static void ld_perfdraw_stats(void)
+{
+    if (g_ld_frames < g_ld_pcache.stat_frame + 600u) return;
+    const u32 frames = g_ld_frames - g_ld_pcache.stat_frame;
+    g_ld_pcache.stat_frame = g_ld_frames;
+    if (!frames || !(g_ld_pcache.vp_hit | g_ld_pcache.vp_miss)) return;
+    fprintf(stderr, "[perf-draw] frame %u: per frame VP %.1f hit %.1f miss, FP %.1f hit %.1f miss "
+            "(%.1f key misses)\n", g_ld_frames,
+            (double)g_ld_pcache.vp_hit / frames, (double)g_ld_pcache.vp_miss / frames,
+            (double)g_ld_pcache.fp_hit / frames, (double)g_ld_pcache.fp_miss / frames,
+            (double)g_ld_pcache.fp_key_miss / frames);
+    fprintf(stderr, "[perf-draw] frame %u: per frame SRV tables %.1f reused %.1f built; "
+            "list state calls %.1f skipped %.1f recorded\n", g_ld_frames,
+            (double)g_ld_srvt.reused / frames, (double)g_ld_srvt.built / frames,
+            (double)g_ld_cl_skipped / frames, (double)g_ld_cl_recorded / frames);
+    g_ld_srvt.reused = g_ld_srvt.built = 0;
+    fprintf(stderr, "[perf-draw] frame %u: per frame %.0f KB transform constants uploaded\n",
+            g_ld_frames, (double)g_ld_cbtrim_bytes / 1024.0 / frames);
+    g_ld_cbtrim_bytes = 0;
