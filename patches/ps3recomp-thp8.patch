+/* ===========================================================================
+ * Idle-poll parking (perf; see spu_llar_park / the SPURS select intercept).
+ *
+ * An SPU that polls a line nobody is writing burns a whole host core: on the
+ * console it is one dedicated SPE, here it is a host thread competing with the
+ * PPU threads that would eventually post the work. Two parking primitives:
+ *
+ *  - spu_coh_resv_park: the caller holds a VALID reservation on a line it has
+ *    just re-read unchanged (a GETLLAR spin). Sleep until that reservation is
+ *    lost -- every coherent writer (PPU store / stwcx / cellSync HLE, peer SPU
+ *    PUTLLC / PUTLLUC / DMA PUT) clears resv_valid in spu_coh_notify_write* and
+ *    now wakes the address -- or until the timeout (the safety net for a writer
+ *    that bypasses the coherence hooks).
+ *
+ *  - spu_coh_watch_park: the caller holds NO reservation (a SPURS policy module
+ *    between two empty polls). Register a watch on a line and sleep until a
+ *    write by someone OTHER than the watcher's own peers (same tag = the other
+ *    lanes of the same policy module, whose lock traffic must not wake it or
+ *    the lanes ping-pong each other awake forever), a kick from a lane that
+ *    found work, or the timeout.
+ *
+ * WaitOnAddress compares-and-sleeps atomically against WakeByAddress*, so a
+ * write that lands between the caller's check and the sleep is never lost.
+ * It is resolved from kernelbase.dll at run time (Windows 8+), so neither the
+ * clang-cl nor the MinGW/zig build needs synchronization.lib at link time.
+ * Where it is unavailable (POSIX, or resolution failed) both parks degrade to
+ * a plain yield: no wake path to miss, just less CPU saved.
+ *
+ * Writers that do NOT come through spu_coh_notify_write* and so cannot wake a
+ * parked line before its timeout (all bounded by SPU_LLAR_PARK_MS /
+ * SPURS_PM_IDLE_MS): lifted PPU vector stores (stvx & co. are emitted as raw
+ * memcpy into vm_base), raw-pointer HLE writes (e.g. cellSpurs' own
+ * readyCount/state bytes), RSX/host writes into main memory, and any SPU context
+ * beyond the SPU_COH_MAX_CTX registry (spu_coh_resv_park refuses to park those).
+ * ===========================================================================*/
+#define SPU_COH_MAX_WATCH 16
+static struct { spu_context* ctx; uint32_t line; int tag; volatile long hit; } s_watch[SPU_COH_MAX_WATCH];
+/* Live watches; notify skips the scan at 0. Written under the lock-line lock,
+ * read unlocked by the kick (a stale read costs one scan or one missed kick). */
+static volatile long s_watch_n;
+/* Tag of the SPU whose write is being notified (0 = PPU / HLE / unknown). Only
+ * ever written and read under the lock-line lock, like everything notify does. */
+static int s_coh_writer_tag;
+unsigned long g_spu_park_n = 0, g_spu_park_wake = 0;   /* diagnostics */
