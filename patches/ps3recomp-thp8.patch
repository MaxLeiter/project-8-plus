+static void ld_texrepl_bind(u32 index, texcache_t* entry)
+{
+    texrepl_view v;
+    /* PS3_DCL: no list unless its upload copies must be recorded now (drain first) */
+    int got = texrepl_acquire((int)entry->repl - 1, g_dcl.on ? NULL : g.list, &v);
+    if (!got && g_dcl.on && texrepl_wants_list((int)entry->repl - 1)) {
+        ld_dcl_sync();
+        ld_dcl_check_idle("texrepl");
+        got = texrepl_acquire((int)entry->repl - 1, g.list, &v);
+    }
+    if (got) {
+        if (entry->repl_gen != v.gen) {
+            ld_texrepl_write_srv(index, entry, &v);
+            entry->repl_gen = v.gen;
+            entry->repl_shift_fx = v.shift_fx;
