+
+/* ---- root signature resolution: WGS_L_BIND entries for the current tables / root views / constants */
+#define WGS_CPOOL_BYTES (16u << 20)
+static wgs_resource* s_cpool;                     /* root constants land here (an upload buffer) */
+static u32 s_cpool_at;
+static pthread_mutex_t s_cpool_lock = PTHREAD_MUTEX_INITIALIZER;
+static u32 cpool_put(const u32* v, u32 n)
+{
+    pthread_mutex_lock(&s_cpool_lock);
+    if (!s_cpool) {
+        D3D12_RESOURCE_DESC d; memset(&d, 0, sizeof d);
+        d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; d.Width = WGS_CPOOL_BYTES; d.Height = 1; d.DepthOrArraySize = 1;
+        d.MipLevels = 1; d.SampleDesc.Count = 1; d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        s_cpool = resource_new(&d, D3D12_HEAP_TYPE_UPLOAD);
+    }
+    if (s_cpool_at + 256 > WGS_CPOOL_BYTES) {
+        /* wrap: everything posted so far must have been consumed (the worker copies UPLOAD data at once) */
+        const u32 h = s_ring.head;
+        while ((int)(__atomic_load_n(&s_ring.tail, __ATOMIC_ACQUIRE) - h) < 0) wgs_wait32(&s_ring.tail, s_ring.tail, 1000000);
+        s_cpool_at = 0;
+    }
+    const u32 off = s_cpool_at;
+    memcpy(s_cpool->shadow + off, v, n * 4);
+    s_cpool_at += 256;
+    pthread_mutex_unlock(&s_cpool_lock);
+    wgs_hint_written(&s_cpool->iface, off, 256);
+    return off;
+}
