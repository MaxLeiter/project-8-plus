+"""ref_fp.py - reference semantics for the scalar FPU (PowerISA v2.02 Book I
+chapter 4) as implemented by the Cell PPU: IEEE-754 binary64 with full
+denormal support (FPSCR[NI]=0), single-precision forms that round the exact
+result directly to binary32, fused multiply-add, and the bit-exact
+single<->double conversions of lfs/stfs.
+
+All arithmetic is exact (Python integers / rationals) followed by ONE rounding
+under FPSCR[RN]; nothing here uses host floating point.
+"""
+from __future__ import annotations
+
+from ppcref import MASK32, MASK64, Undefined, spec, add_spec, s64
+
+FP = ("fp",)
+
+KNOWN_DEVIATIONS = {
+    "fpscr-status": "the lifter does not model FPSCR status bits (FX FEX VX* OX UX ZX XX "
+                    "FR FI FPRF) or CR1 of Rc=1 forms; THP8 reads FPSCR only through "
+                    "fegetround (& 3).",
+    "fpscr-control": "mtfsf/mtfsfi/mtfsb0/mtfsb1 are ignored and arithmetic always rounds "
+                     "to nearest-even; THP8 has one mtfsf (libm fesetenv) and never "
+                     "selects another rounding mode on any observed path.",
+    "fp-estimate": "fres/frsqrte return the exact reciprocal (root); Cell returns a "
+                   "table-based estimate within the ISA bound (RPCS3 replicates the "
+                   "hardware tables).",
+    "nan-payload-single": "a NaN produced by a single-precision op or frsp keeps its low 29 "
+                          "payload bits (ISA frsp model: FRB[0:34] || 29 zeros). Cosmetic; "
+                          "tests/guest/gen_vectors.py KATs encode the current behaviour.",
+}
+
+# ---------------------------------------------------------------------------
+# IEEE helpers on raw bit patterns
+# ---------------------------------------------------------------------------
+
+DBL = (53, -1022, 1023)        # precision, emin, emax
+SGL = (24, -126, 127)
+
+QNAN64 = 0x7FF8000000000000
+FRAC52 = (1 << 52) - 1
+
+
+def isnan(b):
+    return (b >> 52) & 0x7FF == 0x7FF and b & FRAC52
+
+
+def isinf(b):
+    return (b & ~(1 << 63) & MASK64) == 0x7FF0000000000000
+
+
+def iszero(b):
+    return (b & ~(1 << 63) & MASK64) == 0
+
+
+def sign(b):
+    return b >> 63
+
+
+def value(b):
+    """finite b -> (sign, mantissa, exp2) with |v| = mantissa * 2**exp2."""
+    e = (b >> 52) & 0x7FF
+    m = b & FRAC52
+    if e == 0:
+        return b >> 63, m, -1074
+    return b >> 63, m | (1 << 52), e - 1075
+
+
+def quiet(b, single=False):
+    q = b | (1 << 51)
+    if single:
+        # a NaN result of a single-precision operation is in single format
+        # (frsp model: FRT <- FRB[0:34] || 29 zeros, with the quiet bit set)
+        q &= ~((1 << 29) - 1) & MASK64
+    return q
+
+
+def f32_to_f64(w):
+    """lfs conversion (Book I 4.6.2): exact, keeps SNaN payloads."""
+    s = w >> 31
+    e = (w >> 23) & 0xFF
+    m = w & 0x7FFFFF
+    if e == 0xFF:
+        return (s << 63) | (0x7FF << 52) | (m << 29)
+    if e == 0:
+        if m == 0:
+            return s << 63
+        sh = 0
+        while not (m & 0x800000):
+            m <<= 1
+            sh += 1
+        m &= 0x7FFFFF
+        return (s << 63) | ((1 - sh - 127 + 1023) << 52) | (m << 29)
+    return (s << 63) | ((e - 127 + 1023) << 52) | (m << 29)
+
+
+def f64_to_f32_store(b):
+    """stfs conversion (Book I 4.6.3). Returns (word, defined)."""
+    e = (b >> 52) & 0x7FF
+    if e > 896 or (b & ~(1 << 63) & MASK64) == 0:
+        return ((b >> 32) & 0xC0000000) | ((b >> 29) & 0x3FFFFFFF), True
+    if 874 <= e <= 896:
+        sgn = b >> 63
+        exp = e - 1023
+        frac = (1 << 52) | (b & FRAC52)          # 1.fraction, 52 fraction bits
+        while exp < -126:
+            frac >>= 1
+            exp += 1
+        return (sgn << 31) | ((frac >> 29) & 0x7FFFFF), True
+    return 0, False
+
+
+def _encode(sgn, q, e, fmt):
+    """q in [0, 2^p), unbiased exponent e of the leading bit position p-1
+    (q < 2^(p-1) means denormal with e == emin). Returns raw bits of fmt."""
+    p, emin, emax = fmt
+    if fmt is DBL:
+        bias, fb, eb = 1023, 52, 11
+    else:
+        bias, fb, eb = 127, 23, 8
+    if q < (1 << (p - 1)):
+        return (sgn << (fb + eb)) | q
+    return (sgn << (fb + eb)) | ((e + bias) << fb) | (q - (1 << (p - 1)))
+
+
+def _maxfin(sgn, fmt):
+    p, emin, emax = fmt
+    return _encode(sgn, (1 << p) - 1, emax, fmt)
+
+
+def _inf(sgn, fmt):
+    return (sgn << 63) | 0x7FF0000000000000 if fmt is DBL else (sgn << 31) | 0x7F800000
+
+
+def round_rat(sgn, num, den, fmt, rn):
+    """Round sgn * num/den (num, den > 0) to fmt under rounding mode rn
+    (0 nearest-even, 1 toward 0, 2 toward +inf, 3 toward -inf).
+    Returns raw bits in fmt."""
+    p, emin, emax = fmt
+    k = num.bit_length() - den.bit_length()
+    if k >= 0:
+        if num < den << k:
+            k -= 1
+    else:
+        if num << -k < den:
+            k -= 1
+    e = max(k, emin)
+    sh = (p - 1) - e
+    if sh >= 0:
+        q, r = divmod(num << sh, den)
+        d = den
+    else:
+        q, r = divmod(num, den << -sh)
+        d = den << -sh
+    if r:
+        if rn == 0:
+            up = 2 * r > d or (2 * r == d and q & 1)
+        elif rn == 1:
+            up = False
+        elif rn == 2:
+            up = sgn == 0
+        else:
+            up = sgn == 1
+        if up:
+            q += 1
+    if q == 1 << p:
+        q >>= 1
+        e += 1
+    if q >= (1 << (p - 1)) and e > emax:
+        if rn == 0 or (rn == 2 and sgn == 0) or (rn == 3 and sgn == 1):
+            return _inf(sgn, fmt)
+        return _maxfin(sgn, fmt)
+    return _encode(sgn, q, e, fmt)
+
+
+def to_fpr(bits, fmt):
+    return bits if fmt is DBL else f32_to_f64(bits)
+
+
+def round_to_fpr(sgn, num, den, fmt, rn):
+    return to_fpr(round_rat(sgn, num, den, fmt, rn), fmt)
+
+
+def zero(sgn):
+    return sgn << 63
+
+
+def rat(b):
+    """finite -> (num, den) signed rational (num may be negative)."""
+    s, m, e = value(b)
+    if e >= 0:
+        n, d = m << e, 1
+    else:
+        n, d = m, 1 << -e
+    return (-n if s else n), d
+
+
+# ---------------------------------------------------------------------------
+# operations (inputs/outputs raw u64 FPR bit patterns)
+# ---------------------------------------------------------------------------
+
+def _finish_sum(n, d, zsign_if_exact_zero, fmt, rn):
+    if n == 0:
+        return zero(zsign_if_exact_zero)
+    sg = 1 if n < 0 else 0
+    return round_to_fpr(sg, abs(n), d, fmt, rn)
+
+
+def op_add(a, b, fmt, rn, negb=False):
+    single = fmt is SGL
+    if isnan(a):
+        return quiet(a, single)
+    if isnan(b):
+        return quiet(b, single)
+    if negb:
+        b ^= 1 << 63
+    if isinf(a) or isinf(b):
+        if isinf(a) and isinf(b) and sign(a) != sign(b):
+            return QNAN64
+        return a if isinf(a) else b
+    na, da = rat(a)
+    nb, db = rat(b)
+    n = na * db + nb * da
+    d = da * db
+    if n == 0:
+        if iszero(a) and iszero(b) and sign(a) == sign(b):
+            return zero(sign(a))
+        return zero(1 if rn == 3 else 0)
+    return _finish_sum(n, d, 0, fmt, rn)
+
+
+def op_mul(a, c, fmt, rn):
+    single = fmt is SGL
+    if isnan(a):
+        return quiet(a, single)
+    if isnan(c):
+        return quiet(c, single)
+    sg = sign(a) ^ sign(c)
+    if isinf(a) or isinf(c):
+        if iszero(a) or iszero(c):
+            return QNAN64
+        return (sg << 63) | 0x7FF0000000000000
+    if iszero(a) or iszero(c):
+        return zero(sg)
+    na, da = rat(a)
+    nc, dc = rat(c)
+    return round_to_fpr(sg, abs(na * nc), da * dc, fmt, rn)
+
+
+def op_div(a, b, fmt, rn):
+    single = fmt is SGL
+    if isnan(a):
+        return quiet(a, single)
+    if isnan(b):
+        return quiet(b, single)
+    sg = sign(a) ^ sign(b)
+    if isinf(a):
+        if isinf(b):
+            return QNAN64
+        return (sg << 63) | 0x7FF0000000000000
+    if isinf(b):
+        return zero(sg)
+    if iszero(b):
+        if iszero(a):
+            return QNAN64
+        return (sg << 63) | 0x7FF0000000000000
+    if iszero(a):
+        return zero(sg)
+    na, da = rat(a)
+    nb, db = rat(b)
+    return round_to_fpr(sg, abs(na) * db, abs(nb) * da, fmt, rn)
+
+
+def op_fma(a, c, b, fmt, rn, negb, negr):
+    """(negr ? -1 : 1) * (a*c + (negb ? -b : b)), one rounding.
+    NaN priority FRA, FRB, FRC; NaN results are never negated."""
+    single = fmt is SGL
+    if isnan(a):
+        return quiet(a, single)
+    if isnan(b):
+        return quiet(b, single)
+    if isnan(c):
+        return quiet(c, single)
+    if negb:
+        b ^= 1 << 63
+    ps = sign(a) ^ sign(c)
+    pinf = isinf(a) or isinf(c)
+    if pinf and (iszero(a) or iszero(c)):
+        return QNAN64
+    if pinf:
+        if isinf(b) and sign(b) != ps:
+            return QNAN64
+        r = (ps << 63) | 0x7FF0000000000000
+    elif isinf(b):
+        r = b
+    else:
+        pzero = iszero(a) or iszero(c)
+        if pzero:
+            pn, pd = 0, 1
+        else:
+            na, da = rat(a)
+            nc, dc = rat(c)
+            pn, pd = na * nc, da * dc
+        nb, db = rat(b)
+        n = pn * db + nb * pd
+        d = pd * db
+        if n == 0:
+            if pzero and iszero(b) and ps == sign(b):
+                r = zero(ps)
+            else:
+                r = zero(1 if rn == 3 else 0)
+        else:
+            r = _finish_sum(n, d, 0, fmt, rn)
+    if negr:
+        r ^= 1 << 63
+    return r
+
+
+def op_frsp(b, rn):
+    if isnan(b):
+        return quiet(b, True)
+    if isinf(b) or iszero(b):
+        return b
+    n, d = rat(b)
+    return round_to_fpr(sign(b), abs(n), d, SGL, rn)
+
+
+def _isqrt(n):
+    import math
+    return math.isqrt(n)
+
+
+def op_sqrt(b, fmt, rn):
+    single = fmt is SGL
+    if isnan(b):
+        return quiet(b, single)
+    if iszero(b):
+        return b
+    if sign(b):
+        return QNAN64
+    if isinf(b):
+        return b
+    _, m, e = value(b)
+    if e & 1:
+        m <<= 1
+        e -= 1
+    # sqrt(m * 2^e) = sqrt(m << 2s) * 2^(e/2 - s); want >= 60 significant bits
+    s = max(0, (130 - m.bit_length()) // 2)
+    N = m << (2 * s)
+    q = _isqrt(N)
+    ex = e // 2 - s
+    if q * q == N:
+        num, den = q, 1
+    else:
+        num, den = 2 * q + 1, 2          # strictly inside (q, q+1): same rounding
+    if ex >= 0:
+        num <<= ex
+    else:
+        den <<= -ex
+    return round_to_fpr(0, num, den, fmt, rn)
+
+
+def op_cvt_int(b, bits, rn, trunc):
+    """fctiw/fctid: returns the integer bit pattern (u32 / u64)."""
+    lo, hi = -(1 << (bits - 1)), (1 << (bits - 1)) - 1
+    if isnan(b):
+        return 1 << (bits - 1)
+    if isinf(b):
+        return (hi if not sign(b) else lo) & ((1 << bits) - 1)
+    n, d = rat(b)
+    q = abs(n) // d
+    r = abs(n) - q * d
+    neg = n < 0
+    mode = 1 if trunc else rn
+    if r:
+        if mode == 0:
+            up = 2 * r > d or (2 * r == d and q & 1)
+        elif mode == 1:
+            up = False
+        elif mode == 2:
+            up = not neg
+        else:
+            up = neg
+        if up:
+            q += 1
+    v = -q if neg else q
+    v = max(lo, min(hi, v))
+    return v & ((1 << bits) - 1)
+
+
+def op_cfid(b, rn):
+    v = s64(b)
+    if v == 0:
+        return 0
+    return round_to_fpr(1 if v < 0 else 0, abs(v), 1, DBL, rn)
+
+
+# ---------------------------------------------------------------------------
+# specs
+# ---------------------------------------------------------------------------
+
+def _rn(s):
+    return s.fpscr & 3
+
+
+def _status(s):
+    # status bits are unmodeled by the lifter (KNOWN_DEVIATIONS['fpscr-status'])
+    s.dontcare("fpscr", 0xFFFFFF00)
+
+
+def _rc1(s, f):
+    if f.rc:
+        s.dontcare("cr", 0xF << 24)       # CR1 <- FX FEX VX OX
+
+
+def _dr_setup(s, f, rng, ea):
+    """Sometimes load FRA/FRC/FRB with single-precision operands whose exact
+    a*c+b lies just below a single-precision tie with an odd lower neighbour:
+    rounding the fused result to double first lands ON the tie, and the
+    second rounding then goes the wrong way (double rounding)."""
+    if rng.random() < 0.25:
+        k = rng.randrange(-30, 30)
+        a = (1.0 - 2.0 ** -18) * 2.0 ** (k - 24)
+        c = 1.0 + 2.0 ** -18
+        b = (1.0 + 2.0 ** -23) * 2.0 ** k
+        if rng.random() < 0.5:
+            b = -b
+            a = -a
+        import struct as _st
+        bits = lambda x: _st.unpack("<Q", _st.pack("<d", x))[0]
+        s.fpr[f.ra], s.fpr[f.frc], s.fpr[f.rb] = bits(a), bits(c), bits(b)
+
+
+def _single_nan_dc(s, f, op):
+    if op == 59 and isnan(s.fpr[f.rt]):
+        s.dontcare(("fpr", f.rt), (1 << 29) - 1)
+        s.notes.append("nan-payload-single")
+
+
+def _single_ok(b):
+    """representable in single format (NaN/inf/zero count as representable)"""
+    if isnan(b):
+        return True
+    return f32_to_f64(f64_to_f32_store(b)[0]) == b
+
+
+def _a_form(name, op, xo, fn, uses=("a", "b"), fixed=None, setup=None):
+    # Book I 4.3.5.1: every input of a single-precision ARITHMETIC instruction
+    # (op 59 except the estimate fres) must be representable in single format,
+    # otherwise the result, FPSCR and CR1 are undefined.
+    single_arith = op == 59 and name != "fres"
+    for rc in (0, 1):
+        def sem(s, f):
+            if single_arith:
+                regs = {"a": f.ra, "b": f.rb, "c": f.frc}
+                undefined = not all(_single_ok(s.fpr[regs[u]]) for u in uses)
+            fn(s, f)
+            _single_nan_dc(s, f, op)
+            _status(s)
+            _rc1(s, f)
+            if single_arith and undefined:
+                s.dontcare(("fpr", f.rt), MASK64)
+                s.notes.append("single-input-undefined")
+        fx = {"rc": rc}
+        fx.update(fixed or {})
+        tags = FP + (("single",) if op == 59 else ())
+        add_spec(name + ("." if rc else ""), "A", op, xo, sem, fixed=fx, setup=setup, tags=tags)
+
+
+# binary ops: fadd/fsub/fmul/fdiv (A-form; fmul uses FRC instead of FRB)
+for _op, _fmt, _sfx in ((63, DBL, ""), (59, SGL, "s")):
+    _a_form("fadd" + _sfx, _op, 21,
+            lambda s, f, fmt=_fmt: s.fpr.__setitem__(f.rt, op_add(s.fpr[f.ra], s.fpr[f.rb], fmt, _rn(s))),
+            uses=("a", "b"), fixed={"frc": 0})
+    _a_form("fsub" + _sfx, _op, 20,
+            lambda s, f, fmt=_fmt: s.fpr.__setitem__(f.rt, op_add(s.fpr[f.ra], s.fpr[f.rb], fmt, _rn(s), negb=True)),
+            fixed={"frc": 0})
+    _a_form("fmul" + _sfx, _op, 25,
+            lambda s, f, fmt=_fmt: s.fpr.__setitem__(f.rt, op_mul(s.fpr[f.ra], s.fpr[f.frc], fmt, _rn(s))),
+            uses=("a", "c"), fixed={"rb": 0})
+    _a_form("fdiv" + _sfx, _op, 18,
+            lambda s, f, fmt=_fmt: s.fpr.__setitem__(f.rt, op_div(s.fpr[f.ra], s.fpr[f.rb], fmt, _rn(s))),
+            fixed={"frc": 0})
+    _a_form("fsqrt" + _sfx, _op, 22,
+            lambda s, f, fmt=_fmt: s.fpr.__setitem__(f.rt, op_sqrt(s.fpr[f.rb], fmt, _rn(s))),
+            uses=("b",), fixed={"frc": 0, "ra": 0})
+    for _nm, _xo_, _nb, _nr in (("fmadd", 29, 0, 0), ("fmsub", 28, 1, 0),
+                                ("fnmadd", 31, 0, 1), ("fnmsub", 30, 1, 1)):
+        _a_form(_nm + _sfx, _op, _xo_,
+                lambda s, f, fmt=_fmt, nb=_nb, nr=_nr: s.fpr.__setitem__(
+                    f.rt, op_fma(s.fpr[f.ra], s.fpr[f.frc], s.fpr[f.rb], fmt, _rn(s), nb, nr)),
+                uses=("a", "b", "c"), setup=_dr_setup if _fmt is SGL else None)
+
+
+def _fsel(s, f):
+    a = s.fpr[f.ra]
+    ge = not isnan(a) and (iszero(a) or not sign(a))
+    s.fpr[f.rt] = s.fpr[f.frc] if ge else s.fpr[f.rb]
+
+
+_a_form("fsel", 63, 23, _fsel)
+
+
+def _est_checker(exact_bits, rel, single, true_value=None):
+    """accept an estimate within `rel` relative error of the exact result
+    (of `true_value`, the unrounded Fraction, when given -- the ISA bound is
+    on the infinitely precise result, and measuring against the single-
+    rounded value instead rejected estimates exactly at the bound);
+    special values (inf/zero/NaN results) must match exactly."""
+    from fractions import Fraction
+
+    def chk(got):
+        if exact_bits == got:
+            return None
+        if isnan(exact_bits) or isinf(exact_bits) or iszero(exact_bits):
+            return "special"
+        if isnan(got) or isinf(got) or iszero(got) or sign(got) != sign(exact_bits):
+            return "special"
+        if single and f32_to_f64(f64_to_f32_store(got)[0]) != got:
+            return "not single"
+        ng, dg = rat(got)
+        if true_value is not None:
+            tv = true_value
+        else:
+            ne, de = rat(exact_bits)
+            tv = Fraction(ne, de)
+        err = abs(Fraction(ng, dg) - tv) / abs(tv)
+        return None if err <= rel else f"error {float(err):.3g}"
+    return chk
+
+
+def _fres(s, f):
+    b = s.fpr[f.rb]
+    one = 0x3FF0000000000000
+    exact = op_div(one, b, SGL, 0)
+    if isnan(b):
+        exact = quiet(b, True)
+    s.fpr[f.rt] = exact
+    tv = None
+    if not (isnan(b) or isinf(b) or iszero(b)):
+        from fractions import Fraction
+        nb_, db_ = rat(b)
+        tv = Fraction(db_, nb_)
+    s.approx[("fpr", f.rt)] = _est_checker(exact, 1 / 256, True, tv)
+    s.notes.append("fp-estimate")
+
+
+def _frsqrte(s, f):
+    b = s.fpr[f.rb]
+    if isnan(b):
+        exact = quiet(b)
+    elif iszero(b):
+        exact = (sign(b) << 63) | 0x7FF0000000000000
+    elif sign(b):
+        exact = QNAN64
+    elif isinf(b):
+        exact = 0
+    else:
+        exact = op_div(0x3FF0000000000000, op_sqrt(b, DBL, 0), DBL, 0)
+    s.fpr[f.rt] = exact
+    if isnan(b) or iszero(b) or sign(b) or isinf(b):
+        s.approx[("fpr", f.rt)] = _est_checker(exact, 1 / 32, False)
+    else:
+        s.approx[("fpr", f.rt)] = _rsqrt_checker(b)
+    s.notes.append("fp-estimate")
+
+
+def _rsqrt_checker(b):
+    """exact ISA bound for frsqrte of a positive finite b: |got - 1/sqrt(b)| <=
+    sqrt(b)^-1 / 32, i.e. (31/32)^2 <= got^2 * b <= (33/32)^2 (no rounded
+    reference value in between)."""
+    from fractions import Fraction
+    nb_, db_ = rat(b)
+    fb = Fraction(nb_, db_)
+    lo, hi = Fraction(31, 32) ** 2, Fraction(33, 32) ** 2
+
+    def chk(got):
+        if isnan(got) or isinf(got) or iszero(got) or sign(got):
+            return "special"
+        ng, dg = rat(got)
+        v = Fraction(ng, dg) ** 2 * fb
+        return None if lo <= v <= hi else f"error {float(v) ** 0.5 - 1:.3g}"
+    return chk
+
+
+_a_form("fres", 59, 24, _fres, fixed={"frc": 0, "ra": 0})
+_a_form("frsqrte", 63, 26, _frsqrte, fixed={"frc": 0, "ra": 0})
+
+
+# X-form (op 63) unary / convert / compare / FPSCR
+def _x63(name, xo, fn, rc_forms=True, fixed=None):
+    for rc in ((0, 1) if rc_forms else (0,)):
+        def sem(s, f):
+            fn(s, f)
+            _rc1(s, f)
+        fx = {"rc": rc}
+        fx.update(fixed or {})
+        add_spec(name + ("." if rc else ""), "X", 63, xo, sem, fixed=fx, tags=FP)
+
+
+def _set(fn):
+    def sem(s, f):
+        s.fpr[f.rt] = fn(s, s.fpr[f.rb]) & MASK64
+        _status(s)
+    return sem
+
+
+_x63("fmr", 72, _set(lambda s, b: b), fixed={"ra": 0})
+_x63("fneg", 40, _set(lambda s, b: b ^ (1 << 63)), fixed={"ra": 0})
+_x63("fabs", 264, _set(lambda s, b: b & ~(1 << 63)), fixed={"ra": 0})
+_x63("fnabs", 136, _set(lambda s, b: b | (1 << 63)), fixed={"ra": 0})
+def _frsp(s, f):
+    s.fpr[f.rt] = op_frsp(s.fpr[f.rb], _rn(s))
+    _single_nan_dc(s, f, 59)
+    _status(s)
+
+
+_x63("frsp", 12, _frsp, fixed={"ra": 0})
+_x63("fcfid", 846, _set(lambda s, b: op_cfid(b, _rn(s))), fixed={"ra": 0})
+_x63("fctid", 814, _set(lambda s, b: op_cvt_int(b, 64, _rn(s), False)), fixed={"ra": 0})
+_x63("fctidz", 815, _set(lambda s, b: op_cvt_int(b, 64, _rn(s), True)), fixed={"ra": 0})
+
+
+def _fctiw(trunc):
+    def sem(s, f):
+        s.fpr[f.rt] = op_cvt_int(s.fpr[f.rb], 32, _rn(s), trunc)
+        s.dontcare(("fpr", f.rt), MASK64 ^ MASK32)       # FRT[0:31] undefined
+        _status(s)
+    return sem
+
+
+_x63("fctiw", 14, _fctiw(False), fixed={"ra": 0})
+_x63("fctiwz", 15, _fctiw(True), fixed={"ra": 0})
+
+
+def _gen_fcmp(xo):
+    def gen(rng):
+        return 63 << 26 | rng.randrange(8) << 23 | rng.randrange(32) << 16 | rng.randrange(32) << 11 | xo << 1
+    return gen
+
+
+def _fcmp(s, f):
+    bf = (f.w >> 23) & 7
+    a, b = s.fpr[f.ra], s.fpr[f.rb]
+    if isnan(a) or isnan(b):
+        nib = 1
+    else:
+        na = _cmpkey(a)
+        nb = _cmpkey(b)
+        nib = 8 if na < nb else 4 if na > nb else 2
+    s.set_crf(bf, nib)
+    _status(s)
+
+
+def _cmpkey(b):
+    from fractions import Fraction
+    if isinf(b):
+        return Fraction(-(10 ** 400)) if sign(b) else Fraction(10 ** 400)
+    if iszero(b):
+        return Fraction(0)
+    n, d = rat(b)
+    return Fraction(n, d)
+
+
+def _fcmp_setup(s, f, rng, ea):
+    """equal / signed-zero / infinite / NaN operand pairs (random doubles are
+    almost never equal: EQ came up 2 times in 720)"""
+    r = rng.random()
+    if r >= 0.5 or f.ra == f.rb:
+        return
+    if r < 0.2:
+        s.fpr[f.rb] = s.fpr[f.ra]
+    else:
+        a, b = rng.choice(((0, 1 << 63), (1 << 63, 0), (0x7FF0000000000000,) * 2,
+                           (0xFFF0000000000000,) * 2, (0x7FF8000000000000, 0x7FF8000000000000),
+                           (0x7FF4000000000000, 0x3FF0000000000000),
+                           (0x3FF0000000000000, 0x3FF0000000000001)))
+        s.fpr[f.ra], s.fpr[f.rb] = a, b
+
+
+add_spec("fcmpu", "X", 63, 0, _fcmp, gen=_gen_fcmp(0), valid=lambda f: not (f.w >> 21) & 3,
+         setup=_fcmp_setup, tags=FP)
+add_spec("fcmpo", "X", 63, 32, _fcmp, gen=_gen_fcmp(32), valid=lambda f: not (f.w >> 21) & 3,
+         setup=_fcmp_setup, tags=FP)
+
+
+def _mffs(s, f):
+    s.fpr[f.rt] = s.fpscr
+    s.dontcare(("fpr", f.rt), MASK64 ^ MASK32)
+
+
+_x63("mffs", 583, _mffs, fixed={"ra": 0, "rb": 0})
+
+
+def _fpscr_summary(s):
+    s.dontcare("fpscr", 0x60000000)     # FEX, VX are recomputed summaries
+
+
+def _gen_mtfsf(rng):
+    flm = rng.choice((0xFF, 0x01, 0x80, rng.getrandbits(8)))
+    return 63 << 26 | flm << 17 | rng.randrange(32) << 11 | 711 << 1
+
+
+def _mtfsf(s, f):
+    v = s.fpr[f.rb] & MASK32
+    m = 0
+    for i in range(8):
+        if f.flm & (0x80 >> i):
+            m |= 0xF << (28 - 4 * i)
+    s.fpscr = (s.fpscr & ~m & MASK32) | (v & m)
+    _fpscr_summary(s)
+    _rc1(s, f)
+    s.notes.append("fpscr-control")
+
+
+add_spec("mtfsf", "X", 63, 711, _mtfsf, gen=_gen_mtfsf, fixed={"rc": 0}, tags=FP)
+
+
+def _gen_mtfsfi(rng):
+    return 63 << 26 | rng.randrange(8) << 23 | rng.randrange(16) << 12 | 134 << 1
+
+
+def _mtfsfi(s, f):
+    bf = (f.w >> 23) & 7
+    u = (f.w >> 12) & 15
+    if bf == 0:
+        u &= 0b1001                      # FEX/VX cannot be set explicitly
+    sh = 28 - 4 * bf
+    s.fpscr = (s.fpscr & ~(0xF << sh) & MASK32) | (u << sh)
+    _fpscr_summary(s)
+    s.notes.append("fpscr-control")
+
+
+add_spec("mtfsfi", "X", 63, 134, _mtfsfi, gen=_gen_mtfsfi, fixed={"rc": 0}, tags=FP)
+
+
+def _gen_mtfsb(xo):
+    def gen(rng):
+        return 63 << 26 | rng.choice((0, 3, 24, 29, 30, 31, rng.randrange(32))) << 21 | xo << 1
+    return gen
+
+
+def _mtfsb(val):
+    def sem(s, f):
+        bt = f.rt
+        if bt in (1, 2):
+            raise Undefined
+        m = 1 << (31 - bt)
+        s.fpscr = (s.fpscr | m) if val else (s.fpscr & ~m & MASK32)
+        _fpscr_summary(s)
+        s.notes.append("fpscr-control")
+    return sem
+
+
+add_spec("mtfsb0", "X", 63, 70, _mtfsb(0), gen=_gen_mtfsb(70), fixed={"rc": 0}, tags=FP)
+add_spec("mtfsb1", "X", 63, 38, _mtfsb(1), gen=_gen_mtfsb(38), fixed={"rc": 0}, tags=FP)
+
+
+# ---------------------------------------------------------------------------
+# FP loads / stores
+# ---------------------------------------------------------------------------
+
+def _ea(s, f, kind, upd):
+    base = s.gpr[f.ra] if (f.ra or upd) else 0
+    off = f.d if kind == "D" else s.gpr[f.rb]
+    return (base + off) & MASK64
+
+
+def _upd_ok(f):
+    return f.ra != 0
+
+
+def _lf_setup(single):
+    """put an interesting float at the EA (the memory window is random bytes:
+    an SNaN or a single denormal came up about once in 700 cases)"""
+    def setup(s, f, rng, ea):
+        if ea is None or rng.random() >= 0.6:
+            return
+        import gen
+        o = (ea & MASK32) - 0x4000
+        if single:
+            s.mem[o:o + 4] = gen.rand_f32(rng).to_bytes(4, "big")
+        else:
+            s.mem[o:o + 8] = gen.rand_f64(rng).to_bytes(8, "big")
+    return setup
+
+
+def _lf(name, kind, op, xo, single, upd):
+    def sem(s, f):
+        ea = _ea(s, f, kind, upd)
+        if single:
+            s.fpr[f.rt] = f32_to_f64(s.ld_u(ea, 4))
+        else:
+            s.fpr[f.rt] = s.ld_u(ea, 8)
+        if upd:
+            s.gpr[f.ra] = ea
+    add_spec(name, kind, op, xo, sem, ea=(kind, 4 if single else 8),
+             valid=_upd_ok if upd else None, setup=_lf_setup(single), tags=FP + ("ldst", "load"))
+
+
+def _stf(name, kind, op, xo, mode, upd):
+    def sem(s, f):
+        ea = _ea(s, f, kind, upd)
+        b = s.fpr[f.rt]
+        if mode == "s":
+            w, ok = f64_to_f32_store(b)
+            s.st_u(ea, 4, w)
+            if not ok:                       # undefined conversion: any bytes
+                o = (ea & MASK32) - 0x4000
+                s.dontcare("mem", 0xF << o)
+                s.notes.append("stfs-undefined")
+        elif mode == "d":
+            s.st_u(ea, 8, b)
+        else:  # stfiwx
+            s.st_u(ea, 4, b & MASK32)
+        if upd:
+            s.gpr[f.ra] = ea
+    size = 8 if mode == "d" else 4
+    add_spec(name, kind, op, xo, sem, ea=(kind, size),
+             valid=_upd_ok if upd else None, tags=FP + ("ldst", "store"))
+
+
+_lf("lfs", "D", 48, None, True, False)
+_lf("lfsu", "D", 49, None, True, True)
+_lf("lfd", "D", 50, None, False, False)
+_lf("lfdu", "D", 51, None, False, True)
+_lf("lfsx", "X", 31, 535, True, False)
+_lf("lfsux", "X", 31, 567, True, True)
+_lf("lfdx", "X", 31, 599, False, False)
+_lf("lfdux", "X", 31, 631, False, True)
