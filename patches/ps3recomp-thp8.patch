+static void test_mfc_variants(void)
+{
+    spu_context* c = new_ctx(0x50);
+
+    /* Every single-transfer GET and PUT form, plain, barrier and fence, and the
+     * PUTR ("put with result") forms, which move data like PUT (RPCS3 runs
+     * them through the same transfer). 48 bytes each way; the rest of the
+     * quadword-padded window stays as it was, and each tag completes. */
+    TEST("mfc.variants");
+    static const struct { uint32_t cmd; int get; } v[] = {
+        { MFC_GET_CMD, 1 }, { MFC_GETB_CMD, 1 }, { MFC_GETF_CMD, 1 },
+        { MFC_PUT_CMD, 0 }, { MFC_PUTB_CMD, 0 }, { MFC_PUTF_CMD, 0 },
+        { T_PUTR, 0 },      { T_PUTRB, 0 },      { T_PUTRF, 0 } };
+    { int ok = 1, tags = 1;
+      for (int i = 0; i < 9; i++) {
+          const uint32_t tag = 16u + (uint32_t)i;
+          uint8_t ls0[64], mem0[64];
+          fill(vm_base + EA_BUF + 0x2000, 64, (uint8_t)(0x30 + i));
+          fill(c->ls + 0xC000, 64, (uint8_t)(0x90 + i));
+          memcpy(ls0, c->ls + 0xC000, 64); memcpy(mem0, vm_base + EA_BUF + 0x2000, 64);
+          mfc(c, v[i].cmd, 0xC000, EA_BUF + 0x2000, 48, tag);
+          if (v[i].get) {
+              if (memcmp(c->ls + 0xC000, mem0, 48) || memcmp(c->ls + 0xC030, ls0 + 48, 16) ||
+                  memcmp(vm_base + EA_BUF + 0x2000, mem0, 64)) ok = 0;
+          } else {
+              if (memcmp(vm_base + EA_BUF + 0x2000, ls0, 48) || memcmp(vm_base + EA_BUF + 0x2030, mem0 + 48, 16) ||
+                  memcmp(c->ls + 0xC000, ls0, 64)) ok = 0;
+          }
+          if (tag_wait(c, 1u << tag, MFC_TAG_UPDATE_ALL) != (1u << tag)) tags = 0;
+      }
+      CHECK(ok); CHECK(tags); }
+
+    /* Every list form: GETL/GETLB/GETLF, PUTL/PUTLB/PUTLF, PUTRL/PUTRLB/PUTRLF. */
+    TEST("mfc.list-variants");
+    static const struct { uint32_t cmd; int get; } lv[] = {
+        { MFC_GETL_CMD, 1 }, { MFC_GETLB_CMD, 1 }, { MFC_GETLF_CMD, 1 },
+        { MFC_PUTL_CMD, 0 }, { MFC_PUTLB_CMD, 0 }, { MFC_PUTLF_CMD, 0 },
+        { T_PUTRL, 0 },      { T_PUTRLB, 0 },      { T_PUTRLF, 0 } };
+    { int ok = 1, tags = 1;
+      list_elem(c, 0xD00, 16, EA_BUF + 0x2200, 0);
+      list_elem(c, 0xD08, 32, EA_BUF + 0x2300, 0);
+      list_elem(c, 0xD10, 64, EA_BUF + 0x2400, 0);
+      for (int i = 0; i < 9; i++) {
+          const uint32_t tag = 16u + (uint32_t)i;
+          fill(vm_base + EA_BUF + 0x2200, 0x300, (uint8_t)(0x11 * i));
+          fill(c->ls + 0xC000, 0x100, (uint8_t)(0x70 + i));
+          mfc(c, lv[i].cmd, 0xC000, 0xD00, 3 * 8, tag);
+          /* element k lands at 0xC000 + 0, 16, 48 (sizes rounded to 16) */
+          const uint8_t* m0 = vm_base + EA_BUF + 0x2200; const uint8_t* m1 = vm_base + EA_BUF + 0x2300;
+          const uint8_t* m2 = vm_base + EA_BUF + 0x2400;
+          if (memcmp(c->ls + 0xC000, m0, 16) || memcmp(c->ls + 0xC010, m1, 32) || memcmp(c->ls + 0xC030, m2, 64)) ok = 0;
+          if (lv[i].get == 0) {   /* the data went the other way: memory now equals the LS pattern */
+              uint8_t want[0x100]; fill(want, 0x100, (uint8_t)(0x70 + i));
+              if (memcmp(m0, want, 16) || memcmp(m1, want + 16, 32) || memcmp(m2, want + 48, 64)) ok = 0;
+          } else {
+              uint8_t want[0x300]; fill(want, 0x300, (uint8_t)(0x11 * i));
+              if (memcmp(m0, want, 16)) ok = 0;   /* a GET leaves memory alone */
+          }
+          if (tag_wait(c, 1u << tag, MFC_TAG_UPDATE_ALL) != (1u << tag)) tags = 0;
+      }
+      CHECK(ok); CHECK(tags); }
+
+    /* Commands execute in issue order: a fenced GET after a PUT of the same
+     * tag reads what the PUT wrote, and a barriered PUT after a GET does not
+     * change what the GET read. Nothing fenced or barriered is dropped. */
+    TEST("mfc.order");
+    put_be32(c->ls + 0xC100, 0xA1A1A1A1u); put_be32(c->ls + 0xC120, 0xB2B2B2B2u);
+    memset(c->ls + 0xC110, 0, 16); memset(c->ls + 0xC130, 0, 16);
+    put_be32(vm_base + EA_BUF + 0x2500, 0);
+    mfc(c, MFC_PUT_CMD,  0xC100, EA_BUF + 0x2500, 16, 3);
+    mfc(c, MFC_GETF_CMD, 0xC110, EA_BUF + 0x2500, 16, 3);
+    mfc(c, MFC_PUTB_CMD, 0xC120, EA_BUF + 0x2500, 16, 3);
+    mfc(c, MFC_GETB_CMD, 0xC130, EA_BUF + 0x2500, 16, 3);
+    CHECK_EQ(be32(c->ls + 0xC110), 0xA1A1A1A1u);
+    CHECK_EQ(be32(c->ls + 0xC130), 0xB2B2B2B2u);
+    CHECK_EQ(be32(vm_base + EA_BUF + 0x2500), 0xB2B2B2B2u);
+    CHECK_EQ(tag_wait(c, 1u << 3, MFC_TAG_UPDATE_ALL), 1u << 3);
+
+    /* MFC_EAH: lv2 SPU thread addresses are 32-bit, and the MFC uses EAL (RPCS3
+     * ignores EAH for every SPU-thread transfer). */
+    TEST("mfc.eah-ignored");
+    fill(vm_base + EA_BUF + 0x2600, 32, 0x61);
+    memset(c->ls + 0xC200, 0, 32);
+    wr(c, MFC_LSA, 0xC200); wr(c, MFC_EAH, 1); wr(c, MFC_EAL, EA_BUF + 0x2600);
+    wr(c, MFC_Size, 32); wr(c, MFC_TagID, 2); wr(c, MFC_Cmd, MFC_GET_CMD);
+    CHECK(memcmp(c->ls + 0xC200, vm_base + EA_BUF + 0x2600, 32) == 0);
+    fill(c->ls + 0xC200, 32, 0x17);
+    wr(c, MFC_EAH, 0xFFFFFFFFu); wr(c, MFC_Cmd, MFC_PUT_CMD);
+    CHECK(memcmp(c->ls + 0xC200, vm_base + EA_BUF + 0x2600, 32) == 0);
+
+    /* sdcrz: zero `size` bytes of main memory (RPCS3: a PUT from a zero
+     * buffer). The line is written, so a reservation on it is lost. The other
+     * cache-management commands (sdcrt, sdcrtst, sdcrs, sdcrf) are hints that
+     * move no data -- in particular sdcrs/sdcrf carry the 0x04 bit and must not
+     * be run as list commands. */
+    TEST("mfc.sdcrz");
+    { spu_context* p = new_ctx(0x55);
+      memset(vm_base + EA_BUF + 0x2800, 0xCC, 0x200);
+      fill(c->ls + 0xC400, 0x200, 0x44);
+      uint8_t ls0[0x200]; memcpy(ls0, c->ls + 0xC400, sizeof ls0);
+      getllar(p, 0x7000, EA_BUF + 0x2880);
+      mfc(c, T_SDCRZ, 0xC400, EA_BUF + 0x2880, 128, 4);
+      int zero = 1, kept = 1;
+      for (int k = 0; k < 128; k++) if (vm_base[EA_BUF + 0x2880 + k]) zero = 0;
+      for (int k = 0; k < 0x80; k++) if (vm_base[EA_BUF + 0x2800 + k] != 0xCC || vm_base[EA_BUF + 0x2900 + k] != 0xCC) kept = 0;
+      CHECK(zero); CHECK(kept);
+      CHECK(memcmp(c->ls + 0xC400, ls0, sizeof ls0) == 0);
+      CHECK_EQ(tag_wait(c, 1u << 4, MFC_TAG_UPDATE_ALL), 1u << 4);
+      putllc(p, 0x7000, EA_BUF + 0x2880);
+      CHECK_EQ(rd(p, MFC_RdAtomicStat), 1);
+      CHECK(p->event_status & 0x400);
+      free_ctx(p); }
+    TEST("mfc.cache-hints");
+    { static const uint32_t hints[] = { T_SDCRT, T_SDCRTST, T_SDCRS, T_SDCRF };
+      int ok = 1;
+      /* An LS "list" the hints would read if they were taken for list
+       * commands: a stall element (would raise Sn and park) and a GET. */
+      list_elem(c, 0xE00, 16, EA_BUF + 0x2A00, 1); list_elem(c, 0xE08, 16, EA_BUF + 0x2A10, 0);
+      memset(vm_base + EA_BUF + 0x2A00, 0x5A, 0x40); fill(c->ls + 0xC600, 0x40, 0x21);
+      uint8_t ls0[0x40]; memcpy(ls0, c->ls + 0xC600, sizeof ls0);
+      wr(c, SPU_WrEventAck, 0xFFFFFFFFu);
+      for (int i = 0; i < 4; i++) {
+          mfc(c, hints[i], 0xC600, EA_BUF + 0x2A00, 0x40, 5);
+          for (int k = 0; k < 0x40; k++) if (vm_base[EA_BUF + 0x2A00 + k] != 0x5A) ok = 0;
+          if (memcmp(c->ls + 0xC600, ls0, sizeof ls0)) ok = 0;
+          /* the same, aimed so that EAL would name the fake list */
+          mfc(c, hints[i], 0xC600, 0xE00, 0x10, 5);
+          if (memcmp(c->ls + 0xC600, ls0, sizeof ls0)) ok = 0;
+      }
+      CHECK(ok);
+      CHECK_EQ(c->event_status & 0x2, 0);                  /* no stall-and-notify */
+      CHECK_EQ(cnt(c, MFC_RdListStallStat), 0);
+      CHECK_EQ(tag_wait(c, 1u << 5, MFC_TAG_UPDATE_ALL), 1u << 5); }
+
+    /* Forms the runtime accepts that real code cannot issue from an SPU. */
+    TEST("mfc.unissuable");
+    fill(vm_base + EA_BUF + 0x2C00, 16, 0x3E); memset(c->ls + 0xC800, 0, 16);
+    mfc(c, T_GETS, 0xC800, EA_BUF + 0x2C00, 16, 6);
+    NOTE(c->ls[0xC800] == 0, "GETS/PUTS (the PPU-proxy start forms) are performed for an SPU (RPCS3: unknown command)");
+    NOTE(0, "sndsig/sndsigf/sndsigb to an SPU thread's SNR (0xF0000000 + n*0x100000 + 0x5400C/0x5C00C) and SPU-to-SPU "
+            "local-store DMA through that window are not modelled: they are plain transfers to guest memory");
+    free_ctx(c);
+}
+
+static void test_mfc_list_more(void)
+{
+    spu_context* c = new_ctx(0x56);
+
+    /* Element word 0 = [S:1][reserved:16][size:15]: the reserved bits and the
+     * top bit of the size halfword are ignored (RPCS3: sb & 0x80, ts & 0x7fff). */
+    TEST("mfc.list-element-format");
+    spu_ls_write32(c, 0xD00, 0x7FFF8000u | 32u); spu_ls_write32(c, 0xD04, EA_BUF + 0x3000);
+    fill(vm_base + EA_BUF + 0x3000, 64, 0x5C); memset(c->ls + 0xC000, 0, 64);
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu);
+    mfc(c, MFC_GETL_CMD, 0xC000, 0xD00, 8, 8);
+    CHECK(memcmp(c->ls + 0xC000, vm_base + EA_BUF + 0x3000, 32) == 0);
+    CHECK_EQ(c->ls[0xC020], 0);
+    CHECK_EQ(c->event_status & 0x2, 0);
+    CHECK_EQ(tag_wait(c, 1u << 8, MFC_TAG_UPDATE_ALL), 1u << 8);
+
+    /* A zero-size element moves nothing and does not advance the LSA. */
+    TEST("mfc.list-zero-size");
+    list_elem(c, 0xD00, 16, EA_BUF + 0x3100, 0);
+    list_elem(c, 0xD08, 0,  EA_BUF + 0x3200, 0);
+    list_elem(c, 0xD10, 16, EA_BUF + 0x3300, 0);
+    fill(vm_base + EA_BUF + 0x3100, 0x300, 0x12); memset(c->ls + 0xC000, 0, 64);
+    mfc(c, MFC_GETL_CMD, 0xC000, 0xD00, 24, 8);
+    CHECK(memcmp(c->ls + 0xC000, vm_base + EA_BUF + 0x3100, 16) == 0);
+    CHECK(memcmp(c->ls + 0xC010, vm_base + EA_BUF + 0x3300, 16) == 0);
+    CHECK_EQ(c->ls[0xC020], 0);
+
+    /* The list address is 8-byte aligned: its low three bits are ignored
+     * (RPCS3: eal & 0x3fff8), not used to read the elements off by a few bytes. */
+    TEST("mfc.list-address-alignment");
+    list_elem(c, 0xD00, 16, EA_BUF + 0x3400, 0);
+    list_elem(c, 0xD08, 16, EA_BUF + 0x3500, 0);
+    fill(vm_base + EA_BUF + 0x3400, 0x200, 0x2D); memset(c->ls + 0xC000, 0, 64);
+    mfc(c, MFC_GETL_CMD, 0xC000, 0xD04, 16, 8);
+    CHECK(memcmp(c->ls + 0xC000, vm_base + EA_BUF + 0x3400, 16) == 0);
+    CHECK(memcmp(c->ls + 0xC010, vm_base + EA_BUF + 0x3500, 16) == 0);
+    CHECK_EQ(tag_wait(c, 1u << 8, MFC_TAG_UPDATE_ALL), 1u << 8);
+
+    /* Two stall points in one list: park, ack, park again, ack, done. */
+    TEST("mfc.list-two-stalls");
+    for (int i = 0; i < 4; i++) list_elem(c, 0xD00 + 8u * i, 16, EA_BUF + 0x3600 + 0x10u * i, i == 0 || i == 2);
+    fill(vm_base + EA_BUF + 0x3600, 0x40, 0x4B); memset(c->ls + 0xC000, 0, 0x40);
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu); wr(c, SPU_WrEventMask, 0x2);
+    mfc(c, MFC_GETL_CMD, 0xC000, 0xD00, 32, 12);
+    CHECK(memcmp(c->ls + 0xC000, vm_base + EA_BUF + 0x3600, 16) == 0);
+    CHECK_EQ(c->ls[0xC010], 0);
+    CHECK_EQ(rd(c, MFC_RdListStallStat), 1u << 12);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x2);
+    wr(c, SPU_WrEventAck, 0x2);
+    CHECK_EQ(tag_wait(c, 1u << 12, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    wr(c, MFC_WrListStallAck, 12);
+    CHECK(memcmp(c->ls + 0xC010, vm_base + EA_BUF + 0x3610, 32) == 0);
+    CHECK_EQ(c->ls[0xC030], 0);
+    CHECK_EQ(cnt(c, MFC_RdListStallStat), 1);
+    CHECK_EQ(rd(c, MFC_RdListStallStat), 1u << 12);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x2);
+    CHECK_EQ(tag_wait(c, 1u << 12, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    wr(c, SPU_WrEventAck, 0x2);
+    wr(c, MFC_WrListStallAck, 12);
+    CHECK(memcmp(c->ls + 0xC030, vm_base + EA_BUF + 0x3630, 16) == 0);
+    CHECK_EQ(tag_wait(c, 1u << 12, MFC_TAG_UPDATE_ALL), 1u << 12);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+
+    /* WrListStallAck naming a tag with nothing parked changes nothing; a list
+     * parked on another tag stays parked. */
+    TEST("mfc.list-ack-unparked");
+    list_elem(c, 0xD00, 16, EA_BUF + 0x3600, 1); list_elem(c, 0xD08, 16, EA_BUF + 0x3610, 0);
+    memset(c->ls + 0xC000, 0, 0x40);
+    mfc(c, MFC_GETL_CMD, 0xC000, 0xD00, 16, 13);
+    (void)rd(c, MFC_RdListStallStat);
+    wr(c, MFC_WrListStallAck, 14);
+    CHECK_EQ(c->ls[0xC010], 0);
+    CHECK_EQ(tag_wait(c, 1u << 13, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    /* ...and neither a barrier, an eieio, a sync nor a plain GET in that tag
+     * group completes it while the list is parked. */
+    TEST("mfc.parked-tag-stays-incomplete");
+    mfc(c, MFC_BARRIER_CMD, 0, 0, 0, 13);
+    mfc(c, MFC_EIEIO_CMD, 0, 0, 0, 13);
+    mfc(c, MFC_SYNC_CMD, 0, 0, 0, 13);
+    CHECK_EQ(tag_wait(c, 1u << 13, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    mfc(c, MFC_GET_CMD, 0xC100, EA_BUF + 0x3700, 16, 13);
+    CHECK_EQ(tag_wait(c, 1u << 13, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    wr(c, MFC_WrListStallAck, 13);
+    CHECK(memcmp(c->ls + 0xC010, vm_base + EA_BUF + 0x3610, 16) == 0);
+    CHECK_EQ(tag_wait(c, 1u << 13, MFC_TAG_UPDATE_ALL), 1u << 13);
+
+    /* Documented divergences. */
+    TEST("mfc.list-notes");
+    list_elem(c, 0xD00, 16, EA_BUF + 0x3600, 0); list_elem(c, 0xD08, 16, EA_BUF + 0x3610, 1);
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu);
+    mfc(c, MFC_GETL_CMD, 0xC000, 0xD00, 16, 15);
+    NOTE(cnt(c, MFC_RdListStallStat) == 0,
+         "stall-and-notify on the LAST list element parks the list and raises Sn (RPCS3 completes the list; "
+         "kept: the WWS job manager's one-element notify list relies on it)");
+    if (cnt(c, MFC_RdListStallStat)) { (void)rd(c, MFC_RdListStallStat); wr(c, MFC_WrListStallAck, 15); }
+    NOTE(0, "MFC_TAG_UPDATE_ALL/ANY on a tag whose list is parked returns the partial status at once (hardware waits for the ack)");
+    wr(c, SPU_WrEventAck, 0xFFFFFFFFu); wr(c, SPU_WrEventMask, 0);
+    free_ctx(c);
+}
