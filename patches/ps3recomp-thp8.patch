+/* reCreateMode YES, after the pass wrote everything: remove the files it did not write, then the
+ * new PARAM.PFD (the secure files of this pass), written through a tmp file like the rest. */
+static void savedata_recreate_commit(const char* save_path, const savedata_pass* pass)
+{
+    char path[1024];
+    u32 n = enumerate_save_files(save_path, NULL, 0);
+    CellSaveDataFileStat* files = n ? (CellSaveDataFileStat*)calloc(n, sizeof(*files)) : NULL;
+    if (files) {
+        u32 got = enumerate_save_files(save_path, files, n);
+        if (got > n) got = n;
+        for (u32 i = 0; i < got; i++) {
+            int kept = 0;
+            for (unsigned j = 0; j < pass->n_written && !kept; j++) kept = !strcmp(pass->written[j], files[i].fileName);
+            if (kept) continue;
+            snprintf(path, sizeof(path), "%s/%s", save_path, files[i].fileName);
+            savedata_host_path(path);
+            if (sd_remove(path) == 0)
+                printf("[cellSaveData] recreate: removed '%s' (not part of the new save)\n", files[i].fileName);
+        }
+        free(files);
+    }
+    pfd_path(save_path, path, sizeof(path));
+    if (!pass->n_secure) { sd_remove(path); return; }
+    char tmp_path[1100];
+    FILE* fp = savedata_open_tmp(path, tmp_path, sizeof tmp_path);
+    if (!fp) return;
+    int bad = 0;
+    for (unsigned i = 0; i < pass->n_secure; i++) bad |= fprintf(fp, "%s\n", pass->secure[i]) < 0;
+    savedata_close_commit(fp, tmp_path, path, bad);
+}
