+/* PSO-key hash of a vertex program (get_pso, every draw): byte-wise FNV over
+ * a 2-3 KB program is a 64-bit multiply chain per byte (~2 us per draw, done
+ * twice). Four independent lanes of 8-byte words, each finished with the
+ * murmur3 fmix64 avalanche, then combined. In-process key only (the shader
+ * caches hash the HLSL text), so it only has to be collision-free.
+ * PS3_PSO_FNV=1: the byte-wise FNV (old keys). */
+static u64 ld_fmix64(u64 k)
+{
+    k ^= k >> 33; k *= 0xff51afd7ed558ccdull;
+    k ^= k >> 33; k *= 0xc4ceb9fe1a85ec53ull;
+    k ^= k >> 33;
+    return k;
+}
+/* PS3_PSO_OLD_FILE=<path>: while <path> exists (polled once per frame),
+ * get_pso uses the old byte-wise FNV VP key and the linear PSO scan -- a
+ * same-boot perf A/B of the two (both key sets coexist in the cache). */
+static int ld_pso_old_active(void)
+{
+    static const char* file = (const char*)-1;
+    static u32 frame;
+    static int old;
+    if (file == (const char*)-1) file = getenv("PS3_PSO_OLD_FILE");
+    if (!file) return 0;
+    if (frame != g_ld_frames + 1u) {
+        frame = g_ld_frames + 1u;
+        struct stat st;
+        const int now = stat(file, &st) == 0;
+        if (now != old)
+            fprintf(stderr, "[pso-key] frame %u: %s\n", g_ld_frames,
+                    now ? "old (byte FNV + linear scan)" : "word hash + index");
+        old = now;
+    }
+    return old;
+}
+
+static u64 ld_hash_words(const void* data, u32 n, u64 seed)
+{
+    static int fnv = -1;
+    if (fnv < 0) fnv = getenv("PS3_PSO_FNV") ? 1 : 0;
+    if (fnv) return fnv1a(data, n, seed);
+    const u8* p = (const u8*)data;
+    u64 h0 = seed ^ 0x9E3779B97F4A7C15ull, h1 = seed ^ 0xC2B2AE3D27D4EB4Full,
+        h2 = seed ^ 0x165667B19E3779F9ull, h3 = seed ^ 0x27D4EB2F165667C5ull;
+    u32 i = 0;
+    for (; i + 32 <= n; i += 32) {
+        u64 w0, w1, w2, w3;
+        memcpy(&w0, p + i, 8); memcpy(&w1, p + i + 8, 8);
+        memcpy(&w2, p + i + 16, 8); memcpy(&w3, p + i + 24, 8);
+        h0 = (h0 ^ w0) * 0x100000001B3ull; h0 ^= h0 >> 29;
+        h1 = (h1 ^ w1) * 0x100000001B3ull; h1 ^= h1 >> 29;
+        h2 = (h2 ^ w2) * 0x100000001B3ull; h2 ^= h2 >> 29;
+        h3 = (h3 ^ w3) * 0x100000001B3ull; h3 ^= h3 >> 29;
+    }
+    u64 t = (u64)n;
+    for (; i < n; i++) t = (t ^ p[i]) * 1099511628211ull;
+    return ld_fmix64(ld_fmix64(h0) ^ ld_fmix64(h1 + 1) ^ ld_fmix64(h2 + 2) ^ ld_fmix64(h3 + 3) ^ ld_fmix64(t));
+}
+
+/* PSO cache index: open addressing over g.psos by key (the linear scan of up
+ * to MAX_PSOS keys ran on every draw). Value = slot + 1. */
+#define LD_PSO_INDEX_SIZE (MAX_PSOS * 2u)
+static u32 g_ld_pso_index[LD_PSO_INDEX_SIZE];
+static int ld_pso_find(u64 key)
+{
+    u32 h = (u32)ld_fmix64(key) & (LD_PSO_INDEX_SIZE - 1u);
+    for (u32 probe = 0; probe < LD_PSO_INDEX_SIZE; probe++) {
+        const u32 v = g_ld_pso_index[h];
+        if (!v) return -1;
+        if (g.psos[v - 1u].key == key) return (int)(v - 1u);
+        h = (h + 1u) & (LD_PSO_INDEX_SIZE - 1u);
+    }
+    return -1;
+}
+static void ld_pso_index_add(u64 key, u32 slot)
+{
+    u32 h = (u32)ld_fmix64(key) & (LD_PSO_INDEX_SIZE - 1u);
+    while (g_ld_pso_index[h]) h = (h + 1u) & (LD_PSO_INDEX_SIZE - 1u);
+    g_ld_pso_index[h] = slot + 1u;
+}
