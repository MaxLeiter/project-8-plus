+}
+static void ldl_OMSetRenderTargets(UINT n, const D3D12_CPU_DESCRIPTOR_HANDLE* rtvs, BOOL single,
+                                   const D3D12_CPU_DESCRIPTOR_HANDLE* dsv)
+{
+    const UINT nh = rtvs ? (single ? (n ? 1u : 0u) : n) : 0u;
+    if (!g_dcl.on || nh > 8u) { ld_dcl_sync(); g.list->lpVtbl->OMSetRenderTargets(g.list, n, rtvs, single, dsv); return; }
+    DCL_PUT(dcl_om_rt, DCL_OM_RT);
+    o_->n = n; o_->single = single; o_->has_dsv = dsv != NULL;
+    if (dsv) o_->dsv = *dsv;
+    if (nh) memcpy(o_->rtv, rtvs, (size_t)nh * sizeof(*rtvs));
+    o_->has_rtv = rtvs != NULL;
+}
+static void ldl_IASetVertexBuffers(UINT start, UINT n, const D3D12_VERTEX_BUFFER_VIEW* v)
+{
+    if (!g_dcl.on || !v) { ld_dcl_sync(); g.list->lpVtbl->IASetVertexBuffers(g.list, start, n, v); return; }
+    DCL_VAR(dcl_ia_vb, DCL_IA_VB, v, n ? n : 1u);
+    o_->start = start; o_->n = n; if (n) memcpy(o_->v, v, (size_t)n * sizeof(*v));
+}
+static void ldl_IASetPrimitiveTopology(D3D12_PRIMITIVE_TOPOLOGY t)
+{
+    if (!g_dcl.on) { g.list->lpVtbl->IASetPrimitiveTopology(g.list, t); return; }
+    DCL_PUT(dcl_u32s, DCL_IA_TOPO); o_->a = (UINT)t;
+}
+static void ldl_IASetIndexBuffer(const D3D12_INDEX_BUFFER_VIEW* v)
