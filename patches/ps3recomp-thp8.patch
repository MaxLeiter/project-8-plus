+
+static int sd_mkdir(const char* path)
+{
+#ifdef _WIN32
+    wchar_t w[SD_PATH_MAX + 8];
+    if (!sd_wide(path, w, SD_PATH_MAX + 8)) return -1;
+    return _wmkdir(w);
+#else
+    return mkdir(path, 0755);
+#endif
