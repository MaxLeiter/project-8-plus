+  tailCall: valid([...HDR, ...TYPE_V_V, ...FUNC_1, ...code([0x00, 0x12, 0x00, 0x0b])]),
+  simd: valid([...HDR, ...TYPE_V_V, ...FUNC_1, ...code([0x00, 0xfd, 0x0c, ...new Array(16).fill(0), 0x1a, 0x0b])]),
+  ehLegacy: valid([...HDR, ...TYPE_V_V, ...FUNC_1, ...code([0x00, 0x06, 0x40, 0x0b, 0x0b])]),
+  ehExnref: valid([...HDR, ...TYPE_V_V, ...FUNC_1, ...code([0x00, 0x1f, 0x40, 0x00, 0x0b, 0x0b])]),
+};
+
+async function probe() {
+  let ok = true;
+  ok &= check(window.isSecureContext ? "ok" : "bad", "Secure context", window.isSecureContext ? "yes" :
+    "open this page via https:// or http://localhost (the bundled launcher), not a LAN IP over plain http or file://.");
+  const coi = window.crossOriginIsolated && typeof SharedArrayBuffer === "function";
+  ok &= check(coi ? "ok" : "bad", "Threads (SharedArrayBuffer)", coi ? "cross-origin isolated" :
+    "the server did not send COOP/COEP headers. Use the bundled launcher or add the _headers rules.");
+  const need = { threads: "wasm threads", tailCall: "wasm tail calls", simd: "wasm SIMD", eh: "wasm exceptions" };
+  const missing = Object.keys(need).filter((k) => (k === "eh" ? !(FEATURES.ehLegacy || FEATURES.ehExnref) : !FEATURES[k]));
