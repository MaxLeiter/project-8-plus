+    else if ((e = getenv("PS3_HLE_TRACE")) && atoi(e) > 0) why = "PS3_HLE_TRACE";
+    else if ((e = getenv("PS3_HLE_ARGS")) && strtoul(e, 0, 16) != 0) why = "PS3_HLE_ARGS";
+    else if ((e = getenv("PS3_HLE_ARGLOG")) && atoi(e) > 0) why = "PS3_HLE_ARGLOG";
+    else if (getenv("FLOW_NOSPILL")) why = "FLOW_NOSPILL";
+    else if (getenv("PS3_HLE_PTRCHECK")) why = "PS3_HLE_PTRCHECK";
+    else if (getenv("PS3_SCTRACE")) why = "PS3_SCTRACE";
+    else if (getenv("PS3_SCTRACE_TID")) why = "PS3_SCTRACE_TID";
+    else if (getenv("PS3_SCENTER")) why = "PS3_SCENTER";
+    else if (getenv("PS3_SCBLOCK_PROF")) why = "PS3_SCBLOCK_PROF";
+    int m;
+    if (why) m = 0;
+    else {
+        e = getenv("PS3_HLE_TRIM_OFF_FILE");
+        if (e && *e) { s_hle_trim_off = e; m = hle_path_exists(e) ? 3 : 2; }
+        else m = 1;
+    }
+    static volatile int s_said = 0;
+    if (!__atomic_exchange_n(&s_said, 1, __ATOMIC_RELAXED)) {
+        if (why) fprintf(stderr, "[hle-trim] off (%s): full import/syscall path\n", why);
+        else fprintf(stderr, "[hle-trim] on: lean import/syscall path%s%s%s\n",
+                     s_hle_trim_off ? " (live off file " : "", s_hle_trim_off ? s_hle_trim_off : "",
+                     s_hle_trim_off ? (m == 3 ? ": present -> off)" : ")") : "");
+    }
+    __atomic_store_n(&g_ps3_hle_lean_mode[0], m, __ATOMIC_RELAXED);
+    return m;
