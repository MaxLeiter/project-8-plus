+static ULONG STDMETHODCALLTYPE cl_addref(ID3D12GraphicsCommandList* t) { return (ULONG)__atomic_add_fetch(&L_of(t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE cl_release(ID3D12GraphicsCommandList* t)
+{
