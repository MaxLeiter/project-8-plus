+def _vsum2sws(s, f):
+    a = [s32(x) for x in W(s.vr[f.ra])]
+    b = [s32(x) for x in W(s.vr[f.rb])]
+    r1, s1 = sat(a[0] + a[1] + b[1], -(1 << 31), (1 << 31) - 1)
+    r3, s3 = sat(a[2] + a[3] + b[3], -(1 << 31), (1 << 31) - 1)
+    s.set_v(f.rt, fromW([0, r1, 0, r3]))
+    _sat_note(s, s1 or s3)
+
+
+def _vsumsws(s, f):
+    a = [s32(x) for x in W(s.vr[f.ra])]
+    b = s32(W(s.vr[f.rb])[3])
+    r, st = sat(sum(a) + b, -(1 << 31), (1 << 31) - 1)
+    s.set_v(f.rt, fromW([0, 0, 0, r]))
+    _sat_note(s, st)
+
+
+vx("vsum2sws", 1672, _vsum2sws)
+vx("vsumsws", 1928, _vsumsws)
+
+
+def _msum(kind):
+    def sem(s, f):
+        va_, vb_, vc_ = s.vr[f.ra], s.vr[f.rb], s.vr[f.vc]
+        c = W(vc_)
+        out, anys = [], False
+        for j in range(4):
+            if kind in ("ubm", "mbm"):
+                xs = va_[4 * j:4 * j + 4]
+                ys = vb_[4 * j:4 * j + 4]
+                if kind == "mbm":
+                    xs = [sext(x, 8) for x in xs]
+                t = sum(x * y for x, y in zip(xs, ys)) + s32(c[j]) * (kind == "mbm") + c[j] * (kind == "ubm")
+                out.append(t & MASK32)
+            else:
+                hs_a, hs_b = H(va_)[2 * j:2 * j + 2], H(vb_)[2 * j:2 * j + 2]
+                if kind.startswith("sh"):
+                    hs_a = [sext(x, 16) for x in hs_a]
+                    hs_b = [sext(x, 16) for x in hs_b]
+                    cj = s32(c[j])
+                else:
+                    cj = c[j]
+                t = sum(x * y for x, y in zip(hs_a, hs_b)) + cj
+                if kind.endswith("s"):
+                    lo, hi = ((-(1 << 31), (1 << 31) - 1) if kind.startswith("sh") else (0, MASK32))
+                    t, st = sat(t, lo, hi)
+                    anys |= st
+                out.append(t & MASK32)
+        s.set_v(f.rt, fromW(out))
+        if kind.endswith("s"):
+            _sat_note(s, anys)
+    return sem
+
+
+va("vmsumubm", 36, _msum("ubm"))
+va("vmsummbm", 37, _msum("mbm"))
+va("vmsumuhm", 38, _msum("uhm"))
+va("vmsumuhs", 39, _msum("uhs"))
+va("vmsumshm", 40, _msum("shm"))
+va("vmsumshs", 41, _msum("shs"))
+
+
+def _mhadd(rnd):
+    def sem(s, f):
+        a = [sext(x, 16) for x in H(s.vr[f.ra])]
+        b = [sext(x, 16) for x in H(s.vr[f.rb])]
+        c = [sext(x, 16) for x in H(s.vr[f.vc])]
+        out, anys = [], False
+        for x, y, z in zip(a, b, c):
+            v, st = sat(((x * y + (0x4000 if rnd else 0)) >> 15) + z, -32768, 32767)
+            anys |= st
+            out.append(v)
+        s.set_v(f.rt, fromH(out))
+        _sat_note(s, anys)
+    return sem
+
+
+va("vmhaddshs", 32, _mhadd(False))
+va("vmhraddshs", 33, _mhadd(True))
+
+
+def _vmladduhm(s, f):
+    a, b, c = H(s.vr[f.ra]), H(s.vr[f.rb]), H(s.vr[f.vc])
+    s.set_v(f.rt, fromH([(x * y + z) & 0xFFFF for x, y, z in zip(a, b, c)]))
+
