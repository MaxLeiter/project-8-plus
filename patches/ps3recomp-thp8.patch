+/* Follow the default device: re-open the stream when it was invalidated or
+ * the default eConsole endpoint changed. Rate-limited; returns 1 if a stream
+ * is (still / again) open. */
+static int audio_backend_follow_default(int invalidated)
+{
+    ULONGLONG now = GetTickCount64();
+    if (!invalidated && now - s_wasapi_last_check < 2000) return s_wasapi_client != NULL;
+    if (invalidated && now - s_wasapi_last_check < 500) return 0;
+    s_wasapi_last_check = now;
+    WCHAR cur[512];
+    int have = wasapi_default_id(cur, sizeof cur / sizeof cur[0], NULL);
+    if (!invalidated && s_wasapi_client && have && wcscmp(cur, s_wasapi_dev_id) == 0)
+        return 1;
+    if (!have && !s_wasapi_client) return 0;
+    printf("[cellAudio] %s -- reopening the stream on the current default device\n",
+           invalidated ? "device invalidated" : "default device changed");
+    audio_backend_release();
+    if (audio_backend_init() < 0) { s_wasapi_last_check = now; return 0; }
+    return 1;
+}
