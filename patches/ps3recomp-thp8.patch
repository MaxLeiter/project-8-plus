+/* SPURS policy-module idle parking (perf).
+ *
+ * A persistent job-manager policy module (THP8/GH3's Neversoft PM) never
+ * exits while its workload stays selected: each lane loops lock job queue ->
+ * DMA in ~150 KB of job records -> scan -> DMA them back -> unlock ->
+ * cellSpursModulePoll, forever. On the console that is a dedicated SPE; here
+ * each lane is a host core, and the lanes hammer the queue mutex the PPU needs
+ * to submit work. At the poll, a lane whose last few passes ran no job code
+ * parks on the line of its last atomic (the queue mutex) until somebody other
+ * than its peer lanes writes it -- the PPU taking the mutex to submit or to
+ * check a job group -- a peer lane that found work kicks it, or the timeout.
+ *
+ * "Ran job code" = an indirect branch out of the PM image's LS range (a job
+ * body, an overlay) since the previous poll; spu_run_policy_module publishes
+ * the range per host thread.
+ *   SPURS_PM_IDLE_PARK=0       disable (default on)
+ *   SPURS_PM_IDLE_POLLS=<n>    consecutive job-less polls before parking (4)
+ *   SPURS_PM_IDLE_MS=<ms>      first park timeout (2)
+ *   SPURS_PM_IDLE_MS_MAX=<ms>  backoff cap (8): each park that times out with
+ *                              nobody writing the line doubles the next one;
+ *                              a write, a kick or a job resets it. An idle lane
+ *                              re-ran its whole poll (lock, ~150 KB of job
+ *                              records in and out, scan, unlock) every 2 ms --
+ *                              ~8% of a host core per lane in THP8's menus.
+ *                              Job submission takes the queue mutex the lane
+ *                              watches, so it still wakes the lane at once; the
+ *                              cap bounds what a writer that bypasses the
+ *                              coherence hooks can wait.
+ * The park uses the lane's ARMED watch (spu_coh_arm: re-armed at each of its
+ * lock-line atomics under the lock-line lock), so a non-peer write that landed
+ * after the lane's unlock but before the park ends the park at once instead of
+ * at the timeout. */
+static SPU_THREAD_LOCAL uint32_t t_pm_lo, t_pm_hi;
+static SPU_THREAD_LOCAL int      t_pm_tag;
+static SPU_THREAD_LOCAL unsigned t_pm_foreign, t_pm_foreign_seen, t_pm_idle;
+void spu_pm_set_range(uint32_t lo, uint32_t hi, int tag)
+{
+    t_pm_lo = lo; t_pm_hi = hi; t_pm_tag = tag;
+    t_pm_idle = 0; t_pm_foreign_seen = t_pm_foreign;
+}
+static int s_pm_park = -1, s_pm_park_polls = 4, s_pm_park_ms = 2, s_pm_park_ms_max = 8;
+/* Title hook (THP8: src/title/thp8_pm_native.c, PS3_SPURS_PM_WAKEFILTER): after a parked lane is woken by a
+ * write or a kick, return 1 if the job queue provably has nothing for it (read from guest memory AFTER the
+ * lane's watch was re-armed, so a later enqueue -- which takes the queue mutex and so writes the watched line
+ * -- still ends the next park). The lane then parks again instead of running a whole empty poll. Timeouts
+ * always poll. NULL = every wake polls (the old behaviour). */
+int (*g_spurs_pm_idle_filter)(spu_context* ctx) = 0;
+static SPU_THREAD_LOCAL unsigned t_pm_ms;
+/* PS3_GAME_STATS=<s>: lane poll / park counters plus the PPU-side
+ * cellSyncMutexLock counters (libs/sync/cellSync.c), one line every <s> s. */
+static int s_gs = -1;
+static volatile long s_gs_polls, s_gs_work, s_gs_parks, s_gs_wake, s_gs_tmo, s_gs_kick, s_gs_refilt;
+extern volatile long g_gs_pm_parked;   /* spu_coherency.c: lanes parked right now */
+#define GS_INC(x) do { if (s_gs > 0) __atomic_fetch_add(&(x), 1, __ATOMIC_RELAXED); } while (0)
+/* PS3_GAME_STATS: SPURS job-batch time per job binary. A batch runs from the first branch into job code after a
+ * PM poll to the next poll (the PM can run several jobs back to back; the batch is attributed to the first one's
+ * binary = FNV-1a of the 64 LS bytes at its entry, the same key PS3_CPATH uses: BC0392FD CPUSkinning, 550C2630
+ * JobQBVS, 29543EF6 ProcessPreCacheAnim, EB310CAF SortNodeList, 35ECF53C decompress). TSC ticks. */
+#if defined(_WIN32)
+#include <intrin.h>
+#elif defined(__x86_64__) || defined(__i386__)
+#include <x86intrin.h>
+#include <time.h>
+#else   /* no TSC (arm64, wasm): a nanosecond monotonic clock; the ticks-per-us calibration below adapts */
+#include <time.h>
+static inline unsigned long long ps3__tsc_ns(void)
+{ struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (unsigned long long)t.tv_sec * 1000000000ull + (unsigned long long)t.tv_nsec; }
+#define __rdtsc ps3__tsc_ns
+#endif
