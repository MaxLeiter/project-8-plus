+# ---------------------------------------------------------------------------
+# loads / stores
+# ---------------------------------------------------------------------------
+
+def _ea(s, f):
+    base = s.gpr[f.ra] if f.ra else 0
+    return (base + s.gpr[f.rb]) & MASK64
+
+
+def _lvx(s, f):
+    ea = _ea(s, f) & ~15
+    s.set_v(f.rt, s.load(ea, 16))
+
+
+def _stvx(s, f):
+    ea = _ea(s, f) & ~15
+    s.store(ea, s.vr[f.rt])
+
+
+def _lve(size):
+    def sem(s, f):
+        ea = _ea(s, f) & ~(size - 1)
+        k = ea & 15
+        data = s.load(ea, size)
+        v = bytearray(16)
+        v[k:k + size] = data
+        s.set_v(f.rt, bytes(v))
+        m = ((1 << 128) - 1) ^ (((1 << (8 * size)) - 1) << (8 * (16 - k - size)))
+        s.dontcare(("vr", f.rt), m)          # other elements undefined
+    return sem
+
+
+def _stve(size):
+    def sem(s, f):
+        ea = _ea(s, f) & ~(size - 1)
+        k = ea & 15
+        s.store(ea, s.vr[f.rt][k:k + size])
+    return sem
+
+
+def _lvsl(s, f):
+    sh = _ea(s, f) & 15
+    s.set_v(f.rt, bytes(sh + i for i in range(16)))
+
+
+def _lvsr(s, f):
+    sh = _ea(s, f) & 15
+    s.set_v(f.rt, bytes(16 - sh + i for i in range(16)))
+
+
+def _lvlx(s, f):
+    ea = _ea(s, f)
+    sh = ea & 15
+    data = s.load(ea, 16 - sh)
+    s.set_v(f.rt, data + bytes(sh))
+
+
+def _lvrx(s, f):
+    ea = _ea(s, f)
+    sh = ea & 15
+    data = s.load(ea & ~15, sh) if sh else b""
+    s.set_v(f.rt, bytes(16 - sh) + data)
+
+
+def _stvlx(s, f):
+    ea = _ea(s, f)
+    sh = ea & 15
+    s.store(ea, s.vr[f.rt][:16 - sh])
+
+
+def _stvrx(s, f):
+    ea = _ea(s, f)
+    sh = ea & 15
+    if sh:
+        s.store(ea & ~15, s.vr[f.rt][16 - sh:])
+
+
