+/* a value next to x: same, +-1..3 in the bit pattern */
+static uint32_t near32(uint32_t x) { static const int d[] = { 0, 0, 1, -1, 2, -2, 3 }; return x + (uint32_t)PICK(d); }
+static uint64_t near64(uint64_t x) { static const int d[] = { 0, 0, 1, -1, 2, -2, 3 }; return x + (uint64_t)(int64_t)PICK(d); }
