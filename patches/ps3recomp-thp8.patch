+import ppu_codegen_opt as _cg
 
 # ---------------------------------------------------------------------------
 # Lifter context
@@ -163,6 +165,50 @@ extern const uint64_t  function_table_count;  /* entries, excluding sentinel */
 
 """
 
+# Opt-in mod-hook guard, appended to the header unless --no-fn-entry. Every
+# lifted function (HLE import stubs excepted) opens with PPU_FN_ENTRY(i) on its
+# signature line, i = its index in function_table[]. The marker sits on the
+# signature line, not a line of its own, so line numbers, the chunk split and
+# with it every translation unit's contents stay exactly what they were.
+#
+# Default build: PPU_FN_ENTRY expands to ((void)0), which emits no code, so the
+# compiled result is the unhooked lift's. -DPPU_MOD_HOOKS turns it into a
+# one-byte test of function_table_hook_flags[i] (defined next to
+# function_table[] in the table chunk, also under PPU_MOD_HOOKS). The byte is
+# nonzero only for a hooked function; that entry calls ppu_hook_enter
+# (runtime/ppu/ppu_mod_hooks.cpp), which runs the hook chain and returns 1, or
+# returns 0 to let the original body run (the chain's call_next). The guard is
+# the function's first statement, so every way in passes it: bl, tail call /
+# trampoline, ps3_indirect_call, thread entry, guest callbacks, and copies of
+# the body clang inlined into a caller.
+FN_ENTRY_PREAMBLE = """\
+/* Mod hooks (opt-in): every lifted function opens with PPU_FN_ENTRY(i), i =
