+#!/usr/bin/env bash
+# Cross-build the web launcher for Windows / Linux / macOS with zig. Usage: build.sh <zig> [outdir]
+set -e
+Z=${1:?zig path}; O=${2:-$(dirname "$0")/out}; S=$(dirname "$0")/serve.c
+mkdir -p "$O"
+"$Z" cc -O2 -s -target x86_64-windows-gnu  "$S" -lws2_32 -o "$O/serve.exe"
+"$Z" cc -O2 -s -target x86_64-linux-musl   "$S" -o "$O/serve-linux-x64"
+"$Z" cc -O2 -s -target aarch64-linux-musl  "$S" -o "$O/serve-linux-arm64"
+"$Z" cc -O2 -s -target aarch64-macos       "$S" -o "$O/serve-macos-arm64"
+"$Z" cc -O2 -s -target x86_64-macos        "$S" -o "$O/serve-macos-x64"
+rm -f "$O"/*.pdb
+ls -la "$O"
