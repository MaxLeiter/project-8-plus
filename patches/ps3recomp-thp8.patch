+            case 3: a = mkf(s1, 60 + (int)(rnd() % 8), rfrac()); b = mkf(s2, 60 + (int)(rnd() % 8), rfrac());
+                    c = (rnd() & 1) ? mkf(rnd32() & 1, (int)(rnd() % 3), rnd32()) : near32(spu_ref_fm(a, b) ^ ((fms || fnms) ? 0 : 0x80000000u)); break;
