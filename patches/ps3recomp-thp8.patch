+}
+
+static double lds_gen_fpr_raw(LdsRng* r)
+{
+    uint32_t k = lds_below(r, 100);
+    uint64_t b;
+    double d;
+    if (k < 20) return (double)((int32_t)lds_below(r, 4096) - 2048) / 8.0;
+    if (k < 36) return (double)(float)(((double)(lds_next(r) >> 11) / 9007199254740992.0) * 2000.0 - 1000.0);
+    if (k < 42) return 0.0;
+    if (k < 46) b = 0x8000000000000000ull;                                   /* -0.0     */
+    else if (k < 50) b = 0x7FF0000000000000ull;                              /* +inf     */
+    else if (k < 53) b = 0xFFF0000000000000ull;                              /* -inf     */
+    else if (k < 58) b = 0x7FF8000000000000ull | (lds_next(r) & 0x0007FFFFFFFFFFFFull)
+                         | ((lds_next(r) & 1) << 63);                         /* qNaN     */
+    else if (k < 61) b = 0x7FF0000000000001ull | (lds_next(r) & 0x0007FFFFFFFFFFFFull);   /* sNaN */
+    else if (k < 66) b = (lds_next(r) & 0x800FFFFFFFFFFFFFull);              /* denormal */
+    else if (k < 69) b = (lds_next(r) & 1) ? 0x7FEFFFFFFFFFFFFFull : 0x0010000000000000ull;
+    else if (k < 74) { float f; uint32_t fb = (uint32_t)lds_next(r) & 0x807FFFFFu;      /* float denormal */
