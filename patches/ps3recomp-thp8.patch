+        msg_bytes(m, e->SemanticName, (u32)strlen(e->SemanticName));
+        msg_u32(m, e->SemanticIndex); msg_u32(m, e->Format); msg_u32(m, e->InputSlot); msg_u32(m, e->AlignedByteOffset);
+        msg_u32(m, e->InputSlotClass); msg_u32(m, e->InstanceDataStepRate);
+    }
+    msg_u32(m, d->IBStripCutValue); msg_u32(m, d->PrimitiveTopologyType); msg_u32(m, d->NumRenderTargets);
+    for (int i = 0; i < 8; i++) msg_u32(m, d->RTVFormats[i]);
+    msg_u32(m, d->DSVFormat); msg_u32(m, d->SampleDesc.Count ? d->SampleDesc.Count : 1);
+    ring_post(m);
+    free(mm.w);
+    *out = &p->iface;
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE dev_create_cs_pso(ID3D12Device* t, const D3D12_COMPUTE_PIPELINE_STATE_DESC* d, REFIID iid, void** out)
+{
+    (void)t; (void)iid;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC dummy; (void)dummy;
+    if (!d || !d->pRootSignature) return E_INVALIDARG;
+    if (!s_pso_vtbl.QueryInterface) { s_pso_vtbl.QueryInterface = pso_qi; s_pso_vtbl.AddRef = pso_addref; s_pso_vtbl.Release = pso_release;
+        s_pso_vtbl.SetName = pso_set_name; s_pso_vtbl.GetCachedBlob = pso_get_cached_blob; WGS_CHILD_SLOTS(s_pso_vtbl); wgs_fill_vtbl(&s_pso_vtbl, sizeof s_pso_vtbl); }
+    wgs_pso* p = (wgs_pso*)wgs_zalloc(sizeof *p);
+    p->iface.lpVtbl = &s_pso_vtbl; p->refs = 1; p->id = wgs_new_id(); p->compute = 1;
+    wgs_msg mm = {0}, *m = &mm;
+    msg_begin(m, WGS_CREATE_CS_PSO); msg_u32(m, p->id); msg_u32(m, ((wgs_rootsig*)d->pRootSignature)->id);
+    msg_shader(m, d->CS.pShaderBytecode, d->CS.BytecodeLength);
+    ring_post(m);
+    free(mm.w);
+    *out = &p->iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE dev_create_fence(ID3D12Device* t, UINT64 init, D3D12_FENCE_FLAGS fl, REFIID iid, void** out)
+{
+    (void)t; (void)fl; (void)iid;
+    static int vt;
+    if (!vt) { s_fence_vtbl.QueryInterface = fence_qi; s_fence_vtbl.AddRef = fence_addref; s_fence_vtbl.Release = fence_release;
+               s_fence_vtbl.GetCompletedValue = fence_get; s_fence_vtbl.SetEventOnCompletion = fence_on_completion;
+               s_fence_vtbl.Signal = fence_signal; s_fence_vtbl.SetName = fence_set_name; WGS_CHILD_SLOTS(s_fence_vtbl); wgs_fill_vtbl(&s_fence_vtbl, sizeof s_fence_vtbl); vt = 1; }
+    wgs_fence* f = (wgs_fence*)wgs_zalloc(sizeof *f);
+    f->iface.lpVtbl = &s_fence_vtbl; f->refs = 1; f->id = wgs_new_id(); f->completed = init;
+    *out = &f->iface;
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE dev_create_query_heap(ID3D12Device* t, const D3D12_QUERY_HEAP_DESC* d, REFIID iid, void** out)
+{ (void)t; (void)d; (void)iid; *out = &unk_new(1)->iface; return S_OK; }
+static HRESULT STDMETHODCALLTYPE dev_check_feature(ID3D12Device* t, D3D12_FEATURE f, void* data, UINT size)
+{ (void)t; (void)f; if (data) memset(data, 0, size); return E_INVALIDARG; }
+static HRESULT STDMETHODCALLTYPE dev_create_queue(ID3D12Device* t, const D3D12_COMMAND_QUEUE_DESC* d, REFIID iid, void** out);
+static HRESULT STDMETHODCALLTYPE dev_create_alloc(ID3D12Device* t, D3D12_COMMAND_LIST_TYPE type, REFIID iid, void** out);
+static HRESULT STDMETHODCALLTYPE dev_create_list(ID3D12Device* t, UINT mask, D3D12_COMMAND_LIST_TYPE type, ID3D12CommandAllocator* a,
+                                                 ID3D12PipelineState* pso, REFIID iid, void** out);
+
+HRESULT WINAPI D3D12CreateDeviceVKD3D(IUnknown* adapter, D3D_FEATURE_LEVEL level, REFIID iid, void** device, enum vkd3d_api_version v)
+{
+    (void)adapter; (void)level; (void)iid; (void)v;
+    ID3D12DeviceVtbl* t = &s_dev_vtbl;
+    if (!t->QueryInterface) {
+        t->QueryInterface = dev_qi; t->AddRef = dev_addref; t->Release = dev_release;
+        t->GetPrivateData = dev_get_priv; t->SetPrivateData = dev_set_priv; t->SetName = dev_set_name;
+        t->GetNodeCount = dev_node_count; t->CreateCommandQueue = dev_create_queue; t->CreateCommandAllocator = dev_create_alloc;
+        t->CreateGraphicsPipelineState = dev_create_gfx_pso; t->CreateComputePipelineState = dev_create_cs_pso;
+        t->CreateCommandList = dev_create_list; t->CheckFeatureSupport = dev_check_feature;
+        t->CreateDescriptorHeap = dev_create_dheap; t->GetDescriptorHandleIncrementSize = dev_inc;
+        t->CreateRootSignature = dev_create_rootsig; t->CreateConstantBufferView = dev_cbv; t->CreateShaderResourceView = dev_srv;
+        t->CreateUnorderedAccessView = dev_uav; t->CreateRenderTargetView = dev_rtv; t->CreateDepthStencilView = dev_dsv;
+        t->CreateSampler = dev_sampler; t->CopyDescriptors = dev_copy; t->CopyDescriptorsSimple = dev_copy_simple;
+        t->GetResourceAllocationInfo = dev_alloc_info; t->CreateCommittedResource = dev_create_committed;
+        t->CreateHeap = dev_create_heap; t->CreatePlacedResource = dev_create_placed; t->CreateFence = dev_create_fence;
+        t->GetDeviceRemovedReason = dev_removed; t->GetCopyableFootprints = dev_footprints; t->CreateQueryHeap = dev_create_query_heap;
+        t->GetAdapterLuid = dev_luid;
+        WGS_OBJECT_SLOTS(*t); wgs_fill_vtbl(t, sizeof *t);
+        s_device.iface.lpVtbl = t; s_device.refs = 1;
+        wgs_msg* m = &t_msg; msg_begin(m, WGS_BEGIN); msg_u32(m, WGS_MAGIC); msg_u32(m, s_ring.flags); ring_post(m);
+    }
+    if (device) { dev_addref(&s_device.iface); *device = &s_device.iface; }
+    return S_OK;
+}
diff --git a/libs/video/webgpu/d3d12_webgpu_dxgi.inc b/libs/video/webgpu/d3d12_webgpu_dxgi.inc
new file mode 100644
index 00000000..b54e6bac
--- /dev/null
+++ b/libs/video/webgpu/d3d12_webgpu_dxgi.inc
@@ -0,0 +1,159 @@
+/* d3d12_webgpu_dxgi.inc -- the DXGI subset: a factory and a swap chain whose back buffers the worker presents to
+ * the page's canvas (included by d3d12_webgpu.c). Mirrors rsx_live_draw_vkd3d.c's minimal DXGI. */
+
+static HRESULT STDMETHODCALLTYPE q_get_device(ID3D12CommandQueue* t, REFIID iid, void** out)
+{ (void)t; (void)iid; dev_addref(&s_device.iface); *out = &s_device.iface; return S_OK; }
+
+#define WGS_SC_BUFFERS 4
+typedef struct wgs_swapchain {
+    IDXGISwapChain3 iface;
+    volatile LONG refs;
+    ID3D12Resource* buf[WGS_SC_BUFFERS];
+    UINT count, index, width, height;
+    DXGI_FORMAT format;
+    u64 presents;
+    volatile u64 presented __attribute__((aligned(8)));   /* the worker stores the count it has shown */
+} wgs_swapchain;
+static wgs_swapchain* sc_of(IDXGISwapChain3* i) { return (wgs_swapchain*)i; }
+
+static HRESULT STDMETHODCALLTYPE sc_qi(IDXGISwapChain3* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_IDXGISwapChain) || iid_eq(r, &IID_IDXGISwapChain1) || iid_eq(r, &IID_IDXGISwapChain3)) {
+        t->lpVtbl->AddRef(t); *o = t; return S_OK;
+    }
+    *o = NULL; return E_NOINTERFACE;      /* SwapChain2 (frame latency waitable): not offered */
+}
+static ULONG STDMETHODCALLTYPE sc_addref(IDXGISwapChain3* t) { return (ULONG)__atomic_add_fetch(&sc_of(t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE sc_release(IDXGISwapChain3* t)
+{
+    wgs_swapchain* s = sc_of(t);
+    const LONG n = __atomic_sub_fetch(&s->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) { for (UINT i = 0; i < s->count; i++) if (s->buf[i]) s->buf[i]->lpVtbl->Release(s->buf[i]); free(s); }
+    return (ULONG)n;
+}
+static HRESULT STDMETHODCALLTYPE sc_present(IDXGISwapChain3* t, UINT sync, UINT flags)
+{
+    (void)flags;
+    wgs_swapchain* s = sc_of(t);
+    const u64 count = ++s->presents;
+    wgs_msg* m = &t_msg;
+    msg_begin(m, WGS_PRESENT); msg_u32(m, res_of(s->buf[s->index])->id); msg_u32(m, sync);
+    msg_u32(m, (u32)(uintptr_t)&s->presented); msg_u32(m, (u32)count);
+    ring_post(m);
+    s->index = (s->index + 1) % s->count;
+#ifndef WGS_RECORD
+    /* at most two frames queued ahead of the display (the worker presents on requestAnimationFrame) */
+    double w0 = 0;
+    for (;;) {
+        const u64 done = __atomic_load_n(&s->presented, __ATOMIC_ACQUIRE);
+        if (count <= done + 2) break;
+        if (!w0) w0 = wgs_now_ms();
+        wgs_wait32((volatile u32*)&s->presented, (u32)done, 4000000);
+    }
+    if (w0) {
+        wgs_stats_note(2, wgs_now_ms() - w0);
+#if defined(PS3_WASM)
+        FT_ADD(FT_W_PRESWAIT_US, (long long)((wgs_now_ms() - w0) * 1000.0));   /* PS3_SPIKE_MS */
+#endif
+    }
+#endif
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE sc_get_buffer(IDXGISwapChain3* t, UINT i, REFIID r, void** o)
+{
+    wgs_swapchain* s = sc_of(t);
+    if (i >= s->count || !s->buf[i]) return DXGI_ERROR_INVALID_CALL;
+    return s->buf[i]->lpVtbl->QueryInterface(s->buf[i], r, o);
+}
+static UINT STDMETHODCALLTYPE sc_index(IDXGISwapChain3* t) { return sc_of(t)->index; }
+/* The back buffers at the swap chain's current size / format / count (RENDER_TARGET-capable, the canvas source). */
+static void sc_make_buffers(wgs_swapchain* s)
+{
+    D3D12_RESOURCE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; rd.Width = s->width; rd.Height = s->height; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.Format = s->format; rd.SampleDesc.Count = 1; rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    for (UINT i = 0; i < s->count; i++) s->buf[i] = &resource_new(&rd, D3D12_HEAP_TYPE_DEFAULT)->iface;
+}
+/* ResizeBuffers: new back buffers (the worker blits whatever size it is given to the canvas, so the present pass can
+ * resolve straight to the canvas size). As in D3D12 the caller has released its references to the old buffers and
+ * the GPU is done with them (rsx_live_draw flushes first); the swap chain drops its own, which DESTROYs them in
+ * stream order. 0 / UNKNOWN keep the current count, size or format. WebGPU's default texture limit: 8192. */
+static HRESULT STDMETHODCALLTYPE sc_resize(IDXGISwapChain3* t, UINT count, UINT w, UINT h, DXGI_FORMAT f, UINT flags)
+{
+    (void)flags;
+    wgs_swapchain* s = sc_of(t);
+    const UINT nc = count ? (count < WGS_SC_BUFFERS ? count : WGS_SC_BUFFERS) : s->count;
+    const UINT nw = w ? w : s->width, nh = h ? h : s->height;
+    const DXGI_FORMAT nf = f != DXGI_FORMAT_UNKNOWN ? f : s->format;
+    if (nw > 8192 || nh > 8192) return DXGI_ERROR_INVALID_CALL;
+    if (nc == s->count && nw == s->width && nh == s->height && nf == s->format) return S_OK;
+    for (UINT i = 0; i < WGS_SC_BUFFERS; i++)
+        if (s->buf[i]) { s->buf[i]->lpVtbl->Release(s->buf[i]); s->buf[i] = NULL; }
+    WGS_LOG("swap chain %ux%u x%u -> %ux%u x%u\n", s->width, s->height, s->count, nw, nh, nc);
+    s->count = nc; s->width = nw; s->height = nh; s->format = nf; s->index = 0;
+    sc_make_buffers(s);
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE sc_get_desc1(IDXGISwapChain3* t, DXGI_SWAP_CHAIN_DESC1* d)
+{
+    wgs_swapchain* s = sc_of(t);
+    memset(d, 0, sizeof *d);
+    d->Width = s->width; d->Height = s->height; d->Format = s->format; d->SampleDesc.Count = 1;
+    d->BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT; d->BufferCount = s->count; d->SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    return S_OK;
+}
+static IDXGISwapChain3Vtbl s_sc_vtbl;
+
+typedef struct wgs_factory { IDXGIFactory4 iface; volatile LONG refs; } wgs_factory;
+static HRESULT STDMETHODCALLTYPE fac_qi(IDXGIFactory4* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_IDXGIFactory) || iid_eq(r, &IID_IDXGIFactory1) || iid_eq(r, &IID_IDXGIFactory2) ||
+        iid_eq(r, &IID_IDXGIFactory3) || iid_eq(r, &IID_IDXGIFactory4)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;      /* Factory5 (tearing): not offered -> the renderer presents with sync */
+}
+static ULONG STDMETHODCALLTYPE fac_addref(IDXGIFactory4* t) { return (ULONG)__atomic_add_fetch(&((wgs_factory*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE fac_release(IDXGIFactory4* t)
+{
+    const LONG n = __atomic_sub_fetch(&((wgs_factory*)t)->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) free(t);
+    return (ULONG)n;
+}
+static HRESULT STDMETHODCALLTYPE fac_create_sc_hwnd(IDXGIFactory4* t, IUnknown* device, HWND window, const DXGI_SWAP_CHAIN_DESC1* desc,
+    const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* fs, IDXGIOutput* output, IDXGISwapChain1** out)
+{
+    (void)t; (void)device; (void)window; (void)fs; (void)output;
+    if (!s_sc_vtbl.QueryInterface) {
+        s_sc_vtbl.QueryInterface = sc_qi; s_sc_vtbl.AddRef = sc_addref; s_sc_vtbl.Release = sc_release; s_sc_vtbl.Present = sc_present;
+        s_sc_vtbl.GetBuffer = sc_get_buffer; s_sc_vtbl.ResizeBuffers = sc_resize; s_sc_vtbl.GetDesc1 = sc_get_desc1;
+        s_sc_vtbl.GetCurrentBackBufferIndex = sc_index;
+        WGS_DXGI_SLOTS(s_sc_vtbl); *(void**)&s_sc_vtbl.GetDevice = (void*)wgs_child_get_device;
+        wgs_fill_vtbl(&s_sc_vtbl, sizeof s_sc_vtbl);
+    }
+    wgs_swapchain* s = (wgs_swapchain*)wgs_zalloc(sizeof *s);
+    s->iface.lpVtbl = &s_sc_vtbl; s->refs = 1;
+    s->count = desc->BufferCount ? (desc->BufferCount < WGS_SC_BUFFERS ? desc->BufferCount : WGS_SC_BUFFERS) : 2;
+    s->width = desc->Width ? desc->Width : 1280; s->height = desc->Height ? desc->Height : 720; s->format = desc->Format;
+    sc_make_buffers(s);
+    WGS_LOG("swap chain %ux%u x%u -> canvas\n", s->width, s->height, s->count);
+    *out = (IDXGISwapChain1*)&s->iface;
+    return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE fac_enum_by_luid(IDXGIFactory4* t, LUID l, REFIID r, void** o) { (void)t; (void)l; (void)r; *o = NULL; return DXGI_ERROR_NOT_FOUND; }
+static HRESULT STDMETHODCALLTYPE fac_enum1(IDXGIFactory1* t, UINT i, IDXGIAdapter1** o) { (void)t; (void)i; *o = NULL; return DXGI_ERROR_NOT_FOUND; }
+static IDXGIFactory4Vtbl s_fac_vtbl;
+
+HRESULT __stdcall CreateDXGIFactory1(REFIID riid, void** out)
+{
+    if (!s_fac_vtbl.QueryInterface) {
+        s_fac_vtbl.QueryInterface = fac_qi; s_fac_vtbl.AddRef = fac_addref; s_fac_vtbl.Release = fac_release;
+        s_fac_vtbl.CreateSwapChainForHwnd = fac_create_sc_hwnd; s_fac_vtbl.EnumAdapterByLuid = fac_enum_by_luid;
+        s_fac_vtbl.EnumAdapters1 = (void*)fac_enum1;
+        WGS_DXGI_SLOTS(s_fac_vtbl);
+        wgs_fill_vtbl(&s_fac_vtbl, sizeof s_fac_vtbl);
+    }
+    wgs_factory* f = (wgs_factory*)wgs_zalloc(sizeof *f);
+    f->iface.lpVtbl = &s_fac_vtbl; f->refs = 1;
+    const HRESULT hr = fac_qi(&f->iface, riid, out);
+    fac_release(&f->iface);
+    return hr;
+}
diff --git a/libs/video/webgpu/d3d12_webgpu_list.inc b/libs/video/webgpu/d3d12_webgpu_list.inc
new file mode 100644
index 00000000..eed49d36
--- /dev/null
+++ b/libs/video/webgpu/d3d12_webgpu_list.inc
@@ -0,0 +1,577 @@
+/* d3d12_webgpu_list.inc -- command allocators, command lists, the command queue, upload tracking
+ * (included by d3d12_webgpu.c). */
+
+/* ------------------------------------------------------------------------------------------------ upload tracking
+ * An upload-heap buffer's bytes reach the GPU as WGS_UPLOAD messages posted just before the EXECUTE that reads
+ * them. Ranges come from two sources:
+ *   hints:      wgs_hint_written(resource, off, size) from the renderer's ring writers (PS3_WASM hooks in
+ *               rsx_live_draw.c). A resource that has sent a hint is tracked by hints only.
+ *   references: for every other upload buffer, what the recorded commands read (vertex / index views, root
+ *               CBVs, copy sources) -- conservative but always correct.
+ * Ranges are merged per resource (the rings advance sequentially, so a frame collapses to a few spans). */
+typedef struct { u32 id; u64 lo, hi; } wgs_span;
+typedef struct { wgs_span* s; u32 n, cap; u32 last[16]; } wgs_spans;   /* last: index + 1 of the newest span per id & 15 */
+static void spans_add(wgs_spans* v, u32 id, u64 lo, u64 hi)
+{
+    if (hi <= lo) return;
+    /* the rings advance sequentially: try the newest span of this resource first (O(1)); with many spans (per-range
+     * hints: PS3_WASM_CBHINT / VBSKIP) a range that does not join it starts a new span without the full scan --
+     * at worst an overlap is uploaded twice from the same shadow bytes */
+    const u32 slot = id & 15u, li = v->last[slot];
+    if (li && li <= v->n) {
+        wgs_span* s = &v->s[li - 1];
+        if (s->id == id && lo <= s->hi + 4096 && hi + 4096 >= s->lo) {
+            if (lo < s->lo) s->lo = lo;
+            if (hi > s->hi) s->hi = hi;
+            return;
+        }
+    }
+    if (v->n <= 64)
+        for (u32 i = 0; i < v->n; i++) {
+            wgs_span* s = &v->s[i];
+            if (s->id == id && lo <= s->hi + 4096 && hi + 4096 >= s->lo) {    /* overlap or near: merge */
+                if (lo < s->lo) s->lo = lo;
+                if (hi > s->hi) s->hi = hi;
+                v->last[slot] = i + 1;
+                return;
+            }
+        }
+    if (v->n == v->cap) { v->cap = v->cap * 2 + 16; v->s = (wgs_span*)realloc(v->s, v->cap * sizeof *v->s); }
+    v->s[v->n++] = (wgs_span){ id, lo, hi };
+    v->last[slot] = v->n;
+}
+
+static wgs_spans s_hinted;                     /* hint ranges since the last ExecuteCommandLists (under s_hint_lock) */
+static pthread_mutex_t s_hint_lock = PTHREAD_MUTEX_INITIALIZER;
+static u8 s_hint_mode[WGS_MAX_MAPPABLE];       /* 1 = this upload resource is tracked by hints */
+
+void wgs_hint_written(ID3D12Resource* res, u64 off, u64 size)
+{
+    if (!res) return;
+    wgs_resource* r = res_of(res);
+    if (!r->shadow || r->id >= WGS_MAX_MAPPABLE) return;
+    s_hint_mode[r->id] = 1;
+    if (off >= r->size) return;
+    if (off + size > r->size) size = r->size - off;
+    pthread_mutex_lock(&s_hint_lock);
+    spans_add(&s_hinted, r->id, off, off + size);
+    pthread_mutex_unlock(&s_hint_lock);
+}
+
+static void post_upload(u32 id, u64 lo, u64 hi)
+{
+    wgs_resource* r = mappable_of(id);
+    if (!r || r->heap != D3D12_HEAP_TYPE_UPLOAD) return;
+    if (hi > r->size) hi = r->size;
+    lo &= ~3ull; hi = (hi + 3) & ~3ull; if (hi > r->size) hi = r->size;   /* writeBuffer wants 4-byte multiples */
+    while (lo < hi) {                                                  /* REF lengths are 32-bit */
+        const u64 n = hi - lo > 0x40000000ull ? 0x40000000ull : hi - lo;
+        wgs_msg* m = &t_msg;
+        msg_begin(m, WGS_UPLOAD); msg_u32(m, id); msg_u64(m, lo); msg_ref(m, r->shadow + lo, (u32)n);
+        ring_post(m);
+        lo += n;
+    }
+}
+
+/* ------------------------------------------------------------------------------------------------ allocators */
+#define WGS_CHUNK_WORDS (64u * 1024u)
+typedef struct wgs_alloc {
+    ID3D12CommandAllocator iface;
+    volatile LONG refs;
+    u32** chunks; u32 nchunks, cap;
+    u32 cur, used;                       /* next free word: chunks[cur][used] */
+} wgs_alloc;
+static HRESULT STDMETHODCALLTYPE al_qi(ID3D12CommandAllocator* t, REFIID r, void** o)
+{
+    if (iid_eq(r, &IID_IUnknown) || iid_eq(r, &IID_ID3D12CommandAllocator)) { t->lpVtbl->AddRef(t); *o = t; return S_OK; }
+    *o = NULL; return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE al_addref(ID3D12CommandAllocator* t) { return (ULONG)__atomic_add_fetch(&((wgs_alloc*)t)->refs, 1, __ATOMIC_RELAXED); }
+static ULONG STDMETHODCALLTYPE al_release(ID3D12CommandAllocator* t)
+{
+    wgs_alloc* a = (wgs_alloc*)t;
+    const LONG n = __atomic_sub_fetch(&a->refs, 1, __ATOMIC_ACQ_REL);
+    if (!n) { for (u32 i = 0; i < a->nchunks; i++) free(a->chunks[i]); free(a->chunks); free(a); }
+    return (ULONG)n;
+}
