+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>ps3recomp web</title>
+<style>
+  :root { color-scheme: dark; --bg: #0b0c10; --fg: #e8e8ea; --dim: #9a9aa3; --ok: #5ad19a; --warn: #f0b85a; --bad: #ff6b6b; }
+  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--fg);
+               font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
+  #stage { display: none; background: #000; text-align: center; position: relative; }
+  #stage canvas { display: inline-block; touch-action: none; outline: none; max-width: 100%; }
+  #hud { position: absolute; left: 8px; top: 6px; font: 12px ui-monospace, monospace; color: #9f9; text-shadow: 0 0 2px #000; }
+  #panel { max-width: 720px; margin: 0 auto; padding: 24px 16px; }
+  h1 { font-size: 20px; margin: 0 0 4px; }
+  .sub { color: var(--dim); margin: 0 0 20px; }
+  ul.checks { list-style: none; padding: 0; margin: 0 0 20px; }
+  ul.checks li { padding: 6px 0; border-bottom: 1px solid #1d1f26; display: flex; gap: 10px; }
+  ul.checks li b { min-width: 52px; }
+  .ok b { color: var(--ok); } .warn b { color: var(--warn); } .bad b { color: var(--bad); }
+  .note { color: var(--dim); font-size: 13px; }
+  pre#log { background: #111318; padding: 10px; border-radius: 6px; font-size: 12px; max-height: 40vh; overflow: auto;
+            white-space: pre-wrap; word-break: break-word; }
+  button { font: inherit; padding: 8px 16px; border-radius: 6px; border: 1px solid #3a3d48; background: #1a1c23;
+           color: var(--fg); cursor: pointer; }
+  button:disabled { opacity: .5; cursor: default; }
+  label { color: var(--dim); margin-left: 12px; }
+</style>
+</head>
+<body>
+<div id="stage"><canvas id="screen" width="1280" height="720"></canvas><div id="hud"></div></div>
+<div id="panel">
+  <h1 id="title">ps3recomp web</h1>
+  <p class="sub">Runs locally in your browser. Nothing is uploaded.</p>
+  <ul class="checks" id="checks"></ul>
+  <p>
+    <button id="start" disabled>Start</button>
+    <label>Resolution scale
+      <select id="scale"><option value="0.5">50%</option><option value="0.75">75%</option>
+        <option value="1" selected>100%</option><option value="1.5">150%</option><option value="2">200%</option></select>
+    </label>
+    <label><input type="checkbox" id="sound"> Sound</label>
+    <button id="savelog" title="Download the full log as a text file (stays on this computer)">Save log</button>
+  </p>
+  <p id="saves">
+    Saves: <button id="saveexport" title="Download all of this browser's saves as a .zip (native savedata folders)">Export saves</button>
+    <button id="saveimport" title="Import a .zip of savedata folders (from a native install or an earlier export)">Import .zip…</button>
+    <button id="saveimportdir" title="Import one savedata folder (the folder that holds PARAM.SFO)">Import folder…</button>
+    <input type="file" id="savefile" accept=".zip" multiple hidden>
+    <input type="file" id="savedir" webkitdirectory hidden>
+    <span class="sub" id="savenote">only before Start; you pick every file, nothing is read from your PC on its own</span>
+  </p>
+  <pre id="log"></pre>
+</div>
+<script type="module" src="boot.js"></script>
+</body>
+</html>
