+def _unpack(src, high):
+    get, _, bits = _SZ[src]
+    put = fromH if src == "b" else fromW
+
+    def sem(s, f):
+        v = get(s.vr[f.rb])
+        n = len(v) // 2
+        part = v[:n] if high else v[n:]
+        s.set_v(f.rt, put([sext(x, bits) for x in part]))
+    return sem
+
+
