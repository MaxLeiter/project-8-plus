+/* ===========================================================================
+ * 2. Signal-notification registers
+ * ===========================================================================*/
+static void test_snr(void)
+{
+    spu_context* c = new_ctx(2);
+
+    TEST("snr.overwrite");
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 0);
+    spu_snr_write(&c->ch_sig_notify[0], 0x10u, 0);
+    spu_snr_write(&c->ch_sig_notify[0], 0x20u, 0);   /* replaces, does not queue */
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 1);
+    CHECK_EQ(rd(c, SPU_RdSigNotify1), 0x20u);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 0);            /* the read cleared it */
+    spu_snr_write(&c->ch_sig_notify[0], 0x30u, 0);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 1);
+    CHECK_EQ(rd(c, SPU_RdSigNotify1), 0x30u);
+
+    TEST("snr.or");
+    spu_snr_write(&c->ch_sig_notify[1], 0x01u, 1);
+    spu_snr_write(&c->ch_sig_notify[1], 0x04u, 1);
+    spu_snr_write(&c->ch_sig_notify[1], 0x80000000u, 1);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify2), 1);
+    CHECK_EQ(rd(c, SPU_RdSigNotify2), 0x80000005u);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify2), 0);
+    spu_snr_write(&c->ch_sig_notify[1], 0x02u, 1);     /* read reset the register */
+    CHECK_EQ(rd(c, SPU_RdSigNotify2), 0x02u);
+
+    TEST("snr.independent");
+    spu_snr_write(&c->ch_sig_notify[0], 0xA, 0);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 1);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify2), 0);
+    CHECK_EQ(rd(c, SPU_RdSigNotify1), 0xAu);
+    /* Many writes between reads never build a queue (THP8: FMOD's PPU side
+     * signals the mixer's block number; a queue replays stale blocks). */
+    for (uint32_t i = 0; i < 100; i++) spu_snr_write(&c->ch_sig_notify[0], i, 0);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 1);
+    CHECK_EQ(rd(c, SPU_RdSigNotify1), 99u);
+    CHECK_EQ(cnt(c, SPU_RdSigNotify1), 0);
+    free_ctx(c);
+
+    blocking_read_case(SPU_RdSigNotify1, "snr.blocking-read1");
+    blocking_read_case(SPU_RdSigNotify2, "snr.blocking-read2");
+}
