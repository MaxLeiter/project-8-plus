index 00000000..c0e4c874
--- /dev/null
+++ b/libs/video/tests/test_gpu_vfetch.c
@@ -0,0 +1,233 @@
+/* test_gpu_vfetch.c -- bit-exactness of the GPU vertex fetch decoder (rsx_vp_decompile_gpufetch_ex HLSL)
+ * against the CPU path (rsx_vertex_element_index + rsx_vertex_decode_element), on the real GPU.
+ * Random guest bytes, every type 1..7, sizes 1..4 (and 5..15), unaligned offsets, strides, frequency
+ * divide/modulo, base index with 20-bit wrap, plus the vf_vid topology modes against the CPU index
+ * expansion. The decoder text is cut out of a decompiled VS, so the test runs the shipped HLSL.
+ * Build (Windows, clang-cl): clang-cl -O1 -clang:-ffp-contract=off -Ilibs/video -Iinclude libs/video/tests/test_gpu_vfetch.c
+ *   libs/video/rsx_vp_decompiler.c libs/video/rsx_vertex_compact.c libs/video/rsx_dispatch.c d3d12.lib d3dcompiler.lib dxguid.lib
+ * Needs a D3D12 GPU and ~600 MB RAM (272 MB guest buffer so every element address stays in range). */
+#define COBJMACROS
+#include <windows.h>
+#include <d3d12.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include "rsx_vertex_compact.h"
+#include "rsx_vertex_formats.h"
+#include "rsx_vp_decompiler.h"
+
+#define DATA_BYTES (272u << 20)
+#define NCASES 4096
+#define NV 256
+
+typedef struct { uint32_t attr[4]; uint32_t lim[4]; float def[4]; uint32_t draw[4]; } case_t;
+
+static uint32_t rng = 12345;
+static uint32_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+static ID3D12Device* dev; static ID3D12CommandQueue* q; static ID3D12CommandAllocator* al;
+static ID3D12GraphicsCommandList* cl; static ID3D12Fence* fe; static HANDLE ev; static UINT64 fv;
+
+static ID3D12Resource* buf(UINT64 size, D3D12_HEAP_TYPE ht, D3D12_RESOURCE_STATES st, D3D12_RESOURCE_FLAGS fl)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = ht;
+    D3D12_RESOURCE_DESC d = {0};
+    d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; d.Width = size; d.Height = 1; d.DepthOrArraySize = 1;
+    d.MipLevels = 1; d.SampleDesc.Count = 1; d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; d.Flags = fl;
+    ID3D12Resource* r = NULL;
+    if (FAILED(ID3D12Device_CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &d, st, NULL, &IID_ID3D12Resource, (void**)&r))) { printf("buf fail\n"); exit(1); }
+    return r;
+}
+static void run(void)
+{
+    HRESULT hc = ID3D12GraphicsCommandList_Close(cl);
+    if (FAILED(hc)) printf("Close failed 0x%08lX\n", (unsigned long)hc);
+    ID3D12CommandQueue_ExecuteCommandLists(q, 1, (ID3D12CommandList**)&cl);
+    ID3D12CommandQueue_Signal(q, fe, ++fv);
+    ID3D12Fence_SetEventOnCompletion(fe, fv, ev); WaitForSingleObject(ev, INFINITE);
+    { HRESULT rr = ID3D12Device_GetDeviceRemovedReason(dev); if (rr != S_OK) printf("device removed 0x%08lX\n", (unsigned long)rr); }
+    ID3D12CommandAllocator_Reset(al); ID3D12GraphicsCommandList_Reset(cl, al, NULL);
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    /* the shipped decoder text: decompile a 1-instruction VP (MOV o[0], v[0], end) */
+    static char vs[256 * 1024];
+    u8 vp[16] = {0};
+    {   /* d0..d3 little-endian words: vec op MOV(1) <<22 in d1, input v0, dst o0, mask xyzw, end */
+        u32 d0 = 0, d1 = (1u << 22) | (0u << 8), d2 = 0, d3 = 1u;
+        /* src0 = input reg (type 2) swizzle xyzw: src0 bits [d1 0-7] high part + d2 23-31 low part */
+        u32 src0 = (2u) | (0x1Bu << 9);   /* reg_type 2 (input) , swizzle bits approx */
+        d2 |= (src0 & 0x1FF) << 23; d1 |= (src0 >> 9) & 0xFF;
+        d3 |= (0u << 2) | (1u << 16) | (1u << 15) | (1u << 14) | (1u << 13);
+        d0 |= (1u << 30);  /* vec result -> output */
+        memcpy(vp + 0, &d0, 4); memcpy(vp + 4, &d1, 4); memcpy(vp + 8, &d2, 4); memcpy(vp + 12, &d3, 4);
+    }
+    int vi = rsx_vp_decompile_gpufetch_ex(vp, 16, 0, 0x0001, vs, sizeof(vs));
+    if (vi <= 0) { printf("decompile failed %d\n", vi); return 1; }
+    /* VS must compile as is */
+    ID3DBlob *blob = NULL, *err = NULL;
+    if (FAILED(D3DCompile(vs, strlen(vs), "vs", NULL, NULL, "main", "vs_5_0", 0, 0, &blob, &err))) {
+        printf("VS compile FAILED:\n%s\n----\n%s\n", err ? (char*)ID3D10Blob_GetBufferPointer(err) : "?", vs); return 1;
+    }
+    printf("VS compiles (%zu bytes DXBC)\n", (size_t)ID3D10Blob_GetBufferSize(blob));
+    const char* a = strstr(vs, "ByteAddressBuffer vf_data");
+    const char* b = strstr(vs, "VSOutput main(");
+    if (!a || !b) { printf("no decoder text\n"); return 1; }
+    static char cs[64 * 1024];
+    int n = snprintf(cs, sizeof cs,
+        "cbuffer VPConst : register(b0) { uint4 vf_attr[16]; uint4 vf_lim[16]; float4 vf_def[16]; uint4 vf_draw; };\n"
+        "%.*s\n"
+        "ByteAddressBuffer vids : register(t22);\n"
+        "RWByteAddressBuffer outp : register(u0);\n"
+        "[numthreads(64,1,1)] void main(uint3 id : SV_DispatchThreadID) {\n"
+        "  uint sv = vids.Load(id.x * 4u);\n"
+        "  uint vid = vf_vid(sv);\n"
+        "  float4 r = vf_fetch(0u, vid);\n"
+        "  outp.Store4(id.x * 20u, asuint(r)); outp.Store(id.x * 20u + 16u, vid);\n"
+        "}\n", (int)(b - a), a);
+    (void)n;
+    if (FAILED(D3DCompile(cs, strlen(cs), "cs", NULL, NULL, "main", "cs_5_0", 0, 0, &blob, &err))) {
+        printf("CS compile FAILED:\n%s\n", err ? (char*)ID3D10Blob_GetBufferPointer(err) : "?"); return 1;
+    }
+
+    if (getenv("DBG")) { ID3D12Debug* dbg; if (SUCCEEDED(D3D12GetDebugInterface(&IID_ID3D12Debug, (void**)&dbg))) ID3D12Debug_EnableDebugLayer(dbg); }
+    if (FAILED(D3D12CreateDevice(NULL, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev))) { printf("no device\n"); return 1; }
+    D3D12_COMMAND_QUEUE_DESC qd = {0};
+    ID3D12Device_CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&q);
+    ID3D12Device_CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&al);
+    ID3D12Device_CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, NULL, &IID_ID3D12GraphicsCommandList, (void**)&cl);
+    ID3D12Device_CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&fe);
+    ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+
+    D3D12_ROOT_PARAMETER rp[5] = {0};
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV; rp[0].Descriptor.ShaderRegister = 0;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[1].Descriptor.ShaderRegister = 20;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[2].Descriptor.ShaderRegister = 21;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[3].Descriptor.ShaderRegister = 22;
+    rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; rp[4].Descriptor.ShaderRegister = 0;
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0}; rsd.NumParameters = 5; rsd.pParameters = rp;
+    ID3DBlob* sig; ID3D12RootSignature* rs;
+    D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    ID3D12Device_CreateRootSignature(dev, 0, ID3D10Blob_GetBufferPointer(sig), ID3D10Blob_GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&rs);
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {0}; pd.pRootSignature = rs;
+    pd.CS.pShaderBytecode = ID3D10Blob_GetBufferPointer(blob); pd.CS.BytecodeLength = ID3D10Blob_GetBufferSize(blob);
+    ID3D12PipelineState* pso;
+    if (FAILED(ID3D12Device_CreateComputePipelineState(dev, &pd, &IID_ID3D12PipelineState, (void**)&pso))) { printf("pso fail\n"); return 1; }
+
+    /* LUT exactly as ld_vf_make_lut */
+    static float lut[RSX_VF_LUT_COUNT];
+    for (u32 i = 0; i < 256; i++) { const u8 bb = (u8)i; lut[RSX_VF_LUT_U8 + i] = bb / 255.0f; }
+    for (u32 i = 0; i < 65536; i++) { const s16 value = (s16)(u16)i; lut[RSX_VF_LUT_S16 + i] = value / 32767.0f; }
+    for (u32 i = 0; i < 2048; i++) { s32 x = (s32)i; if (x & 0x400) x -= 0x800; lut[RSX_VF_LUT_CMP11 + i] = (float)x / 1023.0f; }
+    for (u32 i = 0; i < 1024; i++) { s32 z = (s32)i; if (z & 0x200) z -= 0x400; lut[RSX_VF_LUT_CMP10 + i] = (float)z / 511.0f; }
+
+    u8* data = (u8*)malloc(DATA_BYTES + 64);
+    for (u32 i = 0; i < DATA_BYTES + 64; i += 4) { u32 x = rnd(); memcpy(data + i, &x, 4); }
+    /* sprinkle special halves/floats: denormals, inf, nan, -0 */
+    for (u32 i = 0; i < DATA_BYTES; i += 97) { u32 k = rnd() % 6; static const u8 sp[6][2] = {{0,1},{0x80,0x3},{0x7C,0},{0xFC,0},{0x7E,0x1},{0x80,0}}; data[i] = sp[k][0]; data[i + 1] = sp[k][1]; }
+
+    ID3D12Resource* dat = buf(DATA_BYTES + 64, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ, 0);
+    ID3D12Resource* lb = buf(sizeof(lut), D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ, 0);
+    ID3D12Resource* cbr = buf(NCASES * 1024ull, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ, 0);
+    ID3D12Resource* vidb = buf(NCASES * NV * 4ull, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ, 0);
+    ID3D12Resource* ob = buf(NCASES * NV * 20ull, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+    ID3D12Resource* rb = buf(NCASES * NV * 20ull, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_STATE_COPY_DEST, 0);
+    void* m; D3D12_RANGE r0 = {0, 0};
+    ID3D12Resource_Map(dat, 0, &r0, &m); memcpy(m, data, DATA_BYTES + 64);
+    ID3D12Resource_Map(lb, 0, &r0, &m); memcpy(m, lut, sizeof(lut));
+    u8* cbm; ID3D12Resource_Map(cbr, 0, &r0, (void**)&cbm);
+    u32* vm; ID3D12Resource_Map(vidb, 0, &r0, (void**)&vm);
+
+    /* cases */
+    static struct { u32 type, size, stride, freq, modulo, base_index, mode, first, lim; u64 prefix; } cs_[NCASES];
+    for (u32 c = 0; c < NCASES; c++) {
+        u32 type = 1 + rnd() % 7, size = (rnd() % 8 == 0) ? 5 + rnd() % 11 : 1 + rnd() % 4;
+        u32 elem = rsx_vertex_attrib_size(type, size);
+        u32 stride = (rnd() % 4 == 0) ? elem : elem + rnd() % 40;
+        if (stride > 255) stride = 255;
+        if (stride < elem) stride = elem;   /* the window path never sees stride < elem in practice */
+        u32 freq = (rnd() % 3 == 0) ? 2 + rnd() % 7 : rnd() % 2;
+        u32 modulo = rnd() & 1;
+        u32 base_index = (rnd() % 4 == 0) ? rnd() : rnd() % 1000;
+        u32 mode = rnd() % 5;
+        u32 first = rnd() % 2000;
+        u32 lim = (rnd() % 5 == 0) ? 50 + rnd() % 300 : 0xFFFFFFFFu;
+        u64 prefix = rnd() % 4096;      /* unaligned on purpose */
+        cs_[c].type = type; cs_[c].size = size; cs_[c].stride = stride; cs_[c].freq = freq; cs_[c].modulo = modulo;
+        cs_[c].base_index = base_index; cs_[c].mode = mode; cs_[c].first = first; cs_[c].lim = lim; cs_[c].prefix = prefix;
+        case_t k; memset(&k, 0, sizeof k);
+        k.attr[0] = (u32)prefix; k.attr[1] = stride; k.attr[2] = type | (size << 4) | (modulo << 8) | 0x200u; k.attr[3] = freq;
+        k.lim[0] = lim; k.def[0] = 7.0f; k.def[1] = 8.0f; k.def[2] = 9.0f; k.def[3] = 10.0f;
+        k.draw[0] = mode; k.draw[1] = first; k.draw[2] = base_index;
+        /* cbuffer: vf_attr[16] at 0, vf_lim[16] at 256, vf_def[16] at 512, vf_draw at 768 */
+        u8* cb = cbm + (size_t)c * 1024;
+        memset(cb, 0, 1024);
+        memcpy(cb + 0, k.attr, 16); memcpy(cb + 256, k.lim, 16); memcpy(cb + 512, k.def, 16); memcpy(cb + 768, k.draw, 16);
+        for (u32 i = 0; i < NV; i++) {
+            /* sv: for mode 0 an index value whose element stays inside the data; else an occurrence */
+            u32 sv = mode == 0 ? rnd() % 4000 : i;
+            vm[c * NV + i] = sv;
+        }
+    }
+    for (u32 c = 0; c < NCASES; c++) {
+        ID3D12GraphicsCommandList_SetComputeRootSignature(cl, rs);
+        ID3D12GraphicsCommandList_SetPipelineState(cl, pso);
+        ID3D12GraphicsCommandList_SetComputeRootConstantBufferView(cl, 0, ID3D12Resource_GetGPUVirtualAddress(cbr) + (UINT64)c * 1024);
+        ID3D12GraphicsCommandList_SetComputeRootShaderResourceView(cl, 1, ID3D12Resource_GetGPUVirtualAddress(dat));
+        ID3D12GraphicsCommandList_SetComputeRootShaderResourceView(cl, 2, ID3D12Resource_GetGPUVirtualAddress(lb));
+        ID3D12GraphicsCommandList_SetComputeRootShaderResourceView(cl, 3, ID3D12Resource_GetGPUVirtualAddress(vidb) + (UINT64)c * NV * 4);
+        ID3D12GraphicsCommandList_SetComputeRootUnorderedAccessView(cl, 4, ID3D12Resource_GetGPUVirtualAddress(ob) + (UINT64)c * NV * 20);
+        ID3D12GraphicsCommandList_Dispatch(cl, NV / 64, 1, 1);
+    }
+    D3D12_RESOURCE_BARRIER br = {0}; br.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; br.Transition.pResource = ob;
+    br.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS; br.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    br.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    ID3D12GraphicsCommandList_ResourceBarrier(cl, 1, &br);
+    ID3D12GraphicsCommandList_CopyResource(cl, rb, ob);
+    run();
+    u8* out; D3D12_RANGE rr = {0, NCASES * NV * 20ull};
+    ID3D12Resource_Map(rb, 0, &rr, (void**)&out);
+
+    u64 checked = 0, bad = 0, defs = 0;
+    for (u32 c = 0; c < NCASES; c++) {
+        for (u32 i = 0; i < NV; i++) {
+            const u32 sv = vm[c * NV + i];
+            /* CPU vid: mode 0 = sv; else first + occurrence of the expanded topology (write_topology_indices) */
+            u32 occ = sv;
+            const u32 t = sv / 3, j = sv % 3;
+            switch (cs_[c].mode) {
+            case 2: { const u32 tri[3] = { t + (t & 1u), t + 1u - (t & 1u), t + 2u }; occ = tri[j]; break; }
+            case 3: { const u32 tri[3] = { 0, t + 1u, t + 2u }; occ = tri[j]; break; }
+            case 4: { const u32 qd6[6] = {0, 1, 2, 2, 3, 0}; occ = (sv / 6) * 4 + qd6[sv % 6]; break; }
+            }
+            const u32 vid = cs_[c].mode == 0 ? sv : cs_[c].first + occ;
+            const u32 e = rsx_vertex_element_index(vid, cs_[c].base_index, cs_[c].freq, cs_[c].modulo);
+            float ref[4] = {7.0f, 8.0f, 9.0f, 10.0f};
+            int is_def = e > cs_[c].lim;
+            if (!is_def) {
+                const u64 addr = cs_[c].prefix + (u64)e * cs_[c].stride;
+                if (addr + 64 > DATA_BYTES) { continue; }  /* outside the test buffer: not representative */
+                if (!rsx_vertex_decode_element(cs_[c].type, cs_[c].size, data + addr, ref)) { printf("cpu decode fail\n"); return 1; }
+            } else defs++;
+            const u8* g = out + ((size_t)c * NV + i) * 20;
+            u32 gvid; memcpy(&gvid, g + 16, 4);
+            checked++;
+            if (memcmp(ref, g, 16) != 0 || gvid != vid) {
+                if (bad++ < 12) {
+                    float gf[4]; memcpy(gf, g, 16);
+                    printf("MISMATCH case %u i %u type %u size %u stride %u freq %u mod %u mode %u vid %u/%u e %u: cpu %08X %08X %08X %08X gpu %08X %08X %08X %08X\n",
+                           c, i, cs_[c].type, cs_[c].size, cs_[c].stride, cs_[c].freq, cs_[c].modulo, cs_[c].mode, vid, gvid, e,
+                           ((u32*)ref)[0], ((u32*)ref)[1], ((u32*)ref)[2], ((u32*)ref)[3],
+                           ((u32*)gf)[0], ((u32*)gf)[1], ((u32*)gf)[2], ((u32*)gf)[3]);
+                }
+            }
+        }
+    }
+    printf("checked %llu vertices (%llu default), mismatches %llu\n", (unsigned long long)checked,
+           (unsigned long long)defs, (unsigned long long)bad);
+    return bad ? 1 : 0;
+}
diff --git a/libs/video/tests/test_wasm_pacing.c b/libs/video/tests/test_wasm_pacing.c
new file mode 100644
index 00000000..25d2544c
--- /dev/null
+++ b/libs/video/tests/test_wasm_pacing.c
@@ -0,0 +1,126 @@
+/*
+ * Test for the WebAssembly host_pacing port (libs/video/host_pacing.c under PS3_WASM), in node with the cellGcm hooks
+ * stubbed. One scenario per process (the pacing config is resolved once), chosen by argv[1]:
+ *   none        no PS3_VBLANK_HZ / PS3_FLIP_HZ: must stay on the legacy ticker (inactive, vblank_hz 62.5, vsync 1)
+ *   v60 / v120  PS3_VBLANK_HZ=60 / 120: guest vblank rate within 1%, interval jitter p99 reported
+ *   f90         PS3_FLIP_HZ=90 (vblank 60 by default): flip clock 90 Hz, vblank 60 Hz
+ *   present     PS3_FLIP_HZ=present: flips complete on ps3_pacing_on_present (+ every vblank)
+ *   display     PS3_VBLANK_HZ=display: no monitor vblank in a worker -> 60 Hz timer
+ *   vsync0      PS3_VSYNC=0 alone: ticker unchanged (inactive), vsync reported 0
+ * Optional argv[2]: PS3_PACE_MARGIN_CAP_US (0 = the old ratchet margin); every rate line also prints the clock
+ * thread's spin share.
+ * Build: emcc -O2 -pthread -sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=4 -sEXIT_RUNTIME -DPS3_WASM -I libs/video \
+ *        -I runtime/platform libs/video/tests/test_wasm_pacing.c runtime/platform/win32_compat.c -o pacing.js
+ */
+#if !defined(__EMSCRIPTEN__)
+int main(void) { return 0; }
+#else
+#include "../host_pacing.c"
+#include <emscripten/emscripten.h>
+#include <math.h>
+
+/* ---- cellGcmSys stubs ------------------------------------------------------------------------------------- */
+static volatile LONG64 g_vb, g_ft, g_flip_waiting, g_flips_done;
+static double g_vb_t[4096]; static volatile int g_vb_n;
+static HANDLE g_kick;
+void  cellGcmTickVBlank(void)
+{
+    InterlockedIncrement64(&g_vb);
+    const int n = g_vb_n; if (n < 4096) { g_vb_t[n] = emscripten_get_now(); g_vb_n = n + 1; }
+}
+void  cellGcmTickFlip(void) { InterlockedIncrement64(&g_ft); if (InterlockedExchange64(&g_flip_waiting, 0)) InterlockedIncrement64(&g_flips_done); }
+int   cellGcm_tick_flip_if_waiting(void)
+{
+    InterlockedIncrement64(&g_ft);
+    if (InterlockedExchange64(&g_flip_waiting, 0)) { InterlockedIncrement64(&g_flips_done); return 1; }
+    return 0;
+}
+void* cellGcm_fifo_kick_event(void) { if (!g_kick) g_kick = CreateEventA(NULL, FALSE, FALSE, NULL); return g_kick; }
+unsigned cellGcm_flip_request_count(void) { return (unsigned)g_flips_done; }
+void  cellGcm_set_vblank_hz(double hz) { (void)hz; }
+long  cellGcm_waitflip_race_count(void) { return 0; }
+
+static int fails;
+static void sleep_ms(double ms) { const double t = emscripten_get_now() + ms; static volatile int w; while (emscripten_get_now() < t) emscripten_futex_wait((void*)&w, 0, t - emscripten_get_now()); }
+#define CHECK(c, ...) do { if (!(c)) { fails++; printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+static int cmpd(const void* a, const void* b) { double x = *(const double*)a, y = *(const double*)b; return (x > y) - (x < y); }
+
+static void rate(const char* what, double want_hz, double secs)
+{
+    const LONG64 v0 = g_vb, f0 = g_ft; const int n0 = g_vb_n; const double t0 = emscripten_get_now();
+    sleep_ms(secs * 1000.0);
+    const double dt = (emscripten_get_now() - t0) / 1000.0;
+    const double vhz = (double)(g_vb - v0) / dt, fhz = (double)(g_ft - f0) / dt;
+    const int n1 = g_vb_n;
+    static double iv[4096]; int m = 0;
+    for (int i = n0 + 1; i < n1; i++) iv[m++] = g_vb_t[i] - g_vb_t[i - 1];
+    qsort(iv, (size_t)m, sizeof iv[0], cmpd);
+    printf("  %s: vblank %.2f Hz, flip ticks %.2f Hz, interval ms p50 %.3f p99 %.3f max %.3f\n", what, vhz, fhz,
+           m ? iv[m / 2] : 0.0, m ? iv[m * 99 / 100] : 0.0, m ? iv[m - 1] : 0.0);
+    { static LONG64 sp0 = 0; const LONG64 sp1 = s_spin_ticks;
+      printf("  %s: clock thread spun %.1f%% of the time\n", what, (double)(sp1 - sp0) * 100.0 / ((double)s_freq * dt));
+      sp0 = sp1; }
+    if (want_hz > 0) CHECK(fabs(vhz - want_hz) < want_hz * 0.01, "%s vblank %.2f Hz, want %.2f", what, vhz, want_hz);
+}
+
+int main(int argc, char** argv)
+{
+    const char* sc = argc > 1 ? argv[1] : "none";
+    if (!strcmp(sc, "v60")) setenv("PS3_VBLANK_HZ", "60", 1);
+    else if (!strcmp(sc, "v120")) setenv("PS3_VBLANK_HZ", "120", 1);
+    else if (!strcmp(sc, "f90")) setenv("PS3_FLIP_HZ", "90", 1);
+    else if (!strcmp(sc, "present")) setenv("PS3_FLIP_HZ", "present", 1);
+    else if (!strcmp(sc, "display")) setenv("PS3_VBLANK_HZ", "display", 1);
+    else if (!strcmp(sc, "vsync0")) setenv("PS3_VSYNC", "0", 1);
+    if (argc > 2) setenv("PS3_PACE_MARGIN_CAP_US", argv[2], 1);   /* optional: margin cap (0 = ratchet) */
+    const int active = ps3_pacing_init();
+    printf("scenario %s: active %d vblank_hz %.2f flip_mode %d vsync %d\n", sc, active, ps3_pacing_vblank_hz(),
+           ps3_pacing_flip_mode(), ps3_pacing_vsync());
+    if (!strcmp(sc, "none") || !strcmp(sc, "vsync0")) {
+        CHECK(!active && !ps3_pacing_active(), "clock active without PS3_VBLANK_HZ / PS3_FLIP_HZ");
+        CHECK(ps3_pacing_vblank_hz() == 62.5, "legacy vblank_hz %.2f", ps3_pacing_vblank_hz());
+        CHECK(ps3_pacing_flip_mode() == PS3_FLIPCLK_VBLANK, "flip mode %d", ps3_pacing_flip_mode());
+        CHECK(ps3_pacing_vsync() == (strcmp(sc, "vsync0") ? 1 : 0), "vsync %d", ps3_pacing_vsync());
+        CHECK(!ps3_pacing_wait_flip_tick(1), "wait_flip_tick handled while inactive");
+        ps3_pacing_start(NULL);
+        const LONG64 v0 = g_vb; sleep_ms(200.0);
+        CHECK(g_vb == v0, "a clock ticked while inactive");
+    } else {
+        CHECK(active, "clock not active");
+        ps3_pacing_start(NULL);
+        sleep_ms(300.0);   /* settle */
+        if (!strcmp(sc, "v60") || !strcmp(sc, "display") || !strcmp(sc, "f90") || !strcmp(sc, "present")) rate(sc, 60.0, 3.0);
+        else if (!strcmp(sc, "v120")) rate(sc, 120.0, 3.0);
+        if (!strcmp(sc, "f90")) {
+            const LONG64 f0 = g_ft; const double t0 = emscripten_get_now();
+            sleep_ms(2000.0);
+            const double hz = (double)(g_ft - f0) * 1000.0 / (emscripten_get_now() - t0);
+            printf("  f90: flip clock %.2f Hz\n", hz);
+            CHECK(fabs(hz - 90.0) < 1.0, "flip clock %.2f Hz, want 90", hz);
+        }
+        if (!strcmp(sc, "present")) {
+            /* a flip waiting completes on the next present, not at the next vblank */
+            int ok = 0;
+            for (int k = 0; k < 50; k++) {
+                InterlockedExchange64(&g_flip_waiting, 1);
+                const LONG64 d0 = g_flips_done;
+                ps3_pacing_on_present();
+                if (g_flips_done == d0 + 1) ok++;
+                sleep_ms(3.0);
+            }
+            printf("  present: %d/50 flips completed by the present itself\n", ok);
+            CHECK(ok >= 45, "only %d/50 flips completed on present", ok);
+            /* a present with no flip waiting banks a credit: the next wait_flip_tick completes at once */
+            InterlockedExchange64(&g_flip_waiting, 0);
+            ps3_pacing_on_present();
+            InterlockedExchange64(&g_flip_waiting, 1);
+            const LONG64 d0 = g_flips_done;
+            const double t0 = emscripten_get_now();
+            CHECK(ps3_pacing_wait_flip_tick(5), "wait_flip_tick not handled");
+            printf("  credit: flip done %d in %.3f ms\n", (int)(g_flips_done - d0), emscripten_get_now() - t0);
+        }
+    }
+    printf("%s (%d failures)\n", fails ? "FAILED" : "ALL PASS", fails);
+    return fails != 0;
+}
+#endif
