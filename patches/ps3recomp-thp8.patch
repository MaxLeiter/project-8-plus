+// then the IO worker (data streaming), the device worker (WebGPU, OffscreenCanvas), the AudioWorklet and input.
+import { attachInput, HID } from "./input.js";
+import { classify } from "./screen.js";
+import * as saves from "./saves.js";
+
+const $ = (id) => document.getElementById(id);
+const logEl = $("log");
