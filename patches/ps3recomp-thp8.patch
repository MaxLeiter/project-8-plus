+}
+document.getElementById("savelog")?.addEventListener("click", saveLog);
+function check(level, name, text) {
+  const li = document.createElement("li");
+  li.className = level;
+  li.innerHTML = `<b>${level === "ok" ? "OK" : level === "warn" ? "NOTE" : "NO"}</b><span><strong>${name}</strong> &mdash; ${text}</span>`;
+  $("checks").appendChild(li);
