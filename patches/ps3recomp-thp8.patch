+
+/* One override index. Built once at start-up; ps3_mods_rescan() builds a new
+ * one and publishes it with a single pointer swap, so ps3_mods_resolve() never
+ * locks. A replaced index is retired, never freed (a reader may still be in
+ * it); that costs ~100 bytes per file per rescan. */
+typedef struct mods_index {
+    mods_entry* ent;
+    size_t      n, cap;
+    char**      packs;       /* pack names, sorted (owned) */
+    size_t      npacks;
+    size_t      nloose;
+    uint64_t    fp;          /* fingerprint of the active set, 0 = empty */
+} mods_index;
+
+static mods_index           g_boot_idx;              /* built by the one-time init */
+static mods_index* volatile g_idx = &g_boot_idx;     /* the published index */
+static char        g_root[MODS_PATH];
+static int         g_verbose;     /* PS3_MODS_VERBOSE: log every redirected open */
+
+static mods_index* mods_cur(void) { return (mods_index*)MODS_LOAD_PTR(&g_idx); }
+
+/* The title's PS3_MODS_RESET default (ps3_mods_set_reset_default). Plain
+ * zero-initialised storage with no dynamic initialisation, so the setter is
+ * safe from any static constructor in any TU, in any order. Read once, by
+ * mods_reset_check() inside the one-time init. */
+static char          g_reset_default[2048];
+static volatile long g_init_started;
+
+/* ---- helpers --------------------------------------------------------------- */
+
+static int ascii_ieq_n(const char* a, const char* b, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        unsigned char x = (unsigned char)a[i], y = (unsigned char)b[i];
+        if (toupper(x) != toupper(y)) return 0;
+        if (!x) return 1;
+    }
+    return 1;
+}
+
+static int ascii_icmp(const char* a, const char* b)
+{
+    for (;; a++, b++) {
+        int x = toupper((unsigned char)*a), y = toupper((unsigned char)*b);
+        if (x != y || !x) return x - y;
+    }
+}
+
+static char* mods_strdup(const char* s)
+{
+    size_t n = strlen(s) + 1;
+    char* d = (char*)malloc(n);
+    if (d) memcpy(d, s, n);
+    return d;
+}
+
+/* Normalise a relative path into a key: '/' separators, no empty or "."
+ * components, upper case. Refuses ".." (no escaping the root). */
+static int mods_norm(const char* in, char* out, size_t cap)
+{
+    size_t o = 0;
+    const char* p = in;
+    while (*p) {
+        while (*p == '/' || *p == '\\') p++;
+        if (!*p) break;
+        const char* s = p;
+        while (*p && *p != '/' && *p != '\\') p++;
+        size_t n = (size_t)(p - s);
+        if (n == 1 && s[0] == '.') continue;
+        if (n == 2 && s[0] == '.' && s[1] == '.') return 0;
+        if (o) { if (o + 1 >= cap) return 0; out[o++] = '/'; }
+        if (o + n >= cap) return 0;
+        for (size_t i = 0; i < n; i++) out[o++] = (char)toupper((unsigned char)s[i]);
+    }
+    if (!o) return 0;
+    out[o] = 0;
+    return 1;
+}
+
+/* snprintf that reports truncation: 1 if the whole string fit. */
+static int mods_fmt_ok(int n, size_t cap)
+{
+    return n >= 0 && (size_t)n < cap;
+}
+
+/* Guest path -> key (see the table at the top). 0 = not an overlayable path
+ * (or one too long to be a key: a truncated key could name another file). */
+static int mods_guest_key(const char* g, char* key, size_t cap)
+{
+    char tmp[MODS_PATH];
+    if (!g || g[0] != '/') return 0;
+    if (strncmp(g, "/dev_bdvd/", 10) == 0)
+        return mods_norm(g + 10, key, cap);
+    if (strncmp(g, "/app_home/", 10) == 0) {
+        if (!mods_fmt_ok(snprintf(tmp, sizeof tmp, "PS3_GAME/USRDIR/%s", g + 10), sizeof tmp)) return 0;
+        return mods_norm(tmp, key, cap);
+    }
+    if (strncmp(g, "/dev_hdd0/game/", 15) == 0) {
+        const char* t = g + 15;
+        while (*t == '/') t++;
+        const char* s = strpbrk(t, "/\\");
+        if (!s || s == t) return 0;
+        while (*s == '/' || *s == '\\') s++;
+        if (!ascii_ieq_n(s, "USRDIR", 6) || (s[6] != '/' && s[6] != '\\')) return 0;
+        if (!mods_fmt_ok(snprintf(tmp, sizeof tmp, "PS3_GAME/USRDIR/%s", s + 7), sizeof tmp)) return 0;
+        return mods_norm(tmp, key, cap);
+    }
+    return 0;
+}
+
+static int is_dir(const char* p)
+{
+    mods_stat_t st;
+    return p && *p && MODS_STAT(p, &st) == 0 && (st.st_mode & MODS_IFMT) == MODS_IFDIR;
+}
+
+static void mods_add(mods_index* ix, const char* key, const char* host, const mods_stat_t* st, int prio,
+                     const char* src)
+{
+    if (ix->n == ix->cap) {
+        size_t nc = ix->cap ? ix->cap * 2 : 256;
+        mods_entry* ne = (mods_entry*)realloc(ix->ent, nc * sizeof *ne);
+        if (!ne) return;
+        ix->ent = ne; ix->cap = nc;
+    }
+    mods_entry* e = &ix->ent[ix->n];
+    memset(e, 0, sizeof *e);
+    e->key = mods_strdup(key);
+    e->host = mods_strdup(host);
+    if (!e->key || !e->host) { free(e->key); free(e->host); return; }
+    e->src = src;
+    e->size = (uint64_t)st->st_size;
+    e->mtime = (int64_t)st->st_mtime;
+    e->prio = prio;
+    ix->n++;
+}
+
+/* Index every regular file under host_dir; keys are key_prefix + relative path. */
+static void mods_walk(mods_index* ix, const char* host_dir, const char* key_prefix, int prio, const char* src,
+                      int depth)
+{
+    if (depth > 24) {
+        fprintf(stderr, "[mods] '%s' is nested too deep: not indexed [%s]\n", host_dir, src);
+        return;
+    }
+    DIR* d = opendir(host_dir);
+    if (!d) return;
+    struct dirent* e;
+    while ((e = readdir(d)) != NULL) {
+        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
+        char hp[MODS_PATH], kp[MODS_PATH], key[MODS_PATH];
+        /* A truncated path would index the wrong file (or a wrong key): skip it, loudly. */
+        if (!mods_fmt_ok(snprintf(hp, sizeof hp, "%s/%s", host_dir, e->d_name), sizeof hp) ||
+            !mods_fmt_ok(snprintf(kp, sizeof kp, "%s%s%s", key_prefix, *key_prefix ? "/" : "", e->d_name), sizeof kp)) {
+            fprintf(stderr, "[mods] path too long, skipped: '%s/%s' [%s]\n", host_dir, e->d_name, src);
+            continue;
+        }
+        mods_stat_t st;
+        if (MODS_STAT(hp, &st) != 0) continue;
+        if ((st.st_mode & MODS_IFMT) == MODS_IFDIR) mods_walk(ix, hp, kp, prio, src, depth + 1);
+        else if ((st.st_mode & MODS_IFMT) == MODS_IFREG) {
+            if (mods_norm(kp, key, sizeof key)) mods_add(ix, key, hp, &st, prio, src);
+            else fprintf(stderr, "[mods] '%s': not a usable key, skipped [%s]\n", hp, src);
+        }
+    }
+    closedir(d);
+}
+
+/* Case-insensitive lookup of a sub-DIRECTORY `name` of `parent`; writes its
+ * host path to out. 0 if there is none. */
+static int find_child_dir(const char* parent, const char* name, char* out, size_t cap)
+{
+    DIR* d = opendir(parent);
+    if (!d) return 0;
+    struct dirent* e;
+    int found = 0;
+    while (!found && (e = readdir(d)) != NULL) {
+        if (ascii_icmp(e->d_name, name) != 0) continue;
+        if (!mods_fmt_ok(snprintf(out, cap, "%s/%s", parent, e->d_name), cap)) continue;
+        found = is_dir(out);
+    }
+    closedir(d);
+    return found;
+}
+
+static int cmp_entry(const void* a, const void* b)
+{
+    const mods_entry* x = (const mods_entry*)a;
+    const mods_entry* y = (const mods_entry*)b;
+    int c = strcmp(x->key, y->key);
+    if (c) return c;
+    return (y->prio > x->prio) - (y->prio < x->prio);   /* higher priority first */
+}
+
+static int cmp_name(const void* a, const void* b)
+{
+    return ascii_icmp(*(char* const*)a, *(char* const*)b);
+}
+
+/* Directory the executable lives in ("" if unknown). */
+static void exe_dir(char* out, size_t cap)
+{
+    out[0] = 0;
+#ifdef _WIN32
+    DWORD n = GetModuleFileNameA(NULL, out, (DWORD)cap);
+    if (n == 0 || n >= cap) { out[0] = 0; return; }
+    /* The ANSI API turns characters outside the code page into '?', which can
+     * never be part of a real Windows path: say so instead of silently looking
+     * for a mods folder that cannot be found. */
+    if (strchr(out, '?')) {
+        fprintf(stderr, "[mods] executable path '%s' has characters outside the ANSI code page: "
+                        "no default <exe dir>/mods (set PS3_MODS_ROOT)\n", out);
+        out[0] = 0;
+        return;
+    }
+#else
+    ssize_t n = readlink("/proc/self/exe", out, cap - 1);
+    if (n <= 0) { out[0] = 0; return; }
+    out[n] = 0;
+#endif
+    for (char* p = out; *p; p++) if (*p == '\\') *p = '/';
+    char* s = strrchr(out, '/');
+    if (s) *s = 0; else out[0] = 0;
+}
+
+/* FNV-1a over (key, size, mtime) of the active set; 0 for an empty set. */
+static uint64_t mods_fingerprint(const mods_index* ix)
+{
+    if (!ix->n) return 0;
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < ix->n; i++) {
+        const mods_entry* e = &ix->ent[i];
+        for (const char* k = e->key; ; k++) { h = (h ^ (uint8_t)*k) * 1099511628211ull; if (!*k) break; }
+        uint64_t v[2] = { e->size, (uint64_t)e->mtime };
+        const uint8_t* b = (const uint8_t*)v;
+        for (size_t j = 0; j < sizeof v; j++) h = (h ^ b[j]) * 1099511628211ull;
+    }
+    return h ? h : 1;
+}
+
+/* PS3_MODS_RESET: when the active set changed since the last run, delete the
+ * named /dev_hdd0 files (a title's cache index) and record the new state.
+ *
+ * State file, first line:
+ *   (no file)               no reset recorded yet: treated as the empty set, so
+ *                           a vanilla boot never deletes anything
+ *   fingerprint=<hex>       the set the caches were last reset for
+ *   fingerprint=retry       (or anything unreadable) the last reset could not
+ *                           delete every target: reset again on this boot,
+ *                           whatever the set is now
+ * It is rewritten with the new fingerprint only when every target was deleted
+ * or was already absent. A target that could not be deleted (locked by a
+ * scanner, read-only, a directory, ...) leaves "retry" behind instead, so the
+ * cache is not trusted until a later boot manages the delete. */
+static void mods_reset_check(void)
+{
+    const mods_index* ix = &g_boot_idx;
+    const char* env = getenv("PS3_MODS_RESET");
+    const int   from_env = env != NULL;
+    const char* list = from_env ? env : g_reset_default;
+    if (!*list || strcmp(list, "0") == 0 || ascii_icmp(list, "off") == 0 || ascii_icmp(list, "none") == 0)
+        return;
+    const char* hdd = getenv("PS3_HDD0_ROOT");
+    if (!hdd || !*hdd) {
+        /* The title default is always there; only complain when it matters. */
+        if (from_env || ix->n)
+            fprintf(stderr, "[mods] PS3_MODS_RESET%s ignored: PS3_HDD0_ROOT is not set\n",
+                    from_env ? "" : " (title default)");
+        return;
+    }
+    char state[MODS_PATH];
+    if (!mods_fmt_ok(snprintf(state, sizeof state, "%s/ps3recomp_mods_state.txt", hdd), sizeof state)) {
+        fprintf(stderr, "[mods] PS3_MODS_RESET ignored: PS3_HDD0_ROOT is too long\n");
+        return;
+    }
+    unsigned long long prev = 0;
+    int prev_ok = 1;                       /* no state file = empty set, nothing to reset */
+    FILE* f = fopen(state, "rb");
+    if (f) {
+        char line[128];
+        prev_ok = fgets(line, sizeof line, f) != NULL && sscanf(line, "fingerprint=%llx", &prev) == 1;
+        fclose(f);
+    }
+    if (prev_ok && (uint64_t)prev == ix->fp) return;
+
+    if (prev_ok)
+        fprintf(stderr, "[mods] active mod set changed (fingerprint %016llx -> %016llx): resetting title caches%s\n",
+                prev, (unsigned long long)ix->fp, from_env ? "" : " (title default targets)");
+    else
+        fprintf(stderr, "[mods] previous cache reset incomplete (state '%s'): retrying (fingerprint now %016llx)\n",
+                state, (unsigned long long)ix->fp);
+
+    char buf[2048];
+    if (!mods_fmt_ok(snprintf(buf, sizeof buf, "%s", list), sizeof buf))
+        fprintf(stderr, "[mods]   PS3_MODS_RESET is longer than %zu chars: the rest is ignored\n", sizeof buf - 1);
+    int failed = 0;
+    for (char* t = buf; *t; ) {
+        /* split on ';' or ',' (no strtok: its state is not thread-safe everywhere) */
+        char* end = t + strcspn(t, ";,");
+        char* next = *end ? end + 1 : end;
+        *end = 0;
+        while (*t == ' ' || *t == '\t') t++;
+        size_t n = strlen(t);
+        while (n && (t[n - 1] == ' ' || t[n - 1] == '\t')) t[--n] = 0;
+        if (!*t) { t = next; continue; }
+        if (strncmp(t, "/dev_hdd0/", 10) != 0) {
+            fprintf(stderr, "[mods]   reset target '%s' ignored (only /dev_hdd0/ paths)\n", t);
+            t = next; continue;
+        }
+        char rel[MODS_PATH], host[MODS_PATH];
+        if (!mods_norm(t + 10, rel, sizeof rel)) {
+            fprintf(stderr, "[mods]   reset target '%s' ignored (empty, '..' or too long)\n", t);
+            t = next; continue;
+        }
+        /* keep the guest spelling for the host path (case-insensitive NTFS
+         * either way; on POSIX the title's own spelling is the real one) */
+        if (!mods_fmt_ok(snprintf(host, sizeof host, "%s/%s", hdd, t + 10), sizeof host)) {
+            fprintf(stderr, "[mods]   reset target '%s' ignored (host path too long)\n", t);
+            t = next; continue;
+        }
+        for (char* p = host; *p; p++) if (*p == '\\') *p = '/';
+        errno = 0;
+        if (remove(host) == 0) {
+            fprintf(stderr, "[mods]   reset '%s': deleted '%s'\n", t, host);
+        } else {
+            const int err = errno;
+            if (err == ENOENT || err == ENOTDIR)   /* already gone: nothing to reset */
+                fprintf(stderr, "[mods]   reset '%s': not present\n", t);
+            else {
+                fprintf(stderr, "[mods]   reset '%s': delete FAILED ('%s': %s)\n", t, host, strerror(err));
+                failed++;
+            }
+        }
+        t = next;
+    }
+
+    if (failed) {
+        fprintf(stderr, "[mods] ERROR: cache reset incomplete (%d target(s) not deleted): the caches may still "
+                        "hold the previous mod set; the reset is retried on the next boot\n", failed);
+        f = fopen(state, "wb");
+        if (!f) { fprintf(stderr, "[mods] cannot write '%s'\n", state); return; }
+        fprintf(f, "fingerprint=retry\n"
+                   "# ps3recomp mods overlay state (runtime/syscalls/vfs_mods.c): the last cache reset\n"
+                   "# could not delete every PS3_MODS_RESET target; the next boot resets again.\n");
+        if (fclose(f) != 0) fprintf(stderr, "[mods] cannot write '%s'\n", state);
+        return;
+    }
+    f = fopen(state, "wb");
+    if (!f) { fprintf(stderr, "[mods] cannot write '%s'\n", state); return; }
+    fprintf(f, "fingerprint=%016llx\n", (unsigned long long)ix->fp);
+    fprintf(f, "# ps3recomp mods overlay state (runtime/syscalls/vfs_mods.c): the override set\n"
+               "# the HDD caches were last reset for. Set the first line to fingerprint=retry\n"
+               "# to force a reset on the next boot.\n");
+    fprintf(f, "# root: %s\n", g_root[0] ? g_root : "(overlay off)");
+    for (size_t i = 0; i < ix->n; i++)
+        fprintf(f, "%s\t%llu\t%lld\t%s\n", ix->ent[i].key, (unsigned long long)ix->ent[i].size,
+                (long long)ix->ent[i].mtime, ix->ent[i].src);
+    if (fclose(f) != 0) fprintf(stderr, "[mods] cannot write '%s'\n", state);
+}
+
+static void mods_build(mods_index* ix, int log);
+
+static void mods_init_impl(void)
+{
+    g_init_started = 1;
+    { const char* v = getenv("PS3_MODS_VERBOSE"); g_verbose = v && *v && *v != '0'; }
+
+    /* ---- where ---- */
+    const char* env = getenv("PS3_MODS_ROOT");
+    if (env) {
+        if (!*env || strcmp(env, "0") == 0 || ascii_icmp(env, "off") == 0) g_root[0] = 0;
+        else if (!mods_fmt_ok(snprintf(g_root, sizeof g_root, "%s", env), sizeof g_root)) {
+            fprintf(stderr, "[mods] PS3_MODS_ROOT is too long: overlay off\n");
+            g_root[0] = 0;
+        }
+    } else {
+        char d[MODS_PATH];
+        exe_dir(d, sizeof d);
+        if (d[0] && !mods_fmt_ok(snprintf(g_root, sizeof g_root, "%s/mods", d), sizeof g_root))
+            g_root[0] = 0;
+    }
+    for (char* p = g_root; *p; p++) if (*p == '\\') *p = '/';
+    { size_t n = strlen(g_root); while (n > 1 && g_root[n - 1] == '/') g_root[--n] = 0; }
+    if (g_root[0] && !is_dir(g_root)) {
+        if (env) fprintf(stderr, "[mods] PS3_MODS_ROOT '%s' is not a directory: overlay off\n", g_root);
+        g_root[0] = 0;
+    }
+
+    mods_build(&g_boot_idx, 1);
+    mods_reset_check();
+}
+
+/* Index the mods root into ix (empty when the overlay is off). log = the start-up
+ * report: overrides between packs, the "[mods] overlay ON" line and the listing. */
+static void mods_build(mods_index* ix, int log)
+{
+    /* ---- index ---- */
+    if (g_root[0]) {
+        DIR* d = opendir(g_root);
+        char* loose_dir = NULL;
+        if (d) {
+            struct dirent* e;
+            while ((e = readdir(d)) != NULL) {
+                if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0) continue;
+                char hp[MODS_PATH];
+                if (!mods_fmt_ok(snprintf(hp, sizeof hp, "%s/%s", g_root, e->d_name), sizeof hp)) {
+                    fprintf(stderr, "[mods] path too long, skipped: '%s/%s'\n", g_root, e->d_name);
+                    continue;
+                }
+                if (!is_dir(hp)) continue;
+                if (ascii_icmp(e->d_name, "PS3_GAME") == 0) { free(loose_dir); loose_dir = mods_strdup(e->d_name); continue; }
+                if (e->d_name[0] == '.' || e->d_name[0] == '_') {
+                    if (log) fprintf(stderr, "[mods] pack '%s' disabled (name starts with '%c')\n", e->d_name, e->d_name[0]);
+                    continue;
+                }
+                char** np = (char**)realloc(ix->packs, (ix->npacks + 1) * sizeof *np);
+                if (!np) continue;
+                ix->packs = np;
+                ix->packs[ix->npacks] = mods_strdup(e->d_name);
+                if (ix->packs[ix->npacks]) ix->npacks++;
+            }
+            closedir(d);
+        }
+        if (ix->npacks) qsort(ix->packs, ix->npacks, sizeof *ix->packs, cmp_name);
+        for (size_t i = 0; i < ix->npacks; i++) {
+            char hp[MODS_PATH], gp[MODS_PATH];
+            /* pack names come from the listing above, which already checked
+             * that "<root>/<name>" fits */
+            snprintf(hp, sizeof hp, "%s/%s", g_root, ix->packs[i]);
+            if (find_child_dir(hp, "PS3_GAME", gp, sizeof gp))
+                mods_walk(ix, gp, "PS3_GAME", (int)i + 1, ix->packs[i], 0);
+            else if (!find_child_dir(hp, "textures", gp, sizeof gp) && log)   /* texture packs: rsx_texrepl.c */
+                fprintf(stderr, "[mods] pack '%s' has no PS3_GAME folder: ignored\n", ix->packs[i]);
+        }
+        if (loose_dir) {
+            char hp[MODS_PATH];
+            size_t before = ix->n;
+            snprintf(hp, sizeof hp, "%s/%s", g_root, loose_dir);   /* fits: checked above */
+            mods_walk(ix, hp, "PS3_GAME", INT_MAX, "(loose)", 0);
+            ix->nloose = ix->n - before;
+            free(loose_dir);
+        }
+    }
+
+    /* ---- sort, resolve conflicts (highest priority wins) ---- */
+    if (ix->n) {
+        qsort(ix->ent, ix->n, sizeof *ix->ent, cmp_entry);
+        size_t w = 0;
+        for (size_t i = 0; i < ix->n; i++) {
+            if (w && strcmp(ix->ent[w - 1].key, ix->ent[i].key) == 0) {
+                if (log)
+                    fprintf(stderr, "[mods] %s: '%s' overrides '%s'\n", ix->ent[i].key, ix->ent[w - 1].src,
+                            ix->ent[i].src);
+                free(ix->ent[i].key); free(ix->ent[i].host);
+                continue;
+            }
+            ix->ent[w++] = ix->ent[i];
+        }
+        ix->n = w;
+    }
+    ix->fp = mods_fingerprint(ix);
+    if (!log) return;
+
+    if (ix->n) {
+        char packs[512] = "";
+        size_t o = 0;
+        for (size_t i = 0; i < ix->npacks && o + 4 < sizeof packs; i++)
+            o += (size_t)snprintf(packs + o, sizeof packs - o, "%s%s", i ? ", " : "", ix->packs[i]);
+        fprintf(stderr, "[mods] overlay ON: root '%s', %zu file(s) (loose %zu; packs in priority order: %s)\n",
+                g_root, ix->n, ix->nloose, ix->npacks ? packs : "none");
+        const char* le = getenv("PS3_MODS_LIST");
+        size_t lim = le ? (size_t)strtoul(le, NULL, 0) : 32;
+        for (size_t i = 0; i < ix->n && i < lim; i++)
+            fprintf(stderr, "[mods]   %s <- %s [%s]\n", ix->ent[i].key, ix->ent[i].host, ix->ent[i].src);
+        if (ix->n > lim) fprintf(stderr, "[mods]   ... %zu more (PS3_MODS_LIST=<n> to list)\n", ix->n - lim);
+    } else if (g_root[0]) {
+        fprintf(stderr, "[mods] overlay root '%s' holds no files: overlay off\n", g_root);
+    }
+}
+
+#ifdef _WIN32
+static INIT_ONCE g_once = INIT_ONCE_STATIC_INIT;
+static BOOL CALLBACK mods_once_cb(PINIT_ONCE o, PVOID p, PVOID* c) { (void)o; (void)p; (void)c; mods_init_impl(); return TRUE; }
+void ps3_mods_init(void) { InitOnceExecuteOnce(&g_once, mods_once_cb, NULL, NULL); }
+#else
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+void ps3_mods_init(void) { pthread_once(&g_once, mods_init_impl); }
+#endif
+
+void ps3_mods_set_reset_default(const char* list)
+{
+    if (g_init_started) {
+        fprintf(stderr, "[mods] ps3_mods_set_reset_default('%s') called after the overlay initialised: ignored\n",
+                list ? list : "");
+        return;
+    }
+    if (!list) { g_reset_default[0] = 0; return; }
+    const size_t n = strlen(list);
+    if (n >= sizeof g_reset_default) {
+        fprintf(stderr, "[mods] ps3_mods_set_reset_default: list too long (%zu chars): ignored\n", n);
+        return;
+    }
+    memcpy(g_reset_default, list, n + 1);
+}
+
+int ps3_mods_active(void)
+{
+    ps3_mods_init();
+    return mods_cur()->n != 0;
+}
+
+const char* ps3_mods_root(void)
+{
+    ps3_mods_init();
+    return g_root;
+}
+
+/* First open of a mod file: an NPDRM container (EDAT/SDATA, "NPD\0") is served
+ * as-is by the overlay, which is almost certainly not what its author meant. */
+static void mods_warn_if_npd(const mods_entry* e)
+{
+    FILE* f = fopen(e->host, "rb");
+    if (!f) return;
+    unsigned char m[4] = { 0 };
+    const size_t got = fread(m, 1, sizeof m, f);
+    fclose(f);
+    if (got == 4 && m[0] == 'N' && m[1] == 'P' && m[2] == 'D' && m[3] == 0)
+        fprintf(stderr, "[mods] WARNING: '%s' [%s] is NPDRM-encrypted (EDAT/SDATA): mod files are served "
+                        "as-is (no EDAT decryption); ship it decrypted\n", e->host, e->src);
+}
+
+int ps3_mods_resolve(const char* guest, char* out, size_t cap, const char* what)
+{
+    ps3_mods_init();
+    mods_index* ix = mods_cur();
+    if (!ix->n || !guest || !out || !cap) return 0;
+    char key[MODS_PATH];
+    if (!mods_guest_key(guest, key, sizeof key)) return 0;
+    size_t lo = 0, hi = ix->n;
+    while (lo < hi) {
+        size_t mid = (lo + hi) / 2;
+        int c = strcmp(ix->ent[mid].key, key);
+        if (c == 0) {
+            mods_entry* e = &ix->ent[mid];
+            const char* tag = what ? what : "use";
+            const size_t hl = strlen(e->host);
+            if (hl >= cap) {
+                /* Truncating would open a path that does not exist (ENOENT for a
+                 * file the game has): fall back to the game's own file instead. */
+                if (MODS_INC(&e->toolong) == 1)
+                    fprintf(stderr, "[mods] %s '%s': mod path '%s' is too long for this caller "
+                                    "(%zu chars, buffer %zu): NOT redirected, the game's file is used\n",
+                            tag, guest, e->host, hl, cap);
+                return 0;
+            }
+            memcpy(out, e->host, hl + 1);
+            const int is_stat = what && strstr(what, "stat") != NULL;
+            long n = is_stat ? MODS_INC(&e->stats) : MODS_INC(&e->opens);
+            if (n == 1 || (!is_stat && g_verbose))
+                fprintf(stderr, "[mods] %s '%s' -> '%s' [%s]%s\n", tag, guest, e->host, e->src,
+                        n != 1 ? "" : is_stat ? " (first stat; later stats not logged)"
+                                    : g_verbose ? "" : " (first open; PS3_MODS_VERBOSE=1 logs every open)");
+            if (!is_stat && n == 1) mods_warn_if_npd(e);
+            return 1;
+        }
+        if (c < 0) lo = mid + 1; else hi = mid;
+    }
+    return 0;
+}
+
+/* ---- live rescan (ps3_mods_rescan) ------------------------------------------ */
+
+#ifdef _WIN32
+static SRWLOCK g_rescan_lock = SRWLOCK_INIT;
+#  define RESCAN_LOCK()   AcquireSRWLockExclusive(&g_rescan_lock)
+#  define RESCAN_UNLOCK() ReleaseSRWLockExclusive(&g_rescan_lock)
+#else
+static pthread_mutex_t g_rescan_lock = PTHREAD_MUTEX_INITIALIZER;
+#  define RESCAN_LOCK()   pthread_mutex_lock(&g_rescan_lock)
+#  define RESCAN_UNLOCK() pthread_mutex_unlock(&g_rescan_lock)
+#endif
+
+/* A changed live set may leave the title's HDD caches holding mod bytes the
+ * game copied during this session: force the PS3_MODS_RESET reset on the next
+ * boot, whatever the set is then. */
+static void mods_mark_retry(void)
+{
+    const char* env = getenv("PS3_MODS_RESET");
+    const char* list = env ? env : g_reset_default;
+    if (!*list || strcmp(list, "0") == 0 || ascii_icmp(list, "off") == 0 || ascii_icmp(list, "none") == 0)
+        return;
+    const char* hdd = getenv("PS3_HDD0_ROOT");
+    if (!hdd || !*hdd) return;
+    char state[MODS_PATH];
+    if (!mods_fmt_ok(snprintf(state, sizeof state, "%s/ps3recomp_mods_state.txt", hdd), sizeof state)) return;
+    FILE* f = fopen(state, "wb");
+    if (!f) { fprintf(stderr, "[mods] cannot write '%s'\n", state); return; }
+    fprintf(f, "fingerprint=retry\n"
+               "# ps3recomp mods overlay state (runtime/syscalls/vfs_mods.c): the override set changed\n"
+               "# while the game ran (ps3_mods_rescan); the next boot resets the title caches.\n");
+    if (fclose(f) != 0) fprintf(stderr, "[mods] cannot write '%s'\n", state);
+}
+
+int ps3_mods_rescan(ps3_mods_rescan_info* out)
+{
+    ps3_mods_init();
+    if (out) memset(out, 0, sizeof *out);
+    if (!g_root[0]) {
+        fprintf(stderr, "[mods] rescan: no mods root (overlay off at start-up)\n");
+        return -1;
+    }
+    RESCAN_LOCK();
+    mods_index* old = mods_cur();
+    mods_index* ix = (mods_index*)calloc(1, sizeof *ix);
+    if (!ix) { RESCAN_UNLOCK(); return -1; }
+    mods_build(ix, 0);
+    /* diff: both lists are sorted by key */
+    size_t i = 0, j = 0, added = 0, removed = 0, changed = 0;
+    while (i < old->n || j < ix->n) {
+        const int c = i >= old->n ? 1 : j >= ix->n ? -1 : strcmp(old->ent[i].key, ix->ent[j].key);
+        if (c < 0) {
+            fprintf(stderr, "[mods] rescan: removed %s [%s]\n", old->ent[i].key, old->ent[i].src);
+            removed++; i++;
+        } else if (c > 0) {
+            fprintf(stderr, "[mods] rescan: added %s <- %s [%s]\n", ix->ent[j].key, ix->ent[j].host, ix->ent[j].src);
+            added++; j++;
+        } else {
+            const mods_entry* a = &old->ent[i];
+            const mods_entry* b = &ix->ent[j];
+            if (a->size != b->size || a->mtime != b->mtime || strcmp(a->host, b->host) != 0) {
+                fprintf(stderr, "[mods] rescan: changed %s <- %s [%s]\n", b->key, b->host, b->src);
+                changed++;
+            }
+            i++; j++;
+        }
+    }
+    MODS_STORE_PTR(&g_idx, ix);       /* the old index is retired, not freed */
+    RESCAN_UNLOCK();
+    fprintf(stderr, "[mods] rescan: %zu file(s), +%zu -%zu ~%zu, fingerprint %016llx -> %016llx\n",
+            ix->n, added, removed, changed, (unsigned long long)old->fp, (unsigned long long)ix->fp);
+    if (added || removed || changed) mods_mark_retry();
+    if (out) {
+        out->files = ix->n; out->added = added; out->removed = removed; out->changed = changed;
+        out->fingerprint = ix->fp;
+    }
+    return 0;
+}
diff --git a/runtime/syscalls/vfs_mods.h b/runtime/syscalls/vfs_mods.h
new file mode 100644
index 00000000..9257b9ec
--- /dev/null
+++ b/runtime/syscalls/vfs_mods.h
@@ -0,0 +1,69 @@
+/*
+ * ps3recomp - loose-file mod overlay for the guest VFS (see vfs_mods.c)
+ *
+ * A "mods" directory whose files replace game files by guest path. Read-side
+ * only: opens without write access and stats are redirected, every write still
+ * goes to the real path. Off (zero cost, zero behaviour change) unless a mods
+ * directory exists or PS3_MODS_ROOT names one.
+ */
+#ifndef PS3RECOMP_VFS_MODS_H
+#define PS3RECOMP_VFS_MODS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Title default for PS3_MODS_RESET (';'-separated /dev_hdd0 guest paths, see
+ * vfs_mods.c), used only when the PS3_MODS_RESET environment variable is unset.
+ * The value is consumed at first use, inside ps3_mods_init(); nothing goes
+ * through the process environment, so the getenv cache and the order of static
+ * initialisation do not matter. Call it before ps3_mods_init() runs -- from a
+ * static constructor (it only fills zero-initialised storage, so it is safe in
+ * any TU and any order) or from title code that runs before ppu_fs_register().
+ * A later call is logged and ignored. NULL clears it. */
+void ps3_mods_set_reset_default(const char* list);
+
+/* Build the override index and run the mod-set-changed bookkeeping
+ * (PS3_MODS_RESET). Idempotent and thread-safe; ps3_mods_resolve() calls it
+ * too, but ppu_fs_register() calls it at boot so the log lines and any cache
+ * reset happen before the title touches a file. */
+void ps3_mods_init(void);
+
+/* 1 if the overlay is active (a mods root with at least one file). */
+int ps3_mods_active(void);
+
+/* The mods root directory ('/' separators, no trailing '/'), or "" when the
+ * overlay is off (PS3_MODS_ROOT=off, no <exe dir>/mods). Set even when the
+ * root holds no PS3_GAME files: host-side features such as texture
+ * replacement (libs/video/rsx_texrepl.c, <root>/[<pack>/]textures) use it. */
+const char* ps3_mods_root(void);
+
+/* If guest path `guest` is overridden, write the host path of the mod file to
+ * `out` and return 1 (and log the redirect, tagged with `what`, e.g. "open").
+ * Return 0 -- `out` untouched -- when it is not, the overlay is off, or the mod
+ * path does not fit in `cap` (logged once per file; the game's file is used).
+ * Only call it for READ-side operations. A redirected file is a plain file:
+ * callers skip NPDRM/EDAT resolution for it (run edat_resolve only on 0). */
+int ps3_mods_resolve(const char* guest, char* out, size_t cap, const char* what);
+
+/* Re-index the mods root while the title runs (editor / live-link hot reload).
+ * Builds a new index and publishes it with one pointer swap: resolve() stays
+ * lock-free, a file already open keeps its handle, the next open/stat sees the
+ * new set. When the set changed, the PS3_MODS_RESET state is marked "retry" so
+ * the next boot rebuilds the title caches. 0 = OK, -1 = no mods root (the
+ * overlay was off at start-up). Thread-safe; rescans are serialised. */
+typedef struct ps3_mods_rescan_info {
+    size_t   files;                    /* overlay files indexed now */
+    size_t   added, removed, changed;  /* vs the previous index (key; size, mtime, host path) */
+    uint64_t fingerprint;
+} ps3_mods_rescan_info;
+int ps3_mods_rescan(ps3_mods_rescan_info* out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_VFS_MODS_H */
diff --git a/tests/audio_session/test_audio_session.c b/tests/audio_session/test_audio_session.c
new file mode 100644
index 00000000..7a59f43f
--- /dev/null
+++ b/tests/audio_session/test_audio_session.c
@@ -0,0 +1,179 @@
+/*
+ * ps3recomp - tests/audio_session/test_audio_session.c   (Windows / WASAPI only)
+ *
+ * GitHub THP8 issue #1 regression: a run with PS3_AUDIO_MUTE=1 must not leave the program muted for its later
+ * runs. Windows keeps an audio session's mute (ISimpleAudioVolume) per program and endpoint across restarts, so the
+ * old PS3_AUDIO_MUTE (a session SetMute) muted every later normal start of the same exe in the volume mixer.
+ *
+ * The test includes libs/audio/cellAudio.c and opens the real WASAPI backend (audio_backend_init) in CHILD runs of
+ * this exe -- persistence is only visible across processes. Every child only opens the stream; nothing is played.
+ *   1. child PS3_AUDIO_MUTE=1             -> the session is NOT muted (the backend submits silence instead)
+ *   2. child, no variables                -> the session is not muted (fails before the fix: the mute of run 1 stuck)
+ *   3. child "leave-muted" (SetMute(TRUE) like the old PS3_AUDIO_MUTE, what 0.9.0 left behind) then a plain child
+ *                                         -> muted (documents the Windows persistence the fix works around)
+ *   4. child PS3_AUDIO_UNMUTE=1           -> it clears that left-over mute; 5. a plain child -> not muted again
+ * The program's own session ends unmuted, as it started.
+ *
+ * Pick the endpoint with PS3_AUDIO_DEVICE (e.g. "Steam Streaming Speakers" on a PC someone uses); default = the
+ * Windows default output. No active output endpoint -> SKIP (exit 0).
+ *
+ * Build (zig):  zig cc -target x86_64-windows-gnu -Iinclude tests/audio_session/test_audio_session.c
+ *                  -lole32 -o test_audio_session.exe
+ * Run:          test_audio_session.exe            exit 0 = pass
+ */
+#include "../../libs/audio/cellAudio.c"
+
+#if !AUDIO_BACKEND_WASAPI
+int main(void) { printf("SKIP: WASAPI backend only\n"); return 0; }
+#else
+
+/* --- the few runtime symbols cellAudio.c links against (the backend under test needs none of them) --- */
+uint8_t* vm_base;
+int sys_event_queue_push_by_id(uint32_t q, uint64_t s, uint64_t d1, uint64_t d2, uint64_t d3)
+{ (void)q; (void)s; (void)d1; (void)d2; (void)d3; return 0; }
+uint32_t sys_event_find_queue_by_key(uint64_t k) { (void)k; return 0; }
+uint32_t sys_event_queue_create_direct(uint64_t k, int32_t n) { (void)k; (void)n; return 0; }
+/* guest-memory store helpers (ppu_memory.h / vm.h inlines) */
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi, ppu_vm_size;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+
+/* -1 = no stream, 0/1 = the stream's session mute */
+static int session_muted(void)
+{
+    ISimpleAudioVolume* vol = NULL;
+    BOOL m = FALSE;
+    if (!s_wasapi_client) return -1;
+    if (FAILED(s_wasapi_client->lpVtbl->GetService(s_wasapi_client, &ps3r_IID_ISimpleAudioVolume, (void**)&vol)) || !vol)
+        return -1;
+    vol->lpVtbl->GetMute(vol, &m);
+    vol->lpVtbl->Release(vol);
+    return m ? 1 : 0;
+}
+
+/* child: open the backend the way cellAudioInit does, report, close. "leave-muted" = the pre-fix PS3_AUDIO_MUTE. */
+static int child(const char* mode)
+{
+    if (audio_backend_init() < 0) { printf("RESULT nostream\n"); return 0; }
+    if (strcmp(mode, "leave-muted") == 0) {
+        ISimpleAudioVolume* vol = NULL;
+        if (SUCCEEDED(s_wasapi_client->lpVtbl->GetService(s_wasapi_client, &ps3r_IID_ISimpleAudioVolume, (void**)&vol)) && vol) {
+            vol->lpVtbl->SetMute(vol, TRUE, NULL);
+            vol->lpVtbl->Release(vol);
+        }
+    }
+    /* the mute flag decides what audio_backend_submit writes: a loud block must reach the device as zeros */
+    printf("RESULT session_muted=%d silence=%d\n", session_muted(), s_wasapi_mute);
+    fflush(stdout);
+    audio_backend_shutdown();
+    return 0;
+}
+
+/* run this exe as a child with extra variables; returns its session_muted (-1 no stream, -2 failed) and silence */
+static int run_child(const char* mode, const char* const* env_set, int* silence)
+{
+    char exe[MAX_PATH], line[MAX_PATH + 64];
+    GetModuleFileNameA(NULL, exe, sizeof exe);
+    snprintf(line, sizeof line, "\"%s\" --child %s", exe, mode);
+    static const char* const all[] = { "PS3_AUDIO_MUTE", "PS3_AUDIO_UNMUTE", NULL };
+    for (int i = 0; all[i]; i++) SetEnvironmentVariableA(all[i], NULL);
+    for (int i = 0; env_set && env_set[i]; i += 2) SetEnvironmentVariableA(env_set[i], env_set[i + 1]);
+
+    SECURITY_ATTRIBUTES sa = { sizeof sa, NULL, TRUE };
+    HANDLE rd, wr;
+    if (!CreatePipe(&rd, &wr, &sa, 0)) return -2;
+    SetHandleInformation(rd, HANDLE_FLAG_INHERIT, 0);
+    STARTUPINFOA si; memset(&si, 0, sizeof si); si.cb = sizeof si;
+    si.dwFlags = STARTF_USESTDHANDLES; si.hStdOutput = wr; si.hStdError = wr; si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    PROCESS_INFORMATION pi;
+    if (!CreateProcessA(NULL, line, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) { CloseHandle(rd); CloseHandle(wr); return -2; }
+    CloseHandle(wr);
+    char out[16384]; DWORD got = 0, n;
+    while (got < sizeof out - 1 && ReadFile(rd, out + got, (DWORD)(sizeof out - 1 - got), &n, NULL) && n) got += n;
+    out[got] = 0;
+    CloseHandle(rd);
+    WaitForSingleObject(pi.hProcess, 30000);
+    CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
+    for (int i = 0; env_set && env_set[i]; i += 2) SetEnvironmentVariableA(env_set[i], NULL);
+
+    const char* r = strstr(out, "RESULT ");
+    for (const char* p = out; (p = strstr(p, "[cellAudio] ")) != NULL; ) {      /* the backend's own log lines */
+        const char* e = strchr(p, '\n'); int len = e ? (int)(e - p) : (int)strlen(p);
+        char ln[512]; snprintf(ln, sizeof ln, "%.*s", len, p);
+        if (strstr(ln, "mute") || strstr(ln, "MUTE") || strstr(ln, "WASAPI device")) printf("      %s\n", ln);
+        p += len;
+    }
+    if (!r) { printf("    child %s: no RESULT line:\n%s\n", mode, out); return -2; }
+    if (strncmp(r, "RESULT nostream", 15) == 0) return -1;
+    int m = -2, s = 0;
+    sscanf(r, "RESULT session_muted=%d silence=%d", &m, &s);
+    if (silence) *silence = s;
+    return m;
+}
+
+static int fails = 0;
+static void expect(const char* what, int got, int want)
+{
+    printf("  %s %s (session muted %d, want %d)\n", got == want ? "ok  " : "FAIL", what, got, want);
+    if (got != want) fails++;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc >= 3 && strcmp(argv[1], "--child") == 0) return child(argv[2]);
+    setvbuf(stdout, NULL, _IONBF, 0);
+
+    /* device-name matching (no device needed): PS3_AUDIO_DEVICE is read as UTF-8 like the friendly names; ASCII
+     * letters fold, nothing else does */
+    {
+        char buf[256];
+        WCHAR saved[512]; DWORD had = GetEnvironmentVariableW(L"PS3_AUDIO_DEVICE", saved, 512);
+        SetEnvironmentVariableW(L"PS3_AUDIO_DEVICE", L"\x0414\x0438\x043D\x0430\x043C\x0438\x043A\x0438 (Stra\x00DF" L"e)");
+        const char* w = wasapi_env_utf8(L"PS3_AUDIO_DEVICE", buf, (int)sizeof buf);
+        const int ok1 = w && wasapi_name_has("\xD0\x94\xD0\xB8\xD0\xBD\xD0\xB0\xD0\xBC\xD0\xB8\xD0\xBA\xD0\xB8 "
+                                             "(Stra\xC3\x9F" "e)", w);
+        const int ok2 = wasapi_name_has("Speakers (High Definition Audio Device)", "speakers (high definition audio device)") &&
+                        wasapi_name_has("Speakers (Yeti Nano)", "YETI") && !wasapi_name_has("a@b", "a`b") &&
+                        !wasapi_name_has("\xC3\x9F", "\xE3\x9F") && !wasapi_name_has("Speakers", "Headphones");
+        SetEnvironmentVariableW(L"PS3_AUDIO_DEVICE", had && had < 512 ? saved : NULL);
+        printf("  %s non-ASCII PS3_AUDIO_DEVICE matches its endpoint name (UTF-8)\n", ok1 ? "ok  " : "FAIL");
+        printf("  %s name matching: ASCII case folds, nothing else\n", ok2 ? "ok  " : "FAIL");
+        fails += !ok1 + !ok2;
+    }
+
+    static const char* const mute[] = { "PS3_AUDIO_MUTE", "1", NULL };
+    static const char* const unmute[] = { "PS3_AUDIO_UNMUTE", "1", NULL };
+    int sil = -1;
+    int m = run_child("plain", NULL, &sil);
+    if (m == -1) { printf("SKIP: no active output endpoint to open\n"); return 0; }
+    if (m == -2) { printf("FAIL: the child did not run\n"); return 1; }
+    if (m == 1) {   /* a left-over mute from an earlier (pre-fix) run of this very exe: clear it first */
+        printf("  note: this exe starts muted (an earlier run left it so); clearing it\n");
+        run_child("plain", unmute, NULL);
+        m = run_child("plain", NULL, &sil);
+    }
+    expect("start state", m, 0);
+
+    sil = -1;
+    expect("1 PS3_AUDIO_MUTE=1 run: the session itself stays unmuted", run_child("plain", mute, &sil), 0);
+    printf("  %s 1 PS3_AUDIO_MUTE=1 run: the backend submits silence (flag %d)\n", sil == 1 ? "ok  " : "FAIL", sil);
+    if (sil != 1) fails++;
+    expect("2 the next normal run is not muted (GitHub #1)", run_child("plain", NULL, &sil), 0);
+    printf("  %s 2 a normal run submits the game's audio (silence flag %d)\n", sil == 0 ? "ok  " : "FAIL", sil);
+    if (sil != 0) fails++;
+
+    run_child("leave-muted", NULL, NULL);
+    expect("3 Windows keeps a session mute across runs (what 0.9.0 left behind)", run_child("plain", NULL, NULL), 1);
+    expect("4 PS3_AUDIO_UNMUTE=1 clears it", run_child("plain", unmute, NULL), 0);
+    expect("5 and it stays cleared", run_child("plain", NULL, NULL), 0);
+
+    if (run_child("plain", NULL, NULL) == 1) run_child("plain", unmute, NULL);    /* leave the exe as it started */
+    printf(fails ? "FAIL: %d check(s)\n" : "PASS\n", fails);
+    return fails ? 1 : 0;
+}
+#endif
