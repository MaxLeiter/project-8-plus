new file mode 100644
index 00000000..098444e2
--- /dev/null
+++ b/runtime/syscalls/vfs_mods.c
@@ -0,0 +1,768 @@
+/*
+ * ps3recomp - loose-file mod overlay for the guest VFS
+ *
+ * Lets a port ship "drop files in a folder" modding without touching the game
+ * tree: files under a mods directory replace game files by GUEST path. The
+ * game data stays pristine and read-only; removing the folder restores the
+ * vanilla game.
+ *
+ * Layout (mirrors the disc):
+ *   <mods>/PS3_GAME/USRDIR/DATA/...           loose files (highest priority)
+ *   <mods>/<pack>/PS3_GAME/USRDIR/DATA/...    packs: one folder per mod; packs
+ *                                             are applied in name order (case-
+ *                                             insensitive) and a later pack wins
+ *                                             over an earlier one for the same
+ *                                             file; loose files win over packs.
+ *   A pack whose folder name starts with '.' or '_' is skipped (disable a mod
+ *   by renaming it to _name). Only the PS3_GAME tree of the root and of each
+ *   pack is indexed; anything else (readme, previews, ...) is ignored.
+ *
+ * Guest path -> override key (case-insensitive, '\' == '/', "//" == "/"):
+ *   /dev_bdvd/<rest>                    -> <rest>              (PS3_GAME/USRDIR/...)
+ *   /app_home/<rest>                    -> PS3_GAME/USRDIR/<rest>  (disc boot)
+ *   /dev_hdd0/game/<title>/USRDIR/<rest>-> PS3_GAME/USRDIR/<rest>
+ * The last one makes a mod also win over a copy of the same file the title
+ * keeps in its HDD data cache / game-data dir (Tony Hawk's Project 8 copies
+ * zone and pak files to /dev_hdd0/game/BLUS30011/USRDIR/DATA/... and then reads
+ * those instead of the disc), and over an installed update's copy.
+ *
+ * Read side only: callers redirect opens WITHOUT write access and stats. Every
+ * write, create, truncate, unlink, rename, mkdir and opendir/readdir still uses
+ * the real path, so a title that copies a file into its cache writes the real
+ * cache file (with the mod's bytes, since it read the mod), never the mod.
+ * Directories are not merged: a file a mod ADDS is visible to open/stat by
+ * name, not to readdir.
+ *
+ * Mod files are served as-is: they are plain files. The callers run the NPDRM
+ * (EDAT) decryption step only for paths the overlay did NOT redirect, so a mod
+ * never gets a "<file>.dec" cache written next to it and an overridden EDAT is
+ * never probed or decrypted. A mod file that starts with the NPD magic is
+ * reported once (ship it decrypted).
+ *
+ * Only the absolute spellings in the table above are keys. sys_fs also accepts
+ * "app_home/...", "e:/app_home/...", any "USRDIR/..." flattening and relative
+ * paths; those are not overlaid (THP8 retail uses none of them).
+ *
+ * Environment:
+ *   PS3_MODS_ROOT=<dir>   mods directory. Unset: <exe dir>/mods if that is a
+ *                         directory. "" / "0" / "off": overlay disabled.
+ *   PS3_MODS_LIST=<n>     list the first n overrides at startup (default 32).
+ *   PS3_MODS_VERBOSE=1    log every redirected open (default: the first open
+ *                         and the first stat of each file).
+ *   PS3_MODS_RESET=<guest path>[;<guest path>...]
+ *                         files (under /dev_hdd0 only) to delete when the set
+ *                         of active override files changed since the previous
+ *                         run (added/removed/resized/touched; tracked in
+ *                         $PS3_HDD0_ROOT/ps3recomp_mods_state.txt). For a title
+ *                         with an HDD cache this names its cache index, so the
+ *                         title rebuilds the cache from the (overlaid) disc and
+ *                         a REMOVED mod does not live on in cached copies.
+ *                         "0" / "off" / "none": no reset. Unset: the title's
+ *                         default, ps3_mods_set_reset_default() (THP8 sets it
+ *                         in its title layer). The state is only recorded when
+ *                         every target was deleted or already absent; after a
+ *                         failed delete it is marked "retry", and the next boot
+ *                         resets again whatever the mod set is then.
+ *
+ * Log lines (stderr): "[mods] ..." -- the index at startup, the first
+ * redirected open and stat of each file, and any reset.
+ */
+#include "vfs_mods.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <errno.h>
+#include <limits.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include "../platform/win32_dirent.h"   /* <dirent.h>, or a Win32 stand-in */
+
+#ifdef _WIN32
+#  ifndef WIN32_LEAN_AND_MEAN
+#    define WIN32_LEAN_AND_MEAN
+#  endif
+#  include <windows.h>
+   typedef struct _stat64 mods_stat_t;
+#  define MODS_STAT(p, s) _stat64((p), (s))
+   /* underscore spellings: C17 mode (__STDC__ == 1) hides the POSIX names in the UCRT headers */
+#  define MODS_IFMT  _S_IFMT
+#  define MODS_IFDIR _S_IFDIR
+#  define MODS_IFREG _S_IFREG
+#  define MODS_INC(p) InterlockedIncrement((volatile LONG*)(p))
+#  define MODS_LOAD_PTR(pp)     InterlockedCompareExchangePointer((PVOID volatile*)(pp), NULL, NULL)
+#  define MODS_STORE_PTR(pp, v) ((void)InterlockedExchangePointer((PVOID volatile*)(pp), (PVOID)(v)))
+#else
+#  include <pthread.h>
+#  include <unistd.h>
