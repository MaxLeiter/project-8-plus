+static uint64_t get64(const uint8_t* p) { return ((uint64_t)get32(p) << 32) | get32(p + 4); }
+
+static void rand_reg(uint8_t r[16], uint8_t regs[128][16], int idx)
+{
+    int k = (int)(rnd() % 100), i;
+    if (k < 30) {
+        for (i = 0; i < 4; i++) { uint32_t m = (uint32_t)(rnd() % 10);
+            put32(r + 4 * i, m < 5 ? PICK(int_edges) : m < 7 ? (uint32_t)(rnd() % 300) : rnd32()); }
+    } else if (k < 55) {
+        for (i = 0; i < 4; i++) put32(r + 4 * i, (rnd() % 10) < 4 ? PICK(flt_edges) : rand_float());
+    } else if (k < 68) {
+        for (i = 0; i < 2; i++) { uint64_t d = (rnd() % 10) < 4 ? PICK(dbl_edges) : rand_double();
+            put32(r + 8 * i, (uint32_t)(d >> 32)); put32(r + 8 * i + 4, (uint32_t)d); }
+    } else if (k < 78) {
+        for (i = 0; i < 8; i++) { uint16_t h = (rnd() & 1) ? PICK(half_edges) : (uint16_t)rnd();
+            r[2 * i] = (uint8_t)(h >> 8); r[2 * i + 1] = (uint8_t)h; }
+    } else if (k < 90 || idx == 0) {
+        for (i = 0; i < 16; i++) r[i] = (uint8_t)rnd();
+    } else {
+        memcpy(r, regs[rnd() % idx], 16);
+        if (rnd() & 1) r[(rnd() % 4) * 4] ^= 0x80;          /* sign flip of one lane */
+        if (rnd() & 1) r[rnd() % 16] ^= (uint8_t)(1u << (rnd() % 8));
+    }
+}
+/* make operand b related to operand a (equality / sign / ulp neighbours) */
+static void relate(uint8_t b[16], const uint8_t a[16])
+{
+    memcpy(b, a, 16);
+    switch (rnd() % 5) {
+    case 0: break;
+    case 1: for (int i = 0; i < 4; i++) if (rnd() & 1) b[4 * i] ^= 0x80; break;
+    case 2: { int i = (int)(rnd() % 4); put32(b + 4 * i, get32(b + 4 * i) + ((rnd() & 1) ? 1 : 0xFFFFFFFFu)); break; }
+    case 3: { int i = (int)(rnd() % 4); put32(b + 4 * i, get32(b + 4 * i) ^ 0x80000000u ^ (uint32_t)(rnd() % 3)); break; }
+    default: b[rnd() % 16] ^= (uint8_t)(1u << (rnd() % 8)); break;
+    }
+}
