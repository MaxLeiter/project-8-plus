+/* A virtual streaming sink (Steam Remote Play / Sunshine "Steam Streaming
+ * Speakers"): nothing is audible locally when audio goes there. */
+static int wasapi_is_virtual_sink(const char* name)
+{
+    return wasapi_name_has(name, "Steam Streaming");
+}
+
+#include <tlhelp32.h>
+/* PID of the first process with this image name, 0 if none. */
+static DWORD wasapi_process_pid(const WCHAR* exe)
+{
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snap == INVALID_HANDLE_VALUE) return 0;
+    PROCESSENTRY32W pe; pe.dwSize = sizeof pe;
+    DWORD pid = 0;
+    for (BOOL ok = Process32FirstW(snap, &pe); ok && !pid; ok = Process32NextW(snap, &pe))
+        if (_wcsicmp(pe.szExeFile, exe) == 0) pid = pe.th32ProcessID;
+    CloseHandle(snap);
+    return pid;
+}
+
+/* Is a Sunshine (Moonlight host) streaming session live? Sunshine makes its
+ * virtual sink the Windows default for a session and restores the old default
+ * when it ends -- but a crashed / hung session leaves the virtual sink as the
+ * default and every app silent. sunshine.exe running is not enough (it idles
+ * between sessions): the last "CLIENT CONNECTED" in its log must be newer than
+ * the last "CLIENT DISCONNECTED". Log unreadable -> assume live (trust the
+ * default). */
+static int wasapi_sunshine_session_live(void)
+{
+    DWORD pid = wasapi_process_pid(L"sunshine.exe");
+    if (!pid) return 0;
+    WCHAR path[MAX_PATH + 32] = L"";
+    HANDLE ph = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+    if (ph) {
+        DWORD n = MAX_PATH;
+        if (QueryFullProcessImageNameW(ph, 0, path, &n)) {
+            WCHAR* slash = wcsrchr(path, L'\\');
+            if (slash) wcscpy(slash + 1, L"config\\sunshine.log"); else path[0] = 0;
+        } else path[0] = 0;
+        CloseHandle(ph);
+    }
+    if (!path[0]) {
+        DWORD n = GetEnvironmentVariableW(L"ProgramFiles", path, MAX_PATH);
+        if (!n || n >= MAX_PATH) return 1;
+        wcscat(path, L"\\Sunshine\\config\\sunshine.log");
+    }
+    HANDLE f = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           NULL, OPEN_EXISTING, 0, NULL);
+    if (f == INVALID_HANDLE_VALUE) return 1;
+    LARGE_INTEGER sz; int live = 1;
+    if (GetFileSizeEx(f, &sz)) {
+        const LONGLONG tail = 512 * 1024;
+        LARGE_INTEGER off; off.QuadPart = sz.QuadPart > tail ? sz.QuadPart - tail : 0;
+        DWORD want = (DWORD)(sz.QuadPart - off.QuadPart), got = 0;
+        char* buf = (char*)malloc((size_t)want + 1);
+        if (buf && SetFilePointerEx(f, off, NULL, FILE_BEGIN) && ReadFile(f, buf, want, &got, NULL)) {
+            buf[got] = 0;
+            const char* lastc = NULL; const char* lastd = NULL;
+            for (const char* q = buf; (q = strstr(q, "CLIENT CONNECTED")) != NULL; q++) lastc = q;
+            for (const char* q = buf; (q = strstr(q, "CLIENT DISCONNECTED")) != NULL; q++) lastd = q;
+            live = lastc && (!lastd || lastc > lastd);
+        }
+        free(buf);
+    }
+    CloseHandle(f);
+    return live;
+}
+
+/* Pick the render endpoint. Returns an AddRef'd device (or NULL) and writes the
+ * CURRENT DEFAULT endpoint id into default_id (what follow-the-default compares).
+ *   PS3_AUDIO_DEVICE=<text>   first active endpoint whose friendly name contains
+ *                             <text> (case-insensitive); "default" = plain default
+ *   otherwise                 the default eConsole endpoint -- except when that is
+ *                             a Steam Streaming virtual sink left as the default
+ *                             with no live Sunshine session (crashed/hung stream): then
+ *                             the first real active endpoint, so the game is not
+ *                             silent (PS3_AUDIO_AVOID_VIRTUAL=0 disables this).
+ * The active endpoints are listed once. */
+static IMMDevice* wasapi_pick_device(WCHAR* default_id, size_t n)
+{
+    IMMDevice* def = NULL;
+    if (!wasapi_default_id(default_id, n, &def)) def = NULL;
+    char wantbuf[1024];
+    const char* want = wasapi_env_utf8(L"PS3_AUDIO_DEVICE", wantbuf, (int)sizeof wantbuf);
+    const char* av = getenv("PS3_AUDIO_AVOID_VIRTUAL");
+    const int avoid = !(av && *av == '0');
+    char defname[256] = "";
+    if (def) wasapi_device_name(def, defname, sizeof defname);
+
+    IMMDeviceEnumerator* en = NULL;
+    IMMDeviceCollection* col = NULL;
+    UINT cnt = 0;
+    if (SUCCEEDED(CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_ALL,
+                                   &IID_IMMDeviceEnumerator, (void**)&en)) && en &&
+        SUCCEEDED(en->lpVtbl->EnumAudioEndpoints(en, eRender, DEVICE_STATE_ACTIVE, &col)) && col)
+        col->lpVtbl->GetCount(col, &cnt);
+    if (en) en->lpVtbl->Release(en);
+
+    static int listed = 0;
+    IMMDevice* pick = NULL; IMMDevice* real = NULL;
+    const char* why = NULL;
+    for (UINT i = 0; i < cnt; i++) {
+        IMMDevice* d = NULL;
+        if (FAILED(col->lpVtbl->Item(col, i, &d)) || !d) continue;
+        char nm[256]; wasapi_device_name(d, nm, sizeof nm);
+        if (!listed) printf("[cellAudio] output endpoint: \"%s\"%s\n", nm, strcmp(nm, defname) == 0 && def ? " (Windows default)" : "");
+        if (!pick && want && *want && _stricmp(want, "default") != 0 && wasapi_name_has(nm, want)) {
+            pick = d; d->lpVtbl->AddRef(d); why = "PS3_AUDIO_DEVICE";
+        }
+        if (!real && !wasapi_is_virtual_sink(nm)) { real = d; d->lpVtbl->AddRef(d); }
+        d->lpVtbl->Release(d);
+    }
+    listed = 1;
+    if (col) col->lpVtbl->Release(col);
+
+    if (!pick && want && *want && _stricmp(want, "default") != 0)
+        printf("[cellAudio] PS3_AUDIO_DEVICE=\"%s\" matches no active output -- using the default\n", want);
+    if (!pick && def && avoid && !(want && _stricmp(want, "default") == 0) &&
+        wasapi_is_virtual_sink(defname) && real && !wasapi_sunshine_session_live()) {
+        pick = real; real->lpVtbl->AddRef(real);
+        why = "the Windows default is a streaming virtual sink and no Sunshine stream is live";
+    }
+    if (!pick && def) { pick = def; def->lpVtbl->AddRef(def); }
+    if (why) {
+        char nm[256]; wasapi_device_name(pick, nm, sizeof nm);
+        printf("[cellAudio] using \"%s\" instead of the default \"%s\" (%s)\n", nm, defname, why);
+    }
+    if (real) real->lpVtbl->Release(real);
+    if (def) def->lpVtbl->Release(def);
+    return pick;
+}
+
+/* Current default render endpoint id (eConsole), into out; 0 on failure. */
+static int wasapi_default_id(WCHAR* out, size_t n, IMMDevice** keep)
+{
+    IMMDeviceEnumerator* en = NULL;
+    IMMDevice* dev = NULL;
+    out[0] = 0;
+    if (FAILED(CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_ALL,
+                                &IID_IMMDeviceEnumerator, (void**)&en)) || !en)
+        return 0;
+    HRESULT hr = en->lpVtbl->GetDefaultAudioEndpoint(en, eRender, eConsole, &dev);
+    en->lpVtbl->Release(en);
+    if (FAILED(hr) || !dev) return 0;
+    LPWSTR id = NULL;
+    if (SUCCEEDED(dev->lpVtbl->GetId(dev, &id)) && id) {
+        wcsncpy(out, id, n - 1); out[n - 1] = 0;
+        CoTaskMemFree(id);
+    }
+    if (keep) *keep = dev; else dev->lpVtbl->Release(dev);
+    return out[0] != 0;
+}
