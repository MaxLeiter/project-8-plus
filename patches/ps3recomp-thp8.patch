+/* This exe: PE link timestamp, image size, checksum, section count + file size
+ * (the harness's per-slot copies of one exe share it). */
+static u64 ld_psolib_exe_id(void)
+{
+    const u8* base = (const u8*)GetModuleHandleA(NULL);
+    u64 h = 1469598103934665603ull;
+    if (base) {
+        const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)base;
+        const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(base + dos->e_lfanew);
+        const u32 v[4] = { nt->FileHeader.TimeDateStamp, nt->OptionalHeader.SizeOfImage,
+                           nt->OptionalHeader.CheckSum, nt->FileHeader.NumberOfSections };
+        h = fnv1a(v, sizeof(v), h);
+    }
+    char path[MAX_PATH * 2];
+    const DWORD n = GetModuleFileNameA(NULL, path, sizeof(path));
+    WIN32_FILE_ATTRIBUTE_DATA fa;
+    if (n && n < sizeof(path) && GetFileAttributesExA(path, GetFileExInfoStandard, &fa)) {
+        const u32 s[2] = { fa.nFileSizeLow, fa.nFileSizeHigh };
+        h = fnv1a(s, sizeof(s), h);
+    }
+    return h;
+}
