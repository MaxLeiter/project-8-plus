+/* ---- PS3_HLE_TRIM: the lean import path (default on) ------------------------
+ *
+ * Every firmware import funnels through ps3_hle_call, and with every knob off
+ * most of its cost was the diagnostic scaffolding: ~7% of THP8's render-thread
+ * CPU in ps3_hle_call itself plus 1.2% in ps3_msf (xprof, draw17 rest view).
+ * Per call: the HLE_BT_EVERY / PS3_HLE_TRACE / PS3_HLE_ARGS /
+ * FLOW_NOSPILL statics, which share a cache line with g_last_hle_name -- written
+ * by every guest thread on every import, so each read is a coherence miss; the
+ * PS3_HLE_ARGLOG register copy (16-byte loads over the lifted code's fresh
+ * 8-byte stores: store-forwarding stalls) and its out-of-line destructor; a
+ * ps3_msf call that formats nothing while the milestone log is off; and a 2 KB
+ * frame for diagnostics that never run.
+ *
+ * hle_call_lean does what the full body does when no knob is set, in the same
+ * order: the TOC guard (r2 and the caller's 0x28(r1) slot restored on every
+ * exit, in-flight slot cleared), the GCM pump, the profiler stamp, both
+ * last-HLE breadcrumbs (placeholder first), the ABI TOC spill, the PRX bridge
+ * and the unresolved path (shared code, above), the dispatch cache, and the ctx
+ * or generic handler with its in-flight name. It applies only while no knob the
+ * full body reads per call is set (list in hle_trim_init) and not to the NIDs
+ * with an inline hook there (YDKJ_TUNERFIX, the exit chain, the GCM
+ * tile/display-buffer trace). lv2_syscall (ppu_loader.cpp) reads the same
+ * switch for its own diagnostics.
+ *
+ * Kill switch: PS3_HLE_TRIM=0, or live with PS3_HLE_TRIM_OFF_FILE=<path> (the
+ * file present = full path; polled at most every 250 ms by threads making
+ * calls). */
+#ifndef _WIN32
+#include <time.h>
+#include <unistd.h>
+#endif
+/* [0]: -1 unresolved, 0 full path, 1 lean, 2 lean + off file armed, 3 full + off
+ * file armed. A whole cache line of its own: read on every import and syscall,
+ * written only when the switch flips. */
+extern "C" alignas(64) volatile int g_ps3_hle_lean_mode[16] = { -1 };
+static const char* s_hle_trim_off;
+
+static unsigned long long hle_now_ms(void)
+{
+#ifdef _WIN32
+    return (unsigned long long)GetTickCount64();
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000ull + (unsigned long long)ts.tv_nsec / 1000000ull;
+#endif
+}
+static int hle_path_exists(const char* path)
+{
+#ifdef _WIN32
+    return GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
+#else
+    return access(path, F_OK) == 0;
+#endif
+}
