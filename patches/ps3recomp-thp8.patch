+/* Depth-compare sampling helper for unit u: rsx_zcmp<u>(tex, samp, uv, ref).
+ *
+ * RSX compares the FETCHED depth against the reference, `texel <zfunc> ref`.
+ * D3D/GL/Vulkan comparison samplers compute `ref <op> texel`, which is why
+ * RPCS3 builds its comparison sampler with
+ * vk::get_compare_func(tex.zfunc(), reverse_direction = true). THP8 writes
+ * TEXTURE_ADDRESS = 0x40030303 for its shadow units 14/15 (sub_5A0944):
+ * zfunc 4 = GREATER, i.e. lit where the stored occluder depth is farther than
+ * the receiver -- the only reading under which that value makes sense.
+ *
+ * The compare is done in the shader rather than with a comparison sampler so
+ * the root signature, the sampler cache and every other program stay as they
+ * are. A linear-filtered unit gets the NV40's 2x2 PCF (Gather + bilinear
+ * weights of the four 0/1 results); a point-filtered one a single compare.
+ * The reference is clamped to [0,1] and both operands are quantised to the
+ * depth format's unorm grid (the host depth is D32_FLOAT), so a receiver that
+ * samples its own depth compares the way the 24-bit hardware value would.
+ *
+ * PCF footprint. In texel space (tc = uv * size - 0.5, texel centres on
+ * integers) the bilinear footprint is texels i0..i0+1 x j0..j0+1 with
+ * (i0, j0) = floor(tc), weighted by f = frac(tc). The Gather is issued at
+ * the corner those four texels share, normalised (i0 + 1, j0 + 1) / size:
+ * there the sampler's own tc is i0 + 0.5, half a texel from either footprint
+ * boundary, so its fixed-point (~8-bit sub-texel) footprint choice always
+ * agrees with the float floor()/frac() here. Gathering at uv itself could
+ * pick the next footprint when frac(tc) was within ~1/256 of 1.0 while the
+ * weights still favoured this one: speckles along shadow-texel edges.
+ *
+ * Gather component order (D3D gather4 / HLSL Gather): counter-clockwise from
+ * the lower-left texel, i.e. offsets (-,+), (+,+), (+,-), (-,-) from the
+ * sample point, v growing downwards:
+ *     w = (i0,   j0  )   z = (i0+1, j0  )     row j0   (weight 1 - f.y)
+ *     x = (i0,   j0+1)   y = (i0+1, j0+1)     row j0+1 (weight f.y)
+ * hence lerp(lerp(w, z, f.x), lerp(x, y, f.x), f.y): f.x blends column i0
+ * into i0+1 within each row, f.y row j0 into j0+1. */
+static void fp_emit_shadow_helper(Out* p, u32 u, const rsx_fp_shadow_desc* s)
+{
+    static const char* op[7] = { NULL, "<", "==", "<=", ">", "!=", ">=" };
+    const u32 zf = s->zfunc[u];
+    if (zf < 1 || zf > 6) return;
+    const char* k = ((s->float_mask >> u) & 1u) ? NULL
+                  : ((s->depth16_mask >> u) & 1u) ? "65535.0" : "16777215.0";
+    char line[512];
+    snprintf(line, sizeof line,
+             "float4 rsx_zcmp%u(Texture2D t, SamplerState s, float2 uv, float z) {\n",
+             u);
+    out_puts(p, line);
+    const int pcf = (s->pcf_mask >> u) & 1u;
+    if (pcf && s->filter) {
+        fp_emit_shadow_filter(p, s, op[zf], k);
+        return;
+    }
+    out_puts(p, pcf ? "  uint w, h; t.GetDimensions(w, h); float2 sz = float2(w, h);\n"
+                      "  float2 tc = uv * sz - 0.5; float2 f = frac(tc);\n"
+                      "  float4 d = t.Gather(s, (floor(tc) + 1.0) / sz);\n"
+                    : "  float d = t.SampleLevel(s, uv, 0).x;\n");
+    if (k) {
+        snprintf(line, sizeof line,
+                 "  float r = round(saturate(z) * %s); d = round(saturate(d) * %s);\n",
+                 k, k);
+        out_puts(p, line);
+    } else {
+        out_puts(p, "  float r = z;\n");
+    }
+    if (pcf) {
+        snprintf(line, sizeof line,
+                 "  float4 c = (float4)(d %s r);\n"
+                 "  return (float4)lerp(lerp(c.w, c.z, f.x), lerp(c.x, c.y, f.x), f.y);\n"
+                 "}\n", op[zf]);
+    } else {
+        snprintf(line, sizeof line,
+                 "  return (float4)(d %s r);\n"
+                 "}\n", op[zf]);
+    }
+    out_puts(p, line);
+}
