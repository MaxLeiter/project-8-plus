+    typedef HRESULT (WINAPI *known_folder_fn)(const GUID*, DWORD, HANDLE, PWSTR*);
+    static const GUID folderid_documents =      /* FOLDERID_Documents {FDD39AD0-238F-46AF-ADB4-6C85480369C7} */
+        { 0xFDD39AD0, 0x238F, 0x46AF, { 0xAD, 0xB4, 0x6C, 0x85, 0x48, 0x03, 0x69, 0xC7 } };
+    HMODULE sh = LoadLibraryW(L"shell32.dll");           /* loaded at run time: the exe links no shell32 */
+    known_folder_fn fn = sh ? (known_folder_fn)(void*)GetProcAddress(sh, "SHGetKnownFolderPath") : NULL;
+    PWSTR wp = NULL;
+    if (fn && SUCCEEDED(fn(&folderid_documents, 0, NULL, &wp)) && wp) {
+        sd_utf8(wp, docs, (int)sizeof docs);
+        CoTaskMemFree(wp);
