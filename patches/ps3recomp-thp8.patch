new file mode 100644
index 00000000..9d5599a7
--- /dev/null
+++ b/tools/ppucheck/census.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""census.py - which PPU instructions does a title actually use?
+
+Decodes every word inside the lifted function bodies of a PPU ELF with the
+same decoder the lifter uses (ppu_disasm.decode) and counts mnemonics. The
+differential harness (ppucheck.py) uses the census to (a) choose which
+instructions to test and (b) weight the report by how often each instruction
+occurs in the title. Only counts and the mnemonic list are written by default;
+--samples additionally keeps up to N distinct instruction words per mnemonic
+(title-derived data: keep it out of the repo).
+
+    python census.py EBOOT.elf --functions functions.json --code-end 0xC14B38 \
+        -o census.json [--samples 24]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import struct
+import sys
+from collections import Counter, defaultdict
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(HERE))
+import ppu_disasm  # noqa: E402
+
+
+def load_segments(path):
+    """Minimal ELF64 big-endian loader: [(vaddr, bytes)] for PT_LOAD."""
+    data = open(path, "rb").read()
+    if data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 2:
+        raise SystemExit(f"{path}: not an ELF64 big-endian image")
+    phoff, = struct.unpack_from(">Q", data, 0x20)
+    phentsize, phnum = struct.unpack_from(">HH", data, 0x36)
+    segs = []
+    for i in range(phnum):
+        off = phoff + i * phentsize
+        p_type, p_flags, p_offset, p_vaddr, _pa, p_filesz, _memsz, _al = \
+            struct.unpack_from(">IIQQQQQQ", data, off)
+        if p_type == 1 and p_filesz:
+            segs.append((p_vaddr, data[p_offset:p_offset + p_filesz]))
+    return segs
+
+
+def read_word(segs, addr):
+    for base, blob in segs:
+        if base <= addr and addr + 4 <= base + len(blob):
+            return struct.unpack_from(">I", blob, addr - base)[0]
+    return None
+
+
+def census(elf, functions, code_end=None, samples=0, skip_tables=True):
+    """skip_tables: after a `bctr`, skip the inline jump table (consecutive
+    words whose top halfword is 0x0000 or 0xFFFF -- small signed offsets from
+    the table base). They are data the lifter never executes; decoded they
+    look like `.word` / `fre f31,f31` / `frsqrte f31,f31`."""
+    segs = load_segments(elf)
+    skipped = 0
+    funcs = json.load(open(functions))
+    seen = set()
+    counts = Counter()
+    raw_by_mn = defaultdict(list)
+    raw_seen = defaultdict(set)
+    for f in funcs:
+        s = int(f["start"], 16) if isinstance(f["start"], str) else f["start"]
+        e = int(f["end"], 16) if isinstance(f["end"], str) else f["end"]
+        if code_end is not None:
+            e = min(e, code_end)
+        in_table = False
+        for a in range(s, e, 4):
+            if a in seen:
+                continue
+            seen.add(a)
+            w = read_word(segs, a)
+            if w is None:
+                continue
+            if in_table and (w >> 16) in (0, 0xFFFF):
+                skipped += 1
+                continue
+            in_table = False
+            ins = ppu_disasm.decode(w, a)
+            mn = ins.mnemonic
+            if skip_tables and mn == "bctr":
+                in_table = True
+            counts[mn] += 1
+            if samples and len(raw_by_mn[mn]) < samples and w not in raw_seen[mn]:
+                raw_seen[mn].add(w)
+                raw_by_mn[mn].append(w)
+    out = {"elf": os.path.basename(elf), "words": len(seen),
+           "table_words_skipped": skipped,
+           "counts": dict(counts.most_common())}
+    if samples:
+        out["samples"] = {k: [f"0x{w:08X}" for w in v] for k, v in raw_by_mn.items()}
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("elf")
+    ap.add_argument("--functions", required=True)
+    ap.add_argument("--code-end", type=lambda s: int(s, 0))
+    ap.add_argument("--samples", type=int, default=0)
+    ap.add_argument("--keep-tables", action="store_true",
+                    help="count inline jump-table words too")
+    ap.add_argument("-o", "--output", required=True)
+    a = ap.parse_args()
+    res = census(a.elf, a.functions, a.code_end, a.samples,
+                 skip_tables=not a.keep_tables)
+    with open(a.output, "w") as fh:
+        json.dump(res, fh, indent=1)
+    print(f"{res['words']} words ({res['table_words_skipped']} jump-table words skipped), {len(res['counts'])} mnemonics -> {a.output}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/ppucheck/driver_main.cpp b/tools/ppucheck/driver_main.cpp
new file mode 100644
index 00000000..d3010599
--- /dev/null
+++ b/tools/ppucheck/driver_main.cpp
@@ -0,0 +1,230 @@
+// driver_main.cpp - runtime stand-ins and the record loop of the ppucheck
+// differential harness (tools/ppucheck/ppucheck.py).
+//
+// The generated test chunks hold one function per instruction word, each the
+// lifter's own emission for that word wrapped as
+//     g_ppuc_out = RETURN; { <lifted statement> } g_ppuc_out = FALL; return;
+//     loc_<target>: g_ppuc_out = TAKEN; return;
+// This file supplies what the lifted code links against (guest memory
+// accessors, store-conditional, indirect call, syscall, timebase) with the
+// same semantics the real runtime gives them, runs every input record through
+// its test function and writes the resulting architectural state back out.
+//
+// Guest memory: a 4 GiB reservation (vm_base) with only the page around the
+// test window committed. Window accesses work, accesses to the rest of the
+// committed page are caught by a canary check, anything else faults (SEH).
+
+#include "ppu_recomp.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <vector>
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <xmmintrin.h>
+
+#define PPUC_MEMBASE 0x4000u
+#define PPUC_MEMSIZE 512u
+#define PPUC_COMMIT_LO 0x3000u
+#define PPUC_COMMIT_HI 0x5000u
+
+enum { OUT_FALL = 0, OUT_TAKEN = 1, OUT_RETURN = 2, OUT_ICALL = 4, OUT_SYSCALL = 8, OUT_FAULT = 16 };
+
+extern "C" {
+uint8_t* vm_base = nullptr;
+PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+uint32_t g_ppuc_out = 0;
+void ppuc_call_stub(uint32_t target, ppu_context* ctx);
+}
+
+static uint32_t g_flags;
+static uint64_t g_icall, g_icall_lr;
+static ppu_context* g_cur;
+
+static inline bool in_win(uint64_t a, unsigned n)
+{
+    uint32_t x = (uint32_t)a;
+    return x >= PPUC_MEMBASE && (uint64_t)x + n <= PPUC_MEMBASE + PPUC_MEMSIZE;
+}
+
+extern "C" uint8_t vm_read8(uint64_t a)
+{
+    if (!in_win(a, 1)) { g_flags |= OUT_FAULT; return 0; }
+    return vm_base[(uint32_t)a];
+}
+extern "C" uint16_t vm_read16(uint64_t a)
+{
+    if (!in_win(a, 2)) { g_flags |= OUT_FAULT; return 0; }
+    uint16_t v; memcpy(&v, vm_base + (uint32_t)a, 2); return __builtin_bswap16(v);
+}
+extern "C" uint32_t vm_read32(uint64_t a)
+{
+    if (!in_win(a, 4)) { g_flags |= OUT_FAULT; return 0; }
+    uint32_t v; memcpy(&v, vm_base + (uint32_t)a, 4); return __builtin_bswap32(v);
+}
+extern "C" uint64_t vm_read64(uint64_t a)
+{
+    if (!in_win(a, 8)) { g_flags |= OUT_FAULT; return 0; }
+    uint64_t v; memcpy(&v, vm_base + (uint32_t)a, 8); return __builtin_bswap64(v);
+}
+extern "C" void vm_write8(uint64_t a, uint8_t v)
+{
+    if (!in_win(a, 1)) { g_flags |= OUT_FAULT; return; }
+    vm_base[(uint32_t)a] = v;
+}
+extern "C" void vm_write16(uint64_t a, uint16_t v)
+{
+    if (!in_win(a, 2)) { g_flags |= OUT_FAULT; return; }
+    v = __builtin_bswap16(v); memcpy(vm_base + (uint32_t)a, &v, 2);
+}
+extern "C" void vm_write32(uint64_t a, uint32_t v)
+{
+    if (!in_win(a, 4)) { g_flags |= OUT_FAULT; return; }
+    v = __builtin_bswap32(v); memcpy(vm_base + (uint32_t)a, &v, 4);
+}
+extern "C" void vm_write64(uint64_t a, uint64_t v)
+{
+    if (!in_win(a, 8)) { g_flags |= OUT_FAULT; return; }
+    v = __builtin_bswap64(v); memcpy(vm_base + (uint32_t)a, &v, 8);
+}
+
+// Mirrors runtime/ppu/ppu_loader.cpp: the reservation must be this thread's
+// (reserve_addr == ea) and the word must still hold the value lwarx saw.
+extern "C" int ppu_stwcx32(uint64_t ea, uint32_t expected, uint32_t val)
+{
+    if (!in_win(ea, 4)) { g_flags |= OUT_FAULT; return 0; }
+    if (g_cur && g_cur->reserve_addr != (uint32_t)ea) return 0;
+    uint32_t cur; memcpy(&cur, vm_base + (uint32_t)ea, 4);
+    if (__builtin_bswap32(cur) != expected) return 0;
+    uint32_t raw = __builtin_bswap32(val); memcpy(vm_base + (uint32_t)ea, &raw, 4);
+    return 1;
+}
+extern "C" int ppu_stdcx64(uint64_t ea, uint64_t expected, uint64_t val)
+{
+    if (!in_win(ea, 8)) { g_flags |= OUT_FAULT; return 0; }
+    if (g_cur && g_cur->reserve_addr != (uint32_t)ea) return 0;
+    uint64_t cur; memcpy(&cur, vm_base + (uint32_t)ea, 8);
+    if (__builtin_bswap64(cur) != expected) return 0;
+    uint64_t raw = __builtin_bswap64(val); memcpy(vm_base + (uint32_t)ea, &raw, 8);
+    return 1;
+}
+
+extern "C" void ps3_indirect_call(ppu_context* ctx)
+{
+    g_flags |= OUT_ICALL; g_icall = ctx->ctr; g_icall_lr = ctx->lr;
+}
+extern "C" void ps3_hle_call(unsigned int, ppu_context*) {}
+extern "C" void lv2_syscall(ppu_context*) { g_flags |= OUT_SYSCALL; }
+extern "C" uint64_t ppu_timebase_now(void) { return 0x0123456789ABCDEFull; }
+// direct call / trampoline targets referenced by a lifted branch (the harness
+// keeps branch targets in range, so reaching one is itself a mismatch)
+extern "C" void ppuc_call_stub(uint32_t target, ppu_context* ctx)
+{
+    g_flags |= OUT_ICALL; g_icall = target; g_icall_lr = ctx->lr;
+}
+
+typedef void (*ppuc_fn)(ppu_context*);
+extern "C" const ppuc_fn* ppuc_tables[];
+extern "C" const uint32_t ppuc_table_sizes[];
+extern "C" const uint32_t ppuc_ntables;
+
+#pragma pack(push, 1)
+struct rec_in {
+    uint32_t fn, pad;
+    uint64_t gpr[32];
+    uint64_t fpr[32];
+    uint8_t  vr[32][16];
+    uint32_t cr, xer, fpscr, vscr;
+    uint64_t lr, ctr, resv_addr, resv_val;
+    uint8_t  mem[PPUC_MEMSIZE];
+};
+struct rec_out {
+    uint64_t gpr[32];
+    uint64_t fpr[32];
+    uint8_t  vr[32][16];
+    uint32_t cr, xer, fpscr, vscr;
+    uint64_t lr, ctr, resv_addr, resv_val;
+    uint8_t  mem[PPUC_MEMSIZE];
+    uint32_t outcome, pad;
+    uint64_t icall, icall_lr;
+};
+#pragma pack(pop)
+
+static int run_one(ppuc_fn fn, ppu_context* ctx)
+{
+    __try {
+        fn(ctx);
+        while (g_trampoline_fn) {           // a trampoline is a tail jump out:
+            void (*t)(void*) = g_trampoline_fn;     // run it once -- the glue's
+            g_trampoline_fn = nullptr;              // func_X stub records the
+            g_ppuc_out = OUT_RETURN;                // target (icall) and LR
+            g_flags |= OUT_ICALL;
+            t(ctx);
+            g_trampoline_fn = nullptr;
+        }
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return 1;
+    }
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 3) { fprintf(stderr, "usage: %s in.bin out.bin\n", argv[0]); return 2; }
+    // A PPU thread's host MXCSR: round-to-nearest, all exceptions masked, no
+    // FTZ/DAZ (the runtime never changes it for PPU threads). Explicit, so
+    // the result does not depend on the process default.
+    _mm_setcsr(0x1F80);
+    vm_base = (uint8_t*)VirtualAlloc(nullptr, (SIZE_T)0x100010000ull, MEM_RESERVE, PAGE_NOACCESS);
+    if (!vm_base || !VirtualAlloc(vm_base + PPUC_COMMIT_LO, PPUC_COMMIT_HI - PPUC_COMMIT_LO,
+                                  MEM_COMMIT, PAGE_READWRITE)) {
+        fprintf(stderr, "VirtualAlloc failed\n"); return 3;
+    }
+    std::vector<ppuc_fn> fns;
+    for (uint32_t t = 0; t < ppuc_ntables; t++)
+        for (uint32_t i = 0; i < ppuc_table_sizes[t]; i++) fns.push_back(ppuc_tables[t][i]);
+
+    FILE* fi = fopen(argv[1], "rb");
+    FILE* fo = fopen(argv[2], "wb");
+    if (!fi || !fo) { fprintf(stderr, "cannot open files\n"); return 4; }
+    static uint8_t canary[PPUC_COMMIT_HI - PPUC_COMMIT_LO];
+    memset(canary, 0xA5, sizeof canary);
+    rec_in in; rec_out out;
+    unsigned long n = 0, crashes = 0;
+    while (fread(&in, sizeof in, 1, fi) == 1) {
+        ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+        memcpy(ctx.gpr, in.gpr, sizeof in.gpr);
+        memcpy(ctx.fpr, in.fpr, sizeof in.fpr);
+        memcpy(ctx.vr, in.vr, sizeof in.vr);
+        ctx.cr = in.cr; ctx.xer = in.xer; ctx.fpscr = in.fpscr; ctx.vscr = in.vscr;
+        ctx.lr = in.lr; ctx.ctr = in.ctr;
+        ctx.reserve_addr = in.resv_addr; ctx.reserve_value = in.resv_val;
+        ctx.reserve_valid = in.resv_addr != 0;
+        memcpy(vm_base + PPUC_COMMIT_LO, canary, sizeof canary);
+        memcpy(vm_base + PPUC_MEMBASE, in.mem, PPUC_MEMSIZE);
+        g_flags = 0; g_ppuc_out = OUT_FALL; g_cur = &ctx; g_trampoline_fn = nullptr;
+        g_icall = g_icall_lr = 0;
+        if (in.fn >= fns.size()) { fprintf(stderr, "bad fn %u\n", in.fn); return 5; }
+        if (run_one(fns[in.fn], &ctx)) { g_flags |= OUT_FAULT; crashes++; }
+        // stores that escaped the window but stayed on the committed pages
+        if (memcmp(vm_base + PPUC_COMMIT_LO, canary, PPUC_MEMBASE - PPUC_COMMIT_LO) ||
+            memcmp(vm_base + PPUC_MEMBASE + PPUC_MEMSIZE, canary,
+                   PPUC_COMMIT_HI - (PPUC_MEMBASE + PPUC_MEMSIZE)))
+            g_flags |= OUT_FAULT;
+        memcpy(out.gpr, ctx.gpr, sizeof out.gpr);
+        memcpy(out.fpr, ctx.fpr, sizeof out.fpr);
+        memcpy(out.vr, ctx.vr, sizeof out.vr);
+        out.cr = ctx.cr; out.xer = ctx.xer; out.fpscr = ctx.fpscr; out.vscr = ctx.vscr;
+        out.lr = ctx.lr; out.ctr = ctx.ctr;
+        out.resv_addr = ctx.reserve_addr; out.resv_val = ctx.reserve_value;
+        memcpy(out.mem, vm_base + PPUC_MEMBASE, PPUC_MEMSIZE);
+        out.outcome = g_ppuc_out | g_flags; out.pad = 0;
+        out.icall = g_icall; out.icall_lr = g_icall_lr;
+        fwrite(&out, sizeof out, 1, fo);
+        n++;
+    }
+    fclose(fi); fclose(fo);
+    fprintf(stderr, "ppucheck driver: %lu records, %lu crashed\n", n, crashes);
+    return 0;
+}
