+    uint32_t        abi_version;        /* plugin: PS3MOD_ABI_VERSION it was built with */
+    uint32_t        ctx_layout;         /* PS3MOD_CTX_LAYOUT, or 0 if ctx is not used */
+    uint32_t        lift_abi;           /* PS3MOD_LIFT_ABI, or 0 = does not care */
+    const char*     name;               /* display name, e.g. "Project 8 Plus" */
+    const char*     version;            /* plugin version string */
+    const char*     author;             /* optional */
+    const char*     description;        /* optional */
+    const char*     required_ppu_hash;  /* "PPU-<40 hex>" of the ELF it targets */
+    const char*     required_lift_id;   /* optional: host->lift_id it was tested on; NULL = any */
+    const uint32_t* required_entries;   /* optional: function entries that must exist */
+    uint32_t        n_required_entries;
+    uint32_t        flags;              /* PS3MOD_INFO_* */
+} ps3mod_info;
+
+/* ------------------------------------------------------------------------ */
+/* Plugin entry points (exported by the DLL, looked up by these names)       */
+
+typedef int  (*ps3mod_query_fn)(ps3mod_info* out);
+typedef int  (*ps3mod_init_fn)(const ps3mod_host* host, ps3mod_info* out);
+typedef void (*ps3mod_shutdown_fn)(void);
+
+#define PS3MOD_SYM_QUERY    "ps3mod_query"
+#define PS3MOD_SYM_INIT     "ps3mod_init"
+#define PS3MOD_SYM_SHUTDOWN "ps3mod_shutdown"
+
+#ifndef PS3MOD_HOST   /* the runtime defines this; plugins get the prototypes */
+/* Optional. Fill *out (no side effects); validated before init runs. */
+PS3MOD_EXPORT int  ps3mod_query(ps3mod_info* out);
+/* Required. Fill *out, then register hooks / patches / events through host.
+ * `host` stays valid until the plugin is unloaded. Return 0 to be loaded. */
+PS3MOD_EXPORT int  ps3mod_init(const ps3mod_host* host, ps3mod_info* out);
+/* Optional. Called once before the DLL is unloaded. */
+PS3MOD_EXPORT void ps3mod_shutdown(void);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
