+static void ld_psolib_store(const WCHAR* name, ID3D12PipelineState* pso, int may_wait, const ld_psolib_ix* ix);
+
+/* A shader blob from the disk cache by (stage, HLSL hash, length) -- no HLSL
+ * at hand (PS3_PSO_PREWARM). A reference, or NULL. */
+static ID3DBlob* shader_disk_cache_load_ref(u32 stage, u64 hash, u32 len)
+{
+    char path[MAX_PATH];
+    if (!shader_disk_cache_path(path, stage, hash, len)) return NULL;
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    shader_disk_cache_header h;
+    ID3DBlob* b = NULL;
+    const int ok = fread(&h, sizeof(h), 1, f) == 1 && h.magic == SHADER_DISK_CACHE_MAGIC &&
+        h.version == SHADER_DISK_CACHE_VERSION && h.stage == stage && h.source_hash == hash &&
+        h.source_length == len && h.blob_length > 0 && h.blob_length <= SHADER_DISK_CACHE_MAX_BLOB &&
+        fseek(f, (long)len, SEEK_CUR) == 0 && SUCCEEDED(D3DCreateBlob(h.blob_length, &b)) && b &&
+        fread(b->lpVtbl->GetBufferPointer(b), 1, h.blob_length, f) == h.blob_length;
+    fclose(f);
+    if (!ok && b) { b->lpVtbl->Release(b); b = NULL; }
+    return b;
+}
+
+/* ---------------------------------------------------------------------------
+ * PS3_PSO_PREWARM (default on; =0 off): at start-up PS3_PSO_PREWARM_THREADS (2)
+ * below-normal threads re-create every pipeline of the library's index from
+ * the shader disk cache and store what the library lacks. After a driver
+ * update (library payload dropped, driver cache empty) this rebuilds both in
+ * the background while the game boots; on a fresh exe path it fills the
+ * driver's per-exe cache (NVIDIA: a library load is a compile until then).
+ * When the first 24 creates average under 4 ms the driver cache is warm
+ * and the prewarm stops.
+ * -----------------------------------------------------------------------*/
+static struct {
+    ld_psolib_ix* list;
+    u32 n;
+    volatile LONG next, made, stored, skipped, stop;
+    volatile LONG64 us;
+    long long t0;
+    volatile LONG live;
+} g_pw;
+
+static DWORD LD_THREAD_CC ld_psolib_prewarm_worker(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN);   /* disk cache reads + compiles: background */
+    for (;;) {
+        if (g_pw.stop) break;
+        const LONG i = InterlockedIncrement(&g_pw.next) - 1;
+        if (i >= (LONG)g_pw.n) break;
+        const ld_psolib_ix* x = &g_pw.list[i];
+        ID3DBlob* vs = shader_disk_cache_load_ref('V', x->vs_hash, x->vs_len);
+        ID3DBlob* ps = vs ? shader_disk_cache_load_ref('P', x->ps_hash, x->ps_len) : NULL;
+        if (!vs || !ps) {
+            InterlockedIncrement(&g_pw.skipped);
+            if (vs) vs->lpVtbl->Release(vs);
+            continue;
+        }
+        render_state_t rs;
+        ld_psolib_ix_rs(x, &rs);
+        rsx_vertex_layout_plan plan;
+        rsx_vertex_layout_plan_init(&plan, x->inmask);
+        D3D12_INPUT_ELEMENT_DESC il[16];
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+        WCHAR name[20];
+        ld_fill_pso_desc(&pd, il, vs, ps, &rs, (x->flags & 1u) ? &plan : NULL, (x->flags & 2u) != 0,
+                         (x->flags & 4u) != 0);
+        if (ld_psolib_name(&pd, name) != x->name) {   /* another root signature / desc layout */
+            InterlockedIncrement(&g_pw.skipped);
+        } else {
+            ID3D12PipelineState* pso = NULL;
+            const long long t0 = ld_psolib_now_us();
+            const HRESULT hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState,
+                                                                          (void**)&pso);
+            const LONG made = InterlockedIncrement(&g_pw.made);
+            const LONG64 us = InterlockedExchangeAdd64(&g_pw.us, ld_psolib_now_us() - t0) + (ld_psolib_now_us() - t0);
+            if (SUCCEEDED(hr) && pso) {
+                if (!g_psolib.blob) {   /* rebuilding: store; an intact library has it (driver-cache warm only) */
+                    const LONG before = g_psolib.pipelines;
+                    ld_psolib_store(name, pso, 1, x);
+                    if (g_psolib.pipelines != before) InterlockedIncrement(&g_pw.stored);
+                }
+                pso->lpVtbl->Release(pso);
+            }
+            if (made == 24 && us < 24 * 4000 && g_psolib.blob) {   /* warm driver cache, intact library */
+                InterlockedExchange(&g_pw.stop, 1);
+                fprintf(stderr, "[pso-prewarm] driver cache warm (24 creates, %.2f ms avg): stopping\n",
+                        (double)us / 24000.0);
+            }
+        }
+        vs->lpVtbl->Release(vs);
+        ps->lpVtbl->Release(ps);
+    }
+    if (InterlockedDecrement(&g_pw.live) == 0)
+        fprintf(stderr, "[pso-prewarm] done: %ld of %u index entries re-created (%.1f ms avg), %ld stored into the "
+                        "library, %ld skipped (shader not in the disk cache / desc changed), %.1f s\n",
+                (long)g_pw.made, g_pw.n, g_pw.made ? (double)g_pw.us / g_pw.made / 1000.0 : 0.0, (long)g_pw.stored,
+                (long)g_pw.skipped, (double)(ld_psolib_now_us() - g_pw.t0) / 1e6);
+    return 0;
+}
+
+static void ld_psolib_prewarm_start(const ld_psolib_ix* ix, u32 n)
+{
+    const char* e = getenv("PS3_PSO_PREWARM");
+    if ((e && e[0] == '0') || !ix || !n || g_psolib.state != 1) return;
+    g_pw.list = (ld_psolib_ix*)malloc((size_t)n * sizeof(ld_psolib_ix));
+    if (!g_pw.list) return;
+    memcpy(g_pw.list, ix, (size_t)n * sizeof(ld_psolib_ix));
+    g_pw.n = n;
+    g_pw.t0 = ld_psolib_now_us();
+    const char* t = getenv("PS3_PSO_PREWARM_THREADS");
+    int threads = t ? atoi(t) : 2;
+    if (threads < 1) threads = 1;
+    if (threads > 8) threads = 8;
+    g_pw.live = threads;
+    int started = 0;
+    for (int i = 0; i < threads; i++) {
+        HANDLE th = CreateThread(NULL, 0, ld_psolib_prewarm_worker, NULL, 0, NULL);
+        if (th) { CloseHandle(th); started++; }
+    }
+    InterlockedExchangeAdd(&g_pw.live, started - threads);
+    fprintf(stderr, "[pso-prewarm] %u index entries, %d threads (library %s)\n", n, started,
+            g_psolib.blob ? "intact: stops early on a warm driver cache" : "rebuilt from the index");
+}
+
+/* Read and check a library file. same_exe: it must be this exe's. Returns NULL
+ * with *blob / *bytes / *pipes set, or why the payload cannot be used. The
+ * index (*ix / *ix_n, malloc'd) is returned whenever the file is of this
+ * version and root signature -- also after a driver or GPU change. */
+static const char* ld_psolib_read(const char* path, int same_exe, void** blob, size_t* bytes, u32* pipes,
+                                  ld_psolib_ix** ix, u32* ix_n)
+{
+    *blob = NULL; *bytes = 0; *pipes = 0;
+    if (ix) { *ix = NULL; *ix_n = 0; }
+    FILE* f = fopen(path, "rb");
+    if (!f) return "no library file yet";
+    const char* why = NULL;
+    ld_psolib_header h;
+    const ld_psolib_header* id = &g_psolib.id;
+    const int hdr_ok = fread(&h, sizeof(h), 1, f) == 1 && h.magic == LD_PSOLIB_MAGIC &&
+                       h.version == LD_PSOLIB_VERSION && h.header_bytes == sizeof(h);
+    if (hdr_ok && ix && h.rootsig == id->rootsig && h.ix_count && h.ix_count < 1000000u &&
+        h.ix_entry_bytes == sizeof(ld_psolib_ix) &&
+        _fseeki64(f, (long long)sizeof(h) + (long long)h.payload_bytes, SEEK_SET) == 0) {
+        ld_psolib_ix* x = (ld_psolib_ix*)malloc((size_t)h.ix_count * sizeof(ld_psolib_ix));
+        if (x && fread(x, sizeof(ld_psolib_ix), h.ix_count, f) == h.ix_count &&
+            ld_psolib_hash(x, (size_t)h.ix_count * sizeof(ld_psolib_ix), LD_PSOLIB_MAGIC + 1u) == h.ix_hash) {
+            *ix = x; *ix_n = h.ix_count;
+        } else {
+            free(x);
+        }
+    }
+    if (hdr_ok) _fseeki64(f, (long long)sizeof(h), SEEK_SET);
+    if (!hdr_ok)
+        why = "not a library of this version";
+    else if (same_exe && h.exe != id->exe) why = "written by another exe";
+    else if (h.vendor != id->vendor || h.device != id->device || h.subsys != id->subsys ||
+             h.revision != id->revision)
+        why = "written on another GPU";
+    else if (h.driver != id->driver) why = "the GPU driver changed";
+    else if (h.rootsig != id->rootsig) why = "the root signature changed";
+    else if (!h.payload_bytes || h.payload_bytes > g_psolib.max_bytes) why = "empty or over PS3_PSO_LIBRARY_MAX_MB";
+    else {
+        void* b = malloc((size_t)h.payload_bytes);
+        if (b && fread(b, 1, (size_t)h.payload_bytes, f) == (size_t)h.payload_bytes &&
+            ld_psolib_hash(b, (size_t)h.payload_bytes, LD_PSOLIB_MAGIC) == h.payload_hash) {
+            *blob = b;
+            *bytes = (size_t)h.payload_bytes;
+            *pipes = h.pipelines;
+        } else {
+            free(b);
+            why = "damaged (payload hash)";
+        }
+    }
+    fclose(f);
+    return why;
+}
+
+/* A new exe (no library of its own yet): the most recently written library of
+ * another exe in the same directory that fits this GPU, driver and root
+ * signature. Its entries are named by their full desc, so the ones this exe
+ * still builds hit and the rest are never matched. */
+static int ld_psolib_find_seed(const char* path, char* seed, size_t cap, void** blob, size_t* bytes, u32* pipes,
+                               ld_psolib_ix** ix, u32* ix_n)
+{
+    char dir[MAX_PATH], pat[MAX_PATH + 16];
+    snprintf(dir, sizeof dir, "%s", path);
+    char* s1 = strrchr(dir, '/');
+    char* s2 = strrchr(dir, '\\');
+    char* sl = s1 > s2 ? s1 : s2;
+    if (!sl) return 0;
+    *sl = 0;
+    snprintf(pat, sizeof pat, "%s/pso_library_*.bin", dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE) return 0;
+    static struct { char name[MAX_PATH]; u64 t; } c[32];
+    u32 n = 0;
+    do {
+        if ((fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || n >= 32) continue;
+        snprintf(c[n].name, sizeof c[n].name, "%s/%s", dir, fd.cFileName);
+        c[n].t = ((u64)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+        if (_stricmp(c[n].name, path) != 0) n++;
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+    for (u32 tries = 0; tries < 4 && tries < n; tries++) {   /* newest first */
+        u32 best = tries;
+        for (u32 i = tries + 1; i < n; i++) if (c[i].t > c[best].t) best = i;
+        if (best != tries) {
+            static struct { char name[MAX_PATH]; u64 t; } tmp;
+            memcpy(&tmp, &c[tries], sizeof(tmp)); memcpy(&c[tries], &c[best], sizeof(tmp)); memcpy(&c[best], &tmp, sizeof(tmp));
+        }
+        const char* why = ld_psolib_read(c[tries].name, 0, blob, bytes, pipes, ix, ix_n);
+        if (!why) { snprintf(seed, cap, "%s", c[tries].name); return 1; }
+        if (ix && *ix) { free(*ix); *ix = NULL; *ix_n = 0; }
+        fprintf(stderr, "[pso-library] not seeding from %s (%s)\n", c[tries].name, why);
+    }
+    return 0;
+}
+
+/* After make_root_signature (g_ld_rootsig_hash). at_exit: register the exit save. */
+static void ld_psolib_init(int at_exit)
+{
+    memset(&g_psolib, 0, sizeof(g_psolib));
+    InitializeSRWLock(&g_psolib.lock);
+    InitializeSRWLock(&g_psolib.plock);
+    InitializeSRWLock(&g_psolib.ixlock);
+    const char* e = getenv("PS3_PSO_LIBRARY");
+    if (e && e[0] == '0') { fprintf(stderr, "[pso-library] off (PS3_PSO_LIBRARY=0)\n"); return; }
+    ld_psolib_identity(&g_psolib.id);
+    const char* fp = getenv("PS3_PSO_LIBRARY_FILE");
+    if (fp && *fp) {
+        snprintf(g_psolib.path, sizeof g_psolib.path, "%s", fp);
+        /* the prewarm threads read the shader disk cache: set it up here, not
+         * lazily from two threads at once (one lost the race and skipped) */
+        shader_disk_cache_prepare();
+    } else {
+        if (!shader_disk_cache_prepare()) {
+            fprintf(stderr, "[pso-library] off (no shader disk cache directory)\n");
+            return;
+        }
+        snprintf(g_psolib.path, sizeof g_psolib.path, "%s/pso_library_%016llx.bin", g_ld_shader_disk_dir,
+                 (unsigned long long)g_psolib.id.exe);
+    }
+    const char* sn = getenv("PS3_PSO_LIBRARY_SAVE_N");
+    g_psolib.save_n = sn ? (u32)strtoul(sn, NULL, 0) : 32u;
+    if (!g_psolib.save_n) g_psolib.save_n = 1;
+    const char* mm = getenv("PS3_PSO_LIBRARY_MAX_MB");
+    g_psolib.max_bytes = (u64)(mm ? strtoul(mm, NULL, 0) : 512u) << 20;
+    ID3D12Device1* d1 = NULL;
+    if (FAILED(g.dev->lpVtbl->QueryInterface(g.dev, &IID_ID3D12Device1, (void**)&d1)) || !d1) {
+        fprintf(stderr, "[pso-library] off (no ID3D12Device1)\n");
+        return;
+    }
+    const long long t0 = ld_psolib_now_us();
+    void* blob = NULL;
+    size_t bytes = 0;
+    u32 pipes = 0;
+    ld_psolib_ix* ix = NULL;
+    u32 ix_n = 0;
+    const char* why = ld_psolib_read(g_psolib.path, 1, &blob, &bytes, &pipes, &ix, &ix_n);
+    char seed[MAX_PATH];
+    seed[0] = 0;
+    const char* inh = getenv("PS3_PSO_LIBRARY_INHERIT");
+    if (!blob && !(fp && *fp) && !(inh && inh[0] == '0')) {
+        ld_psolib_ix* six = NULL;
+        u32 six_n = 0;
+        if (ld_psolib_find_seed(g_psolib.path, seed, sizeof seed, &blob, &bytes, &pipes, &six, &six_n)) {
+            why = NULL;
+            if (six) { free(ix); ix = six; ix_n = six_n; }
+        }
+    }
+    HRESULT hr = E_FAIL;
+    if (blob) {
+        hr = d1->lpVtbl->CreatePipelineLibrary(d1, blob, bytes, &IID_ID3D12PipelineLibrary, (void**)&g_psolib.lib);
+        if (FAILED(hr) || !g_psolib.lib) {
+            why = hr == D3D12_ERROR_DRIVER_VERSION_MISMATCH ? "the driver rejected it (driver version)"
+                : hr == D3D12_ERROR_ADAPTER_NOT_FOUND ? "the driver rejected it (adapter)"
+                : "the driver rejected it";
+            if (g_psolib.lib) { g_psolib.lib->lpVtbl->Release(g_psolib.lib); g_psolib.lib = NULL; }
+            free(blob);
+            blob = NULL;
+            pipes = 0;
+        }
+    }
+    /* the index stays with the payload it describes; a dropped payload keeps it
+     * only as the prewarm list (entries go back in as the rebuild stores them) */
+    if (blob && ix) {
+        g_psolib.ix = ix; g_psolib.ix_n = g_psolib.ix_cap = ix_n;
+        for (u32 i = 0; i < ix_n; i++) ld_psolib_name_mark(ix[i].name);
+    }
+    if (!g_psolib.lib)
+        hr = d1->lpVtbl->CreatePipelineLibrary(d1, NULL, 0, &IID_ID3D12PipelineLibrary, (void**)&g_psolib.lib);
+    d1->lpVtbl->Release(d1);
+    if (FAILED(hr) || !g_psolib.lib) {
+        g_psolib.lib = NULL;
+        free(blob);
+        if (g_psolib.ix != ix) free(ix);
+        free(g_psolib.ix); g_psolib.ix = NULL; g_psolib.ix_n = g_psolib.ix_cap = 0;
+        fprintf(stderr, "[pso-library] off (CreatePipelineLibrary hr=0x%08lX)\n", (unsigned long)hr);
+        return;
+    }
+    g_psolib.blob = blob;
+    g_psolib.pipelines = (LONG)pipes;
+    g_psolib.state = 1;
+    if (blob && seed[0]) {
+        fprintf(stderr, "[pso-library] new library %s, seeded with %u pipelines (%.1f MB) of another exe's library %s "
+                        "in %.1f ms (entries are matched by their full desc; PS3_PSO_LIBRARY_INHERIT=0: no seed)\n",
+                g_psolib.path, pipes, (double)bytes / 1048576.0, seed, (double)(ld_psolib_now_us() - t0) / 1000.0);
+        g_psolib.dirty = 1;   /* written under this exe's name at the next save */
+        InterlockedExchange64(&g_psolib.last_new_us, ld_psolib_now_us());
+    } else if (blob)
+        fprintf(stderr, "[pso-library] %u pipelines (%.1f MB) from %s in %.1f ms\n", pipes,
+                (double)bytes / 1048576.0, g_psolib.path, (double)(ld_psolib_now_us() - t0) / 1000.0);
+    else
+        fprintf(stderr, "[pso-library] new library %s (%s)\n", g_psolib.path, why);
+    if (!(fp && *fp)) ld_psolib_tidy(g_psolib.path);
+    if (at_exit) {
+        atexit(ld_psolib_atexit);
+        ld_psolib_prewarm_start(ix, ix_n);   /* takes a copy */
+        if (blob) ld_pso_preload_start(ix, ix_n);   /* takes a copy */
+    }
+    if (ix != g_psolib.ix) free(ix);
+}
+
+/* build_pso: the library's copy of this desc, or NULL */
+static ID3D12PipelineState* ld_psolib_load(const WCHAR* name, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd)
+{
+    ID3D12PipelineState* pso = NULL;
+    if (g_psolib.serializing) {   /* a save holds the runtime's library lock: create instead of waiting */
+        InterlockedIncrement(&g_psolib.load_skips);
+        return NULL;
+    }
+    FT_T0(ft_l0);
+    static int lock_on = -1;
+    if (lock_on < 0) {
+        const char* e = getenv("PS3_PSO_LOAD_LOCK");
+        lock_on = !(e && *e == '0');
+        fprintf(stderr, "[pso-library] LoadGraphicsPipeline serialised (PS3_PSO_LOAD_LOCK): %s\n", lock_on ? "on" : "OFF");
+    }
+    if (lock_on) AcquireSRWLockExclusive(&g_psolib.loadlock);
+    const long long t0 = ld_psolib_now_us();   /* after the lock: load_us / the cold-cache rule see driver time only */
+    const HRESULT hr = g_psolib.lib->lpVtbl->LoadGraphicsPipeline(g_psolib.lib, name, pd,
+                                                                  &IID_ID3D12PipelineState, (void**)&pso);
+    if (lock_on) ReleaseSRWLockExclusive(&g_psolib.loadlock);
+    if (SUCCEEDED(hr) && pso) {
+        const LONG64 dt = ld_psolib_now_us() - t0;
+        InterlockedExchangeAdd64(&g_psolib.load_us, dt);
+        for (LONG64 m = g_psolib.load_max_us; dt > m;) {
+            const LONG64 seen = InterlockedCompareExchange64(&g_psolib.load_max_us, dt, m);
+            if (seen == m) break;
+            m = seen;
+        }
+        InterlockedIncrement(&g_psolib.loads);
+        FT_ADD(FT_PSOLIB_N, 1); FT_ADD(FT_PSOLIB_US, FT_SINCE(ft_l0));
+        return pso;
+    }
+    if (pso) pso->lpVtbl->Release(pso);
+    return NULL;
+}
+
+/* A new PSO into the library (stores are serialised: lock exclusive, so the
+ * name check and the store are one step). may_wait = 0 (render thread):
+ * while a save or another store holds the lock the PSO is queued (AddRef) and
+ * stored by the next tick / save instead. */
+static void ld_psolib_store(const WCHAR* name, ID3D12PipelineState* pso, int may_wait, const ld_psolib_ix* ix)
+{
+    InterlockedIncrement(&g_psolib.creates);
+    if (may_wait) AcquireSRWLockExclusive(&g_psolib.lock);
+    else if (!TryAcquireSRWLockExclusive(&g_psolib.lock)) {
+        AcquireSRWLockExclusive(&g_psolib.plock);
+        if (g_psolib.n_pending < LD_PSOLIB_PENDING) {
+            memcpy(g_psolib.pending[g_psolib.n_pending].name, name, sizeof(g_psolib.pending[0].name));
+            pso->lpVtbl->AddRef(pso);
+            g_psolib.pending[g_psolib.n_pending].has_ix = ix != NULL;
+            if (ix) g_psolib.pending[g_psolib.n_pending].ix = *ix;
+            g_psolib.pending[g_psolib.n_pending++].pso = pso;
+        }
+        ReleaseSRWLockExclusive(&g_psolib.plock);
+        return;
+    }
+    ld_psolib_store_locked(name, pso, ix);
+    ReleaseSRWLockExclusive(&g_psolib.lock);
+}
+
+/* ---------------------------------------------------------------------------
+ * PS3_PSO_PRELOAD (default on with an intact library; =0 off, =verify: look up, then build the normal way and
+ * compare the library name; live PS3_PSO_PRELOAD_OFF_FILE, present = off, checked <= every 250 ms).
+ * One background thread (below normal, background I/O mode) loads every pipeline of the library's index at
+ * start-up -- shader blobs from the disk cache, the desc rebuilt from the index exactly like PS3_PSO_PREWARM
+ * (and only when it reproduces the stored library name), LoadGraphicsPipeline -- into a table keyed by the index
+ * entry itself (HLSL hash + length of both stages, layout mask / flags, the LD_RS_PSO_FIELDS render state: every
+ * input of ld_fill_pso_desc; the vertex layout plan is rsx_vertex_layout_plan_init(mask) in get_pso too). The
+ * table is published once complete; from then on build_pso finds such a pipeline before it touches the shader
+ * blob caches, the disk cache (psodisk) or the library (psolib).
+ * THP8 census20 steady skating: library-resolved PSO misses cost ~0.3-1.3 ms each on the render thread, ~37% of it
+ * the disk blob reads and LoadGraphicsPipeline this moves to boot.
+ * -------------------------------------------------------------------------*/
+#define LD_PRE_KEY_BYTES ((u32)(offsetof(ld_psolib_ix, rs) - offsetof(ld_psolib_ix, vs_hash) + sizeof(u32) * LD_RS_PSO_NFIELDS))
+typedef struct { ld_psolib_ix k; ID3D12PipelineState* pso; } ld_pre_ent;
+static struct {
+    ld_pre_ent* t; u32 cap;
+    ld_psolib_ix* list; u32 n;
+    volatile LONG ready;
+    int mode;                                   /* -1 unread, 0 off, 1 on, 2 verify */
+    const char* off; volatile int live; unsigned long long next;
+    volatile LONG64 hit, vbad, vok, loaded, failed;
+    u64 expect;                                 /* verify: the found entry's library name (render thread) */
+} g_pre = { NULL, 0, NULL, 0, 0, -1, NULL, 1, 0, 0, 0, 0, 0, 0, 0 };
+static const u8* ld_pre_kp(const ld_psolib_ix* k) { return (const u8*)&k->vs_hash; }
+static u32 ld_pre_hash(const ld_psolib_ix* k)
+{
+    const u8* p = ld_pre_kp(k); u64 h = 1469598103934665603ull;
+    for (u32 i = 0; i < LD_PRE_KEY_BYTES; i++) { h ^= p[i]; h *= 1099511628211ull; }
+    return (u32)(h ^ (h >> 32));
+}
+static int ld_pre_mode(void)
+{
+    if (g_pre.mode < 0) {
+        const char* e = getenv("PS3_PSO_PRELOAD");
+        g_pre.off = getenv("PS3_PSO_PRELOAD_OFF_FILE");
+        if (g_pre.off && !*g_pre.off) g_pre.off = NULL;
+        g_pre.mode = !e || !*e ? 1 : (!strcmp(e, "0") || !strcmp(e, "off")) ? 0 : !strcmp(e, "verify") ? 2 : 1;
+    }
+    if (!g_pre.mode || !g_pre.off) return g_pre.mode;
+    const unsigned long long now = GetTickCount64();
