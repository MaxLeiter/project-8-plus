+/* Build an 8-byte list element: word0 = [S:1][reserved:16][size:15]. */
+static void list_elem(spu_context* c, uint32_t lsa, uint32_t size, uint32_t eal, int stall)
+{
+    spu_ls_write32(c, lsa, (stall ? 0x80000000u : 0) | (size & 0x7FFF));
+    spu_ls_write32(c, lsa + 4, eal);
+}
+
+static void test_mfc_list(void)
+{
+    TEST("mfc.getl-lsa-advance");
+    spu_context* c = new_ctx(5);
+    /* Mixed sizes. Each element lands at the running LSA, rounded to a
+     * quadword, plus the EA's offset within its quadword; the running LSA then
+     * advances by the size rounded up to 16. */
+    const uint32_t L = 0x800;                       /* list in LS, 8-byte aligned */
+    const uint32_t eas[]   = { EA_BUF + 0x104, EA_BUF + 0x200, EA_BUF + 0x308, EA_BUF + 0x401, EA_BUF + 0x500 };
+    const uint32_t sizes[] = { 4,              48,             8,              1,              0x100 };
+    uint32_t expect_lsa[5];
+    uint32_t cur = 0x9000;
+    for (int i = 0; i < 5; i++) {
+        list_elem(c, L + 8u * i, sizes[i], eas[i], 0);
+        expect_lsa[i] = (cur & ~15u) | (eas[i] & 15u);
+        cur = (cur & ~15u) + ((sizes[i] + 15u) & ~15u);
+    }
+    fill(vm_base + EA_BUF, 0x800, 0x21);
+    memset(c->ls + 0x9000, 0, 0x400);
+    mfc(c, MFC_GETL_CMD, 0x9000, L, 5 * 8, 9);
+    { int ok = 1;
+      for (int i = 0; i < 5; i++)
+          if (memcmp(c->ls + expect_lsa[i], vm_base + eas[i], sizes[i])) ok = 0;
+      CHECK(ok); }
+    CHECK_EQ(tag_wait(c, 1u << 9, MFC_TAG_UPDATE_ALL), 1u << 9);
+
+    TEST("mfc.putl");
+    memset(vm_base + EA_BUF + 0x1000, 0, 0x800);
+    for (int i = 0; i < 5; i++) list_elem(c, L + 8u * i, sizes[i], eas[i] + 0x1000, 0);
+    fill(c->ls + 0x9000, 0x400, 0x63);
+    mfc(c, MFC_PUTL_CMD, 0x9000, L, 5 * 8, 10);
+    { int ok = 1;
+      for (int i = 0; i < 5; i++)
+          if (memcmp(vm_base + eas[i] + 0x1000, c->ls + expect_lsa[i], sizes[i])) ok = 0;
+      CHECK(ok); }
+    /* Fenced and barriered list forms move the same data. */
+    memset(vm_base + EA_BUF + 0x1000, 0, 0x800);
+    mfc(c, MFC_PUTLF_CMD, 0x9000, L, 5 * 8, 10);
+    CHECK(memcmp(vm_base + eas[4] + 0x1000, c->ls + expect_lsa[4], sizes[4]) == 0);
+    memset(c->ls + 0x9000, 0, 0x400);
+    mfc(c, MFC_GETLB_CMD, 0x9000, L, 5 * 8, 10);
+    CHECK(memcmp(c->ls + expect_lsa[1], vm_base + eas[1] + 0x1000, sizes[1]) == 0);
+    CHECK_EQ(tag_wait(c, 1u << 10, MFC_TAG_UPDATE_ALL), 1u << 10);
+
+    /* Stall-and-notify on a middle element: the elements up to and including
+     * it transfer, the list parks, RdListStallStat names the tag (count 1,
+     * read clears), SPU_EVENT_SN (0x2) is raised, the tag group stays
+     * incomplete; WrListStallAck resumes the rest and completes the tag. */
+    TEST("mfc.list-stall-notify");
+    for (int i = 0; i < 5; i++) list_elem(c, L + 8u * i, sizes[i], eas[i], i == 1);
+    memset(c->ls + 0x9000, 0, 0x400);
+    wr(c, SPU_WrEventMask, 0x2);
+    CHECK_EQ(cnt(c, MFC_RdListStallStat), 0);
+    mfc(c, MFC_GETL_CMD, 0x9000, L, 5 * 8, 11);
+    CHECK(memcmp(c->ls + expect_lsa[0], vm_base + eas[0], sizes[0]) == 0);
+    CHECK(memcmp(c->ls + expect_lsa[1], vm_base + eas[1], sizes[1]) == 0);
+    CHECK_EQ(c->ls[expect_lsa[2]], 0);                   /* not yet */
+    CHECK_EQ(cnt(c, MFC_RdListStallStat), 1);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 1);
+    CHECK_EQ(rd(c, SPU_RdEventStat), 0x2);
+    CHECK_EQ(tag_wait(c, 1u << 11, MFC_TAG_UPDATE_IMMEDIATE), 0);
+    CHECK_EQ(rd(c, MFC_RdListStallStat), 1u << 11);
+    CHECK_EQ(cnt(c, MFC_RdListStallStat), 0);
+    wr(c, SPU_WrEventAck, 0x2);
+    CHECK_EQ(cnt(c, SPU_RdEventStat), 0);
+    wr(c, MFC_WrListStallAck, 11);
+    { int ok = 1;
+      for (int i = 2; i < 5; i++)
+          if (memcmp(c->ls + expect_lsa[i], vm_base + eas[i], sizes[i])) ok = 0;
+      CHECK(ok); }
+    CHECK_EQ(tag_wait(c, 1u << 11, MFC_TAG_UPDATE_ALL), 1u << 11);
+    CHECK_EQ(cnt(c, MFC_RdListStallStat), 0);
+    /* Two lists stalled on different tags accumulate in the stall status. */
+    list_elem(c, 0xA00, 16, EA_BUF, 1); list_elem(c, 0xA08, 16, EA_BUF + 16, 0);
+    list_elem(c, 0xA10, 16, EA_BUF, 1); list_elem(c, 0xA18, 16, EA_BUF + 16, 0);
+    mfc(c, MFC_GETL_CMD, 0xB000, 0xA00, 16, 20);
+    mfc(c, MFC_GETL_CMD, 0xB100, 0xA10, 16, 21);
+    CHECK_EQ(rd(c, MFC_RdListStallStat), (1u << 20) | (1u << 21));
+    wr(c, MFC_WrListStallAck, 20); wr(c, MFC_WrListStallAck, 21);
+    CHECK_EQ(tag_wait(c, 3u << 20, MFC_TAG_UPDATE_ALL), 3u << 20);
+    wr(c, SPU_WrEventAck, 0x2); wr(c, SPU_WrEventMask, 0);
+    free_ctx(c);
+}
