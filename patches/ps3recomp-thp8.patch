+/* harness_rt.cpp -- liftdiff runtime: everything the lifted code links against.
+ *
+ * Compiled once per variant against THAT variant's ppu_recomp.h. Every
+ * runtime entry point the lifted code can reach is defined here; anything a
+ * variant references that is not defined here (or in lds_gen.cpp) is a link
+ * error on purpose -- extend this file, never stub it silently.
+ *
+ *   memory       vm_base, vm_read8..64 / vm_write8..64 (plain big-endian),
+ *                ppu_stwcx32 / ppu_stdcx64 (big-endian compare-exchange)
+ *   time         ppu_timebase_now (deterministic counter, reset per test)
+ *   control      ps3_indirect_call, ps3_hle_call, lv2_syscall -> trace event +
+ *                deterministic clobber (lds_record_and_clobber); the stubbed
+ *                func_X definitions in lds_gen.cpp land in the same place
+ *   trampolines  g_trampoline_fn (the driver drains it like the runtime does)
+ *   variant B    ppu_line_flags[] (one byte per 128-byte guest line, index addr >> 7:
+ *                bit0 = loads -> vm_read*, bit1 = stores -> vm_write*),
+ *                ppu_icall_tab / ppu_icall_lo / ppu_icall_n (n = 0: every indirect
+ *                call falls back to ps3_indirect_call), g_active_ctx (TLS)
+ *                -- all zero = fast path / disabled; options below flip them
+ *
+ * Options (liftdiff.py --opt KEY=VAL, or the driver's --opt):
+ *   CLOBBER=abi|all   which registers a stubbed callee destroys
+ *   SLOWMEM=1|ld|st   ppu_line_flags[*] = 3 (loads+stores) | 1 (loads) | 2 (stores):
+ *                     guest accesses take B's vm_read* / vm_write* slow path
+ *   ICALL=1           ppu_icall_tab covers the code range and maps every func_X
+ *                     symbol of this build (stubs + closure fns) -> B's inline
+ *                     indirect-call fast path is taken where it can be
+ *   TRACELIMIT=n      events per test before status TRACELIMIT (default 200000)
+ *   MEMLIMIT=mb       demand-committed MB per test before MEMLIMIT (default 64)
+ *   BSS=0|1           seed the ELF's .bss (zero-fill part of writable PT_LOADs) with
+ *                     the same pointer-rich mix as the heap (default 1): globals then
+ *                     point at random structures instead of all being null
+ *   NANFREE=1         no seeded register / memory word is a float NaN or Inf bit pattern
+ *                     (separates NaN-payload choices of the C compiler from real differences)
+ *   DEMAND=pattern|zero  content of a demand-committed 64 KB granule outside the
+ *                     heap/stack/ELF: the heap's pointer-rich mix seeded by (seed,
+ *                     granule) (default), or zeros. The null granule is always zero.
+ * To add a knob for a new variant-B symbol: define the symbol below, add a
+ * field to LdsConfig (lds_rt.h), parse it in lds_configure, apply it in
+ * lds_apply_config. */
+#include "lds_rt.h"
+#include <stdio.h>
+#include <stdlib.h>
+#define NOMINMAX
+#include <windows.h>
+
+LdsConfig g_lds = { LDS_CLOBBER_ABI, 0, 0, 200000, 64ull << 20, 0, 1, 1, 0 };
+
+/* ======================= runtime symbols (both variants) ===================== */
+extern "C" uint8_t* vm_base = nullptr;
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+extern "C" PPU_THREAD_LOCAL ppu_context* g_active_ctx = nullptr;   /* driver: &ctx per test */
+
+#define LDS_P(a) (vm_base + (uint32_t)(a))
+extern "C" uint8_t  vm_read8 (uint64_t a) { return *LDS_P(a); }
+extern "C" uint16_t vm_read16(uint64_t a) { uint16_t v; memcpy(&v, LDS_P(a), 2); return __builtin_bswap16(v); }
+extern "C" uint32_t vm_read32(uint64_t a) { uint32_t v; memcpy(&v, LDS_P(a), 4); return __builtin_bswap32(v); }
+extern "C" uint64_t vm_read64(uint64_t a) { uint64_t v; memcpy(&v, LDS_P(a), 8); return __builtin_bswap64(v); }
+extern "C" void vm_write8 (uint64_t a, uint8_t  v) { *LDS_P(a) = v; }
+extern "C" void vm_write16(uint64_t a, uint16_t v) { v = __builtin_bswap16(v); memcpy(LDS_P(a), &v, 2); }
+extern "C" void vm_write32(uint64_t a, uint32_t v) { v = __builtin_bswap32(v); memcpy(LDS_P(a), &v, 4); }
+extern "C" void vm_write64(uint64_t a, uint64_t v) { v = __builtin_bswap64(v); memcpy(LDS_P(a), &v, 8); }
+
+extern "C" int ppu_stwcx32(uint64_t a, uint32_t expected, uint32_t val)
+{
+    uint32_t cur; memcpy(&cur, LDS_P(a), 4);
+    if (__builtin_bswap32(cur) != expected) return 0;
+    val = __builtin_bswap32(val); memcpy(LDS_P(a), &val, 4);
+    return 1;
+}
+extern "C" int ppu_stdcx64(uint64_t a, uint64_t expected, uint64_t val)
+{
+    uint64_t cur; memcpy(&cur, LDS_P(a), 8);
+    if (__builtin_bswap64(cur) != expected) return 0;
+    val = __builtin_bswap64(val); memcpy(LDS_P(a), &val, 8);
+    return 1;
+}
+
+LdsTrace g_trace;
+extern "C" uint64_t ppu_timebase_now(void) { return g_trace.timebase += 0x1F3; }
+
+static void (*lds_lookup(const LdsFn* t, uint32_t n, uint32_t addr))(ppu_context*)
+{
+    uint32_t lo = 0, hi = n;
+    while (lo < hi) {
+        uint32_t m = (lo + hi) / 2;
+        if (t[m].addr < addr) lo = m + 1; else hi = m;
+    }
+    return (lo < n && t[lo].addr == addr) ? t[lo].fn : nullptr;
+}
+
+/* bctrl / bctr / blrl: CTR holds the guest target. A closure function linked
+ * for real runs for real (exactly what B's inline fast path would call through
+ * ppu_icall_tab); anything else behaves like a stubbed callee of that address,
+ * so "fast path into a stub" and "fallback" give the same trace event. */
+extern "C" void ps3_indirect_call(ppu_context* ctx)
+{
+    const uint32_t t = (uint32_t)ctx->ctr;
+    g_active_ctx = ctx;                       /* as the runtime's dispatcher does */
+    if (void (*f)(ppu_context*) = lds_lookup(lds_real_fns, lds_real_count, t)) { f(ctx); return; }
+    lds_record_and_clobber(ctx, LDS_EV_CALL, t);
+}
+extern "C" void ps3_hle_call(unsigned int nid, ppu_context* ctx) { lds_record_and_clobber(ctx, LDS_EV_HLE, nid); }
+extern "C" void lv2_syscall(ppu_context* ctx) { lds_record_and_clobber(ctx, LDS_EV_SYSCALL, (uint32_t)ctx->gpr[11]); }
+
+/* ======================= planned variant-B symbols =========================== */
+extern "C" uint8_t  ppu_line_flags[1u << 25] = {};    /* per 128-byte line: bit0 loads, bit1 stores slow */
+extern "C" void   (**ppu_icall_tab)(ppu_context*) = nullptr;
+extern "C" uint32_t ppu_icall_lo = 0, ppu_icall_n = 0;     /* n = 0: always fall back      */
+extern "C" int ppu_icall_wanted = 0;                       /* set by the lifted chunks static init */
+
+/* ======================= options ============================================= */
+int lds_configure(const char* k, const char* v)
+{
+    if (!strcmp(k, "CLOBBER")) {
+        if (!strcmp(v, "abi")) g_lds.clobber = LDS_CLOBBER_ABI;
+        else if (!strcmp(v, "all")) g_lds.clobber = LDS_CLOBBER_ALL;
+        else return 0;
+        return 1;
+    }
+    if (!strcmp(k, "SLOWMEM")) {
+        g_lds.slowmem = !strcmp(v, "1") ? 3 : !strcmp(v, "ld") ? 1 : !strcmp(v, "st") ? 2 : atoi(v);
+        return 1;
+    }
+    if (!strcmp(k, "ICALL"))      { g_lds.icall = atoi(v); return 1; }
+    if (!strcmp(k, "TRACELIMIT")) { g_lds.trace_limit = strtoull(v, 0, 0); return 1; }
+    if (!strcmp(k, "BSS"))        { g_lds.bss = atoi(v); return 1; }
+    if (!strcmp(k, "DEMAND")) {
+        if (!strcmp(v, "pattern") || !strcmp(v, "1")) g_lds.demand = 1;
+        else if (!strcmp(v, "zero") || !strcmp(v, "0")) g_lds.demand = 0;
+        else return 0;
+        return 1;
+    }
+    if (!strcmp(k, "NANFREE"))    { g_lds.nanfree = atoi(v); return 1; }
+    if (!strcmp(k, "MEMLIMIT"))   { g_lds.mem_limit = strtoull(v, 0, 0) << 20; return 1; }
+    return 0;
+}
+
+void lds_apply_config(void)
+{
+    memset(ppu_line_flags, g_lds.slowmem & 3, sizeof ppu_line_flags);
+    if (g_lds.icall && lds_all_count) {
+        /* cover [lowest, highest] func_X of this build; holes get a thunk that takes the
+         * normal fallback (so B works whether or not its fast path tests for null) */
+        uint32_t lo = lds_all_fns[0].addr & ~3u, hi = lds_all_fns[lds_all_count - 1].addr + 4;
+        size_t n = (hi - lo) / 4;
