diff --git a/runtime/spu/spu_capture.c b/runtime/spu/spu_capture.c
new file mode 100644
index 00000000..04aafe6c
--- /dev/null
+++ b/runtime/spu/spu_capture.c
@@ -0,0 +1,508 @@
+/* spu_capture.c -- SPU channel hook, run capture, trace replay. See spu_capture.h.
+ *
+ * File layout (host little-endian; it never leaves the machine that wrote it):
+ *   "SPUCAP1\0"  u32 version(=1)  u32 sizeof(spu_trace_hdr)  spu_trace_hdr
+ *   u32[4] gpr[128] (u128 lanes as stored in spu_context)   u8 ls[256K]
+ *   events, each a 1-byte type followed by:
+ *     1 RDCH    u32 ch, u32 value, u32 pc
+ *     2 RCHCNT  u32 ch, u32 value, u32 pc
+ *     3 WRCH    u32 ch, u32 value (preferred word), u32 pc
+ *     4 XFER    u32 kind (SPU_XFER_*), lsa, ea, size, result, dup
+ *               then `size` payload bytes unless dup != 0xFFFFFFFF (= index of
+ *               an identical payload in the 32-entry duplicate cache, below)
+ *     6 END     u32 reason (0 returned, 1 halted), status, stop_code, pc,
+ *               u32[4] gpr[128], u8 ls[256K]
+ *     7 TRUNC   (size cap reached; no END follows)
+ * XFER records follow the channel operation that caused them (the MFC runs
+ * synchronously inside wrch MFC_Cmd / WrListStallAck).
+ *
+ * Duplicate cache: polling SPUs re-fetch the same line forever, so a payload
+ * identical to the last one seen for the same (kind, ea, size) is written as a
+ * slot index. Slot update rule (writer and reader apply it identically): a
+ * non-duplicate payload replaces the slot already holding that key, else takes
+ * slot dup_next++ % 32.
+ */
+#include "spu_capture.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(_WIN32)
+#  include <io.h>
+#endif
+
+enum { EV_RDCH = 1, EV_RCHCNT = 2, EV_WRCH = 3, EV_XFER = 4, EV_END = 6, EV_TRUNC = 7 };
+#define CAP_MAGIC "SPUCAP1"
+#define CAP_VERSION 1u
+#define CAP_DUP_N 32
+
+/* ===========================================================================
+ * Capture
+ * ===========================================================================*/
+#if defined(PS3_WASM)
+typedef struct cap_spec { int img; uint32_t job; unsigned skip, max, every; uint64_t cap_bytes; uint64_t min_payload;
+#else   /* every=<k> is browser-build only for now (NATIVE CANDIDATE: diagnostic, unguard with the Windows gates) */
+typedef struct cap_spec { int img; uint32_t job; unsigned skip, max; uint64_t cap_bytes; uint64_t min_payload;
+#endif
+                          volatile long runs, taken, seq; } cap_spec;
+#define CAP_SPEC_MAX 8
+static cap_spec s_specs[CAP_SPEC_MAX];
+static int      s_nspecs;
+static char     s_dir[400] = ".";
+static volatile long s_cfg_state;      /* 0 unread, 1 reading, 2 ready */
+static int      s_enabled;
+
+typedef struct cap_session {
+    FILE*    f;
+    char     path[512];
+    uint64_t bytes, payload;
+    cap_spec* spec;
+    struct { uint32_t kind, ea, size; uint8_t* data; } dup[CAP_DUP_N];
+    unsigned dup_next;
+} cap_session;
+
+static void cap_parse(void)
+{
+    const char* e = getenv("SPU_CAPTURE");
+    const char* d = getenv("SPU_CAPTURE_DIR");
+    if (d && *d) { strncpy(s_dir, d, sizeof s_dir - 1); s_dir[sizeof s_dir - 1] = 0; }
+    if (!e || !*e) return;
+    char buf[512]; strncpy(buf, e, sizeof buf - 1); buf[sizeof buf - 1] = 0;
+    for (char* spec = strtok(buf, ";"); spec && s_nspecs < CAP_SPEC_MAX; spec = strtok(NULL, ";")) {
+        cap_spec c; memset(&c, 0, sizeof c);
+        c.img = -1; c.max = 1; c.cap_bytes = 64ull << 20;
+        char* p = spec;
+        while (p && *p) {
+            char* n = strchr(p, ','); if (n) *n++ = 0;
+            if      (!strncmp(p, "img=", 4))   c.img  = atoi(p + 4);
+            else if (!strncmp(p, "skip=", 5))  c.skip = (unsigned)strtoul(p + 5, 0, 0);
+            else if (!strncmp(p, "max=", 4))   c.max  = (unsigned)strtoul(p + 4, 0, 0);
+            else if (!strncmp(p, "mb=", 3))    c.cap_bytes = (uint64_t)strtoull(p + 3, 0, 0) << 20;
+            else if (!strncmp(p, "minkb=", 6)) c.min_payload = (uint64_t)strtoull(p + 6, 0, 0) << 10;
+            else if (!strncmp(p, "job=", 4))   c.job = (uint32_t)strtoul(p + 4, 0, 16);
+#if defined(PS3_WASM)
+            else if (!strncmp(p, "every=", 6)) c.every = (unsigned)strtoul(p + 6, 0, 0);
+#endif
+            p = n;
+        }
+        if (c.img >= 0 || c.job) s_specs[s_nspecs++] = c;
+    }
+    s_enabled = s_nspecs > 0;
+    if (s_enabled) {
+        fprintf(stderr, "[spu-cap] capture armed: %d spec(s), dir=%s\n", s_nspecs, s_dir);
+        fflush(stderr);
+    }
+}
+
+static int cap_ready(void)
+{
+    if (s_cfg_state == 2) return s_enabled;
+    if (__atomic_exchange_n(&s_cfg_state, 1, __ATOMIC_ACQ_REL) == 0) {
+        cap_parse();
+        __atomic_store_n(&s_cfg_state, 2, __ATOMIC_RELEASE);
+    } else {
+        while (__atomic_load_n(&s_cfg_state, __ATOMIC_ACQUIRE) != 2) { }
+    }
+    return s_enabled;
+}
+
+static void cap_w32(cap_session* s, uint32_t v) { fwrite(&v, 4, 1, s->f); s->bytes += 4; }
+static void cap_wev(cap_session* s, uint8_t type, uint32_t a, uint32_t b, uint32_t c)
+{
+    uint8_t rec[13]; rec[0] = type;
+    memcpy(rec + 1, &a, 4); memcpy(rec + 5, &b, 4); memcpy(rec + 9, &c, 4);
+    fwrite(rec, 1, sizeof rec, s->f); s->bytes += sizeof rec;
+}
+static void cap_wregs(cap_session* s, const spu_context* ctx)
+{
+    for (int i = 0; i < 128; i++) { fwrite(ctx->gpr[i]._u32, 4, 4, s->f); }
+    s->bytes += 128 * 16;
+}
+
+static const spu_chan_hook s_cap_hook;
+
+static void cap_close(spu_context* ctx, cap_session* s, int keep)
+{
+    fclose(s->f);
+    if (!keep) {
+        remove(s->path);
+        __atomic_sub_fetch(&s->spec->taken, 1, __ATOMIC_ACQ_REL);
+    } else {
+        fprintf(stderr, "[spu-cap] wrote %s (%llu bytes, %llu payload)\n", s->path,
+                (unsigned long long)s->bytes, (unsigned long long)s->payload);
+        fflush(stderr);
+    }
+    for (int i = 0; i < CAP_DUP_N; i++) free(s->dup[i].data);
+    free(s);
+    ctx->chan_hook = NULL;
+    ctx->chan_user = NULL;
+}
+
+/* Size cap reached: mark the trace truncated and let the SPU run on untraced. */
+static int cap_check_cap(spu_context* ctx, cap_session* s)
+{
+    if (s->bytes < s->spec->cap_bytes) return 0;
+    uint8_t t = EV_TRUNC; fwrite(&t, 1, 1, s->f);
+    cap_close(ctx, s, 1);
+    return 1;
+}
+
+static u128 cap_rdch(spu_context* ctx, uint32_t ch)
+{
+    cap_session* s = (cap_session*)ctx->chan_user;
+    u128 v = spu_rdch_real(ctx, ch);
+    if (ctx->chan_hook == &s_cap_hook && !cap_check_cap(ctx, s))
+        cap_wev(s, EV_RDCH, ch, v._u32[0], (uint32_t)ctx->pc);
+    return v;
+}
+static uint32_t cap_rchcnt(spu_context* ctx, uint32_t ch)
+{
+    cap_session* s = (cap_session*)ctx->chan_user;
+    uint32_t v = spu_rchcnt_real(ctx, ch);
+    if (ctx->chan_hook == &s_cap_hook && !cap_check_cap(ctx, s))
+        cap_wev(s, EV_RCHCNT, ch, v, (uint32_t)ctx->pc);
+    return v;
+}
+static void cap_wrch(spu_context* ctx, uint32_t ch, u128 v)
+{
+    cap_session* s = (cap_session*)ctx->chan_user;
+    if (!cap_check_cap(ctx, s))
+        cap_wev(s, EV_WRCH, ch, v._u32[0], (uint32_t)ctx->pc);
+    spu_wrch_real(ctx, ch, v);
+}
+static void cap_xfer(spu_context* ctx, int kind, uint32_t lsa, uint32_t ea,
+                     uint32_t size, const uint8_t* data, uint32_t result)
+{
+    cap_session* s = (cap_session*)ctx->chan_user;
+    if (!s) return;
+    uint32_t dup = 0xFFFFFFFFu; int same = -1;
+    for (int i = 0; i < CAP_DUP_N; i++)
+        if (s->dup[i].data && s->dup[i].kind == (uint32_t)kind && s->dup[i].ea == ea &&
+            s->dup[i].size == size) { same = i; break; }
+    if (same >= 0 && memcmp(s->dup[same].data, data, size) == 0) dup = (uint32_t)same;
+    uint8_t t = EV_XFER; fwrite(&t, 1, 1, s->f); s->bytes += 1;
+    cap_w32(s, (uint32_t)kind); cap_w32(s, lsa); cap_w32(s, ea); cap_w32(s, size);
+    cap_w32(s, result); cap_w32(s, dup);
+    s->payload += size;
+    if (dup == 0xFFFFFFFFu) {
+        fwrite(data, 1, size, s->f); s->bytes += size;
+        int slot = same >= 0 ? same : (int)(s->dup_next++ % CAP_DUP_N);
+        uint8_t* p = (uint8_t*)realloc(s->dup[slot].data, size ? size : 1);
+        if (p) {
+            memcpy(p, data, size);
+            s->dup[slot].data = p; s->dup[slot].kind = (uint32_t)kind;
+            s->dup[slot].ea = ea; s->dup[slot].size = size;
+        }
+    }
+}
+
+static const spu_chan_hook s_cap_hook = { cap_rdch, cap_rchcnt, cap_wrch, cap_xfer };
+
+static void cap_open(spu_context* ctx, cap_spec* c);
+void spu_cap_run_begin(spu_context* ctx)
+{
+    if (!cap_ready() || ctx->chan_hook) return;
+    cap_spec* c = NULL;
+    for (int i = 0; i < s_nspecs; i++) if (!s_specs[i].job && s_specs[i].img == ctx->image_id) { c = &s_specs[i]; break; }
+    if (!c) return;
+    cap_open(ctx, c);
+}
+/* SPU_CAPTURE job=<hash>: a session from the first branch into a SPURS job binary (key = FNV-1a of the 64 LS
+ * bytes at its entry, as [game-stats] job batches / PS3_CPATH) to the next policy-module poll, written as a
+ * truncated capture: spu_replay re-runs exactly the job batch (every DMA / channel output checked) and stops at the
+ * PM's next channel operation. skip / max count job batches. */
+int spu_cap_jobs_armed(void)
+{
+    if (!cap_ready()) return 0;
+    for (int i = 0; i < s_nspecs; i++) if (s_specs[i].job) return 1;
+    return 0;
+}
+void spu_cap_job_begin(spu_context* ctx, uint32_t key)
+{
+    if (!cap_ready() || ctx->chan_hook) return;
+    for (int i = 0; i < s_nspecs; i++) if (s_specs[i].job == key) { cap_open(ctx, &s_specs[i]); return; }
+}
+void spu_cap_job_end(spu_context* ctx)
+{
+    if (ctx->chan_hook != &s_cap_hook) return;
+    cap_session* s = (cap_session*)ctx->chan_user;
+    if (!s->spec->job) return;
+    uint8_t t = EV_TRUNC; fwrite(&t, 1, 1, s->f); s->bytes += 1;
+    cap_close(ctx, s, 1);
+}
+static void cap_open(spu_context* ctx, cap_spec* c)
+{
+    long run = __atomic_fetch_add(&c->runs, 1, __ATOMIC_ACQ_REL);
+    if ((unsigned long)run < c->skip) return;
+#if defined(PS3_WASM)
+    if (c->every > 1 && ((unsigned long)run - c->skip) % c->every) return;   /* every=<k>: spread the sessions */
+#endif
+    if ((unsigned long)__atomic_fetch_add(&c->taken, 1, __ATOMIC_ACQ_REL) >= c->max) {
+        __atomic_sub_fetch(&c->taken, 1, __ATOMIC_ACQ_REL);
+        return;
+    }
+    cap_session* s = (cap_session*)calloc(1, sizeof *s);
+    if (!s) return;
+    s->spec = c;
+    long seq = __atomic_fetch_add(&c->seq, 1, __ATOMIC_ACQ_REL);
+    if (c->job) snprintf(s->path, sizeof s->path, "%s/spucap_job%08X_%03ld.bin", s_dir, c->job, seq);
+    else        snprintf(s->path, sizeof s->path, "%s/spucap_img%d_%03ld.bin", s_dir, ctx->image_id, seq);
+    s->f = fopen(s->path, "wb");
+    if (!s->f) { free(s); __atomic_sub_fetch(&c->taken, 1, __ATOMIC_ACQ_REL); return; }
+    setvbuf(s->f, NULL, _IOFBF, 1 << 20);
+
+    spu_trace_hdr h; memset(&h, 0, sizeof h);
+    h.image_id = ctx->image_id; h.entry_pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+    h.policy_mode = ctx->policy_mode; h.module_img_a00 = ctx->module_img_a00;
+    h.resident_ovl = ctx->resident_ovl; h.resident_task = ctx->resident_task;
+    h.spu_id = ctx->spu_id; h.spu_group_id = ctx->spu_group_id;
+    h.event_mask = ctx->event_mask; h.event_status = ctx->event_status;
+    h.srr0 = ctx->srr0; h.decrementer = ctx->decrementer;
+    h.int_enable = ctx->int_enable; h.ch_block = ctx->ch_block;
+    for (int i = 0; i < 4; i++) {
+        h.resident_code[i].lsa = ctx->resident_code[i].lsa;
+        h.resident_code[i].size = ctx->resident_code[i].size;
+        h.resident_code[i].source_ea = ctx->resident_code[i].source_ea;
+        h.resident_code[i].image_id = ctx->resident_code[i].image_id;
+    }
+    fwrite(CAP_MAGIC, 1, 8, s->f); s->bytes += 8;
+    cap_w32(s, CAP_VERSION); cap_w32(s, (uint32_t)sizeof h);
+    fwrite(&h, sizeof h, 1, s->f); s->bytes += sizeof h;
+    cap_wregs(s, ctx);
+    fwrite(ctx->ls, 1, SPU_LS_SIZE, s->f); s->bytes += SPU_LS_SIZE;
+    ctx->chan_user = s;
+    ctx->chan_hook = &s_cap_hook;
+}
+
+void spu_cap_run_end(spu_context* ctx, int halted)
+{
+    if (ctx->chan_hook != &s_cap_hook) return;
+    cap_session* s = (cap_session*)ctx->chan_user;
+    uint8_t t = EV_END; fwrite(&t, 1, 1, s->f); s->bytes += 1;
+    cap_w32(s, halted ? 1u : 0u); cap_w32(s, ctx->status); cap_w32(s, ctx->stop_code);
+    cap_w32(s, (uint32_t)ctx->pc);
+    cap_wregs(s, ctx);
+    fwrite(ctx->ls, 1, SPU_LS_SIZE, s->f); s->bytes += SPU_LS_SIZE;
+    cap_close(ctx, s, s->payload >= s->spec->min_payload);
+}
+
+/* ===========================================================================
+ * Trace loading
+ * ===========================================================================*/
+static uint32_t rd32(const uint8_t* p) { uint32_t v; memcpy(&v, p, 4); return v; }
+
+int spu_trace_load(spu_trace* t, const char* path)
+{
+    memset(t, 0, sizeof *t);
+    FILE* f = fopen(path, "rb");
+    if (!f) return -1;
+#if defined(_WIN32)
+    _fseeki64(f, 0, SEEK_END); long long n = _ftelli64(f); _fseeki64(f, 0, SEEK_SET);
+#else
+    fseeko(f, 0, SEEK_END); long long n = ftello(f); fseeko(f, 0, SEEK_SET);
+#endif
+    uint8_t* b = (uint8_t*)malloc((size_t)n + 16);
+    if (!b || fread(b, 1, (size_t)n, f) != (size_t)n) { fclose(f); free(b); return -2; }
+    fclose(f);
+    t->file_buf = b;
+    if (n < 16 || memcmp(b, CAP_MAGIC, 8) || rd32(b + 8) != CAP_VERSION) return -3;
+    uint32_t hs = rd32(b + 12);
+    size_t off = 16;
+    memset(&t->hdr, 0, sizeof t->hdr);
+    memcpy(&t->hdr, b + off, hs < sizeof t->hdr ? hs : sizeof t->hdr); off += hs;
+    for (int i = 0; i < 128; i++) { memcpy(t->gpr0[i]._u32, b + off, 16); off += 16; }
+    t->ls0 = b + off; off += SPU_LS_SIZE;
+    if (off > (size_t)n) return -4;
+    t->ev = b + off;
+    /* walk to END / TRUNC */
+    size_t p = off;
+    while (p < (size_t)n) {
+        uint8_t ty = b[p];
+        if (ty == EV_RDCH || ty == EV_RCHCNT || ty == EV_WRCH) { p += 13; continue; }
+        if (ty == EV_XFER) {
+            uint32_t size = rd32(b + p + 1 + 12), dup = rd32(b + p + 1 + 20);
+            p += 1 + 24 + (dup == 0xFFFFFFFFu ? size : 0); continue;
+        }
+        if (ty == EV_TRUNC) { t->truncated = 1; t->ev_len = p - off; return 0; }
+        if (ty == EV_END) {
+            t->ev_len = p - off;
+            const uint8_t* q = b + p + 1;
+            t->has_end = 1;
+            t->end_reason = rd32(q); t->end_status = rd32(q + 4);
+            t->end_stop = rd32(q + 8); t->end_pc = rd32(q + 12); q += 16;
+            for (int i = 0; i < 128; i++) { memcpy(t->gpr1[i]._u32, q, 16); q += 16; }
+            t->ls1 = (uint8_t*)q;
+            if ((size_t)(q - b) + SPU_LS_SIZE > (size_t)n) return -5;
+            return 0;
+        }
+        return -6;   /* corrupt */
+    }
+    t->truncated = 1;            /* the writer died mid-run */
+    t->ev_len = p - off;
+    return 0;
+}
+
+void spu_trace_free(spu_trace* t) { free(t->file_buf); memset(t, 0, sizeof *t); }
+
+void spu_trace_apply_start(const spu_trace* t, spu_context* ctx)
+{
+    const spu_trace_hdr* h = &t->hdr;
+    memcpy(ctx->ls, t->ls0, SPU_LS_SIZE);
+    memcpy(ctx->gpr, t->gpr0, sizeof ctx->gpr);
+    ctx->image_id = h->image_id; ctx->pc = h->entry_pc;
+    ctx->policy_mode = h->policy_mode; ctx->module_img_a00 = h->module_img_a00;
+    ctx->resident_ovl = h->resident_ovl; ctx->resident_task = h->resident_task;
+    ctx->spu_id = h->spu_id; ctx->spu_group_id = h->spu_group_id;
+    ctx->event_mask = h->event_mask; ctx->event_status = h->event_status;
+    ctx->srr0 = h->srr0; ctx->decrementer = h->decrementer;
+    ctx->int_enable = h->int_enable; ctx->ch_block = h->ch_block;
+    for (int i = 0; i < 4; i++) {
+        ctx->resident_code[i].lsa = h->resident_code[i].lsa;
+        ctx->resident_code[i].size = h->resident_code[i].size;
+        ctx->resident_code[i].source_ea = h->resident_code[i].source_ea;
+        ctx->resident_code[i].image_id = h->resident_code[i].image_id;
+    }
+    ctx->status = SPU_STATUS_RUNNING;
+}
+
+/* ===========================================================================
+ * Replay
+ * ===========================================================================*/
+extern void spu_halt(spu_context* ctx);
+extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+
+static const char* ev_name(int ty)
+{
+    switch (ty) { case EV_RDCH: return "rdch"; case EV_RCHCNT: return "rchcnt";
+                  case EV_WRCH: return "wrch"; case EV_XFER: return "xfer";
+                  case EV_END: return "end"; case EV_TRUNC: return "trunc"; }
+    return "?";
+}
+
+static void rp_fail(spu_replay* r, spu_context* ctx, int exhausted, const char* fmt, ...)
+{
+    if (!r->diverged && !r->exhausted) {
+        va_list ap; va_start(ap, fmt);
+        vsnprintf(r->msg, sizeof r->msg, fmt, ap);
+        va_end(ap);
+        if (exhausted) r->exhausted = 1; else r->diverged = 1;
+    }
+    ctx->status = SPU_STATUS_STOPPED_BY_HALT;
+    spu_halt(ctx);
+}
+
+static int rp_peek(const spu_replay* r)
+{
+    if (r->pos >= r->t->ev_len) return 0;
+    return r->t->ev[r->pos];
+}
+
+/* Apply every XFER record that follows the current position. */
+static void rp_apply_xfers(spu_replay* r, spu_context* ctx)
+{
+    while (rp_peek(r) == EV_XFER) {
+        const uint8_t* q = r->t->ev + r->pos + 1;
+        uint32_t kind = rd32(q), lsa = rd32(q + 4), ea = rd32(q + 8), size = rd32(q + 12),
+                 dup = rd32(q + 20);
+        const uint8_t* data;
+        r->pos += 1 + 24;
+        int same = -1;
+        for (int i = 0; i < CAP_DUP_N; i++)
+            if (r->dup[i].data && r->dup[i].kind == kind && r->dup[i].ea == ea && r->dup[i].size == size)
+            { same = i; break; }
+        if (dup != 0xFFFFFFFFu) {
+            if (dup >= CAP_DUP_N || !r->dup[dup].data) rp_fail(r, ctx, 0, "corrupt dup ref %u at ev %llu", dup, (unsigned long long)r->nev);
+            data = r->dup[dup].data;
+        } else {
+            data = r->t->ev + r->pos;
+            r->pos += size;
+            int slot = same >= 0 ? same : (int)(r->dup_next++ % CAP_DUP_N);
+            uint8_t* p = (uint8_t*)realloc(r->dup[slot].data, size ? size : 1);
+            if (p) { memcpy(p, data, size); r->dup[slot].data = p; r->dup[slot].kind = kind;
+                     r->dup[slot].ea = ea; r->dup[slot].size = size; }
+        }
+        r->nev++;
+        if (lsa + size > SPU_LS_SIZE) rp_fail(r, ctx, 0, "xfer lsa out of range 0x%X+%u", lsa, size);
+        if (kind == SPU_XFER_GET || kind == SPU_XFER_GETLLAR) {
+            SPU_VAR_NOTE_GET(ctx, lsa, data, size);
+            memcpy(ctx->ls + lsa, data, size);
+            if (kind == SPU_XFER_GET) { r->n_get++; r->get_bytes += size;
+                                        spu_overlay_note_get(ctx, ea, ctx->ls + lsa, size); }
+            else r->n_atom++;
+        } else {
+            if (memcmp(ctx->ls + lsa, data, size) != 0) {
+                uint32_t o = 0; while (o < size && ctx->ls[lsa + o] == data[o]) o++;
+                rp_fail(r, ctx, 0, "ev %llu: %s payload differs: lsa=0x%05X ea=0x%08X size=%u, first diff at +0x%X "
+                        "(got %02X want %02X)", (unsigned long long)r->nev,
+                        kind == SPU_XFER_PUT ? "PUT" : kind == SPU_XFER_PUTLLC ? "PUTLLC" : "PUTLLUC",
+                        lsa, ea, size, o, ctx->ls[lsa + o], data[o]);
+            }
+            if (kind == SPU_XFER_PUT) { r->n_put++; r->put_bytes += size; } else r->n_atom++;
+        }
+    }
+}
+
+static void rp_expect(spu_replay* r, spu_context* ctx, int type, uint32_t ch, uint32_t* val_inout)
+{
+    int ty = rp_peek(r);
+    if (ty != EV_RDCH && ty != EV_RCHCNT && ty != EV_WRCH)
+        rp_fail(r, ctx, 1, "trace %s after %llu events: SPU wants %s ch%u%s", ty ? ev_name(ty) : "ended",
+                (unsigned long long)r->nev, ev_name(type), ch,
+                r->t->truncated ? " (truncated capture -- expected end)" : "");
+    const uint8_t* q = r->t->ev + r->pos + 1;
+    uint32_t tch = rd32(q), tval = rd32(q + 4), tpc = rd32(q + 8);
+    if (ty != type || tch != ch)
+        rp_fail(r, ctx, 0, "ev %llu: SPU does %s ch%u (pc~0x%05X), trace has %s ch%u (pc~0x%05X)",
+                (unsigned long long)r->nev, ev_name(type), ch, (uint32_t)ctx->pc & SPU_LS_MASK,
+                ev_name(ty), tch, tpc);
+    if (type == EV_WRCH && tval != *val_inout)
+        rp_fail(r, ctx, 0, "ev %llu: wrch ch%u value 0x%08X, trace has 0x%08X (pc~0x%05X / 0x%05X)",
+                (unsigned long long)r->nev, ch, *val_inout, tval, (uint32_t)ctx->pc & SPU_LS_MASK, tpc);
+    *val_inout = tval;
+    r->pos += 13;
+    r->nev++;
+}
+
+static u128 rp_rdch(spu_context* ctx, uint32_t ch)
+{
+    spu_replay* r = (spu_replay*)ctx->chan_user;
+    uint32_t v = 0;
+    rp_expect(r, ctx, EV_RDCH, ch, &v);
+    r->n_rdch++;
+    rp_apply_xfers(r, ctx);
+    return spu_make_preferred_u32(v);
+}
+static uint32_t rp_rchcnt(spu_context* ctx, uint32_t ch)
+{
+    spu_replay* r = (spu_replay*)ctx->chan_user;
+    uint32_t v = 0;
+    rp_expect(r, ctx, EV_RCHCNT, ch, &v);
+    r->n_rchcnt++;
+    rp_apply_xfers(r, ctx);
+    return v;
+}
+static void rp_wrch(spu_context* ctx, uint32_t ch, u128 val)
+{
+    spu_replay* r = (spu_replay*)ctx->chan_user;
+    uint32_t v = val._u32[0];
+    rp_expect(r, ctx, EV_WRCH, ch, &v);
+    r->n_wrch++;
+    rp_apply_xfers(r, ctx);
+}
+static const spu_chan_hook s_rp_hook = { rp_rdch, rp_rchcnt, rp_wrch, NULL };
+
+void spu_replay_begin(spu_replay* r, const spu_trace* t, spu_context* ctx)
+{
+    memset(r, 0, sizeof *r);
+    r->t = t;
+    ctx->chan_user = r;
+    ctx->chan_hook = &s_rp_hook;
+    /* A run may start with payloads already queued (none today), apply them. */
+}
+
+void spu_replay_end(spu_replay* r, spu_context* ctx)
+{
+    ctx->chan_hook = NULL;
+    ctx->chan_user = NULL;
+    for (int i = 0; i < CAP_DUP_N; i++) { free(r->dup[i].data); r->dup[i].data = NULL; }
+}
diff --git a/runtime/spu/spu_capture.h b/runtime/spu/spu_capture.h
new file mode 100644
index 00000000..0247a180
--- /dev/null
+++ b/runtime/spu/spu_capture.h
@@ -0,0 +1,126 @@
+/*
+ * ps3recomp - SPU channel hook, run capture and trace replay.
+ *
+ * A captured SPU run is the complete external input of an SPU program: the
+ * local store and registers it started with, and every value the outside world
+ * handed it through its channels (rdch / rchcnt results, DMA GET payloads,
+ * atomic line loads) -- together with everything it handed back (wrch values,
+ * PUT payloads, atomic stores) and the state it ended in. An SPU program is
+ * deterministic given those inputs, so the run can be re-executed offline by
+ * any executor -- the lifted code through the real dispatcher, the runtime
+ * interpreter, an independent reference -- and every output checked against
+ * what the game actually produced. That is the whole-program differential
+ * test; re-running the lifted replay in a loop is the dispatch benchmark.
+ *
+ * Capture (env, off by default; costs one well-predicted pointer test per
+ * channel operation and one flag test per SPU run when off):
+ *   SPU_CAPTURE=<spec>[;<spec>...]   spec = img=<id>|job=<hash>[,skip=<K>][,every=<E>][,max=<N>][,mb=<MB>][,minkb=<KB>]
+ *       img    image id to capture (ctx->image_id at spu_run_with_halt entry)
+ *       skip   ignore the first K runs of that image (default 0)
+ *       every  after the skip, take only every E-th run (spreads max sessions over time; default 1)
+ *       max    number of sessions to write (default 1)
+ *       mb     per-session size cap; the session is closed "truncated" when hit (default 64)
+ *       minkb  discard a completed session that moved less DMA payload than this (idle PM polls)
+ *   SPU_CAPTURE_DIR=<dir>            output directory (default ".")
+ * Files: <dir>/spucap_img<id>_<n>.bin
+ *
+ * Trace format: see the SPU_CAP_* record layout in spu_capture.c.
+ */
+#ifndef SPU_CAPTURE_H
+#define SPU_CAPTURE_H
+
+#include "spu_context.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Per-context channel hook (ctx->chan_hook). NULL for every normal SPU run.
+ * rdch/rchcnt/wrch REPLACE the runtime's channel implementation when set (the
+ * capture hook calls the real one, spu_*_real, and records the result); xfer
+ * is told about every DMA/atomic data movement the real MFC performs. */
+enum { SPU_XFER_GET = 0, SPU_XFER_PUT = 1,
+       SPU_XFER_GETLLAR = 2, SPU_XFER_PUTLLC = 3, SPU_XFER_PUTLLUC = 4 };
+typedef struct spu_chan_hook {
+    u128     (*rdch)(spu_context* ctx, uint32_t ch);
+    uint32_t (*rchcnt)(spu_context* ctx, uint32_t ch);
+    void     (*wrch)(spu_context* ctx, uint32_t ch, u128 v);
+    /* kind = SPU_XFER_*; data = the LS bytes after a GET / before a PUT;
+     * result = atomic status for the reservation commands, else 0. */
+    void     (*xfer)(spu_context* ctx, int kind, uint32_t lsa, uint32_t ea,
+                     uint32_t size, const uint8_t* data, uint32_t result);
+} spu_chan_hook;
+
+/* Report a data movement to the hook (capture). One predictable test when off. */
+#define SPU_XFER_NOTE(ctx, kind, lsa, ea, size, data, res) do {                \
+        if (__builtin_expect((ctx)->chan_hook != 0, 0) && (ctx)->chan_hook->xfer) \
+            (ctx)->chan_hook->xfer((ctx), (kind), (lsa), (ea), (size), (data), (res)); \
+    } while (0)
+
+/* The runtime's own channel implementation (what the hook replaces). */
+u128     spu_rdch_real(spu_context* ctx, uint32_t ch);
+uint32_t spu_rchcnt_real(spu_context* ctx, uint32_t ch);
+void     spu_wrch_real(spu_context* ctx, uint32_t ch, u128 v);
+
+/* Capture driver (spu_run_with_halt). */
+void spu_cap_run_begin(spu_context* ctx);
+void spu_cap_run_end(spu_context* ctx, int halted);
+void spu_cap_job_begin(spu_context* ctx, uint32_t key);   /* SPU_CAPTURE job=<hash> */
+void spu_cap_job_end(spu_context* ctx);
+int  spu_cap_jobs_armed(void);
+
+/* ---- trace reading + replay engine (used by tools/spucheck/spu_replay) ---- */
+typedef struct spu_trace_hdr {
+    int32_t  image_id;
+    uint32_t entry_pc;
+    int32_t  policy_mode, module_img_a00, resident_ovl, resident_task;
+    uint32_t spu_id, spu_group_id;
+    uint32_t event_mask, event_status, srr0, decrementer;
+    int32_t  int_enable, ch_block;
+    struct { uint32_t lsa, size, source_ea; int32_t image_id; } resident_code[4];
+} spu_trace_hdr;
+
+typedef struct spu_trace {
+    spu_trace_hdr hdr;
+    u128     gpr0[128];
+    uint8_t* ls0;                   /* SPU_LS_SIZE bytes */
+    const uint8_t* ev;              /* event stream */
+    size_t   ev_len;
+    /* END record (valid if has_end) */
+    int      has_end;
+    uint32_t end_reason, end_status, end_stop, end_pc;
+    u128     gpr1[128];
+    uint8_t* ls1;
+    int      truncated;
+    void*    file_buf;
+} spu_trace;
+
+/* Load a capture file; 0 on success. */
+int  spu_trace_load(spu_trace* t, const char* path);
+void spu_trace_free(spu_trace* t);
+/* Initialise ctx (already spu_context_init'ed) from the trace header. */
+void spu_trace_apply_start(const spu_trace* t, spu_context* ctx);
+
+typedef struct spu_replay {
+    const spu_trace* t;
+    size_t   pos;                    /* byte offset into t->ev */
+    uint64_t nev;                    /* events consumed */
+    int      diverged;               /* first divergence recorded */
+    int      exhausted;              /* the SPU asked past the end of the trace */
+    char     msg[512];
+    uint64_t n_rdch, n_wrch, n_rchcnt, n_get, n_put, n_atom, get_bytes, put_bytes;
+    /* duplicate-payload cache (mirrors the writer) */
+    struct { uint32_t kind, ea, size; uint8_t* data; } dup[32];
+    unsigned dup_next;
+} spu_replay;
+
+/* Install a replay of `t` on ctx (ctx->chan_hook); the SPU's channel traffic is
+ * answered from the trace and verified. On divergence or exhaustion the replay
+ * halts the SPU (spu_halt). */
+void spu_replay_begin(spu_replay* r, const spu_trace* t, spu_context* ctx);
+void spu_replay_end(spu_replay* r, spu_context* ctx);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* SPU_CAPTURE_H */
