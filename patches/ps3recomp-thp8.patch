+/* save directories of a savedata folder: subfolders holding a PARAM.SFO (names with a '.' are no save) */
+static int sd_count_saves(const char* folder)
+{
+    int n = 0;
+    sd_dir d;
+    sd_dirent e;
+    char p[SD_PATH_MAX + 300];
+    if (!sd_dir_open(&d, folder, NULL)) return 0;
+    while (sd_dir_next(&d, &e)) {
+        if (!e.is_dir || e.name[0] == '.' || strchr(e.name, '.')) continue;
+        snprintf(p, sizeof p, "%s/%s", folder, e.name);
+        if (dir_has_save(p)) n++;
+    }
+    sd_dir_close(&d);
+    return n;
+}
