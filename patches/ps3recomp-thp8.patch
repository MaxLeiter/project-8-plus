--- /dev/null
+++ b/tools/ppu_codegen_opt.py
@@ -0,0 +1,1271 @@
+"""ppu_codegen_opt.py -- optional code-generation passes for ppu_lifter.py output.
+
+Every pass here is OFF unless the lifter is given the matching --opt-* flag, and
+each one rewrites the TEXT of an already-lifted function body at emission time
+(after all of the lifter's own lift-time passes, which match on the plain
+`ctx->gpr[N]` / `vm_read32(...)` spelling). The ABI between lifted functions --
+the whole guest register file lives in `ppu_context* ctx` at every call and
+return -- is unchanged, so optimised and unoptimised functions mix freely.
+
+Passes
+  fast_mem   guest loads/stores inline (vm_base + addr, byte swap) instead of the
+             out-of-line runtime helpers vm_read32/vm_write32. A per-128-byte-line
+             flag table (ppu_line_flags[], bit0 loads / bit1 stores) routes the
+             accesses with side effects (raw SPU problem state, the GCM ref-poll
+             word, the null page, SPU-reserved lines, armed write/read watches)
+             to the old helpers, so the semantics are the helpers' semantics.
+  trust_sp   loads whose base register is r1 (the stack) skip the flag check.
+  fast_icall bctrl/bctr dispatch through a direct-mapped table (ppu_icall_tab,
+             one slot per 4-byte guest code address) before falling back to
+             ps3_indirect_call.
+  musttail   tail calls and fall-through chains become [[clang::musttail]] direct
+             calls instead of the g_trampoline_fn TLS handshake; the
+             DRAIN_TRAMPOLINE after every call is then dead and dropped.
+  locals     GPRs, FPRs, VRs, CR, CTR and XER live in C locals inside a function.
+             Dataflow decides where they move between locals and ctx:
+               * forward "may be dirty" analysis -> a register is stored back to
+                 ctx before a call / at an exit only if this function may have
+                 changed it since the last sync point;
+               * backward liveness (spills count as reads) -> a register is
+                 loaded at entry / after a call only if something reads it.
+             Dead CR/XER updates then disappear in the C compiler (they are SSA
+             values that never reach a store).
+
+A body the parser does not fully understand is emitted UNCHANGED (counted as a
+fallback) -- correctness never depends on recognising a shape.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+
+
+@dataclass
+class CodegenOptions:
+    fast_mem: bool = False
+    trust_sp: bool = False
+    fast_icall: bool = False
+    musttail: bool = False
+    locals: bool = False
+    fp: bool = False
+    cr: bool = False
+    inline: bool = False
+    inline_max: int = 24
+    # locals_vr=False (--opt-locals-no-vr): VRs stay in ctx->vr. The lifted vector
+    # float ops are plain C (d[i] = a[i] + b[i]); with both operands NaN, which payload
+    # x86 propagates depends on the operand order the C compiler picks, and that
+    # changes once the values are SSA locals instead of ctx memory. Keeping VRs in
+    # ctx makes the vector code compile exactly as in the plain lift.
+    locals_vr: bool = True
+    # wasm=True (ppu_lifter.py --wasm): the WebAssembly forms of the 64-bit byte swap (one i8x16.shuffle) and of
+    # ppc_mulhd/mulhdu (no __int128 libcall), behind __wasm_simd128__ / __wasm__. Off = the native lift text
+    # byte-for-byte as before (the browser build was the only user; native lifts must stay pinnable).
+    wasm: bool = False
+
+    def any(self) -> bool:
+        return (self.fast_mem or self.fast_icall or self.musttail or self.locals
+                or self.fp or self.cr or self.inline)
+
+    def tag(self) -> str:
+        on = [n for n in ("fast_mem", "trust_sp", "fast_icall", "musttail", "locals", "fp",
+                          "cr", "inline", "wasm")
+              if getattr(self, n)]
+        if self.locals and not self.locals_vr:
+            on.append("no_vr")
+        return ",".join(on) if on else "none"
+
+
+@dataclass
+class CodegenStats:
+    functions: int = 0
+    transformed: int = 0
+    fallback: int = 0
+    inlined_sites: int = 0
+    fallback_reasons: dict = field(default_factory=dict)
+
+    def note_fallback(self, reason: str) -> None:
+        self.fallback += 1
+        self.fallback_reasons[reason] = self.fallback_reasons.get(reason, 0) + 1
+
+    def merge(self, other: "CodegenStats") -> None:
+        self.functions += other.functions
+        self.transformed += other.transformed
+        self.fallback += other.fallback
+        self.inlined_sites += other.inlined_sites
+        for k, v in other.fallback_reasons.items():
+            self.fallback_reasons[k] = self.fallback_reasons.get(k, 0) + v
+
+
+# ---------------------------------------------------------------------------
+# Preamble text (source chunks) for the enabled passes
+# ---------------------------------------------------------------------------
+
+_PRE_COMMON = """\
+/* ---- ppu_lifter --opt-* support (tools/ppu_codegen_opt.py) ---- */
+#if defined(__clang__) || defined(__GNUC__)
+#  define PPU_LIKELY(x)   __builtin_expect(!!(x), 1)
+#  define PPU_UNLIKELY(x) __builtin_expect(!!(x), 0)
+#else
+#  define PPU_LIKELY(x)   (x)
+#  define PPU_UNLIKELY(x) (x)
+#endif
+"""
+
+_PRE_FASTMEM = """\
+/* --opt-fast-mem: inline guest memory access. ppu_line_flags[addr >> 7], one
+ * byte per 128-byte guest line: bit0 = loads of this line go through vm_read*,
+ * bit1 = stores go through vm_write*. Set for the lines whose helper does more
+ * than the plain access: SPU-reserved lines (stores must serialise with the
+ * SPU and raise its lost-reservation event), raw SPU problem state, the GCM
+ * label/control page, the null page, everything while an access diagnostic,
+ * PS3_NULL_SWEEP or PPU_MEM_SLOW=1 is active. Runtime: spu_coherency.c +
+ * ppu_loader.cpp (fastmem).
+ *
+ * Every inline access is VOLATILE (PPU_MEMV): exactly one host access per guest
+ * load/store, in program order, never hoisted out of a loop or merged with
+ * another. Guest memory is shared with other host threads (the GCM walker, SPU
+ * threads, other PPU threads); once the registers live in C locals a spin loop
+ * on such a word has no call and no store left in it, and a plain load would be
+ * loop-invariant to the compiler -- hoisted, the guest spins on a stale value.
+ * The plain lift's opaque vm_read* calls never allowed that; volatile keeps the
+ * same guarantee for the inline form. -DPPU_MEMV= drops it (measurement only). */
+#ifndef PPU_MEMV
+#  define PPU_MEMV volatile
+#endif
+#if defined(__clang__) || defined(__GNUC__)
+typedef uint16_t __attribute__((aligned(1), may_alias)) ppu_u16u;
+typedef uint32_t __attribute__((aligned(1), may_alias)) ppu_u32u;
+typedef uint64_t __attribute__((aligned(1), may_alias)) ppu_u64u;
+#else
+typedef uint16_t ppu_u16u;
+typedef uint32_t ppu_u32u;
+typedef uint64_t ppu_u64u;
+#endif
+extern "C" uint8_t ppu_line_flags[];
+#define PPU_GLD8(m, a)  (*(PPU_MEMV const uint8_t*)((m) + (a)))
+#define PPU_GLD16(m, a) __builtin_bswap16(*(PPU_MEMV const ppu_u16u*)((m) + (a)))
+#define PPU_GLD32(m, a) __builtin_bswap32(*(PPU_MEMV const ppu_u32u*)((m) + (a)))
+#define PPU_GLD64(m, a) __builtin_bswap64(*(PPU_MEMV const ppu_u64u*)((m) + (a)))
+static inline uint8_t ppu_ld8(const uint8_t* m, uint64_t ea) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 1u)) return vm_read8(a);
+    return PPU_GLD8(m, a);
+}
+static inline uint16_t ppu_ld16(const uint8_t* m, uint64_t ea) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 1u)) return vm_read16(a);
+    return PPU_GLD16(m, a);
+}
+static inline uint32_t ppu_ld32(const uint8_t* m, uint64_t ea) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 1u)) return vm_read32(a);
+    return PPU_GLD32(m, a);
+}
+static inline uint64_t ppu_ld64(const uint8_t* m, uint64_t ea) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 1u)) return vm_read64(a);
+    return PPU_GLD64(m, a);
+}
+/* _nc: the base register is the stack pointer -- never raw SPU MMIO or the
+ * GCM page, so no flag check (--opt-trust-sp). Still volatile: a title can
+ * hand a stack word to another thread and spin on it. */
+static inline uint8_t  ppu_ld8_nc (const uint8_t* m, uint64_t ea) { return PPU_GLD8(m, (uint32_t)ea); }
+static inline uint16_t ppu_ld16_nc(const uint8_t* m, uint64_t ea) { return PPU_GLD16(m, (uint32_t)ea); }
+static inline uint32_t ppu_ld32_nc(const uint8_t* m, uint64_t ea) { return PPU_GLD32(m, (uint32_t)ea); }
+static inline uint64_t ppu_ld64_nc(const uint8_t* m, uint64_t ea) { return PPU_GLD64(m, (uint32_t)ea); }
+static inline void ppu_st8(uint8_t* m, uint64_t ea, uint8_t v) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 2u)) { vm_write8(a, v); return; }
+    *(PPU_MEMV uint8_t*)(m + a) = v;
+}
+static inline void ppu_st16(uint8_t* m, uint64_t ea, uint16_t v) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 2u)) { vm_write16(a, v); return; }
+    *(PPU_MEMV ppu_u16u*)(m + a) = __builtin_bswap16(v);
+}
+static inline void ppu_st32(uint8_t* m, uint64_t ea, uint32_t v) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 2u)) { vm_write32(a, v); return; }
+    *(PPU_MEMV ppu_u32u*)(m + a) = __builtin_bswap32(v);
+}
+static inline void ppu_st64(uint8_t* m, uint64_t ea, uint64_t v) {
+    uint32_t a = (uint32_t)ea;
+    if (PPU_UNLIKELY(ppu_line_flags[a >> 7] & 2u)) { vm_write64(a, v); return; }
+    *(PPU_MEMV ppu_u64u*)(m + a) = __builtin_bswap64(v);
+}
+"""
+
+_PRE_ICALL = """\
+/* --opt-fast-icall: direct-mapped guest code address -> lifted function table,
+ * built and kept current by the runtime (ppu_loader.cpp: ppu_recomp_register /
+ * ppu_register_function). A miss, a misaligned target or a disabled table
+ * (ppu_icall_n == 0: a dispatch diagnostic is armed) takes ps3_indirect_call.
+ * Like ps3_indirect_call it leaves g_active_ctx naming this context. */
+extern "C" void (**ppu_icall_tab)(ppu_context*);
+extern "C" uint32_t ppu_icall_lo, ppu_icall_n;
+extern "C" PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+/* The runtime builds the table only for a lift that uses it (static init,
+ * before ppu_recomp_register): a plain lift does not pay its ~25 MB. */
+extern "C" int ppu_icall_wanted;
+namespace { struct ppu_icall_want_t { ppu_icall_want_t() { ppu_icall_wanted = 1; } } ppu_icall_want_; }
+static inline void ppu_icall(ppu_context* ctx) {
+    uint32_t off = (uint32_t)ctx->ctr - ppu_icall_lo;
+    uint32_t idx = (off >> 2) | (off << 30);      /* misaligned -> out of range */
+    if (PPU_LIKELY(idx < ppu_icall_n)) {
+        void (*f)(ppu_context*) = ppu_icall_tab[idx];
+        if (PPU_LIKELY(f != 0)) {
+            if (PPU_UNLIKELY(g_active_ctx != ctx)) g_active_ctx = ctx;
+            f(ctx);
+            return;
+        }
+    }
+    ps3_indirect_call(ctx);
+}
+"""
+
+_PRE_MUSTTAIL = """\
+/* --opt-musttail: guest tail calls are host tail calls. */
+#if defined(__clang__)
+#  define PPU_MUSTTAIL [[clang::musttail]]
+#else
+#  define PPU_MUSTTAIL
+#endif
+"""
+
+
+# --opt-fp: the PPC NaN rules in the FP helpers, with the common case first.
+# Any NaN operand of add/sub/mul/div/fma makes the result NaN, so checking the
+# RESULT alone separates the rare case; only then are the operands examined, in
+# the same priority order as before. Results are bit-identical.
+_FP_BIN_OLD = """static inline double ppu_fp_bin(double a, double b, double r)
+{
+    if (a != a) return ppu_fp_quiet(a);"""
+_FP_BIN_NEW = """static inline double ppu_fp_bin(double a, double b, double r)
+{
+    if (__builtin_expect(r == r, 1)) return r;   /* --opt-fp: no NaN in, none out */
+    if (a != a) return ppu_fp_quiet(a);"""
+_FP_FMA_OLD = """static inline double ppu_fmadd_core(double a, double c, double b, int neg_b, int neg_res)
+{
+    if (a != a) return ppu_fp_quiet(a);
+    if (b != b) return ppu_fp_quiet(b);
+    if (c != c) return ppu_fp_quiet(c);
+    double r = fma(a, c, neg_b ? -b : b);
+    if (r != r) return ppu_fp_default_qnan();
+    return neg_res ? -r : r;
+}"""
+_FP_FMA_NEW = """static inline double ppu_fmadd_core(double a, double c, double b, int neg_b, int neg_res)
+{
+    double r = fma(a, c, neg_b ? -b : b);
+    if (__builtin_expect(r == r, 1)) return neg_res ? -r : r;   /* --opt-fp */
+    if (a != a) return ppu_fp_quiet(a);
+    if (b != b) return ppu_fp_quiet(b);
+    if (c != c) return ppu_fp_quiet(c);
+    return ppu_fp_default_qnan();
+}"""
+
+# Single-precision fused multiply-add (thp8-ppucheck lifter: rounds once to
+# single). Same reordering: any NaN operand makes the fma result NaN, so the
+# operand checks (same a, b, c priority) only run when the result is NaN.
+# Optional -- older lifters do not emit this helper.
+_FP_FMAS_OLD = """static inline double ppu_fmadds_core(double a, double c, double b, int neg_b, int neg_res)
+{
+    if (a != a) return ppu_fp_quiet(a);
+    if (b != b) return ppu_fp_quiet(b);
+    if (c != c) return ppu_fp_quiet(c);
+    double nb = neg_b ? -b : b;
+    double r = fma(a, c, nb);
+    if (r != r) return ppu_fp_default_qnan();"""
+_FP_FMAS_NEW = """static inline double ppu_fmadds_core(double a, double c, double b, int neg_b, int neg_res)
+{
+    double nb = neg_b ? -b : b;
+    double r = fma(a, c, nb);
+    if (__builtin_expect(r != r, 0)) {   /* --opt-fp: operand NaN checks only for a NaN result */
+        if (a != a) return ppu_fp_quiet(a);
+        if (b != b) return ppu_fp_quiet(b);
+        if (c != c) return ppu_fp_quiet(c);
+        return ppu_fp_default_qnan();
+    }"""
+
+
+
+# WebAssembly forms (CodegenOptions.wasm, ppu_lifter.py --wasm): replacements of the native template text
+_WASM_GLD64_OLD = """#define PPU_GLD64(m, a) __builtin_bswap64(*(PPU_MEMV const ppu_u64u*)((m) + (a)))
+"""
+_WASM_GLD64_NEW = """/* ppu-wasm-patch v1 */
+#if defined(__wasm_simd128__) && !defined(PPU_WASM_SCALAR)
+/* WebAssembly has no byte-swap instruction (__builtin_bswap64 = 22 scalar ops): the guest access stays one
+ * volatile scalar load/store, its value is swapped with one i8x16.shuffle. */
+#include <wasm_simd128.h>
+static inline uint64_t ppu_bswap64(uint64_t v) {
+    return (uint64_t)wasm_i64x2_extract_lane(wasm_i8x16_shuffle(wasm_i64x2_splat((int64_t)v), wasm_i64x2_splat(0),
+                                             7, 6, 5, 4, 3, 2, 1, 0, 15, 14, 13, 12, 11, 10, 9, 8), 0);
+}
+#else
+#define ppu_bswap64 __builtin_bswap64
+#endif
+#define PPU_GLD64(m, a) ppu_bswap64(*(PPU_MEMV const ppu_u64u*)((m) + (a)))
+"""
+_WASM_ST64_OLD = """    *(PPU_MEMV ppu_u64u*)(m + a) = __builtin_bswap64(v);
+"""
+_WASM_ST64_NEW = """    *(PPU_MEMV ppu_u64u*)(m + a) = ppu_bswap64(v);
+"""
+_WASM_MUL_ANCHOR = """#else
+static inline int64_t ppc_mulhd(int64_t a, int64_t b) {
+    return (int64_t)((__int128)(int64_t)a * (__int128)(int64_t)b >> 64);
+"""
+_WASM_MUL_BLOCK = """#elif defined(__wasm__) && !defined(PPU_WASM_SCALAR)
+/* WebAssembly: a 128-bit multiply is a __multi3 libcall; four 32x32->64 products instead. The signed high
+ * half is the unsigned one minus (a < 0 ? b : 0) and (b < 0 ? a : 0), mod 2^64. */
+static inline uint64_t ppc_mulhdu(uint64_t a, uint64_t b) {
+    const uint64_t al = (uint32_t)a, ah = a >> 32, bl = (uint32_t)b, bh = b >> 32;
+    const uint64_t ll = al * bl, lh = al * bh, hl = ah * bl, hh = ah * bh;
+    const uint64_t mid = (ll >> 32) + (uint32_t)lh + (uint32_t)hl;
+    return hh + (lh >> 32) + (hl >> 32) + (mid >> 32);
+}
+static inline int64_t ppc_mulhd(int64_t a, int64_t b) {
+    return (int64_t)(ppc_mulhdu((uint64_t)a, (uint64_t)b) - (a < 0 ? (uint64_t)b : 0) - (b < 0 ? (uint64_t)a : 0));
+}
+"""
+
+
+def _wasm_text(t: str, pairs) -> str:
+    crlf = "\r\n" in t
+    if crlf:
+        t = t.replace("\r\n", "\n")
+    for old, new in pairs:
+        if t.count(old) != 1:
+            raise ValueError("--wasm: template text not found exactly once: " + old.splitlines()[0][:60])
+        t = t.replace(old, new)
+    return t.replace("\n", "\r\n") if crlf else t
+
+
+def patch_source_preamble(text: str, opts: CodegenOptions) -> str:
+    """Rewrite helper definitions inside SOURCE_PREAMBLE for the enabled passes.
+    Works on either EOL convention."""
+    if opts.wasm:
+        text = _wasm_text(text, ((_WASM_MUL_ANCHOR, _WASM_MUL_BLOCK + _WASM_MUL_ANCHOR),))
+    if not opts.fp:
+        return text
+    crlf = "\r\n" in text
+    t = text.replace("\r\n", "\n") if crlf else text
+    for old, new in ((_FP_BIN_OLD, _FP_BIN_NEW), (_FP_FMA_OLD, _FP_FMA_NEW)):
+        if old in t:
+            t = t.replace(old, new)
+        elif new not in t:
+            raise ValueError("--opt-fp: FP helper text not found in the preamble")
+    if _FP_FMAS_OLD in t:
+        t = t.replace(_FP_FMAS_OLD, _FP_FMAS_NEW)
+    return t.replace("\n", "\r\n") if crlf else t
+
+
+def source_preamble(opts: CodegenOptions) -> str:
+    """Extra text appended to every chunk's preamble (after SOURCE_PREAMBLE,
+    which already declares vm_base, ps3_indirect_call and the vm_* helpers)."""
+    if not opts.any():
+        return ""
+    s = _PRE_COMMON
+    if opts.fast_mem:
+        s += _wasm_text(_PRE_FASTMEM, ((_WASM_GLD64_OLD, _WASM_GLD64_NEW), (_WASM_ST64_OLD, _WASM_ST64_NEW))) \
+            if opts.wasm else _PRE_FASTMEM
+    if opts.fast_icall:
+        s += _PRE_ICALL
+    if opts.musttail:
+        s += _PRE_MUSTTAIL
+    return s
+
+
+# ---------------------------------------------------------------------------
+# Simple text passes
+# ---------------------------------------------------------------------------
+
+_VM_ACC_RE = re.compile(r'\bvm_(read|write)(8|16|32|64)\(')
+_SP_LOAD_RE = re.compile(r'\bvm_read(8|16|32|64)\(ctx->gpr\[1\] \+ ')
+_TRAMP_RE = re.compile(r'g_trampoline_fn = \(void\(\*\)\(void\*\)\)(\w+); return;')
+_DRAIN_RE = re.compile(r' ?DRAIN_TRAMPOLINE\(ctx\);')
+_ICALL_RE = re.compile(r'\bps3_indirect_call\(ctx\)')
+
+
+def _fast_mem_text(s: str, trust_sp: bool) -> str:
+    if "vm_" not in s:
+        return s
+    if trust_sp:
+        s = _SP_LOAD_RE.sub(lambda m: f"ppu_ld{m.group(1)}_nc(_vmb, ctx->gpr[1] + ", s)
+    s = _VM_ACC_RE.sub(lambda m: ("ppu_ld" if m.group(1) == "read" else "ppu_st")
+                       + m.group(2) + "(_vmb, ", s)
+    return s.replace("vm_base + ", "_vmb + ")
+
+
+# --opt-cr: compare results as a branchless OR of the three (four, for fcmpu)
+# predicates instead of a ?: chain. Exactly one predicate is true, so the value
+# is the same; but LLVM can now see through `(cr >> s) & 2` to `a == b` and
+# keep compare+branch fused, and a CR field nobody reads folds away entirely.
+_CR_REWRITES = (
+    ("uint32_t cr_val = (a != a || b != b) ? 1 : (a < b) ? 8 : (a > b) ? 4 : 2;",
+     "uint32_t cr_val = ((uint32_t)(a < b) << 3) | ((uint32_t)(a > b) << 2) | "
+     "((uint32_t)(a == b) << 1) | (uint32_t)(a != a || b != b);"),
+    ("uint32_t cr_val = (a < b) ? 8 : (a > b) ? 4 : 2;",
+     "uint32_t cr_val = ((uint32_t)(a < b) << 3) | ((uint32_t)(a > b) << 2) | "
+     "((uint32_t)(a == b) << 1);"),
+    ("uint32_t _c = (_r < 0) ? 8u : (_r > 0) ? 4u : 2u;",
+     "uint32_t _c = ((uint32_t)(_r < 0) << 3) | ((uint32_t)(_r > 0) << 2) | "
+     "((uint32_t)(_r == 0) << 1);"),
+)
+
+
+def _simple_passes(lines: list[str], opts: CodegenOptions) -> list[str]:
+    out = []
+    for s in lines:
+        if opts.cr and "? 8" in s:
+            for old, new in _CR_REWRITES:
+                if old in s:
+                    s = s.replace(old, new)
+        if opts.fast_mem:
+            s = _fast_mem_text(s, opts.trust_sp)
+        if opts.fast_icall:
+            s = _ICALL_RE.sub("ppu_icall(ctx)", s)
+        if opts.musttail:
+            s = _TRAMP_RE.sub(r"PPU_MUSTTAIL return \1(ctx);", s)
+            s = _DRAIN_RE.sub("", s)
+        out.append(s)
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Register model
+# ---------------------------------------------------------------------------
+# bit index: r0..r31 -> 0..31, f0..f31 -> 32..63, v0..v31 -> 64..95,
+# cr -> 96, ctr -> 97, xer -> 98
+
+_N_REGS = 99
+_CR, _CTR, _XER = 96, 97, 98
+
+_SUBST = [
+    (re.compile(r'ctx->gpr\[(\d+)\]'), r'_r\1'),
+    (re.compile(r'ctx->fpr\[(\d+)\]'), r'_f\1'),
+    (re.compile(r'ctx->vr\[(\d+)\]'), r'_v\1'),
+    (re.compile(r'ctx->cr\b'), '_cr'),
+    (re.compile(r'ctx->ctr\b'), '_ctr'),
+    (re.compile(r'ctx->xer\b'), '_xer'),
+]
+_BAD_INDEX_RE = re.compile(r'ctx->(?:gpr|fpr|vr)\[(?!\d+\])')
+_TOK_RE = re.compile(r'\b_(?:r(\d+)|f(\d+)|v(\d+)|(cr|ctr|xer))\b')
+# ctx uses that may remain after substitution: uncached fields and the sync calls
+_CTX_OK_RE = re.compile(r'\bctx->(?:lr|reserve_addr|reserve_value|reserve_valid|fpscr|vscr|cia|thread_id)\b')
+_SYNC_CALL_RE = re.compile(
+    r'\b(?:\w*func_[0-9A-F]{8}|ps3_indirect_call|ppu_icall|lv2_syscall|ps3_hle_call)'
+    r'\((?:0x[0-9A-Fa-f]+u, )?ctx\);(?: DRAIN_TRAMPOLINE\(ctx\);)?')
+_MUSTTAIL_EXIT_RE = re.compile(r'PPU_MUSTTAIL return (\w+)\(ctx\);')
+
+
+def _bit(m: re.Match) -> int:
+    if m.group(1) is not None:
+        return int(m.group(1))
+    if m.group(2) is not None:
+        return 32 + int(m.group(2))
+    if m.group(3) is not None:
+        return 64 + int(m.group(3))
+    return {"cr": _CR, "ctr": _CTR, "xer": _XER}[m.group(4)]
+
+
+def _reg_name(i: int) -> str:
+    if i < 32:
+        return f"_r{i}"
+    if i < 64:
+        return f"_f{i - 32}"
+    if i < 96:
+        return f"_v{i - 64}"
+    return {_CR: "_cr", _CTR: "_ctr", _XER: "_xer"}[i]
+
+
+def _ctx_field(i: int) -> str:
+    if i < 32:
+        return f"ctx->gpr[{i}]"
+    if i < 64:
+        return f"ctx->fpr[{i - 32}]"
+    if i < 96:
+        return f"ctx->vr[{i - 64}]"
+    return {_CR: "ctx->cr", _CTR: "ctx->ctr", _XER: "ctx->xer"}[i]
+
+
+def _reg_type(i: int) -> str:
+    if i < 32:
+        return "uint64_t"
+    if i < 64:
+        return "double"
+    if i < 96:
+        return "ppu_vr"
+    return {_CR: "uint32_t", _CTR: "uint64_t", _XER: "uint32_t"}[i]
+
+
+def _bits_iter(x: int):
+    while x:
+        low = x & -x
+        yield low.bit_length() - 1
+        x ^= low
+
+
+def _tokens(s: str) -> int:
+    b = 0
+    for m in _TOK_RE.finditer(s):
+        b |= 1 << _bit(m)
+    return b
+
+
+_ASSIGN_AFTER_RE = re.compile(r'\s*(?:=(?!=)|\+=|-=|\|=|&=|\^=|<<=|>>=|\*=|/=|%=|\+\+|--|\.|\[)')
+
+
+def _may_write(s: str) -> int:
+    """Registers this text may write: assignment / compound assignment /
+    increment targets, address-taken (&_v3, (uint8_t*)&_v3 ...), member or
+    element access. Over-approximation is safe (an extra store-back)."""
+    b = 0
+    for m in _TOK_RE.finditer(s):
+        st, en = m.start(), m.end()
+        if (st > 0 and s[st - 1] == "&") or (st > 1 and s[st - 2:st] in ("++", "--")):
+            b |= 1 << _bit(m)
+            continue
+        if _ASSIGN_AFTER_RE.match(s, en):
+            b |= 1 << _bit(m)
+    return b
+
+
+def _split_top(s: str, sep: str = ";") -> list[str]:
+    """Split at `sep` outside parentheses (braces are flattened)."""
+    out, depth, cur = [], 0, []
+    for ch in s:
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+        if ch == sep and depth == 0:
+            out.append("".join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+    out.append("".join(cur))
+    return out
+
+
+_CONTROL_RE = re.compile(r'\b(?:if|for|while|switch|else|goto|return|do|case|default)\b')
+_ASSIGN_STMT_RE = re.compile(r'^(_(?:r\d+|f\d+|v\d+|cr|ctr|xer))\s*=(?!=)(.*)$', re.S)
+_MEMCPY_DEF_RE = re.compile(r'^memcpy\(&(_[fv]\d+), (.*), (\d+)\)$', re.S)
+_VST_DEF_RE = re.compile(r'^ppu_vst[fu]4\(&(_v\d+),\s*(.*)\)$', re.S)
+# --opt-vmx-sse helpers (ppu_vx_*): the first argument is a whole-register
+# destination written after every source is read, so it is killed and only the other arguments are read.
+_VX_DEF_RE = re.compile(r'^ppu_vx_\w+\(&(_v\d+),\s*(.*)\)$', re.S)
+
+
+def _pieces(s: str):
+    """Split a statement line into simple statements, each tagged with whether
+    it executes conditionally (inside an if/for/while/switch body or carrying
+    the control keyword itself). Braces delimit blocks; semicolons inside
+    parentheses (for headers) do not split."""
+    out = []
+    depth = 0                 # paren depth
+    stack = []                # one entry per open brace: is it a control block?
+    cur = []
+
+    def flush():
+        txt = "".join(cur).strip()
+        cur.clear()
+        if txt:
+            out.append((txt, any(stack) or bool(_CONTROL_RE.search(txt))))
+
+    for ch in s:
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+        if depth == 0 and ch in "{};":
+            if ch == "{":
+                head = "".join(cur)
+                ctl = bool(_CONTROL_RE.search(head))
+                flush()
+                stack.append(ctl)
+            elif ch == "}":
+                flush()
+                if stack:
+                    stack.pop()
+            else:
+                flush()
+            continue
+        cur.append(ch)
+    flush()
+    return out
+
+
+_ALIAS_RE = re.compile(r'^(?:const\s+)?(\w+)\s*\*\s*(\w+)\s*=\s*\((?:const\s+)?\w+\s*\*\)\s*&(_v\d+)$')
+_ELEM_WRITE_RE = re.compile(r'^(\w+)\[(\d+)\] = (?!=)(.*)$', re.S)
+_ELEMS = {"uint8_t": 16, "int8_t": 16, "uint16_t": 8, "int16_t": 8, "uint32_t": 4,
+          "int32_t": 4, "float": 4, "uint64_t": 2, "int64_t": 2}
+_MEMCPY_ALIAS_RE = re.compile(r'^memcpy\((\w+), (.*), 16\)$', re.S)
+_SPLAT_LOOP_RE = re.compile(
+    r'^for \(int i = 0; i < 16; i\+\+\) \(\(uint8_t\*\)&(_v\d+)\)\[i\] = (.*)$', re.S)
+
+
+def _analyze(s: str) -> tuple[int, int, int]:
+    """(gen, kill, mayw) of a straight-line statement text. gen over-, kill
+    under-approximated (both safe for liveness)."""
+    if not s or "_" not in s:
+        return 0, 0, 0
+    gen = 0
+    killed = 0
+    alias: dict = {}           # local pointer name -> vector register bit
+    elems: dict = {}           # alias name -> element count of its type
+    partial: dict = {}         # vector register bit -> set of elements written
+
+    def toks(t: str) -> int:
+        b = _tokens(t)
+        if alias:
+            for nm in re.findall(r'\w+', t):
+                if nm in alias:
+                    b |= alias[nm]
+        return b
+
+    for p, cond in _pieces(s):
+        if cond:
+            gen |= toks(p) & ~killed
+            continue
+        m = _ALIAS_RE.match(p)
+        if m:                  # T* d = (T*)&_vN : address only, no access yet
+            alias[m.group(2)] = _tokens(m.group(3))
+            elems[m.group(2)] = _ELEMS.get(m.group(1), 0)
+            continue
+        m = _ELEM_WRITE_RE.match(p)
+        if m and m.group(1) in alias and elems.get(m.group(1)):
+            # d[k] = rhs through an alias: a partial write. The register counts
+            # as killed only once every element has been written (vor/vxor/...);
+            # otherwise it is read (its other elements survive).
+            reg = alias[m.group(1)]
+            gen |= toks(m.group(3)) & ~killed
+            ws = partial.setdefault((reg, elems[m.group(1)]), set())
+            ws.add(int(m.group(2)))
+            if len(ws) == elems[m.group(1)] and ws == set(range(elems[m.group(1)])):
+                killed |= reg
+            continue
+        m = _ASSIGN_STMT_RE.match(p)
+        if m:
+            gen |= toks(m.group(2)) & ~killed
+            killed |= _tokens(m.group(1))
+            continue
+        m = _MEMCPY_DEF_RE.match(p)
+        if m:
+            full = 8 if m.group(1).startswith("_f") else 16
+            if int(m.group(3)) == full:
+                gen |= toks(m.group(2)) & ~killed
+                killed |= _tokens(m.group(1))
+                continue
+        m = _MEMCPY_ALIAS_RE.match(p)
+        if m and m.group(1) in alias:
+            gen |= toks(m.group(2)) & ~killed
+            killed |= alias[m.group(1)]
+            continue
+        m = _VST_DEF_RE.match(p)
+        if m:
+            gen |= toks(m.group(2)) & ~killed
+            killed |= _tokens(m.group(1))
+            continue
+        m = _VX_DEF_RE.match(p)
+        if m:
+            gen |= toks(m.group(2)) & ~killed
+            killed |= _tokens(m.group(1))
+            continue
+        m = _SPLAT_LOOP_RE.match(p)
+        if m and not (toks(m.group(2)) & _tokens(m.group(1))):
+            gen |= toks(m.group(2)) & ~killed
+            killed |= _tokens(m.group(1))
+            continue
+        gen |= toks(p) & ~killed
+    for (reg, n), ws in partial.items():
+        if not (killed & reg):
+            gen |= reg         # partially written: the rest of it is read through
+    return gen, killed, _may_write(s)
+
+
+def _match_paren(s: str, i: int) -> int:
+    """s[i] == '('; index of its matching ')' or -1."""
+    depth = 0
+    for j in range(i, len(s)):
+        c = s[j]
+        if c == "(":
+            depth += 1
+        elif c == ")":
+            depth -= 1
+            if depth == 0:
+                return j
+    return -1
+
+
+# ---------------------------------------------------------------------------
+# Statement parsing
+# ---------------------------------------------------------------------------
+
+class _Fallback(Exception):
+    pass
+
+
+@dataclass
+class _Node:
+    kind: str                  # label plain goto cgoto exit cexit sync csync switch
+    text: str = ""             # plain text / label line / pre text
+    cond: str = ""
+    target: str = ""           # label for goto/cgoto
+    exit_tail: str = ""        # exit statement text without the spill ("return;", tramp)
+    call: str = ""             # sync call text
+    ret: bool = False          # sync followed by return
+    arms: list = field(default_factory=list)   # switch arms: (case_val, 'goto'|'exit', payload)
+    sel: str = ""
+    default: str = ""
+    # analysis
+    gen: int = 0
+    kill: int = 0
+    mayw: int = 0
+    cgen: int = 0
+    cmayw: int = 0
+    succ: list = field(default_factory=list)
+    spill: int = 0
+    reload: int = 0
+    comment: str = ""
+
+
+_LBL = r'(?:loc_[0-9A-F]{8}(?:_i\d+)?|inl_\d+_end)'   # lifted labels, plus --opt-inline's renamed ones
+_LABEL_RE = re.compile(r'^(' + _LBL + r'):(.*)$')
+_GOTO_RE = re.compile(r'^goto (' + _LBL + r');$')
+_TRAMP_EXIT_RE = re.compile(
+    r'^\{ (g_trampoline_fn = \(void\(\*\)\(void\*\)\)\w+; return;|PPU_MUSTTAIL return \w+\(ctx\);) \}$')
+_LEAD_COMMENT_RE = re.compile(r'^/\*.*?\*/\s*')
+_TRAIL_COMMENT_RE = re.compile(r'\s*/\*(?:(?!\*/).)*\*/\s*$')
+_CASE_GOTO_RE = re.compile(r'case (0x[0-9A-Fa-f]+u): goto (loc_[0-9A-F]{8});')
+_CASE_EXIT_RE = re.compile(
+    r'case (0x[0-9A-Fa-f]+u): \{ (g_trampoline_fn = \(void\(\*\)\(void\*\)\)\w+; return;|'
+    r'PPU_MUSTTAIL return \w+\(ctx\);) \}')
+_DEFAULT_RE = re.compile(r'default: ((?:ps3_indirect_call|ppu_icall)\(ctx\); return;)')
+
+
+def _strip_comments(s: str) -> tuple[str, str, str]:
+    lead = trail = ""
+    m = _LEAD_COMMENT_RE.match(s)
+    if m:
+        lead, s = m.group(0), s[m.end():]
+    m = _TRAIL_COMMENT_RE.search(s)
+    if m:
+        trail, s = m.group(0), s[:m.start()]
+    return lead, s.strip(), trail
+
+
+def _parse_line(raw: str) -> _Node:
+    s0 = raw.strip()
+    m = _LABEL_RE.match(s0)
+    if m:
+        rest = m.group(2).strip()
+        if rest and not re.match(r'^;\s*(/\*.*\*/)?$', rest):
+            raise _Fallback("label+code")
+        return _Node("label", text=s0)
+    lead, s, trail = _strip_comments(s0)
+    if not s or s == ";":
+        return _Node("plain", text=s0)
+
+    if s == "return;":
+        return _Node("exit", exit_tail="return;")
+    m = _GOTO_RE.match(s)
+    if m:
+        return _Node("goto", target=m.group(1))
+    m = _TRAMP_EXIT_RE.match(s)
+    if m:
+        return _Node("exit", exit_tail=m.group(1))
+
+    if s.startswith("switch ("):
+        return _parse_switch(s)
+
+    if s.startswith("if ("):
+        j = _match_paren(s, 3)
+        if j < 0:
+            raise _Fallback("paren")
+        cond = s[4:j]
+        rest = s[j + 1:].strip()
+        if "return" in cond or "goto" in cond or _SYNC_CALL_RE.search(cond):
+            raise _Fallback("cond-ctl")
+        m = re.match(r'^goto (' + _LBL + r');$', rest)
+        if m:
+            return _Node("cgoto", cond=cond, target=m.group(1))
+        if rest == "return;":
+            return _Node("cexit", cond=cond, exit_tail="return;")
+        m = _TRAMP_EXIT_RE.match(rest)
+        if m:
+            return _Node("cexit", cond=cond, exit_tail=m.group(1))
+        if rest.startswith("{") and rest.endswith("}"):
+            inner = rest[1:-1].strip()
+            m = _SYNC_CALL_RE.search(inner)
+            if m:
+                pre = inner[:m.start()]
+                post = inner[m.end():].strip()
+                if post not in ("", "return;") or _SYNC_CALL_RE.search(inner, m.end()):
+                    raise _Fallback("csync-shape")
+                if re.search(r'\b(?:return|goto|if|switch)\b', pre):
+                    raise _Fallback("csync-pre")
+                return _Node("csync", cond=cond, text=pre.strip(), call=m.group(0),
+                             ret=(post == "return;"))
+        # if-statement without control transfer or call (e.g. a trap report)
+        if re.search(r'\b(?:return|goto|switch)\b|g_trampoline_fn|PPU_MUSTTAIL', s) \
+                or _SYNC_CALL_RE.search(s):
+            raise _Fallback("if-shape")
+        return _Node("plain", text=s0)
+
+    m = _SYNC_CALL_RE.search(s)
+    if m:
+        pre = s[:m.start()]
+        post = s[m.end():].strip()
+        if post not in ("", "return;") or _SYNC_CALL_RE.search(s, m.end()):
+            raise _Fallback("sync-shape")
+        if re.search(r'\b(?:return|goto|if|switch)\b', pre):
+            raise _Fallback("sync-pre")
+        return _Node("sync", text=pre.strip(), call=m.group(0), ret=(post == "return;"),
+                     exit_tail=trail)
+
+    if re.search(r'\b(?:return|goto|switch|case)\b|g_trampoline_fn|PPU_MUSTTAIL', s):
+        raise _Fallback("unknown-ctl")
+    return _Node("plain", text=s0)
+
+
+def _parse_switch(s: str) -> _Node:
+    m = re.match(r'^switch \(((?:[^()]|\([^()]*\))*)\) \{ (.*) \} return;$', s)
+    if not m:
+        raise _Fallback("switch-shape")
+    sel, body = m.group(1), m.group(2)
+    arms = []
+    pos = 0
+    rebuilt = []
+    while pos < len(body):
+        if body[pos] == " ":
+            pos += 1
+            continue
+        mg = _CASE_GOTO_RE.match(body, pos)
+        if mg:
+            arms.append((mg.group(1), "goto", mg.group(2)))
+            rebuilt.append(mg.group(0))
+            pos = mg.end()
+            continue
+        me = _CASE_EXIT_RE.match(body, pos)
+        if me:
+            arms.append((me.group(1), "exit", me.group(2)))
+            rebuilt.append(me.group(0))
+            pos = me.end()
+            continue
+        md = _DEFAULT_RE.match(body, pos)
+        if md and md.end() == len(body.rstrip()):
+            default = md.group(1)
+            rebuilt.append(md.group(0))
+            pos = len(body)
+            break
+        raise _Fallback("switch-arm")
+    else:
+        raise _Fallback("switch-nodefault")
+    if "".join(rebuilt).replace(" ", "") != body.replace(" ", ""):
+        raise _Fallback("switch-rebuild")
+    return _Node("switch", sel=sel, arms=arms, default=default)
+
+
+# ---------------------------------------------------------------------------
+# The locals transform
+# ---------------------------------------------------------------------------
+
+_CTX_VR_RE = re.compile(r'\bctx->vr\[\d+\]')
+
+
+def _subst(s: str, keep_vr: bool = False) -> str:
+    for rx, rep in _SUBST:
+        if keep_vr and rep == r'_v\1':
+            continue
+        s = rx.sub(rep, s)
+    return s
+
+
+def _spill_text(bits: int) -> str:
+    return " ".join(f"{_ctx_field(i)} = {_reg_name(i)};" for i in _bits_iter(bits))
+
+
+def _reload_text(bits: int) -> str:
+    return " ".join(f"{_reg_name(i)} = {_ctx_field(i)};" for i in _bits_iter(bits))
+
+
+def _exit_text(tail: str, spill: int) -> str:
+    sp = _spill_text(spill)
+    return f"{{ {sp} {tail} }}" if sp else (tail if tail == "return;" else f"{{ {tail} }}")
+
+
+def _locals_transform(lines: list[str], stats_reason: list, keep_vr: bool = False) -> list[str] | None:
+    """lines: body lines (already through the simple passes). Returns the new
+    lines (declarations first) or None to keep the function unchanged."""
+    if any(_BAD_INDEX_RE.search(l) for l in lines):
+        stats_reason.append("computed-index")
+        return None
+    sub = [_subst(l, keep_vr) for l in lines]
+    # every remaining ctx use must be an uncached field or a recognised call
+    for l in sub:
+        if "ctx" not in l:
+            continue
+        t = _CTX_OK_RE.sub("", l)
+        if keep_vr:
+            t = _CTX_VR_RE.sub("", t)
+        t = _SYNC_CALL_RE.sub("", t)
+        t = _MUSTTAIL_EXIT_RE.sub("", t)
+        t = t.replace("PPU_FN_ENTRY", "")
+        if re.search(r'\bctx\b', t):
+            stats_reason.append("ctx-use")
+            return None
+    try:
+        nodes = [_parse_line(l) for l in sub]
+        for n, l in zip(nodes, sub):           # keep comments (title patches, notes)
+            if n.kind not in ("label", "plain", "sync"):
+                lead, _s, trail = _strip_comments(l.strip())
+                n.comment = (lead.strip() + " " + trail.strip()).strip()
+    except _Fallback as e:
+        stats_reason.append(str(e))
+        return None
+
+    used = 0
+    for l in sub:
+        used |= _tokens(l)
+    if not used:
+        return None
+
+    # implicit return when the body can fall off its end
+    def falls_through(n: _Node) -> bool:
+        return not (n.kind in ("goto", "exit", "switch") or (n.kind == "sync" and n.ret))
+    if not nodes or falls_through(nodes[-1]):
+        nodes.append(_Node("exit", exit_tail="return;"))
+
+    # analysis inputs
+    labels = {}
+    for i, n in enumerate(nodes):
+        if n.kind == "label":
+            labels[n.text.split(":", 1)[0]] = i
+        if n.kind in ("plain", "sync", "csync", "exit"):
+            n.gen, n.kill, n.mayw = _analyze(_strip_comments(n.text)[1] if n.kind == "plain"
+                                               else n.text)
+        if n.kind in ("cgoto", "cexit", "csync"):
+            n.cgen = _tokens(n.cond)
+            n.cmayw = _may_write(n.cond)
+        if n.kind == "switch":
+            n.cgen = _tokens(n.sel)
+            n.cmayw = _may_write(n.sel)
+    N = len(nodes)
+    for i, n in enumerate(nodes):
+        nxt = [i + 1] if i + 1 < N else []
+        k = n.kind
+        if k in ("label", "plain", "cexit"):
+            n.succ = nxt
+        elif k == "goto":
+            if n.target not in labels:
+                stats_reason.append("missing-label")
+                return None
+            n.succ = [labels[n.target]]
+        elif k == "cgoto":
+            if n.target not in labels:
+                stats_reason.append("missing-label")
+                return None
+            n.succ = nxt + [labels[n.target]]
+        elif k == "exit":
+            n.succ = []
+        elif k == "sync":
+            n.succ = [] if n.ret else nxt
+        elif k == "csync":
+            n.succ = nxt
+        elif k == "switch":
+            tg = []
+            for _v, kind, payload in n.arms:
+                if kind == "goto":
+                    if payload not in labels:
+                        stats_reason.append("missing-label")
+                        return None
+                    tg.append(labels[payload])
+            n.succ = sorted(set(tg))
+        if any(s >= N for s in n.succ):
+            stats_reason.append("succ-range")
+            return None
+
+    # Only code reachable from the entry takes part: jump-table data words that
+    # decoded as instructions after a switch are dead, and their fall-through
+    # into the next case label must not make a register "dirty" there.
+    reach = [False] * N
+    stack = [0]
+    reach[0] = True
+    while stack:
+        i = stack.pop()
+        for s in nodes[i].succ:
+            if not reach[s]:
+                reach[s] = True
+                stack.append(s)
+    preds = [[] for _ in range(N)]
+    for i, n in enumerate(nodes):
+        if not reach[i]:
+            continue
+        for s in n.succ:
+            preds[s].append(i)
+
+    # forward may-dirty
+    din = [0] * N
+    dout = [0] * N
+    work = [i for i in range(N) if reach[i]]
+    inq = list(reach)
+    while work:
+        i = work.pop()
+        inq[i] = False
+        n = nodes[i]
+        d = 0
+        for p in preds[i]:
+            d |= dout[p]
+        din[i] = d
+        k = n.kind
+        if k in ("label", "goto"):
+            o = d
+        elif k == "plain":
+            o = d | n.mayw
+        elif k in ("cgoto", "cexit", "switch"):
+            o = d | n.cmayw
+        elif k == "sync":
+            o = 0
+        elif k == "csync":
+            o = d | n.cmayw
+        else:
+            o = 0
+        if o != dout[i]:
+            dout[i] = o
+            for s in n.succ:
+                if not inq[s]:
+                    inq[s] = True
+                    work.append(s)
+    # spill sets
+    for i, n in enumerate(nodes):
+        k = n.kind
+        if k == "exit":
+            n.spill = din[i] | n.mayw
+        elif k == "cexit":
+            n.spill = din[i] | n.cmayw
+        elif k == "sync":
+            n.spill = din[i] | n.mayw
+        elif k == "csync":
+            n.spill = din[i] | n.cmayw | n.mayw
+        elif k == "switch":
+            n.spill = din[i] | n.cmayw
+
+    # backward liveness (spills read)
+    lin = [0] * N
+    work = list(range(N))
+    inq = [True] * N
+    while work:
+        i = work.pop()
+        inq[i] = False
+        n = nodes[i]
+        lo = 0
+        for s in n.succ:
+            lo |= lin[s]
+        k = n.kind
+        if k in ("label", "goto"):
+            li = lo
+        elif k == "plain":
+            li = n.gen | (lo & ~n.kill)
+        elif k == "cgoto":
+            li = n.cgen | lo
+        elif k == "exit":
+            li = n.gen | (n.spill & ~n.kill)
+        elif k == "cexit":
+            li = n.cgen | n.spill | lo
+        elif k == "sync":
+            li = n.gen | (n.spill & ~n.kill)
+            n.reload = 0 if n.ret else lo
+        elif k == "csync":
+            li = n.cgen | n.gen | (n.spill & ~n.kill) | lo
+            n.reload = 0 if n.ret else lo
+        elif k == "switch":
+            li = n.cgen | n.spill | lo
+        else:
+            li = lo
+        if li != lin[i]:
+            lin[i] = li
+            for p in preds[i]:
+                if not inq[p]:
+                    inq[p] = True
+                    work.append(p)
+    # reload sets were computed with the final lo only if the node was last
+    # visited after convergence; recompute them now.
+    for i, n in enumerate(nodes):
+        if n.kind in ("sync", "csync") and not n.ret:
+            lo = 0
+            for s in n.succ:
+                lo |= lin[s]
+            n.reload = lo
+
+    entry_live = lin[0]
+    allregs = used
+    for n in nodes:
+        allregs |= n.spill | n.reload
+
+    # ---- emit ----
+    out = []
+    decl = []
+    for i in _bits_iter(allregs):
+        ty, nm = _reg_type(i), _reg_name(i)
+        if entry_live >> i & 1:
+            decl.append(f"{ty} {nm} = {_ctx_field(i)};")
+        else:
+            decl.append(f"{ty} {nm} = {{}};" if ty == "ppu_vr" else f"{ty} {nm} = 0;")
+    # declarations, a few per line
+    for k in range(0, len(decl), 6):
+        out.append("    " + " ".join(decl[k:k + 6]))
+    for n in nodes:
+        k = n.kind
+        nout = len(out)
+        _emit_node(n, out)
+        if n.comment and len(out) > nout:
+            out[-1] += "  " + n.comment
+    return out
+
+
+def _emit_node(n: "_Node", out: list) -> None:
+    if True:
+        k = n.kind
+        if k in ("label", "plain"):
+            out.append(n.text if k == "label" else "    " + n.text)
+        elif k == "goto":
+            out.append(f"    goto {n.target};")
+        elif k == "cgoto":
+            out.append(f"    if ({n.cond}) goto {n.target};")
+        elif k == "exit":
+            out.append("    " + _exit_text(n.exit_tail, n.spill))
+        elif k == "cexit":
+            out.append(f"    if ({n.cond}) " + _exit_text(n.exit_tail, n.spill))
+        elif k == "sync":
+            parts = [p for p in (n.text, _spill_text(n.spill), n.call) if p]
+            if n.ret:
+                parts.append("return;")
+            else:
+                r = _reload_text(n.reload)
+                if r:
+                    parts.append(r)
+            line = " ".join(parts)
+            if n.exit_tail:          # (a sync line's trailing comment)
+                line += n.exit_tail
+            out.append("    " + line)
+        elif k == "csync":
+            parts = [p for p in (n.text, _spill_text(n.spill), n.call) if p]
+            if n.ret:
+                parts.append("return;")
+            else:
+                r = _reload_text(n.reload)
+                if r:
+                    parts.append(r)
+            out.append(f"    if ({n.cond}) {{ " + " ".join(parts) + " }")
+        elif k == "switch":
+            sp = _spill_text(n.spill)
+            arms = []
+            for val, kind, payload in n.arms:
+                if kind == "goto":
+                    arms.append(f"case {val}: goto {payload};")
+                else:
+                    arms.append(f"case {val}: {{ {sp + ' ' if sp else ''}{payload} }}")
+            arms.append(f"default: {sp + ' ' if sp else ''}{n.default}")
+            out.append(f"    switch ({n.sel}) {{ " + " ".join(arms) + " } return;")
+
+
+# ---------------------------------------------------------------------------
+# --opt-inline: small leaf functions copied into their direct call sites
+# ---------------------------------------------------------------------------
+# A leaf (no call, syscall, indirect call, tail call or switch of its own; no
+# fall-through into a next fragment) of at most inline_max statements is
+# pasted in place of `ctx->lr = RET; func_F(ctx);` as a braced block: its
+# labels renamed per site, `return` turned into a goto to the block's end and
+# its callee-save snapshots (_cs_N) renamed. ctx->lr is still set first, so an
+# mflr inside sees the return address exactly as with the call. The copy runs
+# on the caller's register file -- the same one the callee would have seen in
+# ctx -- so with --opt-locals the call's spill/reload disappears too.
+# NOT for the PPU_MOD_HOOKS build: an inlined copy bypasses its PPU_FN_ENTRY
+# guard (lift the hooks tree without --opt-inline).
+
+_CALL_SITE_RE = re.compile(
+    r'^(\s*)(ctx->lr = 0x[0-9A-F]+;) (\w*func_[0-9A-F]{8})\(ctx\);(?: DRAIN_TRAMPOLINE\(ctx\);)?\s*$')
+_LOC_RE = re.compile(r'\bloc_([0-9A-F]{8})\b')
+_CS_RE = re.compile(r'\b_cs_(\d+)\b')
+_RET_LINE_RE = re.compile(r'^(\s*)(if \(.*\) )?return;\s*(/\*.*\*/)?\s*$')
+
+
+def inline_candidate(body_lines: list[str], opts: CodegenOptions) -> list[str] | None:
+    """Return the callee body prepared for pasting (stripped lines), or None."""
+    n_stmt = 0
+    out = []
+    for l in body_lines:
+        s = l.strip()
+        if not s:
+            continue
+        if (_SYNC_CALL_RE.search(s) or "g_trampoline_fn" in s or "PPU_MUSTTAIL" in s
+                or s.startswith("switch") or "missing continuation" in s
+                or "ps3_hle_call" in s or "ctx)" in s or "ctx," in s or "ctx;" in s):
+            return None
+        if not _LABEL_RE.match(s):
+            n_stmt += 1
+        out.append(s)
+    if n_stmt == 0 or n_stmt > opts.inline_max:
+        return None
+    # every exit must be a plain (optionally conditional) return
+    for s in out:
+        if re.search(r'\breturn\b', s) and not _RET_LINE_RE.match(s):
+            return None
+    return out
+
+
+def _inline_site(m: re.Match, body: list[str], k: int, fname: str) -> list[str]:
+    ind = m.group(1) or "    "
+    end = f"inl_{k}_end"
+    res = [f"{ind}{m.group(2)} {{ /* inline {fname} */"]
+    for s in body:
+        s = _LOC_RE.sub(lambda mm: f"loc_{mm.group(1)}_i{k}", s)
+        s = _CS_RE.sub(lambda mm: f"_cs{k}_{mm.group(1)}", s)
+        r = _RET_LINE_RE.match(s)
+        if r:
+            s = (r.group(2) or "") + f"goto {end};"
+        if _LABEL_RE.match(s):
+            res.append(s)
+        else:
+            res.append(ind + s)
+    res.append(f"{end}: ;")
+    res.append(ind + "}")
+    return res
+
+
+def inline_calls(lines: list[str], bodies: dict, stats: CodegenStats, self_name: str = "") -> list[str]:
+    out = []
+    k = 0
+    for l in lines:
+        m = _CALL_SITE_RE.match(l)
+        if m and m.group(3) in bodies and m.group(3) != self_name:
+            out.extend(_inline_site(m, bodies[m.group(3)], k, m.group(3)))
+            k += 1
+            stats.inlined_sites += 1
+        else:
+            out.append(l)
+    return out
+
+
+def transform_body(lines: list[str], opts: CodegenOptions, stats: CodegenStats,
+                   uses_memory_hint: bool = True, inline_bodies: dict | None = None,
+                   self_name: str = "") -> list[str]:
+    """Rewrite one function's body lines (as emitted between the signature line
+    and the closing brace, fall-through trampoline included)."""
+    stats.functions += 1
+    if not opts.any():
+        return lines
+    body = _simple_passes(lines, opts)
+    if opts.inline and inline_bodies:
+        body = inline_calls(body, inline_bodies, stats, self_name)
+    if opts.locals:
+        reasons: list = []
+        new = _locals_transform(body, reasons, keep_vr=not opts.locals_vr)
+        if new is not None:
+            body = new
+            stats.transformed += 1
+        else:
+            stats.note_fallback(reasons[0] if reasons else "no-regs")
+    if opts.fast_mem and any("_vmb" in l for l in body):
+        body = ["    uint8_t* const _vmb = vm_base;"] + body
+    return body
diff --git a/tools/ppu_codegen_retransform.py b/tools/ppu_codegen_retransform.py
new file mode 100644
index 00000000..32fbaf51
--- /dev/null
+++ b/tools/ppu_codegen_retransform.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""ppu_codegen_retransform.py -- apply ppu_lifter's --opt-* code-generation
+passes to an ALREADY LIFTED tree, without re-running the lift.
+
+The passes (tools/ppu_codegen_opt.py) are pure text rewrites of each emitted
+function body, so applying them here is exactly what `ppu_lifter.py --opt-*`
+does at emission time. Useful for A/B builds from one baseline lift.
+
+    python ppu_codegen_retransform.py IN_DIR OUT_DIR --opt-all [-j N]
+    python ppu_codegen_retransform.py IN_DIR OUT_DIR --opt-fast-mem --opt-locals ...
+
+IN_DIR must be an unoptimised lift (ppu_recomp.h + ppu_recomp_NNN.cpp).
+"""
+import argparse
+import glob
+import os
+import re
+import shutil
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import ppu_codegen_opt as cg  # noqa: E402
+
+_DEF_RE = re.compile(r'^void (\w*func_[0-9A-F]{8})\(ppu_context\* ctx\) \{')
+
+
+def iter_functions(src: str):
+    """(name, body lines) for every function definition in a chunk."""
+    lines = [l[:-1] if l.endswith("\r") else l for l in src.split("\n")]
+    i, n = 0, len(lines)
+    while i < n:
+        m = _DEF_RE.match(lines[i])
+        if m:
+            j = i + 1
+            while j < n and lines[j] != "}":
+                j += 1
+            yield m.group(1), lines[i + 1:j]
+            i = j + 1
+        else:
+            i += 1
+
+
+def collect_inline_bodies(chunks, opts: "cg.CodegenOptions") -> dict:
+    bodies = {}
+    for c in chunks:
+        with open(c, encoding="latin-1", newline="") as f:
+            src = f.read()
+        for name, body in iter_functions(src):
+            cand = cg.inline_candidate(cg._simple_passes(body, opts), opts)
+            if cand is not None:
+                bodies[name] = cand
+    return bodies
+
+
+_INLINE = {}
+
+
+def _init_worker(bodies):
+    _INLINE.clear()
+    _INLINE.update(bodies)
+
+
+def transform_chunk(src: str, opts: "cg.CodegenOptions", stats: "cg.CodegenStats") -> str:
+    nl = "\r\n" if "\r\n" in src[:4096] else "\n"
+    lines = [l[:-1] if l.endswith("\r") else l for l in src.split("\n")]
+    out = []
+    i = 0
+    n = len(lines)
+    pre_done = False
+    while i < n:
+        line = lines[i]
+        m = _DEF_RE.match(line)
+        if m:
+            if not pre_done:
+                # preamble extension goes right before the first definition (and
+                # before its optional /* label */ comment line)
+                ins = len(out)
+                if out and out[-1].startswith("/*") and out[-1].endswith("*/"):
+                    ins -= 1
+                if opts.fp:
+                    pre = cg.patch_source_preamble("\n".join(out[:ins]), opts).split("\n")
+                    out[:ins] = pre
+                    ins = len(pre)
+                extra = cg.source_preamble(opts)
+                if extra:
+                    out[ins:ins] = extra.rstrip("\n").split("\n") + [""]
+                pre_done = True
+            out.append(line)
+            j = i + 1
+            body = []
+            while j < n and lines[j] != "}":
+                body.append(lines[j])
+                j += 1
+            if j >= n:
+                raise SystemExit(f"unterminated function {m.group(1)}")
+            out.extend(cg.transform_body(body, opts, stats, inline_bodies=_INLINE,
+                                         self_name=m.group(1)))
+            out.append("}")
+            i = j + 1
+            continue
+        out.append(line)
+        i += 1
+    if opts.musttail:
+        for l in out:
+            if "g_trampoline_fn = (void" in l:
+                raise SystemExit("musttail: a trampoline assignment survived: " + l.strip()[:200])
+    return nl.join(out)
+
+
+def _work(args):
+    path, out_path, flags = args
+    opts = cg.CodegenOptions(**flags)
+    stats = cg.CodegenStats()
+    with open(path, encoding="latin-1", newline="") as f:
+        src = f.read()
+    dst = transform_chunk(src, opts, stats)
+    with open(out_path, "w", encoding="latin-1", newline="") as f:
+        f.write(dst)
+    return os.path.basename(path), stats
+
+
+def add_opt_args(p):
+    p.add_argument("--opt-fast-mem", action="store_true")
+    p.add_argument("--opt-trust-sp", action="store_true")
+    p.add_argument("--opt-fast-icall", action="store_true")
+    p.add_argument("--opt-musttail", action="store_true")
+    p.add_argument("--opt-locals", action="store_true")
+    p.add_argument("--opt-locals-no-vr", action="store_true",
+                   help="with --opt-locals/--opt-all: keep vector registers in ctx->vr")
+    p.add_argument("--opt-fp", action="store_true")
+    p.add_argument("--opt-cr", action="store_true")
+    p.add_argument("--opt-inline", action="store_true")
+    p.add_argument("--inline-max", type=int, default=24)
+    p.add_argument("--opt-all", action="store_true",
+                   help="fast-mem + trust-sp + fast-icall + musttail + locals + fp + cr (not inline)")
+
+
+def opts_from_args(a) -> dict:
+    allon = a.opt_all
+    return dict(fast_mem=allon or a.opt_fast_mem, trust_sp=allon or a.opt_trust_sp,
+                fast_icall=allon or a.opt_fast_icall, musttail=allon or a.opt_musttail,
+                locals=allon or a.opt_locals, fp=allon or a.opt_fp, cr=allon or a.opt_cr,
+                inline=a.opt_inline, inline_max=a.inline_max, locals_vr=not a.opt_locals_no_vr)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("in_dir")
+    ap.add_argument("out_dir")
+    ap.add_argument("-j", "--jobs", type=int, default=1)
+    ap.add_argument("--only", default=None, help="comma list of chunk basenames (testing)")
+    add_opt_args(ap)
+    a = ap.parse_args()
+    flags = opts_from_args(a)
+    os.makedirs(a.out_dir, exist_ok=True)
+    for h in glob.glob(os.path.join(a.in_dir, "*.h")):
+        shutil.copy2(h, os.path.join(a.out_dir, os.path.basename(h)))
+    chunks = sorted(glob.glob(os.path.join(a.in_dir, "ppu_recomp_*.cpp")))
+    if a.only:
+        keep = set(a.only.split(","))
+        chunks = [c for c in chunks if os.path.basename(c) in keep]
+    tasks = [(c, os.path.join(a.out_dir, os.path.basename(c)), flags) for c in chunks]
+    t0 = time.time()
+    total = cg.CodegenStats()
+    bodies = {}
+    if flags.get("inline"):
+        allchunks = sorted(glob.glob(os.path.join(a.in_dir, "ppu_recomp_*.cpp")))
+        bodies = collect_inline_bodies(allchunks, cg.CodegenOptions(**flags))
+        print(f"  inline candidates: {len(bodies)} leaf functions "
+              f"(<= {flags.get('inline_max')} statements)", flush=True)
+    _init_worker(bodies)
+    if a.jobs > 1:
+        import multiprocessing as mp
+        pool = mp.Pool(a.jobs, initializer=_init_worker, initargs=(bodies,))
+        try:
+            for name, st in pool.imap_unordered(_work, tasks):
+                total.merge(st)
+                print(f"  {name}: {st.functions} fns, {st.transformed} locals, {st.fallback} fallback", flush=True)
+            pool.close()
+            pool.join()
+        except BaseException:
+            pool.terminate()
+            raise
+    else:
+        for t in tasks:
+            name, st = _work(t)
+            total.merge(st)
+            print(f"  {name}: {st.functions} fns, {st.transformed} locals, {st.fallback} fallback", flush=True)
+    print(f"[retransform] opts={cg.CodegenOptions(**flags).tag()} functions={total.functions} "
+          f"locals={total.transformed} fallback={total.fallback} "
+          f"inlined_sites={total.inlined_sites} {time.time() - t0:.1f}s")
+    for k, v in sorted(total.fallback_reasons.items(), key=lambda kv: -kv[1]):
+        print(f"    fallback {k}: {v}")
+
+
+if __name__ == "__main__":
+    main()
