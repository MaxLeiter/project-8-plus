+static void savedata_shared_init(const char* import_from)
+{
+    s_shared = 1;
+    ensure_dirs(s_save_root);
+    int r = sd_lock_try(SD_LOCK_SESSION);
+    if (r == 1) sd_lock_write_holder();
+    else if (r == 0) {
+        char who[SD_PATH_MAX + 64];
+        sd_lock_holder(who, sizeof who);
+        printf("[cellSaveData] NOTE: another game is using this save folder (%s). Both load and save the same saves: "
+               "the one that saves last wins.\n", who[0] ? who : "unknown process");
+    } else
+        printf("[cellSaveData] NOTE: no lock file in the save folder (errno %d): two games on it are not detected\n", errno);
+    if (import_from && savedata_pass_lock(1)) {
+        savedata_import(import_from);
+        savedata_pass_unlock();
+    }
