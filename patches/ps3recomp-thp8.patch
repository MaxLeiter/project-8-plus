+            case 3: a = (rnd() & 1) ? mkf(s1, 0, rnd32()) : get32(RA + 4 * i);
+                    b = (rnd() & 1) ? mkf(s2, 0, (rnd() & 1) ? rnd32() : 0) : get32(RB + 4 * i); break;
+            case 4: a = (rnd() & 1) ? mkf(s1, 255, rfrac()) : rand_float(); b = (rnd() & 1) ? mkf(s2, 255, rfrac()) : rand_float(); break;
+            case 5: a = rand_float(); b = mul ? ((rnd() & 1) ? 0x80000000u : 0) : (a ^ (sub ? 0 : 0x80000000u)); break;
