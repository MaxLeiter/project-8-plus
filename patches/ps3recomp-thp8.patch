+#!/usr/bin/env bash
+# run_spucheck.sh -- SPU per-instruction differential harness, one command:
+# regenerate the cases (gen_spucheck.py + the real spu_lifter.py: ~9.8k
+# single-instruction cases over every decoded mnemonic, plus random multi-
+# instruction SEQUENCE programs lifted as whole functions), build the driver
+# twice (game flags with the SSE4.1 helper paths, and without SSE4.1 so the
+# scalar *_ref helper loops are what runs), run both. Strict: any mismatch
+# against the ISA reference, or between interpreter and lifted code, fails.
+#
+#   runtime/spu/tests/spucheck/run_spucheck.sh [options]
+#     --out DIR         work dir (default: $SPUCHECK_OUT or <repo>/build/spucheck)
+#     --seeds N         seeds per case (default 64)
+#     --strict-float    no expected failures (the default now; kept for old command lines)
+#     --xfail LIST      explicit expected-failing mnemonic list (comma separated)
+#     --only LIST       only these mnemonics (generated and run; "seq" = the sequence programs)
+#     --seq N           sequence-mode programs (default 300, 0 = none; more = longer build)
+#     --seq-seed N      sequence generator seed (a different program set per seed)
+#     --gen-seed N      single-instruction case generator seed
+#     --sse-only        skip the scalar (*_ref) build
+#     --no-gen          reuse the generated cases in DIR/gen
+#
+# Exit status: 0 = no unexpected mismatch in any build, 1 = mismatches, 2 = setup error.
+# Toolchain: clang-cl on PATH (override CC=...), python (override PY=...). Builds
+# run one compiler at a time. On a shared machine wrap the whole thing, e.g.
+#   tools/lowprio.sh tools/vsbuild.sh bash <this script>
+set -u
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO="$(cd "$HERE/../../../.." && pwd)"
+OUT="${SPUCHECK_OUT:-$REPO/build/spucheck}"
+PY="${PY:-python}"
+CC="${CC:-clang-cl}"
+SEEDS=64; ONLY=""; GEN=1; SCALAR=1; GENARGS=()
+XFAIL="${SPUCHECK_XFAIL-}"
+while [ $# -gt 0 ]; do
+    case "$1" in
+    --out) OUT="$2"; shift 2 ;;
+    --seeds) SEEDS="$2"; shift 2 ;;
+    --strict-float) XFAIL="none"; shift ;;
+    --xfail) XFAIL="$2"; shift 2 ;;
+    --only) ONLY="$2"; shift 2 ;;
+    --seq) GENARGS+=(--seq "$2"); shift 2 ;;
+    --seq-seed) GENARGS+=(--seq-seed "$2"); shift 2 ;;
+    --gen-seed) GENARGS+=(--seed "$2"); shift 2 ;;
+    --sse-only) SCALAR=0; shift ;;
+    --no-gen) GEN=0; shift ;;
+    *) echo "unknown option $1" >&2; exit 2 ;;
+    esac
+done
+mkdir -p "$OUT/gen" "$OUT/obj" || exit 2
+w() { if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else echo "$1"; fi; }
+
+if [ $GEN -eq 1 ]; then
+    rm -f "$OUT"/gen/*
+    "$PY" "$HERE/gen_spucheck.py" --out "$(w "$OUT/gen")" --python "$PY" ${ONLY:+--only "$ONLY"} "${GENARGS[@]}" || exit 2
+fi
+
+# Git-for-Windows bash would rewrite /nologo, /Fo..., /clang:... as paths.
+export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
+COMMON=(/nologo -O2 -fno-strict-aliasing /clang:-ffp-contract=off -MD
+        -I"$(w "$REPO/runtime/spu")" -I"$(w "$REPO/include")" -I"$(w "$OUT/gen")" -I"$(w "$HERE")"
+        -Wno-unused-function -Wno-unused-variable -Wno-unused-label -Wno-unused-but-set-variable
+        -D_CRT_SECURE_NO_WARNINGS)
+variants=(sse41)
+[ $SCALAR -eq 1 ] && variants+=(scalar)
+rc=0
+for v in "${variants[@]}"; do
+    flags=("${COMMON[@]}")
+    [ "$v" = sse41 ] && flags+=(-msse4.1)
+    objs=()
+    srcs=("$HERE/spucheck_main.c" "$HERE/spu_ref.c" "$REPO/runtime/spu/spu_interp.c")
+    for g in "$OUT"/gen/spck*.c "$OUT"/gen/spsq*.c; do [ -e "$g" ] && srcs+=("$g"); done
+    for s in "${srcs[@]}"; do
+        o="$OUT/obj/${v}_$(basename "${s%.c}").obj"
+        if ! "$CC" "${flags[@]}" -c "$(w "$s")" /Fo"$(w "$o")" > "$OUT/obj/build_${v}.log" 2>&1; then
+            echo "[spucheck] build failed: $s ($v)"; cat "$OUT/obj/build_${v}.log" | head -40; exit 2
+        fi
+        objs+=("$(w "$o")")
+    done
+    exe="$OUT/spucheck_${v}.exe"
+    "$CC" /nologo "${objs[@]}" /Fe"$(w "$exe")" > "$OUT/obj/link_${v}.log" 2>&1 || { echo "[spucheck] link failed ($v)"; cat "$OUT/obj/link_${v}.log" | head -40; exit 2; }
+    echo "[spucheck] running $v build ..."
+    if [ -n "$XFAIL" ]; then export SPUCHECK_XFAIL="$XFAIL"; fi
+    if [ -n "$ONLY" ]; then export SPUCHECK_ONLY="$ONLY"; fi
+    SPUCHECK_SEEDS="$SEEDS" "$exe" "$(w "$OUT/gen")" > "$OUT/report_${v}.txt" 2> "$OUT/stderr_${v}.log"
+    r=$?
+    tail -n 1 "$OUT/report_${v}.txt"
+    echo "[spucheck] $v: exit $r, report $OUT/report_${v}.txt"
+    [ $r -ne 0 ] && rc=1
+done
+exit $rc
