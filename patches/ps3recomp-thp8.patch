+++ b/tools/spucheck/lift_variants.py
@@ -0,0 +1,249 @@
+#!/usr/bin/env python3
+"""lift_variants.py -- lift runtime-built / self-modified SPU code offline.
+
+The runtime writes a local-store dump whenever dispatch has to fall back to the
+interpreter (SPU_MISS_DIR=<dir>, runtime/spu/spu_channels.c spu_miss_dump):
+    u32 'SMIS', u32 version (1|2), u32 image_id, u32 pc, u32 lr, u32 policy_mode,
+    u64 key, u8 ls[256 KB]
+(v1 key: FNV-1a of 32 bytes at pc; v2: spu_code_hash of up to 4 KB from pc).
+This tool lifts the code found there (a --window of LS from the miss pc) and
+describes every lifted function as a VARIANT (runtime/spu/spu_variant_api.h):
+
+    entry   the function's LS address
+    extent  [lo, lo+len): the hull of the function and every function it calls
+            or jumps to DIRECTLY, transitively -- those transfers bypass
+            dispatch, so their bytes are part of what the lift assumes (calls
+            to code outside the window go through the dispatcher and are
+            validated there, not here). In-function branch targets and jump-
+            table case labels lie inside the body.
+    hash    code_hash(extent bytes) == the runtime's spu_code_hash
+
+The runtime runs a variant only where the live LS bytes of its whole extent
+hash the same.
+
+    python tools/spucheck/lift_variants.py --out <dir> [--window 0x4000]
+                                           [--dll <file.dll>] dump.bin...
+
+<dir> receives one sub-directory of lifted C per distinct (pc, window bytes),
+spu_variants.c (the variant table) and variants.json (a manifest). Two ways to
+use them:
+  static  add all of it to the title build (THP8: drop the directory under
+          src/spu_gen/, which the build globs); spu_variants.c registers the
+          table from a constructor.
+  DLL     --dll <file> compiles the lifted C + spu_variants.c + the glue
+          (tools/spucheck/spu_variant_dll.c) with -DSPU_VARIANT_DLL and the
+          game's flags into one DLL (clang-cl and link on PATH: THP8 under
+          tools/vsbuild.sh). Put it in a directory and run the UNCHANGED game
+          with SPU_VARIANT_DIR=<that directory>.
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+import shutil
+import struct
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TOOLS = os.path.dirname(HERE)
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+from find_spu_functions import detect_functions  # noqa: E402
+
+LS_SIZE = 0x40000
+M64 = (1 << 64) - 1
+# The game's runtime flags (work/spucheck/RULES.txt), + the DLL switch.
+CFLAGS = ["-nologo", "-MD", "-O2", "-msse4.1", "-fno-strict-aliasing", "/clang:-ffp-contract=off"]
+
+
+def code_hash(b):
+    """runtime/spu/spu_channels.c spu_code_hash -- keep identical."""
+    k = 0xBF58476D1CE4E5B9
+    n = len(b)
+    h = 0x9E3779B97F4A7C15 ^ ((n * 0xC2B2AE3D27D4EB4F) & M64)
+    i = 0
+    for (w,) in struct.iter_unpack("<Q", b[:n - n % 8]):
+        h = ((h ^ w) * k) & M64
+        h ^= h >> 31
+        i += 8
+    if i < n:
+        w = int.from_bytes(b[i:], "little")
+        h = ((h ^ w) * k) & M64
+        h ^= h >> 31
+    h ^= h >> 33
+    h = (h * 0xFF51AFD7ED558CCD) & M64
+    h ^= h >> 33
+    return h
+
+
+def parse_bodies(src, prefix, starts):
+    """{start: set(direct references to other lifted functions)} from spu_recomp.c."""
+    defn = re.compile(r"^void " + re.escape(prefix) + r"spu_func_([0-9A-F]{8})\(spu_context\* ctx\) \{$")
+    ref = re.compile(re.escape(prefix) + r"spu_func_([0-9A-F]{8})")
+    refs, cur = {}, None
+    for line in src.splitlines():
+        m = defn.match(line)
+        if m:
+            a = int(m.group(1), 16)
+            cur = a if a in starts else None
+            if cur is not None:
+                refs[cur] = set()
+            continue
+        if line.startswith("/* Indirect-dispatch stubs") or line.startswith("/* Function table"):
+            cur = None
+            continue
+        if cur is not None:
+            for r in ref.findall(line):
+                a = int(r, 16)
+                if a in starts and a != cur:
+                    refs[cur].add(a)
+    return refs
+
+
+def extents(funcs, refs):
+    """{start: (lo, hi)}: hull over the direct-transfer closure of each function."""
+    ends = dict(funcs)
+    out = {}
+    for s, _ in funcs:
+        seen, todo = {s}, [s]
+        while todo:
+            for t in refs.get(todo.pop(), ()):
+                if t not in seen:
+                    seen.add(t)
+                    todo.append(t)
+        out[s] = (min(seen), max(ends[a] for a in seen))
+    return out
+
+
+def lift_dump(path, a, seen_windows):
+    raw = open(path, "rb").read()
+    magic, ver, img, pc, lr, pm = struct.unpack_from("<6I", raw, 0)
+    if magic != 0x53494D53 or ver not in (1, 2) or len(raw) < 32 + LS_SIZE:
+        print(f"{path}: not a miss dump")
+        return None
+    ls = raw[32:32 + LS_SIZE]
+    end = min(pc + a.window, LS_SIZE)
+    blob = ls[pc:end]
+    wkey = (pc, hashlib.sha1(blob).digest())
+    if wkey in seen_windows:
+        return None
+    seen_windows.add(wkey)
+    name = f"var_{pc:05X}_{code_hash(blob):016X}_"
+    sub = os.path.join(a.out, name.rstrip("_"))
+    os.makedirs(sub, exist_ok=True)
+    binp = os.path.join(sub, "code.bin")
+    open(binp, "wb").write(blob)
+    funcs, _ = detect_functions(blob, base_override=pc, verbose=False, raw=True)
+    if not any(s == pc for s, _ in funcs):
+        nxt = [s for s, _ in funcs if s > pc]
+        funcs.append((pc, min(nxt) if nxt else end))
+        funcs.sort()
+    jf = os.path.join(sub, "functions.json")
+    json.dump([{"start": s, "end": e} for s, e in funcs], open(jf, "w"))
+    r = subprocess.run([a.python, os.path.join(TOOLS, "spu_lifter.py"), binp, "--base", hex(pc),
+                        "--functions", jf, "--symbol-prefix", name, "--output", sub,
+                        "--header-name", "spu_recomp.h", "--source-name", "spu_recomp.c"],
+                       capture_output=True, text=True)
+    if r.returncode != 0:
+        print(f"{path}: lifter failed:\n{r.stdout}\n{r.stderr}")
+        shutil.rmtree(sub, ignore_errors=True)
+        return None
+    src = open(os.path.join(sub, "spu_recomp.c")).read()
+    refs = parse_bodies(src, name, {s for s, _ in funcs})
+    ext = extents(funcs, refs)
+    out = []
+    for s, _ in funcs:
+        lo, hi = ext[s]
+        out.append({"entry": s, "lo": lo, "len": hi - lo, "hash": code_hash(ls[lo:hi]),
+                    "symbol": f"{name}spu_func_{s:08X}", "dir": os.path.basename(sub),
+                    "dump": os.path.basename(path), "image": img})
+    print(f"{path}: img {img} pc 0x{pc:05X}: {len(funcs)} function(s) -> {sub} "
+          f"(entry extent 0x{ext[pc][0]:05X}+0x{ext[pc][1] - ext[pc][0]:X})")
+    return sub, out
+
+
+def write_table(out_dir, variants):
+    p = os.path.join(out_dir, "spu_variants.c")
+    with open(p, "w") as f:
+        f.write("/* Generated by tools/spucheck/lift_variants.py -- lifted SPU variants\n"
+                " * (runtime/spu/spu_variant_api.h). Static build: a constructor registers the\n"
+                " * table. -DSPU_VARIANT_DLL: exports spu_variants_register for SPU_VARIANT_DIR. */\n")
+        f.write('#include "spu_variant_api.h"\n\n')
+        for v in variants:
+            f.write(f"extern void {v['symbol']}(struct spu_context*);\n")
+        f.write("\nstatic const spu_variant_desc s_variants[] = {\n")
+        for v in variants:
+            f.write(f"    {{ 0x{v['entry']:05X}u, 0x{v['lo']:05X}u, 0x{v['len']:X}u, "
+                    f"0x{v['hash']:016X}ull, {v['symbol']} }},\n")
+        if not variants:
+            f.write("    { 0, 0, 0, 0, 0 },\n")
+        f.write("};\n#define N_VARIANTS %du\n\n" % len(variants))
+        f.write("#ifdef SPU_VARIANT_DLL\n"
+                "int spu_vdll_register(const spu_variant_api* api, const spu_variant_desc* v, uint32_t n);\n"
+                "__declspec(dllexport) int spu_variants_register(const spu_variant_api* api)\n"
+                "{\n    return spu_vdll_register(api, s_variants, N_VARIANTS);\n}\n"
+                "#else\n"
+                "__attribute__((constructor)) static void spu_variants_ctor(void)\n"
+                "{\n    spu_variant_add(s_variants, N_VARIANTS);\n}\n"
+                "#endif\n")
+    return p
+
+
+def build_dll(out_dir, subs, table, dll, cc="clang-cl", link="link"):
+    inc = [os.path.join(ROOT, "runtime", "spu"), os.path.join(ROOT, "runtime"), os.path.join(ROOT, "include")]
+    flags = CFLAGS + ["-DSPU_VARIANT_DLL"] + [x for d in inc for x in ("-I", d)]
+    objd = os.path.join(out_dir, "obj")
+    os.makedirs(objd, exist_ok=True)
+    srcs = [os.path.join(s, "spu_recomp.c") for s in subs] + [table, os.path.join(HERE, "spu_variant_dll.c")]
+    objs = []
+    for i, s in enumerate(srcs):       # one compiler process at a time (shared machine)
+        o = os.path.join(objd, f"v{i}.obj")
+        quiet = ["-w"] if s.endswith("spu_recomp.c") else []
+        r = subprocess.run([cc] + flags + quiet + ["-c", s, "-Fo" + o], capture_output=True, text=True)
+        if r.returncode != 0:
+            sys.exit(f"compile failed: {s}\n{r.stdout}\n{r.stderr}")
+        objs.append(o)
+    r = subprocess.run([link, "-nologo", "-DLL", "-OUT:" + dll] + objs, capture_output=True, text=True)
+    if r.returncode != 0:
+        sys.exit(f"link failed:\n{r.stdout}\n{r.stderr}")
+    print(f"DLL: {dll} ({len(subs)} lift(s))")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("dumps", nargs="+")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--window", type=lambda x: int(x, 0), default=0x4000,
+                    help="bytes of LS lifted from the miss pc on (default 16 KB)")
+    ap.add_argument("--dll", help="also build this variant DLL (for SPU_VARIANT_DIR)")
+    ap.add_argument("--python", default=sys.executable)
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+
+    seen_windows, subs, variants, keys = set(), [], [], set()
+    for path in a.dumps:
+        res = lift_dump(path, a, seen_windows)
+        if not res:
+            continue
+        sub, vs = res
+        fresh = [v for v in vs if (v["entry"], v["lo"], v["len"], v["hash"]) not in keys]
+        if not fresh:          # same code lifted from another dump: drop the copy
+            shutil.rmtree(sub, ignore_errors=True)
+            continue
+        subs.append(sub)
+        for v in vs:           # all of a lift's functions link; register each code once
+            k = (v["entry"], v["lo"], v["len"], v["hash"])
+            if k not in keys:
+                keys.add(k)
+                variants.append(v)
+    table = write_table(a.out, variants)
+    json.dump(variants, open(os.path.join(a.out, "variants.json"), "w"), indent=1)
+    print(f"{len(variants)} variant(s) -> {table}")
+    if a.dll:
+        build_dll(a.out, subs, table, a.dll)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/spucheck/run_variants.sh b/tools/spucheck/run_variants.sh
new file mode 100644
index 00000000..46e8d65c
--- /dev/null
+++ b/tools/spucheck/run_variants.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# run_variants.sh <runtime.lib> <work-dir> [python]
+# End-to-end check of content-keyed lifted variants (see test_variants.c):
+#   pass 1:  runtime-built code runs through the interpreter and is dumped (SPU_MISS_DIR)
+#   lift:    tools/spucheck/lift_variants.py lifts the dumps into a variant DLL
+#   pass 2:  the SAME executable with SPU_VARIANT_DIR runs the code lifted (0 interpreter
+#            fallbacks); patched code, swapped overlays, GET invalidation checked
+#   pass 2s: the static path -- variant table + lifted C linked into a second executable
+#   bench:   dispatch-miss lookup cost with N variants registered
+# Needs clang-cl/link on PATH (THP8: under tools/vsbuild.sh). One compiler at a time.
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+root="$(cd "$here/../.." && pwd)"
+lib="$1"; work="$2"; py="${3:-python}"
+rm -rf "$work"; mkdir -p "$work/miss" "$work/var" "$work/dll" "$work/obj"
+w() { cygpath -w "$1"; }
+CF=(-nologo -MD -O2 -msse4.1 -fno-strict-aliasing /clang:-ffp-contract=off
+    -I "$(w "$root/runtime/spu")" -I "$(w "$root/runtime")" -I "$(w "$root/include")")
+LIBS=("$(w "$lib")" ws2_32.lib bcrypt.lib user32.lib gdi32.lib ole32.lib shell32.lib
+      advapi32.lib winmm.lib d3d12.lib dxgi.lib dxguid.lib d3dcompiler.lib xinput.lib dbghelp.lib uuid.lib)
+exe="$work/test_variants.exe"
+clang-cl "${CF[@]}" "$(w "$here/test_variants.c")" -Fe"$(w "$exe")" -Fo"$(w "$work/obj/")" -link "${LIBS[@]}" >/dev/null
+
+echo "== pass 1 (no variants)"
+SPU_MISS_DIR="$(w "$work/miss")" "$exe" pass1 2>"$work/pass1.err"
+dumps=(); for f in "$work"/miss/*.bin; do dumps+=("$(w "$f")"); done
+echo "== lift ${#dumps[@]} dump(s) -> variant DLL"
+"$py" "$(w "$here/lift_variants.py")" --out "$(w "$work/var")" --dll "$(w "$work/dll/variants.dll")" "${dumps[@]}"
+
+echo "== pass 2 (same executable, SPU_VARIANT_DIR)"
+SPU_VARIANT_DIR="$(w "$work/dll")" "$exe" pass2 --dll "$(w "$work/dll/variants.dll")" 2>"$work/pass2.err"
+grep "spu-var" "$work/pass2.err" || true
+
+echo "== pass 2s (static: variant table + lifted C linked in)"
+objs=(); i=0
+for s in "$here/test_variants.c" "$work/var/spu_variants.c" "$work"/var/var_*/spu_recomp.c; do
+    o="$work/obj/s_$i.obj"; i=$((i+1))
+    clang-cl "${CF[@]}" -w -c "$(w "$s")" -Fo"$(w "$o")" >/dev/null
+    objs+=("$(w "$o")")
+done
+link -nologo -OUT:"$(w "$work/pass2s.exe")" "${objs[@]}" "${LIBS[@]}" >/dev/null
+"$work/pass2s.exe" pass2 2>"$work/pass2s.err"
+
+echo "== bench (dispatch-miss variant lookup)"
+for n in 1 64 1024 8000; do "$exe" bench "$n" 2>/dev/null; done
diff --git a/tools/spucheck/spu_replay.c b/tools/spucheck/spu_replay.c
new file mode 100644
index 00000000..233d1228
--- /dev/null
+++ b/tools/spucheck/spu_replay.c
@@ -0,0 +1,439 @@
+/*
+ * spu_replay -- whole-program SPU differential test + dispatch benchmark.
+ *
+ * Re-executes captured SPU runs (runtime/spu/spu_capture.h, SPU_CAPTURE=...)
+ * offline and checks every channel operation, DMA payload and the final state
+ * against what the game produced:
+ *
+ *   --lifted   the title's lifted code through the real runtime dispatcher
+ *              (spu_run_with_halt / spu_indirect_branch / drain brackets)
+ *   --interp   the runtime's SPU interpreter alone (no lifted code at all;
+ *              the SPURS kernel-service addresses 0x9C0/0x9D0 still work)
+ *   --both     both, and the two end states against each other (default)
+ *   --bench N  N timed lifted replays (thread CPU per run), no checking after
+ *              the first; prints the median/min per run (thread cycles,
+ *              QueryThreadCycleTime, converted with a measured TSC rate)
+ *   --jobdump DIR  [--jobpc HEX] [--jobkey HEX] at every policy-module branch into job code at
+ *              LS HEX (default 0x4000): write DIR/job<KEY>_<capture#>_<n>.bin =
+ *              "SPUJOB1\0", u32 key, u32 pc, then gpr[128] + LS at entry, then
+ *              gpr[128] + LS after the lifted job returned (run nested in the hook,
+ *              spu_job_run_lifted). The per-job corpus for native job handlers. --jobkey
+ *              limits it to one job binary (needed when other jobs do not return
+ *              through their link: nesting them derails the replay).
+ *   --prof F   (Windows) sample the replaying thread's instruction pointer
+ *              during the --bench runs and write "rva count" lines to F
+ *              (symbolize with llvm-symbolizer --inlines against the PDB);
+ *              --prof-us U sets the sampling period (default 250 us)
+ *
+ * Exit code 0 = every capture replayed identically.
+ *
+ * It links the prebuilt runtime library plus the title's lifted SPU sources
+ * (THP8: src/spu_gen/ *.c, which self-register via a constructor), so this file
+ * stubs the handful of symbols a game build normally supplies (PPU loader,
+ * guest VM). Build: tools/spucheck/build_replay.sh.
+ */
+#include "spu_context.h"
+#include "spu_capture.h"
+#include "spu_interp.h"
+#include "spu_job_native.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#if defined(_WIN32)
+#  define WIN32_LEAN_AND_MEAN
+#  include <windows.h>
+#  include <intrin.h>
+#else
+#  include <time.h>
+#  if defined(__EMSCRIPTEN__)
+#    include <emscripten.h>
+/* node's process CPU time (user + system): a replay bench on a loaded machine is preempted, wall time lies */
+EM_JS(double, replay_cpu_ms, (void), { const u = process.cpuUsage(); return (u.user + u.system) / 1000; });
+#  endif
+static double replay_now_ms(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
+}
+#endif
+
+/* ---- symbols a game build provides (PPU loader / guest VM); unused here ---- */
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+const char* ppu_vfs_root = "";
+int g_resv_store_active = 0;
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+uint32_t g_barrier_sync_watch = 0;
+uint32_t g_spu_image_ls_start = 0, g_spu_image_span = 0, g_spu_image_src_ea = 0;
+const uint64_t function_table_count = 0;
+const struct { uint64_t a, b; } function_table[1];
+#if defined(_MSC_VER)
+__declspec(thread) void* g_active_ctx;
+#else
+__thread void* g_active_ctx;
+#endif
+void lbp_breadcrumb_dump(void) {}
+void ppu_hle_fastmem_poll(void) {}                       /* ppu_loader.cpp (HLE fast path off file) */
+const char* ps3_hle_name(unsigned nid) { (void)nid; return "?"; }   /* ppu_hle.cpp (frame_trace names) */
+void ppu_dump_bctrl_ring(void) {}
+void ppu_dump_guest_stack(void) {}
+void ppu_guard_page(uint32_t a) { (void)a; }
+uint32_t ppu_guest_caller(void) { return 0; }
+int ppu_guest_callstack(void) { return 0; }
+void ppu_log_host_chain(void) {}
+void ppu_resv_break_store(void) {}
+void ppu_resv_register(void) {}
+void ps3_hle_register_ctx(void) {}
+uint32_t ps3_spu_image_source_ea(void) { return 0; }
+void ps3_ww_report_inline(void) {}
+uint32_t vm_read32(uint32_t a) { (void)a; return 0; }
+void vm_write32(uint32_t a, uint32_t v) { (void)a; (void)v; }
+void vm_write8(uint32_t a, uint8_t v) { (void)a; (void)v; }
+
+extern int  spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx);
+extern void spu_begin_image(int image_id);
+extern void spu_register_function(uint32_t addr, void (*fn)(spu_context*));
+
+/* ---- interpreter driver ----------------------------------------------------
+ * Pure interpretation under a private image id whose only registered entries
+ * are the SPURS kernel-service addresses: the interpreter stops there (its
+ * "rejoin lifted code" check) and the driver hands them to the dispatcher,
+ * which performs the service exactly as for lifted code. */
+#define REPLAY_INTERP_IMAGE 99
+static void svc_stub(spu_context* ctx) { (void)ctx; }
+static void interp_entry(spu_context* ctx)
+{
+    for (;;) {
+        uint32_t pc = (uint32_t)ctx->pc & 0x3FFFCu;
+        if (ctx->policy_mode && (pc == SPURS_PM_EXIT_TO_KERNEL_LS || pc == SPURS_PM_SELECT_WORKLOAD_LS)) {
+            ctx->pc = pc;
+            spu_indirect_branch(ctx);           /* exit-to-kernel halts (longjmp) */
+            continue;
+        }
+        spu_interp_run(ctx, pc);
+        if (ctx->status & (SPU_STATUS_STOPPED_BY_STOP | SPU_STATUS_STOPPED_BY_HALT)) return;
+        uint32_t np = (uint32_t)ctx->pc & 0x3FFFCu;
+        if (!(ctx->policy_mode && (np == SPURS_PM_EXIT_TO_KERNEL_LS || np == SPURS_PM_SELECT_WORKLOAD_LS))) {
+            fprintf(stderr, "  [interp] stopped at 0x%05X (not a service address) -- impure\n", np);
+            return;
+        }
+    }
+}
+
+static double thread_cpu_ms(void)
+{
+#if defined(_WIN32)
+    FILETIME c, x, k, u;
+    if (!GetThreadTimes(GetCurrentThread(), &c, &x, &k, &u)) return 0;
+    unsigned long long t = (((unsigned long long)k.dwHighDateTime << 32) | k.dwLowDateTime)
+                         + (((unsigned long long)u.dwHighDateTime << 32) | u.dwLowDateTime);
+    return (double)t / 10000.0;
+#elif defined(__EMSCRIPTEN__)
+    return replay_cpu_ms();                 /* process CPU (15.6 ms ticks on Windows): use the per-run average */
+#else
+    return 0;
+#endif
+}
+static double wall_ms(void)
+{
+#if defined(_WIN32)
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1000.0 / (double)f.QuadPart;
+#else
+    return replay_now_ms();
+#endif
+}
+
+/* Thread cycles (QueryThreadCycleTime: TSC ticks while this thread ran, so
+ * time the scheduler gave to other processes is not counted) and the TSC rate
+ * to turn them into milliseconds. GetThreadTimes ticks in ~15.6 ms quanta,
+ * too coarse for one replay. */
+static unsigned long long thread_cycles(void)
+{
+#if defined(_WIN32)
+    ULONG64 c = 0;
+    QueryThreadCycleTime(GetCurrentThread(), &c);
+    return c;
+#else
+#if defined(__EMSCRIPTEN__)
+    return (unsigned long long)(replay_cpu_ms() * 1e6);   /* ns of process CPU time (node; one busy thread) */
+#else
+    return (unsigned long long)(replay_now_ms() * 1e6);   /* ns of the monotonic clock */
+#endif
+#endif
+}
+static double tsc_per_ms(void)
+{
+#if defined(_WIN32)
+    static double r;
+    if (r == 0) {
+        unsigned long long t0 = __rdtsc(); double w0 = wall_ms();
+        while (wall_ms() - w0 < 50.0) {}
+        r = (double)(__rdtsc() - t0) / (wall_ms() - w0);
+    }
+    return r;
+#else
+    return 1e6;
+#endif
+}
+static int cmp_dbl(const void* a, const void* b)
+{
+    double x = *(const double*)a, y = *(const double*)b;
+    return x < y ? -1 : x > y;
+}
+
+/* ---- sampling profiler (--prof) --------------------------------------------
+ * A second thread suspends the replaying thread every period and records its
+ * instruction pointer as an RVA of this executable (outside it: 0). */
+#if defined(_WIN32)
+#define PROF_SLOTS (1u << 16)
+static HANDLE         s_prof_target;
+static volatile LONG  s_prof_on, s_prof_quit;
+static unsigned       s_prof_us = 250;
+static unsigned long long s_prof_key[PROF_SLOTS];
+static unsigned       s_prof_ct[PROF_SLOTS];
+static unsigned long long s_prof_n, s_prof_drop;
+static void prof_note(unsigned long long rva)
+{
+    unsigned i = (unsigned)((rva * 0x9E3779B97F4A7C15ull) >> 48) & (PROF_SLOTS - 1);
+    for (unsigned n = 0; n < PROF_SLOTS; n++, i = (i + 1) & (PROF_SLOTS - 1)) {
+        if (s_prof_ct[i] && s_prof_key[i] == rva) { s_prof_ct[i]++; s_prof_n++; return; }
+        if (!s_prof_ct[i]) { s_prof_key[i] = rva; s_prof_ct[i] = 1; s_prof_n++; return; }
+    }
+    s_prof_drop++;
+}
+static DWORD WINAPI prof_thread(LPVOID unused)
+{
+    (void)unused;
+    unsigned long long base = (unsigned long long)(uintptr_t)GetModuleHandleA(NULL);
+    unsigned long long lim = base;
+    { const IMAGE_DOS_HEADER* d = (const IMAGE_DOS_HEADER*)(uintptr_t)base;
+      const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(uintptr_t)(base + (unsigned long long)d->e_lfanew);
+      lim = base + nt->OptionalHeader.SizeOfImage; }
+    HANDLE tm = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    while (!s_prof_quit) {
+        if (tm) {
+            LARGE_INTEGER due; due.QuadPart = -(LONGLONG)s_prof_us * 10;
+            SetWaitableTimer(tm, &due, 0, NULL, NULL, FALSE);
+            WaitForSingleObject(tm, INFINITE);
+        } else Sleep(1);
+        if (!s_prof_on) continue;
+        if (SuspendThread(s_prof_target) == (DWORD)-1) continue;
+        CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_CONTROL;
+        if (GetThreadContext(s_prof_target, &c)) {
+            unsigned long long ip = c.Rip;
+            prof_note(ip >= base && ip < lim ? ip - base : 0);
+        }
+        ResumeThread(s_prof_target);
+    }
+    if (tm) CloseHandle(tm);
+    return 0;
+}
+static void prof_write(const char* path)
+{
+    FILE* f = fopen(path, "w");
+    if (!f) { fprintf(stderr, "cannot write %s\n", path); return; }
+    fprintf(f, "# samples %llu dropped %llu period_us %u\n", s_prof_n, s_prof_drop, s_prof_us);
+    for (unsigned i = 0; i < PROF_SLOTS; i++)
+        if (s_prof_ct[i]) fprintf(f, "0x%llX %u\n", s_prof_key[i], s_prof_ct[i]);
+    fclose(f);
+    printf("  prof   : %llu samples -> %s\n", s_prof_n, path);
+}
+#endif
+
+typedef struct run_result {
+    int ok, halted, diverged, exhausted, consumed_all;
+    uint32_t status, stop, pc;
+    char msg[600];
+    spu_replay r;
+} run_result;
+
+/* ---- --jobdump: per-job corpus (spu_job_native.h) ---- */
+static const char* s_jobdump_dir;
+static int s_jobdump_file;
+static unsigned s_jobdump_n;
+static int jobdump_handler(spu_context* ctx, uint32_t key)
+{
+    char path[1024];
+    snprintf(path, sizeof path, "%s/job%08X_%03d_%04u.bin", s_jobdump_dir, key, s_jobdump_file, s_jobdump_n++);
+    FILE* f = fopen(path, "wb");
+    if (f) {
+        uint32_t pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+        fwrite("SPUJOB1", 1, 8, f); fwrite(&key, 4, 1, f); fwrite(&pc, 4, 1, f);
+        fwrite(ctx->gpr, 16, 128, f); fwrite(ctx->ls, 1, SPU_LS_SIZE, f);
+    }
+    int ok = spu_job_run_lifted(ctx);
+    if (f) { fwrite(ctx->gpr, 16, 128, f); fwrite(ctx->ls, 1, SPU_LS_SIZE, f); fclose(f); }
+    return ok;
+}
+
+static spu_context* new_ctx(const spu_trace* t)
+{
+    spu_context* ctx = (spu_context*)calloc(1, sizeof(spu_context));
+    spu_context_init(ctx, t->hdr.spu_id);
+    spu_trace_apply_start(t, ctx);
+    return ctx;
+}
+
+/* Run one replay; returns the context (caller frees) for state comparison. */
+static spu_context* run_one(const spu_trace* t, int interp, run_result* out)
+{
+    memset(out, 0, sizeof *out);
+    spu_context* ctx = new_ctx(t);
+    if (interp) ctx->image_id = REPLAY_INTERP_IMAGE;
+    spu_replay_begin(&out->r, t, ctx);
+    out->halted = spu_run_with_halt(interp ? interp_entry : spu_indirect_branch, ctx);
+    spu_replay_end(&out->r, ctx);
+    out->diverged = out->r.diverged;
+    out->exhausted = out->r.exhausted;
+    out->consumed_all = out->r.pos >= t->ev_len;
+    out->status = ctx->status; out->stop = ctx->stop_code; out->pc = (uint32_t)ctx->pc;
+    if (out->diverged) {
+        snprintf(out->msg, sizeof out->msg, "DIVERGED: %s", out->r.msg);
+    } else if (t->truncated) {
+        out->ok = out->exhausted && out->consumed_all;
+        snprintf(out->msg, sizeof out->msg, "%s (truncated capture; %llu events replayed%s)",
+                 out->ok ? "OK" : "INCOMPLETE", (unsigned long long)out->r.nev,
+                 out->exhausted ? "" : ", SPU stopped before the trace end");
+    } else {
+        int regs_ok = memcmp(ctx->gpr, t->gpr1, sizeof ctx->gpr) == 0;
+        int ls_ok = memcmp(ctx->ls, t->ls1, SPU_LS_SIZE) == 0;
+        out->ok = out->consumed_all && !out->exhausted && regs_ok && ls_ok;
+        int nr = 0; uint32_t nl = 0, first = 0xFFFFFFFFu;
+        for (int i = 0; i < 128; i++) if (memcmp(&ctx->gpr[i], &t->gpr1[i], 16)) nr++;
+        for (uint32_t i = 0; i < SPU_LS_SIZE; i++) if (ctx->ls[i] != t->ls1[i]) { nl++; if (first == 0xFFFFFFFFu) first = i; }
+        snprintf(out->msg, sizeof out->msg, "%s (%llu events%s; end status 0x%X/0x%X stop 0x%X/0x%X; %d regs, %u LS bytes differ%s%05X)",
+                 out->ok ? "OK" : "MISMATCH", (unsigned long long)out->r.nev,
+                 out->consumed_all ? "" : ", NOT all consumed",
+                 out->status, t->end_status, out->stop, t->end_stop, nr, nl,
+                 nl ? " from 0x" : "", nl ? first : 0);
+        if (nr && nr <= 8) {
+            size_t p = strlen(out->msg);
+            for (int i = 0; i < 128 && p < sizeof out->msg - 64; i++)
+                if (memcmp(&ctx->gpr[i], &t->gpr1[i], 16))
+                    p += snprintf(out->msg + p, sizeof out->msg - p, " r%d=%08X.%08X(want %08X.%08X)", i,
+                                  ctx->gpr[i]._u32[0], ctx->gpr[i]._u32[1], t->gpr1[i]._u32[0], t->gpr1[i]._u32[1]);
+        }
+    }
+    return ctx;
+}
+
+int main(int argc, char** argv)
+{
+    int mode_l = 1, mode_i = 1, bench = 0, nfiles = 0, fails = 0;
+    const char* files[4096];
+    const char* prof = NULL;
+    uint32_t jobpc = 0x4000, jobkey = 0;
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--lifted")) { mode_l = 1; mode_i = 0; }
+        else if (!strcmp(argv[i], "--interp")) { mode_l = 0; mode_i = 1; }
+        else if (!strcmp(argv[i], "--both")) { mode_l = mode_i = 1; }
+        else if (!strcmp(argv[i], "--bench") && i + 1 < argc) { bench = atoi(argv[++i]); }
+        else if (!strcmp(argv[i], "--prof") && i + 1 < argc) { prof = argv[++i]; }
+        else if (!strcmp(argv[i], "--jobdump") && i + 1 < argc) { s_jobdump_dir = argv[++i]; }
+        else if (!strcmp(argv[i], "--jobpc") && i + 1 < argc) { jobpc = (uint32_t)strtoul(argv[++i], 0, 16); }
+        else if (!strcmp(argv[i], "--jobkey") && i + 1 < argc) { jobkey = (uint32_t)strtoul(argv[++i], 0, 16); }
+#if defined(_WIN32)
+        else if (!strcmp(argv[i], "--prof-us") && i + 1 < argc) { s_prof_us = (unsigned)atoi(argv[++i]); }
+#endif
+        else if (nfiles < 4096) files[nfiles++] = argv[i];
+    }
+    if (!nfiles) {
+        fprintf(stderr, "usage: spu_replay [--lifted|--interp|--both] [--bench N] [--prof out.txt [--prof-us U]] capture.bin...\n");
+        return 2;
+    }
+#if defined(_WIN32)
+    HANDLE prof_th = NULL;
+    if (prof && bench > 0) {
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &s_prof_target,
+                        0, FALSE, DUPLICATE_SAME_ACCESS);
+        prof_th = CreateThread(NULL, 0, prof_thread, NULL, 0, NULL);
+    }
+#endif
+    /* Replays must not sleep in the PM idle-poll park. */
+#if defined(_WIN32)
+    _putenv("SPURS_PM_IDLE_PARK=0");
+#else
+    setenv("SPURS_PM_IDLE_PARK", "0", 1);
+#endif
+    spu_begin_image(REPLAY_INTERP_IMAGE);
+    spu_register_function(SPURS_PM_EXIT_TO_KERNEL_LS, svc_stub);
+    spu_register_function(SPURS_PM_SELECT_WORKLOAD_LS, svc_stub);
+    spu_begin_image(0);
+    if (s_jobdump_dir) spu_job_native_register(jobpc, jobkey, jobdump_handler);
+
+    for (int f = 0; f < nfiles; f++) {
+        spu_trace t;
+        int rc = spu_trace_load(&t, files[f]);
+        s_jobdump_file = f; s_jobdump_n = 0;
+        if (rc) { printf("%s: cannot load (%d)\n", files[f], rc); fails++; continue; }
+        printf("%s: img %d entry 0x%05X%s, %zu event bytes%s\n", files[f], t.hdr.image_id,
+               t.hdr.entry_pc, t.hdr.policy_mode ? " (policy module)" : "", t.ev_len,
+               t.truncated ? ", truncated" : "");
+        run_result rl, ri;
+        spu_context *cl = NULL, *ci = NULL;
+        if (mode_l) {
+            cl = run_one(&t, 0, &rl);
+            printf("  lifted : %s\n", rl.msg);
+            printf("           rdch %llu wrch %llu rchcnt %llu get %llu (%llu B) put %llu (%llu B) atomic %llu\n",
+                   (unsigned long long)rl.r.n_rdch, (unsigned long long)rl.r.n_wrch, (unsigned long long)rl.r.n_rchcnt,
+                   (unsigned long long)rl.r.n_get, (unsigned long long)rl.r.get_bytes,
+                   (unsigned long long)rl.r.n_put, (unsigned long long)rl.r.put_bytes, (unsigned long long)rl.r.n_atom);
+            if (!rl.ok) fails++;
+        }
+        if (mode_i) {
+            ci = run_one(&t, 1, &ri);
+            printf("  interp : %s\n", ri.msg);
+            if (!ri.ok) fails++;
+        }
+        if (cl && ci) {
+            int nr = 0; uint32_t nl = 0;
+            for (int i = 0; i < 128; i++) if (memcmp(&cl->gpr[i], &ci->gpr[i], 16)) nr++;
+            for (uint32_t i = 0; i < SPU_LS_SIZE; i++) if (cl->ls[i] != ci->ls[i]) nl++;
+            int same = !nr && !nl && rl.r.nev == ri.r.nev;
+            printf("  lifted vs interp: %s (%d regs, %u LS bytes, events %llu/%llu)\n",
+                   same ? "identical" : "DIFFER", nr, nl,
+                   (unsigned long long)rl.r.nev, (unsigned long long)ri.r.nev);
+            if (!same) fails++;
+        }
+        free(cl); free(ci);
+        if (bench > 0) {
+            double* per = (double*)calloc((size_t)bench, sizeof(double));
+            double rate = tsc_per_ms();
+            double c0 = thread_cpu_ms(), w0 = wall_ms(), best = 1e30;
+#if defined(_WIN32)
+            s_prof_on = prof != NULL;
+#endif
+            for (int k = 0; k < bench; k++) {
+                unsigned long long tk = thread_cycles(); double wk = wall_ms();
+                run_result rb; spu_context* cb = run_one(&t, 0, &rb); free(cb);
+                per[k] = (double)(thread_cycles() - tk) / rate;
+                double dk = wall_ms() - wk;
+                if (dk < best) best = dk;
+            }
+#if defined(_WIN32)
+            s_prof_on = 0;
+#endif
+            double c1 = thread_cpu_ms(), w1 = wall_ms();
+            qsort(per, (size_t)bench, sizeof(double), cmp_dbl);
+            printf("  bench  : %d runs, thread-cycles median %.3f ms/run (min %.3f max %.3f); "
+                   "cpu %.3f ms/run, wall %.3f ms/run (best %.3f ms)\n",
+                   bench, per[bench / 2], per[0], per[bench - 1],
+                   (c1 - c0) / bench, (w1 - w0) / bench, best);
+            free(per);
+        }
+        spu_trace_free(&t);
+    }
+#if defined(_WIN32)
+    if (prof_th) {
+        s_prof_quit = 1;
+        WaitForSingleObject(prof_th, INFINITE);
+        prof_write(prof);
+    }
+#endif
+    printf("%s: %d failure(s)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
diff --git a/tools/spucheck/spu_variant_dll.c b/tools/spucheck/spu_variant_dll.c
new file mode 100644
index 00000000..19f4d087
--- /dev/null
+++ b/tools/spucheck/spu_variant_dll.c
@@ -0,0 +1,81 @@
+/*
+ * spu_variant_dll.c -- glue linked into every lifted-variant DLL
+ * (tools/spucheck/lift_variants.py --dll). Compiled, like the lifted sources,
+ * with -DSPU_VARIANT_DLL: runtime names are accessors over the tables below
+ * (runtime/spu/spu_variant_api.h explains why).
+ *
+ * spu_vdll_register() binds the tables BY NAME from the host's spu_variant_api,
+ * checks that the host thread-locals it computes are the host's own, and only
+ * then hands the variants to api->add -- a DLL that cannot bind registers
+ * nothing, so the host may unload it.
+ */
+#include "spu_context.h"
+#include <stdio.h>
+#include <string.h>
+
+void*     spu_vdll_sym[SPU_VI_COUNT];
+uint32_t  spu_vdll_tls_index;
+uintptr_t spu_vdll_tls_off[SPU_VT_COUNT];
+static const spu_variant_api* s_api;
+
+static const char* const s_sym_names[SPU_VI_COUNT] = {
+#define SPU_VN_(n) #n,
+    SPU_VARIANT_FUNCS(SPU_VN_) SPU_VARIANT_DATA(SPU_VN_)
+#undef SPU_VN_
+};
+static const char* const s_tls_names[SPU_VT_COUNT] = {
+#define SPU_VN_(n) #n,
+    SPU_VARIANT_TLS(SPU_VN_)
+#undef SPU_VN_
+};
+
+void* spu_vdll_tls_slow(int i) { return s_api->tls_addr(s_tls_names[i]); }
+
+/* The lifter emits a per-image registrar into every spu_recomp.c; a variant DLL
+ * registers through its variant table instead, so this is never called. */
+void spu_register_function(uint32_t addr, void (*fn)(spu_context*)) { (void)addr; (void)fn; }
+
+int spu_vdll_register(const spu_variant_api* api, const spu_variant_desc* v, uint32_t n)
+{
+    if (!api || api->version != SPU_VARIANT_API_VERSION || api->size < sizeof *api) {
+        fprintf(stderr, "[spu-var-dll] host API version %u, this DLL needs %u\n",
+                api ? api->version : 0u, (unsigned)SPU_VARIANT_API_VERSION);
+        return -1;
+    }
+    /* Resolve everything first: a refused bind must leave a live binding intact. */
+    void* sym[SPU_VI_COUNT];
+    uintptr_t off[SPU_VT_COUNT];
+    for (int i = 0; i < SPU_VI_COUNT; i++) {
+        void* a = NULL;
+        for (uint32_t k = 0; k < api->n_syms && !a; k++)
+            if (!strcmp(api->syms[k].name, s_sym_names[i])) a = api->syms[k].addr;
+        if (!a) { fprintf(stderr, "[spu-var-dll] host lacks %s\n", s_sym_names[i]); return -2; }
+        sym[i] = a;
+    }
+    for (int i = 0; i < SPU_VT_COUNT; i++) {
+        int found = 0;
+        for (uint32_t k = 0; k < api->n_tls && !found; k++)
+            if (!strcmp(api->tls[k].name, s_tls_names[i])) {
+                off[i] = (uintptr_t)api->tls[k].off;
+                found = 1;
+            }
+        if (!found) { fprintf(stderr, "[spu-var-dll] host lacks thread-local %s\n", s_tls_names[i]); return -2; }
+    }
+    if (s_api && s_api != api) {
+        fprintf(stderr, "[spu-var-dll] already bound to another host API\n");
+        return -4;
+    }
+    memcpy(spu_vdll_sym, sym, sizeof sym);
+    memcpy(spu_vdll_tls_off, off, sizeof off);
+    spu_vdll_tls_index = api->tls_index;
+    s_api = api;
+    /* The thread-locals must be the host's own, on this (the loading) thread. */
+    for (int i = 0; i < SPU_VT_COUNT; i++)
+        if (SPU_VDLL_TLS(i) != api->tls_addr(s_tls_names[i])) {
+            fprintf(stderr, "[spu-var-dll] thread-local %s: computed %p, host has %p\n",
+                    s_tls_names[i], SPU_VDLL_TLS(i), api->tls_addr(s_tls_names[i]));
+            s_api = NULL;
+            return -3;
+        }
+    return api->add(v, n);
+}
diff --git a/tools/spucheck/test_variants.c b/tools/spucheck/test_variants.c
new file mode 100644
index 00000000..a1ec87d0
--- /dev/null
+++ b/tools/spucheck/test_variants.c
@@ -0,0 +1,350 @@
+/*
+ * test_variants -- runtime-built / swapped SPU code runs LIFTED after one
+ * offline relift, without rebuilding the program that runs it.
+ *
+ * None of the SPU programs below is part of a lifted image: the test writes
+ * them into local store at run time (as a title assembling, patching or
+ * streaming code would) and branches to them. Driven by run_variants.sh:
+ *
+ *   pass1         no variants: every program falls back to the interpreter
+ *                 and, with SPU_MISS_DIR set, its local store is dumped.
+ *   (lift)        lift_variants.py --dll: the dumps -> one variant DLL.
+ *   pass2         the SAME executable with SPU_VARIANT_DIR=<dll dir>: the code
+ *                 dispatches lifted (0 interpreter fallbacks), and
+ *                 - patched code (a byte inside the first 32, or only BEYOND
+ *                   them) is not run by the stale variant;
+ *                 - two overlays streamed in by MFC GETs alternate at the same
+ *                   LSA and each runs its own variant; a GET that rewrites a
+ *                   validated variant's code invalidates it, a GET of the same
+ *                   bytes or into data pages does not;
+ *                 - a DLL handed an incompatible API refuses to register.
+ *   pass2 (static) the same checks with the variant table + lifted C linked in.
+ *   bench N       ns per dispatch-miss variant lookup with N variants
+ *                 registered: miss / validated / dirty code / dirty data ...
+ */
+#include "spu_context.h"
+#include "spu_interp.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+
+/* game-side symbols the runtime library expects (see spu_replay.c) */
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+const char* ppu_vfs_root = "";
+int g_resv_store_active = 0;
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+uint32_t g_barrier_sync_watch = 0;
+uint32_t g_spu_image_ls_start = 0, g_spu_image_span = 0, g_spu_image_src_ea = 0;
+const uint64_t function_table_count = 0;
+const struct { uint64_t a, b; } function_table[1];
+#if defined(_MSC_VER)
+__declspec(thread) void* g_active_ctx;
+#else
+__thread void* g_active_ctx;
+#endif
+void lbp_breadcrumb_dump(void) {}
+void ppu_dump_bctrl_ring(void) {}
+void ppu_dump_guest_stack(void) {}
+void ppu_guard_page(uint32_t a) { (void)a; }
+uint32_t ppu_guest_caller(void) { return 0; }
+int ppu_guest_callstack(void) { return 0; }
+void ppu_log_host_chain(void) {}
+void ppu_resv_break_store(void) {}
+void ppu_resv_register(void) {}
+void ps3_hle_register_ctx(void) {}
+uint32_t ps3_spu_image_source_ea(void) { return 0; }
+void ps3_ww_report_inline(void) {}
+uint32_t vm_read32(uint32_t a) { (void)a; return 0; }
+void vm_write32(uint32_t a, uint32_t v) { (void)a; (void)v; }
+void vm_write8(uint32_t a, uint8_t v) { (void)a; (void)v; }
+
+extern int spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx);
+extern uint64_t g_spu_interp_steps;
+
+/* ---- a few SPU instruction encodings ---- */
+static uint32_t il(int rt, int i16)       { return (0x081u << 23) | (((uint32_t)i16 & 0xFFFFu) << 7) | (uint32_t)rt; }
+static uint32_t ila(int rt, uint32_t i18) { return (0x21u << 25) | ((i18 & 0x3FFFFu) << 7) | (uint32_t)rt; }
+static uint32_t ai(int rt, int ra, int i10) { return (0x1Cu << 24) | (((uint32_t)i10 & 0x3FFu) << 14) | ((uint32_t)ra << 7) | (uint32_t)rt; }
+static uint32_t a_(int rt, int ra, int rb)  { return (0x0C0u << 21) | ((uint32_t)rb << 14) | ((uint32_t)ra << 7) | (uint32_t)rt; }
+static uint32_t wrch(int ch, int rt)      { return (0x10Du << 21) | ((uint32_t)ch << 7) | (uint32_t)rt; }
+static uint32_t rdch(int rt, int ch)      { return (0x00Du << 21) | ((uint32_t)ch << 7) | (uint32_t)rt; }
+static uint32_t brasl(int rt, uint32_t a) { return (0x062u << 23) | (((a >> 2) & 0xFFFFu) << 7) | (uint32_t)rt; }
+static uint32_t bi(int ra)                { return (0x1A8u << 21) | ((uint32_t)ra << 7); }
+static uint32_t stop(uint32_t code)       { return code & 0x3FFFu; }
+
+static spu_context g_ctx;
+static void put(uint32_t lsa, const uint32_t* w, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        uint8_t* p = g_ctx.ls + lsa + 4 * i;
+        p[0] = (uint8_t)(w[i] >> 24); p[1] = (uint8_t)(w[i] >> 16); p[2] = (uint8_t)(w[i] >> 8); p[3] = (uint8_t)w[i];
+    }
+}
+static void put_be(uint8_t* p, const uint32_t* w, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        p[4*i] = (uint8_t)(w[i] >> 24); p[4*i+1] = (uint8_t)(w[i] >> 16); p[4*i+2] = (uint8_t)(w[i] >> 8); p[4*i+3] = (uint8_t)w[i];
+    }
+}
+static void ctx_fresh(void)
+{
+    spu_context_init(&g_ctx, 0x1234);
+    g_ctx.image_id = 77;                       /* an image with no lifted functions */
+    put(0x100, (uint32_t[]){ stop(0x2000) }, 1);   /* standalone overlays return here */
+    g_ctx.gpr[0]._u32[0] = 0x100;
+}
+typedef struct { uint64_t steps, misses, validations, rejects, dirty, consumes, spot; } run_res;
+static run_res run_at(uint32_t pc)
+{
+    spu_variant_stats s0, s1;
+    spu_variant_get_stats(&s0);
+    g_ctx.pc = pc;
+    g_ctx.status = SPU_STATUS_RUNNING;
+    g_spu_interp_steps = 0;
+    spu_run_with_halt(spu_indirect_branch, &g_ctx);
+    spu_variant_get_stats(&s1);
+    run_res r = { g_spu_interp_steps, s1.misses - s0.misses, s1.validations - s0.validations,
+                  s1.rejects - s0.rejects, s1.dirty_marks - s0.dirty_marks,
+                  s1.consumes - s0.consumes, s1.spot_fails - s0.spot_fails };
+    return r;
+}
+
+/* P1 at 0x8000: il $3,5 ; il $4,7 ; a $3,$3,$4 ; ai $3,$3,IMM ; stop  -> 12 + IMM */
+static void put_p1(int imm)
+{
+    uint32_t w[] = { il(3, 5), il(4, 7), a_(3, 3, 4), ai(3, 3, imm), stop(0x2000) };
+    put(0x8000, w, 5);
+}
+/* Overlay at 0x9000: il $3,7 ; 7 x ai $3,$3,1 ; ai $3,$3,TAG ; ai $3,$3,K ; bi $0
+ * -> 14 + TAG + K. A (TAG 100, K 1) and B (TAG 200, K 1) share their first 32
+ * bytes; C (TAG 100, K 5) differs from A only at byte 0x24. */
+#define OVL_LSA 0x9000u
+static unsigned ovl_words(uint32_t* w, int tag, int k)
+{
+    unsigned n = 0;
+    w[n++] = il(3, 7);
+    for (int i = 0; i < 7; i++) w[n++] = ai(3, 3, 1);
+    w[n++] = ai(3, 3, tag);
+    w[n++] = ai(3, 3, k);
+    w[n++] = bi(0);
+    return n;
+}
+/* EA layout of the test's "main memory" */
+#define EA_A    0x10000u
+#define EA_B    0x10100u
+#define EA_DATA 0x11000u
+#define DRV_LSA 0x1000u
+/* GET <size> bytes EA -> LSA with tag 0 and wait for it (MFC channels). */
+static unsigned emit_get(uint32_t* w, unsigned n, uint32_t lsa, uint32_t ea, uint32_t size)
+{
+    w[n++] = ila(10, lsa);  w[n++] = wrch(16, 10);   /* MFC_LSA  */
+    w[n++] = il(11, 0);     w[n++] = wrch(17, 11);   /* MFC_EAH  */
+    w[n++] = ila(12, ea);   w[n++] = wrch(18, 12);   /* MFC_EAL  */
+    w[n++] = ila(13, size); w[n++] = wrch(19, 13);   /* MFC_Size */
+    w[n++] = il(14, 0);     w[n++] = wrch(20, 14);   /* MFC_TagID */
+    w[n++] = il(15, 0x40);  w[n++] = wrch(21, 15);   /* MFC_Cmd = GET */
+    w[n++] = il(16, 1);     w[n++] = wrch(22, 16);   /* WrTagMask */
+    w[n++] = il(16, 2);     w[n++] = wrch(23, 16);   /* WrTagUpdate ALL */
+    w[n++] = rdch(16, 24);                           /* RdTagStat */
+    return n;
+}
+static unsigned emit_call_ovl(uint32_t* w, unsigned n)
+{
+    w[n++] = brasl(0, OVL_LSA);
+    w[n++] = a_(20, 20, 3);                          /* r20 += overlay result */
+    return n;
+}
+/* Driver X: GET A, call; GET A again (same bytes), call; GET data into a code-
+ * free page, call.  -> r20 = 3 * 115.
+ * Driver Y: A, B, A, B swapped in by GETs at the same LSA. -> r20 = 2*115 + 2*215 */
+static void put_driver(char which)
+{
+    uint32_t w[256]; unsigned n = 0;
+    w[n++] = il(20, 0);
+    if (which == 'X') {
+        n = emit_get(w, n, OVL_LSA, EA_A, 0x100);  n = emit_call_ovl(w, n);
+        n = emit_get(w, n, OVL_LSA, EA_A, 0x100);  n = emit_call_ovl(w, n);
+        n = emit_get(w, n, 0x20000, EA_DATA, 0x400); n = emit_call_ovl(w, n);
+    } else {
+        for (int i = 0; i < 4; i++) {
+            n = emit_get(w, n, OVL_LSA, (i & 1) ? EA_B : EA_A, 0x100);
+            n = emit_call_ovl(w, n);
+        }
+    }
+    w[n++] = stop(0x2000);
+    put(DRV_LSA, w, n);
+}
+static void setup_main_memory(void)
+{
+    vm_base = (uint8_t*)VirtualAlloc(NULL, 0x100000, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    uint32_t w[16]; unsigned n;
+    n = ovl_words(w, 100, 1); put_be(vm_base + EA_A, w, n);
+    n = ovl_words(w, 200, 1); put_be(vm_base + EA_B, w, n);
+    for (uint32_t i = 0; i < 0x400; i++) vm_base[EA_DATA + i] = (uint8_t)(i * 37 + 11);
+}
+
+static int fails;
+#define CHECK(cond, ...) do { if (!(cond)) { printf("  FAIL: " __VA_ARGS__); printf("\n"); fails++; } } while (0)
+static void show(const char* what, const run_res* r, uint32_t val)
+{
+    printf("%-34s result=%-4u interp-fallbacks=%llu steps=%llu validations=%llu rejects=%llu "
+           "dirty-pages=%llu consumes=%llu\n", what, val, (unsigned long long)r->misses,
+           (unsigned long long)r->steps, (unsigned long long)r->validations,
+           (unsigned long long)r->rejects, (unsigned long long)r->dirty, (unsigned long long)r->consumes);
+}
+#define LIFTED(r)   ((r).misses == 0 && (r).steps == 0)
+
+static void standalone_ovl(const char* what, int tag, int k, int expect_lifted)
+{
+    uint32_t w[16]; unsigned n = ovl_words(w, tag, k);
+    ctx_fresh(); put(OVL_LSA, w, n);
+    run_res r = run_at(OVL_LSA);
+    uint32_t v = g_ctx.gpr[3]._u32[0];
+    show(what, &r, v);
+    CHECK(v == (uint32_t)(14 + tag + k), "r3 should be %d", 14 + tag + k);
+    if (expect_lifted == 1) CHECK(LIFTED(r), "expected the lifted variant (no interpreter fallback)");
+    if (expect_lifted == 0) CHECK(!LIFTED(r), "expected the interpreter (no variant may match)");
+}
+
+static void dll_refuses(const char* dll)
+{
+    HMODULE m = LoadLibraryA(dll);
+    CHECK(m != NULL, "LoadLibrary(%s)", dll);
+    if (!m) return;
+    spu_variants_register_fn reg = (spu_variants_register_fn)(void*)GetProcAddress(m, SPU_VARIANTS_ENTRY);
+    CHECK(reg != NULL, "no %s export", SPU_VARIANTS_ENTRY);
+    if (!reg) return;
+    spu_variant_stats s0, s1; spu_variant_get_stats(&s0);
+    spu_variant_api bad; memset(&bad, 0, sizeof bad);
+    bad.version = 99; bad.size = sizeof bad;
+    int rc1 = reg(&bad);
+    bad.version = SPU_VARIANT_API_VERSION;            /* right version, empty symbol table */
+    int rc2 = reg(&bad);
+    spu_variant_get_stats(&s1);
+    printf("%-34s rc(version 99)=%d rc(no symbols)=%d registered +%llu\n", "DLL with an incompatible host API",
+           rc1, rc2, (unsigned long long)(s1.registered - s0.registered));
+    CHECK(rc1 < 0 && rc2 < 0 && s1.registered == s0.registered, "an unbindable DLL must register nothing");
+}
+
+static void passes(int expect_lifted, const char* dll)
+{
+    run_res r; uint32_t v;
+    /* 1: runtime-built code */
+    ctx_fresh(); put_p1(30); r = run_at(0x8000); v = g_ctx.gpr[3]._u32[0];
+    show("1 built code", &r, v);
+    CHECK(v == 42, "r3 should be 42");
+    if (expect_lifted) CHECK(LIFTED(r), "expected the lifted variant (no interpreter fallback)");
+    else CHECK(!LIFTED(r), "expected an interpreter fallback");
+    /* 2: self-modified within the first 32 bytes (pass 2 only: pass 1 must not
+     * dump -- and so lift -- the patched code) */
+    if (expect_lifted) {
+        ctx_fresh(); put_p1(40); r = run_at(0x8000); v = g_ctx.gpr[3]._u32[0];
+        show("2 patched code", &r, v);
+        CHECK(v == 52, "r3 should be 52 (a stale variant ran?)");
+        CHECK(!LIFTED(r), "the patched code must not run the variant lifted from the original");
+    }
+    /* 3: overlays standalone; C differs from A only beyond its first 32 bytes */
+    standalone_ovl("3a overlay A", 100, 1, expect_lifted);
+    standalone_ovl("3b overlay B", 200, 1, expect_lifted);
+    if (expect_lifted) standalone_ovl("3c A patched past byte 32", 100, 5, 0);
+    /* 4: driver X -- GET A twice (identical bytes) + a data GET */
+    ctx_fresh(); put_driver('X'); r = run_at(DRV_LSA); v = g_ctx.gpr[20]._u32[0];
+    show("4 GET A, GET A again, GET data", &r, v);
+    CHECK(v == 3 * 115, "r20 should be %d", 3 * 115);
+    if (expect_lifted) {
+        CHECK(LIFTED(r), "expected driver + overlay lifted");
+        CHECK(r.dirty == 0 && r.consumes == 0, "an identical / data GET must not dirty validated code");
+        CHECK(r.validations - r.rejects == 2, "driver + A validated once each (got %llu ok)",
+              (unsigned long long)(r.validations - r.rejects));
+    }
+    /* 5: driver Y -- A and B alternate at the same LSA */
+    ctx_fresh(); put_driver('Y'); r = run_at(DRV_LSA); v = g_ctx.gpr[20]._u32[0];
+    show("5 A,B,A,B swapped in by GETs", &r, v);
+    CHECK(v == 2 * 115 + 2 * 215, "r20 should be %d (each overlay its own code)", 2 * 115 + 2 * 215);
+    if (expect_lifted) {
+        CHECK(LIFTED(r), "expected driver + both overlays lifted");
+        CHECK(r.consumes == 3, "each of the 3 swaps should invalidate (got %llu)", (unsigned long long)r.consumes);
+        CHECK(r.validations - r.rejects == 5, "driver + 4 overlay validations (got %llu ok)",
+              (unsigned long long)(r.validations - r.rejects));
+    }
+    if (dll) dll_refuses(dll);
+}
+
+/* ---- microbenchmark: the dispatch-miss variant lookup ---- */
+static void bench_fn(spu_context* c) { (void)c; }
+static double now_ns(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1e9 / (double)f.QuadPart;
+}
+/* best of 3: the machine is shared and the test runs at BELOW_NORMAL priority */
+#define TIME(label, iters, body) do {                                           \
+        double _best = 1e30;                                                    \
+        for (int _r = 0; _r < 3; _r++) {                                        \
+            double _t0 = now_ns();                                              \
+            for (long _i = 0; _i < (iters); _i++) { body; }                     \
+            double _t = (now_ns() - _t0) / (double)(iters);                     \
+            if (_t < _best) _best = _t;                                         \
+        }                                                                       \
+        res[nres++] = _best;                                                    \
+        names[nres - 1] = label;                                                \
+    } while (0)
+static volatile uintptr_t sink;
+static int bench(unsigned N)
+{
+    ctx_fresh();
+    uint32_t x = 12345;
+    for (uint32_t i = 0; i < SPU_LS_SIZE; i++) { x = x * 1103515245u + 12345u; g_ctx.ls[i] = (uint8_t)(x >> 16); }
+    static spu_variant_desc d[SPU_VARIANT_MAX];
+    for (unsigned i = 0; i < N; i++) {
+        uint32_t e = 0x1000u + i * 16u;               /* 256-byte extents, 16 apart */
+        d[i].entry = e; d[i].lo = e; d[i].len = 256;
+        d[i].hash = spu_code_hash(g_ctx.ls + e, 256); d[i].fn = bench_fn;
+    }
+    int added = spu_variant_add(d, N);
+    const uint32_t k = d[N / 2].entry;               /* the variant under test */
+    const uint32_t data_lsa = 0x3E000;               /* no variant code there  */
+    uint8_t other[256]; for (int i = 0; i < 256; i++) other[i] = (uint8_t)~g_ctx.ls[k + i];
+    uint8_t same[256];  memcpy(same, g_ctx.ls + k, 256);
+    /* every variant validated in this context: the worst case for a consume */
+    for (unsigned i = 0; i < N; i++) sink += (uintptr_t)spu_variant_find(&g_ctx, d[i].entry);
+    double res[8]; const char* names[8]; int nres = 0;
+    TIME("miss (no variant at pc)", 4000000, sink += (uintptr_t)spu_variant_find(&g_ctx, 0x3F004u));
+    TIME("validated hit", 4000000, sink += (uintptr_t)spu_variant_find(&g_ctx, k));
+    TIME("GET same bytes + hit", 2000000,
+         SPU_VAR_NOTE_GET(&g_ctx, k, same, 256); sink += (uintptr_t)spu_variant_find(&g_ctx, k));
+    TIME("GET data page + hit", 2000000,
+         SPU_VAR_NOTE_GET(&g_ctx, data_lsa, other, 256); sink += (uintptr_t)spu_variant_find(&g_ctx, k));
+    long dirty_iters = N >= 1024 ? 20000 : 400000;
+    TIME("GET new bytes (dirty) + revalidate", dirty_iters,
+         SPU_VAR_NOTE_GET(&g_ctx, k, other, 16); sink += (uintptr_t)spu_variant_find(&g_ctx, k));
+    spu_context* idle = (spu_context*)calloc(1, sizeof(spu_context));
+    spu_context_init(idle, 1);
+    TIME("GET hook, context without verdicts", 20000000, SPU_VAR_NOTE_GET(idle, data_lsa, other, 256));
+    spu_variant_stats s; spu_variant_get_stats(&s);
+    printf("bench N=%-5u (registered %d):", N, added);
+    for (int i = 0; i < nres; i++) printf("  %s %.1f ns;", names[i], res[i]);
+    printf("  [validations %llu consumes %llu]\n", (unsigned long long)s.validations, (unsigned long long)s.consumes);
+    if (spu_variant_find(&g_ctx, k) != bench_fn) { printf("FAIL: lookup lost the variant\n"); return 1; }
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc > 2 && !strcmp(argv[1], "bench")) return bench((unsigned)strtoul(argv[2], 0, 0));
+    int pass2 = argc > 1 && !strcmp(argv[1], "pass2");
+    const char* dll = (argc > 3 && !strcmp(argv[2], "--dll")) ? argv[3] : NULL;
+    if (!pass2 && !(argc > 1 && !strcmp(argv[1], "pass1"))) {
+        printf("usage: test_variants pass1 | pass2 [--dll <variant.dll>] | bench <N>\n");
+        return 2;
+    }
+    setup_main_memory();
+    passes(pass2, dll);
+    printf("%s\n", fails ? "FAIL" : "PASS");
+    return fails ? 1 : 0;
+}
