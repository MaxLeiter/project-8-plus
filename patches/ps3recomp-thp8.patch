+"""ref_vmx.py - reference semantics for the VMX/AltiVec facility of the Cell
+PPU (AltiVec Technology Programming Environments Manual; PowerISA v2.02
+Book I chapter 5 "Vector Facility"; Cell BE Handbook for lvlx/lvrx/stvlx/
+stvrx).
+
+Vector registers are 16 raw big-endian bytes (element 0 first). Float lanes
+use exact rational arithmetic with round-to-nearest-even (the only VMX
+rounding mode); with VSCR[NJ]=1 (the Cell power-on value, never changed by
+THP8) denormal inputs are read as zero of the same sign and denormal results
+are flushed to zero of the same sign. NaN results: the first NaN operand in
+the order vA, vB, vC, quieted; an invalid operation without NaN operands
+gives the default QNaN 0x7FC00000.
+"""
+from __future__ import annotations
+
+import math
+from fractions import Fraction
+
+from ppcref import MASK32, MASK64, MEMBASE, Undefined, VSCR_NJ, VSCR_SAT, add_spec, s32, sext
+from ref_fp import SGL, round_rat
+
+VMX = ("vmx",)
+
+KNOWN_DEVIATIONS = {
+    "vmx-estimate": "vrefp/vrsqrtefp/vexptefp/vlogefp return exact values; Cell returns "
+                    "an estimate within the PEM bound.",
+}
+
+VQNAN = 0x7FC00000
+
+
+# ---------------------------------------------------------------------------
+# lane helpers
+# ---------------------------------------------------------------------------
+
+def W(b):
+    return [int.from_bytes(b[i:i + 4], "big") for i in range(0, 16, 4)]
+
+
+def H(b):
+    return [int.from_bytes(b[i:i + 2], "big") for i in range(0, 16, 2)]
+
+
+def B(b):
+    return list(b)
+
+
+def fromW(ws):
+    return b"".join((w & MASK32).to_bytes(4, "big") for w in ws)
+
+
+def fromH(hs):
+    return b"".join((h & 0xFFFF).to_bytes(2, "big") for h in hs)
+
+
+def fromB(bs):
+    return bytes(x & 0xFF for x in bs)
+
+
+def sat(v, lo, hi):
+    if v < lo:
+        return lo, True
+    if v > hi:
+        return hi, True
+    return v, False
+
+
+def _sat_note(s, any_sat):
+    # VSCR[SAT] is sticky: set when any lane saturated, never cleared by a
+    # saturating op. The lifter models it (ORs 1 into ctx->vscr), so it is
+    # compared exactly; it used to be a don't-care ("vscr-sat") while the
+    # lifter ignored it.
+    if any_sat:
+        s.vscr |= VSCR_SAT
+
+
+# ---------------------------------------------------------------------------
+# single-precision lane arithmetic
+# ---------------------------------------------------------------------------
+
+def fnan(x):
+    return (x >> 23) & 0xFF == 0xFF and x & 0x7FFFFF
+
+
+def finf(x):
+    return x & 0x7FFFFFFF == 0x7F800000
+
+
+def fzero(x):
+    return x & 0x7FFFFFFF == 0
+
+
+def fden(x):
+    return (x >> 23) & 0xFF == 0 and x & 0x7FFFFF
+
+
+def fsign(x):
+    return x >> 31
+
+
+def flush(x, nj):
+    return x & 0x80000000 if nj and fden(x) else x
+
+
+def frat(x):
+    """finite single -> Fraction"""
+    e = (x >> 23) & 0xFF
+    m = x & 0x7FFFFF
+    if e == 0:
+        v = Fraction(m, 1 << 149)
+    else:
+        v = Fraction(m | (1 << 23)) * (Fraction(2) ** (e - 150))
+    return -v if x >> 31 else v
+
+
+def fround(v, nj):
+    """Fraction -> single bits, round to nearest even, NJ flush of tiny results."""
+    if v == 0:
+        return 0
+    sg = 1 if v < 0 else 0
+    a = -v if sg else v
+    r = round_rat(sg, a.numerator, a.denominator, SGL, 0)
+    return flush(r, nj)
+
+
+def quietf(x):
+    return x | 0x00400000
+
+
+def first_nan(*xs):
+    for x in xs:
+        if fnan(x):
+            return quietf(x)
+    return None
+
+
+def vadd(a, b, nj, negb=False):
+    a, b = flush(a, nj), flush(b, nj)
+    n = first_nan(a, b)
+    if n is not None:
+        return n
+    if negb:
+        b ^= 0x80000000
+    if finf(a) or finf(b):
+        if finf(a) and finf(b) and fsign(a) != fsign(b):
+            return VQNAN
+        return a if finf(a) else b
+    v = frat(a) + frat(b)
+    if v == 0:
+        if fzero(a) and fzero(b) and fsign(a) == fsign(b):
+            return a & 0x80000000
+        return 0
+    return fround(v, nj)
+
+
+def vfma(a, c, b, nj, negb, negr):
+    a, b, c = flush(a, nj), flush(b, nj), flush(c, nj)
+    n = first_nan(a, b, c)
+    if n is not None:
+        return n
+    if negb:
+        b ^= 0x80000000
+    ps = fsign(a) ^ fsign(c)
+    pinf = finf(a) or finf(c)
+    if pinf and (fzero(a) or fzero(c)):
+        return VQNAN
+    if pinf:
+        if finf(b) and fsign(b) != ps:
+            return VQNAN
+        r = (ps << 31) | 0x7F800000
+    elif finf(b):
+        r = b
+    else:
+        pz = fzero(a) or fzero(c)
+        v = (0 if pz else frat(a) * frat(c)) + frat(b)
+        if v == 0:
+            r = (ps << 31) if (pz and fzero(b) and ps == fsign(b)) else 0
+        else:
+            r = fround(v, nj)
+    if negr:
+        r ^= 0x80000000
+    return r
+
+
+def vmaxmin(a, b, nj, is_max):
+    a, b = flush(a, nj), flush(b, nj)
+    n = first_nan(a, b)
+    if n is not None:
+        return n
+    if fzero(a) and fzero(b):
+        if is_max:
+            return a if not fsign(a) else b
+        return a if fsign(a) else b
+    fa = _fkey(a)
+    fb = _fkey(b)
+    if is_max:
+        return a if fa > fb else b
+    return a if fa < fb else b
+
+
+def _fkey(x):
+    if finf(x):
+        return Fraction(-(10 ** 60)) if fsign(x) else Fraction(10 ** 60)
+    return frat(x)
+
+
+def vrfi(x, nj, mode):
+    x = flush(x, nj)
+    if fnan(x):
+        return quietf(x)
+    if finf(x) or fzero(x):
+        return x
+    v = frat(x)
+    if mode == "n":
+        r = Fraction(round(v))          # Python round(): half to even
+    elif mode == "z":
+        r = Fraction(math.trunc(v))
+    elif mode == "p":
+        r = Fraction(math.ceil(v))
+    else:
+        r = Fraction(math.floor(v))
+    if r == 0:
+        return x & 0x80000000
+    return fround(r, nj)
+
+
+# ---------------------------------------------------------------------------
+# registration helpers
+# ---------------------------------------------------------------------------
+
+def vx(name, xo, fn, unary=False, valid=None, fixed=None, gen=None):
+    fx = dict(fixed or {})
+    if unary:
+        fx["ra"] = 0
+    add_spec(name, "VX", 4, xo, fn, fixed=fx, valid=valid, gen=gen, tags=VMX)
+
+
+def va(name, xo, fn, valid=None):
+    add_spec(name, "VA", 4, xo, fn, valid=valid, tags=VMX)
+
+
+def _nj(s):
+    return bool(s.vscr & VSCR_NJ)
+
+
+def lanes_f(name, xo, op, unary=False):
+    def sem(s, f):
+        nj = _nj(s)
+        a, b = W(s.vr[f.ra]), W(s.vr[f.rb])
+        s.set_v(f.rt, fromW([op(a[i], b[i], nj) for i in range(4)]))
+    vx(name, xo, sem, unary=unary)
+
+
+def _ftz_setup(sub):
+    """lanes whose sum/difference of two NORMAL tiny operands is denormal (the
+    non-Java flush of a result; random lanes hit it ~1 in 2000)"""
+    import struct as _st
+
+    def setup(s, f, rng, ea):
+        if rng.random() >= 0.35 or f.ra == f.rb:
+            return
+        a, b = bytearray(s.vr[f.ra]), bytearray(s.vr[f.rb])
+        for i in range(4):
+            if rng.random() < 0.6:
+                ea_ = rng.randrange(1, 4)                       # biased exponent 1..3
+                av = (rng.getrandbits(1) << 31) | (ea_ << 23) | rng.getrandbits(23)
+                d = rng.randrange(-(1 << 22), 1 << 22)
+                bv = (av & 0x7FFFFFFF) + d
+                bv = max(0x00800000, min(bv, 0x017FFFFF)) | (av & 0x80000000)
+                if not sub:
+                    bv ^= 0x80000000                            # a + (-a') = small
+                a[4 * i:4 * i + 4] = av.to_bytes(4, "big")
+                b[4 * i:4 * i + 4] = bv.to_bytes(4, "big")
+        s.vr[f.ra], s.vr[f.rb] = bytes(a), bytes(b)
+    return setup
+
+
+def lanes_f_setup(name, xo, op, setup):
+    def sem(s, f):
+        nj = _nj(s)
+        a, b = W(s.vr[f.ra]), W(s.vr[f.rb])
+        s.set_v(f.rt, fromW([op(a[i], b[i], nj) for i in range(4)]))
+    add_spec(name, "VX", 4, xo, sem, setup=setup, tags=VMX)
+
+
+lanes_f_setup("vaddfp", 10, lambda a, b, nj: vadd(a, b, nj), _ftz_setup(False))
+lanes_f_setup("vsubfp", 74, lambda a, b, nj: vadd(a, b, nj, negb=True), _ftz_setup(True))
+lanes_f("vmaxfp", 1034, lambda a, b, nj: vmaxmin(a, b, nj, True))
+lanes_f("vminfp", 1098, lambda a, b, nj: vmaxmin(a, b, nj, False))
+for _m, _xo in (("n", 522), ("z", 586), ("p", 650), ("m", 714)):
+    lanes_f("vrfi" + _m, _xo, lambda a, b, nj, m=_m: vrfi(b, nj, m), unary=True)
+
+
+def _vfma(negb, negr):
+    def sem(s, f):
+        nj = _nj(s)
+        a, b, c = W(s.vr[f.ra]), W(s.vr[f.rb]), W(s.vr[f.vc])
+        s.set_v(f.rt, fromW([vfma(a[i], c[i], b[i], nj, negb, negr) for i in range(4)]))
+    return sem
+
+
+def _dr_lanes(neg):
+    """Load some lanes with binary32 operands whose exact a*c+b sits just off
+    a binary32 tie (odd lower neighbour): forming the sum in binary64 lands
+    ON the tie and a second rounding would go the wrong way."""
+    import struct as _st
+
+    def setup(s, f, rng, ea):
+        if 0.35 <= rng.random() < 0.55 and len({f.ra, f.rb, f.vc}) == 3:
+            # products landing around 2^-126 (flush-to-zero of the result)
+            a, b, c = bytearray(s.vr[f.ra]), bytearray(s.vr[f.rb]), bytearray(s.vr[f.vc])
+            for i in range(4):
+                if rng.random() < 0.6:
+                    av = _st.pack(">f", rng.uniform(0.5, 2.0) * 2.0 ** -63 * rng.choice((1, -1)))
+                    cv = _st.pack(">f", rng.uniform(0.5, 2.0) * 2.0 ** -63)
+                    bv = _st.pack(">f", rng.choice((0.0, -0.0, 2.0 ** -126, -(2.0 ** -126))))
+                    a[4 * i:4 * i + 4], b[4 * i:4 * i + 4], c[4 * i:4 * i + 4] = av, bv, cv
+            s.vr[f.ra], s.vr[f.rb], s.vr[f.vc] = bytes(a), bytes(b), bytes(c)
+            return
+        if rng.random() < 0.35:
+            a, b, c = bytearray(s.vr[f.ra]), bytearray(s.vr[f.rb]), bytearray(s.vr[f.vc])
+            for i in range(4):
+                if rng.random() < 0.6:
+                    k = rng.randrange(-60, 60)
+                    av = (1.0 - 2.0 ** -18) * 2.0 ** (k - 24)
+                    cv = 1.0 + 2.0 ** -18
+                    bv = (1.0 + 2.0 ** -23) * 2.0 ** k
+                    if neg:
+                        bv = -bv
+                    if rng.random() < 0.5:
+                        av, bv = -av, -bv
+                    a[4 * i:4 * i + 4] = _st.pack(">f", av)
+                    b[4 * i:4 * i + 4] = _st.pack(">f", bv)
+                    c[4 * i:4 * i + 4] = _st.pack(">f", cv)
+            s.vr[f.ra], s.vr[f.rb], s.vr[f.vc] = bytes(a), bytes(b), bytes(c)
+    return setup
+
+
+add_spec("vmaddfp", "VA", 4, 46, _vfma(False, False), setup=_dr_lanes(False), tags=VMX)
+add_spec("vnmsubfp", "VA", 4, 47, _vfma(True, True), setup=_dr_lanes(True), tags=VMX)
+
+
+def _est(kind):
+    def lane_exact(x, nj):
+        x = flush(x, nj)
+        if fnan(x):
+            return quietf(x)
+        if kind == "re":
+            if fzero(x):
+                return (x & 0x80000000) | 0x7F800000
+            if finf(x):
+                return x & 0x80000000
+            return fround(1 / frat(x), nj)
+        if kind == "rsqrte":
+            if fzero(x):
+                return (x & 0x80000000) | 0x7F800000
+            if fsign(x):
+                return VQNAN
+            if finf(x):
+                return 0
+            v = frat(x)
+            r = 1 / math.sqrt(float(v)) if float(v) > 0 else float("inf")
+            return fround(Fraction(r), nj)
+        if kind == "expte":
+            if finf(x):
+                return 0 if fsign(x) else 0x7F800000
+            v = float(frat(x))
+            try:
+                r = 2.0 ** v
+            except OverflowError:
+                return 0x7F800000
+            if r > 3.4028234663852886e38:
+                return 0x7F800000
+            return fround(Fraction(r), nj)
+        # loge
+        if fzero(x):
+            return 0xFF800000
+        if fsign(x):
+            return VQNAN
+        if finf(x):
+            return 0x7F800000
+        return fround(Fraction(math.log2(float(frat(x)))), nj)
+
+    tol = {"re": Fraction(1, 4096), "rsqrte": Fraction(1, 4096), "expte": Fraction(1, 16),
+           "loge": Fraction(1, 32)}[kind]
+
+    def sem(s, f):
+        nj = _nj(s)
+        b = W(s.vr[f.rb])
+        exact = [lane_exact(x, nj) for x in b]
+        s.set_v(f.rt, fromW(exact))
+        s.notes.append("vmx-estimate")
+
+        def chk(got_bytes):
+            g = W(got_bytes)
+            for e, x in zip(exact, g):
+                if e == x:
+                    continue
+                if fnan(e) or finf(e) or fzero(e) or fnan(x) or finf(x) or fzero(x):
+                    return "special"
+                if fsign(e) != fsign(x):
+                    return "sign"
+                fe, fg = frat(e), frat(x)
+                err = abs(fg - fe) if kind == "loge" else abs(fg - fe) / abs(fe)
+                if err > tol:
+                    return f"error {float(err):.3g}"
+            return None
+        s.approx[("vr", f.rt)] = chk
+    return sem
+
+
+vx("vrefp", 266, _est("re"), unary=True)
+vx("vrsqrtefp", 330, _est("rsqrte"), unary=True)
+vx("vexptefp", 394, _est("expte"), unary=True)
+vx("vlogefp", 458, _est("loge"), unary=True)
+
+
+def _vcf(signed):
+    def sem(s, f):
+        b = W(s.vr[f.rb])
+        out = []
+        for x in b:
+            v = s32(x) if signed else x
+            out.append(fround(Fraction(v, 1 << f.uimm5), _nj(s)) if v else 0)
+        s.set_v(f.rt, fromW(out))
+    return sem
+
+
+def _vct(signed):
+    def sem(s, f):
+        nj = _nj(s)
+        b = W(s.vr[f.rb])
+        out = []
+        anys = False
+        lo, hi = (-(1 << 31), (1 << 31) - 1) if signed else (0, MASK32)
+        for x in b:
+            x = flush(x, nj)
+            if fnan(x):
+                out.append(0)
+                continue
+            if finf(x):
+                r = hi if not fsign(x) else lo
+                anys = True
+                out.append(r & MASK32)
+                continue
+            v = math.trunc(frat(x) * (1 << f.uimm5))
+            r, st = sat(v, lo, hi)
+            anys |= st
+            out.append(r & MASK32)
+        s.set_v(f.rt, fromW(out))
+        _sat_note(s, anys)
+    return sem
+
+
+vx("vcfux", 778, _vcf(False))
+vx("vcfsx", 842, _vcf(True))
+vx("vctuxs", 906, _vct(False))
+vx("vctsxs", 970, _vct(True))
+
+
+# ---------------------------------------------------------------------------
+# compares (VXR form, Rc -> CR6)
+# ---------------------------------------------------------------------------
+
+def _cr6(s, all_true, all_false):
+    s.set_crf(6, (8 if all_true else 0) | (2 if all_false else 0))
+
+
+def vcmp(name, xo, lanes, pred, fp=False, bfp=False):
+    for rc in (0, 1):
+        def sem(s, f, rc=rc):
+            nj = _nj(s)
+            a, b = lanes(s.vr[f.ra]), lanes(s.vr[f.rb])
+            n = len(a)
+            if bfp:
+                out = []
+                for x, y in zip(a, b):
+                    x, y = flush(x, nj), flush(y, nj)
+                    r = 0
+                    if fnan(x) or fnan(y):
+                        r = 0xC0000000
+                    else:
+                        fx, fy = _fkey(x), _fkey(y)
+                        if not fx <= fy:
+                            r |= 0x80000000
+                        if not fx >= -fy:
+                            r |= 0x40000000
+                    out.append(r)
+                s.set_v(f.rt, fromW(out))
+                if rc:
+                    s.set_crf(6, 2 if all(o == 0 for o in out) else 0)
+                return
+            res = []
+            for x, y in zip(a, b):
+                if fp:
+                    x, y = flush(x, nj), flush(y, nj)
+                    t = (not fnan(x) and not fnan(y)) and pred(_fkey(x), _fkey(y))
+                else:
+                    t = pred(x, y)
+                res.append(t)
+            width = 16 // n
+            m = (1 << (8 * width)) - 1
+            vals = [m if t else 0 for t in res]
+            s.set_v(f.rt, (fromB if width == 1 else fromH if width == 2 else fromW)(vals))
+            if rc:
+                _cr6(s, all(res), not any(res))
+        add_spec(name + ("." if rc else ""), "VXR", 4, xo, sem, fixed={"vrc": rc}, setup=_vcmp_setup,
+                 tags=VMX + ("vcmp",))
+
+
+def _vcmp_setup(s, f, rng, ea):
+    """vB = vA with at most one byte changed: the record forms' CR6 "all
+    true" case (random vectors never produce it) and near-equal lanes"""
+    if rng.random() >= 0.4 or f.ra == f.rb:
+        return
+    b = bytearray(s.vr[f.ra])
+    if rng.random() < 0.5:
+        b[rng.randrange(16)] ^= 1 << rng.randrange(8)
+    s.vr[f.rb] = bytes(b)
+
