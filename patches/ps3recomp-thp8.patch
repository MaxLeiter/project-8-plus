+/* ---- Idle-poll detector (SPU threads polling main memory) -----------------
+ * An SPU program is a function of its inputs. If the data it keeps pulling in
+ * is content it already knew -- the same bytes it GOT from that place last
+ * time -- and it pushes out nothing new, it is not making progress: it is
+ * polling. THP8's Havok constraint thread (img 31) runs such a loop whenever
+ * the physics job queue is empty -- cellSyncMutexLock / GET of the queue
+ * header / cellSyncMutexUnlock, ~150k iterations a second -- one host core at
+ * 97-100% for the whole game.
+ *
+ * Evidence is counted on plain GETs only. Lock-line traffic is neutral when it
+ * returns what this SPU already knew -- the line as it last read it, or as its
+ * own PUTLLC / PUTLLUC left it (a cellSyncMutex lock / unlock rewrites the
+ * lock word every iteration, so comparing reads with reads alone never fired
+ * on the Havok loop). A poll iteration is a handful of lock operations around
+ * the read of the polled data; more than SPU_POLL_SYNC_MAX (8) committed
+ * atomic writes between two uninformative GETs is atomic WORK (an allocator,
+ * a work counter: they read back their own writes too) and restarts the
+ * count. So does new content anywhere -- a GET or GETLLAR returning bytes
+ * this SPU did not know, a consumed mailbox / signal word, a plain PUT of new
+ * data -- so an SPU doing real work never parks.
+ *
+ * After SPU_POLL_PARK_REPEATS (48) uninformative GETs in a row the thread
+ * parks at its next GETLLAR, watching that line, until another agent writes
+ * it (every coherent PPU store / cellSync HLE / SPU PUTLLC / PUTLLUC / DMA PUT
+ * wakes the watch, spu_coherency.c; a write that landed just before the watch
+ * was registered is caught by comparing the line with what this SPU last knew)
+ * or SPU_POLL_PARK_MS (1 ms) passes. A PPU posting work takes the same lock
+ * and so wakes it at once. The park only delays; the SPU then performs the
+ * GETLLAR exactly as before, so nothing it observes changes.
+ *
+ * Bookkeeping is per context and starts at the context's first GETLLAR
+ * (ctx->poll_on): a program without lock-line traffic never parks here and
+ * pays nothing. SPURS policy modules have their own idle park (below) and are
+ * skipped. SPU_POLL_PARK=0 disables; SPU_POLL_PARK_STATS=<s> logs parks/wakes
+ * per context every <s> seconds. */
+static int s_poll_park = -1, s_poll_repeats = 48, s_poll_ms = 1, s_poll_stats = 0;
+static unsigned s_poll_sync_max = 8;
+static void spu_poll_park_cfg(void)
+{
+    const char* e = getenv("SPU_POLL_PARK");
+    int on = (e && *e == '0') ? 0 : 1;
+    if ((e = getenv("SPU_POLL_PARK_REPEATS")) && atoi(e) > 0) s_poll_repeats = atoi(e);
+    if ((e = getenv("SPU_POLL_PARK_MS")) && atoi(e) > 0) s_poll_ms = atoi(e);
+    if ((e = getenv("SPU_POLL_PARK_STATS")) && atoi(e) > 0) s_poll_stats = atoi(e);
+    if ((e = getenv("SPU_POLL_SYNC_MAX")) && atoi(e) > 0) s_poll_sync_max = (unsigned)atoi(e);
+    if (on)
