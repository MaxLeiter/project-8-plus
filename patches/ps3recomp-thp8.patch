+/* hle_call_full's _TocGuard, same semantics. */
+struct hle_toc_guard {
+    ppu_context* c; uint64_t toc, sp;
+    ~hle_toc_guard() { c->gpr[2] = toc; vm_write64(sp + 0x28, toc);
+                       unsigned t = (unsigned)c->thread_id;
+                       if (t < PS3_HLE_INFLIGHT_MAX) g_hle_inflight[t] = nullptr; }
+};
+
+static inline __attribute__((always_inline)) void hle_call_lean(uint32_t nid, ppu_context* ctx, void* ra)
+{
+    hle_toc_guard _tg{ ctx, ctx->gpr[2], ctx->gpr[1] };
+    if (ppu_gcm_pump) ppu_gcm_pump();
+    ppu_prof_stamp(ctx, ppu_prof_tag_host(ra));
+    g_last_hle_nid = nid;
+    g_last_hle_name = "(unimplemented)";
+    vm_write64(ctx->gpr[1] + 0x28, ctx->gpr[2]);        /* the ABI TOC spill */
+    { const uint32_t opd = prx_resolve_export(nid);
+      if (opd && hle_prx_call(nid, ctx, opd)) return; }
+    ps3_nid_entry* e = nullptr;
+    const int ctx_slot = hle_dc_resolve(nid, &e);
+    if (ctx_slot >= 0) {
+        const uint32_t i = (uint32_t)ctx_slot;
+        if (PS3_MS_MAYBE_ON()) ps3_msf("hle:%s", g_ctx[i].name);
+        g_last_hle_name = g_ctx[i].name;
+        { unsigned t = (unsigned)ctx->thread_id;
+          if (t < PS3_HLE_INFLIGHT_MAX) g_hle_inflight[t] = g_ctx[i].name; }
+        g_ctx[i].fn(ctx);
+        { unsigned t = (unsigned)ctx->thread_id;
+          if (t < PS3_HLE_INFLIGHT_MAX) g_hle_inflight[t] = nullptr; }
+        return;
+    }
+    if (!e || !e->handler) { hle_unresolved(nid, ctx); return; }
+    g_last_hle_name = e->name;
+    if (PS3_MS_MAYBE_ON()) ps3_msf("hle:%s", e->name);
+    { unsigned t = (unsigned)ctx->thread_id;
+      if (t < PS3_HLE_INFLIGHT_MAX) g_hle_inflight[t] = e->name; }
+    hle_generic fn = (hle_generic)e->handler;
+    ctx->gpr[3] = fn(ctx->gpr[3], ctx->gpr[4], ctx->gpr[5], ctx->gpr[6],
+                     ctx->gpr[7], ctx->gpr[8], ctx->gpr[9], ctx->gpr[10]);
+}
+
+extern "C" void ps3_hle_call(uint32_t nid, ppu_context* ctx)
+{
+    void* const ra = __builtin_return_address(0);
+    if (hle_lean_now() && !hle_nid_has_hook(nid)) { hle_call_lean(nid, ctx, ra); return; }
+    hle_call_full(nid, ctx, ra);
+}
