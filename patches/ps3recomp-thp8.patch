+    if (!((a && *a && *a != '0') || (b && *b && *b != '0'))) return;
+    if (s_wasapi_mute) return;                                   /* PS3_AUDIO_MUTE: nothing is heard, the beep neither */
+    static int done = 0;
+    if (done) return;
+    done = 1;
+    const u32 total = CELL_AUDIO_SAMPLE_RATE * 6 / 10;
+    float chunk[2 * 480];
+    u32 t = 0;
+    printf("[cellAudio] AUDIO TEST: 440 Hz beep for 0.6 s\n");
+    while (t < total && s_wasapi_client) {
+        UINT32 pad = 0;
+        if (FAILED(s_wasapi_client->lpVtbl->GetCurrentPadding(s_wasapi_client, &pad))) break;
+        UINT32 room = s_wasapi_buf_frames - pad;
+        if (room < 480) { Sleep(2); continue; }
+        for (u32 i = 0; i < 480; i++, t++) {
+            float v = 0.25f * (float)sin(2.0 * 3.14159265358979 * 440.0 * (double)t / CELL_AUDIO_SAMPLE_RATE);
+            chunk[2 * i] = chunk[2 * i + 1] = v;
+        }
+        BYTE* buf = NULL;
+        if (SUCCEEDED(s_wasapi_render->lpVtbl->GetBuffer(s_wasapi_render, 480, &buf)) && buf) {
+            memcpy(buf, chunk, sizeof chunk);
+            s_wasapi_render->lpVtbl->ReleaseBuffer(s_wasapi_render, 480, 0);
+        }
+    }
+}
