+/* Does any non-branch instruction read one of the interpolants in
+ * `input_mask` (bit n = INPUT_SRC n)? Same walk as rsx_fp_program_size:
+ * inline CONST slots are skipped. */
+static int fp_reads_inputs(const u8* ucode, u32 max_bytes, u32 input_mask);
+
+/* TC8 (input 0xC) or TC9 (0xD). */
+static int fp_reads_tc89(const u8* ucode, u32 max_bytes)
+{
+    return fp_reads_inputs(ucode, max_bytes, (1u << 0xC) | (1u << 0xD));
+}
+
+static int fp_reads_inputs(const u8* ucode, u32 max_bytes, u32 input_mask)
+{
+    u32 off = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 w0 = rsx_fp_read_word(ucode + off + 0);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        const u32 in = (w0 & FP_INPUT_SRC_MASK) >> FP_INPUT_SRC_SHIFT;
+        if (!(w2 & FP_BRANCH) && ((input_mask >> in) & 1u) &&
+            ((w1 & FP_REG_TYPE_MASK) == FP_REG_TYPE_INPUT ||
+             (w2 & FP_REG_TYPE_MASK) == FP_REG_TYPE_INPUT ||
+             (w3 & FP_REG_TYPE_MASK) == FP_REG_TYPE_INPUT))
+            return 1;
+        off += 16;
+        if ((w1 & FP_REG_TYPE_MASK) == FP_REG_TYPE_CONST ||
+            (w2 & FP_REG_TYPE_MASK) == FP_REG_TYPE_CONST ||
+            (w3 & FP_REG_TYPE_MASK) == FP_REG_TYPE_CONST)
+            off += 16;
+        if (w0 & FP_END) break;
+    }
+    return 0;
+}
